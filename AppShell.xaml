<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EHMR.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EHMR.Views"
    FlyoutBehavior="Flyout">

	<FlyoutItem Route="dashboard">
		<ShellContent ContentTemplate="{DataTemplate views:DashboardView}" />
	</FlyoutItem>

	<FlyoutItem Route="patients">
		<ShellContent ContentTemplate="{DataTemplate views:PatientListPage}" />
	</FlyoutItem>

	<!--<FlyoutItem Route="therapy" local:ShellVisibility.Route="therapy">
		<ShellContent ContentTemplate="{DataTemplate views:TherapyPage}" />
	</FlyoutItem>-->

	<FlyoutItem Route="login">
		<ShellContent ContentTemplate="{DataTemplate views:LoginView}" />
	</FlyoutItem>
</Shell>