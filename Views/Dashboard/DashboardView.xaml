<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.DashboardView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:admin="clr-namespace:EHMR.ViewModels.Admin"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dash="clr-namespace:EHMR.ViewModels.Dashboard.Models"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="Page"
	x:DataType="viewModels:DashboardViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<converters:MetricTileVariantToColorConverter x:Key="MetricTileVariantToColorConverter" />

			<Style
				x:Key="DashboardSummaryCard"
				BasedOn="{StaticResource PageHeaderCardStyle1}"
				TargetType="Border">
				<Setter Property="Padding" Value="20" />
			</Style>

			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 14" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

			<Style x:Key="AlertChipBorder" TargetType="Border">
				<Setter Property="Padding" Value="14,10" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="8">

			<!--  ===================================================  -->
			<!--  HEADER  -->
			<!--  ===================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid ColumnDefinitions="*,Auto,Auto" VerticalOptions="Center">

					<!--  COL 0: TITLE — untouched  -->
					<controls:FFPageHeader
						Title="Почетна страна"
						Grid.Column="0"
						Subtitle="Преглед на пациентите, терапии, прегледи и други активности." />

					<!--
						COL 1: ALERTS
						FIX: CollectionView inside an "Auto" Grid column is a known MAUI
						measurement bug — it either collapses to zero width or refuses
						to size itself to its content, so the three chips could end up
						squeezed, wrapped, or clipped instead of sitting in one row.
						Since this is a small, fixed set of alert chips (not a scrolling
						list), swapping to HorizontalStackLayout + BindableLayout avoids
						the CollectionView measurement issue entirely: a StackLayout
						sizes correctly inside an Auto column every time, so all three
						cards are guaranteed to lay out side-by-side, horizontally,
						without affecting the "*" title column or the Auto button
						column next to it.
					-->
					<HorizontalStackLayout
						Grid.Column="1"
						Margin="1,0"
						BindableLayout.ItemsSource="{Binding State.AlertSummaries}"
						Spacing="10"
						VerticalOptions="Center">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="dash:DashboardAlertSummaryItem">
								<Border
									Padding="14,0"
									BackgroundColor="{Binding BackgroundColor}"
									HeightRequest="45"
									Stroke="{Binding AccentColor}"
									Style="{StaticResource AlertChipBorder}"
									VerticalOptions="Center">
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Command}" />
									</Border.GestureRecognizers>
									<Grid
										ColumnDefinitions="Auto,Auto"
										ColumnSpacing="6"
										VerticalOptions="Center">
										<Label
											FontFamily="FASolid"
											FontSize="18"
											Text="{Binding Icon}"
											TextColor="{Binding AccentColor}"
											VerticalOptions="Center" />
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="0"
											VerticalOptions="Center">
											<Label
												FontAttributes="Bold"
												FontSize="14"
												Text="{Binding Count}"
												TextColor="{Binding AccentColor}" />
											<Label
												FontSize="8"
												Text="{Binding Label}"
												TextColor="{Binding AccentColor}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
					<!--  COL 2: BUTTONS — untouched  -->
					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding NewEncounterCommand}"
							ContentPadding="20,0"
							HeightRequestEx="45"
							Text="Нов Преглед" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding NewAppointmentCommand}"
							ContentPadding="20,0"
							HeightRequestEx="45"
							Text="Нов Термин" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  MAIN SCROLL AREA  -->
			<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Spacing="8">

					<!--  ===================================================  -->
					<!--
						KPI STRIP
						
						These numbers were already computed on every dashboard load but
						nothing rendered them. Uses FFMetricTile so the dashboard matches
						the admin dashboard's design system rather than hand-rolled cards.
					-->
					<!--  ===================================================  -->
					<Border Style="{StaticResource PageHeaderCardStyle}">
						<FlexLayout
							AlignItems="Center"
							BindableLayout.ItemsSource="{Binding Kpis}"
							Direction="Row"
							JustifyContent="SpaceBetween"
							Wrap="Wrap">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="admin:FFMetricTileItem">
									<controls:FFMetricTile
										Title="{Binding Title}"
										Margin="0,0,12,12"
										Command="{Binding Command}"
										CommandParameter="{Binding CommandParameter}"
										DisplayMode="Metric"
										Icon="{Binding Icon}"
										MaximumHeightRequest="160"
										MinimumWidthRequest="240"
										Subtitle="{Binding Subtitle}"
										Variant="{Binding Variant}"
										Value="{Binding Value}" />
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</FlexLayout>
					</Border>

					<!--  ===================================================  -->
					<!--  ===================================================  -->

					<!--  ===================================================  -->
					<!--  PATIENT EXPLORER  -->
					<!--  ===================================================  -->
					<Border Grid.Row="1" Style="{StaticResource PageHeaderCardStyle}">
						<Grid ColumnSpacing="5" RowSpacing="20">
							<VerticalStackLayout>

								<controls:SparkExplorerHeaderView
									Buttons="{Binding Buttons}"
									Pickers="{Binding Pickers}"
									SearchCommand="{Binding SearchCommand}"
									SearchPlaceholder="Пребарување на пациенти..."
									SearchText="{Binding PatientSearchText}"
									Tabs="{Binding Tabs}" />

								<Border Padding="0">
									<controls:SparkDataGridView
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										EditRowCommand="{Binding EditCommand}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										RowTappedCommand="{Binding SelectCommand}"
										Rows="{Binding GridRows}"
										TotalPages="{Binding TotalPages}" />
								</Border>
							</VerticalStackLayout>
						</Grid>
					</Border>

					<!--  ===================================================  -->
					<!--  BOTTOM ROW — ТЕРМИНИ + ПРЕГЛЕДИ ПО ДАТУМ  -->
					<!--  ===================================================  -->
					<Grid
						Padding="0,0,0,12"
						ColumnDefinitions="*,*"
						ColumnSpacing="12">

						<!--  ── Термини ──────────────────────────────────────  -->
						<Border Style="{StaticResource PageHeaderCardStyle}">
							<Grid RowDefinitions="Auto,*" RowSpacing="12">

								<Grid ColumnDefinitions="*,Auto">
									<Label Style="{StaticResource DashboardCardTitle}" Text="Термини" />
									<Border
										Grid.Column="1"
										Padding="10,5"
										MinimumHeightRequest="28"
										MinimumWidthRequest="28"
										Style="{StaticResource DashboardCardCountBadge}">
										<!--  Was bound to DailyEncounters.Count — the count of the *other* card's list.  -->
										<Label
											FontAttributes="Bold"
											FontSize="14"
											Style="{StaticResource DashboardCardCountLabel}"
											Text="{Binding State.Appointments.Count}" />
									</Border>
								</Grid>

								<CollectionView
									Grid.Row="1"
									ItemsSource="{Binding State.Appointments}"
									SelectionMode="None">

									<CollectionView.EmptyView>
										<VerticalStackLayout
											Padding="20"
											HorizontalOptions="Center"
											Spacing="6"
											VerticalOptions="Center">
											<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема закажани термини" />
										</VerticalStackLayout>
									</CollectionView.EmptyView>

									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="dash:DashboardAppointmentItem">
											<Border
												Margin="0,0,0,10"
												Padding="0"
												BackgroundColor="{StaticResource SparkPageBackground}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeThickness="1">

												<Border.Shadow>
													<Shadow
														Brush="{StaticResource SparkTextPrimary}"
														Opacity="0.08"
														Radius="10"
														Offset="0,3" />
												</Border.Shadow>
												<Border.StrokeShape>
													<RoundRectangle CornerRadius="14" />
												</Border.StrokeShape>

												<Grid Padding="0,12,14,12" ColumnDefinitions="4,Auto,*,Auto">

													<BoxView
														Grid.Column="0"
														BackgroundColor="{Binding StatusColor}"
														HorizontalOptions="Start"
														WidthRequest="4" />

													<!--  Avatar background tint  -->
													<Border
														Grid.Column="1"
														Margin="14,0,14,0"
														BackgroundColor="{Binding StatusColor}"
														HeightRequest="48"
														Opacity="0.15"
														StrokeThickness="0"
														VerticalOptions="Center"
														WidthRequest="48">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="24" />
														</Border.StrokeShape>
													</Border>

													<!--  Initials label  -->
													<Label
														Grid.Column="1"
														Margin="14,0,14,0"
														FontAttributes="Bold"
														FontSize="16"
														HorizontalOptions="Center"
														HorizontalTextAlignment="Center"
														Text="{Binding PatientName, Converter={StaticResource AppointmentsInitialsConverter}}"
														TextColor="{Binding StatusColor}"
														VerticalOptions="Center"
														WidthRequest="48" />

													<VerticalStackLayout
														Grid.Column="2"
														Spacing="4"
														VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontSize="15"
															Text="{Binding PatientName}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<HorizontalStackLayout Spacing="6">
															<Label
																FontFamily="FASolid"
																FontSize="11"
																Text="&#xf017;"
																TextColor="{StaticResource SparkTextMuted}" />
															<Label
																FontSize="12.5"
																Text="{Binding Time}"
																TextColor="{StaticResource SparkTextSecondary}" />
															<Label
																FontSize="12.5"
																Text="•"
																TextColor="{StaticResource SparkBorderSubtle}" />
															<Label
																FontSize="12.5"
																Text="{Binding RelativeDay}"
																TextColor="{StaticResource SparkTextMuted}" />
														</HorizontalStackLayout>
													</VerticalStackLayout>

													<Border
														Grid.Column="3"
														Padding="12,6"
														BackgroundColor="{Binding StatusColor}"
														Opacity="0.9"
														StrokeThickness="0"
														VerticalOptions="Center">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="20" />
														</Border.StrokeShape>
														<Label
															FontAttributes="Bold"
															FontSize="11"
															HorizontalTextAlignment="Center"
															Text="{Binding RelativeDay}"
															TextColor="White" />
													</Border>

												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</Grid>
						</Border>

						<!--  ── Прегледи по датум ────────────────────────────  -->
						<Border Grid.Column="1" Style="{StaticResource PageHeaderCardStyle}">
							<Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

								<Grid ColumnDefinitions="*,Auto">
									<Label Style="{StaticResource DashboardCardTitle}" Text="Прегледи по датум" />
									<Border
										Grid.Column="1"
										Padding="10,5"
										MinimumHeightRequest="30"
										MinimumWidthRequest="30"
										Style="{StaticResource DashboardCardCountBadge}">
										<Label
											FontAttributes="Bold"
											FontSize="14"
											Style="{StaticResource DashboardCardCountLabel}"
											Text="{Binding State.DailyEncounters.Count}" />
									</Border>
								</Grid>

								<!--  Day navigator  -->
								<!--  Day navigator  -->
								<Grid
									Grid.Row="1"
									ColumnDefinitions="Auto,*,Auto,Auto"
									ColumnSpacing="6"
									VerticalOptions="Center">

									<!--  Previous week  -->
									<Border
										Grid.Column="0"
										Padding="0"
										BackgroundColor="{StaticResource SparkSurface}"
										HeightRequest="60"
										SemanticProperties.Description="Претходна недела"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeThickness="1"
										ToolTipProperties.Text="Претходна недела"
										VerticalOptions="Center"
										WidthRequest="60">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="12" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="40"
											HorizontalOptions="Center"
											HorizontalTextAlignment="Center"
											Text="‹"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center"
											VerticalTextAlignment="Center" />
									</Border>

									<!--  Day strip  -->
									<ScrollView
										Grid.Column="1"
										HorizontalScrollBarVisibility="Never"
										Orientation="Horizontal"
										VerticalOptions="Center">
										<HorizontalStackLayout
											BindableLayout.ItemsSource="{Binding State.DayStrip}"
											Spacing="8"
											VerticalOptions="Center">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="dash:DashboardDayItem">
													<Border
														Padding="0"
														HeightRequest="52"
														StrokeThickness="1"
														VerticalOptions="Center"
														WidthRequest="44">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="12" />
														</Border.StrokeShape>
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Command}" />
														</Border.GestureRecognizers>
														<Border.Triggers>
															<DataTrigger
																Binding="{Binding IsSelected}"
																TargetType="Border"
																Value="True">
																<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
															</DataTrigger>
															<DataTrigger
																Binding="{Binding IsSelected}"
																TargetType="Border"
																Value="False">
																<Setter Property="BackgroundColor" Value="{StaticResource SparkSurface}" />
																<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
															</DataTrigger>
														</Border.Triggers>

														<VerticalStackLayout
															HorizontalOptions="Center"
															Spacing="1"
															VerticalOptions="Center">
															<Label
																FontSize="10"
																HorizontalTextAlignment="Center"
																Text="{Binding DayLabel}">
																<Label.Triggers>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Label"
																		Value="True">
																		<Setter Property="TextColor" Value="White" />
																	</DataTrigger>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Label"
																		Value="False">
																		<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
																	</DataTrigger>
																</Label.Triggers>
															</Label>
															<Label
																FontAttributes="Bold"
																FontSize="15"
																HorizontalTextAlignment="Center"
																Text="{Binding DayNumber}">
																<Label.Triggers>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Label"
																		Value="True">
																		<Setter Property="TextColor" Value="White" />
																	</DataTrigger>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Label"
																		Value="False">
																		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																	</DataTrigger>
																</Label.Triggers>
															</Label>
															<BoxView
																CornerRadius="2"
																HeightRequest="4"
																HorizontalOptions="Center"
																IsVisible="{Binding HasEncounters}"
																WidthRequest="4">
																<BoxView.Triggers>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="BoxView"
																		Value="True">
																		<Setter Property="Color" Value="White" />
																	</DataTrigger>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="BoxView"
																		Value="False">
																		<Setter Property="Color" Value="{StaticResource SparkAccentTeal}" />
																	</DataTrigger>
																</BoxView.Triggers>
															</BoxView>
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</HorizontalStackLayout>
									</ScrollView>

									<!--  Next week  -->
									<Border
										Grid.Column="2"
										Padding="0"
										BackgroundColor="{StaticResource SparkSurface}"
										HeightRequest="60"
										SemanticProperties.Description="Следна недела"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeThickness="1"
										ToolTipProperties.Text="Следна недела"
										VerticalOptions="Center"
										WidthRequest="60">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="12" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NextWeekCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="42"
											HorizontalOptions="Center"
											HorizontalTextAlignment="Center"
											Text="›"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center"
											VerticalTextAlignment="Center" />
									</Border>

									<!--  Calendar jump  -->
									<Grid
										Grid.Column="3"
										HeightRequest="60"
										VerticalOptions="Center"
										WidthRequest="60">
										<Border
											BackgroundColor="{StaticResource SparkSurface}"
											SemanticProperties.Description="Отвори календар"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeThickness="1"
											ToolTipProperties.Text="Отвори календар">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="6" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Tapped="OnCalendarIconTapped" />
											</Border.GestureRecognizers>
											<Label
												FontFamily="FASolid"
												FontSize="40"
												HorizontalOptions="Center"
												HorizontalTextAlignment="Center"
												Text="&#xf133;"
												TextColor="{StaticResource Gray600}"
												VerticalOptions="Center"
												VerticalTextAlignment="Center" />
										</Border>
										<DatePicker
											x:Name="CalendarDatePicker"
											BackgroundColor="Transparent"
											Date="{Binding SelectedDate}"
											HeightRequest="44"
											IsVisible="False"
											WidthRequest="44" />
									</Grid>
								</Grid>

								<!--  Encounters for selected date  -->
								<CollectionView
									Grid.Row="2"
									ItemsSource="{Binding State.DailyEncounters}"
									SelectionMode="None">

									<CollectionView.EmptyView>
										<VerticalStackLayout
											Padding="20"
											HorizontalOptions="Center"
											Spacing="6"
											VerticalOptions="Center">
											<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема прегледи за избраниот датум" />
										</VerticalStackLayout>
									</CollectionView.EmptyView>

									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="dash:DashboardEncounterItem">
											<Border
												Margin="0,0,0,10"
												Padding="0"
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeThickness="1">

												<Border.Shadow>
													<Shadow
														Brush="{StaticResource SparkTextPrimary}"
														Opacity="0.08"
														Radius="10"
														Offset="0,3" />
												</Border.Shadow>
												<Border.StrokeShape>
													<RoundRectangle CornerRadius="14" />
												</Border.StrokeShape>

												<Grid Padding="0,12,14,12" ColumnDefinitions="4,Auto,*,Auto">
													<BoxView
														Grid.Column="0"
														BackgroundColor="{Binding StatusColor}"
														HorizontalOptions="Start"
														WidthRequest="4" />

													<Label
														Grid.Column="1"
														Margin="14,0,14,0"
														FontAttributes="Bold"
														FontSize="15"
														Text="{Binding Time}"
														TextColor="{StaticResource SparkTextPrimary}"
														VerticalOptions="Center" />

													<Label
														Grid.Column="2"
														FontSize="14"
														Text="{Binding PatientName}"
														TextColor="{StaticResource SparkTextPrimary}"
														VerticalOptions="Center" />

													<Border
														Grid.Column="3"
														Padding="12,6"
														BackgroundColor="{Binding StatusColor}"
														Opacity="0.9"
														StrokeThickness="0"
														VerticalOptions="Center">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="20" />
														</Border.StrokeShape>
														<Label
															FontAttributes="Bold"
															FontSize="11"
															HorizontalTextAlignment="Center"
															Text="{Binding StatusText}"
															TextColor="White" />
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>

							</Grid>
						</Border>

					</Grid>

				</VerticalStackLayout>
			</ScrollView>

		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
