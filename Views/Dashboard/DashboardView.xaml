									Text="{Binding OverdueCycles}"
									TextColor="{Binding OverdueCyclesVariant, Converter={StaticResource MetricTileVariantToColorConverter}}" />
							</VerticalStackLayout>
						</Border>

						<Border Grid.Column="4" Style="{StaticResource DashboardKpiTile}">
