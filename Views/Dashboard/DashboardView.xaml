<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.DashboardView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="Page"
	x:DataType="viewModels:DashboardViewModel"
	BackgroundColor="#191E29">

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border
			Grid.Column="0"
			BackgroundColor="{StaticResource Gray200}"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Border
			Grid.Column="1"
			BackgroundColor="{StaticResource Gray100}"
			StrokeThickness="0">
			<Grid
				Padding="28"
				BackgroundColor="{StaticResource AppBackground}"
				RowDefinitions="110,Auto,*"
				RowSpacing="6">
				<Border
					Grid.Row="0"
					Padding="20"
					StrokeShape="RoundRectangle 0"
					Style="{StaticResource SurfaceCard}">
					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

						<controls:FFPageHeader
							Title="Основна страна"
							Caption="Dashboard"
							Subtitle="Преглед на пациентите, терапиите, закажаните прегледи и активноста на системот." />

						<HorizontalStackLayout
							Grid.Column="1"
							Spacing="10"
							VerticalOptions="Center">
							<!--
								Removed BorderWidth="6" — a stray border width on what should
								be a solid-fill primary button. HeightRequest standardized to
								45 to match the icon button; let PrimaryButtonStyle drive the
								rest instead of per-instance overrides.
								
								NOTE: this still points at RefreshCommand. If "+ Преглед" means
								"start a new encounter/review" rather than "refresh," rebind
								to the appropriate new-encounter command in DashboardViewModel.
							-->
							<Button
								Command="{Binding RefreshCommand}"
								HeightRequest="45"
								Style="{StaticResource PrimaryButtonStyle}"
								Text="+ Преглед"
								WidthRequest="160" />

							<Button
								Command="{Binding NewAppointmentCommand}"
								HeightRequest="45"
								Style="{StaticResource PrimaryButtonStyle}"
								Text="+ Термин"
								WidthRequest="160" />

							<Button
								Command="{Binding RefreshCommand}"
								HeightRequest="45"
								Style="{StaticResource EhmrIconButton}"
								TextColor="Blue"
								WidthRequest="45" />
						</HorizontalStackLayout>
					</Grid>
				</Border>
				<Border Grid.Row="1" Padding="0">
					<Grid
						ColumnDefinitions="2.9*,1*"
						ColumnSpacing="10"
						RowSpacing="10">
						<VerticalStackLayout Grid.Column="0">
							<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пребарување на пациенти..."
								SearchText="{Binding PatientSearchText}"
								Tabs="{Binding Tabs}" />
							<Border>
								<controls:SparkDataGridView
									x:Name="PatientGrid"
									Columns="{Binding GridColumns}"
									CurrentPage="{Binding CurrentPage}"
									EditRowCommand="{Binding EditCommand}"
									NextPageCommand="{Binding NextPageCommand}"
									PageChangedCommand="{Binding PageChangedCommand}"
									PreviousPageCommand="{Binding PreviousPageCommand}"
									RowTappedCommand="{Binding SelectCommand}"
									Rows="{Binding GridRows}"
									TotalPages="{Binding TotalPages}" />
							</Border>

						</VerticalStackLayout>


						<VerticalStackLayout Grid.Column="1">
							<Border
								Grid.Row="0"
								Grid.Column="1"
								Padding="20"
								BackgroundColor="{StaticResource Gray50}"
								Stroke="{StaticResource Gray100}"
								StrokeShape="RoundRectangle 12">

								<Grid RowDefinitions="Auto,*" RowSpacing="18">
									<Grid ColumnDefinitions="*,Auto">
										<VerticalStackLayout Spacing="2">
											<Label
												CharacterSpacing="1.5"
												FontAttributes="Bold"
												FontSize="11"
												Text="TODAY"
												TextColor="{StaticResource Gray500}" />
											<Label
												FontAttributes="Bold"
												FontSize="20"
												Text="Денешни прегледи"
												TextColor="{StaticResource Gray900}" />
										</VerticalStackLayout>

										<Border
											Grid.Column="1"
											Padding="10,4"
											StrokeShape="RoundRectangle 14"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="{Binding UpcomingAppointmentsCount}"
												TextColor="{StaticResource Gray600}" />
										</Border>
									</Grid>

									<CollectionView
										Grid.Row="1"
										ItemsSource="{Binding Appointments}"
										SelectionMode="None">
										<CollectionView.ItemTemplate>
											<DataTemplate>
												<Border
													Margin="0,0,0,10"
													Padding="14"
													BackgroundColor="{StaticResource White}"
													Stroke="{StaticResource DashboardBorder}"
													StrokeShape="RoundRectangle 12">
													<Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="14">
														<Border
															BackgroundColor="{Binding StatusColor}"
															HeightRequest="56"
															StrokeShape="RoundRectangle 12"
															StrokeThickness="0"
															WidthRequest="56">
															<VerticalStackLayout
																HorizontalOptions="Center"
																Spacing="0"
																VerticalOptions="Center">
																<Label
																	FontAttributes="Bold"
																	FontSize="15"
																	HorizontalTextAlignment="Center"
																	Text="{Binding Time}"
																	TextColor="White" />
															</VerticalStackLayout>
														</Border>

														<VerticalStackLayout
															Grid.Column="1"
															Spacing="3"
															VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="15"
																Text="{Binding PatientName}"
																TextColor="{StaticResource Gray900}" />
															<Label
																FontSize="13"
																Text="{Binding RelativeDay}"
																TextColor="{StaticResource Gray500}" />
															<Label
																FontSize="12"
																Text="{Binding ScheduledStart, StringFormat='{}{0:dd MMM yyyy}'}"
																TextColor="{StaticResource Gray400}" />
														</VerticalStackLayout>

														<Border
															Grid.Column="2"
															Padding="10,5"
															BackgroundColor="{Binding StatusColor}"
															StrokeShape="RoundRectangle 20"
															StrokeThickness="0"
															VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="11"
																Text="{Binding RelativeDay}"
																TextColor="White" />
														</Border>
													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>



							<Border
								Padding="20"
								BackgroundColor="{StaticResource Gray100}"
								Stroke="{StaticResource Gray50}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid RowDefinitions="Auto,*" RowSpacing="14">
									<Label Text="Известувања" TextColor="{StaticResource Gray600}" />
									<CollectionView
										Grid.Row="1"
										HeightRequest="240"
										ItemsSource="{Binding Notifications}">
										<CollectionView.ItemTemplate>
											<DataTemplate>
												<Border
													Margin="0,4"
													Padding="16"
													BackgroundColor="{StaticResource Gray100}"
													Stroke="{StaticResource Gray50}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="1">
													<Grid
														ColumnDefinitions="Auto,*"
														ColumnSpacing="18"
														RowSpacing="6">
														<Label
															FontSize="22"
															Text="⚠"
															TextColor="#F59E0B"
															VerticalOptions="Center" />
														<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																Text="{Binding Title}"
																TextColor="{StaticResource Gray700}" />
															<Label
																FontSize="12"
																Text="{Binding Time}"
																TextColor="{StaticResource Gray600}" />
														</VerticalStackLayout>
													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>
						</VerticalStackLayout>


					</Grid>

				</Border>

				<!--  ================= BODY =================  -->
				<Border
					Grid.Row="2"
					StrokeShape="RoundRectangle 0"
					StrokeThickness="0">
					<Grid ColumnDefinitions="3*,1*" ColumnSpacing="20">
						<!--
							Was RowDefinitions="Auto, Auto,*" with Row 0 left unassigned —
							dead space above the divider. Collapsed to Auto,* since nothing
							occupies a header row here; re-add a title row above the divider
							if the blueprint's list panel should carry one.
						-->
						<Grid
							Grid.Column="0"
							RowDefinitions="Auto,*"
							RowSpacing="6">

							<ScrollView Grid.Row="1">
								<VerticalStackLayout Spacing="20">


									<!--  CHARTS CONTAINER  -->
									<Grid ColumnDefinitions="*,*,*" ColumnSpacing="20">
										<controls:FFChart Title="Пациенти" Values="{Binding PatientTrend}" />
										<controls:FFChart
											Title="Прегледи"
											Grid.Column="1"
											Values="{Binding AppointmentTrend}" />
										<controls:FFChart
											Title="Терапии"
											Grid.Column="2"
											Values="{Binding TherapyStats}" />
									</Grid>
								</VerticalStackLayout>
							</ScrollView>
						</Grid>

						<!--  ================= RIGHT SIDEBAR =================  -->

					</Grid>
				</Border>
			</Grid>
		</Border>
	</Grid>
</ContentPage>