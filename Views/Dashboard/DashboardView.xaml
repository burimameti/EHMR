<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.DashboardView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dash="clr-namespace:EHMR.ViewModels"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="Page"
	x:DataType="viewModels:DashboardViewModel"
	BackgroundColor="#191E29">

	<ContentPage.Resources>
		<ResourceDictionary>

			<converters:MetricTileVariantToColorConverter x:Key="MetricTileVariantToColorConverter" />

			<!--  Single KPI tile — accent bar color driven by MetricTileVariant via converter  -->
			<Style x:Key="DashboardKpiTile" TargetType="Border">
				<Setter Property="Padding" Value="18,14" />
				<Setter Property="BackgroundColor" Value="{StaticResource Gray50}" />
				<Setter Property="Stroke" Value="{StaticResource Gray100}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			</Style>

			<Style x:Key="DashboardKpiLabel" TargetType="Label">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardKpiValue" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="26" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<!--  Shared style for the two bottom summary cards (appointments / auditing)  -->
			<Style x:Key="DashboardSummaryCard" TargetType="Border">
				<Setter Property="Padding" Value="20" />
				<Setter Property="BackgroundColor" Value="{StaticResource White}" />
				<Setter Property="Stroke" Value="{StaticResource Gray100}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			</Style>

			<!--  Card title, e.g. "Денешни прегледи" / "Информации за аудитинг"  -->
			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<!--  Count pill next to the card title  -->
			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 14" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<!--  Row card inside each CollectionView (appointment row / notification row)  -->
			<Style x:Key="DashboardListRow" TargetType="Border">
				<Setter Property="Margin" Value="0,8" />
				<Setter Property="Padding" Value="10" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkSurface}" />
				<Setter Property="HeightRequest" Value="60" />
				<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="1" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border
			Grid.Column="0"
			BackgroundColor="{StaticResource Gray200}"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Border
			Grid.Column="1"
			BackgroundColor="{StaticResource Gray200}"
			StrokeThickness="0">
			<Grid>

				<Grid RowDefinitions="110,Auto,Auto,2*,1.1*" RowSpacing="0">

					<!--  ===================================================  -->
					<!--  HEADER — untouched  -->
					<!--  ===================================================  -->
					<Border Grid.Row="0" Style="{StaticResource SparkCardStyle}">
						<Grid ColumnDefinitions="*,*" VerticalOptions="Center">
							<controls:FFPageHeader Title="Почетна страна" Subtitle="Преглед на пациентите, терапии, прегледи и други активносто." />
							<HorizontalStackLayout
								Grid.Column="1"
								HorizontalOptions="End"
								Spacing="10"
								VerticalOptions="Center">
								<Button
									BackgroundColor="{StaticResource SparkAccentTeal}"
									Command="{Binding NewEncounterCommand}"
									HeightRequest="45"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="+ Преглед"
									WidthRequest="160" />
								<Button
									BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
									Command="{Binding NewAppointmentCommand}"
									HeightRequest="45"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="+ Термин"
									WidthRequest="160" />
							</HorizontalStackLayout>
						</Grid>
					</Border>

					<!--  ===================================================  -->
					<!--  KPI TILE ROW — was a bare comment before, never rendered  -->
					<!--  ===================================================  -->
					<!--<Grid
						Grid.Row="1"
						ColumnDefinitions="*,*,*,*,*"
						ColumnSpacing="12">

						<Border Grid.Column="0" Style="{StaticResource DashboardKpiTile}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding OpenKpiCommand}" CommandParameter="patients" />
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="4">
								<Label Style="{StaticResource DashboardKpiLabel}" Text="Пациенти" />
								<Label Style="{StaticResource DashboardKpiValue}" Text="{Binding TotalPatients}" />
							</VerticalStackLayout>
						</Border>

						<Border Grid.Column="1" Style="{StaticResource DashboardKpiTile}">
