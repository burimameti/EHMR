<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.DashboardView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:admin="clr-namespace:EHMR.ViewModels.Admin"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dash="clr-namespace:EHMR.ViewModels.Dashboard.Models"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="ThisPage"
	x:DataType="viewModels:DashboardViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<converters:MetricTileVariantToColorConverter x:Key="MetricTileVariantToColorConverter" />
			<converters:EncounterStatusChipBackgroundConverter x:Key="EncounterStatusChipBg" />
			<converters:EncounterStatusChipTextConverter x:Key="EncounterStatusChipFg" />
			<converters:EncounterStatusChipLabelConverter x:Key="EncounterStatusChipLabel" />
			<DataTemplate x:Key="DashboardKpiTemplate" x:DataType="admin:FFMetricTileItem">

				<Border
					Padding="12,8"
					BackgroundColor="White"
					HeightRequest="72"
					HorizontalOptions="FillAndExpand"
					Stroke="{Binding Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1.5">
					<Grid
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="8"
						RowDefinitions="Auto,Auto"
						RowSpacing="3">
						<Border
							Grid.RowSpan="2"
							BackgroundColor="{Binding Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
							HeightRequest="30"
							StrokeShape="RoundRectangle 8"
							StrokeThickness="0"
							VerticalOptions="Start"
							WidthRequest="30">
							<Label
								FontFamily="FASolid"
								FontSize="12"
								HorizontalOptions="Center"
								Text="{Binding Icon}"
								TextColor="White"
								VerticalOptions="Center" />
						</Border>
						<Label
							Grid.Column="1"
							FontAttributes="Bold"
							FontSize="9"
							LineBreakMode="TailTruncation"
							MaxLines="1"
							Text="{Binding Title}"
							TextColor="{StaticResource SubtitleColor}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="2"
							FontAttributes="Bold"
							FontSize="19"
							Text="{Binding Value}"
							TextColor="{StaticResource TitleColor}"
							VerticalOptions="Center" />
						<Border
							Grid.Row="1"
							Grid.Column="1"
							Grid.ColumnSpan="2"
							Padding="8,4"
							BackgroundColor="{Binding Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
							HorizontalOptions="Fill"
							MinimumHeightRequest="28"
							StrokeThickness="0">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="8" />
							</Border.StrokeShape>
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
							</Border.GestureRecognizers>
							<Label
								FontAttributes="Bold"
								FontSize="10"
								HorizontalTextAlignment="Center"
								Text="Повеќе  ›"
								TextColor="White" />
						</Border>
					</Grid>
				</Border>

			</DataTemplate>

			<Style
				x:Key="DashboardSummaryCard"
				BasedOn="{StaticResource PageCardStyleDashboard}"
				TargetType="Border">
				<Setter Property="Padding" Value="20" />
			</Style>

			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="15" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 14" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

			<Style x:Key="AlertChipBorder" TargetType="Border">
				<Setter Property="Padding" Value="14,10" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			</Style>
			<Style x:Key="AppointmentCardStyle" TargetType="Border">
				<Setter Property="Padding" Value="0" />
				<Setter Property="BackgroundColor" Value="White" />
				<Setter Property="Stroke" Value="#E6EDF3" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 14" />
			</Style>

			<Style x:Key="AppointmentRowStyle" TargetType="Border">
				<Setter Property="Margin" Value="0,0,0,7" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="BackgroundColor" Value="#F8FBFC" />
				<Setter Property="Stroke" Value="#E7EEF2" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 9" />
			</Style>
			<DataTemplate x:Key="DashboardDiagnosisHistoryTemplate" x:DataType="domain:Diagnosis">
				<Border
					Margin="0,0,0,6"
					Padding="10,8"
					BackgroundColor="{StaticResource SparkContentBackground}"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 10"
					StrokeThickness="1">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12.5"
							Text="{Binding Mkb10Code.Code}"
							TextColor="{StaticResource SparkAccentTealDark}" />
						<Label
							Grid.Column="1"
							FontSize="11.5"
							Text="{Binding Mkb10Code.Description}"
							TextColor="{StaticResource SparkTextPrimary}" />
					</Grid>
				</Border>
			</DataTemplate>
			<DataTemplate x:Key="DashboardAppointmentHistoryTemplate" x:DataType="domain:Appointment">
				<Border
					Margin="0,0,0,6"
					Padding="10,8"
					BackgroundColor="{StaticResource SparkContentBackground}"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 10"
					StrokeThickness="1">
					<Grid ColumnDefinitions="*,Auto">
						<Label
							FontAttributes="Bold"
							FontSize="12.5"
							Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							Grid.Column="1"
							FontSize="11.5"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTealDark}" />
					</Grid>
				</Border>
			</DataTemplate>
			<DataTemplate x:Key="DashboardMedicineHistoryTemplate" x:DataType="domain:PatientMedicine">
				<Border
					Margin="0,0,0,6"
					Padding="10,8"
					BackgroundColor="{StaticResource SparkContentBackground}"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 10"
					StrokeThickness="1">
					<Grid ColumnDefinitions="*,Auto">
						<Label
							FontAttributes="Bold"
							FontSize="12.5"
							Text="{Binding Medicine.Name}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							Grid.Column="1"
							FontSize="11.5"
							Text="{Binding Dosage}"
							TextColor="{StaticResource SparkAccentTealDark}" />
					</Grid>
				</Border>
			</DataTemplate>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="260,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="2,2,2,2"
			RowDefinitions="Auto,*"
			RowSpacing="01">

			<!--  ===================================================  -->
			<!--  HEADER  -->
			<!--  ===================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid
					BackgroundColor="{StaticResource White}"
					ColumnDefinitions="*,Auto,Auto"
					VerticalOptions="Center">

					<!--  COL 0: TITLE — untouched  -->
					<controls:FFPageHeader
						Title="Почетна страна"
						Grid.Column="0"
						Subtitle="" />

					<!--
						COL 1: ALERTS
						FIX: CollectionView inside an "Auto" Grid column is a known MAUI
						measurement bug — it either collapses to zero width or refuses
						to size itself to its content, so the three chips could end up
						squeezed, wrapped, or clipped instead of sitting in one row.
						Since this is a small, fixed set of alert chips (not a scrolling
						list), swapping to HorizontalStackLayout + BindableLayout avoids
						the CollectionView measurement issue entirely: a StackLayout
						sizes correctly inside an Auto column every time, so all three
						cards are guaranteed to lay out side-by-side, horizontally,
						without affecting the "*" title column or the Auto button
						column next to it.
					-->
					<HorizontalStackLayout
						Grid.Column="1"
						Margin="12,8,12,8"
						BindableLayout.ItemsSource="{Binding State.AlertSummaries}"
						Spacing="10"
						VerticalOptions="Center">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="dash:DashboardAlertSummaryItem">
								<Border
									Padding="14,0"
									BackgroundColor="{Binding BackgroundColor}"
									HeightRequest="45"
									Stroke="{Binding AccentColor}"
									Style="{StaticResource AlertChipBorder}"
									VerticalOptions="Center">
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Command}" />
									</Border.GestureRecognizers>
									<Grid
										ColumnDefinitions="Auto,Auto"
										ColumnSpacing="6"
										VerticalOptions="Center">
										<Label
											FontFamily="FASolid"
											FontSize="18"
											Text="{Binding Icon}"
											TextColor="{Binding AccentColor}"
											VerticalOptions="Center" />
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="0"
											VerticalOptions="Center">
											<Label
												FontAttributes="Bold"
												FontSize="14"
												Text="{Binding Count}"
												TextColor="{Binding AccentColor}" />
											<Label
												FontSize="8"
												Text="{Binding Label}"
												TextColor="{Binding AccentColor}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
					<!--  COL 2: BUTTONS — untouched  -->
					<!--<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
						BackgroundColorEx="{StaticResource SparkButtonSecondaryBg}"
						TextColorEx="White"
							ButtonKind="Primary"
							Command="{Binding NewEncounterCommand}"
							ContentPadding="20,0"
							HeightRequestEx="45"
							Text="Нов преглед" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding NewAppointmentCommand}"
							ContentPadding="20,0"
							HeightRequestEx="45"
							Text="Нов термин" />
					</HorizontalStackLayout>-->
				</Grid>
			</Border>
			<Border Grid.Row="1" StrokeThickness="0">
				<!--  MAIN SCROLL AREA  -->
				<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">

						<!-- KPI strip disabled. -->
							Margin="12,12,12,12"
							ColumnDefinitions="*,*,*,*,*"
							ColumnSpacing="28"
							HorizontalOptions="Fill"
							Style="{StaticResource CrudFormPageGridStyle}">
							<Border
								Grid.Column="0"
								Padding="12,12"
								BackgroundColor="White"
								HeightRequest="88"
								HorizontalOptions="Fill"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1.9">
								<Grid
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="8"
									RowDefinitions="Auto,Auto"
									RowSpacing="3">
									<Border
										Grid.RowSpan="2"
										BackgroundColor="{Binding Kpi0.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="27"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="0"
										VerticalOptions="Start"
										WidthRequest="27">
										<Label
											FontFamily="FASolid"
											FontSize="11"
											HorizontalOptions="Center"
											Text="&#xf0c0;"
											TextColor="White"
											VerticalOptions="Center" />
									</Border>
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="9"
										LineBreakMode="TailTruncation"
										MaxLines="1"
										Text="ПАЦИЕНТИ ВКУПНО"
										TextColor="{StaticResource SubtitleColor}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontAttributes="Bold"
										FontSize="18"
										Text="{Binding State.TotalPatients}"
										TextColor="{StaticResource TitleColor}"
										VerticalOptions="Center" />
									<Border
										Grid.Row="1"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Padding="6,2"
										BackgroundColor="{Binding Kpi0.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="22"
										HorizontalOptions="Fill"
										StrokeThickness="0">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="8" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NavigateToPatientsCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="9"
											HorizontalTextAlignment="Center"
											Text="Повеќе  ›"
											TextColor="White" />
									</Border>
								</Grid>
							</Border>
							<Border
								Grid.Column="1"
								Padding="12,12"
								BackgroundColor="White"
								HeightRequest="88"
								HorizontalOptions="Fill"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1.9">
								<Grid
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="8"
									RowDefinitions="Auto,Auto"
									RowSpacing="3">
									<Border
										Grid.RowSpan="2"
										BackgroundColor="{Binding Kpi1.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="27"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="0"
										VerticalOptions="Start"
										WidthRequest="27">
										<Label
											FontFamily="FASolid"
											FontSize="12"
											HorizontalOptions="Center"
											Text="&#xf133;"
											TextColor="White"
											VerticalOptions="Center" />
									</Border>
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="9"
										LineBreakMode="TailTruncation"
										MaxLines="1"
										Text="АКТИВНИ ТЕРМИНИ"
										TextColor="{StaticResource SubtitleColor}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontAttributes="Bold"
										FontSize="18"
										Text="{Binding State.UpcomingAppointmentsCount}"
										TextColor="{StaticResource TitleColor}"
										VerticalOptions="Center" />
									<Border
										Grid.Row="1"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Padding="6,2"
										BackgroundColor="{Binding Kpi1.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="22"
										HorizontalOptions="Fill"
										StrokeThickness="0">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="8" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NavigateToAppointmentsCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="9"
											HorizontalTextAlignment="Center"
											Text="Повеќе  ›"
											TextColor="White" />
									</Border>
								</Grid>
							</Border>
							<Border
								Grid.Column="2"
								Padding="12,12"
								BackgroundColor="White"
								HeightRequest="88"
								HorizontalOptions="Fill"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1.9">
								<Grid
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="8"
									RowDefinitions="Auto,Auto"
									RowSpacing="3">
									<Border
										Grid.RowSpan="2"
										BackgroundColor="{Binding Kpi2.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="27"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="0"
										VerticalOptions="Start"
										WidthRequest="27">
										<Label
											FontFamily="FASolid"
											FontSize="11"
											HorizontalOptions="Center"
											Text="&#xf058;"
											TextColor="White"
											VerticalOptions="Center" />
									</Border>
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="9"
										LineBreakMode="TailTruncation"
										MaxLines="1"
										Text="ЗАВРШЕНИ ДЕНЕС ПРЕГЛЕДИ"
										TextColor="{StaticResource SubtitleColor}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontAttributes="Bold"
										FontSize="18"
										Text="{Binding State.CompletedToday}"
										TextColor="{StaticResource TitleColor}"
										VerticalOptions="Center" />
									<Border
										Grid.Row="1"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Padding="6,2"
										BackgroundColor="{Binding Kpi2.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="22"
										HorizontalOptions="Fill"
										StrokeThickness="0">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="8" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NavigateToEncountersCommand}" CommandParameter="Completed" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="9"
											HorizontalTextAlignment="Center"
											Text="Повеќе  ›"
											TextColor="White" />
									</Border>
								</Grid>
							</Border>
							<Border
								Grid.Column="3"
								Padding="12,12"
								BackgroundColor="White"
								HeightRequest="88"
								HorizontalOptions="Fill"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1.9">
								<Grid
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="8"
									RowDefinitions="Auto,Auto"
									RowSpacing="3">
									<Border
										Grid.RowSpan="2"
										BackgroundColor="{Binding Kpi3.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="27"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="0"
										VerticalOptions="Start"
										WidthRequest="27">
										<Label
											FontFamily="FASolid"
											FontSize="12"
											HorizontalOptions="Center"
											Text="&#xf254;"
											TextColor="White"
											VerticalOptions="Center" />
									</Border>
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="9"
										LineBreakMode="TailTruncation"
										MaxLines="1"
										Text="ЗАКАЖАНИ И ПРИЈАВЕНИ"
										TextColor="{StaticResource SubtitleColor}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontAttributes="Bold"
										FontSize="18"
										Text="{Binding State.WaitingToday}"
										TextColor="{StaticResource TitleColor}"
										VerticalOptions="Center" />
									<Border
										Grid.Row="1"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Padding="6,2"
										BackgroundColor="{Binding Kpi3.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="22"
										HorizontalOptions="Fill"
										StrokeThickness="0">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="8" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NavigateToEncountersCommand}" CommandParameter="Scheduled" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="9"
											HorizontalTextAlignment="Center"
											Text="Повеќе  ›"
											TextColor="White" />
									</Border>
								</Grid>
							</Border>
							<Border
								Grid.Column="4"
								Padding="12,12"
								BackgroundColor="White"
								HeightRequest="88"
								HorizontalOptions="Fill"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1.9">
								<Grid
									ColumnDefinitions="Auto,*,Auto"
									ColumnSpacing="8"
									RowDefinitions="Auto,Auto"
									RowSpacing="3">
									<Border
										Grid.RowSpan="2"
										BackgroundColor="{Binding Kpi4.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="27"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="0"
										VerticalOptions="Start"
										WidthRequest="27">
										<Label
											FontFamily="FASolid"
											FontSize="12"
											HorizontalOptions="Center"
											Text="&#xf492;"
											TextColor="White"
											VerticalOptions="Center" />
									</Border>
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="9"
										LineBreakMode="TailTruncation"
										MaxLines="1"
										Text="ВО ТЕК"
										TextColor="{StaticResource SubtitleColor}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontAttributes="Bold"
										FontSize="18"
										Text="{Binding State.ActiveTherapies}"
										TextColor="{StaticResource TitleColor}"
										VerticalOptions="Center" />
									<Border
										Grid.Row="1"
										Grid.Column="1"
										Grid.ColumnSpan="2"
										Padding="6,2"
										BackgroundColor="{Binding Kpi4.Variant, Converter={StaticResource MetricTileVariantToColorConverter}}"
										HeightRequest="22"
										HorizontalOptions="Fill"
										StrokeThickness="0">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="8" />
										</Border.StrokeShape>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NavigateToTherapiesCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontAttributes="Bold"
											FontSize="9"
											HorizontalTextAlignment="Center"
											Text="Повеќе  ›"
											TextColor="White" />
									</Border>
								</Grid>
							</Border>
						</Grid>


						<!--  ===================================================  -->
						<!--  PATIENT EXPLORER  -->
						<!--  ===================================================  -->

						<Grid ColumnDefinitions="*">

							<controls:FFSectionCard>
								<VerticalStackLayout>

									<controls:SparkExplorerHeaderView
										Buttons="{Binding Buttons}"
										SearchPlaceholder="Пребарување на пациенти..."
										SearchText="{Binding PatientSearchText}"
										SelectedSuggestion="{Binding SelectedPatientSuggestion, Mode=TwoWay}"
										ShowCyrillicToggle="True"
										ShowSuggestions="{Binding ShowPatientSuggestions}"
										Suggestions="{Binding PatientSuggestions}"
										Tabs="{Binding Tabs}"
										TabsVisible="{Binding ShowTabs}"
										UseCyrillicInput="{Binding UseCyrillicSearch, Mode=TwoWay}">
										<controls:SparkExplorerHeaderView.SuggestionTemplate>
											<DataTemplate x:DataType="{x:Null}">
												<Border
													BackgroundColor="{StaticResource Gray100}"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeShape="RoundRectangle 2"
													StrokeThickness="1.2">
													<Grid ColumnDefinitions="1.7*,1.1*,1.1*,1*" ColumnSpacing="14">
														<VerticalStackLayout Spacing="1">
															<Label
																FontSize="10"
																Text="Име и презиме"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="1" Spacing="1">
															<Label
																FontSize="10"
																Text="ЕМБГ"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.NationalId}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="2" Spacing="1">
															<Label
																FontSize="10"
																Text="СЗБО број"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.SzboNumber}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="3" Spacing="1">
															<Label
																FontSize="14"
																HorizontalOptions="Center"
																Text="Последен преглед"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Border
																Padding="8,4"
																BackgroundColor="{Binding LatestEncounterStatus, Converter={StaticResource EncounterStatusChipBg}}"
																HorizontalOptions="Center"
																StrokeThickness="0"
																VerticalOptions="Start">
																<Border.StrokeShape>
																	<RoundRectangle CornerRadius="8" />
																</Border.StrokeShape>
																<Label
																	FontAttributes="Bold"
																	FontSize="12"
																	Text="{Binding LatestEncounterStatus, Converter={StaticResource EncounterStatusChipLabel}}"
																	TextColor="{Binding LatestEncounterStatus, Converter={StaticResource EncounterStatusChipFg}}" />
															</Border>
														</VerticalStackLayout>
													</Grid>
												</Border>
											</DataTemplate>
										</controls:SparkExplorerHeaderView.SuggestionTemplate>
									</controls:SparkExplorerHeaderView>

									<Grid
										Margin="0,8,0,10"
										ColumnDefinitions="*,Auto"
										ColumnSpacing="12"
										IsVisible="{Binding IsEncounterHistoryMode}">
										<controls:CrudSectionHeader Title="ПРЕГЛЕДИ НА ИЗБРАН ПАЦИЕНТ" />
										<HorizontalStackLayout
											Grid.Column="1"
											IsVisible="{Binding HasEncounterYearOptions}"
											Spacing="8"
											VerticalOptions="Center">
											<Label
												FontAttributes="Bold"
												FontSize="11.5"
												Text="Година"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<controls:FFPicker
												ItemsSource="{Binding AvailableEncounterYears}"
												Label=""
												MinimumWidthRequest="105"
												SelectedItem="{Binding SelectedEncounterYear, Mode=TwoWay}" />
										</HorizontalStackLayout>
									</Grid>

									<controls:SparkDataGridView
										AutoSelectFirstRow="False"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										EditRowCommand="{Binding EditCommand}"
										HyperlinkCommand="{Binding OpenDashboardGridItemCommand}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										RowTappedCommand="{Binding OpenDashboardGridItemCommand}"
										Rows="{Binding GridRows}"
										SelectionChangedCommand="{Binding OpenDashboardGridItemCommand}"
										ShowPagination="{Binding IsPatientGridMode}"
										TotalPages="{Binding TotalPages}" />
								</VerticalStackLayout>
							</controls:FFSectionCard>



						</Grid>





						<!--  ── Термини по датум ────────────────────────────  -->
						<controls:FFSectionCard>
							<VerticalStackLayout Padding="0">

								<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
									<VerticalStackLayout
										Grid.Column="0"
										Spacing="2"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="16"
											Text="Термини по датум"
											TextColor="{StaticResource TitleColor}" />
										<Label
											FontSize="11"
											Text="{Binding SelectedDate, StringFormat='{0:dddd, dd MMMM yyyy}'}"
											TextColor="{StaticResource SubtitleColor}" />
									</VerticalStackLayout>
									<Border
										Grid.Column="1"
										Padding="0"
										BackgroundColor="Transparent"
										HeightRequest="28"
										SemanticProperties.Description="Отвори календар"
										Stroke="Transparent"
										StrokeThickness="0"
										ToolTipProperties.Text="Отвори календар"
										VerticalOptions="Center"
										WidthRequest="28">
										<Border.GestureRecognizers>
											<TapGestureRecognizer Tapped="OnCalendarIconTapped" />
										</Border.GestureRecognizers>
										<Label
											FontFamily="FASolid"
											FontSize="14"
											HorizontalOptions="Center"
											Text="&#xf133;"
											TextColor="{StaticResource LoginDark}"
											VerticalOptions="Center" />
									</Border>
									<DatePicker
										x:Name="CalendarDatePicker"
										Grid.Column="1"
										Date="{Binding SelectedDate}"
										HeightRequest="1"
										IsVisible="False"
										WidthRequest="1" />
									<Border
										Grid.Column="2"
										Padding="8,3"
										MinimumHeightRequest="24"
										MinimumWidthRequest="24"
										Style="{StaticResource DashboardCardCountBadge}">
										<Label Style="{StaticResource DashboardCardCountLabel}" Text="{Binding SelectedDateAppointments.Count}" />
									</Border>
									<Border
										Grid.Column="3"
										Padding="0"
										BackgroundColor="Transparent"
										HeightRequest="24"
										StrokeThickness="0"
										VerticalOptions="Center"
										WidthRequest="24">
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding ToggleDateCardCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontSize="12"
											HorizontalOptions="Center"
											HorizontalTextAlignment="Center"
											Text="&#x25BC;"
											TextColor="{StaticResource SparkTextMuted}"
											VerticalOptions="Center">
											<Label.Triggers>
												<DataTrigger
													Binding="{Binding IsDateCardExpanded}"
													TargetType="Label"
													Value="False">
													<Setter Property="Rotation" Value="-90" />
												</DataTrigger>
												<DataTrigger
													Binding="{Binding IsDateCardExpanded}"
													TargetType="Label"
													Value="True">
													<Setter Property="Rotation" Value="0" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
									</Border>
								</Grid>

								<VerticalStackLayout IsVisible="{Binding IsDateCardExpanded}" Spacing="10">

									<!--  caption above the day strip  -->
									<Label
										FontSize="12"
										Text="Изберете од неделните датуми"
										TextColor="{StaticResource LoginDark}" />

									<!--
										Day navigator — clean, no negative padding / oversized fonts (that overflow was
										blocking touch on the tiles), small refined calendar icon on its own row
									-->
									<Grid
										ColumnDefinitions="Auto,Auto,Auto"
										ColumnSpacing="6"
										HorizontalOptions="Start"
										VerticalOptions="Center">

										<Border
											Grid.Column="0"
											BackgroundColor="White"
											HeightRequest="40"
											SemanticProperties.Description="Претходна недела"
											Stroke="{StaticResource BorderColor}"
											StrokeThickness="1"
											ToolTipProperties.Text="Претходна недела"
											VerticalOptions="Center"
											WidthRequest="40">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="10" />
											</Border.StrokeShape>
											<Border.Shadow>
												<Shadow
													Brush="#334155"
													Opacity="0.20"
													Radius="5"
													Offset="0,2" />
											</Border.Shadow>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
											</Border.GestureRecognizers>
											<Label
												FontAttributes="Bold"
												FontSize="16"
												HorizontalOptions="Center"
												HorizontalTextAlignment="Center"
												Text="‹"
												TextColor="{StaticResource SparkAccentTeal}"
												VerticalOptions="Center"
												VerticalTextAlignment="Center" />
										</Border>

										<!--
											Day strip — each tile is its own tappable Border, sized to actually
											be clickable (38x40) with no overlapping siblings
										-->
										<ScrollView
											Grid.Column="1"
											Padding="3,5"
											HorizontalScrollBarVisibility="Never"
											Orientation="Horizontal"
											VerticalOptions="Center"
											WidthRequest="294">
											<HorizontalStackLayout
												BindableLayout.ItemsSource="{Binding State.DayStrip}"
												Spacing="6"
												VerticalOptions="Center">
												<BindableLayout.ItemTemplate>
													<DataTemplate x:DataType="dash:DashboardDayItem">
														<Border
															Padding="0"
															HeightRequest="40"
															InputTransparent="False"
															StrokeThickness="1"
															VerticalOptions="Center"
															WidthRequest="42">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="8" />
															</Border.StrokeShape>
															<Border.Shadow>
																<Shadow
																	Brush="#334155"
																	Opacity="0.16"
																	Radius="4"
																	Offset="0,2" />
															</Border.Shadow>
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Command}" />
															</Border.GestureRecognizers>
															<Border.Triggers>
																<DataTrigger
																	Binding="{Binding IsSelected}"
																	TargetType="Border"
																	Value="True">
																	<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																	<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding IsSelected}"
																	TargetType="Border"
																	Value="False">
																	<Setter Property="BackgroundColor" Value="White" />
																	<Setter Property="Stroke" Value="{StaticResource Gray400}" />
																</DataTrigger>
															</Border.Triggers>

															<VerticalStackLayout
																HorizontalOptions="Center"
																InputTransparent="True"
																Spacing="0"
																VerticalOptions="Center">
																<Label
																	FontSize="8"
																	HorizontalTextAlignment="Center"
																	Text="{Binding DayLabel}">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	HorizontalTextAlignment="Center"
																	Text="{Binding DayNumber}">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</BindableLayout.ItemTemplate>
											</HorizontalStackLayout>
										</ScrollView>

										<Border
											Grid.Column="2"
											BackgroundColor="White"
											HeightRequest="40"
											SemanticProperties.Description="Следна недела"
											Stroke="{StaticResource BorderColor}"
											StrokeThickness="1"
											ToolTipProperties.Text="Следна недела"
											VerticalOptions="Center"
											WidthRequest="40">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="10" />
											</Border.StrokeShape>
											<Border.Shadow>
												<Shadow
													Brush="#334155"
													Opacity="0.20"
													Radius="5"
													Offset="0,2" />
											</Border.Shadow>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding NextWeekCommand}" />
											</Border.GestureRecognizers>
											<Label
												FontAttributes="Bold"
												FontSize="16"
												HorizontalOptions="Center"
												HorizontalTextAlignment="Center"
												Text="›"
												TextColor="{StaticResource SparkAccentTeal}"
												VerticalOptions="Center"
												VerticalTextAlignment="Center" />
										</Border>
									</Grid>

									<!--  Appointments for selected date  -->
									<CollectionView
										HeightRequest="220"
										ItemsSource="{Binding SelectedDateAppointments}"
										SelectionMode="None">

										<CollectionView.EmptyView>
											<VerticalStackLayout
												Padding="16"
												HorizontalOptions="Center"
												Spacing="6"
												VerticalOptions="Center">
												<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема закажани термини за избраниот датум" />
											</VerticalStackLayout>
										</CollectionView.EmptyView>

										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="dash:DashboardAppointmentItem">
												<Border Style="{StaticResource AppointmentRowStyle}">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenAppointmentCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>

													<Grid
														Padding="0,12,12,12"
														ColumnDefinitions="3,Auto,*,Auto"
														ColumnSpacing="10">
														<BoxView
															Grid.Column="0"
															BackgroundColor="{Binding StatusColor}"
															HorizontalOptions="Start"
															WidthRequest="3" />

														<Label
															Grid.Column="1"
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Time}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />

														<Label
															Grid.Column="2"
															FontSize="12"
															LineBreakMode="TailTruncation"
															Text="{Binding PatientName}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />

														<Border
															Grid.Column="3"
															Padding="9,4"
															BackgroundColor="{Binding StatusColor}"
															Opacity="0.9"
															StrokeThickness="0"
															VerticalOptions="Center">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="10" />
															</Border.StrokeShape>
															<Label
																FontAttributes="Bold"
																FontSize="9"
																HorizontalTextAlignment="Center"
																Text="{Binding RelativeDay}"
																TextColor="White" />
														</Border>
													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</controls:FFSectionCard>



					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>
