<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.DashboardView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="Page"
	x:DataType="viewModels:DashboardViewModel"
	BackgroundColor="#191E29">

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border
			Grid.Column="0"
			BackgroundColor="{StaticResource Gray200}"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Border
			Grid.Column="1"
			BackgroundColor="{StaticResource Gray200}"
			StrokeThickness="0">
			<Grid BackgroundColor="{StaticResource AppBackground}">

				<Grid
					Padding="28"
					RowDefinitions="110,Auto,Auto,*"
					RowSpacing="20">

					<!--  HEADER  -->
					<Border
						Grid.Row="0"
						Padding="20"
						StrokeShape="RoundRectangle 0"
						Style="{StaticResource SurfaceCard}">
						<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

							<controls:FFPageHeader Title="Основна страна" Subtitle="Преглед на пациентите, терапиите, закажаните прегледи и активноста на системот." />

							<HorizontalStackLayout
								Grid.Column="1"
								Spacing="10"
								VerticalOptions="Center">
								<Button
									BackgroundColor="{StaticResource SparkAccentTeal}"
									Command="{Binding NewEncounterCommand}"
									HeightRequest="45"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="+ Преглед"
									WidthRequest="160" />

								<Button
									BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
									Command="{Binding NewAppointmentCommand}"
									HeightRequest="45"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="+ Термин"
									WidthRequest="160" />

								<Button
									Command="{Binding RefreshCommand}"
									HeightRequest="45"
									Style="{StaticResource EhmrIconButton}"
									TextColor="Blue"
									WidthRequest="45" />
							</HorizontalStackLayout>
						</Grid>
					</Border>

					<!--  KPI TILE ROW  -->


					<!--  FILTERS / GRID + APPOINTMENTS / NOTIFICATIONS  -->
					<Border Grid.Row="1" Padding="0">
						<Grid ColumnSpacing="5" RowSpacing="20">
							<VerticalStackLayout>
								<Border Margin="0,8,0,8" Padding="0">
									<controls:SparkExplorerHeaderView
										Buttons="{Binding Buttons}"
										Pickers="{Binding Pickers}"
										SearchCommand="{Binding SearchCommand}"
										SearchPlaceholder="Пребарување на пациенти..."
										SearchText="{Binding PatientSearchText}"
										Tabs="{Binding Tabs}" />
								</Border>
								<Border>
									<controls:SparkDataGridView
										x:Name="PatientGrid"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										EditRowCommand="{Binding EditCommand}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										RowTappedCommand="{Binding SelectCommand}"
										Rows="{Binding GridRows}"
										TotalPages="{Binding TotalPages}" />
								</Border>
							</VerticalStackLayout>

						</Grid>
					</Border>
					<Border Grid.Row="2" Padding="0">
						<Grid
							ColumnDefinitions="*,*"
							ColumnSpacing="10"
							RowSpacing="10">

							<!--  Денешни прегледи  -->
							<Border
								Grid.Row="0"
								Grid.Column="0"
								Padding="20"
								BackgroundColor="{StaticResource Gray50}"
								Stroke="{StaticResource Gray100}"
								StrokeShape="RoundRectangle 0">

								<Grid RowDefinitions="Auto,*" RowSpacing="18">
									<Grid ColumnDefinitions="*,Auto">
										<VerticalStackLayout Spacing="2">
											<Label
												FontAttributes="Bold"
												FontSize="20"
												Text="Денешни прегледи"
												TextColor="#2E3A4E" />
										</VerticalStackLayout>

										<!--  FIX: имаше BackgroundColor=transparent + TextColor слична на позадината  -->
										<Border
											Grid.Column="1"
											Padding="10,4"
											BackgroundColor="#EDF1F5"
											StrokeShape="RoundRectangle 14"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="{Binding UpcomingAppointmentsCount}"
												TextColor="#5B6B85" />
										</Border>
									</Grid>
									<CollectionView
										Grid.Row="1"
										HeightRequest="320"
										ItemsSource="{Binding Appointments}"
										SelectionMode="None">
										<CollectionView.EmptyView>
											<VerticalStackLayout
												Padding="20"
												HorizontalOptions="Center"
												Spacing="6"
												VerticalOptions="Center">
												<Label
													FontSize="13"
													HorizontalTextAlignment="Center"
													Text="Нема закажани прегледи за денес"
													TextColor="#5B6B85" />
											</VerticalStackLayout>
										</CollectionView.EmptyView>
										<CollectionView.ItemTemplate>
											<DataTemplate>
												<Border
													Margin="0,10"
													Padding="8"
													BackgroundColor="White"
													HeightRequest="60"
													Stroke="#F0F2F5"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="1">
													<Grid ColumnDefinitions="56,*,90" ColumnSpacing="14">
														<Border
															BackgroundColor="{Binding StatusColor}"
															HeightRequest="56"
															StrokeShape="RoundRectangle 12"
															StrokeThickness="0"
															WidthRequest="56">
															<VerticalStackLayout
																HorizontalOptions="Center"
																Spacing="0"
																VerticalOptions="Center">
																<Label
																	FontAttributes="Bold"
																	FontSize="15"
																	HorizontalTextAlignment="Center"
																	Text="{Binding Time}"
																	TextColor="Black" />
															</VerticalStackLayout>
														</Border>

														<VerticalStackLayout
															Grid.Column="1"
															Spacing="3"
															VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="15"
																Text="{Binding PatientName}"
																TextColor="#2E3A4E" />
															<Label
																FontSize="13"
																Text="{Binding RelativeDay}"
																TextColor="#5B6B85" />
															<!--<Label
																FontSize="12"
																Text="{Binding ScheduledStart, StringFormat='{}{0:dd MMM yyyy}'}"
																TextColor="#8B95A6" />-->
														</VerticalStackLayout>

														<Border
															Grid.Column="2"
															Padding="10,5"
															BackgroundColor="{Binding StatusColor}"
															StrokeShape="RoundRectangle 20"
															StrokeThickness="0"
															VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="11"
																Text="{Binding RelativeDay}"
																TextColor="White" />
														</Border>
													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>

							<!--  Информации за аудитинг  -->
							<Border
								Grid.Row="0"
								Grid.Column="1"
								Padding="20"
								BackgroundColor="{StaticResource Gray50}"
								Stroke="{StaticResource Gray100}"
								StrokeShape="RoundRectangle 0">
								<Grid RowDefinitions="Auto,*" RowSpacing="14">
									<Label
										FontAttributes="Bold"
										FontSize="20"
										Text="Информации за аудитинг"
										TextColor="#2E3A4E" />
									<CollectionView
										x:Name="NotificationsCollectionView"
										Grid.Row="1"
										HeightRequest="240"
										IsVisible="{Binding IsnotificationVisisble}"
										ItemsSource="{Binding Notifications}">
										<CollectionView.EmptyView>
											<VerticalStackLayout
												HorizontalOptions="Center"
												Spacing="6"
												VerticalOptions="Center">
												<Label
													FontSize="13"
													HorizontalTextAlignment="Center"
													Text="Нема нови известувања"
													TextColor="#8B95A6" />
											</VerticalStackLayout>
										</CollectionView.EmptyView>
										<CollectionView.ItemTemplate>
											<DataTemplate>
												<Border
													Margin="0,10"
													Padding="8"
													BackgroundColor="White"
													HeightRequest="60"
													Stroke="#F0F2F5"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="1">
													<Grid
														ColumnDefinitions="Auto,*"
														ColumnSpacing="18"
														RowSpacing="6">
														<Label
															FontSize="22"
															Text="⚠"
															TextColor="#F59E0B"
															VerticalOptions="Center" />
														<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																Text="{Binding Title}"
																TextColor="#2E3A4E" />
															<Label
																FontSize="12"
																Text="{Binding Time}"
																TextColor="#8B95A6" />
														</VerticalStackLayout>
													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>

						</Grid>
					</Border>

				</Grid>

				<!--  LOADING OVERLAY  -->
				<Grid BackgroundColor="#80191E29" IsVisible="{Binding IsBusy}">
					<VerticalStackLayout
						HorizontalOptions="Center"
						Spacing="12"
						VerticalOptions="Center">
						<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
						<Label
							FontSize="13"
							Text="Вчитување..."
							TextColor="White" />
					</VerticalStackLayout>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</ContentPage>