<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.DashboardView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:admin="clr-namespace:EHMR.ViewModels.Admin"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dash="clr-namespace:EHMR.ViewModels.Dashboard.Models"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="ThisPage"
	x:DataType="viewModels:DashboardViewModel"
	BackgroundColor="{StaticResource SparkBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<converters:MetricTileVariantToColorConverter x:Key="MetricTileVariantToColorConverter" />

			<Style
				x:Key="DashboardSummaryCard"
				BasedOn="{StaticResource PageHeaderCardStyle1}"
				TargetType="Border">
				<Setter Property="Padding" Value="20" />
			</Style>

			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="15" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 14" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

			<Style x:Key="AlertChipBorder" TargetType="Border">
				<Setter Property="Padding" Value="14,10" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			</Style>

			<Style x:Key="AppointmentCardStyle" TargetType="Border">
				<Setter Property="Padding" Value="0" />
				<Setter Property="BackgroundColor" Value="White" />
				<Setter Property="Stroke" Value="#E6EDF3" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 14" />
			</Style>

			<Style x:Key="AppointmentRowStyle" TargetType="Border">
				<Setter Property="Margin" Value="0,0,0,7" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="BackgroundColor" Value="#F8FBFC" />
				<Setter Property="Stroke" Value="#E7EEF2" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 9" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="12,0,12,12"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  ===================================================  -->
			<!--  HEADER  -->
			<!--  ===================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid ColumnDefinitions="*,Auto,Auto" VerticalOptions="Center">

					<!--  COL 0: TITLE — untouched  -->
					<controls:FFPageHeader
						Title="Почетна страна"
						Grid.Column="0"
						Subtitle="" />

					<!--
						COL 1: ALERTS
						FIX: CollectionView inside an "Auto" Grid column is a known MAUI
						measurement bug — it either collapses to zero width or refuses
						to size itself to its content, so the three chips could end up
						squeezed, wrapped, or clipped instead of sitting in one row.
						Since this is a small, fixed set of alert chips (not a scrolling
						list), swapping to HorizontalStackLayout + BindableLayout avoids
						the CollectionView measurement issue entirely: a StackLayout
						sizes correctly inside an Auto column every time, so all three
						cards are guaranteed to lay out side-by-side, horizontally,
						without affecting the "*" title column or the Auto button
						column next to it.
					-->
					<HorizontalStackLayout
						Grid.Column="1"
						Margin="1,0"
						BindableLayout.ItemsSource="{Binding State.AlertSummaries}"
						Spacing="10"
						VerticalOptions="Center">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="dash:DashboardAlertSummaryItem">
								<Border
									Padding="14,0"
									BackgroundColor="{Binding BackgroundColor}"
									HeightRequest="45"
									Stroke="{Binding AccentColor}"
									Style="{StaticResource AlertChipBorder}"
									VerticalOptions="Center">
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Command}" />
									</Border.GestureRecognizers>
									<Grid
										ColumnDefinitions="Auto,Auto"
										ColumnSpacing="6"
										VerticalOptions="Center">
										<Label
											FontFamily="FASolid"
											FontSize="18"
											Text="{Binding Icon}"
											TextColor="{Binding AccentColor}"
											VerticalOptions="Center" />
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="0"
											VerticalOptions="Center">
											<Label
												FontAttributes="Bold"
												FontSize="14"
												Text="{Binding Count}"
												TextColor="{Binding AccentColor}" />
											<Label
												FontSize="8"
												Text="{Binding Label}"
												TextColor="{Binding AccentColor}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
					<!--  COL 2: BUTTONS — untouched  -->
					<!--<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding NewEncounterCommand}"
							ContentPadding="20,0"
							HeightRequestEx="45"
							Text="Нов Преглед" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding NewAppointmentCommand}"
							ContentPadding="20,0"
							HeightRequestEx="45"
							Text="Нов Термин" />
					</HorizontalStackLayout>-->
				</Grid>
			</Border>

			<!--  MAIN SCROLL AREA  -->
			<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Spacing="0">

					<!--  ===================================================  -->
					<!--
						KPI STRIP
						
						These numbers were already computed on every dashboard load but
						nothing rendered them. Uses FFMetricTile so the dashboard matches
						the admin dashboard's design system rather than hand-rolled cards.
					-->
					<!--  ===================================================  -->
					<Border Style="{StaticResource PageHeaderCardStyle}">
						<FlexLayout
							AlignItems="Center"
							BindableLayout.ItemsSource="{Binding Kpis}"
							Direction="Row"
							JustifyContent="SpaceBetween"
							Wrap="Wrap">
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="admin:FFMetricTileItem">
									<controls:FFMetricTile
										Title="{Binding Title}"
										Margin="0,0,8,2"
										Command="{Binding Command}"
										CommandParameter="{Binding CommandParameter}"
										DisplayMode="Metric"
										Icon="{Binding Icon}"
										MinimumHeightRequest="92"
										MinimumWidthRequest="240"
										Subtitle="{Binding Subtitle}"
										Variant="{Binding Variant}"
										Value="{Binding Value}" />
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</FlexLayout>
					</Border>

					<!--  ===================================================  -->
					<!--  ===================================================  -->

					<!--  ===================================================  -->
					<!--  PATIENT EXPLORER  -->
					<!--  ===================================================  -->
					<Border
						Grid.Row="1"
						Padding="0"
						Style="{StaticResource PageHeaderCardStyle}">
						<!--  ===================================================  -->
						<!--  PATIENT EXPLORER + PREVIEW PANEL  -->
						<!--  ===================================================  -->
						<Grid ColumnDefinitions="*" ColumnSpacing="6">

							<Border Padding="10" Style="{StaticResource PageHeaderCardStyle}">
								<VerticalStackLayout Spacing="0">

									<controls:SparkExplorerHeaderView
										Buttons="{Binding Buttons}"
										Pickers="{Binding Pickers}"
										SearchCommand="{Binding SearchCommand}"
										SearchPlaceholder="Пребарување на пациенти..."
										SearchText="{Binding PatientSearchText}"
										SelectedSuggestion="{Binding SelectedPatientSuggestion, Mode=TwoWay}"
										ShowCyrillicToggle="True"
										ShowSuggestions="{Binding ShowPatientSuggestions}"
										Suggestions="{Binding PatientSuggestions}"
										Tabs="{Binding Tabs}"
										TabsVisible="{Binding ShowTabs}"
										UseCyrillicInput="{Binding UseCyrillicSearch, Mode=TwoWay}">
										<controls:SparkExplorerHeaderView.SuggestionTemplate>
											<DataTemplate x:DataType="{x:Null}">
												<Border
													Margin="2"
													Padding="12,8"
													BackgroundColor="{StaticResource Gray100}"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeShape="RoundRectangle 2"
													StrokeThickness="1.2">
													<Grid ColumnDefinitions="1.8*,1.2*,1*" ColumnSpacing="16">
														<VerticalStackLayout Spacing="1">
															<Label
																FontSize="10"
																Text="Име и презиме"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="1" Spacing="1">
															<Label
																FontSize="10"
																Text="ЕМБГ"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.NationalId}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="2" Spacing="1">
															<Label
																FontSize="10"
																Text="Последен преглед"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding LatestEncounterStatus}"
																TextColor="{StaticResource SparkAccentTeal}" />
														</VerticalStackLayout>
													</Grid>
												</Border>
											</DataTemplate>
										</controls:SparkExplorerHeaderView.SuggestionTemplate>
									</controls:SparkExplorerHeaderView>

									<controls:SparkDataGridView
										AutoSelectFirstRow="False"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										EditRowCommand="{Binding EditCommand}"
										HyperlinkCommand="{Binding OpenDashboardGridItemCommand}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										RowTappedCommand="{Binding OpenDashboardGridItemCommand}"
										Rows="{Binding GridRows}"
										SelectionChangedCommand="{Binding OpenDashboardGridItemCommand}"
										ShowPagination="{Binding IsPatientGridMode}"
										TotalPages="{Binding TotalPages}" />
								</VerticalStackLayout>
							</Border>

							<!--  PREVIEW PANEL — appears to the right when a row is selected  -->

						</Grid>
					</Border>

					<!--  ===================================================  -->
					<!--  BOTTOM ROW — BOTH CARDS USE APPOINTMENTS  -->
					<!--  ===================================================  -->

					<Grid
						Margin="0,12,0,0"
						Padding="0"
						ColumnDefinitions="*"
						ColumnSpacing="0">

						<!--  ── Термини по датум ────────────────────────────  -->
						<Border Style="{StaticResource AppointmentCardStyle}">
							<VerticalStackLayout Padding="16,14" Spacing="12">

								<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
									<VerticalStackLayout Spacing="1">
										<Label Style="{StaticResource DashboardCardTitle}" Text="Термини по датум" />
										<Label
											FontSize="10"
											Text="{Binding SelectedDate, StringFormat='{0:dddd, dd MMMM yyyy}'}"
											TextColor="{StaticResource SparkTextMuted}" />
									</VerticalStackLayout>
									<Border
										Grid.Column="1"
										Padding="0"
										BackgroundColor="Transparent"
										HeightRequest="28"
										SemanticProperties.Description="Отвори календар"
										Stroke="Transparent"
										StrokeThickness="0"
										ToolTipProperties.Text="Отвори календар"
										VerticalOptions="Center"
										WidthRequest="28">
										<Border.GestureRecognizers>
											<TapGestureRecognizer Tapped="OnCalendarIconTapped" />
										</Border.GestureRecognizers>
										<Label
											FontFamily="FASolid"
											FontSize="14"
											HorizontalOptions="Center"
											Text="&#xf133;"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center" />
									</Border>
									<DatePicker
										x:Name="CalendarDatePicker"
										Grid.Column="1"
										Date="{Binding SelectedDate}"
										HeightRequest="1"
										IsVisible="False"
										WidthRequest="1" />
									<Border
										Grid.Column="2"
										Padding="8,3"
										MinimumHeightRequest="24"
										MinimumWidthRequest="24"
										Style="{StaticResource DashboardCardCountBadge}">
										<Label Style="{StaticResource DashboardCardCountLabel}" Text="{Binding SelectedDateAppointments.Count}" />
									</Border>
									<Border
										Grid.Column="3"
										Padding="0"
										BackgroundColor="Transparent"
										HeightRequest="24"
										StrokeThickness="0"
										VerticalOptions="Center"
										WidthRequest="24">
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding ToggleDateCardCommand}" />
										</Border.GestureRecognizers>
										<Label
											FontSize="12"
											HorizontalOptions="Center"
											HorizontalTextAlignment="Center"
											Text="&#x25BC;"
											TextColor="{StaticResource SparkTextMuted}"
											VerticalOptions="Center">
											<Label.Triggers>
												<DataTrigger
													Binding="{Binding IsDateCardExpanded}"
													TargetType="Label"
													Value="False">
													<Setter Property="Rotation" Value="-90" />
												</DataTrigger>
												<DataTrigger
													Binding="{Binding IsDateCardExpanded}"
													TargetType="Label"
													Value="True">
													<Setter Property="Rotation" Value="0" />
												</DataTrigger>
											</Label.Triggers>
										</Label>
									</Border>
								</Grid>

								<VerticalStackLayout IsVisible="{Binding IsDateCardExpanded}" Spacing="10">

									<!--  caption above the day strip  -->
									<Label
										FontSize="11"
										Text="Изберете од неделните датуми"
										TextColor="{StaticResource SparkTextMuted}" />

									<!--
										Day navigator — clean, no negative padding / oversized fonts (that overflow was
										blocking touch on the tiles), small refined calendar icon on its own row
									-->
									<Grid
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="6"
										VerticalOptions="Center">

										<Border
											Grid.Column="0"
											BackgroundColor="White"
											HeightRequest="34"
											SemanticProperties.Description="Претходна недела"
											Stroke="{StaticResource Gray400}"
											StrokeThickness="1"
											ToolTipProperties.Text="Претходна недела"
											VerticalOptions="Center"
											WidthRequest="34">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="6" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
											</Border.GestureRecognizers>
											<Label
												FontAttributes="Bold"
												FontSize="16"
												HorizontalOptions="Center"
												HorizontalTextAlignment="Center"
												Text="‹"
												TextColor="{StaticResource SparkAccentTeal}"
												VerticalOptions="Center"
												VerticalTextAlignment="Center" />
										</Border>

										<!--
											Day strip — each tile is its own tappable Border, sized to actually
											be clickable (38x40) with no overlapping siblings
										-->
										<ScrollView
											Grid.Column="1"
											HorizontalScrollBarVisibility="Never"
											Orientation="Horizontal"
											VerticalOptions="Center">
											<HorizontalStackLayout
												BindableLayout.ItemsSource="{Binding State.DayStrip}"
												Spacing="6"
												VerticalOptions="Center">
												<BindableLayout.ItemTemplate>
													<DataTemplate x:DataType="dash:DashboardDayItem">
														<Border
															Padding="0"
															HeightRequest="40"
															InputTransparent="False"
															StrokeThickness="1"
															VerticalOptions="Center"
															WidthRequest="36">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="8" />
															</Border.StrokeShape>
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Command}" />
															</Border.GestureRecognizers>
															<Border.Triggers>
																<DataTrigger
																	Binding="{Binding IsSelected}"
																	TargetType="Border"
																	Value="True">
																	<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																	<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding IsSelected}"
																	TargetType="Border"
																	Value="False">
																	<Setter Property="BackgroundColor" Value="White" />
																	<Setter Property="Stroke" Value="{StaticResource Gray400}" />
																</DataTrigger>
															</Border.Triggers>

															<VerticalStackLayout
																HorizontalOptions="Center"
																InputTransparent="True"
																Spacing="0"
																VerticalOptions="Center">
																<Label
																	FontSize="8"
																	HorizontalTextAlignment="Center"
																	Text="{Binding DayLabel}">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	HorizontalTextAlignment="Center"
																	Text="{Binding DayNumber}">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</BindableLayout.ItemTemplate>
											</HorizontalStackLayout>
										</ScrollView>

										<Border
											Grid.Column="2"
											BackgroundColor="White"
											HeightRequest="34"
											SemanticProperties.Description="Следна недела"
											Stroke="{StaticResource Gray400}"
											StrokeThickness="1"
											ToolTipProperties.Text="Следна недела"
											VerticalOptions="Center"
											WidthRequest="34">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="6" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding NextWeekCommand}" />
											</Border.GestureRecognizers>
											<Label
												FontAttributes="Bold"
												FontSize="16"
												HorizontalOptions="Center"
												HorizontalTextAlignment="Center"
												Text="›"
												TextColor="{StaticResource SparkAccentTeal}"
												VerticalOptions="Center"
												VerticalTextAlignment="Center" />
										</Border>
									</Grid>

									<!--  Appointments for selected date  -->
									<CollectionView
										HeightRequest="180"
										ItemsSource="{Binding SelectedDateAppointments}"
										SelectionMode="None">

										<CollectionView.EmptyView>
											<VerticalStackLayout
												Padding="16"
												HorizontalOptions="Center"
												Spacing="6"
												VerticalOptions="Center">
												<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема закажани термини за избраниот датум" />
											</VerticalStackLayout>
										</CollectionView.EmptyView>

										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="dash:DashboardAppointmentItem">
												<Border Style="{StaticResource AppointmentRowStyle}">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.OpenAppointmentCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>

													<Grid
														Padding="0,9,10,9"
														ColumnDefinitions="3,Auto,*,Auto"
														ColumnSpacing="10">
														<BoxView
															Grid.Column="0"
															BackgroundColor="{Binding StatusColor}"
															HorizontalOptions="Start"
															WidthRequest="3" />

														<Label
															Grid.Column="1"
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Time}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />

														<Label
															Grid.Column="2"
															FontSize="12"
															LineBreakMode="TailTruncation"
															Text="{Binding PatientName}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />

														<Border
															Grid.Column="3"
															Padding="9,4"
															BackgroundColor="{Binding StatusColor}"
															Opacity="0.9"
															StrokeThickness="0"
															VerticalOptions="Center">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="10" />
															</Border.StrokeShape>
															<Label
																FontAttributes="Bold"
																FontSize="9"
																HorizontalTextAlignment="Center"
																Text="{Binding RelativeDay}"
																TextColor="White" />
														</Border>
													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Border>

					</Grid>

				</VerticalStackLayout>
			</ScrollView>

		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>
