								<TapGestureRecognizer Command="{Binding OpenKpiCommand}" CommandParameter="alerts" />
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="4">
								<Label Style="{StaticResource DashboardKpiLabel}" Text="Критични известувања" />
								<Label
									Style="{StaticResource DashboardKpiValue}"
									Text="{Binding CriticalAlerts}"
									TextColor="{Binding CriticalAlertsVariant, Converter={StaticResource MetricTileVariantToColorConverter}}" />
							</VerticalStackLayout>
						</Border>

					</Grid>-->



					<Border Grid.Row="3" Padding="0">
						<VerticalStackLayout>
							<Border Margin="0,8,0,8" Padding="0">
								<controls:SparkExplorerHeaderView
									Buttons="{Binding Buttons}"
									Pickers="{Binding Pickers}"
									SearchCommand="{Binding SearchCommand}"
									SearchPlaceholder="Пребарување на пациенти..."
									SearchText="{Binding PatientSearchText}"
									Tabs="{Binding Tabs}" />
							</Border>
							<Border>
								<controls:SparkDataGridView
									x:Name="PatientGrid"
									Columns="{Binding GridColumns}"
									CurrentPage="{Binding CurrentPage}"
									EditRowCommand="{Binding EditCommand}"
									NextPageCommand="{Binding NextPageCommand}"
									PageChangedCommand="{Binding PageChangedCommand}"
									PreviousPageCommand="{Binding PreviousPageCommand}"
									RowTappedCommand="{Binding SelectCommand}"
									Rows="{Binding GridRows}"
									TotalPages="{Binding TotalPages}" />
							</Border>
						</VerticalStackLayout>
					</Border>

					<!--  ===================================================  -->
					<!--  BOTTOM ROW — appointments card + auditing card, now consistent  -->
					<!--  ===================================================  -->
					<Border Grid.Row="4" Padding="0">
						<Grid
							ColumnDefinitions="*,*"
							ColumnSpacing="62"
							RowSpacing="22">
							<Border
								Grid.Row="0"
								Grid.Column="1"
								Style="{StaticResource DashboardSummaryCard}">
								<Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">

									<!--  Card header  -->
									<Grid ColumnDefinitions="*,Auto">
										<Label Style="{StaticResource DashboardCardTitle}" Text="Прегледи по датум" />
										<Border Grid.Column="1" Style="{StaticResource DashboardCardCountBadge}">
											<Label Style="{StaticResource DashboardCardCountLabel}" Text="{Binding DailyEncounters.Count}" />
										</Border>
									</Grid>

									<!--  Day strip nav — prev/next week paging + calendar jump-to-date, day strip scrolls in the middle  -->
									<Grid
										Grid.Row="1"
										ColumnDefinitions="Auto,*,Auto,Auto"
										ColumnSpacing="6">

										<!--  Previous week  -->
										<Border
											Grid.Column="0"
											Padding="0"
											BackgroundColor="{StaticResource SparkSurface}"
											HeightRequest="32"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeThickness="1"
											VerticalOptions="Center"
											WidthRequest="32">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="8" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
											</Border.GestureRecognizers>
											<Label
												FontAttributes="Bold"
												FontSize="14"
												HorizontalOptions="Center"
												Text="‹"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
										</Border>

										<!--  Day strip — tap a day to load its encounters below  -->
										<ScrollView
											Grid.Column="1"
											HorizontalScrollBarVisibility="Never"
											Orientation="Horizontal">
											<HorizontalStackLayout BindableLayout.ItemsSource="{Binding DayStrip}" Spacing="8">
												<BindableLayout.ItemTemplate>
													<DataTemplate x:DataType="dash:DashboardDayItem">
														<Border
															Padding="0"
															HeightRequest="56"
															StrokeThickness="1"
															WidthRequest="46">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="10" />
															</Border.StrokeShape>
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Command}" />
															</Border.GestureRecognizers>
															<Border.Triggers>
																<DataTrigger
																	Binding="{Binding IsSelected}"
																	TargetType="Border"
																	Value="True">
																	<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																	<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																</DataTrigger>
																<DataTrigger
																	Binding="{Binding IsSelected}"
																	TargetType="Border"
																	Value="False">
																	<Setter Property="BackgroundColor" Value="{StaticResource SparkSurface}" />
																	<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
																</DataTrigger>
															</Border.Triggers>
															<VerticalStackLayout
																HorizontalOptions="Center"
																Spacing="2"
																VerticalOptions="Center">
																<Label
																	FontSize="10"
																	HorizontalTextAlignment="Center"
																	Text="{Binding DayLabel}">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
																<Label
																	FontAttributes="Bold"
																	FontSize="15"
																	HorizontalTextAlignment="Center"
																	Text="{Binding DayNumber}">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
																<VerticalStackLayout
																	HorizontalOptions="Center"
																	Spacing="2"
																	VerticalOptions="Center">
																	<Label
																		FontSize="10"
																		HorizontalTextAlignment="Center"
																		Text="{Binding DayLabel}">
																		<Label.Triggers>
																			<DataTrigger
																				Binding="{Binding IsSelected}"
																				TargetType="Label"
																				Value="True">
																				<Setter Property="TextColor" Value="White" />
																			</DataTrigger>
																			<DataTrigger
																				Binding="{Binding IsSelected}"
																				TargetType="Label"
																				Value="False">
																				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
																			</DataTrigger>
																		</Label.Triggers>
																	</Label>
																	<Label
																		FontAttributes="Bold"
																		FontSize="15"
																		HorizontalTextAlignment="Center"
																		Text="{Binding DayNumber}">
																		<Label.Triggers>
																			<DataTrigger
																				Binding="{Binding IsSelected}"
																				TargetType="Label"
																				Value="True">
																				<Setter Property="TextColor" Value="White" />
																			</DataTrigger>
																			<DataTrigger
																				Binding="{Binding IsSelected}"
																				TargetType="Label"
																				Value="False">
																				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																			</DataTrigger>
																		</Label.Triggers>
																	</Label>

																	<!--  Dot indicator — only visible when the date actually has encounters  -->
																	<BoxView
																		CornerRadius="2"
																		HeightRequest="4"
																		HorizontalOptions="Center"
																		IsVisible="{Binding HasEncounters}"
																		WidthRequest="4">
																		<BoxView.Triggers>
																			<DataTrigger
																				Binding="{Binding IsSelected}"
																				TargetType="BoxView"
																				Value="True">
																				<Setter Property="Color" Value="White" />
																			</DataTrigger>
																			<DataTrigger
																				Binding="{Binding IsSelected}"
																				TargetType="BoxView"
																				Value="False">
																				<Setter Property="Color" Value="{StaticResource SparkAccentTeal}" />
																			</DataTrigger>
																		</BoxView.Triggers>
																	</BoxView>
																</VerticalStackLayout>
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</BindableLayout.ItemTemplate>
											</HorizontalStackLayout>
										</ScrollView>

										<!--  Next week  -->
										<Border
											Grid.Column="2"
											Padding="0"
											BackgroundColor="{StaticResource SparkSurface}"
											HeightRequest="32"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeThickness="1"
											VerticalOptions="Center"
											WidthRequest="32">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="8" />
											</Border.StrokeShape>
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding NextWeekCommand}" />
											</Border.GestureRecognizers>
											<Label
												FontAttributes="Bold"
												FontSize="14"
												HorizontalOptions="Center"
												Text="›"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
										</Border>

										<!--
											Calendar jump — transparent native DatePicker layered over a calendar glyph;
											tapping opens the OS date picker and re-centers the strip on whatever date is picked
										-->
										<Grid
											Grid.Column="3"
											HeightRequest="32"
											VerticalOptions="Center"
											WidthRequest="32">
											<Border
												BackgroundColor="{StaticResource SparkSurface}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeThickness="1">
												<Border.StrokeShape>
													<RoundRectangle CornerRadius="8" />
												</Border.StrokeShape>
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf133;"
													TextColor="{StaticResource SparkTextSecondary}"
													VerticalOptions="Center" />
											</Border>
											<DatePicker
												BackgroundColor="Transparent"
												Date="{Binding SelectedDate}"
												HeightRequest="32"
												Opacity="0.02"
												WidthRequest="32" />
										</Grid>
									</Grid>

									<!--  Encounters for the selected date  -->
									<CollectionView
										Grid.Row="2"
										ItemsSource="{Binding DailyEncounters}"
										SelectionMode="None">

										<CollectionView.EmptyView>
											<VerticalStackLayout
												Padding="20"
												HorizontalOptions="Center"
												Spacing="6"
												VerticalOptions="Center">
												<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема прегледи за избраниот датум" />
											</VerticalStackLayout>
										</CollectionView.EmptyView>

										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="dash:DashboardEncounterItem">
												<Border
													Margin="0,0,0,10"
													Padding="0"
													BackgroundColor="{StaticResource SparkSurface}"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">

													<Border.Shadow>
														<Shadow
															Brush="{StaticResource SparkTextPrimary}"
															Opacity="0.08"
															Radius="10"
															Offset="0,3" />
													</Border.Shadow>

													<Border.StrokeShape>
														<RoundRectangle CornerRadius="14" />
													</Border.StrokeShape>

													<Grid Padding="0,12,14,12" ColumnDefinitions="4,Auto,*,Auto">

														<!--  Accent bar — driven by StatusColor, not hardcoded  -->
														<BoxView
															Grid.Column="0"
															BackgroundColor="{Binding StatusColor}"
															HorizontalOptions="Start"
															WidthRequest="4" />

														<Label
															Grid.Column="1"
															Margin="14,0,14,0"
															FontAttributes="Bold"
															FontSize="15"
															Text="{Binding Time}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />

														<Label
															Grid.Column="2"
															FontSize="14"
															Text="{Binding PatientName}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />

														<Border
															Grid.Column="3"
															Padding="12,6"
															BackgroundColor="{Binding StatusColor}"
															Opacity="0.9"
															StrokeThickness="0"
															VerticalOptions="Center">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="20" />
															</Border.StrokeShape>
															<Label
																FontAttributes="Bold"
																FontSize="11"
																HorizontalTextAlignment="Center"
																Text="{Binding StatusText}"
																TextColor="White" />
														</Border>

													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>
							<!--  Денешни прегледи  -->
							<Border
								Grid.Row="0"
								Grid.Column="0"
								Style="{StaticResource DashboardSummaryCard}">

								<Grid RowDefinitions="Auto,*" RowSpacing="1">

									<!--  Card header  -->
									<Grid ColumnDefinitions="*,Auto">
										<Label Style="{StaticResource DashboardCardTitle}" Text="Денешни прегледи" />
										<Border Grid.Column="1" Style="{StaticResource DashboardCardCountBadge}">
											<Label Style="{StaticResource DashboardCardCountLabel}" Text="{Binding UpcomingAppointmentsCount}" />
										</Border>
									</Grid>

									<CollectionView
										Grid.Row="1"
										ItemsSource="{Binding Appointments}"
										SelectionMode="None">

										<CollectionView.EmptyView>
											<VerticalStackLayout
												Padding="20"
												HorizontalOptions="Center"
												Spacing="6"
												VerticalOptions="Center">
												<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема закажани прегледи за денес" />
											</VerticalStackLayout>
										</CollectionView.EmptyView>

										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="dash:DashboardAppointmentItem">
												<Border
													Margin="0,0,0,10"
													Padding="0"
													BackgroundColor="White"
													Stroke="#EEF1F5"
													StrokeThickness="1">

													<Border.Shadow>
														<Shadow
															Brush="#0F172A"
															Opacity="0.08"
															Radius="10"
															Offset="0,3" />
													</Border.Shadow>

													<Border.StrokeShape>
														<RoundRectangle CornerRadius="14" />
													</Border.StrokeShape>

													<Grid Padding="0,12,14,12" ColumnDefinitions="4,Auto,*,Auto">

														<!--  Colored accent bar (status color)  -->
														<BoxView
															Grid.Column="0"
															BackgroundColor="{Binding StatusColor}"
															HorizontalOptions="Start"
															WidthRequest="4" />

														<!--  Avatar with initials, soft tinted bg  -->
														<Border
															Grid.Column="1"
															Margin="14,0,14,0"
															BackgroundColor="{Binding StatusColor}"
															HeightRequest="48"
															Opacity="0.15"
															StrokeThickness="0"
															VerticalOptions="Center"
															WidthRequest="48">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="24" />
															</Border.StrokeShape>
														</Border>

														<Label
															Grid.Column="1"
															Margin="14,0,14,0"
															FontAttributes="Bold"
															FontSize="16"
															HorizontalOptions="Center"
															HorizontalTextAlignment="Center"
															Text="{Binding PatientName, Converter={StaticResource AppointmentsInitialsConverter}}"
															TextColor="{Binding StatusColor}"
															VerticalOptions="Center"
															WidthRequest="48" />

														<!--  Name + time  -->
														<VerticalStackLayout
															Grid.Column="2"
															Spacing="4"
															VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="15"
																Text="{Binding PatientName}"
																TextColor="#0F172A" />
															<HorizontalStackLayout Spacing="6">
																<Label
																	FontFamily="FASolid"
																	FontSize="11"
																	Text="&#xf017;"
																	TextColor="#94A3B8" />
																<Label
																	FontSize="12.5"
																	Text="{Binding Time}"
																	TextColor="#64748B" />
																<Label
																	FontSize="12.5"
																	Text="•"
																	TextColor="#CBD5E1" />
																<Label
																	FontSize="12.5"
																	Text="{Binding RelativeDay}"
																	TextColor="#94A3B8" />
															</HorizontalStackLayout>
														</VerticalStackLayout>

														<!--  Status pill: soft tinted bg, solid colored text  -->
														<Border
															Grid.Column="3"
															Padding="12,6"
															BackgroundColor="{Binding StatusColor}"
															Opacity="0.9"
															StrokeThickness="0"
															VerticalOptions="Center">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="20" />
															</Border.StrokeShape>
															<Label
																FontAttributes="Bold"
																FontSize="11"
																HorizontalTextAlignment="Center"
																Text="{Binding RelativeDay}"
																TextColor="White" />
														</Border>

													</Grid>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>


						</Grid>
					</Border>

				</Grid>

				<!--  LOADING OVERLAY  -->
				<Grid BackgroundColor="#80191E29" IsVisible="{Binding IsBusy}">
					<VerticalStackLayout
						HorizontalOptions="Center"
						Spacing="12"
						VerticalOptions="Center">
						<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
						<Label
							FontSize="13"
							Text="Вчитување..."
							TextColor="White" />
					</VerticalStackLayout>
				</Grid>
			</Grid>
		</Border>
	</Grid>
</ContentPage>
