								<TapGestureRecognizer Command="{Binding OpenKpiCommand}" CommandParameter="appointments" />
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="4">
								<Label Style="{StaticResource DashboardKpiLabel}" Text="Закажани прегледи" />
								<Label Style="{StaticResource DashboardKpiValue}" Text="{Binding UpcomingAppointmentsCount}" />
							</VerticalStackLayout>
						</Border>

						<Border
							Grid.Column="3"
							Background="{StaticResource Gray200}"
							Style="{StaticResource DashboardKpiTile}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding OpenKpiCommand}" CommandParameter="therapies" />
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="4">
								<Label Style="{StaticResource DashboardKpiLabel}" Text="Задоцнети циклуси" />
