<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Views.RootLayoutPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
	xmlns:local="clr-namespace:EHMR.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"><Grid ColumnDefinitions="240,*">

			<!--  LEFT MENU (GLOBAL, SINGLE INSTANCE)  -->
			<Border
				Grid.Column="0"
				BackgroundColor="#0F172A"
				StrokeThickness="0">

				<ContentView x:Name="MenuHost" />
			</Border>

			<!--  MAIN CONTENT AREA  -->
			<ContentView x:Name="PageHost" Grid.Column="1" />
		</Grid>
	</ContentView.Content>
</ContentView>