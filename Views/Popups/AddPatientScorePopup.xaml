<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
	x:Class="EHMR.Views.Popups.AddPatientScorePopup"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	x:Name="Root"
	Background="{StaticResource AppBg}">

	<Border
		Padding="20"
		BackgroundColor="{StaticResource SparkBackground}"
		Stroke="{StaticResource Gray400}"
		StrokeShape="RoundRectangle 12"
		StrokeThickness="1"
		WidthRequest="400">
		<VerticalStackLayout Spacing="16">

			<!--  Header  -->
			<VerticalStackLayout Spacing="4">
				<Label
					FontAttributes="Bold"
					FontSize="16"
					Text="Избери постоечки скор"
					TextColor="{StaticResource SparkTextPrimary}" />
				<Label
					FontSize="11"
					Text="Пребарај по опис и избери резултат од табелата."
					TextColor="{StaticResource SparkTextSecondary}" />
			</VerticalStackLayout>

			<BoxView HeightRequest="1" Color="{StaticResource SparkBorderSubtle}" />

			<!--  Search  -->
			<VerticalStackLayout Spacing="6">
				<Label
					CharacterSpacing="0.6"
					FontAttributes="Bold"
					FontSize="10"
					Text="ПРЕБАРУВАЊЕ"
					TextColor="{StaticResource SparkTextSecondary}" />
				<Border
					Padding="10,0"
					BackgroundColor="{StaticResource SparkBackground}"
					HeightRequest="40"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="1">
					<Entry
						BackgroundColor="Transparent"
						FontSize="13"
						HeightRequest="38"
						Placeholder="Пр. DAS28"
						PlaceholderColor="{StaticResource SparkTextSecondary}"
						Text="{Binding DescriptionText, Mode=TwoWay}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Border>
			</VerticalStackLayout>

			<!--  Suggestions  -->
			<Border
				Padding="4"
				BackgroundColor="White"
				IsVisible="{Binding ShowSuggestions}"
				Stroke="{StaticResource SparkBorderSubtle}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<ScrollView MaximumHeightRequest="240">
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="0">
						<BindableLayout.ItemTemplate>
							<DataTemplate>
								<VerticalStackLayout Spacing="0">
									<Border
										Padding="12,10"
										BackgroundColor="Transparent"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="0">
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectSuggestionCommand}" CommandParameter="{Binding .}" />
										</Border.GestureRecognizers>
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
											<Label
												FontAttributes="Bold"
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding Text}"
												TextColor="{StaticResource SparkAccentTealDark}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="12"
												Text="{Binding Number}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Grid>
									</Border>
									<BoxView
										Margin="12,0"
										HeightRequest="1"
										Color="{StaticResource SparkBorderSubtle}" />
								</VerticalStackLayout>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</ScrollView>
			</Border>

			<BoxView HeightRequest="1" Color="{StaticResource SparkBorderSubtle}" />

			<!--  Actions  -->
			<Button
				BackgroundColor="{StaticResource SparkSurfaceAlt}"
				BorderColor="{StaticResource SparkBorder}"
				BorderWidth="1"
				Clicked="OnCancelClicked"
				CornerRadius="8"
				FontSize="12"
				HeightRequest="38"
				HorizontalOptions="End"
				Text="Откажи"
				TextColor="{StaticResource SparkTextPrimary}"
				WidthRequest="100" />
		</VerticalStackLayout>
	</Border>
</toolkit:Popup>