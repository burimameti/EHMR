<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Mkb10.Mkb10CodeListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Mkb10"
	x:Name="PageRoot"
	x:DataType="viewModels:Mkb10CodeListViewModel">

	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  MAIN  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="16">

			<!--  HEADER  -->
			<Border
				Grid.Row="0"
				Padding="20"
				StrokeShape="RoundRectangle 0"
				Style="{StaticResource SurfaceCard}">

				<Grid ColumnDefinitions="*,Auto">

					<controls:FFPageHeader Title="МКБ-10 Каталог" Subtitle="Меѓународна класификација на болести и дијагностички шифри" />

					<Button
						Grid.Column="1"
						BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
						Command="{Binding AddCodeCommand}"
						HeightRequest="45"
						Style="{StaticResource TabButtonActiveStyle}"
						Text="+ Нов Код"
						WidthRequest="160" />

				</Grid>

			</Border>

			<!--  SEARCH / FILTER  -->
			<Border Grid.Row="1" Padding="0">

				<VerticalStackLayout Spacing="8">

					<controls:SparkExplorerHeaderView
						Margin="0,8"
						Buttons="{Binding Buttons}"
						Pickers="{Binding Pickers}"
						SearchCommand="{Binding SearchCommand}"
						SearchPlaceholder="Пребарување по шифра, опис или поглавје..."
						SearchText="{Binding Mkb10SearchText}"
						Tabs="{Binding Tabs}" />

					<controls:SparkDataGridView
						x:Name="Grid"
						Columns="{Binding GridColumns}"
						CurrentPage="{Binding CurrentPage}"
						EditRowCommand="{Binding EditCommand}"
						NextPageCommand="{Binding NextPageCommand}"
						PageChangedCommand="{Binding PageChangedCommand}"
						PreviousPageCommand="{Binding PreviousPageCommand}"
						RowTappedCommand="{Binding SelectCommand}"
						Rows="{Binding GridRows}"
						TotalPages="{Binding TotalPages}" />

				</VerticalStackLayout>

			</Border>

			<!--  FOOTER  -->
			<Border
				Grid.Row="2"
				Margin="0,8,0,0"
				Padding="12"
				BackgroundColor="{StaticResource SparkBackground}"
				Stroke="{StaticResource SparkBorder}"
				StrokeShape="RoundRectangle 8">

				<Grid ColumnDefinitions="Auto,*,Auto">

					<HorizontalStackLayout Spacing="12">

						<Label
							FontAttributes="Bold"
							FontSize="13"
							Text="Вкупно:"
							TextColor="{StaticResource SparkTextSecondary}" />

						<Label
							FontSize="13"
							Text="{Binding FilteredCodesCount}"
							TextColor="{StaticResource SparkTextPrimary}" />

					</HorizontalStackLayout>

					<HorizontalStackLayout Grid.Column="2" Spacing="20">

						<Label
							FontSize="12"
							Text="{Binding CurrentPage, StringFormat='Страна {0}'}"
							TextColor="{StaticResource SparkTextSecondary}" />

						<Label
							FontSize="12"
							Text="{Binding TotalPages, StringFormat='од {0}'}"
							TextColor="{StaticResource SparkTextSecondary}" />

					</HorizontalStackLayout>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</ContentPage>