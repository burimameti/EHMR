<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Prescription.PrescriptionDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Prescriptions"
	x:Name="PageRoot"
	x:DataType="viewModels:PrescriptionDetailFormViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*"
			RowSpacing="16">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Grid.Row="0" Title="{Binding PageTitle}" Subtitle="Управување со рецепти и терапија">
	<controls:FFPageHeader.HeaderContent>
		<HorizontalStackLayout Spacing="10">
			<controls:FFButton ButtonKind="Secondary" Command="{Binding ToggleEditModeCommand}" HeightRequestEx="40" IsVisible="{Binding Id, Converter={StaticResource GuidToBoolConverter}}" Text="Уреди" />
			<controls:FFButton ButtonKind="Secondary" Command="{Binding BackCommand}" HeightRequestEx="40" Text="Назад" />
			<controls:FFButton BackgroundColorEx="{StaticResource SidebarActiveBg}" Command="{Binding SaveCommand}" HeightRequestEx="40" IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" Text="Зачувај" TextColorEx="White" />
		</HorizontalStackLayout>
	</controls:FFPageHeader.HeaderContent>
</controls:FFPageHeader>
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =====================================================  -->
			<controls:FFSectionCard Grid.Row="1" Margin="0" ContentPadding="18">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Padding="16" Spacing="28">

						<!--  ================================================  -->
						<!--  СЕКЦИЈА — ПАЦИЕНТ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Spacing="14">
							<controls:CrudSectionHeader Title="ПАЦИЕНТ" />

							<Grid Padding="{StaticResource FormRowPadding}">
								<Grid
									ColumnDefinitions="130,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
									<Label
										Grid.Column="0"
										Style="{StaticResource EditFieldLabelStyle}"
										Text="Пациент *" />
									<controls:FFPicker Grid.Column="1" ItemDisplayBinding="{Binding FullName}" ItemsSource="{Binding PatientsList}" Label="" Placeholder="Избери пациент" SelectedItem="{Binding SelectedPatient, Mode=TwoWay}" />
								</Grid>
								<Grid
									ColumnDefinitions="130,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Пациент:" />
									<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
										<HorizontalStackLayout Spacing="8">
											<Label
												Style="{StaticResource InfoPillIconStyle}"
												Text="&#xf007;" />
											<Label
												Style="{StaticResource InfoPillTextStyle}"
												Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</HorizontalStackLayout>
									</Border>
								</Grid>
							</Grid>
						</VerticalStackLayout>

						<!--  ================================================  -->
						<!--  СЕКЦИЈА — ДЕТАЛИ ЗА РЕЦЕПТОТ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Spacing="14">
							<controls:CrudSectionHeader Title="ДЕТАЛИ ЗА РЕЦЕПТОТ" />

							<Grid
								Padding="{StaticResource FormRowPadding}"
								ColumnDefinitions="*,1,*"
								ColumnSpacing="24">
								<BoxView Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />

								<!--  Лек / Медикамент  -->
								<Grid Grid.Column="0">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Лек *" />
										<controls:FFInput Grid.Column="1" Placeholder="Внесете име на лек..." Text="{Binding Medication}" />
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Лек:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Medication}" />
									</Grid>
								</Grid>

								<!--  Дозирање  -->
								<Grid Grid.Column="2">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Дозирање *" />
										<controls:FFInput Grid.Column="1" Placeholder="Пр. 2 пати по 1 таблета на ден" Text="{Binding Dosage}" />
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Дозирање:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Dosage}" />
									</Grid>
								</Grid>
							</Grid>

							<!--  Инструкции и напомени  -->
							<Grid Padding="{StaticResource FormRowPadding}">
								<VerticalStackLayout IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Инструкции и напомени" />
									<Border Style="{StaticResource TextAreaFieldBoxStyle}">
										<Editor
											AutoSize="TextChanges"
											BackgroundColor="Transparent"
											FontSize="13"
											MinimumHeightRequest="150"
											Placeholder="Внесете дополнителни медицински инструкции за употреба..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Instructions}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
								</VerticalStackLayout>
								<Grid
									ColumnDefinitions="130,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Инструкции:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Instructions, FallbackValue='Нема евидентирано.'}" />
								</Grid>
							</Grid>
						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>
			</controls:FFSectionCard>

		</Grid>
	</Grid>
</ContentPage>
