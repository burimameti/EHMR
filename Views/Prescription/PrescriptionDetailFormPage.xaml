<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="EHMR.Views.Prescription.PrescriptionDetailFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels.Prescriptions"
    xmlns:models="clr-namespace:EHMR.Domain.Entities"
    x:DataType="viewModels:PrescriptionDetailFormViewModel"
    Style="{StaticResource PageBackgroundStyle}">

	<Grid ColumnDefinitions="295,*">

		<!-- LEFT MENU -->
		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!-- MAIN AREA -->
		<Grid Grid.Column="1" RowDefinitions="72,*">

			<!-- HEADER -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderContainer}">
				<Grid ColumnDefinitions="*,Auto">

					<VerticalStackLayout VerticalOptions="Center">
						<Label Text="{Binding PageTitle}" Style="{StaticResource PageHeaderTitle}" />
						<Label Text="Управување со рецепти и терапија" Style="{StaticResource PageHeaderSubtitle}" />
					</VerticalStackLayout>

					<!-- ACTIONS -->
					<HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">

						<Button Text="⟲"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleEditModeCommand}" />

						<Button Text="Назад"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BackCommand}" />

						<Button Text="Зачувај"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"
                                IsVisible="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!-- BODY -->
			<Grid Grid.Row="1"
      Padding="{StaticResource SpaceLg}"
      RowDefinitions="Auto,Auto,Auto,*">

				<!-- Patient -->
				<Border Style="{StaticResource ToolbarContainer}">
					<VerticalStackLayout>
						<Label Text="Пациент"
                   Style="{StaticResource InputLabel}" />

						<Picker
                ItemsSource="{Binding PatientsList}"
                SelectedItem="{Binding SelectedPatient}"
                ItemDisplayBinding="{Binding FirstName}"
                IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBoolConverter}}" />
					</VerticalStackLayout>
				</Border>

				<!-- Medication -->
				<Border Grid.Row="1"
            Style="{StaticResource ToolbarContainer}">
					<VerticalStackLayout>

						<Label Text="Лек"
                   Style="{StaticResource InputLabel}" />

						<Entry
                Text="{Binding Medication}"
                IsReadOnly="{Binding IsReadOnly}" />
					</VerticalStackLayout>
				</Border>

				<!-- Dosage -->
				<Border Grid.Row="2"
            Style="{StaticResource ToolbarContainer}">
					<VerticalStackLayout>

						<Label Text="Дозирање"
                   Style="{StaticResource InputLabel}" />

						<Entry
                Text="{Binding Dosage}"
                IsReadOnly="{Binding IsReadOnly}" />
					</VerticalStackLayout>
				</Border>

				<!-- Instructions -->
				<Border Grid.Row="3"
            Style="{StaticResource ToolbarContainer}">
					<VerticalStackLayout>

						<Label Text="Инструкции"
                   Style="{StaticResource InputLabel}" />

						<Editor
                HeightRequest="150"
                Text="{Binding Instructions}"
                IsReadOnly="{Binding IsReadOnly}" />
					</VerticalStackLayout>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>