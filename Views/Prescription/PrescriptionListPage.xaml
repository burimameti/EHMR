<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="EHMR.Views.Prescription.PrescriptionListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels.Prescriptions"
    xmlns:models="clr-namespace:EHMR.Domain.Entities"
    x:DataType="viewModels:PrescriptionListViewModel"
    Style="{StaticResource PageBackgroundStyle}">

	<Grid ColumnDefinitions="295,*">

		<!-- LEFT MENU -->
		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!-- MAIN -->
		<Grid Grid.Column="1" RowDefinitions="72,*">

			<!-- TOP BAR (HEADER) -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderContainer}">
				<Grid ColumnDefinitions="*,Auto">

					<VerticalStackLayout Spacing="{StaticResource SpaceXs}" VerticalOptions="Center">

						<Label Text="Медицински Рецепти"
                               Style="{StaticResource PageHeaderTitle}" />

						<Label Text="Управување со медицински рецепти и терапии"
                               Style="{StaticResource PageHeaderSubtitle}" />

					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">

						<Border Padding="12,8"
                                BackgroundColor="{StaticResource SurfaceAlt}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

							<HorizontalStackLayout Spacing="{StaticResource SpaceSm}">

								<Label Text="&#xf0f6;"
                                       FontFamily="FASolid"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />

								<Label Text="{Binding UserName}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />

							</HorizontalStackLayout>

						</Border>

					</HorizontalStackLayout>

				</Grid>
			</Border>

			<!-- CONTENT -->
			<Grid Grid.Row="1"
                  Padding="{StaticResource SpaceLg}"
                  RowDefinitions="Auto,16,*">

				<!-- TOOLBAR -->
				<Border Grid.Row="0" Style="{StaticResource ToolbarContainer}">

					<Grid ColumnDefinitions="5*,0.5*,1*"
                          ColumnSpacing="12">

						<!-- SEARCH -->
						<VerticalStackLayout Grid.Column="0" Spacing="5">

							<Label Text="ПРЕБАРУВАЊЕ"
                                   Style="{StaticResource InputLabel}" />

							<Border Style="{StaticResource InputBorderStyle}">
								<Grid ColumnDefinitions="Auto,*">

									<Label Text="&#xf002;"
                                           FontFamily="FASolid"
                                           FontSize="14"
                                           Margin="4,0,8,0"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />

									<Entry Grid.Column="1"
                                           Style="{StaticResource InputEntry}"
                                           Placeholder="Пациент, лек или дозирање..."
                                           Text="{Binding SearchText, Mode=TwoWay}" />

								</Grid>
							</Border>

						</VerticalStackLayout>

						<!-- REFRESH -->
						<VerticalStackLayout Grid.Column="1" VerticalOptions="End">

							<Button Text="⟳"
                                    FontFamily="FASolid"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshCommand}" />

						</VerticalStackLayout>

						<!-- ADD -->
						<VerticalStackLayout Grid.Column="2"
                                             VerticalOptions="End">

							<Button Text="＋ Нов Рецепт"
                                    Padding="16,0"
                                    HeightRequest="42"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddCommand}" />

						</VerticalStackLayout>

					</Grid>

				</Border>

				<!-- LIST -->
				<Border Grid.Row="2"
                        Style="{StaticResource ElevatedCard}"
                        Padding="0">

					<Grid RowDefinitions="48,*">

						<!-- HEADER -->
						<Border Grid.Row="0" Style="{StaticResource GridHeaderStyle}">
							<Grid ColumnDefinitions="2*,2*,2*,2*,1*,1.5*,120"
                                  Padding="16,0">

								<Label Text="ПАЦИЕНТ"
                                       Style="{StaticResource GridHeaderTextStyle}" />

								<Label Grid.Column="1"
                                       Text="ЛЕКОВИ"
                                       Style="{StaticResource GridHeaderTextStyle}" />

								<Label Grid.Column="2"
                                       Text="ДОЗА"
                                       Style="{StaticResource GridHeaderTextStyle}" />

								<Label Grid.Column="3"
                                       Text="ИНСТРУКЦИИ"
                                       Style="{StaticResource GridHeaderTextStyle}" />

								<Label Grid.Column="4"
                                       Text="ДАТУМ"
                                       Style="{StaticResource GridHeaderTextStyle}" />

								<Label Grid.Column="5"
                                       Text="СТАТУС"
                                       Style="{StaticResource GridHeaderTextStyle}" />

								<Label Grid.Column="6"
                                       Text="АКЦИИ"
                                       HorizontalTextAlignment="Center"
                                       Style="{StaticResource GridHeaderTextStyle}" />

							</Grid>
						</Border>

						<!-- ITEMS -->
						<CollectionView Grid.Row="1"
                                        ItemsSource="{Binding Items}">

							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="models:Prescription">

									<Border Style="{StaticResource GridRowStyle}">
										<Grid ColumnDefinitions="2*,2*,2*,2*,1*,1.5*,120"
                                              Padding="12,6">

											<!-- PATIENT -->
											<VerticalStackLayout>
												<Label Text="{Binding Patient.FirstName}"
                                                       FontAttributes="Bold"
                                                       Style="{StaticResource Body}" />

												<Label Text="{Binding Patient.LastName}"
                                                       Style="{StaticResource MutedText}" />
											</VerticalStackLayout>

											<!-- MEDICINES -->
											<Label Grid.Column="1"
                                                   Text="{Binding Medicines.Count}"
                                                   Style="{StaticResource Body}" />

											<!-- DOSAGE -->
											<Label Grid.Column="2"
                                                   Text="{Binding Dosage}"
                                                   Style="{StaticResource Body}" />

											<!-- INSTRUCTIONS -->
											<Label Grid.Column="3"
                                                   Text="{Binding Instructions}"
                                                   Style="{StaticResource MutedText}"
                                                   LineBreakMode="TailTruncation" />

											<!-- DATE -->
											<Label Grid.Column="4"
                                                   Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy}'}"
                                                   Style="{StaticResource Body}" />

											<!-- STATUS -->
											<Border Grid.Column="5"
                                                    Style="{StaticResource SuccessPillStyle}"
                                                    Padding="6,2">

												<Label Text="Активна"
                                                       Style="{StaticResource SuccessChipText}" />

											</Border>

											<!-- ACTIONS -->
											<HorizontalStackLayout Grid.Column="6"
                                                                   Spacing="6"
                                                                   HorizontalOptions="Center">

												<Button Text="👁"
                                                        Style="{StaticResource ToolbarButton}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}"
                                                        CommandParameter="{Binding .}" />

												<Button Text="✎"
                                                        Style="{StaticResource ToolbarButton}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                                        CommandParameter="{Binding .}" />

												<Button Text="🗑"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                        CommandParameter="{Binding .}" />

											</HorizontalStackLayout>

										</Grid>
									</Border>

								</DataTemplate>
							</CollectionView.ItemTemplate>

						</CollectionView>

					</Grid>
				</Border>

			</Grid>
		</Grid>
	</Grid>
</ContentPage>