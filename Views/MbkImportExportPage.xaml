<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
	x:Class="EHMR.Views.MbkImportExportPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
	xmlns:local="clr-namespace:EHMR.Views"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Mkb10"
	mc:Ignorable="d">

	<ContentPage.Resources>
		<ResourceDictionary>

			<Style x:Key="MbkSectionTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="18" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="Margin" Value="0,0,0,14" />
			</Style>

			<Style x:Key="MbkFieldLabel" TargetType="Label">
				<Setter Property="FontSize" Value="12" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="Margin" Value="0,0,0,4" />
			</Style>

			<Style x:Key="MbkUnderlineEntry" TargetType="Entry">
				<Setter Property="BackgroundColor" Value="Transparent" />
				<Setter Property="FontSize" Value="14" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="MbkFieldUnderline" TargetType="BoxView">
				<Setter Property="HeightRequest" Value="1" />
				<Setter Property="Color" Value="{StaticResource SparkBorderSubtle}" />
			</Style>

			<Style x:Key="MbkResultCountLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="MbkResultCountValue" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<ContentPage.ToolbarItems>
		<ToolbarItem Clicked="OnCloseClicked" Text="Затвори" />
	</ContentPage.ToolbarItems>

	<Border BackgroundColor="{StaticResource Gray200}" StrokeThickness="0">
		<Grid RowDefinitions="Auto,*" RowSpacing="1">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,*" VerticalOptions="Center">
					<controls:FFPageHeader Title="Увоз / Извоз на МКБ" Subtitle="Увезете МКБ-10 шифрарник од датотека." />
					<HorizontalStackLayout
						Grid.Column="1"
						HorizontalOptions="End"
						Spacing="10"
						VerticalOptions="Center">
						<Button
							BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
							TextColor="White"
							Command="{Binding CancelImportCommand}"
							HeightRequest="45"
							IsVisible="{Binding IsImporting}"
							Style="{StaticResource TabButtonActiveStyle}"
							Text="Прекини"
							WidthRequest="140" />
						<Button
							BackgroundColor="{StaticResource SparkAccentTeal}"
							TextColor="White"
							Command="{Binding ImportCommand}"
							HeightRequest="45"
							Style="{StaticResource TabButtonActiveStyle}"
							Text="Увези"
							WidthRequest="140" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  FORM  -->
			<Border Grid.Row="1" Margin="16,0,16,2" Padding="0">
				<Border
					Padding="30"
					BackgroundColor="{StaticResource White}"
					Stroke="{StaticResource Gray100}"
					StrokeShape="RoundRectangle 12">

					<VerticalStackLayout Spacing="26">

						<!--  File picker section  -->
						<VerticalStackLayout>
							<Label Style="{StaticResource MbkSectionTitle}" Text="Датотека" />

							<Grid ColumnDefinitions="*,40,*" RowDefinitions="Auto">

								<!--
									File picker — label above underline field, browse button anchored
									inside the same column so it reads as one control, matching the
									label-above-underline convention used elsewhere.
								-->
								<VerticalStackLayout Grid.Row="0" Grid.Column="0">
									<Label Style="{StaticResource MbkFieldLabel}" Text="Избрана датотека" />
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<Entry
											Grid.Column="0"
											IsReadOnly="True"
											Placeholder="Не е избрана датотека"
											Style="{StaticResource MbkUnderlineEntry}"
											Text="{Binding SelectedFilePath}" />
										<!--
											This Button sits directly in the page content (not inside a DataTemplate),
											so its BindingContext is already the page's ViewModel — no RelativeSource
											needed, and BrowseFileAsync takes no parameter so no CommandParameter either.
										-->
										<Button
											Grid.Column="1"
											BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
											TextColor="White"
											Command="{Binding BrowseFileCommand}"
											HeightRequest="38"
											Style="{StaticResource TabButtonActiveStyle}"
											Text="Избери..."
											WidthRequest="120" />
									</Grid>
									<BoxView Style="{StaticResource MbkFieldUnderline}" />
								</VerticalStackLayout>

								<!--  gutter col 1 intentionally empty  -->

								<VerticalStackLayout Grid.Row="0" Grid.Column="2" />

							</Grid>
						</VerticalStackLayout>

						<BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

						<!--  Status + progress section  -->
						<VerticalStackLayout Spacing="10">
							<Label Style="{StaticResource MbkSectionTitle}" Text="Статус" />
							<Label
								FontSize="13"
								Text="{Binding StatusText}"
								TextColor="{StaticResource SparkTextSecondary}" />
							<!--  MAUI's ProgressBar takes a single 0-1 fraction, not Minimum/Maximum/Value  -->
							<ProgressBar
								HeightRequest="8"
								IsVisible="{Binding IsImporting}"
								Progress="{Binding ImportProgressFraction}"
								ProgressColor="{StaticResource SparkAccentTeal}" />
						</VerticalStackLayout>

						<!--  Results section  -->
						<VerticalStackLayout IsVisible="{Binding HasResult}" Spacing="14">

							<BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

							<Label Style="{StaticResource MbkSectionTitle}" Text="Резултати" />

							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">
								<Border Grid.Column="0" Style="{StaticResource DashboardSummaryCard}">
									<Grid RowDefinitions="Auto,Auto" RowSpacing="6">
										<Label Style="{StaticResource MbkResultCountLabel}" Text="Додадени" />
										<Label
											Grid.Row="1"
											Style="{StaticResource MbkResultCountValue}"
											Text="{Binding InsertedCount}" />
									</Grid>
								</Border>
								<Border Grid.Column="1" Style="{StaticResource DashboardSummaryCard}">
									<Grid RowDefinitions="Auto,Auto" RowSpacing="6">
										<Label Style="{StaticResource MbkResultCountLabel}" Text="Ажурирани" />
										<Label
											Grid.Row="1"
											Style="{StaticResource MbkResultCountValue}"
											Text="{Binding UpdatedCount}" />
									</Grid>
								</Border>
								<Border Grid.Column="2" Style="{StaticResource DashboardSummaryCard}">
									<Grid RowDefinitions="Auto,Auto" RowSpacing="6">
										<Label Style="{StaticResource MbkResultCountLabel}" Text="Прескокнати" />
										<Label
											Grid.Row="1"
											Style="{StaticResource MbkResultCountValue}"
											Text="{Binding SkippedCount}" />
									</Grid>
								</Border>
							</Grid>

							<!--
								MAUI has no ListBox; CollectionView is the equivalent for a bound list.
								x:DataType="x:String" on the template enables compiled bindings for the
								"Binding ." path against the plain string items in Errors.
							-->
							<Border
								Padding="10"
								BackgroundColor="{StaticResource SparkBadgeNeutralBg}"
								Stroke="{StaticResource SparkBorderSubtle}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="1">
								<CollectionView HeightRequest="180" ItemsSource="{Binding Errors}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="x:String">
											<Label
												Margin="0,2"
												FontSize="12.5"
												Text="{Binding .}"
												TextColor="{StaticResource SparkDanger}" />
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</Border>

						</VerticalStackLayout>

					</VerticalStackLayout>

				</Border>
			</Border>

		</Grid>
	</Border>
</ContentPage>