<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Views.MenuView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:converters="clr-namespace:EHMR.Extensions"
	xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	x:Name="Root"
	mc:Ignorable="d">

	<Border
		Padding="0"
		BackgroundColor="{StaticResource Surface}"
		StrokeThickness="0">

		<Grid RowDefinitions="Auto,Auto,*,Auto" WidthRequest="270">

			<!--  ================= HEADER / LOGO =================  -->
			<Grid
				Grid.Row="0"
				Padding="22,24,20,18"
				Background="{StaticResource DialogBackground}"
				ColumnDefinitions="26,*"
				ColumnSpacing="10">

				<Label
					FontFamily="FASolid"
					FontSize="18"
					Text="&#xf005;"
					TextColor="{StaticResource SidebarActiveBg}"
					VerticalOptions="Center" />

				<Label
					Grid.Column="1"
					FontAttributes="Bold"
					FontSize="18"
					Text="EHMR"
					TextColor="White"
					VerticalOptions="Center" />
			</Grid>
			<BoxView
				Grid.Row="1"
				BackgroundColor="{StaticResource SidebarActiveBg}"
				HeightRequest="1"
				HorizontalOptions="Fill" />
			<!--  ================= NAVIGATION =================  -->
			<ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Padding="12,8,12,14" Spacing="2">

					<CollectionView ItemsSource="{Binding Items}" SelectionMode="None">
						<CollectionView.ItemTemplate>
							<DataTemplate>
								<VerticalStackLayout Spacing="0">

									<!--  ================= GROUP HEADER =================  -->
									<Border
										Padding="14,0"
										HeightRequest="42"
										StrokeThickness="0">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="1" />
										</Border.StrokeShape>

										<Border.Triggers>
											<DataTrigger
												Binding="{Binding IsActive}"
												TargetType="Border"
												Value="True">
												<Setter Property="BackgroundColor" Value="{StaticResource SidebarActiveBg}" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsActive}"
												TargetType="Border"
												Value="False">
												<Setter Property="BackgroundColor" Value="Transparent" />
											</DataTrigger>
										</Border.Triggers>

										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.ToggleGroupCommand}" CommandParameter="{Binding .}" />
										</Border.GestureRecognizers>

										<Grid ColumnDefinitions="20,*,16" ColumnSpacing="12">
											<Label
												Grid.Column="0"
												FontFamily="FASolid"
												FontSize="14"
												HorizontalOptions="Center"
												Text="{Binding Icon.Glyph}"
												VerticalOptions="Center">
												<Label.Triggers>
													<DataTrigger
														Binding="{Binding IsActive}"
														TargetType="Label"
														Value="True">
														<Setter Property="TextColor" Value="{StaticResource SidebarActiveBg}" />
													</DataTrigger>
													<DataTrigger
														Binding="{Binding IsActive}"
														TargetType="Label"
														Value="False">
														<Setter Property="TextColor" Value="{StaticResource SidebarText}" />
													</DataTrigger>
												</Label.Triggers>
											</Label>

											<Label
												Grid.Column="1"
												FontSize="14"
												LineBreakMode="TailTruncation"
												Text="{Binding GroupTitle}"
												VerticalOptions="Center">
												<Label.Triggers>
													<DataTrigger
														Binding="{Binding IsActive}"
														TargetType="Label"
														Value="True">
														<Setter Property="TextColor" Value="{StaticResource White}" />
														<Setter Property="FontAttributes" Value="Bold" />
													</DataTrigger>
													<DataTrigger
														Binding="{Binding IsActive}"
														TargetType="Label"
														Value="False">
														<Setter Property="TextColor" Value="{StaticResource SidebarText}" />
														<Setter Property="FontAttributes" Value="None" />
													</DataTrigger>
												</Label.Triggers>
											</Label>

											<Label
												Grid.Column="2"
												FontFamily="FASolid"
												FontSize="10"
												HorizontalOptions="End"
												VerticalOptions="Center">
												<Label.Triggers>
													<DataTrigger
														Binding="{Binding IsExpanded}"
														TargetType="Label"
														Value="True">
														<Setter Property="TextColor" Value="{StaticResource SidebarActiveBg}" />
														<Setter Property="Text" Value="&#xf077;" />
													</DataTrigger>
													<DataTrigger
														Binding="{Binding IsExpanded}"
														TargetType="Label"
														Value="False">
														<Setter Property="Text" Value="&#xf078;" />
													</DataTrigger>
													<DataTrigger
														Binding="{Binding IsActive}"
														TargetType="Label"
														Value="True">
														<Setter Property="TextColor" Value="{StaticResource SidebarActiveText}" />
													</DataTrigger>
													<DataTrigger
														Binding="{Binding IsActive}"
														TargetType="Label"
														Value="False">
														<Setter Property="TextColor" Value="{StaticResource SidebarTextMuted}" />
													</DataTrigger>
													<DataTrigger
														Binding="{Binding Items.Count}"
														TargetType="Label"
														Value="0">
														<Setter Property="IsVisible" Value="False" />
													</DataTrigger>
												</Label.Triggers>
											</Label>
										</Grid>
									</Border>

									<!--  ================= CHILDREN =================  -->
									<VerticalStackLayout
										Padding="0,6,0,6"
										IsVisible="{Binding IsExpanded}"
										Spacing="0">

										<BindableLayout.ItemsSource>
											<Binding Path="Items" />
										</BindableLayout.ItemsSource>

										<BindableLayout.ItemTemplate>
											<DataTemplate>
												<Grid
													Padding="22,0,10,0"
													ColumnDefinitions="16,*"
													ColumnSpacing="10"
													HeightRequest="32">

													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.NavigateCommand}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>

													<!--  connector line, contiguous across rows since Spacing="0"  -->
													<BoxView
														Grid.Column="0"
														HorizontalOptions="Center"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="{StaticResource SidebarActiveBg}" />

													<!--  bullet, painted with sidebar bg to mask the line behind it  -->
													<Border
														Grid.Column="0"
														Padding="0"
														BackgroundColor="{StaticResource CardSelected}"
														HeightRequest="9"
														HorizontalOptions="Center"
														StrokeThickness="1.4"
														VerticalOptions="Center"
														WidthRequest="9">
														<Border.StrokeShape>
															<Ellipse />
														</Border.StrokeShape>
														<Border.Triggers>
															<DataTrigger
																Binding="{Binding IsActive}"
																TargetType="Border"
																Value="True">
																<Setter Property="Stroke" Value="{StaticResource SidebarActiveBg}" />
															</DataTrigger>
															<DataTrigger
																Binding="{Binding IsActive}"
																TargetType="Border"
																Value="False">
																<Setter Property="Stroke" Value="{StaticResource CardSelected}" />
															</DataTrigger>
														</Border.Triggers>
													</Border>

													<Label
														Grid.Column="1"
														FontSize="13"
														LineBreakMode="TailTruncation"
														Text="{Binding Title}"
														VerticalOptions="Center">
														<Label.Triggers>
															<DataTrigger
																Binding="{Binding IsActive}"
																TargetType="Label"
																Value="True">
																<Setter Property="TextColor" Value="White" />
																<Setter Property="FontAttributes" Value="Bold" />
															</DataTrigger>
															<DataTrigger
																Binding="{Binding IsActive}"
																TargetType="Label"
																Value="False">
																<Setter Property="TextColor" Value="{StaticResource SidebarTextMuted}" />
																<Setter Property="FontAttributes" Value="None" />
															</DataTrigger>
														</Label.Triggers>
													</Label>
												</Grid>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</VerticalStackLayout>
			</ScrollView>

			<!--  ================= USER CARD =================  -->
			<Border
				Grid.Row="3"
				Margin="12,8,12,16"
				Padding="12,10"
				BackgroundColor="#2F3944"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid ColumnDefinitions="34,*,Auto" ColumnSpacing="10">
					<Border
						BackgroundColor="{StaticResource SidebarActiveBg}"
						HeightRequest="34"
						StrokeShape="Ellipse"
						StrokeThickness="0"
						VerticalOptions="Center"
						WidthRequest="34">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							HorizontalOptions="Center"
							Text="Д"
							TextColor="{StaticResource SidebarActiveText}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="1"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="12.5"
							Text="{Binding UserName}"
							TextColor="White" />
						<Label
							FontSize="10.5"
							Text="{Binding UserRole}"
							TextColor="{StaticResource SidebarTextMuted}" />
					</VerticalStackLayout>

					<Label
						Grid.Column="2"
						FontFamily="FASolid"
						FontSize="12"
						Text="&#xf013;"
						TextColor="{StaticResource SidebarTextMuted}"
						VerticalOptions="Center" />
				</Grid>
			</Border>
		</Grid>
	</Border>
</ContentView>