<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Therapies.ProtocolDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:DataType="viewModels:ProtocolDetailFormViewModel">

	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,*"
			RowSpacing="20">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->
			<Border
				Padding="28"
				BackgroundColor="{StaticResource SparkBackground}"
				Stroke="{StaticResource SparkBorder}"
				StrokeShape="RoundRectangle 0">

				<Grid ColumnDefinitions="*,Auto">

					<VerticalStackLayout Spacing="6" VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding PageTitle}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontSize="14"
							Text="Дефинирање на стандардизирани чекори, времетраење и клинички таргети за третманот"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<!--  ACTIONS  -->
					<HorizontalStackLayout
						Grid.Column="1"
						Spacing="12"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							HeightRequestEx="38"
							Text="Откажи"
							WidthRequest="140" />

						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							HeightRequestEx="38"
							Text="Зачувај"
							TextColorEx="White"
							WidthRequest="140" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  =========================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =========================================================  -->
			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 1"
				StrokeThickness="0">
				<ScrollView>
					<Grid
						Padding="32"
						ColumnDefinitions="*,380"
						ColumnSpacing="24">

						<!--  ЛЕВА СТРАНА: Внесување податоци  -->
						<VerticalStackLayout Grid.Column="0" Spacing="24">

							<VerticalStackLayout Spacing="12">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="ОСНОВНИ ПОДАТОЦИ ЗА ПРОТОКОЛОТ"
									TextColor="{StaticResource SparkTextPrimary}" />
								<BoxView
									Margin="0,10"
									HeightRequest="1"
									Color="{StaticResource SparkBorder}" />

								<!--  Наслов  -->
								<VerticalStackLayout Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Наслов на медицинскиот протокол *"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Протокол за третман на секундарна хипертензија"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding CurrentProtocol.Name, Mode=TwoWay}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="20">
									<!--  Категорија  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Медицинска категорија *"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="12,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="1">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Кардиологија"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding CurrentProtocol.DiseaseCategory, Mode=TwoWay}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<!--  Времетраење  -->
									<VerticalStackLayout Grid.Column="1" Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Стандардно времетраење (денови)"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="12,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="1">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Keyboard="Numeric"
												Placeholder="Пр. 30"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding CurrentProtocol.DurationInDays, Mode=TwoWay}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>
								</Grid>

								<!--  Опис  -->
								<VerticalStackLayout Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Детален клинички опис и индикации"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Padding="12,8"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="100"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Editor
											AutoSize="Disabled"
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Внесете ги главните индикации, симптоматологија..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding CurrentProtocol.Description, Mode=TwoWay}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
								</VerticalStackLayout>
							</VerticalStackLayout>

							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

							<!--  Иднa Секција  -->
							<Border
								Padding="20"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<VerticalStackLayout HorizontalOptions="Center" Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="14"
										HorizontalOptions="Center"
										Text="💊 Поврзани лекови и упатство за употреба"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										FontSize="12"
										HorizontalTextAlignment="Center"
										Text="Во следната фаза, тука ќе можете да закачувате конкретни лекови со дефинирани интервали."
										TextColor="{StaticResource SparkTextSecondary}" />
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>

						<!--  ДЕСНА СТРАНА: Системски информации  -->
						<VerticalStackLayout Grid.Column="1" Spacing="12">

							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="СИСТЕМСКИ ЗАПИС"
								TextColor="{StaticResource SparkAccentTeal}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />

							<Border
								Padding="20"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<VerticalStackLayout Spacing="14">
									<Grid ColumnDefinitions="*,Auto">
										<Label
											FontSize="13"
											Text="Креирано од доктор:"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Column="1"
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding CurrentProtocol.CreatedByDoctor}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Label
											FontSize="13"
											Text="Датум на запис:"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Column="1"
											FontSize="13"
											Text="{Binding CurrentProtocol.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Grid>
								</VerticalStackLayout>
							</Border>

							<!--  Верзии Индикатор  -->
							<Border
								Padding="16"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid ColumnDefinitions="Auto,*">
									<Label
										Margin="0,0,12,0"
										FontFamily="FASolid"
										FontSize="16"
										Text="&#xf3ed;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout Grid.Column="1" Spacing="2">
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="Контрола на верзии"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11"
											Text="Измените нема да ги променат активните планови."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
								</Grid>
							</Border>
						</VerticalStackLayout>
					</Grid>
				</ScrollView>
			</Border>
		</Grid>
	</Grid>
</ContentPage>