<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Therapies.ProtocolDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:ProtocolDetailFormViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*"
			RowSpacing="16">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader
	Grid.Row="0"
	Title="{Binding PageTitle}"
	Subtitle="Дефинирање на стандардизирани чекори, времетраење и клинички таргети за третманот"
	PrimaryButtonCommand="{Binding SaveCommand}"
	PrimaryButtonText="Зачувај"
	SecondaryButtonCommand="{Binding CancelCommand}"
	SecondaryButtonText="Откажи"
	ShowPrimaryButton="True"
	ShowSecondaryButton="True" />
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =====================================================  -->
			<controls:FFSectionCard Grid.Row="1" Margin="0" ContentPadding="18">
				<ScrollView VerticalScrollBarVisibility="Never">
					<Grid
						Padding="16"
						ColumnDefinitions="*,380"
						ColumnSpacing="24">

						<!--  ================================================  -->
						<!--  ЛЕВА СТРАНА — ОСНОВНИ ПОДАТОЦИ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="0" Spacing="24">

							<VerticalStackLayout Spacing="16">
								<controls:CrudSectionHeader Title="ОСНОВНИ ПОДАТОЦИ ЗА ПРОТОКОЛОТ" />

								<!--  Наслов  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<VerticalStackLayout Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Наслов на медицинскиот протокол *" />
										<controls:FFInput Placeholder="Пр. Протокол за третман на секундарна хипертензија" Text="{Binding CurrentProtocol.Name, Mode=TwoWay}" />
									</VerticalStackLayout>
								</Grid>

								<!--  Категорија / Времетраење  -->
								<Grid
									Padding="{StaticResource FormRowPadding}"
									ColumnDefinitions="*,1,*"
									ColumnSpacing="24">
									<BoxView Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />

									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Медицинска категорија *" />
										<controls:FFInput Placeholder="Пр. Кардиологија" Text="{Binding CurrentProtocol.DiseaseCategory, Mode=TwoWay}" />
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="2" Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Стандардно времетраење (денови)" />
										<controls:FFInput Keyboard="Numeric" Placeholder="Пр. 30" Text="{Binding CurrentProtocol.DurationInDays, Mode=TwoWay}" />
									</VerticalStackLayout>
								</Grid>

								<!--  Опис  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<VerticalStackLayout Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Детален клинички опис и индикации" />
										<Border Style="{StaticResource TextAreaFieldBoxStyle}">
											<Editor
												AutoSize="Disabled"
												BackgroundColor="Transparent"
												FontSize="13"
												HeightRequest="100"
												Placeholder="Внесете ги главните индикации, симптоматологија..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding CurrentProtocol.Description, Mode=TwoWay}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  Иднa Секција  -->
							<Border
								Padding="20"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkAccentTealBg}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<VerticalStackLayout HorizontalOptions="Center" Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="14"
										HorizontalOptions="Center"
										Text="💊 Поврзани лекови и упатство за употреба"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										FontSize="12"
										HorizontalTextAlignment="Center"
										Text="Во следната фаза, тука ќе можете да закачувате конкретни лекови со дефинирани интервали."
										TextColor="{StaticResource SparkTextSecondary}" />
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>

						<!--  ================================================  -->
						<!--  ДЕСНА СТРАНА — СИСТЕМСКИ ЗАПИС  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="1" Spacing="14">

							<controls:CrudSectionHeader Title="СИСТЕМСКИ ЗАПИС" />

							<Border
								Padding="16"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkAccentTealBg}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<VerticalStackLayout Spacing="12">
									<Grid ColumnDefinitions="*,Auto">
										<Label Style="{StaticResource ReadRowLabelStyle}" Text="Креирано од реуматолог:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding CurrentProtocol.CreatedByDoctor}" />
									</Grid>

									<Grid ColumnDefinitions="*,Auto">
										<Label Style="{StaticResource ReadRowLabelStyle}" Text="Датум на запис:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding CurrentProtocol.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
									</Grid>
								</VerticalStackLayout>
							</Border>

							<!--  Верзии Индикатор  -->
							<Border
								Padding="16"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkAccentTealBg}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid ColumnDefinitions="Auto,*">
									<Border
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										HeightRequest="36"
										StrokeShape="RoundRectangle 18"
										StrokeThickness="0"
										WidthRequest="36">
										<Label
											FontFamily="FASolid"
											FontSize="14"
											HorizontalOptions="Center"
											Text="&#xf3ed;"
											VerticalOptions="Center" />
									</Border>
									<VerticalStackLayout
										Grid.Column="1"
										Margin="12,0,0,0"
										Spacing="2"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="Контрола на верзии"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11"
											Text="Измените нема да ги променат активните планови."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
								</Grid>
							</Border>
						</VerticalStackLayout>
					</Grid>
				</ScrollView>
			</controls:FFSectionCard>
		</Grid>
	</Grid>
</ContentPage>
