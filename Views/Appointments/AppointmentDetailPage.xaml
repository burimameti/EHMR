<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Appointments.AppointmentDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Appointments"
	x:Name="PageRoot"
	x:DataType="vm:AppointmentDetailViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<DataTemplate x:Key="AppointmentDiagnosisHistoryRowTemplate" x:DataType="entities:Diagnosis">
				<Border
					Margin="0,2"
					Padding="10,8"
					BackgroundColor="White"
					Stroke="#E2E8F0"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="1">
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Mkb10Code.Code, TargetNullValue='—'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="11.5"
							LineBreakMode="TailTruncation"
							Text="{Binding Mkb10Code.Description, TargetNullValue='Без опис'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="2"
							FontSize="10.5"
							Text="{Binding DiagnosedAt, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="AppointmentHistoryRowTemplate" x:DataType="entities:Appointment">
				<Border
					Margin="0,2"
					Padding="10,8"
					BackgroundColor="White"
					Stroke="#E2E8F0"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="1">
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
						<BoxView
							CornerRadius="2"
							HeightRequest="30"
							WidthRequest="4"
							Color="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}" />
						<VerticalStackLayout Grid.Column="1" Spacing="2">
							<Label
								FontAttributes="Bold"
								FontSize="12"
								Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
								TextColor="{StaticResource SparkTextPrimary}" />
							<Label
								FontSize="11"
								LineBreakMode="TailTruncation"
								Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
								TextColor="{StaticResource SparkTextSecondary}" />
						</VerticalStackLayout>
						<Border
							Grid.Column="2"
							Padding="7,3"
							BackgroundColor="{StaticResource SparkAccentTealBg}"
							StrokeShape="RoundRectangle 7"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="9.5"
								Text="{Binding Status, Converter={StaticResource AppointmentStatusToLabelConverter}}"
								TextColor="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}" />
						</Border>
					</Grid>
				</Border>
			</DataTemplate>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*,Auto"
			RowSpacing="16">

			<!--  PAGE HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader
					Title="{Binding HeaderTitle}"
					Grid.Row="0"
					Margin="0,0,0,12"
					Subtitle="{Binding HeaderSubtitle}">
					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="10">
							<controls:FFStatusChip
								BackgroundColor="{Binding Appointment.Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
								IsVisible="{Binding IsReadOnly}"
								Text="{Binding Appointment.Status, Converter={StaticResource AppointmentStatusDisplayConverter}}"
								TextColor="White" />
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GenerateClinicalReportCommand}"
								ContentPadding="16,0"
								HeightRequestEx="40"
								IsVisible="{Binding IsReadOnly}"
								Text="Печати / PDF" />
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding ToggleEditModeCommand}"
								ContentPadding="22,0"
								HeightRequestEx="40"
								IsEnabled="{Binding CanEditAppointment}"
								IsVisible="{Binding CanEditAppointment}"
								Text="Уреди" />
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<!--  MAIN PANEL  -->
			<Grid
				Grid.Row="1"
				Margin="16,0,16,0"
				ColumnDefinitions="2.15*,1*"
				ColumnSpacing="16">

				<!--  ═══════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА  -->
				<!--  ═══════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="0"
					Margin="0"
					ContentPadding="18">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="0" Spacing="16">

							<!--  ══════════════════════════════════════════  -->
							<!--  1. ПАЦИЕНТ И РЕУМАТОЛОГ  -->
							<!--  ══════════════════════════════════════════  -->
							<VerticalStackLayout Spacing="12">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ПАЦИЕНТ И РЕУМАТОЛОГ" />
								</Border>

								<!--  Locked panels — existing appointment (view + edit mode)  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="12"
									IsVisible="{Binding IsNewAppointment, Converter={StaticResource InverseBoolConverter}}">
									<Border
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Избран пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatientForAppointment.FullName, TargetNullValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
									<Border
										Grid.Column="1"
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Матичен реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctorForAppointment.FullName, TargetNullValue='—'}"
													TextColor="{StaticResource SparkAccentTealDark}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  Search block — new appointment only  -->
								<VerticalStackLayout IsVisible="{Binding IsNewAppointment}" Spacing="8">

									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<controls:FFSearchBox Placeholder="Пребарај по име, ЕМБГ или СЗБО..." Text="{Binding PatientSearchText, Mode=TwoWay}" />
										<HorizontalStackLayout
											Grid.Column="1"
											Spacing="4"
											VerticalOptions="Center">
											<CheckBox IsChecked="{Binding UseCyrillicPatientSearch, Mode=TwoWay}" />
											<Label
												FontSize="12"
												Text="Кирилица"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Grid>

									<!--  Autocomplete dropdown  -->
									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowPatientSuggestions}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView
											HeightRequest="164"
											ItemsSource="{Binding PatientSuggestions}"
											SelectedItem="{Binding PatientSuggestionSelection, Mode=TwoWay}"
											SelectionMode="Single">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Patient">
													<Border
														Margin="1"
														Padding="10,7"
														BackgroundColor="#F8FAFC"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 7"
														StrokeThickness="1">
														<Grid ColumnDefinitions="2*,1.2*" ColumnSpacing="12">
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
															<VerticalStackLayout Grid.Column="1" Spacing="1">
																<Label
																	FontSize="9.5"
																	Text="СЗБО број"
																	TextColor="{StaticResource SparkTextSecondary}" />
																<Label
																	FontAttributes="Bold"
																	FontSize="11.5"
																	Text="{Binding SzboNumber}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
															</VerticalStackLayout>
														</Grid>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>

									<!--  Context panels shown after patient selected  -->
									<Grid
										ColumnDefinitions="*,*"
										ColumnSpacing="12"
										IsVisible="{Binding SelectedPatientForAppointment, Converter={StaticResource SparkNotNullConverter}}">
										<Border
											Padding="14,12"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
												<Border
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													HeightRequest="36"
													StrokeShape="RoundRectangle 10"
													StrokeThickness="0"
													WidthRequest="36">
													<Label
														FontFamily="FASolid"
														FontSize="13"
														HorizontalOptions="Center"
														Text="&#xf007;"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="1"
													VerticalOptions="Center">
													<Label
														FontSize="10"
														Text="Избран пациент"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="15"
														LineBreakMode="TailTruncation"
														Text="{Binding SelectedPatientForAppointment.FullName, TargetNullValue='—'}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
											</Grid>
										</Border>
										<Border
											Grid.Column="1"
											Padding="14,12"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
												<Border
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													HeightRequest="36"
													StrokeShape="RoundRectangle 18"
													StrokeThickness="0"
													WidthRequest="36">
													<Label
														FontFamily="FASolid"
														FontSize="13"
														HorizontalOptions="Center"
														Text="&#xf0f0;"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="1"
													VerticalOptions="Center">
													<Label
														FontSize="10"
														Text="Матичен реуматолог"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="15"
														LineBreakMode="TailTruncation"
														Text="{Binding SelectedDoctorForAppointment.FullName, TargetNullValue='—'}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</VerticalStackLayout>
											</Grid>
										</Border>
									</Grid>

								</VerticalStackLayout>

							</VerticalStackLayout>

							<!--  ══════════════════════════════════════════  -->
							<!--  2. ТЕРМИН  -->
							<!--  ══════════════════════════════════════════  -->
							<VerticalStackLayout Spacing="12">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ТЕРМИН" />
								</Border>
								<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">

									<!--  Scheduling horizon + auto slot (new only)  -->
									<Grid
										Grid.Row="0"
										ColumnDefinitions="*,1.4*"
										ColumnSpacing="20"
										IsVisible="{Binding IsNewAppointment}">
										<VerticalStackLayout Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Период за закажување" />
											<controls:FFPicker ItemsSource="{Binding SchedulingHorizonOptions}" SelectedItem="{Binding SelectedSchedulingHorizon, Mode=TwoWay}" />
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="1" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Автоматски слободен термин" />
											<Border Style="{StaticResource DetailValueSurfaceStyle}">
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding AutomaticSlotText}" />
											</Border>
										</VerticalStackLayout>
									</Grid>

									<!--  Date + Time  -->
									<Grid
										Grid.Row="1"
										ColumnDefinitions="1.4*,1*"
										ColumnSpacing="16">
										<VerticalStackLayout Grid.Column="0" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Датум" />
											<DatePicker
												BackgroundColor="White"
												Date="{Binding PreferredAppointmentDate, Mode=TwoWay}"
												IsVisible="{Binding IsEditMode}"
												TextColor="{StaticResource SparkTextPrimary}" />
											<Label
												Padding="12,10"
												IsVisible="{Binding IsReadOnly}"
												Style="{StaticResource CrudFormValueSurfaceStyle}"
												Text="{Binding Appointment.ScheduledStart, StringFormat='{:d.M.yyyy}'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<!--<VerticalStackLayout Grid.Column="1" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Време" />
											<TimePicker
												BackgroundColor="White"
												IsVisible="{Binding IsEditMode}"
												TextColor="{StaticResource SparkTextPrimary}"
												Time="{Binding SelectedStartTime, Mode=TwoWay}" />
											<Label
												Padding="12,10"
												IsVisible="{Binding IsReadOnly}"
												Style="{StaticResource CrudFormValueSurfaceStyle}"
												Text="{Binding Appointment.ScheduledStart}" />
										</VerticalStackLayout>-->
									</Grid>

									<!--  Status (edit mode, existing only)  -->
									<Grid
										Grid.Row="2"
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding ShowStatusEditor}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Статус" />
										<controls:FFPicker
											Grid.Column="1"
											ItemsSource="{Binding StatusOptions}"
											Placeholder="Изберете статус"
											SelectedItem="{Binding SelectedStatusOption}" />
									</Grid>
								</Grid>
							</VerticalStackLayout>
							<!--  ══════════════════════════════════════════  -->
							<!--  3. МКБ-10 ДИЈАГНОЗИ  -->
							<!--  ══════════════════════════════════════════  -->
							<VerticalStackLayout Spacing="14">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="МКБ-10 ДИЈАГНОЗИ" />
								</Border>

								<!--  ═══ EDIT MODE: alphabet + dual search + compact assigned list ═══  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									IsVisible="{Binding IsEditMode}"
									RowDefinitions="Auto,Auto"
									RowSpacing="12">

									<VerticalStackLayout Grid.ColumnSpan="2" Spacing="5">
										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="МКБ СЕКЦИЈА · ЛАТИНИЦА A–Z"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="6,5"
											BackgroundColor="#F4F7FA"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 9"
											StrokeThickness="1">
											<ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
												<FlexLayout
													BindableLayout.ItemsSource="{Binding MkbAlphabetSections}"
													Direction="Row"
													JustifyContent="Start"
													Wrap="NoWrap">
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="vm:MkbAlphabetSection">
															<Border
																Margin="1"
																Padding="2"
																HeightRequest="30"
																StrokeShape="RoundRectangle 6"
																StrokeThickness="1"
																WidthRequest="28">
																<Border.Triggers>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Border"
																		Value="True">
																		<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																		<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																	</DataTrigger>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Border"
																		Value="False">
																		<Setter Property="BackgroundColor" Value="White" />
																		<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
																	</DataTrigger>
																</Border.Triggers>
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectMkbSectionCommand}" CommandParameter="{Binding .}" />
																</Border.GestureRecognizers>
																<Label
																	FontAttributes="Bold"
																	FontSize="10.5"
																	HorizontalOptions="Center"
																	Text="{Binding Letter}"
																	VerticalOptions="Center">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
															</Border>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</FlexLayout>
											</ScrollView>
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="0"
										Spacing="12">

										<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
											<VerticalStackLayout Spacing="5">
												<Label
													FontAttributes="Bold"
													FontSize="11.5"
													Text="Пребарување по МКБ код (латиница)"
													TextColor="{StaticResource SparkTextSecondary}" />
												<controls:FFSearchBox Placeholder="Пример: M06.9" Text="{Binding DiagnosisSearchText, Mode=TwoWay}" />
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="1" Spacing="5">
												<Label
													FontAttributes="Bold"
													FontSize="11.5"
													Text="Пребарување по опис (кирилица)"
													TextColor="{StaticResource SparkTextSecondary}" />
												<controls:FFSearchBox Placeholder="Пример: ревматоиден артритис" Text="{Binding DiagnosisDescriptionSearchText, Mode=TwoWay}" />
											</VerticalStackLayout>
										</Grid>

										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowDiagnosisDropdown}"
											ItemsSource="{Binding AvailableDiagnoses}"
											SelectionMode="None">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddDiagnosisCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="1"
										Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="ДОДЕЛЕНИ ДИЈАГНОЗИ"
											TextColor="{StaticResource SparkTextSecondary}" />
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedDiagnoses}" Spacing="8">
											<BindableLayout.EmptyView>
												<Label
													FontSize="12"
													Text="Нема доделени дијагнози."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:Diagnosis">
													<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
														<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
														<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
															<Grid ColumnDefinitions="Auto,*,28" ColumnSpacing="8">
																<Label Style="{StaticResource CrudCollectionCodeStyle}" Text="{Binding Mkb10Code.Code}" />
																<Label
																	Grid.Column="1"
																	LineBreakMode="TailTruncation"
																	Style="{StaticResource CrudCollectionMetaStyle}"
																	Text="{Binding Mkb10Code.Description}" />
																<Button
																	Grid.Column="2"
																	Padding="0"
																	BackgroundColor="Transparent"
																	Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDiagnosisCommand}"
																	CommandParameter="{Binding .}"
																	FontSize="11"
																	HeightRequest="26"
																	Text="✕"
																	TextColor="#DC2626"
																	WidthRequest="26" />
															</Grid>
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</VerticalStackLayout>

								</Grid>

								<!--  ═══ READ-ONLY MODE: full-width data table ═══  -->
								<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="0">

									<!--  Table header  -->
									<Grid ColumnDefinitions="110,*,110" ColumnSpacing="1">
										<Border
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeShape="RoundRectangle 6,0,0,0"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="МКБ КОД"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="1"
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="ОПИС"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="2"
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeShape="RoundRectangle 0,6,0,0"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="ДАТУМ"
												TextColor="White" />
										</Border>
									</Grid>

									<!--  Table rows  -->
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedDiagnoses}" Spacing="0">
										<BindableLayout.EmptyView>
											<Border
												Padding="12,14"
												BackgroundColor="White"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeThickness="1">
												<Label
													FontSize="12"
													Text="Нема доделени дијагнози."
													TextColor="{StaticResource SparkTextSecondary}" />
											</Border>
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:Diagnosis">
												<Grid ColumnDefinitions="110,*,110" ColumnSpacing="1">
													<Border
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding Mkb10Code.Code}"
															TextColor="{StaticResource SparkAccentTealDark}" />
													</Border>
													<Border
														Grid.Column="1"
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontSize="12"
															LineBreakMode="TailTruncation"
															Text="{Binding Mkb10Code.Description}"
															TextColor="{StaticResource SparkTextPrimary}" />
													</Border>
													<Border
														Grid.Column="2"
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontSize="11"
															Text="{Binding DiagnosedAt, StringFormat='{0:dd.MM.yyyy}'}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</Border>
												</Grid>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>

							</VerticalStackLayout>

							<!--  ══════════════════════════════════════════  -->
							<!--  4. ЛЕКОВИ  -->
							<!--  ══════════════════════════════════════════  -->
							<VerticalStackLayout Spacing="12">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ЛЕКОВИ" />
								</Border>

								<!--  ═══ EDIT MODE: search + compact assigned list side-by-side ═══  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="16"
									IsVisible="{Binding IsEditMode}">

									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:FFSearchBox Placeholder="Пребарување на лекот..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />

										<Border
											Padding="4"
											BackgroundColor="White"
											IsVisible="{Binding ShowMedicineDropdown}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<CollectionView
												HeightRequest="200"
												ItemsSource="{Binding MedicineResults}"
												SelectionMode="None">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="entities:Medicine">
														<Border
															Margin="2,2,2,0"
															Padding="10,8"
															BackgroundColor="Transparent"
															StrokeThickness="0">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<VerticalStackLayout Spacing="2">
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	Text="{Binding Name}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
																<Label
																	FontSize="11"
																	Text="{Binding GenericName}"
																	TextColor="{StaticResource SparkTextSecondary}" />
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="0">
										<Label
											Margin="0,0,0,8"
											FontAttributes="Bold"
											FontSize="11"
											Text="Доделени лекови"
											TextColor="{StaticResource SparkTextSecondary}" />

										<!--  Table header  -->
										<Grid
											ColumnDefinitions="2*,1*,32"
											ColumnSpacing="1"
											IsVisible="{Binding HasSelectedMedicines}">
											<Border
												Grid.Column="0"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeShape="RoundRectangle 6,0,0,0"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="ИМЕ НА ЛЕКОТ"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="1"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="КОЛИЧИНА"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="2"
												BackgroundColor="#475569"
												StrokeShape="RoundRectangle 0,6,0,0"
												StrokeThickness="0" />
										</Grid>

										<!--  Table rows  -->
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedMedicines}" Spacing="0">
											<BindableLayout.EmptyView>
												<Border
													Padding="12,14"
													BackgroundColor="White"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Label
														FontSize="12"
														Text="Нема доделени лекови."
														TextColor="{StaticResource SparkTextSecondary}" />
												</Border>
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:PatientMedicine">
													<Grid ColumnDefinitions="2*,1*,32" ColumnSpacing="1">
														<Border
															Grid.Column="0"
															Padding="10,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Label
																FontSize="12"
																LineBreakMode="TailTruncation"
																Text="{Binding Medicine.Name, TargetNullValue='Непознат лек'}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="1"
															Padding="4,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Entry
																BackgroundColor="Transparent"
																FontSize="12"
																Keyboard="Numeric"
																Text="{Binding Dosage, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center"
																VerticalTextAlignment="Center" />
														</Border>
														<Border
															Grid.Column="2"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
																CommandParameter="{Binding .}"
																FontSize="12"
																Text="✕"
																TextColor="#DC2626"
																WidthRequest="32" />
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>

								<!--  ═══ READ-ONLY MODE: full-width data table ═══  -->
								<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="0">

									<Grid ColumnDefinitions="*,1.3*,90,110" ColumnSpacing="1">
										<Border
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeShape="RoundRectangle 6,0,0,0"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="НАЗИВ"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="1"
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="ГЕНЕРИЧКО ИМЕ"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="2"
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="КОЛИЧИНА"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="3"
											Padding="12,9"
											BackgroundColor="#475569"
											StrokeShape="RoundRectangle 0,6,0,0"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="11"
												Text="ДАТУМ"
												TextColor="White" />
										</Border>
									</Grid>

									<VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedMedicines}" Spacing="0">
										<BindableLayout.EmptyView>
											<Border
												Padding="12,14"
												BackgroundColor="White"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeThickness="1">
												<Label
													FontSize="12"
													Text="Нема доделени лекови."
													TextColor="{StaticResource SparkTextSecondary}" />
											</Border>
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:PatientMedicine">
												<Grid ColumnDefinitions="*,1.3*,90,110" ColumnSpacing="1">
													<Border
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding Medicine.Name, TargetNullValue='Непознат лек'}"
															TextColor="{StaticResource SparkAccentTealDark}" />
													</Border>
													<Border
														Grid.Column="1"
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontSize="12"
															Text="{Binding Medicine.GenericName}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</Border>
													<Border
														Grid.Column="2"
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontSize="12"
															Text="{Binding Dosage}"
															TextColor="{StaticResource SparkTextPrimary}" />
													</Border>
													<Border
														Grid.Column="3"
														Padding="12,10"
														BackgroundColor="White"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontSize="11"
															Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</Border>
												</Grid>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>

							</VerticalStackLayout>

							<!--  ══════════════════════════════════════════  -->
							<!--  5. ЗАБЕЛЕШКА  -->
							<!--  ══════════════════════════════════════════  -->
							<VerticalStackLayout Spacing="12">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ЗАБЕЛЕШКА" />
								</Border>

								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Забелешка (опционално)" />
									<Border Style="{StaticResource TextAreaFieldBoxStyle}">
										<Editor
											AutoSize="TextChanges"
											BackgroundColor="Transparent"
											FontSize="13"
											MinimumHeightRequest="64"
											Placeholder="Внесете забелешка за терминот..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Appointment.ClinicalNotes}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
								</VerticalStackLayout>

								<Grid
									ColumnDefinitions="130,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Забелешка:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Appointment.ClinicalNotes, TargetNullValue='Нема евидентирано.'}" />
								</Grid>

							</VerticalStackLayout>

							<!--  ══════════════════════════════════════════  -->
							<!--  АКЦИИ — исто позиционирање како во Encounter  -->
							<!--  ══════════════════════════════════════════  -->
							<Grid
								Padding="0,8,0,8"
								ColumnDefinitions="*,*"
								ColumnSpacing="16"
								IsVisible="{Binding IsEditMode}">
								<controls:FFButton
									Grid.Column="0"
									ButtonKind="Secondary"
									Command="{Binding CancelCommand}"
									HeightRequestEx="46"
									Text="Откажи" />
								<controls:FFButton
									Grid.Column="1"
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									ButtonKind="Primary"
									Command="{Binding SaveCommand}"
									HeightRequestEx="46"
									IsEnabled="{Binding CanSaveAppointment}"
									Text="Зачувај"
									TextColorEx="White" />
							</Grid>

						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ИСТОРИЈА НА ПАЦИЕНТОТ  -->
				<!--  ═══════════════════════════════════════════════════  -->
				<Grid
					Grid.Column="1"
					RowDefinitions="Auto,*"
					RowSpacing="12">

					<controls:FFSectionCard Margin="0" ContentPadding="18">
						<VerticalStackLayout Padding="14" Spacing="12">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Style="{StaticResource SectionPillLabelStyle}"
									Text="ИСТОРИЈА НА ПАЦИЕНТОТ" />
							</Border>

							<controls:SparkExpandableCard
								Title="Термини"
								CardBackgroundColor="White"
								EmptyViewText="Нема претходни термини."
								HeaderTextColor="{StaticResource SparkTextPrimary}"
								ItemTemplate="{StaticResource AppointmentHistoryRowTemplate}"
								ItemsSource="{Binding AppointmentHistory}"
								Subtitle=""
								Variant="Appointment" />

							<controls:SparkExpandableCard
								Title="Дијагнози"
								CardBackgroundColor="White"
								EmptyViewText="Нема историја на дијагнози."
								HeaderTextColor="{StaticResource SparkTextPrimary}"
								ItemTemplate="{StaticResource AppointmentDiagnosisHistoryRowTemplate}"
								ItemsSource="{Binding PatientDiagnosisHistory}"
								Subtitle=""
								Variant="Diagnosis" />

						</VerticalStackLayout>
					</controls:FFSectionCard>

				</Grid>
			</Grid>
			<Border Grid.Row="2" Margin="0,0,0,16" Padding="16,10" BackgroundColor="White" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
					<Label Grid.Column="0" FontSize="10.5" Text="Завршете ги податоците за терминот" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
					<controls:FFButton Grid.Column="1" ButtonKind="Secondary" Command="{Binding CancelCommand}" HeightRequestEx="42" IsVisible="{Binding IsEditMode}" Text="Откажи" WidthRequestEx="130" />
					<controls:FFButton Grid.Column="2" BackgroundColorEx="{StaticResource SidebarActiveBg}" ButtonKind="Primary" Command="{Binding SaveCommand}" HeightRequestEx="42" IsEnabled="{Binding CanSaveAppointment}" IsVisible="{Binding IsEditMode}" Text="Зачувај" TextColorEx="White" WidthRequestEx="130" />
				</Grid>
			</Border>

		</Grid>
	</Grid>
</ContentPage>

