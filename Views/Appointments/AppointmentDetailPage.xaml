<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Appointments.AppointmentDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Appointments"
	x:Name="PageRoot"
	x:DataType="vm:AppointmentDetailViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<!--  ═══ ШАБЛОНИ ЗА ИСТОРИЈА ═══  -->

			<DataTemplate x:Key="AppointmentDiagnosisHistoryRowTemplate">
				<Grid
					Padding="8,6"
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="10">
					<Label
						Grid.Column="0"
						FontAttributes="Bold"
						FontFamily="Consolas"
						FontSize="12"
						Text="{Binding Mkb10Code}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Description}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="2"
						FontSize="11"
						Text="{Binding DiagnosedOn, StringFormat='{0:dd.MM.yyyy}'}"
						TextColor="{StaticResource SparkTextSecondary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="Mkb10SearchResultRowTemplate" x:DataType="entities:Mkb10Code">
				<Grid Padding="10,8">
					<Grid.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddDiagnosisCommand}" CommandParameter="{Binding .}" />
					</Grid.GestureRecognizers>
					<HorizontalStackLayout Spacing="8">
						<Label
							FontAttributes="Bold"
							FontFamily="Consolas"
							FontSize="12"
							Text="{Binding Code}"
							TextColor="{StaticResource SparkAccentTealDark}" />
						<Label
							FontSize="12"
							Text="{Binding Description}"
							TextColor="{StaticResource SparkTextPrimary}" />
					</HorizontalStackLayout>
				</Grid>
			</DataTemplate>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			Padding="16,12,16,16"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<!--  Avatar circle  -->
					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf073;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<!--  Title + subtitle + status chip  -->
					<VerticalStackLayout
						Grid.Column="1"
						Spacing="6"
						VerticalOptions="Center">
						<Label Style="{StaticResource PageTitleStyle}" Text="{Binding HeaderTitle}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="{Binding HeaderSubtitle}"
							TextColor="{StaticResource SparkTextSecondary}" />
						<!--
							FIX: was bound to StatusOptions (the whole list) instead of the
							current Appointment.Status - the converter received a List<string>,
							failed its `is AppointmentStatus` check, and fell through to
							value?.ToString(), which prints the collection's type name instead
							of a status label. Now bound to the single current status value.
						-->
						<controls:FFStatusChip
							BackgroundColor="{Binding Appointment.Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
							HorizontalOptions="Start"
							Text="{Binding Appointment.Status, Converter={StaticResource AppointmentStatusDisplayConverter}}"
							TextColor="White"
							VerticalOptions="Start" />
					</VerticalStackLayout>

					<!--  Action buttons  -->
					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="12"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding ToggleEditModeCommand}"
							ContentPadding="24,0"
							HeightRequestEx="42"
							IsEnabled="{Binding CanEditAppointment}"
							IsVisible="{Binding CanEditAppointment}"
							Text="✎ Уреди" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="24,0"
							HeightRequestEx="42"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи" />
						<!--
							FIX: was gated on CanCreateAppointments only, which disabled Save
							for a user with update-but-not-create rights editing an EXISTING
							appointment. CanSaveAppointment picks the right permission based
							on whether this is a new appointment or an edit.
						-->
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="24,0"
							HeightRequestEx="42"
							IsEnabled="{Binding CanSaveAppointment}"
							IsVisible="{Binding IsEditMode}"
							Text="💾 Зачувај" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  =====================================================  -->
			<!--  MAIN PANEL  -->
			<!--  =====================================================  -->
			<Grid
				Grid.Row="1"
				ColumnDefinitions="*"
				ColumnSpacing="0">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМУЛАРИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Border Grid.Column="0" Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="16" Spacing="28">

							<!--  ================================================  -->
							<!--  СЕКЦИЈА — ПАЦИЕНТ / РЕУМАТОЛОГ  -->
							<!--  ================================================  -->
							<VerticalStackLayout Spacing="16">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ПОДАТОЦИ ЗА ПАЦИЕНТ / РЕУМАТОЛОГ" />
								</Border>

								<Grid
									Padding="12,0"
									ColumnDefinitions="*,1,*"
									ColumnSpacing="24">

									<BoxView Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />

									<!--  Пациент  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<Grid
											ColumnDefinitions="130,*"
											ColumnSpacing="{StaticResource FormRowSpacing}"
											IsVisible="{Binding IsEditMode}">
											<Label
												Grid.Column="0"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Пациент *" />
											<!--
												NOTE: this SelectedItem binding only sets
												SelectedPatientForAppointment - it does NOT run
												OnPatientChangedAsync/PatientChangedCommand (which reloads
												history, diagnoses, and therapy cycles for the newly picked
												patient). For a brand-new appointment this is usually fine
												since IsEnabled only allows changing it when IsNewAppointment
												is true anyway, but if you want history/therapy context to
												refresh live as the user changes the patient before saving,
												wire this picker's selection-changed event (in code-behind
												or a Behavior) to invoke PatientChangedCommand explicitly.
											-->
											<controls:FFPicker
												Grid.Column="1"
												IsEnabled="{Binding IsNewAppointment}"
												ItemsSource="{Binding PatientsList}"
												Placeholder="Изберете пациент *"
												SelectedItem="{Binding SelectedPatientForAppointment}" />
										</Grid>
										<Grid
											ColumnDefinitions="130,*"
											ColumnSpacing="{StaticResource FormRowSpacing}"
											IsVisible="{Binding IsReadOnly}">
											<Label
												Grid.Column="0"
												Style="{StaticResource ReadRowLabelStyle}"
												Text="Пациент:" />
											<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
												<HorizontalStackLayout Spacing="8">
													<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf007;" />
													<Label
														Style="{StaticResource InfoPillTextStyle}"
														Text="{Binding SelectedPatientForAppointment.FullName, FallbackValue='—'}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</HorizontalStackLayout>
											</Border>
										</Grid>
									</VerticalStackLayout>
									<!--  Реуматологот е доделен на пациентот  -->
									<VerticalStackLayout Grid.Column="2" Spacing="8">
										<Grid ColumnDefinitions="130,*" ColumnSpacing="{StaticResource FormRowSpacing}">
											<Label
												Grid.Column="0"
												Style="{StaticResource ReadRowLabelStyle}"
												Text="Матичен реуматолог:" />
											<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
												<HorizontalStackLayout Spacing="8">
													<Label
														Style="{StaticResource InfoPillIconStyle}"
														Text="&#xf0f0;"
														TextColor="{StaticResource SparkAccentTealDark}" />
													<Label
														Style="{StaticResource InfoPillTextStyle}"
														Text="{Binding SelectedDoctorForAppointment.FullName, TargetNullValue='Се зема од пациентот'}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</HorizontalStackLayout>
											</Border>
										</Grid>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  ================================================  -->
							<!--  СЕКЦИЈА — ТЕРМИН  -->
							<!--  ================================================  -->
							<VerticalStackLayout Spacing="16">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ТЕРМИН" />
								</Border>

								<Grid
									Padding="12,0"
									RowDefinitions="Auto,Auto,Auto"
									RowSpacing="16">

									<Grid
										Grid.Row="0"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<VerticalStackLayout Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Период за закажување" />
											<controls:FFPicker ItemsSource="{Binding SchedulingHorizonOptions}" SelectedItem="{Binding SelectedSchedulingHorizon, Mode=TwoWay}" />
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="1" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Автоматски слободен термин" />
											<Border Style="{StaticResource InfoPillBorderStyle}">
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding AutomaticSlotText}" />
											</Border>
										</VerticalStackLayout>
									</Grid>
									<!--  Датумот и времето ги пресметува системот  -->
									<Grid
										Grid.Row="1"
										ColumnDefinitions="*,*,*"
										ColumnSpacing="24">
										<VerticalStackLayout Grid.Column="0" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Датум" />
											<Border Style="{StaticResource InfoPillBorderStyle}">
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Appointment.ScheduledStart, StringFormat='{0:dd.MM.yyyy}'}" />
											</Border>
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="1" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Почеток" />
											<Border Style="{StaticResource InfoPillBorderStyle}">
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Appointment.ScheduledStart, StringFormat='{0:HH:mm}'}" />
											</Border>
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="2" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Крај" />
											<Border Style="{StaticResource InfoPillBorderStyle}">
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Appointment.ScheduledEnd, StringFormat='{0:HH:mm}'}" />
											</Border>
										</VerticalStackLayout>
									</Grid>

									<!--
                                        FIX (status save bug): the picker now binds ItemsSource to the
										typed StatusOptions (IReadOnlyList<AppointmentStatusOption>) and
										SelectedItem to SelectedStatusOption - a plain object binding with
										NO converter. Previously SelectedItem went through
										AppointmentStatusConverter (a different resource key than the
										AppointmentStatusDisplayConverter used everywhere else), and even
										ignoring that mismatch, ConvertBack was being fed enum names
										("Scheduled") from StatusOptions instead of the Macedonian labels
										("Закажан") it looks up - so ConvertBack always returned
										BindableProperty.UnsetValue and Appointment.Status was never
										updated by picking a new status.
									-->
									<Grid
										Grid.Row="2"
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding ShowStatusEditor}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Статус" />
										<controls:FFPicker
											Grid.Column="1"
											ItemsSource="{Binding StatusOptions}"
											Placeholder="Изберете статус"
											SelectedItem="{Binding SelectedStatusOption}" />
									</Grid>
								</Grid>
							</VerticalStackLayout>
							<!--  ================================================  -->
							<!--  СЕКЦИЈА — ЗАБЕЛЕШКА  -->
							<!--  ================================================  -->
							<VerticalStackLayout Spacing="16">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ЗАБЕЛЕШКА" />
								</Border>
								<Grid Padding="12,0">
									<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Забелешка (опционално)" />
										<Border Style="{StaticResource TextAreaFieldBoxStyle}">
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												MinimumHeightRequest="64"
												Placeholder="Внесете забелешка за терминот..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Appointment.ClinicalNotes}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</VerticalStackLayout>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Забелешка:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Appointment.ClinicalNotes, TargetNullValue='Нема евидентирано.'}" />
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  ================================================  -->
							<!--  СЕКЦИЈА — МКБ-10 ДИЈАГНОЗИ  -->
							<!--  ================================================  -->
							<VerticalStackLayout Spacing="16">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ТЕРАПЕВТСКИ ЦИКЛУС" />
								</Border>
								<Grid
									Padding="12,0"
									ColumnDefinitions="180,*"
									ColumnSpacing="{StaticResource FormRowSpacing}">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Циклус за пациентот" />
									<controls:FFPicker
										Grid.Column="1"
										IsEnabled="{Binding IsEditMode}"
										ItemsSource="{Binding VisibleTherapies}"
										Placeholder="Изберете терапевтски циклус"
										SelectedItem="{Binding SelectedTherapyCycle}" />
								</Grid>
							</VerticalStackLayout>
							<VerticalStackLayout Spacing="16">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="МКБ-10 ДИЈАГНОЗИ" />
								</Border>

								<Grid Margin="12,0" IsVisible="{Binding IsEditMode}">
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Внесете шифра или назив на МКБ-10..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding DiagnosisSearchText, Mode=TwoWay}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Border
									Margin="12,0"
									IsVisible="{Binding ShowDiagnosisDropdown}"
									Style="{StaticResource SearchDropdownBorderStyle}">
									<CollectionView ItemTemplate="{StaticResource Mkb10SearchResultRowTemplate}" ItemsSource="{Binding AvailableDiagnoses}" />
								</Border>

								<FlexLayout
									Margin="12,4,12,0"
									BindableLayout.ItemsSource="{Binding SelectedDiagnoses}"
									Direction="Row"
									JustifyContent="Start"
									Wrap="Wrap">
									<BindableLayout.EmptyView>
										<Label
											Padding="0,4"
											FontSize="13"
											Text="Нема доделени дијагнози."
											TextColor="{StaticResource SparkTextSecondary}" />
									</BindableLayout.EmptyView>
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="entities:Diagnosis">
											<Border Margin="0,0,6,6" Style="{StaticResource TokenChipBorderStyle}">
												<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontFamily="Consolas"
														FontSize="12"
														Text="{Binding Mkb10Code.Code}" />
													<Label
														FontSize="12"
														Text="{Binding Mkb10Code.Description}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Button
														Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDiagnosisCommand}"
														CommandParameter="{Binding .}"
														IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
														Style="{StaticResource TokenChipRemoveButtonStyle}"
														Text="✕"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</HorizontalStackLayout>
											</Border>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</FlexLayout>
							</VerticalStackLayout>

							<!--  ═══════════════════════════════════════════════════  -->
							<!--  ИСТОРИЈА НА ТЕРМИНИ  -->
							<!--  ═══════════════════════════════════════════════════  -->
							<VerticalStackLayout IsVisible="{Binding IsNewAppointment, Converter={StaticResource AppointmentInvertedBoolConverter}}" Spacing="14">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ИСТОРИЈА НА ТЕРМИНИ" />
								</Border>

								<!--
									Prefer SelectionChangedCommand over the raw TapGestureRecognizer
									previously on each row Border - gives built-in accessibility support
									and a selected-state visual for free, and matches how CollectionView
									is meant to report user selection.
								-->
								<CollectionView
									Margin="12,0"
									ItemsSource="{Binding AppointmentHistory}"
									MaximumHeightRequest="260"
									SelectionChangedCommand="{Binding SelectAppointmentCommand}"
									SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}"
									SelectionMode="Single">
									<CollectionView.EmptyView>
										<Label
											FontSize="13"
											Text="Нема претходни термини."
											TextColor="{StaticResource SparkTextSecondary}" />
									</CollectionView.EmptyView>
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="entities:Appointment">
											<Border
												Margin="0,4"
												Padding="12"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0">
												<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="0">
													<BoxView
														Grid.Column="0"
														CornerRadius="2"
														HeightRequest="32"
														WidthRequest="4"
														Color="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}" />
													<VerticalStackLayout Grid.Column="1" Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
														<Label
															FontSize="12"
															LineBreakMode="TailTruncation"
															Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
													<Label
														Grid.Column="2"
														FontSize="11"
														Text="{Binding Status, Converter={StaticResource AppointmentStatusToLabelConverter}}"
														TextColor="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
														VerticalOptions="Center" />
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

							<!--  ═══════════════════════════════════════════════════  -->
							<!--  ИСТОРИЈА НА ДИЈАГНОЗИ  -->
							<!--  ═══════════════════════════════════════════════════  -->
							<VerticalStackLayout Spacing="14">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ИСТОРИЈА НА ДИЈАГНОЗИ" />
								</Border>

								<controls:SparkExpandableCard
									Title="Дијагнози"
									Margin="12,0"
									EmptyViewText="Нема историја на дијагнози."
									ItemTemplate="{StaticResource AppointmentDiagnosisHistoryRowTemplate}"
									ItemsSource="{Binding PatientDiagnosisHistory}"
									Subtitle="Пациент"
									Variant="Diagnosis" />
							</VerticalStackLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — АКЦИИ + ПАЦИЕНТ КОНТЕКСТ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Grid
					Grid.Column="0"
					IsVisible="False"
					RowDefinitions="Auto,*"
					RowSpacing="12">

					<!--  Брзи акции  -->
					<Border Style="{StaticResource PageHeaderCardStyle}">
						<VerticalStackLayout Padding="16" Spacing="14">
							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="АКЦИИ" />
							</Border>

							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding NewAppointmentForPatientCommand}"
								CommandParameter="{Binding SelectedPatientForAppointment}"
								ContentPadding="8,0"
								HeightRequestEx="38"
								IsVisible="{Binding IsReadOnly}"
								Text="+ Нов термин за пациентот" />
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GenerateNextCycleCommand}"
								ContentPadding="8,0"
								HeightRequestEx="38"
								IsVisible="{Binding IsReadOnly}"
								Text="Генерирај нареден циклус" />

							<Grid IsVisible="{Binding IsEditMode}">
								<Label Style="{StaticResource EditFieldLabelStyle}" Text="Терапевтски циклус" />
							</Grid>
							<controls:FFPicker
								IsVisible="{Binding IsEditMode}"
								ItemsSource="{Binding VisibleTherapies}"
								Placeholder="Изберете циклус"
								SelectedItem="{Binding SelectedTherapyCycle}" />
						</VerticalStackLayout>
					</Border>

					<!--  Пациент контекст  -->
					<Border Grid.Row="1" Style="{StaticResource PageHeaderCardStyle}">
						<ScrollView VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="16" Spacing="16">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label Style="{StaticResource SectionPillLabelStyle}" Text="ПОДАТОЦИ ЗА ТЕРМИНОТ" />
								</Border>

								<!--  Избран пациент  -->
								<Grid ColumnDefinitions="130,*" ColumnSpacing="{StaticResource FormRowSpacing}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Пациент:" />
									<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
										<HorizontalStackLayout Spacing="8">
											<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf007;" />
											<Label
												Style="{StaticResource InfoPillTextStyle}"
												Text="{Binding SelectedPatientForAppointment.FullName, TargetNullValue='—'}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</HorizontalStackLayout>
									</Border>
								</Grid>

								<!--  Реуматолог  -->
								<Grid
									ColumnDefinitions="130,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding SelectedDoctorForAppointment}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Реуматолог:" />
									<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
										<HorizontalStackLayout Spacing="8">
											<Label
												Style="{StaticResource InfoPillIconStyle}"
												Text="&#xf0f0;"
												TextColor="{StaticResource SparkAccentTealDark}" />
											<Label
												Style="{StaticResource InfoPillTextStyle}"
												Text="{Binding SelectedDoctorForAppointment.FullName}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</HorizontalStackLayout>
									</Border>
								</Grid>

								<!--  Активен циклус  -->
								<Grid
									ColumnDefinitions="130,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding SelectedTherapyCycle}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Циклус:" />
									<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
										<HorizontalStackLayout Spacing="8">
											<Label
												Style="{StaticResource InfoPillIconStyle}"
												Text="&#xf0da;"
												TextColor="{StaticResource SparkAccentTealDark}" />
											<Label
												Style="{StaticResource InfoPillTextStyle}"
												Text="{Binding SelectedTherapyCycle.Notes}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</HorizontalStackLayout>
									</Border>
								</Grid>

								<ActivityIndicator
									Margin="0,12"
									HorizontalOptions="Center"
									IsRunning="{Binding IsPatientLoading}"
									IsVisible="{Binding IsPatientLoading}"
									Color="{StaticResource SparkAccentTeal}" />

							</VerticalStackLayout>
						</ScrollView>
					</Border>

				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
