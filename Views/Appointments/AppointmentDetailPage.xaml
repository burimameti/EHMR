	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,*,Auto">

		<!--  ===================== HEADER =====================  -->
		<Border
			Grid.Row="0"
			BackgroundColor="{StaticResource SparkBackground}"
			Stroke="{StaticResource SparkBorder}"
			StrokeThickness="1">

			<Grid
				Padding="24,18"
				ColumnDefinitions="Auto,*,Auto"
				ColumnSpacing="18">

				<!--  Avatar  -->
				<Border
					BackgroundColor="{StaticResource SparkAccentTeal}"
					HeightRequest="48"
					StrokeShape="RoundRectangle 24"
					StrokeThickness="0"
					VerticalOptions="Center"
					WidthRequest="48">

					<Label
						FontAttributes="Bold"
						FontSize="17"
						HorizontalOptions="Center"
						Text="{Binding SelectedPatientForAppointment.FullName, Converter={StaticResource AppointmentsInitialsConverter}}"
						TextColor="White"
						VerticalOptions="Center" />

				</Border>

				<!--  Title  -->
				<VerticalStackLayout
					Grid.Column="1"
					Spacing="2"
					VerticalOptions="Center">

					<Label
						FontAttributes="Bold"
						FontSize="18"
						Text="{Binding HeaderTitle}"
						TextColor="{StaticResource SparkTextPrimary}" />

					<Label
						FontSize="12"
						Text="{Binding HeaderSubtitle}"
						TextColor="{StaticResource SparkTextSecondary}" />

				</VerticalStackLayout>

				<!--  Status  -->
				<Border
					Grid.Column="2"
					Padding="10,5"
					BackgroundColor="{Binding Appointment.Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
					StrokeShape="RoundRectangle 5"
					StrokeThickness="0"
					VerticalOptions="Center">

					<Label
						FontAttributes="Bold"
						FontSize="11"
						HorizontalOptions="Center"
						Text="{Binding Appointment.Status}"
						TextColor="White"
						VerticalOptions="Center" />

				</Border>

			</Grid>

		</Border>

		<!--  ===================== BODY =====================  -->
		<ScrollView Grid.Row="1" Padding="24,20">
			<VerticalStackLayout Spacing="16">


				<Border Style="{StaticResource SparkCardStyle}">

					<VerticalStackLayout Spacing="18">

						<Label Style="{StaticResource SparkPagerLabelStyle}" Text="Пациент и лекар" />

						<Grid
							ColumnDefinitions="*,*"
							ColumnSpacing="20"
							RowDefinitions="Auto,Auto">

							<!--  ================= PATIENT =================  -->

							<VerticalStackLayout Grid.Column="0" Spacing="6">

								<Label
									FontSize="11"
									Text="Пациент"
									TextColor="{StaticResource SparkTextSecondary}" />

								<!--  READ ONLY  -->

								<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">

									<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding SelectedPatientForAppointment.FullName}" />

								</Border>

								<!--  EDIT  -->

								<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource SparkPickerFrameStyle}">

									<Picker
										BackgroundColor="Transparent"
										IsEnabled="{Binding IsNewAppointment}"
										ItemDisplayBinding="{Binding FullName}"
										ItemsSource="{Binding PatientsList}"
										SelectedIndexChanged="OnPatientSelectedIndexChanged"
										SelectedItem="{Binding SelectedPatientForAppointment}"
										Style="{StaticResource SparkPickerStyle}" />

								</Border>

							</VerticalStackLayout>

							<!--  ================= DOCTOR =================  -->

							<VerticalStackLayout Grid.Column="1" Spacing="6">

								<Label
									FontSize="11"
									Text="Лекар"
									TextColor="{StaticResource SparkTextSecondary}" />

								<!--  READ  -->

								<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">

									<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding SelectedDoctorForAppointment.FullName}" />

								</Border>

								<!--  EDIT  -->

								<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource SparkPickerFrameStyle}">

									<Picker
										BackgroundColor="Transparent"
										ItemDisplayBinding="{Binding FullName}"
										ItemsSource="{Binding DoctorsList}"
										SelectedItem="{Binding SelectedDoctorForAppointment}"
										Style="{StaticResource SparkPickerStyle}" />

								</Border>

							</VerticalStackLayout>

						</Grid>

					</VerticalStackLayout>

				</Border>



				<Border Style="{StaticResource SparkCardStyle}">

					<VerticalStackLayout Spacing="18">

						<Label Style="{StaticResource SectionHeaderStyle}" Text="Термин" />

						<!--  =======================  -->
						<!--  DATE / START / END  -->
						<!--  =======================  -->

						<Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">

							<!--  DATE  -->

							<VerticalStackLayout Spacing="6">

								<Label
									FontSize="11"
									Text="Датум"
									TextColor="{StaticResource SparkTextSecondary}" />

								<!--  READ  -->

								<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">

									<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding Appointment.ScheduledStart, StringFormat='{0:dd.MM.yyyy}'}" />

								</Border>

								<!--  EDIT  -->

								<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource SparkPickerFrameStyle}">

									<DatePicker
										BackgroundColor="Transparent"
										Date="{Binding Appointment.ScheduledStart}"
										TextColor="{StaticResource SparkTextPrimary}" />

								</Border>

							</VerticalStackLayout>

							<!--  START  -->

							<VerticalStackLayout Grid.Column="1" Spacing="6">

								<Label
									FontSize="11"
									Text="Почеток"
									TextColor="{StaticResource SparkTextSecondary}" />

								<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">

									<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding Appointment.ScheduledStart, StringFormat='{0:HH:mm}'}" />

								</Border>

								<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource SparkPickerFrameStyle}">

									<TimePicker
										BackgroundColor="Transparent"
										TextColor="{StaticResource SparkTextPrimary}"
										Time="{Binding SelectedStartTime}" />

								</Border>

							</VerticalStackLayout>

							<!--  END  -->

							<VerticalStackLayout Grid.Column="2" Spacing="6">

								<Label
									FontSize="11"
									Text="Крај"
									TextColor="{StaticResource SparkTextSecondary}" />

								<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">

									<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding Appointment.ScheduledEnd, StringFormat='{0:HH:mm}'}" />

								</Border>

								<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource SparkPickerFrameStyle}">

									<TimePicker
										BackgroundColor="Transparent"
										TextColor="{StaticResource SparkTextPrimary}"
										Time="{Binding SelectedEndTime}" />

								</Border>

							</VerticalStackLayout>

						</Grid>

						<!--  =======================  -->
						<!--  STATUS  -->
						<!--  =======================  -->

						<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="6">

							<Label
								FontSize="11"
								Text="Статус"
								TextColor="{StaticResource SparkTextSecondary}" />

							<Border Style="{StaticResource SparkPickerFrameStyle}">

								<Picker
									BackgroundColor="Transparent"
									ItemsSource="{Binding StatusOptions}"
									Style="{StaticResource SparkPickerStyle}">

									<Picker.SelectedItem>
										<Binding Converter="{StaticResource AppointmentStatusConverter}" Path="Appointment.Status" />
									</Picker.SelectedItem>

								</Picker>

							</Border>

						</VerticalStackLayout>

						<!--  =======================  -->
						<!--  REASON  -->
						<!--  =======================  -->

						<VerticalStackLayout Spacing="6">

							<Label
								FontSize="11"
								Text="Причина за посета"
								TextColor="{StaticResource SparkTextSecondary}" />

							<!--  READ  -->

							<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">

								<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding Appointment.ReasonForVisit}" />

							</Border>

							<!--  EDIT  -->

							<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource SparkPickerFrameStyle}">

								<Entry
									BackgroundColor="Transparent"
									Placeholder="Внесете причина за посета..."
									PlaceholderColor="{StaticResource SparkTextSecondary}"
									Text="{Binding Appointment.ReasonForVisit}"
									TextColor="{StaticResource SparkTextPrimary}" />

							</Border>

						</VerticalStackLayout>

					</VerticalStackLayout>

				</Border>

				<Frame Style="{StaticResource SparkCardStyle}">
					<VerticalStackLayout>
						<Label Style="{StaticResource SectionHeaderStyle}" Text="Клинички белешки" />

						<Frame IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">
							<Label
								FontSize="14"
								Text="{Binding Appointment.ClinicalNotes}"
								TextColor="{StaticResource SparkTextPrimary}" />
						</Frame>

						<Editor
							HeightRequest="120"
							IsVisible="{Binding IsEditMode}"
							Placeholder="Внесете клинички белешки..."
							Style="{StaticResource EditEditorStyle}"
							Text="{Binding Appointment.ClinicalNotes}" />
					</VerticalStackLayout>
				</Frame>


				<Frame Style="{StaticResource SparkCardStyle}">
					<VerticalStackLayout>
						<Label Style="{StaticResource SectionHeaderStyle}" Text="Дијагнози (МКБ10)" />

						<!--  Search box + dropdown, edit mode only  -->
						<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="4">
							<Entry
								Placeholder="Пребарувај МКБ10 шифра или назив..."
								Style="{StaticResource EditEntryStyle}"
								Text="{Binding DiagnosisSearchText, Mode=TwoWay}"
								TextChanged="OnDiagnosisSearchTextChanged" />

							<Frame
								Padding="0"
								BackgroundColor="{StaticResource SparkBackground}"
								BorderColor="{StaticResource SparkBorder}"
								CornerRadius="8"
								HasShadow="True"
								IsVisible="{Binding ShowDiagnosisDropdown}"
								MaximumHeightRequest="220">
								<CollectionView ItemsSource="{Binding AvailableDiagnoses}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="entities:Mkb10Code">
											<Grid Padding="12,10" ColumnDefinitions="Auto,*">
												<Grid.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentDetailViewModel}}, Path=AddDiagnosisCommand}" CommandParameter="{Binding .}" />
												</Grid.GestureRecognizers>
												<Label
													Grid.Column="0"
													Margin="0,0,10,0"
													FontAttributes="Bold"
													Text="{Binding Code}"
													TextColor="{StaticResource SparkAccentTeal}" />
												<Label
													Grid.Column="1"
													LineBreakMode="TailTruncation"
													Text="{Binding Description}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Grid>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</Frame>
						</VerticalStackLayout>

						<!--  Selected diagnoses chips  -->
						<FlexLayout
							Margin="0,12,0,0"
							JustifyContent="Start"
							Wrap="Wrap">
							<BindableLayout.ItemsSource>
								<Binding Path="SelectedDiagnoses" />
							</BindableLayout.ItemsSource>
							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="entities:AppointmentDiagnosis">
									<Frame
										Margin="0,0,8,8"
										Padding="10,6"
										BackgroundColor="{StaticResource SparkBackground}"
										BorderColor="{StaticResource SparkBorder}"
										CornerRadius="14"
										HasShadow="False">
										<HorizontalStackLayout Spacing="6">
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding Mkb10Code.Code}"
												TextColor="{StaticResource SparkAccentTeal}"
												VerticalOptions="Center" />
											<Label
												FontSize="12"
												Text="{Binding Mkb10Code.Description}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												FontFamily="FontAwesomeSolid"
												FontSize="10"
												IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IsEditMode}"
												Text="&#xf00d;"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center">
												<Label.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentDetailViewModel}}, Path=RemoveDiagnosisCommand}" CommandParameter="{Binding .}" />
												</Label.GestureRecognizers>
											</Label>
										</HorizontalStackLayout>
									</Frame>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</FlexLayout>

						<Label
							FontSize="13"
							IsVisible="{Binding SelectedDiagnoses.Count, Converter={StaticResource InvertedBoolConverter}}"
							Text="Нема доделени дијагнози."
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>
				</Frame>


				<Frame Style="{StaticResource SparkCardStyle}">
					<VerticalStackLayout>
						<Grid ColumnDefinitions="*,Auto">
							<Label
								Grid.Column="0"
								Style="{StaticResource SectionHeaderStyle}"
								Text="Терапевтски циклус" />
							<Button
								Grid.Column="1"
								Padding="12,6"
								BackgroundColor="{StaticResource SparkAccentTeal}"
								Command="{Binding GenerateNextCycleCommand}"
								CornerRadius="8"
								FontSize="12"
								IsVisible="{Binding IsReadOnly}"
								Text="Генерирај нареден циклус"
								TextColor="White" />
						</Grid>

						<Frame IsVisible="{Binding IsReadOnly}" Style="{StaticResource DisplayBlockStyle}">
							<VerticalStackLayout Spacing="2">
								<Label Style="{StaticResource DisplayLabelCaptionStyle}" Text="Активен циклус" />
								<Label Style="{StaticResource DisplayLabelValueStyle}" Text="{Binding SelectedTherapyCycle.Notes}" />
							</VerticalStackLayout>
						</Frame>

						<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="4">
							<Label
								FontSize="12"
								Text="Терапевтски циклус"
								TextColor="{StaticResource SparkTextSecondary}" />
							<Picker
								ItemDisplayBinding="{Binding Name}"
								ItemsSource="{Binding VisibleTherapies}"
								SelectedItem="{Binding SelectedTherapyCycle}"
								Style="{StaticResource EditPickerStyle}" />
						</VerticalStackLayout>
					</VerticalStackLayout>
				</Frame>


				<Frame IsVisible="{Binding IsNewAppointment, Converter={StaticResource AppointmentInvertedBoolConverter}}" Style="{StaticResource SparkCardStyle}">
					<VerticalStackLayout>
						<Label Style="{StaticResource SectionHeaderStyle}" Text="Историја на термини" />

						<CollectionView ItemsSource="{Binding AppointmentHistory}" MaximumHeightRequest="260">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="entities:Appointment">
									<Grid
										Padding="0,10"
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="12">
										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AppointmentDetailViewModel}}, Path=SelectAppointmentCommand}" CommandParameter="{Binding .}" />
										</Grid.GestureRecognizers>

										<BoxView
											Grid.Column="0"
											CornerRadius="2"
											HeightRequest="36"
											WidthRequest="4"
											Color="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}" />

										<VerticalStackLayout Grid.Column="1" Spacing="1">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
												TextColor="{StaticResource SparkTextPrimary}" />
											<Label
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding ReasonForVisit}"
												TextColor="{StaticResource SparkTextSecondary}" />
										</VerticalStackLayout>

										<Label
											Grid.Column="2"
											FontSize="11"
											Text="{Binding Status}"
											TextColor="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
											VerticalOptions="Center" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>

						<Label
							FontSize="13"
							IsVisible="{Binding AppointmentHistory.Count, Converter={StaticResource AppointmentInvertedBoolConverter}}"
							Text="Нема претходни термини."
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>
				</Frame>

				<Frame Style="{StaticResource SparkCardStyle}">
					<VerticalStackLayout>
						<Label Style="{StaticResource SectionHeaderStyle}" Text="Историја на дијагнози" />

						<CollectionView ItemsSource="{Binding PatientDiagnosisHistory}" MaximumHeightRequest="200">
							<CollectionView.ItemTemplate>
								<DataTemplate>
									<Grid
										Padding="0,8"
										ColumnDefinitions="Auto,*,Auto"
										ColumnSpacing="10">
										<Label
											Grid.Column="0"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding Mkb10Code}"
											TextColor="{StaticResource SparkAccentTeal}" />
										<Label
											Grid.Column="1"
											FontSize="12"
											Text="{Binding Description}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Column="2"
											FontSize="11"
											Text="{Binding DiagnosedOn, StringFormat='{0:dd.MM.yyyy}'}"
											TextColor="{StaticResource SparkTextSecondary}" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</VerticalStackLayout>
				</Frame>

			</VerticalStackLayout>
		</ScrollView>

		<Frame
			Grid.Row="2"
			Padding="24,14"
			BackgroundColor="{StaticResource SparkBackground}"
			CornerRadius="0"
			HasShadow="False">
			<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">

				<Button
					Grid.Column="1"
					BackgroundColor="Transparent"
					BorderColor="{StaticResource SparkAccentTeal}"
					BorderWidth="1"
					Command="{Binding NewAppointmentForPatientCommand}"
					CommandParameter="{Binding SelectedPatientForAppointment}"
					CornerRadius="8"
					IsVisible="{Binding IsReadOnly}"
					Text="Нов термин за пациентот"
					TextColor="{StaticResource SparkAccentTeal}" />

				<Button
					Grid.Column="2"
					BackgroundColor="{StaticResource SparkAccentTeal}"
					Command="{Binding ToggleEditModeCommand}"
					CornerRadius="8"
					IsEnabled="{Binding CanUpdateAppointments}"
					IsVisible="{Binding IsReadOnly}"
					Text="Уреди"
					TextColor="White" />

				<Button
					Grid.Column="2"
					BackgroundColor="Transparent"
					BorderColor="{StaticResource SparkBorder}"
					BorderWidth="1"
					Command="{Binding CancelCommand}"
					CornerRadius="8"
					IsVisible="{Binding IsEditMode}"
					Text="Откажи"
					TextColor="{StaticResource SparkTextSecondary}" />

				<Button
					Grid.Column="3"
					BackgroundColor="{StaticResource SparkAccentTeal}"
					Command="{Binding SaveCommand}"
					CornerRadius="8"
					IsEnabled="{Binding CanCreateAppointments}"
					IsVisible="{Binding IsEditMode}"
					Text="Зачувај"
					TextColor="White" />
			</Grid>
		</Frame>
	</Grid>
</ContentPage>
