<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Appointments.AppointmentDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Appointments"
	x:Name="PageRoot"
	BackgroundColor="#F1F5F9">



	<Grid ColumnDefinitions="295,*">

		<Border
			Grid.Column="0"
			BackgroundColor="#0F172A"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>


		<Grid
			Grid.Column="1"
			BackgroundColor="#FFFFFF"
			RowDefinitions="68,*">


			<!--  HEADER  -->

			<Border
				Grid.Row="0"
				Padding="24,0"
				BackgroundColor="White"
				StrokeThickness="0">


				<Grid ColumnDefinitions="Auto,*,Auto">


					<HorizontalStackLayout Spacing="14" VerticalOptions="Center">


						<Border
							BackgroundColor="#015ED7"
							HeightRequest="34"
							StrokeShape="RoundRectangle 10"
							StrokeThickness="0"
							WidthRequest="34">


							<Label
								FontFamily="FASolid"
								FontSize="12"
								HorizontalOptions="Center"
								Text="&#xf053;"
								TextColor="White"
								VerticalOptions="Center" />

						</Border>



						<VerticalStackLayout Spacing="3">


							<Label
								FontAttributes="Bold"
								FontSize="16"
								Text="{Binding PageTitle}"
								TextColor="#0F172A" />



							<HorizontalStackLayout Spacing="5">


								<Label
									FontSize="12"
									Text="Термини"
									TextColor="#94A3B8" />


								<Label
									FontSize="12"
									Text="›"
									TextColor="#CBD5E1" />


								<Label
									FontSize="12"
									Text="{Binding SelectedPatientForAppointment.FullName}"
									TextColor="#64748B" />


							</HorizontalStackLayout>


						</VerticalStackLayout>


					</HorizontalStackLayout>




					<Border
						Grid.Column="1"
						Padding="12,5"
						BackgroundColor="#EFF6FF"
						HorizontalOptions="Center"
						Stroke="#BFDBFE"
						StrokeShape="RoundRectangle 8"
						StrokeThickness="1"
						VerticalOptions="Center">


						<HorizontalStackLayout Spacing="7">


							<Ellipse
								Fill="#2563EB"
								HeightRequest="7"
								WidthRequest="7" />


							<Label
								FontAttributes="Bold"
								FontSize="12"
								Text="{Binding Appointment.Status}"
								TextColor="#1D4ED8" />


						</HorizontalStackLayout>


					</Border>




					<HorizontalStackLayout Grid.Column="2" Spacing="8">


						<Button
							Command="{Binding ToggleEditModeCommand}"
							IsVisible="{Binding IsReadOnly}"
							Style="{StaticResource SecondaryButton}"
							Text="Уреди" />


						<Button
							Command="{Binding SaveCommand}"
							IsVisible="{Binding IsEditMode}"
							Style="{StaticResource PrimaryButton}"
							Text="Зачувај" />


						<Button
							Command="{Binding CancelCommand}"
							IsVisible="{Binding IsEditMode}"
							Style="{StaticResource DangerButtonStyle}"
							Text="Откажи" />


					</HorizontalStackLayout>


				</Grid>


			</Border>





			<!--  BODY  -->


			<ScrollView Grid.Row="1">


				<Grid
					Padding="24"
					ColumnDefinitions="2*,*"
					ColumnSpacing="20">



					<!--  LEFT  -->


					<VerticalStackLayout Grid.Column="0" Spacing="16">





						<!--  PATIENT DOCTOR  -->


						<Border
							Padding="16"
							BackgroundColor="White"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 14"
							StrokeThickness="1">


							<VerticalStackLayout Spacing="14">



								<HorizontalStackLayout Spacing="8">


									<Label
										FontFamily="FASolid"
										FontSize="13"
										Text="&#xf0c0;"
										TextColor="#2563EB" />


									<Label
										CharacterSpacing="1.2"
										FontAttributes="Bold"
										FontSize="12"
										Text="ОСНОВНИ ПОДАТОЦИ"
										TextColor="#64748B" />


								</HorizontalStackLayout>



								<BoxView HeightRequest="1" Color="#EEF2F7" />




								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">



									<!--  PATIENT  -->


									<VerticalStackLayout Spacing="6">


										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="ПАЦИЕНТ"
											TextColor="#94A3B8" />


										<Border
											Padding="12"
											BackgroundColor="#F8FAFC"
											Stroke="#E2E8F0"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1">


											<Grid ColumnDefinitions="42,*" ColumnSpacing="12">


												<Border
													BackgroundColor="#EFF6FF"
													HeightRequest="42"
													StrokeShape="RoundRectangle 21"
													StrokeThickness="0"
													WidthRequest="42">


													<Label
														FontFamily="FASolid"
														FontSize="14"
														HorizontalOptions="Center"
														Text="&#xf007;"
														TextColor="#2563EB"
														VerticalOptions="Center" />


												</Border>



												<VerticalStackLayout Grid.Column="1">


													<Label
														FontAttributes="Bold"
														FontSize="14"
														Text="{Binding SelectedPatientForAppointment.FullName}"
														TextColor="#0F172A" />


													<Label
														FontSize="12"
														Text="Пациент"
														TextColor="#94A3B8" />


												</VerticalStackLayout>


											</Grid>


										</Border>


									</VerticalStackLayout>





									<!--  DOCTOR  -->


									<VerticalStackLayout Grid.Column="1" Spacing="6">


										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="ЛЕКАР"
											TextColor="#94A3B8" />


										<Border
											Padding="12"
											BackgroundColor="#F8FAFC"
											Stroke="#E2E8F0"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1">


											<Grid ColumnDefinitions="42,*" ColumnSpacing="12">


												<Border
													BackgroundColor="#EFF6FF"
													HeightRequest="42"
													StrokeShape="RoundRectangle 21"
													StrokeThickness="0"
													WidthRequest="42">


													<Label
														FontFamily="FASolid"
														FontSize="14"
														HorizontalOptions="Center"
														Text="&#xf0f0;"
														TextColor="#2563EB"
														VerticalOptions="Center" />


												</Border>




												<VerticalStackLayout Grid.Column="1">


													<Label
														FontAttributes="Bold"
														FontSize="14"
														Text="{Binding SelectedDoctorForAppointment.FullName}"
														TextColor="#0F172A" />


													<Label
														FontSize="12"
														Text="Лекар"
														TextColor="#94A3B8" />


												</VerticalStackLayout>


											</Grid>


										</Border>


									</VerticalStackLayout>


								</Grid>


							</VerticalStackLayout>


						</Border>





						<Border
							Padding="16"
							BackgroundColor="#FFFFFF"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 14"
							StrokeThickness="1">

							<VerticalStackLayout Spacing="14">


								<!--  HEADER  -->
								<Grid ColumnDefinitions="Auto,*,Auto">

									<HorizontalStackLayout Spacing="8">

										<Label
											FontFamily="FASolid"
											FontSize="13"
											Text="&#xf0ae;"
											TextColor="#2563EB" />

										<Label
											CharacterSpacing="1.2"
											FontAttributes="Bold"
											FontSize="12"
											Text="ДИЈАГНОЗИ"
											TextColor="#64748B" />

									</HorizontalStackLayout>


									<Border
										Grid.Column="2"
										Padding="8,3"
										BackgroundColor="#EFF6FF"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="0">

										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="{Binding SelectedDiagnoses.Count}"
											TextColor="#2563EB" />

									</Border>

								</Grid>



								<BoxView HeightRequest="1" Color="#EEF2F7" />



								<!--  SEARCH  -->

								<Border
									Padding="10"
									BackgroundColor="#F8FAFC"
									IsVisible="{Binding IsEditMode}"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="1">


									<Grid ColumnDefinitions="Auto,*">


										<Label
											FontFamily="FASolid"
											FontSize="12"
											Text="&#xf002;"
											TextColor="#94A3B8" />


										<Entry
											Grid.Column="1"
											Margin="8,0,0,0"
											BackgroundColor="Transparent"
											Placeholder="Пребарај дијагноза..."
											PlaceholderColor="#94A3B8"
											Text="{Binding DiagnosisSearchText}"
											TextChanged="OnDiagnosisSearchTextChanged"
											TextColor="#0F172A" />

									</Grid>

								</Border>




								<!--  SEARCH RESULTS  -->

								<Border
									BackgroundColor="White"
									IsVisible="{Binding ShowDiagnosisDropdown}"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="1">


									<CollectionView HeightRequest="220" ItemsSource="{Binding AvailableDiagnoses}">


										<CollectionView.ItemTemplate>

											<DataTemplate x:DataType="models:Mkb10Code">


												<Grid
													Padding="10"
													ColumnDefinitions="60,*"
													ColumnSpacing="10">


													<Border
														Padding="6"
														BackgroundColor="#EFF6FF"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0">


														<Label
															FontAttributes="Bold"
															FontSize="11"
															Text="{Binding Code}"
															TextColor="#2563EB" />

													</Border>



													<Label
														Grid.Column="1"
														FontSize="13"
														Text="{Binding Description}"
														TextColor="#334155" />


													<Grid.GestureRecognizers>

														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddDiagnosisCommand}" CommandParameter="{Binding}" />

													</Grid.GestureRecognizers>


												</Grid>


											</DataTemplate>

										</CollectionView.ItemTemplate>


									</CollectionView>


								</Border>





								<!--  SELECTED DIAGNOSES  -->

								<CollectionView IsVisible="{Binding IsReadOnly}" ItemsSource="{Binding SelectedDiagnoses}">


									<CollectionView.ItemTemplate>

										<DataTemplate x:DataType="models:AppointmentDiagnosis">


											<Grid Padding="6" ColumnDefinitions="70,*">


												<Border
													Padding="6"
													BackgroundColor="#EFF6FF"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0">


													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="{Binding Mkb10Code.Code}"
														TextColor="#1D4ED8" />

												</Border>



												<Label
													Grid.Column="1"
													FontSize="13"
													Text="{Binding Mkb10Code.Description}"
													TextColor="#334155" />


											</Grid>


										</DataTemplate>


									</CollectionView.ItemTemplate>


								</CollectionView>



							</VerticalStackLayout>


						</Border>


						<!--  ===================== NOTES =====================  -->


						<Border
							Padding="16"
							BackgroundColor="#FFFFFF"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 14"
							StrokeThickness="1">


							<VerticalStackLayout Spacing="12">


								<HorizontalStackLayout Spacing="8">

									<Label
										FontFamily="FASolid"
										FontSize="13"
										Text="&#xf249;"
										TextColor="#2563EB" />


									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="ЗАБЕЛЕШКА"
										TextColor="#64748B" />

								</HorizontalStackLayout>



								<BoxView HeightRequest="1" Color="#EEF2F7" />



								<!--<Border
									Padding="10"
									BackgroundColor="#F8FAFC"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 10">


									<Editor
										AutoSize="TextChanges"
										BackgroundColor="Transparent"
										HeightRequest="100"
										Placeholder="Внесете забелешка..."
										Text="{Binding Appointment.}"
										TextColor="#0F172A" />


								</Border>-->



							</VerticalStackLayout>


						</Border>



					</VerticalStackLayout>

				</Grid>
				<!--  2*,* body grid  -->


			</ScrollView>


		</Grid>
		<!--  main content  -->


	</Grid>
	<!--  page columns  -->


</ContentPage>