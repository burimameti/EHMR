<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Appointments.AppointmentDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Appointments"
	x:Name="PageRoot"
	x:DataType="vm:AppointmentDetailViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<Grid ColumnDefinitions="285,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Padding="24"
			RowDefinitions="Auto,*"
			RowSpacing="6">

			<!--  ================= HEADER =================  -->
			<Border
				Padding="20,16"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf073;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="{Binding HeaderTitle}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="{Binding HeaderSubtitle}"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">

						<Border
							Padding="12,6"
							BackgroundColor="{Binding Appointment.Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
							StrokeShape="RoundRectangle 14"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="11"
								HorizontalOptions="Center"
								Text="{Binding Appointment.Status}"
								TextColor="White"
								VerticalOptions="Center" />
						</Border>

						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding NewAppointmentForPatientCommand}"
							CommandParameter="{Binding SelectedPatientForAppointment}"
							ContentPadding="18,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsReadOnly}"
							Text="+ Нов термин за пациентот" />

						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding ToggleEditModeCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsEnabled="{Binding CanUpdateAppointments}"
							IsVisible="{Binding IsReadOnly}"
							Text="✎ Уреди" />

						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи" />

						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsEnabled="{Binding CanCreateAppointments}"
							IsVisible="{Binding IsEditMode}"
							Text="💾 Зачувај термин" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  ================= BODY =================  -->
			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Padding="10" Spacing="6">

						<!--  =====================================================  -->
						<!--  ПАЦИЕНТ И ЛЕКАР  -->
						<!--  =====================================================  -->
						<VerticalStackLayout Spacing="14">
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ПАЦИЕНТ И ЛЕКАР"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<!--  READ MODE — контекстни boxes, исто како Encounter  -->
							<Grid
								ColumnDefinitions="*,*"
								ColumnSpacing="20"
								IsVisible="{Binding IsReadOnly}">

								<Border
									Grid.Column="0"
									Padding="16,12"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="0">
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
										<Border
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											HeightRequest="38"
											StrokeShape="RoundRectangle 19"
											StrokeThickness="0"
											WidthRequest="38">
											<Label
												FontFamily="FASolid"
												FontSize="14"
												HorizontalOptions="Center"
												Text="&#xf007;"
												TextColor="{StaticResource SparkAccentTealDark}"
												VerticalOptions="Center" />
										</Border>
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="1"
											VerticalOptions="Center">
											<Label
												FontSize="11"
												Text="Пациент"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="17"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedPatientForAppointment.FullName}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Grid>
								</Border>

								<Border
									Grid.Column="1"
									Padding="16,12"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="0">
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
										<Border
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											HeightRequest="38"
											StrokeShape="RoundRectangle 19"
											StrokeThickness="0"
											WidthRequest="38">
											<Label
												FontFamily="FASolid"
												FontSize="14"
												HorizontalOptions="Center"
												Text="&#xf0f0;"
												TextColor="{StaticResource SparkAccentTealDark}"
												VerticalOptions="Center" />
										</Border>
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="1"
											VerticalOptions="Center">
											<Label
												FontSize="11"
												Text="Лекар"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="17"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedDoctorForAppointment.FullName}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</Grid>

							<!--  EDIT MODE — вистински pickers  -->
							<Grid
								ColumnDefinitions="*,*"
								ColumnSpacing="24"
								IsVisible="{Binding IsEditMode}">
								<controls:FFPicker
									Grid.Column="0"
									IsEnabled="{Binding IsNewAppointment}"
									ItemsSource="{Binding PatientsList}"
									Label="Пациент"
									Placeholder="Изберете пациент *"
									SelectedItem="{Binding SelectedPatientForAppointment}" />

								<controls:FFPicker
									Grid.Column="1"
									ItemsSource="{Binding DoctorsList}"
									Label="Лекар"
									Placeholder="Изберете лекар *"
									SelectedItem="{Binding SelectedDoctorForAppointment}" />
							</Grid>
						</VerticalStackLayout>

						<!--  =====================================================  -->
						<!--  ТЕРМИН — датум / почеток / крај / статус  -->
						<!--  =====================================================  -->
						<VerticalStackLayout Spacing="14">
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ТЕРМИН"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="24">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Датум"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkAccentTealBg}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<Border.Shadow>
											<Shadow
												Brush="Black"
												Opacity="0.06"
												Radius="6"
												Offset="0,2" />
										</Border.Shadow>
										<DatePicker
											BackgroundColor="Transparent"
											Date="{Binding Appointment.ScheduledStart}"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="1"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Почеток"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkAccentTealBg}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<Border.Shadow>
											<Shadow
												Brush="Black"
												Opacity="0.06"
												Radius="6"
												Offset="0,2" />
										</Border.Shadow>
										<TimePicker
											BackgroundColor="Transparent"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											TextColor="{StaticResource SparkTextPrimary}"
											Time="{Binding SelectedStartTime}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="2"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Крај"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkAccentTealBg}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<Border.Shadow>
											<Shadow
												Brush="Black"
												Opacity="0.06"
												Radius="6"
												Offset="0,2" />
										</Border.Shadow>
										<TimePicker
											BackgroundColor="Transparent"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											TextColor="{StaticResource SparkTextPrimary}"
											Time="{Binding SelectedEndTime}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>

							<Grid
								ColumnDefinitions="*,*"
								ColumnSpacing="24"
								IsVisible="{Binding IsEditMode}">
								<controls:FFPicker
									Grid.Column="0"
									ItemsSource="{Binding StatusOptions}"
									Label="Статус"
									Placeholder="Изберете статус">
									<controls:FFPicker.SelectedItem>
										<Binding Converter="{StaticResource AppointmentStatusConverter}" Path="Appointment.Status" />
									</controls:FFPicker.SelectedItem>
								</controls:FFPicker>
							</Grid>
						</VerticalStackLayout>

						<!--  =====================================================  -->
						<!--  ДЕТАЛИ — причина за посета / клинички белешки  -->
						<!--  =====================================================  -->
						<VerticalStackLayout Spacing="14">
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ДЕТАЛИ ЗА ТЕРМИНОТ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Причина за посета *"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkAccentTealBg}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<Border.Shadow>
											<Shadow
												Brush="Black"
												Opacity="0.06"
												Radius="6"
												Offset="0,2" />
										</Border.Shadow>
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											Placeholder="Пр. Редовна контрола, Главоболка"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Appointment.ReasonForVisit}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="1"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Клинички белешки"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="12,8"
										BackgroundColor="{StaticResource SparkBackground}"
										Stroke="{StaticResource SparkAccentTealBg}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<Border.Shadow>
											<Shadow
												Brush="Black"
												Opacity="0.06"
												Radius="6"
												Offset="0,2" />
										</Border.Shadow>
										<Editor
											AutoSize="TextChanges"
											BackgroundColor="Transparent"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											Placeholder="Внесете клинички белешки..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Appointment.ClinicalNotes}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
								</Grid>
							</Grid>
						</VerticalStackLayout>

						<!--  =====================================================  -->
						<!--  МКБ-10 ДИЈАГНОЗИ  -->
						<!--  =====================================================  -->
						<VerticalStackLayout Spacing="14">
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="МКБ-10 ДИЈАГНОЗИ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

								<VerticalStackLayout
									Grid.Column="0"
									IsVisible="{Binding IsEditMode}"
									Spacing="12">
									<controls:FFSearchBox Placeholder="Внесете шифра или назив на МКБ 10 (Пр. I10)..." Text="{Binding DiagnosisSearchText, Mode=TwoWay}" />

									<CollectionView
										HeightRequest="180"
										IsVisible="{Binding ShowDiagnosisDropdown}"
										ItemsSource="{Binding AvailableDiagnoses}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:Mkb10Code">
												<Border
													Margin="0,4"
													Padding="12"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													StrokeShape="RoundRectangle 10"
													StrokeThickness="0">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddDiagnosisCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<VerticalStackLayout Spacing="2">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Code}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															FontSize="12"
															Text="{Binding Description}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>

								<VerticalStackLayout Grid.Column="1" Spacing="14">
									<FlexLayout
										BindableLayout.ItemsSource="{Binding SelectedDiagnoses}"
										Direction="Row"
										JustifyContent="Start"
										Wrap="Wrap">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:AppointmentDiagnosis">
												<Border
													Margin="4"
													Padding="10,6"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													Stroke="{StaticResource SparkAccentTeal}"
													StrokeShape="RoundRectangle 12">
													<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Mkb10Code.Code}"
															TextColor="{StaticResource SparkAccentTealDark}"
															VerticalOptions="Center" />
														<Label
															FontSize="12"
															Text="{Binding Mkb10Code.Description}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />
														<Button
															Padding="0"
															BackgroundColor="Transparent"
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDiagnosisCommand}"
															CommandParameter="{Binding .}"
															CornerRadius="9"
															FontSize="10"
															HeightRequest="18"
															IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
															Text="✕"
															TextColor="{StaticResource SparkAccentTealDark}"
															WidthRequest="18" />
													</HorizontalStackLayout>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</FlexLayout>

									<Label
										FontSize="13"
										IsVisible="{Binding SelectedDiagnoses.Count, Converter={StaticResource InvertedBoolConverter}}"
										Text="Нема доделени дијагнози."
										TextColor="{StaticResource SparkTextSecondary}" />
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>

						<!--  =====================================================  -->
						<!--  ТЕРАПЕВТСКИ ЦИКЛУС  -->
						<!--  =====================================================  -->
						<VerticalStackLayout Spacing="14">
							<Grid ColumnDefinitions="*,Auto">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ТЕРАПЕВТСКИ ЦИКЛУС"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<controls:FFButton
									Grid.Column="1"
									ButtonKind="Secondary"
									Command="{Binding GenerateNextCycleCommand}"
									ContentPadding="14,0"
									HeightRequestEx="34"
									IsVisible="{Binding IsReadOnly}"
									Text="Генерирај нареден циклус" />
							</Grid>

							<Border
								Padding="16,12"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding IsReadOnly}"
								StrokeShape="RoundRectangle 10"
								StrokeThickness="0">
								<VerticalStackLayout Spacing="2">
									<Label
										FontSize="11"
										Text="Активен циклус"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="15"
										Text="{Binding SelectedTherapyCycle.Notes}"
										TextColor="{StaticResource SparkTextPrimary}" />
								</VerticalStackLayout>
							</Border>

							<controls:FFPicker
								IsVisible="{Binding IsEditMode}"
								ItemsSource="{Binding VisibleTherapies}"
								Label="Терапевтски циклус"
								Placeholder="Изберете циклус"
								SelectedItem="{Binding SelectedTherapyCycle}" />
						</VerticalStackLayout>

						<!--  =====================================================  -->
						<!--  ИСТОРИЈА НА ТЕРМИНИ  -->
						<!--  =====================================================  -->
						<VerticalStackLayout IsVisible="{Binding IsNewAppointment, Converter={StaticResource AppointmentInvertedBoolConverter}}" Spacing="14">
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ИСТОРИЈА НА ТЕРМИНИ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<CollectionView ItemsSource="{Binding AppointmentHistory}" MaximumHeightRequest="260">
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="entities:Appointment">
										<Border
											Margin="0,4"
											Padding="12"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectAppointmentCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
												<BoxView
													Grid.Column="0"
													CornerRadius="2"
													HeightRequest="32"
													WidthRequest="4"
													Color="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}" />
												<VerticalStackLayout Grid.Column="1" Spacing="1">
													<Label
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
														TextColor="{StaticResource SparkAccentTealDark}" />
													<Label
														FontSize="12"
														LineBreakMode="TailTruncation"
														Text="{Binding ReasonForVisit}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<Label
													Grid.Column="2"
													FontSize="11"
													Text="{Binding Status}"
													TextColor="{Binding Status, Converter={StaticResource AppointmentStatusToColorConverter}}"
													VerticalOptions="Center" />
											</Grid>
										</Border>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>

							<Label
								FontSize="13"
								IsVisible="{Binding AppointmentHistory.Count, Converter={StaticResource AppointmentInvertedBoolConverter}}"
								Text="Нема претходни термини."
								TextColor="{StaticResource SparkTextSecondary}" />
						</VerticalStackLayout>

						<!--  =====================================================  -->
						<!--  ИСТОРИЈА НА ДИЈАГНОЗИ  -->
						<!--  =====================================================  -->
						<VerticalStackLayout Spacing="14">
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ИСТОРИЈА НА ДИЈАГНОЗИ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<CollectionView ItemsSource="{Binding PatientDiagnosisHistory}" MaximumHeightRequest="200">
								<CollectionView.ItemTemplate>
									<DataTemplate>
										<Grid
											Padding="4,8"
											ColumnDefinitions="Auto,*,Auto"
											ColumnSpacing="10">
											<Label
												Grid.Column="0"
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding Mkb10Code}"
												TextColor="{StaticResource SparkAccentTealDark}" />
											<Label
												Grid.Column="1"
												FontSize="12"
												Text="{Binding Description}"
												TextColor="{StaticResource SparkTextPrimary}" />
											<Label
												Grid.Column="2"
												FontSize="11"
												Text="{Binding DiagnosedOn, StringFormat='{0:dd.MM.yyyy}'}"
												TextColor="{StaticResource SparkTextSecondary}" />
										</Grid>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>
						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>
	</Grid>
</ContentPage>