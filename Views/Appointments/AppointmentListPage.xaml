<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.AppointmentListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Appointments"
	x:Name="PageRoot"
	x:DataType="viewModels:AppointmentListViewModel"
	BackgroundColor="{StaticResource Gray200}">

	<Grid ColumnDefinitions="285,*">

		<!--  ================= LEFT MENU =================  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ================= MAIN =================  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,*"
			RowSpacing="16">

			<!--  HEADER  -->
			<Border
				Grid.Row="0"
				Padding="20"
				StrokeShape="RoundRectangle 0"
				Style="{StaticResource SurfaceCard}">
				<Grid ColumnDefinitions="*,Auto">

					<controls:FFPageHeader Title="Регистар на термини" Subtitle="Преглед и управување со закажани термини" />

					<HorizontalStackLayout
						Grid.Column="1"
						Spacing="10"
						VerticalOptions="Center">

						<Button
							BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
							Command="{Binding NewAppointmentCommand}"
							HeightRequest="45"
							IsVisible="{Binding CanCreate}"
							Style="{StaticResource TabButtonActiveStyle}"
							Text="Нов Термин"
							WidthRequest="150" />

						<Button
							Command="{Binding RefreshCommand}"
							HeightRequest="44"
							Style="{StaticResource EhmrIconButton}"
							WidthRequest="44" />

					</HorizontalStackLayout>

				</Grid>
			</Border>

			<!--  SEARCH / FILTER / GRID  -->
			<Border Grid.Row="1" Padding="0">
				<Grid ColumnSpacing="5" RowSpacing="20">
					<VerticalStackLayout>

						<Border Margin="0,8,0,8" Padding="0">
							<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пациент или доктор..."
								SearchText="{Binding SearchText}"
								Tabs="{Binding Tabs}" />
						</Border>

						<!--  History drill-down banner  -->
						<Border
							Margin="0,0,0,8"
							Padding="12,8"
							BackgroundColor="{StaticResource MedicalBlue}"
							IsVisible="{Binding IsViewingPersonHistory}"
							StrokeShape="RoundRectangle 8"
							StrokeThickness="0">
							<Label
								FontAttributes="Bold"
								FontSize="13"
								Text="{Binding ActiveHistoryLabel, StringFormat='Целосна историја за: {0}'}"
								TextColor="White" />
						</Border>

						<Border>
							<controls:SparkDataGridView
								x:Name="AppointmentGrid"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								ShowPagination="True"
								ShowRowNumbers="True"
								TotalPages="{Binding TotalPages}" />
						</Border>

					</VerticalStackLayout>
				</Grid>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
