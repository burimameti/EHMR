<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.AppointmentListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    xmlns:entities="clr-namespace:EHMR.Domain.Entities"
    xmlns:search="clr-namespace:EHMR.Domain.Search"
    xmlns:converters="clr-namespace:EHMR.Converters"
    xmlns:behaviors="clr-namespace:EHMR.Behaviors"
    xmlns:components="clr-namespace:EHMR.Components"
    x:DataType="viewModels:AppointmentListViewModel"
    x:Name="PageRoot"
    Style="{StaticResource PageBackgroundStyle}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:SuggestionSelectionStrokeConverter x:Key="SuggestionSelectionStrokeConverter" />
			<converters:HighlightMatchConverter         x:Key="HighlightMatchConverter" />
			<converters:SearchEntityTypeToIconConverter x:Key="SearchEntityTypeToIconConverter" />
			<converters:SearchEntityTypeToLabelConverter x:Key="SearchEntityTypeToLabelConverter" />

			<!-- ── Status pill palette ── -->
			<!-- Scheduled  → indigo -->
			<Color x:Key="PillScheduledBg">#EEF2FF</Color>
			<Color x:Key="PillScheduledFg">#6366F1</Color>
			<Color x:Key="PillScheduledDot">#6366F1</Color>
			<!-- Completed  → emerald -->
			<Color x:Key="PillCompletedBg">#DCFCE7</Color>
			<Color x:Key="PillCompletedFg">#16A34A</Color>
			<Color x:Key="PillCompletedDot">#22C55E</Color>
			<!-- Cancelled  → rose -->
			<Color x:Key="PillCancelledBg">#FEE2E2</Color>
			<Color x:Key="PillCancelledFg">#DC2626</Color>
			<Color x:Key="PillCancelledDot">#EF4444</Color>
			<!-- In Progress → amber -->
			<Color x:Key="PillInProgressBg">#FEF3C7</Color>
			<Color x:Key="PillInProgressFg">#B45309</Color>
			<Color x:Key="PillInProgressDot">#F59E0B</Color>

			<!-- Avatar accent pool (deterministic by first letter) -->
			<Color x:Key="AvatarA">#6366F1</Color>
			<Color x:Key="AvatarB">#3B82F6</Color>
			<Color x:Key="AvatarC">#22C55E</Color>
			<Color x:Key="AvatarD">#F59E0B</Color>
			<Color x:Key="AvatarE">#EF4444</Color>
			<Color x:Key="AvatarF">#8B5CF6</Color>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="295,*">

		<!-- ═══════════════════════════════════════════ -->
		<!-- СТРАНИЧНО МЕНИ                              -->
		<!-- ═══════════════════════════════════════════ -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!-- ═══════════════════════════════════════════ -->
		<!-- ГЛАВЕН ПАНЕЛ                                -->
		<!-- ═══════════════════════════════════════════ -->
		<Grid Grid.Column="1" RowDefinitions="72,*">

			<!-- ── TOP BAR ── -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderContainer}">
				<Grid ColumnDefinitions="*,Auto">
					<VerticalStackLayout Spacing="2" VerticalOptions="Center">
						<Label Text="Прегледи" Style="{StaticResource PageHeaderTitle}" />
						<Label Text="Закажување, следење и менаџирање на термините во клиниката"
                               Style="{StaticResource PageHeaderSubtitle}" />
					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
						<!-- Active appointments badge -->
						<Border BackgroundColor="{StaticResource EpicPrimaryLight}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,6"
                                VerticalOptions="Center">
							<HorizontalStackLayout Spacing="6">
								<BoxView WidthRequest="7" HeightRequest="7"
                                         CornerRadius="4"
                                         Color="{StaticResource EpicPrimary}"
                                         VerticalOptions="Center" />
								<Label FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource EpicPrimary}"
                                       VerticalOptions="Center">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding TotalItems}" />
											<Span Text=" термини" />
										</FormattedString>
									</Label.FormattedText>
								</Label>
							</HorizontalStackLayout>
						</Border>

						<Border Padding="12,8" BackgroundColor="{StaticResource SurfaceAlt}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<HorizontalStackLayout Spacing="8">
								<Label Text="&#xf007;" FontFamily="FASolid" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
								<Label Text="{Binding UserName}" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Border>
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!-- ── CONTENT AREA ── -->
			<Grid Grid.Row="1" Padding="24" RowDefinitions="Auto,14,*">

				<!-- ────────────────────────────────── -->
				<!-- TOOLBAR                            -->
				<!-- ────────────────────────────────── -->
				<Border Grid.Row="0" Style="{StaticResource ToolbarContainer}">
					<Grid ColumnDefinitions="*,160,160,200,Auto,Auto"
                          ColumnSpacing="12" VerticalOptions="Center">

						<!-- Search -->
						<VerticalStackLayout Spacing="5">
							<Label Text="ПРЕБАРУВАЊЕ" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}">
								<Grid ColumnDefinitions="Auto,*">
									<Label Text="&#xf002;" FontFamily="FASolid" FontSize="14"
                                           Margin="4,0,8,0" TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />
									<Entry x:Name="SearchEntry"
                                           Grid.Column="1"
                                           Style="{StaticResource InputEntry}"
                                           Placeholder="Пребарај пациент или доктор..."
                                           PlaceholderColor="{StaticResource TextMuted}"
                                           Text="{Binding SearchText, Mode=TwoWay}"
                                           ReturnCommand="{Binding CommitSearchCommand}"
                                           VerticalOptions="Center">
										<Entry.Behaviors>
											<behaviors:SearchSuggestionKeyboardBehavior />
										</Entry.Behaviors>
									</Entry>
								</Grid>
							</Border>
						</VerticalStackLayout>

						<!-- Filter by date toggle -->
						<VerticalStackLayout Grid.Column="1" Spacing="5">
							<Label Text="ДАТУМ ФИЛТЕР" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}" StrokeThickness="0">
								<HorizontalStackLayout Spacing="8" Padding="10,0" VerticalOptions="Center">
									<CheckBox IsChecked="{Binding FilterByDate}"
                                              Color="{StaticResource Primary}" Scale="0.9"
                                              VerticalOptions="Center" />
									<Label Text="Активно" VerticalOptions="Center"
                                           TextColor="{StaticResource TextPrimary}" FontSize="12" />
								</HorizontalStackLayout>
							</Border>
						</VerticalStackLayout>

						<!-- Date picker -->
						<VerticalStackLayout Grid.Column="2" Spacing="5">
							<Label Text="ДАТУМ" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}"
                                    IsEnabled="{Binding FilterByDate}">
								<DatePicker Date="{Binding FilterDate}"
                                            Format="dd.MM.yyyy"
                                            FontSize="13"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource TextPrimary}" />
							</Border>
						</VerticalStackLayout>

						<!-- Status picker -->
						<VerticalStackLayout Grid.Column="3" Spacing="5">
							<Label Text="СТАТУС" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}">
								<Picker Style="{StaticResource InputPicker}"
                                        VerticalOptions="Center"
                                        ItemsSource="{Binding StatusFilters}"
                                        SelectedItem="{Binding SelectedStatus}" />
							</Border>
						</VerticalStackLayout>

						<!-- Clear -->
						<VerticalStackLayout Grid.Column="4" VerticalOptions="End">
							<Button Text="✕ Исчисти" Padding="14,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFiltersCommand}" />
						</VerticalStackLayout>

						<!-- New appointment -->
						<VerticalStackLayout Grid.Column="5" VerticalOptions="End">
							<Button Text="+ Нов Преглед"
                                    HeightRequest="40" CornerRadius="10"
                                    BackgroundColor="{StaticResource EpicPrimary}"
                                    TextColor="White" FontAttributes="Bold"
                                    Command="{Binding NewAppointmentCommand}" />
						</VerticalStackLayout>
					</Grid>
				</Border>

				<!-- ── Autocomplete dropdown overlay ── -->
				<Border Grid.Row="0" Grid.RowSpan="3"
                        IsVisible="{Binding ShowSuggestions}"
                        ZIndex="999"
                        HorizontalOptions="Start" VerticalOptions="Start"
                        WidthRequest="320"
                        Margin="0,88,0,0"
                        Style="{StaticResource ModalCard}"
                        Padding="6">
					<CollectionView ItemsSource="{Binding Suggestions}"
                                    SelectionMode="None"
                                    MaximumHeightRequest="320">
						<CollectionView.EmptyView>
							<Label Text="Нема резултати."
                                   Style="{StaticResource MutedText}" Margin="16" />
						</CollectionView.EmptyView>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="search:SearchSuggestionDto">
								<Border StrokeThickness="2"
                                        StrokeShape="RoundRectangle 8"
                                        Padding="12,10"
                                        BackgroundColor="Transparent">
									<VisualStateManager.VisualStateGroups>
										<VisualStateGroup Name="CommonStates">
											<VisualState Name="Normal" />
											<VisualState Name="PointerOver">
												<VisualState.Setters>
													<Setter Property="BackgroundColor"
                                                            Value="{StaticResource SurfaceAlt}" />
												</VisualState.Setters>
											</VisualState>
										</VisualStateGroup>
									</VisualStateManager.VisualStateGroups>
									<Border.GestureRecognizers>
										<TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:AppointmentListViewModel}}, Path=SelectSuggestionCommand}"
                                            CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<Border.Stroke>
										<MultiBinding Converter="{StaticResource SuggestionSelectionStrokeConverter}"
                                                      ConverterParameter="{StaticResource Primary}">
											<Binding Path="." />
											<Binding Source="{RelativeSource AncestorType={x:Type viewModels:AppointmentListViewModel}}"
                                                     Path="SelectedSuggestion" />
										</MultiBinding>
									</Border.Stroke>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
										<Border Grid.Column="0"
                                                WidthRequest="28" HeightRequest="28"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                VerticalOptions="Center">
											<Label Text="{Binding Type, Converter={StaticResource SearchEntityTypeToIconConverter}}"
                                                   FontFamily="FASolid" FontSize="11"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
										</Border>
										<VerticalStackLayout Grid.Column="1" Spacing="1">
											<Label FontSize="13" TextColor="{StaticResource TextPrimary}">
												<Label.FormattedText>
													<MultiBinding Converter="{StaticResource HighlightMatchConverter}">
														<Binding Path="DisplayText" />
														<Binding Source="{RelativeSource AncestorType={x:Type viewModels:AppointmentListViewModel}}"
                                                                 Path="SearchText" />
													</MultiBinding>
												</Label.FormattedText>
											</Label>
											<Label Text="{Binding Type, Converter={StaticResource SearchEntityTypeToLabelConverter}}"
                                                   Style="{StaticResource MutedText}" FontSize="10" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Border>

				<!-- ────────────────────────────────── -->
				<!-- MAIN GRID CARD                     -->
				<!-- ────────────────────────────────── -->
				<Border Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0">
					<Grid RowDefinitions="Auto,50,*,64">

						<!-- History banner -->
						<Border Grid.Row="0"
                                IsVisible="{Binding IsViewingPersonHistory}"
                                BackgroundColor="{StaticResource EpicPrimaryLight}"
                                StrokeThickness="0">
							<Grid Padding="20,10" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
								<Label Grid.Column="0" Text="&#xf1da;" FontFamily="FASolid"
                                       FontSize="13" TextColor="{StaticResource EpicPrimary}"
                                       VerticalOptions="Center" />
								<Label Grid.Column="1" VerticalOptions="Center"
                                       FontSize="13" TextColor="{StaticResource EpicPrimary}">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="Историја за: " />
											<Span Text="{Binding ActiveHistoryLabel}" FontAttributes="Bold" />
										</FormattedString>
									</Label.FormattedText>
								</Label>
								<Button Grid.Column="2"
                                        Text="✕ Назад кон сите термини"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        FontSize="11" Padding="10,4"
                                        Command="{Binding ClearFiltersCommand}" />
							</Grid>
						</Border>

						<!-- ── GRID HEADER ── -->
						<Border Grid.Row="1"
                                BackgroundColor="#0F172A"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0">
							<Grid Padding="20,0"
                                  ColumnDefinitions="36,2.2*,1.8*,1.2*,1.2*,1.4*,180"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">
								<!-- Checkbox placeholder -->
								<CheckBox Grid.Column="0"
                                          Color="#6366F1"
                                          VerticalOptions="Center"
                                          HorizontalOptions="Center"
                                          Scale="0.85" />

								<Label Grid.Column="1" Text="ПАЦИЕНТ"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="Center" />
								<Label Grid.Column="2" Text="ЛЕКАР"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="Center" />
								<Label Grid.Column="3" Text="ПОЧЕТОК"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="Center" />
								<Label Grid.Column="4" Text="КРАЈ"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="Center" />
								<Label Grid.Column="5" Text="СТАТУС"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8"
                                       VerticalOptions="Center" />
								<Label Grid.Column="6" Text="АКЦИИ"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="#94A3B8"
                                       CharacterSpacing="0.8"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />
							</Grid>
						</Border>

						<!-- ── DATA ROWS ── -->
						<CollectionView Grid.Row="2"
                                        ItemsSource="{Binding Items}"
                                        SelectionMode="None">

							<CollectionView.EmptyView>
								<VerticalStackLayout Spacing="14"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Padding="0,60">
									<Border WidthRequest="64" HeightRequest="64"
                                            BackgroundColor="{StaticResource EpicSurface2}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            HorizontalOptions="Center">
										<Label Text="&#xf274;" FontFamily="FASolid"
                                               FontSize="26"
                                               TextColor="{StaticResource EpicMuted}"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
									</Border>
									<Label Text="Не се пронајдени термини"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource EpicText}"
                                           HorizontalOptions="Center" />
									<Label Text="Обидете се со различни филтери или додајте нов термин."
                                           FontSize="13"
                                           TextColor="{StaticResource EpicMuted}"
                                           HorizontalOptions="Center"
                                           HorizontalTextAlignment="Center" />
								</VerticalStackLayout>
							</CollectionView.EmptyView>

							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="entities:Appointment">

									<!-- Row wrapper with hover VSM -->
									<Border BackgroundColor="{StaticResource EpicSurface}"
                                            Stroke="{StaticResource EpicDivider}"
                                            StrokeThickness="0"
                                            Padding="0">

										<VisualStateManager.VisualStateGroups>
											<VisualStateGroup Name="CommonStates">
												<VisualState Name="Normal">
													<VisualState.Setters>
														<Setter Property="BackgroundColor"
                                                                Value="{StaticResource EpicSurface}" />
													</VisualState.Setters>
												</VisualState>
												<VisualState Name="PointerOver">
													<VisualState.Setters>
														<Setter Property="BackgroundColor"
                                                                Value="{StaticResource EpicPrimaryLight}" />
													</VisualState.Setters>
												</VisualState>
											</VisualStateGroup>
										</VisualStateManager.VisualStateGroups>

										<Grid>
											<!-- Bottom divider line -->
											<BoxView HeightRequest="1"
                                                     Color="{StaticResource EpicDivider}"
                                                     VerticalOptions="End"
                                                     Margin="20,0" />

											<Grid Padding="20,14"
                                                  ColumnDefinitions="36,2.2*,1.8*,1.2*,1.2*,1.4*,180"
                                                  ColumnSpacing="12"
                                                  VerticalOptions="Center">

												<!-- Checkbox -->
												<CheckBox Grid.Column="0"
                                                          Color="{StaticResource EpicPrimary}"
                                                          VerticalOptions="Center"
                                                          HorizontalOptions="Center"
                                                          Scale="0.85" />

												<!-- ── ПАЦИЕНТ: initials avatar + name + EMBR ID ── -->
												<HorizontalStackLayout Grid.Column="1"
                                                                        Spacing="12"
                                                                        VerticalOptions="Center">
													<!-- Initials circle (color driven by first letter via converter) -->
													<Border WidthRequest="36" HeightRequest="36"
                                                            BackgroundColor="{StaticResource EpicPrimaryLight}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 10">
														<Label FontSize="12" FontAttributes="Bold"
                                                               TextColor="{StaticResource EpicPrimary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center">
															<Label.FormattedText>
																<FormattedString>
																	<!-- First initials letter pair -->
																	<Span Text="{Binding Patient.FirstName,
                                                                                StringFormat='{}{0:0}'}" />
																	<!-- NOTE: swap to an InitialsConverter
                                                                         that grabs [0] of each name -->
																</FormattedString>
															</Label.FormattedText>
														</Label>
													</Border>

													<VerticalStackLayout Spacing="1" VerticalOptions="Center">
														<Label FontSize="13" FontAttributes="Bold"
                                                               TextColor="{StaticResource EpicText}"
                                                               LineBreakMode="TailTruncation">
															<Label.FormattedText>
																<FormattedString>
																	<Span Text="{Binding Patient.FirstName}" />
																	<Span Text=" " />
																	<Span Text="{Binding Patient.LastName}" />
																</FormattedString>
															</Label.FormattedText>
														</Label>
														<Label FontSize="11"
                                                               TextColor="{StaticResource EpicMuted}"
                                                               LineBreakMode="TailTruncation">
															<Label.FormattedText>
																<FormattedString>
																	<Span Text="EMBR · " />
																	<Span Text="{Binding Patient.Embg}" />
																</FormattedString>
															</Label.FormattedText>
														</Label>
													</VerticalStackLayout>
												</HorizontalStackLayout>

												<!-- ── ЛЕКАР: initials avatar + dr. name + specialty ── -->
												<HorizontalStackLayout Grid.Column="2"
                                                                        Spacing="10"
                                                                        VerticalOptions="Center">
													<Border WidthRequest="32" HeightRequest="32"
                                                            BackgroundColor="{StaticResource EpicInfoBackground}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8">
														<Label FontSize="11" FontAttributes="Bold"
                                                               TextColor="{StaticResource EpicInfo}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center">
															<Label.FormattedText>
																<FormattedString>
																	<Span Text="{Binding Doctor.FirstName,
                                                                                StringFormat='{}{0:0}'}" />
																</FormattedString>
															</Label.FormattedText>
														</Label>
													</Border>
													<VerticalStackLayout Spacing="1" VerticalOptions="Center">
														<Label FontSize="13"
                                                               TextColor="{StaticResource EpicBodyColor}"
                                                               LineBreakMode="TailTruncation">
															<Label.FormattedText>
																<FormattedString>
																	<Span Text="д-р " TextColor="{StaticResource EpicMuted}" />
																	<Span Text="{Binding Doctor.FirstName}" FontAttributes="Bold" />
																	<Span Text=" " />
																	<Span Text="{Binding Doctor.LastName}" FontAttributes="Bold" />
																</FormattedString>
															</Label.FormattedText>
														</Label>
														<Label Text="Ревматологија"
                                                               FontSize="11"
                                                               TextColor="{StaticResource EpicMuted}" />
													</VerticalStackLayout>
												</HorizontalStackLayout>

												<!-- ── ПОЧЕТОК ── -->
												<VerticalStackLayout Grid.Column="3"
                                                                      Spacing="1"
                                                                      VerticalOptions="Center">
													<Label Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy}'}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{StaticResource EpicText}" />
													<HorizontalStackLayout Spacing="4">
														<Label Text="&#xf017;" FontFamily="FASolid"
                                                               FontSize="10"
                                                               TextColor="{StaticResource EpicMuted}"
                                                               VerticalOptions="Center" />
														<Label Text="{Binding ScheduledStart, StringFormat='{0:HH:mm}'}"
                                                               FontSize="11"
                                                               TextColor="{StaticResource EpicMuted}" />
													</HorizontalStackLayout>
												</VerticalStackLayout>

												<!-- ── КРАЈ ── -->
												<VerticalStackLayout Grid.Column="4"
                                                                      Spacing="1"
                                                                      VerticalOptions="Center">
													<Label Text="{Binding ScheduledEnd, StringFormat='{0:HH:mm}'}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{StaticResource EpicText}" />
													<Label Text="часот"
                                                           FontSize="11"
                                                           TextColor="{StaticResource EpicMuted}" />
												</VerticalStackLayout>

												<!-- ── СТАТУС pill ──
                                                     NOTE: swap BackgroundColor/TextColor/dot Color via
                                                     a StatusToPillConverter that maps the Status string
                                                     to the correct resource key. Hard-coded to Scheduled
                                                     palette here as a starting point. -->
												<Border Grid.Column="5"
                                                        BackgroundColor="{StaticResource PillScheduledBg}"
                                                        StrokeThickness="1"
                                                        Stroke="{StaticResource PillScheduledFg}"
                                                        StrokeShape="RoundRectangle 20"
                                                        Padding="10,5"
                                                        HorizontalOptions="Start"
                                                        VerticalOptions="Center">
													<HorizontalStackLayout Spacing="6">
														<BoxView WidthRequest="6" HeightRequest="6"
                                                                 CornerRadius="3"
                                                                 Color="{StaticResource PillScheduledDot}"
                                                                 VerticalOptions="Center" />
														<Label Text="{Binding Status}"
                                                               FontSize="11" FontAttributes="Bold"
                                                               TextColor="{StaticResource PillScheduledFg}"
                                                               VerticalOptions="Center" />
													</HorizontalStackLayout>
												</Border>

												<!-- ── АКЦИИ ── -->
												<HorizontalStackLayout Grid.Column="6"
                                                                        Spacing="6"
                                                                        HorizontalOptions="Center"
                                                                        VerticalOptions="Center">

													<!-- View button -->
													<Border BackgroundColor="{StaticResource EpicPrimaryLight}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="0">
														<Button Text="&#xf06e;  Преглед"
                                                                FontFamily="FASolid"
                                                                FontSize="11"
                                                                HeightRequest="32"
                                                                Padding="10,0"
                                                                BackgroundColor="Transparent"
                                                                TextColor="{StaticResource EpicPrimary}"
                                                                FontAttributes="Bold"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:AppointmentListViewModel}},
                                                                          Path=SelectCommand}"
                                                                CommandParameter="{Binding .}" />
													</Border>

													<!-- Cancel button -->
													<Border BackgroundColor="{StaticResource EpicDangerBackground}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="0">
														<Button Text="&#xf05e;"
                                                                FontFamily="FASolid"
                                                                FontSize="12"
                                                                WidthRequest="32"
                                                                HeightRequest="32"
                                                                BackgroundColor="Transparent"
                                                                TextColor="{StaticResource EpicDanger}"
                                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:AppointmentListViewModel}},
                                                                          Path=CancelCommand}"
                                                                CommandParameter="{Binding .}" />
													</Border>
												</HorizontalStackLayout>
											</Grid>
										</Grid>
									</Border>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>

						<!-- ────────────────────────────────── -->
						<!-- PAGINATION FOOTER                  -->
						<!-- ────────────────────────────────── -->
						<Border Grid.Row="3"
                                BackgroundColor="{StaticResource EpicSurface2}"
                                Stroke="{StaticResource EpicDivider}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 0">
							<Grid Padding="20,0" HeightRequest="64"
                                  ColumnDefinitions="Auto,*,Auto"
                                  VerticalOptions="Center">

								<!-- Left: row count summary -->
								<HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
									<Border BackgroundColor="{StaticResource EpicPrimaryLight}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Padding="8,4">
										<Label FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource EpicPrimary}">
											<Label.FormattedText>
												<FormattedString>
													<Span Text="{Binding Items.Count}" />
													<Span Text=" / " TextColor="{StaticResource EpicMuted}" />
													<Span Text="{Binding TotalItems}" />
												</FormattedString>
											</Label.FormattedText>
										</Label>
									</Border>
									<Label Text="евидентирани прегледи"
                                           FontSize="12"
                                           TextColor="{StaticResource EpicMuted}"
                                           VerticalOptions="Center" />
								</HorizontalStackLayout>

								<!-- Center: page indicator dots (visual) -->
								<HorizontalStackLayout Grid.Column="1"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center"
                                                        Spacing="5">
									<Border WidthRequest="28" HeightRequest="28"
                                            BackgroundColor="{StaticResource EpicPrimary}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6">
										<Label Text="{Binding CurrentPage, FallbackValue=1}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
									</Border>
									<Label Text="од" FontSize="12"
                                           TextColor="{StaticResource EpicMuted}"
                                           VerticalOptions="Center" />
									<Label Text="{Binding TotalPages, FallbackValue=1}"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource EpicText}"
                                           VerticalOptions="Center" />
									<Label Text="страни" FontSize="12"
                                           TextColor="{StaticResource EpicMuted}"
                                           VerticalOptions="Center" />
								</HorizontalStackLayout>

								<!-- Right: prev / next -->
								<HorizontalStackLayout Grid.Column="2"
                                                        Spacing="8"
                                                        VerticalOptions="Center">
									<Border StrokeThickness="1"
                                            Stroke="{StaticResource EpicBorder}"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{StaticResource EpicSurface}"
                                            Padding="0">
										<Button Text="&#xf104;  Претходна"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="14,0"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource EpicBodyColor}"
                                                Command="{Binding PreviousPageCommand}" />
									</Border>

									<Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            BackgroundColor="{StaticResource EpicPrimary}"
                                            Padding="0">
										<Button Text="Следна  &#xf105;"
                                                FontFamily="FASolid"
                                                FontSize="12"
                                                HeightRequest="36"
                                                Padding="14,0"
                                                BackgroundColor="Transparent"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                Command="{Binding NextPageCommand}" />
									</Border>
								</HorizontalStackLayout>
							</Grid>
						</Border>

					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
