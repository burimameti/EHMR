<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Calendar.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Calendar"
	x:Name="CurrentPage"
	x:DataType="vm:CalendarDashboardViewModel"
	BackgroundColor="#FAFAFA">
	<ContentPage.Resources>
		<!--
			Картичка за преглед во неделниот грид.
			Како во дизајнот: „10:00-10:30 Име" во еден ред, услугата под него.
		-->
		<DataTemplate x:Key="CalendarEventCardTemplate" x:DataType="vm:CalendarEventDto">
			<Border
				Padding="6,4"
				BackgroundColor="{Binding BackgroundColor}"
				StrokeShape="RoundRectangle 6"
				StrokeThickness="0">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding BindingContext.ProcessEncounterSelectionCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding Id}" />
				</Border.GestureRecognizers>
				<VerticalStackLayout Spacing="1">
					<Label
						FontSize="10"
						LineBreakMode="TailTruncation"
						MaxLines="1"
						Text="{Binding CardTitle}"
						TextColor="{Binding TextColor}" />
					<Label
						FontSize="9"
						LineBreakMode="TailTruncation"
						MaxLines="1"
						Opacity="0.7"
						Text="{Binding DoctorName}"
						TextColor="{Binding TextColor}" />
				</VerticalStackLayout>
			</Border>
		</DataTemplate>

		<!--  Larger card for the single-day layout, which has one wide column to fill.  -->
		<DataTemplate x:Key="CalendarEventDayCardTemplate" x:DataType="vm:CalendarEventDto">
			<Border
				Padding="12,8"
				BackgroundColor="{Binding BackgroundColor}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="0">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding BindingContext.ProcessEncounterSelectionCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding Id}" />
				</Border.GestureRecognizers>
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding ScheduledTime, StringFormat='{0:HH:mm}'}"
						TextColor="{Binding TextColor}"
						VerticalOptions="Center" />
					<VerticalStackLayout Grid.Column="1" Spacing="1">
						<Label
							FontAttributes="Bold"
							FontSize="13"
							LineBreakMode="TailTruncation"
							MaxLines="1"
							Text="{Binding PatientName}"
							TextColor="{Binding TextColor}" />
						<Label
							FontSize="11"
							LineBreakMode="TailTruncation"
							MaxLines="1"
							Opacity="0.85"
							Text="{Binding DoctorName}"
							TextColor="{Binding TextColor}" />
					</VerticalStackLayout>
					<Label
						Grid.Column="2"
						FontSize="10"
						Text="{Binding Status}"
						TextColor="{Binding TextColor}"
						VerticalOptions="Center" />
				</Grid>
			</Border>
		</DataTemplate>

		<!--  Compact chip for a day cell in the month grid.  -->
		<DataTemplate x:Key="CalendarEventMonthChipTemplate" x:DataType="vm:CalendarEventDto">
			<Border
				Padding="4,1"
				BackgroundColor="{Binding BackgroundColor}"
				StrokeShape="RoundRectangle 4"
				StrokeThickness="0">
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding BindingContext.ProcessEncounterSelectionCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding Id}" />
				</Border.GestureRecognizers>
				<Label
					FontSize="8"
					LineBreakMode="TailTruncation"
					MaxLines="1"
					Text="{Binding PatientName}"
					TextColor="{Binding TextColor}" />
			</Border>
		</DataTemplate>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>
		<Grid
			Grid.Column="1"
            Margin="12,0,12,12"
			RowDefinitions="*"
			RowSpacing="8">
			<!--
				MAIN PAGE GRID: 2 COLUMNS (CALENDAR DASHBOARD | WAITLIST PANEL)
				
				Row must be star-sized. In an Auto row the hour grid is measured at its full
				24-row natural height, so its CollectionView never gets a viewport to scroll in
				and the bottom hours are simply cut off the page.
			-->
			<!--  Auto за десната колона за да може панелот да се собере; ширината ја диктира самиот панел.  -->
			<Grid ColumnDefinitions="*, Auto" ColumnSpacing="0">

				<!--  ==================== LEFT AREA: CALENDAR & METRICS ====================  -->
				<Grid
					Grid.Column="0"
					Padding="28,18,16,0"
					RowDefinitions="Auto, Auto, Auto, *"
					RowSpacing="14">

					<!--  1. HEADER TITLE  -->
					<Label
						Grid.Row="0"
						FontAttributes="Bold"
						FontSize="24"
						Text="{Binding PageTitle}"
						TextColor="#0F172A" />

					<!--  2. TOOLBAR CONTROLS  -->
					<!--  Auto за левата група: со 4* текстот на 22px и двете стрелки не собираа и се сечеа.  -->
					<Grid
						Grid.Row="1"
						ColumnDefinitions="Auto,*"
						ColumnSpacing="16">
						<!--  Navigation & Date Title  -->
						<HorizontalStackLayout
							Grid.Column="0"
							Spacing="10"
							VerticalOptions="Center">
							<!--  „Денес" — обичен текст како во дизајнот, без рамка.  -->
							<Grid BackgroundColor="Transparent" VerticalOptions="Center">
								<Grid.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding GoToTodayCommand}" />
								</Grid.GestureRecognizers>
								<Label
									Padding="4,6"
									FontSize="14"
									Text="Денес"
									TextColor="#0F172A"
									VerticalOptions="Center" />
							</Grid>

							<Label
								FontAttributes="Bold"
								FontSize="15"
								Text="{Binding CurrentMonthYearText}"
								TextColor="#0F172A"
								VerticalOptions="Center" />

							<!--  Мали стрелки во заедничка рамка, како во дизајнот.  -->
							<!--
								Допирот е на Grid-от со проѕирна позадина, не на самиот Label —
								инаку целта е само знакот и копчето изгледа мртво.
							-->
							<Border
								Padding="0"
								BackgroundColor="#FFFFFF"
								HeightRequest="30"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="1"
								VerticalOptions="Center">
								<Grid ColumnDefinitions="32,1,32">
									<Grid Grid.Column="0" BackgroundColor="Transparent">
										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding PreviousPeriodCommand}" />
										</Grid.GestureRecognizers>
										<Label
											FontSize="15"
											HorizontalOptions="Center"
											HorizontalTextAlignment="Center"
											Text="‹"
											TextColor="#64748B"
											VerticalOptions="Center"
											VerticalTextAlignment="Center" />
									</Grid>

									<BoxView Grid.Column="1" Color="#E2E8F0" />

									<Grid Grid.Column="2" BackgroundColor="Transparent">
										<Grid.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding NextPeriodCommand}" />
										</Grid.GestureRecognizers>
										<Label
											FontSize="15"
											HorizontalOptions="Center"
											HorizontalTextAlignment="Center"
											Text="›"
											TextColor="#64748B"
											VerticalOptions="Center"
											VerticalTextAlignment="Center" />
									</Grid>
								</Grid>
							</Border>
						</HorizontalStackLayout>

						<!--  View Switchers & Dropdowns  -->
						<HorizontalStackLayout
							Grid.Column="1"
							HorizontalOptions="End"
							Spacing="8"
							VerticalOptions="Center">

							<!--  Што прикажува календарот: прегледи или термини.  -->
							<Border
								Padding="3"
								BackgroundColor="#F1F5F9"
								StrokeShape="RoundRectangle 9"
								StrokeThickness="0"
								VerticalOptions="Center">
								<HorizontalStackLayout Spacing="2">
									<controls:CalendarViewSegment
										Command="{Binding SetContentModeCommand}"
										CommandParameter="Encounters"
										IsActive="{Binding IsEncounterContentActive}"
										Text="Прегледи" />
									<controls:CalendarViewSegment
										Command="{Binding SetContentModeCommand}"
										CommandParameter="Appointments"
										IsActive="{Binding IsAppointmentContentActive}"
										Text="Термини" />
								</HorizontalStackLayout>
							</Border>


							<!--
								Сегментирана контрола како во дизајнот: сива патека, активниот
								сегмент е бел со сенка. Нема „Staff" — немаме таков поим.
							-->
							<Border
								Padding="3"
								BackgroundColor="#F1F5F9"
								StrokeShape="RoundRectangle 9"
								StrokeThickness="0"
								VerticalOptions="Center">
								<HorizontalStackLayout Spacing="2">
									<controls:CalendarViewSegment
										Command="{Binding SetCalendarViewCommand}"
										CommandParameter="Day"
										IsActive="{Binding IsDayModeActive}"
										Text="Ден" />
									<controls:CalendarViewSegment
										Command="{Binding SetCalendarViewCommand}"
										CommandParameter="Week"
										IsActive="{Binding IsWeekModeActive}"
										Text="Недела" />
									<controls:CalendarViewSegment
										Command="{Binding SetCalendarViewCommand}"
										CommandParameter="Month"
										IsActive="{Binding IsMonthModeActive}"
										Text="Месец" />
								</HorizontalStackLayout>
							</Border>

							<!--
								Филтер по статус — на иста линија со преклопувачот.
								Натписот над него го креваше и го фрлаше надвор од линијата.
							-->
							<Border
								Padding="10,0"
								BackgroundColor="#FFFFFF"
								HeightRequest="34"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 9"
								StrokeThickness="1"
								VerticalOptions="Center">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
									<Label
										FontSize="12"
										Text="◍"
										TextColor="#94A3B8"
										VerticalOptions="Center" />
									<Picker
										Grid.Column="1"
										FontSize="12"
										HorizontalOptions="Fill"
										ItemsSource="{Binding Statuses}"
										SelectedItem="{Binding SelectedStatus}"
										TextColor="#0F172A"
										TitleColor="#94A3B8"
										VerticalOptions="Center"
										WidthRequest="128" />
								</Grid>
							</Border>

						</HorizontalStackLayout>
					</Grid>

					<!--  3. KPI КАРТИЧКИ  -->
					<Grid
						Grid.Row="2"
						ColumnDefinitions="*, *, *"
						ColumnSpacing="12"
						IsVisible="{Binding IsStatsViewActive}">

						<controls:CalendarKpiCard
							Title="{Binding ContentTotalTitle}"
							Grid.Column="0"
							Command="{Binding OpenEncountersCommand}"
							ComparisonText="{Binding KpiComparisonText}"
							DeltaText="{Binding TotalDeltaText}"
							DeltaTone="{Binding TotalDeltaTone}"
							PeriodText="{Binding KpiPeriodText}"
							Value="{Binding MonthlyEncountersCount}" />

						<controls:CalendarKpiCard
							Title="Завршени"
							Grid.Column="1"
							Command="{Binding OpenEncountersCommand}"
							CommandParameter="Completed"
							ComparisonText="{Binding KpiComparisonText}"
							DeltaText="{Binding CompletedDeltaText}"
							DeltaTone="{Binding CompletedDeltaTone}"
							PeriodText="{Binding KpiPeriodText}"
							Value="{Binding CompletedPercentageText}" />

						<controls:CalendarKpiCard
							Title="Не се јавиле"
							Grid.Column="2"
							Command="{Binding OpenEncountersCommand}"
							CommandParameter="NoShow"
							ComparisonText="{Binding KpiComparisonText}"
							DeltaText="{Binding NoShowDeltaText}"
							DeltaTone="{Binding NoShowDeltaTone}"
							PeriodText="{Binding KpiPeriodText}"
							Value="{Binding NoShowPercentageText}" />
					</Grid>

					<!--  4. WEEKLY CALENDAR GRID AREA  -->
					<Border
						Grid.Row="3"
						Grid.ColumnSpan="2"
						Padding="0"
						BackgroundColor="#FFFFFF"
						Stroke="#E2E8F0"
						StrokeShape="RoundRectangle 12"
						StrokeThickness="1">
						<Border.Shadow>
							<Shadow
								Brush="Black"
								Opacity="0.06"
								Radius="14"
								Offset="0,4" />
						</Border.Shadow>

						<!--  Border прима само едно дете, па трите приказа мора да се во заеднички контејнер.  -->
						<Grid>

							<!--
								Заглавјето и телото се во иста колона (0). Порано заглавјето одеше преку
								цела ширина, а телото беше стеснето за FFScrollBar во десната колона —
								затоа седумте колони не се совпаѓаа и линиите бегаа.
							-->
							<Grid
								ColumnDefinitions="*,Auto"
								IsVisible="{Binding IsWeekModeActive}"
								RowDefinitions="Auto, *">

								<!--  ==================== 1. ХЕДЕР ЗА ДЕНОВИ ====================  -->
								<Border
									Grid.Row="0"
									Grid.Column="0"
									Padding="0"
									BackgroundColor="#F8FAFC"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 1"
									StrokeThickness="1">
									<Grid ColumnDefinitions="64,*,*,*,*,*,*,*">

										<BoxView
											Grid.Column="0"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />
										<BoxView
											Grid.Column="1"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />
										<BoxView
											Grid.Column="2"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />
										<BoxView
											Grid.Column="3"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />
										<BoxView
											Grid.Column="4"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />
										<BoxView
											Grid.Column="5"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />
										<BoxView
											Grid.Column="6"
											HorizontalOptions="End"
											VerticalOptions="Fill"
											WidthRequest="1"
											Color="#E2E8F0" />

										<Label
											Grid.Column="0"
											FontAttributes="Bold"
											FontSize="9"
											HorizontalOptions="Center"
											Text="GMT+7"
											TextColor="#94A3B8"
											VerticalOptions="Center" />

										<!--
											Заглавјата се врзани по индекс, секое во својата колона од овој грид,
											за да се совпаднат со вертикалните линии на редовите под нив.
										-->
										<controls:CalendarDayHeader
											Grid.Column="1"
											Day="{Binding WeekDay0}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
										<controls:CalendarDayHeader
											Grid.Column="2"
											Day="{Binding WeekDay1}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
										<controls:CalendarDayHeader
											Grid.Column="3"
											Day="{Binding WeekDay2}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
										<controls:CalendarDayHeader
											Grid.Column="4"
											Day="{Binding WeekDay3}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
										<controls:CalendarDayHeader
											Grid.Column="5"
											Day="{Binding WeekDay4}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
										<controls:CalendarDayHeader
											Grid.Column="6"
											Day="{Binding WeekDay5}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
										<controls:CalendarDayHeader
											Grid.Column="7"
											Day="{Binding WeekDay6}"
											SelectCommand="{Binding SelectCalendarDayCommand}" />
									</Grid>
								</Border>

								<!--
									==================== 2. КАЛЕНДАРСКА МРЕЖА ====================
									ScrollView наместо CollectionView: само 24 реда се, па виртуелизацијата
									не носи ништо, а ScrollView дава точен ScrollY што FFScrollBar го следи.
								-->
								<ScrollView
									x:Name="WeekGridScroll"
									Grid.Row="1"
									Grid.Column="0"
									VerticalScrollBarVisibility="Never">
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding HourlyTimelineSlots}" Spacing="0">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="vm:HourlyTimelineSlotDto">
												<Grid ColumnDefinitions="64,*,*,*,*,*,*,*" MinimumHeightRequest="40">
													<BoxView
														Grid.ColumnSpan="8"
														HeightRequest="1"
														VerticalOptions="Start"
														Color="#EDF1F5" />

													<!--  Column separators, aligned with the day header above  -->
													<BoxView
														Grid.Column="0"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />
													<BoxView
														Grid.Column="1"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />
													<BoxView
														Grid.Column="2"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />
													<BoxView
														Grid.Column="3"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />
													<BoxView
														Grid.Column="4"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />
													<BoxView
														Grid.Column="5"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />
													<BoxView
														Grid.Column="6"
														HorizontalOptions="End"
														VerticalOptions="Fill"
														WidthRequest="1"
														Color="#E2E8F0" />

													<Label
														Grid.Column="0"
														Margin="0,6,10,0"
														FontAttributes="None"
														FontSize="10"
														HorizontalOptions="End"
														Text="{Binding HourDisplay}"
														TextColor="#94A3B8"
														VerticalOptions="Start" />

													<VerticalStackLayout
														Grid.Column="1"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[0]}"
														Spacing="3" />
													<VerticalStackLayout
														Grid.Column="2"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[1]}"
														Spacing="3" />
													<VerticalStackLayout
														Grid.Column="3"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[2]}"
														Spacing="3" />
													<VerticalStackLayout
														Grid.Column="4"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[3]}"
														Spacing="3" />
													<VerticalStackLayout
														Grid.Column="5"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[4]}"
														Spacing="3" />
													<VerticalStackLayout
														Grid.Column="6"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[5]}"
														Spacing="3" />
													<VerticalStackLayout
														Grid.Column="7"
														Margin="4,3,4,3"
														BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
														BindableLayout.ItemsSource="{Binding DayColumns[6]}"
														Spacing="3" />
												</Grid>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</ScrollView>

								<controls:FFScrollBar
									x:Name="WeekGridScrollBar"
									Grid.Row="1"
									Grid.Column="1"
									Margin="4" />
							</Grid>

							<!--  ==================== ДНЕВЕН ПРИКАЗ ====================  -->
							<Grid IsVisible="{Binding IsDayModeActive}" RowDefinitions="Auto, *">

								<Border
									Grid.Row="0"
									Padding="16,12"
									BackgroundColor="#F8FAFC"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 1"
									StrokeThickness="1">
									<Grid ColumnDefinitions="*,Auto">
										<Label
											FontAttributes="Bold"
											FontSize="14"
											Text="{Binding SelectedDayTitle}"
											TextColor="#0F172A"
											VerticalOptions="Center" />
										<Label
											Grid.Column="1"
											FontSize="11"
											Text="{Binding SelectedCalendarDay.EncountersCountText}"
											TextColor="#94A3B8"
											VerticalOptions="Center" />
									</Grid>
								</Border>

								<!--  ScrollView + FFScrollBar, исто како неделниот приказ, за постојано видлива лента.  -->
								<Grid Grid.Row="1" ColumnDefinitions="*,Auto">
									<ScrollView
										x:Name="DayGridScroll"
										Grid.Column="0"
										VerticalScrollBarVisibility="Never">
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding HourlyTimelineSlots}" Spacing="0">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="vm:HourlyTimelineSlotDto">
													<Grid ColumnDefinitions="64,*" MinimumHeightRequest="44">
														<BoxView
															Grid.ColumnSpan="2"
															HeightRequest="1"
															VerticalOptions="Start"
															Color="#EDF1F5" />
														<BoxView
															Grid.Column="0"
															HorizontalOptions="End"
															VerticalOptions="Fill"
															WidthRequest="1"
															Color="#E2E8F0" />
														<Label
															Grid.Column="0"
															Margin="0,6,10,0"
															FontAttributes="None"
															FontSize="10"
															HorizontalOptions="End"
															Text="{Binding HourDisplay}"
															TextColor="#94A3B8"
															VerticalOptions="Start" />
														<VerticalStackLayout
															Grid.Column="1"
															Margin="10,4,10,4"
															BindableLayout.ItemTemplate="{StaticResource CalendarEventDayCardTemplate}"
															BindableLayout.ItemsSource="{Binding DayColumns[0]}"
															Spacing="4" />
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</ScrollView>

									<controls:FFScrollBar
										x:Name="DayGridScrollBar"
										Grid.Column="1"
										Margin="4" />
								</Grid>
							</Grid>

							<!--
								==================== МЕСЕЧЕН ПРИКАЗ ====================
								Bound to CalendarDays, which the ViewModel already built on every
								load but which nothing rendered until now.
							-->
							<!--  Иста поставка како неделниот: заглавје и решетка во колона 0, лентата во колона 1.  -->
							<Grid
								ColumnDefinitions="*,Auto"
								IsVisible="{Binding IsMonthModeActive}"
								RowDefinitions="Auto, *">

								<Border
									Grid.Row="0"
									Grid.Column="0"
									Padding="0"
									BackgroundColor="#F8FAFC"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 1"
									StrokeThickness="1">
									<Grid ColumnDefinitions="*,*,*,*,*,*,*">
										<Label
											Grid.Column="0"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="ПОН"
											TextColor="#64748B" />
										<Label
											Grid.Column="1"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="ВТО"
											TextColor="#64748B" />
										<Label
											Grid.Column="2"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="СРЕ"
											TextColor="#64748B" />
										<Label
											Grid.Column="3"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="ЧЕТ"
											TextColor="#64748B" />
										<Label
											Grid.Column="4"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="ПЕТ"
											TextColor="#64748B" />
										<Label
											Grid.Column="5"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="САБ"
											TextColor="#64748B" />
										<Label
											Grid.Column="6"
											Padding="0,10"
											FontAttributes="Bold"
											FontSize="11"
											HorizontalTextAlignment="Center"
											Text="НЕД"
											TextColor="#64748B" />
									</Grid>
								</Border>

								<!--
									ScrollView + FlexLayout наместо CollectionView: FFScrollBar бара
									точен ScrollY, а CollectionView не го дава. 42 ќелии се — нема
									што да се виртуелизира. Basis 14.28% дава седум по ред.
								-->
								<ScrollView
									x:Name="MonthGridScroll"
									Grid.Row="1"
									Grid.Column="0"
									VerticalScrollBarVisibility="Never">
									<FlexLayout
										AlignContent="Start"
										BindableLayout.ItemsSource="{Binding CalendarDays}"
										Direction="Row"
										Wrap="Wrap">
										<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="vm:CalendarDayDto">
											<Border
												Margin="1"
												Padding="6"
												BackgroundColor="#FFFFFF"
												FlexLayout.Basis="14.28%"
												MinimumHeightRequest="92"
												Stroke="#E2E8F0"
												StrokeShape="RoundRectangle 6"
												StrokeThickness="1">
												<Border.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding BindingContext.SelectCalendarDayCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding .}" />
												</Border.GestureRecognizers>
												<VerticalStackLayout Spacing="3">
													<Grid ColumnDefinitions="Auto,*">
														<Border
															Padding="5,1"
															BackgroundColor="#0284C7"
															IsVisible="{Binding IsToday}"
															StrokeShape="RoundRectangle 9"
															StrokeThickness="0">
															<Label
																FontAttributes="Bold"
																FontSize="10"
																Text="{Binding DayNumber}"
																TextColor="White" />
														</Border>
														<Label
															FontAttributes="Bold"
															FontSize="11"
															IsVisible="{Binding IsToday, Converter={StaticResource InvertedBoolConverter}}"
															Text="{Binding DayNumber}"
															TextColor="#0F172A" />
														<BoxView
															Grid.Column="1"
															HeightRequest="3"
															HorizontalOptions="End"
															IsVisible="{Binding IsSelected}"
															VerticalOptions="Center"
															WidthRequest="16"
															Color="#0284C7" />
													</Grid>

													<VerticalStackLayout
														BindableLayout.ItemTemplate="{StaticResource CalendarEventMonthChipTemplate}"
														BindableLayout.ItemsSource="{Binding VisibleEvents}"
														Spacing="2" />

													<Label
														FontSize="8"
														IsVisible="{Binding HasHiddenEvents}"
														Text="{Binding HiddenEventsCount, StringFormat='+{0} уште'}"
														TextColor="#94A3B8" />
												</VerticalStackLayout>
											</Border>
										</DataTemplate>
										</BindableLayout.ItemTemplate>
									</FlexLayout>
								</ScrollView>

								<controls:FFScrollBar
									x:Name="MonthGridScrollBar"
									Grid.Row="1"
									Grid.Column="1"
									Margin="4" />
							</Grid>

						</Grid>
					</Border>

				</Grid>

				<!--  ==================== RIGHT AREA: WAITLIST PANEL ====================  -->
				<Grid Grid.Column="1" WidthRequest="{Binding WaitlistPanelWidth}">
					<BoxView
						HorizontalOptions="Start"
						VerticalOptions="Fill"
						WidthRequest="1"
						Color="#E2E8F0" />

					<!--  Собери / рашири го панелот. Ова копче досега немаше никаква команда.  -->
					<Border
						Margin="-14,12,0,0"
						BackgroundColor="#FFFFFF"
						HeightRequest="28"
						HorizontalOptions="Start"
						Stroke="#E2E8F0"
						StrokeShape="RoundRectangle 14"
						ToolTipProperties.Text="Собери / рашири ја листата на чекање"
						VerticalOptions="Start"
						WidthRequest="28"
						ZIndex="10">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding ToggleWaitlistPanelCommand}" />
						</Border.GestureRecognizers>
						<Label
							FontSize="16"
							HorizontalOptions="Center"
							Text="{Binding WaitlistToggleGlyph}"
							TextColor="#64748B"
							VerticalOptions="Center" />
					</Border>

					<Grid
						Padding="20,16,16,16"
						IsVisible="{Binding IsWaitlistExpanded}"
						RowDefinitions="Auto, Auto, Auto, *"
						RowSpacing="16">

						<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
							<VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
								<Label
									FontAttributes="Bold"
									FontSize="18"
									Text="{Binding WaitlistTitle}"
									TextColor="#0F172A" />
								<Label
									FontSize="11"
									Text="{Binding WaitlistDateText}"
									TextColor="#64748B" />
							</VerticalStackLayout>
							<!--  Истиот FFButton како на почетната страна, наместо сина боја однадвор.  -->
							<controls:FFButton
								Grid.Column="1"
								ButtonKind="Primary"
								Command="{Binding CreateNewEncounterForSelectedDayCommand}"
								ContentPadding="16,0"
								HeightRequestEx="36"
								Text="{Binding ContentNewButtonText}" />
						</Grid>

						<Grid
							Grid.Row="1"
							ColumnDefinitions="*, Auto"
							ColumnSpacing="10">
							<Border
								Grid.Column="0"
								Padding="10,2"
								BackgroundColor="#F8FAFC"
								HeightRequest="38"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 8">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
									<Label
										FontSize="12"
										Text="🔍"
										TextColor="#94A3B8"
										VerticalOptions="Center" />
									<Entry
										Grid.Column="1"
										BackgroundColor="Transparent"
										FontSize="12"
										Placeholder="Пребарај пациент или број..."
										PlaceholderColor="#94A3B8"
										ReturnCommand="{Binding ApplyCalendarSearchCommand}"
										Text="{Binding SearchText}"
										TextColor="#0F172A"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontSize="14"
										IsVisible="{Binding HasSearchText}"
										Text="✕"
										TextColor="#94A3B8"
										ToolTipProperties.Text="Исчисти пребарување"
										VerticalOptions="Center">
										<Label.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding ClearSearchCommand}" />
										</Label.GestureRecognizers>
									</Label>
								</Grid>
							</Border>
							<Border
								Grid.Column="1"
								Padding="10,0"
								BackgroundColor="#FFFFFF"
								HeightRequest="38"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 8">
								<HorizontalStackLayout Spacing="4" VerticalOptions="Center">
									<Label
										FontSize="12"
										Text="Сортирај"
										TextColor="#475569"
										VerticalOptions="Center" />
									<Label
										FontSize="12"
										Text="⌄"
										TextColor="#475569"
										VerticalOptions="Center" />
								</HorizontalStackLayout>
							</Border>
						</Grid>

						<Grid
							Grid.Row="2"
							RowDefinitions="Auto, Auto"
							RowSpacing="6">
							<HorizontalStackLayout Grid.Row="0" Spacing="16">
								<HorizontalStackLayout Spacing="6">
									<HorizontalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectWaitlistTabCommand}" CommandParameter="Pending" />
									</HorizontalStackLayout.GestureRecognizers>
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="На чекање"
										TextColor="#0F172A" />
									<Border
										Padding="6,1"
										BackgroundColor="#0F172A"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="10"
											Text="{Binding PendingCount}"
											TextColor="White" />
									</Border>
								</HorizontalStackLayout>

								<HorizontalStackLayout Spacing="6">
									<HorizontalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectWaitlistTabCommand}" CommandParameter="InProgress" />
									</HorizontalStackLayout.GestureRecognizers>
									<Label
										FontSize="13"
										Text="Во тек"
										TextColor="#64748B" />
									<Label
										FontSize="13"
										Text="{Binding InProgressCount}"
										TextColor="#94A3B8" />
								</HorizontalStackLayout>

								<HorizontalStackLayout Spacing="6">
									<HorizontalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectWaitlistTabCommand}" CommandParameter="Scheduled" />
									</HorizontalStackLayout.GestureRecognizers>
									<Label
										FontSize="13"
										Text="Закажани"
										TextColor="#64748B" />
									<Label
										FontSize="13"
										Text="{Binding ScheduledCount}"
										TextColor="#94A3B8" />
								</HorizontalStackLayout>
							</HorizontalStackLayout>

							<BoxView
								Grid.Row="1"
								HeightRequest="2"
								HorizontalOptions="Start"
								WidthRequest="85"
								Color="#0F172A" />
						</Grid>

						<ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Spacing="14">

								<CollectionView IsVisible="{Binding IsPendingTabActive}" ItemsSource="{Binding PendingEncounters}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="vm:WaitlistItemDto">
											<Border
												Margin="0,0,0,12"
												Padding="14"
												BackgroundColor="#FFFFFF"
												Stroke="#E2E8F0"
												StrokeShape="RoundRectangle 12">
												<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
													<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
														<Label
															Grid.Column="0"
															FontAttributes="Bold"
															FontSize="14"
															Text="{Binding PatientName}"
															TextColor="#0F172A" />
														<Border
															Grid.Column="1"
															BackgroundColor="#E11D48"
															HeightRequest="24"
															StrokeShape="RoundRectangle 12"
															StrokeThickness="0"
															WidthRequest="24">
															<Label
																FontAttributes="Bold"
																FontSize="9"
																HorizontalOptions="Center"
																Text="{Binding PatientInitials}"
																TextColor="White"
																VerticalOptions="Center" />
														</Border>
													</Grid>
													<Label
														Grid.Row="1"
														FontSize="11"
														Text="{Binding PatientContact}"
														TextColor="#94A3B8" />
													<HorizontalStackLayout Grid.Row="2" Spacing="8">
														<Label
															FontSize="12"
															Text="🕒"
															TextColor="#64748B"
															VerticalOptions="Center" />
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding TimeRangeText}"
															TextColor="#1E293B"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<HorizontalStackLayout Grid.Row="3" Spacing="8">
														<Label
															FontSize="12"
															Text="🩺"
															VerticalOptions="Center" />
														<Label
															FontSize="12"
															Text="{Binding DoctorName}"
															TextColor="#334155"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<Grid
														Grid.Row="4"
														Margin="0,4,0,0"
														ColumnDefinitions="*, Auto"
														ColumnSpacing="8">
														<Button
															Grid.Column="0"
															BackgroundColor="#0F172A"
															Command="{Binding BindingContext.ProcessEncounterSelectionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
															CommandParameter="{Binding Id}"
															CornerRadius="8"
															FontAttributes="Bold"
															FontSize="12"
															HeightRequest="38"
															Text="Започни преглед"
															TextColor="White" />
														<Border
															Grid.Column="1"
															HeightRequest="38"
															Stroke="#E2E8F0"
															StrokeShape="RoundRectangle 8"
															WidthRequest="38">
															<Label
																FontSize="12"
																HorizontalOptions="Center"
																Text="•••"
																TextColor="#64748B"
																VerticalOptions="Center" />
														</Border>
													</Grid>
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>

								<CollectionView IsVisible="{Binding IsInProgressTabActive}" ItemsSource="{Binding InProgressEncounters}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="vm:WaitlistItemDto">
											<Border
												Margin="0,0,0,12"
												Padding="14"
												BackgroundColor="#FFFFFF"
												Stroke="#E2E8F0"
												StrokeShape="RoundRectangle 12">
												<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
													<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
														<Label
															Grid.Column="0"
															FontAttributes="Bold"
															FontSize="14"
															Text="{Binding PatientName}"
															TextColor="#0F172A" />
														<Border
															Grid.Column="1"
															BackgroundColor="#D97706"
															HeightRequest="24"
															StrokeShape="RoundRectangle 12"
															StrokeThickness="0"
															WidthRequest="24">
															<Label
																FontAttributes="Bold"
																FontSize="9"
																HorizontalOptions="Center"
																Text="{Binding PatientInitials}"
																TextColor="White"
																VerticalOptions="Center" />
														</Border>
													</Grid>
													<Label
														Grid.Row="1"
														FontSize="11"
														Text="{Binding PatientContact}"
														TextColor="#94A3B8" />
													<HorizontalStackLayout Grid.Row="2" Spacing="8">
														<Label
															FontSize="12"
															Text="🕒"
															TextColor="#64748B"
															VerticalOptions="Center" />
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding TimeRangeText}"
															TextColor="#1E293B"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<HorizontalStackLayout Grid.Row="3" Spacing="8">
														<Label
															FontSize="12"
															Text="🩺"
															VerticalOptions="Center" />
														<Label
															FontSize="12"
															Text="{Binding DoctorName}"
															TextColor="#334155"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<Grid
														Grid.Row="4"
														Margin="0,4,0,0"
														ColumnDefinitions="*, Auto"
														ColumnSpacing="8">
														<Button
															Grid.Column="0"
															BackgroundColor="#2563EB"
															Command="{Binding BindingContext.ProcessEncounterSelectionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
															CommandParameter="{Binding Id}"
															CornerRadius="8"
															FontAttributes="Bold"
															FontSize="12"
															HeightRequest="38"
															Text="Отвори детали"
															TextColor="White" />
														<Border
															Grid.Column="1"
															HeightRequest="38"
															Stroke="#E2E8F0"
															StrokeShape="RoundRectangle 8"
															WidthRequest="38">
															<Label
																FontSize="12"
																HorizontalOptions="Center"
																Text="•••"
																TextColor="#64748B"
																VerticalOptions="Center" />
														</Border>
													</Grid>
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>

								<CollectionView IsVisible="{Binding IsScheduledTabActive}" ItemsSource="{Binding ScheduledEncounters}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="vm:WaitlistItemDto">
											<Border
												Margin="0,0,0,12"
												Padding="14"
												BackgroundColor="#FFFFFF"
												Stroke="#E2E8F0"
												StrokeShape="RoundRectangle 12">
												<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
													<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
														<Label
															Grid.Column="0"
															FontAttributes="Bold"
															FontSize="14"
															Text="{Binding PatientName}"
															TextColor="#0F172A" />
														<Border
															Grid.Column="1"
															BackgroundColor="#2563EB"
															HeightRequest="24"
															StrokeShape="RoundRectangle 12"
															StrokeThickness="0"
															WidthRequest="24">
															<Label
																FontAttributes="Bold"
																FontSize="9"
																HorizontalOptions="Center"
																Text="{Binding PatientInitials}"
																TextColor="White"
																VerticalOptions="Center" />
														</Border>
													</Grid>
													<Label
														Grid.Row="1"
														FontSize="11"
														Text="{Binding PatientContact}"
														TextColor="#94A3B8" />
													<HorizontalStackLayout Grid.Row="2" Spacing="8">
														<Label
															FontSize="12"
															Text="🕒"
															TextColor="#64748B"
															VerticalOptions="Center" />
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding TimeRangeText}"
															TextColor="#1E293B"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<HorizontalStackLayout Grid.Row="3" Spacing="8">
														<Label
															FontSize="12"
															Text="🩺"
															VerticalOptions="Center" />
														<Label
															FontSize="12"
															Text="{Binding DoctorName}"
															TextColor="#334155"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<Grid
														Grid.Row="4"
														Margin="0,4,0,0"
														ColumnDefinitions="*, Auto"
														ColumnSpacing="8">
														<Button
															Grid.Column="0"
															BackgroundColor="#0F172A"
															Command="{Binding BindingContext.ProcessEncounterSelectionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
															CommandParameter="{Binding Id}"
															CornerRadius="8"
															FontAttributes="Bold"
															FontSize="12"
															HeightRequest="38"
															Text="Пријави пациент"
															TextColor="White" />
														<Border
															Grid.Column="1"
															HeightRequest="38"
															Stroke="#E2E8F0"
															StrokeShape="RoundRectangle 8"
															WidthRequest="38">
															<Label
																FontSize="12"
																HorizontalOptions="Center"
																Text="•••"
																TextColor="#64748B"
																VerticalOptions="Center" />
														</Border>
													</Grid>
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>

							</VerticalStackLayout>
						</ScrollView>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>