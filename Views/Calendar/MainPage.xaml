<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Calendar.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Calendar"
	x:DataType="vm:CalendarDashboardViewModel"
	BackgroundColor="#FAFAFA">
	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="8">
			<!--  MAIN PAGE GRID: 2 COLUMNS (CALENDAR DASHBOARD | WAITLIST PANEL)  -->
			<Grid ColumnDefinitions="*, 340" ColumnSpacing="0">

				<!--  ==================== LEFT AREA: CALENDAR & METRICS ====================  -->
				<Grid
					Grid.Column="0"
					Padding="28,18,16,0"
					RowDefinitions="Auto, Auto, Auto, *"
					RowSpacing="36">

					<!--  1. HEADER TITLE  -->
					<Label
						Grid.Row="0"
						FontAttributes="Bold"
						FontSize="24"
						Text="Календар на Прегледи"
						TextColor="#0F172A" />

					<!--  2. TOOLBAR CONTROLS  -->
					<Grid Grid.Row="1" ColumnDefinitions="4*,8*">
						<!--  Navigation & Date Title  -->
						<HorizontalStackLayout
							Grid.Column="0"
							Spacing="10"
							VerticalOptions="Center">
							<Border
								Padding="14,6"
								BackgroundColor="#FFFFFF"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 6">
								<Border.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding GoToTodayCommand}" />
								</Border.GestureRecognizers>
								<Label
									FontAttributes="Bold"
									FontSize="22"
									Text="Денес"
									TextColor="#1E293B" />
							</Border>

							<Label
								Margin="0,-5,0,0"
								FontAttributes="Bold"
								FontSize="22"
								Text="{Binding CurrentMonthYearText}"
								TextColor="#0F172A"
								VerticalOptions="Center" />

							<Border
								Margin="0,-5,0,0"
								Padding="0"
								BackgroundColor="White"
								HeightRequest="36"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 12"
								WidthRequest="36">
								<Border.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
								</Border.GestureRecognizers>
								<Label
									Margin="0,-5,0,0"
									FontSize="22"
									HorizontalOptions="Center"
									HorizontalTextAlignment="Center"
									Text="‹"
									TextColor="#64748B"
									VerticalOptions="Center"
									VerticalTextAlignment="Center" />
							</Border>
							<Border
								Margin="0,-5,0,0"
								Padding="0"
								BackgroundColor="#FFFFFF"
								HeightRequest="36"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 12"
								WidthRequest="36">
								<Border.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding NextWeekCommand}" />
								</Border.GestureRecognizers>
								<Label
									Margin="0,-5,0,0"
									FontSize="22"
									HorizontalOptions="Center"
									Text="›"
									TextColor="#64748B"
									VerticalOptions="Center" />
							</Border>
						</HorizontalStackLayout>

						<!--  View Switchers & Dropdowns  -->
						<HorizontalStackLayout
							Grid.Column="2"
							HorizontalOptions="End"
							MinimumWidthRequest="400"
							Spacing="8"
							VerticalOptions="Center">

							<!--  View Switcher Toggle Buttons  -->
							<Border
								Padding="4"
								BackgroundColor="{StaticResource Transparent}"
								StrokeShape="RoundRectangle 16">
								<HorizontalStackLayout Spacing="2">
									<Button
										BackgroundColor="{StaticResource StatTealBg}"
										Command="{Binding SetCalendarViewCommand}"
										CommandParameter="Day"
										CornerRadius="16"
										FontAttributes="Bold"
										FontSize="12"
										HeightRequest="32"
										Text="Day"
										TextColor="#0D9488"
										WidthRequest="80" />
									<Button
										BackgroundColor="{StaticResource StatTealBg}"
										Command="{Binding SetCalendarViewCommand}"
										CommandParameter="Week"
										CornerRadius="16"
										FontAttributes="Bold"
										FontSize="12"
										HeightRequest="32"
										Text="Week"
										TextColor="#0D9488"
										WidthRequest="80" />
									<Button
										BackgroundColor="{StaticResource StatTealBg}"
										Command="{Binding SetCalendarViewCommand}"
										CommandParameter="Month"
										CornerRadius="16"
										FontAttributes="Bold"
										FontSize="12"
										HeightRequest="32"
										Style="{StaticResource BaseButtonStyle}"
										Text="Month"
										TextColor="#0D9488"
										WidthRequest="80" />
								</HorizontalStackLayout>
							</Border>

							<!--  Status Picker Container  -->
							<VerticalStackLayout Spacing="2" VerticalOptions="Center">
								<Label
									Margin="4,0,0,0"
									FontSize="10"
									Text="Пребарување по Статус"
									TextColor="#64748B" />

								<Border
									Padding="8,0"
									BackgroundColor="#FFFFFF"
									HeightRequest="44"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 16">
									<Picker
										FontSize="12"
										HorizontalOptions="Fill"
										ItemsSource="{Binding Statuses}"
										SelectedItem="{Binding SelectedStatus}"
										TextColor="#0F172A"
										TitleColor="#94A3B8"
										VerticalOptions="Start"
										WidthRequest="120" />
								</Border>
							</VerticalStackLayout>

						</HorizontalStackLayout>
					</Grid>

					<!--  3. KPI METRIC CARDS SECTION  -->
					<Grid
						Grid.Row="2"
						ColumnDefinitions="*, *, *"
						ColumnSpacing="12"
						IsVisible="{Binding IsStatsViewActive}">
						<!--  Card 1: Total Appointments  -->
						<Border
							Grid.Column="0"
							Padding="14,10"
							BackgroundColor="#FFFFFF"
							Stroke="#00FF28"
							StrokeShape="RoundRectangle 8">
							<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
								<Label
									Grid.Row="0"
									Grid.Column="0"
									FontSize="16"
									Text="Сите Прегледи ⓘ"
									TextColor="#00FF28" />
								<Label
									Grid.Row="1"
									Grid.Column="0"
									FontAttributes="Bold"
									FontSize="22"
									Text="{Binding MonthlyEncountersCount}"
									TextColor="#ADE6B6" />
								<Border
									Grid.Row="1"
									Grid.Column="1"
									Padding="6,2"
									BackgroundColor="#00FF28"
									StrokeShape="RoundRectangle 10">
									<Label
										Padding="10"
										FontAttributes="Bold"
										FontSize="10"
										Text="+12% vs last week"
										TextColor="#ffffff" />
								</Border>
							</Grid>
						</Border>

						<!--  Card 2: Completed Appointments  -->
						<Border
							Grid.Column="1"
							Padding="14,10"
							BackgroundColor="#00D4C8"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 8">
							<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
								<Label
									Grid.Row="0"
									Grid.Column="0"
									FontSize="16"
									Text="Завршени. ⓘ"
									TextColor="#FFFFFF" />
								<Label
									Grid.Row="1"
									Grid.Column="0"
									FontAttributes="Bold"
									FontSize="22"
									Text="{Binding CompletedPercentageText}"
									TextColor="#FFFFFF" />
								<Border
									Grid.Row="1"
									Grid.Column="1"
									Padding="0,2"
									BackgroundColor="#FFFFFF"
									StrokeShape="RoundRectangle 10">
									<Label
										Padding="10"
										FontAttributes="Bold"
										FontSize="10"
										Text="+12% vs last week"
										TextColor="#00D4C8" />
								</Border>
							</Grid>
						</Border>

						<!--  Card 3: No Show Appointments  -->
						<Border
							Grid.Column="2"
							Padding="14,10"
							BackgroundColor="#DFFFFC"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 8">
							<Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
								<Label
									Grid.Row="0"
									Grid.Column="0"
									FontSize="16"
									Text="Не се дојдени ⓘ"
									TextColor="#64748B" />
								<Label
									Grid.Row="1"
									Grid.Column="0"
									FontAttributes="Bold"
									FontSize="22"
									Text="{Binding NoShowPercentageText}"
									TextColor="#0F172A" />
								<Border
									Grid.Row="1"
									Grid.Column="1"
									Padding="6,2"
									BackgroundColor="#FFFFFF"
									StrokeShape="RoundRectangle 10">
									<Label
										Padding="10"
										FontAttributes="Bold"
										FontSize="10"
										Text="+12% vs last week"
										TextColor="#0F172A" />
								</Border>
							</Grid>
						</Border>
					</Grid>

					<!--  4. WEEKLY CALENDAR GRID AREA  -->
					<Border
						Grid.Row="3"
						Grid.ColumnSpan="2"
						Padding="0"
						BackgroundColor="#FFFFFF"
						Stroke="#E2E8F0"
						StrokeShape="RoundRectangle 12"
						StrokeThickness="1">
						<Border.Shadow>
							<Shadow
								Brush="Black"
								Opacity="0.06"
								Radius="14"
								Offset="0,4" />
						</Border.Shadow>

						<Grid RowDefinitions="Auto, *">

							<!--  ==================== 1. ХЕДЕР ЗА ДЕНОВИ ====================  -->
							<Border
								Grid.Row="0"
								Padding="0"
								BackgroundColor="#F8FAFC"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 1"
								StrokeThickness="1">
								<Grid ColumnDefinitions="64, *, *, *, *, *, *, *">

									<BoxView
										Grid.Column="0"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />
									<BoxView
										Grid.Column="1"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />
									<BoxView
										Grid.Column="2"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />
									<BoxView
										Grid.Column="3"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />
									<BoxView
										Grid.Column="4"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />
									<BoxView
										Grid.Column="5"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />
									<BoxView
										Grid.Column="6"
										HorizontalOptions="End"
										VerticalOptions="Fill"
										WidthRequest="1"
										Color="#E2E8F0" />

									<Label
										Grid.Column="0"
										FontAttributes="Bold"
										FontSize="9"
										HorizontalOptions="Center"
										Text="GMT+7"
										TextColor="#94A3B8"
										VerticalOptions="Center" />

									<!--  Week day headers driven by CollectionView so no index-based bindings needed  -->
									<CollectionView
										Grid.Column="1"
										Grid.ColumnSpan="7"
										ItemsSource="{Binding WeekDays}"
										SelectionMode="None">
										<CollectionView.ItemsLayout>
											<GridItemsLayout Orientation="Vertical" Span="7" />
										</CollectionView.ItemsLayout>
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="vm:CalendarDayDto">
												<VerticalStackLayout
													Padding="0,10"
													HorizontalOptions="Center"
													VerticalOptions="Center">
													<VerticalStackLayout.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCalendarDayCommand}" CommandParameter="{Binding .}" />
													</VerticalStackLayout.GestureRecognizers>
													<HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
														<Border
															Padding="6,2"
															BackgroundColor="#0284C7"
															IsVisible="{Binding IsToday}"
															StrokeShape="RoundRectangle 10"
															StrokeThickness="0">
															<Label
																FontAttributes="Bold"
																FontSize="11"
																Text="{Binding DayNumber}"
																TextColor="White" />
														</Border>
														<Label
															FontAttributes="Bold"
															FontSize="12"
															IsVisible="{Binding IsToday, Converter={StaticResource InvertedBoolConverter}}"
															Text="{Binding DayNumber}"
															TextColor="#0F172A" />
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding DayNameShort}"
															TextColor="#0F172A" />
													</HorizontalStackLayout>
													<Label
														Margin="0,3,0,0"
														FontSize="10"
														HorizontalOptions="Center"
														Text="{Binding EncountersCountText}"
														TextColor="#94A3B8" />
												</VerticalStackLayout>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Grid>
							</Border>

							<!--  ==================== 2. КАЛЕНДАРСКА МРЕЖА — VIRTUALIZED  ====================  -->
							<CollectionView
								Grid.Row="1"
								ItemsSource="{Binding HourlyTimelineSlots}"
								SelectionMode="None"
								VerticalScrollBarVisibility="Default">
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="vm:HourlyTimelineSlotDto">
										<Grid ColumnDefinitions="64,*,*,*,*,*,*,*" MinimumHeightRequest="64">
											<BoxView
												Grid.ColumnSpan="8"
												HeightRequest="1"
												VerticalOptions="Start"
												Color="#EDF1F5" />

											<Label
												Grid.Column="0"
												Margin="0,10,0,0"
												FontAttributes="Bold"
												FontSize="10"
												HorizontalOptions="Center"
												Text="{Binding HourText}"
												TextColor="#94A3B8"
												VerticalOptions="Start" />

											<VerticalStackLayout
												Grid.Column="1"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[0]}"
												Spacing="3" />
											<VerticalStackLayout
												Grid.Column="2"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[1]}"
												Spacing="3" />
											<VerticalStackLayout
												Grid.Column="3"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[2]}"
												Spacing="3" />
											<VerticalStackLayout
												Grid.Column="4"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[3]}"
												Spacing="3" />
											<VerticalStackLayout
												Grid.Column="5"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[4]}"
												Spacing="3" />
											<VerticalStackLayout
												Grid.Column="6"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[5]}"
												Spacing="3" />
											<VerticalStackLayout
												Grid.Column="7"
												Margin="4,3,4,3"
												BindableLayout.ItemTemplate="{StaticResource CalendarEventCardTemplate}"
												BindableLayout.ItemsSource="{Binding DayColumns[6]}"
												Spacing="3" />
										</Grid>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>
						</Grid>
					</Border>

				</Grid>

				<!--  ==================== RIGHT AREA: WAITLIST PANEL ====================  -->
				<Grid Grid.Column="1" WidthRequest="340">
					<BoxView
						HorizontalOptions="Start"
						VerticalOptions="Fill"
						WidthRequest="1"
						Color="#E2E8F0" />

					<Border
						Margin="-14,12,0,0"
						BackgroundColor="#FFFFFF"
						HeightRequest="28"
						HorizontalOptions="Start"
						Stroke="#E2E8F0"
						StrokeShape="RoundRectangle 14"
						VerticalOptions="Start"
						WidthRequest="28"
						ZIndex="10">
						<Label
							FontSize="16"
							HorizontalOptions="Center"
							Text="›"
							TextColor="#64748B"
							VerticalOptions="Center" />
					</Border>

					<Grid
						Padding="20,16,16,16"
						RowDefinitions="Auto, Auto, Auto, *"
						RowSpacing="16">

						<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
							<Label
								Grid.Column="0"
								FontAttributes="Bold"
								FontSize="18"
								Text="Листа на чекање"
								TextColor="#0F172A"
								VerticalOptions="Center" />
							<Button
								Grid.Column="1"
								Padding="12,0"
								BackgroundColor="#0EA5E9"
								Command="{Binding CreateNewEncounterForSelectedDayCommand}"
								CornerRadius="8"
								FontAttributes="Bold"
								FontSize="12"
								HeightRequest="36"
								Text="Додај преглед"
								TextColor="White" />
						</Grid>

						<Grid
							Grid.Row="1"
							ColumnDefinitions="*, Auto"
							ColumnSpacing="10">
							<Border
								Grid.Column="0"
								Padding="10,2"
								BackgroundColor="#F8FAFC"
								HeightRequest="38"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 8">
								<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
									<Label
										FontSize="12"
										Text="🔍"
										TextColor="#94A3B8"
										VerticalOptions="Center" />
									<Entry
										BackgroundColor="Transparent"
										FontSize="12"
										Placeholder="Пребарај..."
										PlaceholderColor="#94A3B8"
										Text="{Binding SearchText}"
										TextColor="#0F172A" />
								</HorizontalStackLayout>
							</Border>
							<Border
								Grid.Column="1"
								Padding="10,0"
								BackgroundColor="#FFFFFF"
								HeightRequest="38"
								Stroke="#E2E8F0"
								StrokeShape="RoundRectangle 8">
								<HorizontalStackLayout Spacing="4" VerticalOptions="Center">
									<Label
										FontSize="12"
										Text="Сортирај"
										TextColor="#475569"
										VerticalOptions="Center" />
									<Label
										FontSize="12"
										Text="⌄"
										TextColor="#475569"
										VerticalOptions="Center" />
								</HorizontalStackLayout>
							</Border>
						</Grid>

						<Grid
							Grid.Row="2"
							RowDefinitions="Auto, Auto"
							RowSpacing="6">
							<HorizontalStackLayout Grid.Row="0" Spacing="16">
								<HorizontalStackLayout Spacing="6">
									<HorizontalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectWaitlistTabCommand}" CommandParameter="Pending" />
									</HorizontalStackLayout.GestureRecognizers>
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="На чекање"
										TextColor="#0F172A" />
									<Border
										Padding="6,1"
										BackgroundColor="#0F172A"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="10"
											Text="{Binding PendingCount}"
											TextColor="White" />
									</Border>
								</HorizontalStackLayout>

								<HorizontalStackLayout Spacing="6">
									<HorizontalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectWaitlistTabCommand}" CommandParameter="InProgress" />
									</HorizontalStackLayout.GestureRecognizers>
									<Label
										FontSize="13"
										Text="Во тек"
										TextColor="#64748B" />
									<Label
										FontSize="13"
										Text="{Binding InProgressCount}"
										TextColor="#94A3B8" />
								</HorizontalStackLayout>

								<HorizontalStackLayout Spacing="6">
									<HorizontalStackLayout.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding SelectWaitlistTabCommand}" CommandParameter="Scheduled" />
									</HorizontalStackLayout.GestureRecognizers>
									<Label
										FontSize="13"
										Text="Закажани"
										TextColor="#64748B" />
									<Label
										FontSize="13"
										Text="{Binding ScheduledCount}"
										TextColor="#94A3B8" />
								</HorizontalStackLayout>
							</HorizontalStackLayout>

							<BoxView
								Grid.Row="1"
								HeightRequest="2"
								HorizontalOptions="Start"
								WidthRequest="85"
								Color="#0F172A" />
						</Grid>

						<ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Spacing="14">

								<CollectionView IsVisible="{Binding IsPendingTabActive}" ItemsSource="{Binding PendingEncounters}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="vm:WaitlistItemDto">
											<Border
												Margin="0,0,0,12"
												Padding="14"
												BackgroundColor="#FFFFFF"
												Stroke="#E2E8F0"
												StrokeShape="RoundRectangle 12">
												<Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" RowSpacing="8">
													<Grid Grid.Row="0" ColumnDefinitions="*, Auto">
														<Label
															Grid.Column="0"
															FontAttributes="Bold"
															FontSize="14"
															Text="{Binding PatientName}"
															TextColor="#0F172A" />
														<Border
															Grid.Column="1"
															BackgroundColor="#E11D48"
															HeightRequest="24"
															StrokeShape="RoundRectangle 12"
															StrokeThickness="0"
															WidthRequest="24">
															<Label
																FontAttributes="Bold"
																FontSize="9"
																HorizontalOptions="Center"
																Text="{Binding PatientInitials}"
																TextColor="White"
																VerticalOptions="Center" />
														</Border>
													</Grid>
													<Label
														Grid.Row="1"
														FontSize="11"
														Text="{Binding PatientContact}"
														TextColor="#94A3B8" />
													<HorizontalStackLayout Grid.Row="2" Spacing="8">
														<Label
															FontSize="12"
															Text="🕒"
															TextColor="#64748B"
															VerticalOptions="Center" />
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding TimeRangeText}"
															TextColor="#1E293B"
															VerticalOptions="Center" />
													</HorizontalStackLayout>
													<HorizontalStackLayout Grid.Row="3" Spacing="8">
														<Label
															FontSize="12"
															Text="🩺"
															VerticalOptions="Center" />
														<Label
