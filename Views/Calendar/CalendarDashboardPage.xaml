<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.CalendarDashboardPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:conv="clr-namespace:EHMR.Extensions"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="CurrentPage"
	x:DataType="vm:CalendarDashboardViewModel"
	BackgroundColor="{StaticResource SparkCanvasBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
			<conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />

			<!--  White elevated card — used for header, calendar grid, right panel  -->
			<Style x:Key="ElevatedCardStyle" TargetType="Border">
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
				<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape">
					<Setter.Value>
						<RoundRectangle CornerRadius="{StaticResource SparkRadiusLg}" />
					</Setter.Value>
				</Setter>
				<Setter Property="Shadow">
					<Setter.Value>
						<Shadow
							Brush="#1E2733"
							Opacity="0.06"
							Radius="10"
							Offset="0,2" />
					</Setter.Value>
				</Setter>
			</Style>

			<Style
				x:Key="MiniStatCardStyle"
				BasedOn="{StaticResource ElevatedCardStyle}"
				TargetType="Border">
				<Setter Property="StrokeShape">
					<Setter.Value>
						<RoundRectangle CornerRadius="{StaticResource SparkRadiusMd}" />
					</Setter.Value>
				</Setter>
				<Setter Property="Padding" Value="14,12" />
			</Style>

			<Style x:Key="StatIconChipStyle" TargetType="Border">
				<Setter Property="StrokeThickness" Value="0" />
				<Setter Property="WidthRequest" Value="36" />
				<Setter Property="HeightRequest" Value="36" />
				<Setter Property="StrokeShape">
					<Setter.Value>
						<RoundRectangle CornerRadius="10" />
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  SIDEBAR  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  MAIN CONTENT  -->
		<Grid
			Grid.Column="1"
			Padding="20"
			ColumnDefinitions="*,380"
			ColumnSpacing="16">

			<!--  ═══════════ LEFT: CALENDAR ═══════════  -->
			<Grid
				Grid.Column="0"
				RowDefinitions="Auto,Auto,*"
				RowSpacing="12">

				<!--  ROW 0: PAGE HEADER  -->
				<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
					<Grid
						Padding="20,16"
						ColumnDefinitions="*,Auto"
						VerticalOptions="Center">

						<VerticalStackLayout Spacing="4" VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="24"
								Text="Медицински календар"
								TextColor="{StaticResource SparkTextPrimary}" />
							<Label
								FontSize="13"
								Text="Распоред на прегледи"
								TextColor="{StaticResource SparkTextSecondary}" />
						</VerticalStackLayout>

						<HorizontalStackLayout
							Grid.Column="1"
							Spacing="8"
							VerticalOptions="Center">

							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding PreviousMonthCommand}"
								FontFamily="FASolid"
								HeightRequestEx="38"
								Text="&#xf053;"
								WidthRequestEx="38" />

							<Border
								Padding="14,0"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								HeightRequest="38"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="1"
								VerticalOptions="Center"
								WidthRequest="160">
								<Label
									FontAttributes="Bold"
									FontSize="13"
									HorizontalOptions="Center"
									Text="{Binding CurrentMonthYearText}"
									TextColor="{StaticResource SparkTextPrimary}"
									VerticalOptions="Center" />
							</Border>

							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding NextMonthCommand}"
								FontFamily="FASolid"
								HeightRequestEx="38"
								Text="&#xf054;"
								WidthRequestEx="38" />

							<controls:FFButton
								Margin="4,0,0,0"
								ButtonKind="Primary"
								Command="{Binding GoToTodayCommand}"
								HeightRequestEx="38"
								Text="{Binding TodaysEncountersCount, StringFormat='Денес ({0})'}"
								TextColorEx="White"
								WidthRequestEx="120" />

							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding CloseDayViewCommand}"
								HeightRequestEx="38"
								IsVisible="{Binding IsDayViewActive}"
								Text="Затвори ден"
								WidthRequestEx="130" />
						</HorizontalStackLayout>
					</Grid>
				</Border>

				<!--  ROW 1: WEEK TABS — dark navy bar, no outer wrapper  -->
				<controls:SparkExplorerHeaderView
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="2"
					SearchVisible="False"
					Tabs="{Binding WeekTabs}" />
				<!--  ROW 2: CALENDAR GRID  -->
				<Border Grid.Row="2" Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView>
						<FlexLayout
							Padding="10"
							AlignContent="Start"
							AlignItems="Start"
							BindableLayout.ItemsSource="{Binding CalendarDays}"
							Direction="Row"
							HeightRequest="800"
							JustifyContent="Start"
							Wrap="Wrap">

							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="vm:CalendarDayDto">
									<Border
										Margin="3"
										Padding="0"
										BackgroundColor="{StaticResource SparkBackgroundAlt}"
										FlexLayout.Basis="14.2857%"
										MinimumHeightRequest="104"
										Opacity="{Binding IsCurrentMonth, Converter={StaticResource BoolToOpacityConverter}}"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">

										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding BindingContext.SelectCalendarDayCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding .}" />
										</Border.GestureRecognizers>

										<Border.Triggers>
											<DataTrigger
												Binding="{Binding IsWeekHighlighted}"
												TargetType="Border"
												Value="True">
												<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
												<Setter Property="StrokeThickness" Value="2" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsToday}"
												TargetType="Border"
												Value="True">
												<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
												<Setter Property="StrokeThickness" Value="2" />
											</DataTrigger>
										</Border.Triggers>

										<Grid
											Padding="8,6"
											RowDefinitions="Auto,Auto,Auto"
											RowSpacing="4">

											<Grid
												Grid.Row="0"
												ColumnDefinitions="Auto,*"
												IsVisible="{Binding IsEmptySlot, Converter={StaticResource InvertedBoolConverter}}">

												<!--  Day number circle (teal on today)  -->
												<Border
													Padding="0"
													BackgroundColor="Transparent"
													HeightRequest="24"
													HorizontalOptions="Start"
													StrokeShape="RoundRectangle 12"
													StrokeThickness="0"
													WidthRequest="24">
													<Border.Triggers>
														<DataTrigger
															Binding="{Binding IsToday}"
															TargetType="Border"
															Value="True">
															<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
														</DataTrigger>
													</Border.Triggers>
													<Label
														FontAttributes="Bold"
														FontSize="12"
														HorizontalOptions="Center"
														Text="{Binding DayNumber}"
														VerticalOptions="Center">
														<Label.Triggers>
															<DataTrigger
																Binding="{Binding IsToday}"
																TargetType="Label"
																Value="True">
																<Setter Property="TextColor" Value="{StaticResource SparkBackground}" />
															</DataTrigger>
															<DataTrigger
																Binding="{Binding IsToday}"
																TargetType="Label"
																Value="False">
																<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
															</DataTrigger>
														</Label.Triggers>
													</Label>
												</Border>

												<!--  Event count badge  -->
												<Border
													Grid.Column="1"
													Padding="6,2"
													BackgroundColor="{StaticResource SparkBadgeNeutralBg}"
													HorizontalOptions="End"
													IsVisible="{Binding EventCount, Converter={StaticResource GreaterThanZeroConverter}}"
													StrokeShape="RoundRectangle 6"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="9"
														Text="{Binding EventCount}"
														TextColor="{StaticResource SparkBadgeNeutralText}" />
												</Border>
											</Grid>

											<!--  Events list  -->
											<VerticalStackLayout
												Grid.Row="1"
												BindableLayout.ItemsSource="{Binding VisibleEvents}"
												Spacing="3"
												VerticalOptions="Start">
												<BindableLayout.ItemTemplate>
													<DataTemplate x:DataType="vm:CalendarEventDto">
														<Border
															Padding="6,4"
															BackgroundColor="{Binding BackgroundColor}"
															StrokeShape="RoundRectangle 6"
															StrokeThickness="0">
															<Grid ColumnDefinitions="3,*" ColumnSpacing="5">
																<BoxView
																	Grid.Column="0"
																	BackgroundColor="{Binding TextColor}"
																	CornerRadius="2"
																	HorizontalOptions="Start"
																	VerticalOptions="Fill" />
																<VerticalStackLayout Grid.Column="1" Spacing="1">
																	<Label
																		FontAttributes="Bold"
																		FontSize="9"
																		Text="{Binding ScheduledTime, StringFormat='{0:HH:mm}'}"
																		TextColor="{Binding TextColor}" />
																	<Label
																		FontSize="9"
																		LineBreakMode="TailTruncation"
																		Text="{Binding Title}"
																		TextColor="{Binding TextColor}" />
																</VerticalStackLayout>
															</Grid>
														</Border>
													</DataTemplate>
												</BindableLayout.ItemTemplate>
											</VerticalStackLayout>

											<!--  +N more  -->
											<Border
												Grid.Row="2"
												Padding="6,2"
												BackgroundColor="Transparent"
												HorizontalOptions="Start"
												IsVisible="{Binding HasHiddenEvents}"
												StrokeShape="RoundRectangle 6"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="9"
													Text="{Binding HiddenEventsCount, StringFormat='+{0} повеќе'}"
													TextColor="{StaticResource SparkAccentTeal}" />
											</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</FlexLayout>
					</ScrollView>
				</Border>
			</Grid>

			<!--  ═══════════ RIGHT: INSIGHTS / DAY PANEL ═══════════  -->
			<Border Grid.Column="1" Style="{StaticResource ElevatedCardStyle}">
				<Grid RowDefinitions="64,*">

					<!--  Panel header  -->
					<Grid
						Grid.Row="0"
						Padding="20,0"
						ColumnDefinitions="*,Auto">
						<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
							<Label
								FontFamily="FASolid"
								FontSize="13"
								Text="&#xf200;"
								TextColor="{StaticResource SparkAccentTeal}"
								VerticalOptions="Center" />
							<Label
								CharacterSpacing="0.8"
								FontAttributes="Bold"
								FontSize="12"
								Text="УВИД И АНАЛИТИКА"
								TextColor="{StaticResource SparkTextPrimary}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
						<controls:FFButton
							Grid.Column="1"
							ButtonKind="Secondary"
							Command="{Binding CloseDayViewCommand}"
							HeightRequestEx="32"
							IsVisible="{Binding IsDayViewActive}"
							Text="Затвори"
							VerticalOptions="Center"
							WidthRequestEx="90" />
					</Grid>

					<!--  1px divider under panel header  -->
					<BoxView
						Grid.Row="0"
						BackgroundColor="{StaticResource SparkBorder}"
						HeightRequest="1"
						VerticalOptions="End" />

					<Grid Grid.Row="1">

						<!--  STATS VIEW  -->
						<ScrollView IsVisible="{Binding IsStatsViewActive}" VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="16,20" Spacing="12">

								<!--  Stat cards row  -->
								<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
									<Border Grid.Column="0" Style="{StaticResource MiniStatCardStyle}">
										<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
											<Border BackgroundColor="{StaticResource SparkBadgeNeutralBg}" Style="{StaticResource StatIconChipStyle}">
												<Label
													FontFamily="FASolid"
													FontSize="14"
													HorizontalOptions="Center"
													Text="&#xf133;"
													TextColor="{StaticResource SparkBadgeNeutralText}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout Spacing="3">
												<Label
													CharacterSpacing="0.5"
													FontAttributes="Bold"
													FontSize="8"
													Text="ОВОЈ МЕСЕЦ"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="20"
													Text="{Binding MonthlyEncountersCount}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</HorizontalStackLayout>
									</Border>
									<Border Grid.Column="1" Style="{StaticResource MiniStatCardStyle}">
										<HorizontalStackLayout Spacing="12" VerticalOptions="Center">
											<Border BackgroundColor="{StaticResource SparkAccentTealBg}" Style="{StaticResource StatIconChipStyle}">
												<Label
													FontFamily="FASolid"
													FontSize="14"
													HorizontalOptions="Center"
													Text="&#xf0f8;"
													TextColor="{StaticResource SparkAccentTeal}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout Spacing="3">
												<Label
													CharacterSpacing="0.5"
													FontAttributes="Bold"
													FontSize="8"
													Text="ДЕНЕС"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="20"
													Text="{Binding TodaysEncountersCount}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</HorizontalStackLayout>
									</Border>
								</Grid>

								<Border Style="{StaticResource MiniStatCardStyle}">
									<Grid ColumnDefinitions="Auto,*">
										<Border
											Margin="0,0,14,0"
											BackgroundColor="{StaticResource SparkBadgeWarningBg}"
											Style="{StaticResource StatIconChipStyle}"
											VerticalOptions="Center">
											<Label
												FontFamily="FASolid"
												FontSize="14"
												HorizontalOptions="Center"
												Text="&#xf073;"
												TextColor="{StaticResource SparkBadgeWarningText}"
												VerticalOptions="Center" />
										</Border>
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="3"
											VerticalOptions="Center">
											<Label
												CharacterSpacing="0.5"
												FontAttributes="Bold"
												FontSize="8"
												Text="ПРЕТСТОЈНИ ПРЕГЛЕДИ"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="20"
												Text="{Binding UpcomingEncountersCount}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Grid>
								</Border>

								<!--  Quick nav  -->
								<VerticalStackLayout Margin="0,8,0,0" Spacing="10">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="11"
										Text="Брза навигација"
										TextColor="{StaticResource SparkTextPrimary}" />
									<controls:FFButton
										ButtonKind="Primary"
										Command="{Binding CreateNewEncounterForSelectedDayCommand}"
										FontFamily="FASolid"
										HeightRequestEx="44"
										HorizontalOptionsEx="Fill"
										Text="&#xf271; Нов преглед" />
								</VerticalStackLayout>
							</VerticalStackLayout>
						</ScrollView>

						<!--  DAY VIEW  -->
						<ScrollView IsVisible="{Binding IsDayViewActive}" VerticalScrollBarVisibility="Always">
							<VerticalStackLayout Padding="16,20" Spacing="16">

								<Border
									Padding="12,10"
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									HorizontalOptions="Fill"
									Stroke="{StaticResource SparkAccentTeal}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="1">
									<HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
										<Label
											FontFamily="FASolid"
											FontSize="12"
											Text="&#xf017;"
											TextColor="{StaticResource SparkAccentTealDark}"
											VerticalOptions="Center" />
										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="ДНЕВЕН РАСПОРЕД ЗА ДЕН:"
											TextColor="{StaticResource SparkAccentTealDark}"
											VerticalOptions="Center" />
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding SelectedCalendarDay.DayNumber}"
											TextColor="{StaticResource SparkAccentTealDark}"
											VerticalOptions="Center" />
									</HorizontalStackLayout>
								</Border>

								<VerticalStackLayout BindableLayout.ItemsSource="{Binding HourlyTimelineSlots}" Spacing="0">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="vm:HourlyTimelineSlotDto">
											<VerticalStackLayout>
												<Grid Padding="0,12" ColumnDefinitions="60,*">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding BindingContext.CreateNewEncounterForSpecificHourCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>
													<Label
														Grid.Column="0"
														Margin="0,4,0,0"
														FontAttributes="Bold"
														FontSize="12"
														Text="{Binding HourText}"
														TextColor="{StaticResource SparkTextSecondary}"
														VerticalOptions="Start" />
													<VerticalStackLayout
														Grid.Column="1"
														BindableLayout.ItemsSource="{Binding SlotEvents}"
														Spacing="6">
														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="vm:CalendarEventDto">
																<Border
																	Padding="12,10"
																	BackgroundColor="{StaticResource SparkBackgroundAlt}"
																	Stroke="{StaticResource SparkBorder}"
																	StrokeShape="RoundRectangle 10"
																	StrokeThickness="1">
																	<Border.GestureRecognizers>
																		<TapGestureRecognizer Tapped="OnTimelineItemBorderTapped" />
																	</Border.GestureRecognizers>
																	<Grid ColumnDefinitions="3,*" ColumnSpacing="10">
																		<BoxView
																			Grid.Column="0"
																			BackgroundColor="{Binding TextColor}"
																			CornerRadius="2"
																			HorizontalOptions="Start"
																			VerticalOptions="Fill" />
																		<VerticalStackLayout Grid.Column="1" Spacing="2">
																			<Label
																				FontAttributes="Bold"
																				FontSize="13"
																				Text="{Binding Title}"
																				TextColor="{StaticResource SparkTextPrimary}" />
																			<HorizontalStackLayout Spacing="5">
																				<Label
																					FontFamily="FASolid"
																					FontSize="10"
																					Text="&#xf05a;"
																					TextColor="{StaticResource SparkTextSecondary}"
																					VerticalOptions="Center" />
																				<Label
																					FontSize="11"
																					Text="{Binding Status, StringFormat='Статус: {0}'}"
																					TextColor="{StaticResource SparkTextSecondary}"
																					VerticalOptions="Center" />
																			</HorizontalStackLayout>
																		</VerticalStackLayout>
																	</Grid>
																</Border>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</VerticalStackLayout>
												</Grid>
												<BoxView
													HeightRequest="1"
													HorizontalOptions="Fill"
													Color="{StaticResource SparkBorder}" />
											</VerticalStackLayout>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</ScrollView>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>