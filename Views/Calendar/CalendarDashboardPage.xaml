<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.CalendarDashboardPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:conv="clr-namespace:EHMR.Extensions"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="CurrentPage"
	x:DataType="vm:CalendarDashboardViewModel">

	<ContentPage.Resources>
		<ResourceDictionary>
			<conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
			<conv:InvertedBoolConverter x:Key="InvertedBoolConverter" />
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			ColumnDefinitions="*,400"
			ColumnSpacing="20">

			<!--  ═══════════════════ LEFT: CALENDAR ═══════════════════  -->
			<Grid
				Grid.Column="0"
				RowDefinitions="Auto,Auto,*"
				RowSpacing="16">


				<Border
					Grid.Row="0"
					Padding="28"
					BackgroundColor="{StaticResource SparkBackground}"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 0">

					<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
						<VerticalStackLayout Spacing="6" VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="28"
								Text="Медицински календар"
								TextColor="{StaticResource SparkTextPrimary}" />
							<Label
								FontSize="14"
								Text="Распоред на прегледи"
								TextColor="{StaticResource SparkTextSecondary}" />
						</VerticalStackLayout>

						<HorizontalStackLayout
							Grid.Column="1"
							Spacing="8"
							VerticalOptions="Center">
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding PreviousMonthCommand}"
								FontFamily="FASolid"
								HeightRequestEx="40"
								Text="&#xf053;"
								WidthRequestEx="40" />

							<Border
								Padding="16,0"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								HeightRequest="40"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="1"
								VerticalOptions="Center"
								WidthRequest="180">
								<Label
									FontAttributes="Bold"
									FontSize="14"
									HorizontalOptions="Center"
									Text="{Binding CurrentMonthYearText}"
									TextColor="{StaticResource SparkTextPrimary}"
									VerticalOptions="Center" />
							</Border>

							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding NextMonthCommand}"
								FontFamily="FASolid"
								HeightRequestEx="40"
								Text="&#xf054;"
								WidthRequestEx="40" />

							<controls:FFButton
								Margin="8,0,0,0"
								ButtonKind="Primary"
								Command="{Binding GoToTodayCommand}"
								HeightRequestEx="40"
								Text="{Binding TodaysEncountersCount, StringFormat='Денес ({0})'}"
								TextColorEx="White"
								WidthRequestEx="120" />


							<controls:FFButton
								Margin="8,0,0,0"
								ButtonKind="Primary"
								Command="{Binding CloseDayViewCommand}"
								HeightRequestEx="40"
								IsVisible="{Binding IsDayViewActive}"
								Text="Затвори Ден"
								TextColorEx="White"
								WidthRequestEx="140" />
						</HorizontalStackLayout>
					</Grid>
				</Border>


				<Border
					Grid.Row="1"
					Padding="0"
					BackgroundColor="{StaticResource SparkBackground}"
					StrokeThickness="0">
					<controls:CalendarHeader Tabs="{Binding WeekTabs}" />
				</Border>


				<Border
					Grid.Row="2"
					BackgroundColor="{StaticResource SparkBackground}"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">
					<ScrollView>
						<FlexLayout
							Padding="8"
							AlignContent="Start"
							AlignItems="Start"
							BindableLayout.ItemsSource="{Binding CalendarDays}"
							Direction="Row"
							HeightRequest="800"
							JustifyContent="Start"
							Wrap="Wrap">

							<BindableLayout.ItemTemplate>
								<DataTemplate x:DataType="vm:CalendarDayDto">
									<Border
										Margin="3"
										Padding="0"
										BackgroundColor="{StaticResource SparkBackgroundAlt}"
										FlexLayout.Basis="14.2857%"
										MinimumHeightRequest="104"
										Opacity="{Binding IsCurrentMonth, Converter={StaticResource BoolToOpacityConverter}}"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 4"
										StrokeThickness="1">

										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding BindingContext.SelectCalendarDayCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding .}" />
										</Border.GestureRecognizers>

										<Border.Triggers>
											<DataTrigger
												Binding="{Binding IsWeekHighlighted}"
												TargetType="Border"
												Value="True">
												<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
												<Setter Property="StrokeThickness" Value="2" />
											</DataTrigger>

											<DataTrigger
												Binding="{Binding IsToday}"
												TargetType="Border"
												Value="True">
												<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
												<Setter Property="StrokeThickness" Value="2" />
											</DataTrigger>
										</Border.Triggers>

										<Grid
											Padding="8,6"
											RowDefinitions="Auto,*,Auto"
											RowSpacing="4">

											<!--  ДЕН + БРОЈ ПРЕГЛЕДИ  -->
											<Grid
												Grid.Row="0"
												ColumnDefinitions="Auto,*"
												IsVisible="{Binding IsEmptySlot, Converter={StaticResource InvertedBoolConverter}}">

												<Border
													Padding="0"
													BackgroundColor="Transparent"
													HeightRequest="24"
													HorizontalOptions="Start"
													StrokeShape="RoundRectangle 6"
													StrokeThickness="0"
													WidthRequest="24">
													<Border.Triggers>
														<DataTrigger
															Binding="{Binding IsToday}"
															TargetType="Border"
															Value="True">
															<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
														</DataTrigger>
													</Border.Triggers>
													<Label
														FontAttributes="Bold"
														FontSize="13"
														HorizontalOptions="Center"
														Text="{Binding DayNumber}"
														VerticalOptions="Center">
														<Label.Triggers>
															<DataTrigger
																Binding="{Binding IsToday}"
																TargetType="Label"
																Value="True">
																<Setter Property="TextColor" Value="{StaticResource SparkBackground}" />
															</DataTrigger>
															<DataTrigger
																Binding="{Binding IsToday}"
																TargetType="Label"
																Value="False">
																<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
															</DataTrigger>
														</Label.Triggers>
													</Label>
												</Border>

												<Border
													Grid.Column="1"
													Padding="7,2"
													BackgroundColor="{StaticResource SparkBadgeNeutralBg}"
													HorizontalOptions="End"
													IsVisible="{Binding EventCount, Converter={StaticResource GreaterThanZeroConverter}}"
													StrokeShape="RoundRectangle 6"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="9"
														Text="{Binding EventCount}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</Border>
											</Grid>

											<!--  НАСТАНИ  -->
											<VerticalStackLayout
												Grid.Row="1"
												BindableLayout.ItemsSource="{Binding VisibleEvents}"
												Spacing="3"
												VerticalOptions="Start">
												<BindableLayout.ItemTemplate>
													<DataTemplate x:DataType="vm:CalendarEventDto">
														<Border
															Padding="6,4"
															BackgroundColor="{Binding BackgroundColor}"
															StrokeShape="RoundRectangle 4"
															StrokeThickness="0">
															<Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
																<BoxView
																	BackgroundColor="{Binding TextColor}"
																	CornerRadius="2"
																	HorizontalOptions="Start"
																	VerticalOptions="Fill"
																	WidthRequest="3" />
																<VerticalStackLayout Grid.Column="1" Spacing="1">
																	<Label
																		FontAttributes="Bold"
																		FontSize="9"
																		Text="{Binding ScheduledTime, StringFormat='{0:HH:mm}'}"
																		TextColor="{Binding TextColor}" />
																	<Label
																		FontSize="9"
																		LineBreakMode="TailTruncation"
																		Text="{Binding Title}"
																		TextColor="{Binding TextColor}" />
																</VerticalStackLayout>
															</Grid>
														</Border>
													</DataTemplate>
												</BindableLayout.ItemTemplate>
											</VerticalStackLayout>

											<!--  +N ПОВЕЌЕ  -->
											<Border
												Grid.Row="2"
												Padding="6,2"
												BackgroundColor="Transparent"
												HorizontalOptions="Start"
												IsVisible="{Binding HasHiddenEvents}"
												StrokeShape="RoundRectangle 6"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="9"
													Text="{Binding HiddenEventsCount, StringFormat='+{0} повеќе'}"
													TextColor="{StaticResource SparkAccentTeal}" />
											</Border>
										</Grid>
									</Border>
								</DataTemplate>
							</BindableLayout.ItemTemplate>
						</FlexLayout>
					</ScrollView>
				</Border>
			</Grid>

			<!--  ═══════════════════ RIGHT: INSIGHTS / DAY PANEL ═══════════════════  -->
			<Border
				Grid.Column="1"
				Padding="0"
				BackgroundColor="{StaticResource SparkBackground}"
				Stroke="{StaticResource SparkBorder}"
				StrokeShape="RoundRectangle 0"
				StrokeThickness="1">
				<Grid RowDefinitions="72,*">

					<Grid
						Grid.Row="0"
						Padding="24,0"
						BackgroundColor="{StaticResource SparkBackgroundAlt}"
						ColumnDefinitions="*,Auto">
						<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
							<Label
								FontFamily="FASolid"
								FontSize="14"
								Text="&#xf200;"
								TextColor="{StaticResource SparkAccentTeal}"
								VerticalOptions="Center" />
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="УВИД И АНАЛИТИКА"
								TextColor="{StaticResource SparkTextPrimary}"
								VerticalOptions="Center" />
						</HorizontalStackLayout>

						<controls:FFButton
							Grid.Column="1"
							ButtonKind="Secondary"
							Command="{Binding CloseDayViewCommand}"
							HeightRequestEx="32"
							IsVisible="{Binding IsDayViewActive}"
							Text="Затвори"
							VerticalOptions="Center"
							WidthRequestEx="100" />
					</Grid>

					<Grid Grid.Row="1">

						<!--  STATS VIEW  -->
						<ScrollView IsVisible="{Binding IsStatsViewActive}" VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="16" Spacing="24">

								<Grid ColumnDefinitions="*,*" ColumnSpacing="14">
									<Border
										Grid.Column="0"
										Padding="16"
										BackgroundColor="{StaticResource SparkBackgroundAlt}"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 14"
										StrokeThickness="1">
										<VerticalStackLayout HorizontalOptions="Center" Spacing="6">
											<Label
												CharacterSpacing="1"
												FontAttributes="Bold"
												FontSize="11"
												HorizontalTextAlignment="Center"
												Text="ПРЕГЛЕДИ ОВОЈ МЕСЕЦ"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="26"
												HorizontalTextAlignment="Center"
												Text="{Binding MonthlyEncountersCount}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Border>
									<Border
										Grid.Column="1"
										Padding="16"
										BackgroundColor="{StaticResource SparkBackgroundAlt}"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 14"
										StrokeThickness="1">
										<VerticalStackLayout HorizontalOptions="Center" Spacing="6">
											<Label
												CharacterSpacing="1"
												FontAttributes="Bold"
												FontSize="11"
												HorizontalTextAlignment="Center"
												Text="ПРЕГЛЕДИ ДЕНЕС"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="26"
												HorizontalTextAlignment="Center"
												Text="{Binding TodaysEncountersCount}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Border>
								</Grid>

								<Border
									Padding="20,16"
									BackgroundColor="{StaticResource SparkBackgroundAlt}"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 14"
									StrokeThickness="1">
									<Grid ColumnDefinitions="Auto,*">
										<Label
											Margin="0,0,16,0"
											FontFamily="FASolid"
											FontSize="22"
											Text="&#xf073;"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center" />
										<VerticalStackLayout
											Grid.Column="1"
											Spacing="2"
											VerticalOptions="Center">
											<Label
												CharacterSpacing="0.3"
												FontAttributes="Bold"
												FontSize="11"
												Text="ПРЕТСТОЈНИ ПРЕГЛЕДИ"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="24"
												Text="{Binding UpcomingEncountersCount}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Grid>
								</Border>

								<VerticalStackLayout Margin="0,10,0,0" Spacing="10">
									<Label
										CharacterSpacing="1"
										FontAttributes="Bold"
										FontSize="12"
										Text="Брза навигација"
										TextColor="{StaticResource SparkTextPrimary}" />
									<controls:FFButton
										ButtonKind="Primary"
										Command="{Binding CreateNewEncounterForSelectedDayCommand}"
										HeightRequestEx="46"
										HorizontalOptionsEx="Fill"
										Text="&#xf271;   Нов преглед"
										TextColorEx="White"
										WidthRequestEx="320" />
								</VerticalStackLayout>
							</VerticalStackLayout>
						</ScrollView>

						<!--  DAY VIEW  -->
						<ScrollView IsVisible="{Binding IsDayViewActive}" VerticalScrollBarVisibility="Always">
							<VerticalStackLayout Padding="20" Spacing="20">

								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkBackgroundAlt}"
									HorizontalOptions="Fill"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
										<Label
											FontFamily="FASolid"
											FontSize="13"
											Text="&#xf017;"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="ДНЕВЕН РАСПОРЕД ЗА ДЕН:"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center" />
										<Label
											FontAttributes="Bold"
											FontSize="14"
											Text="{Binding SelectedCalendarDay.DayNumber}"
											TextColor="{StaticResource SparkAccentTeal}"
											VerticalOptions="Center" />
									</HorizontalStackLayout>
								</Border>

								<VerticalStackLayout BindableLayout.ItemsSource="{Binding HourlyTimelineSlots}" Spacing="0">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="vm:HourlyTimelineSlotDto">
											<VerticalStackLayout>
												<Grid Padding="0,14" ColumnDefinitions="64,*">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding BindingContext.CreateNewEncounterForSpecificHourCommand, Source={x:Reference CurrentPage}}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>

													<Label
														Grid.Column="0"
														Margin="0,4,0,0"
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding HourText}"
														TextColor="{StaticResource SparkTextSecondary}"
														VerticalOptions="Start" />

													<VerticalStackLayout
														Grid.Column="1"
														BindableLayout.ItemsSource="{Binding SlotEvents}"
														Spacing="6">
														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="vm:CalendarEventDto">
																<Border
																	Padding="14,12"
																	BackgroundColor="#DCFCE7"
																	Stroke="#BBF7D0"
																	StrokeShape="RoundRectangle 10"
																	StrokeThickness="1">
																	<Border.GestureRecognizers>
																		<TapGestureRecognizer Tapped="OnTimelineItemBorderTapped" />
																	</Border.GestureRecognizers>
																	<VerticalStackLayout Spacing="2">
																		<Label
																			FontAttributes="Bold"
																			FontSize="13"
																			Text="{Binding Title}"
																			TextColor="#15803D" />
																		<HorizontalStackLayout Spacing="6">
																			<Label
																				FontFamily="FASolid"
																				FontSize="10"
																				Text="&#xf05a;"
																				TextColor="{StaticResource SparkTextSecondary}"
																				VerticalOptions="Center" />
																			<Label
																				FontSize="11"
																				Text="{Binding Status, StringFormat='Статус: {0}'}"
																				TextColor="{StaticResource SparkTextSecondary}"
																				VerticalOptions="Center" />
																		</HorizontalStackLayout>
																	</VerticalStackLayout>
																</Border>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</VerticalStackLayout>
												</Grid>
												<BoxView
													HeightRequest="1"
													HorizontalOptions="Fill"
													Color="{StaticResource SparkBorder}" />
											</VerticalStackLayout>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</ScrollView>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>