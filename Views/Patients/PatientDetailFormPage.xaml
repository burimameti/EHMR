									<Grid IsVisible="{Binding IsEditMode}">
										<Border Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пребарај по код или опис..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding MkbSearchText}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>

									<Border IsVisible="{Binding ShowMkbDropdown}" Style="{StaticResource SearchDropdownBorderStyle}">
										<CollectionView ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="dto:Mkb10CodeDto">
													<Grid Padding="10,8">
														<Grid.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Grid.GestureRecognizers>
														<HorizontalStackLayout Spacing="8">
															<Label
																FontAttributes="Bold"
																FontFamily="Consolas"
																FontSize="12"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</HorizontalStackLayout>
													</Grid>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>

									<FlexLayout
										BindableLayout.ItemsSource="{Binding Diagnoses}"
