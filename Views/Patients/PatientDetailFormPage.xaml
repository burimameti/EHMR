						</Border>
					</VerticalStackLayout>

<!--  РЕД 6 — ДОСИЕ (документи)  -->
									<VerticalStackLayout Grid.Row="5" Spacing="10">

										<controls:CrudSectionHeader Title="ДОСИЕ" />

										<Border
											Padding="14"
											BackgroundColor="{StaticResource SparkBackground}"
											Stroke="{StaticResource SparkAccentTealBg}"
