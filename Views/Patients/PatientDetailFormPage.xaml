<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.PatientDetailFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    x:DataType="viewModels:PatientDetailFormViewModel"
    BackgroundColor="#F8FAFC">

	<Grid ColumnDefinitions="240,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="80,*">

			<Border Grid.Row="0" Style="{StaticResource GridHeaderStyle}" StrokeThickness="0">
				<Grid Padding="6,0" ColumnDefinitions="*,Auto">

					<VerticalStackLayout Spacing="2" VerticalOptions="Center">
						<HorizontalStackLayout Spacing="8">

							<Label Text="Податоци за Пациент" FontSize="22" FontAttributes="Bold" TextColor="#00A0FF" VerticalOptions="Center" Margin="4,0,0,0" />
						</HorizontalStackLayout>
						<Label Text="Целосен увид, креирање и ажурирање на медицински картон" FontSize="13" Margin="4,0,0,0" />
					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
						<Button Text="✎ Уреди Податоци"
                                IsVisible="{Binding IsReadOnly}"
                                Command="{Binding ToggleEditModeCommand}"
                                HeightRequest="40" Padding="16,0" CornerRadius="10" FontSize="12" FontAttributes="Bold" BackgroundColor="#2563EB" TextColor="#FFFFFF" />

						<Button Text="Откажи"
                                IsVisible="{Binding IsEditMode}"
                                Command="{Binding CancelCommand}"
                                HeightRequest="40" Padding="16,0" CornerRadius="10" FontSize="12" FontAttributes="Bold" BackgroundColor="#FF0A00" TextColor="#FFFFFF" />

						<Button Text="💾 Зачувај Запис"
                                IsVisible="{Binding IsEditMode}"
                                Command="{Binding SaveCommand}"
                                HeightRequest="40" Padding="20,0" CornerRadius="10" FontSize="12" FontAttributes="Bold" BackgroundColor="#2563EB" TextColor="#FFFFFF" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<ScrollView Grid.Row="1" Padding="16">
				<Grid ColumnDefinitions="2*,*" ColumnSpacing="16">

					<VerticalStackLayout Grid.Column="0" Spacing="6">

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="20">
								<HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
									<Label Text="👤" FontSize="18" VerticalOptions="Center" />
									<Label Text="Лични Информации" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
								</HorizontalStackLayout>

								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
									<VerticalStackLayout Spacing="6">
										<Label Text="ИМЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding Patient.FirstName}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Внесете име" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="6">
										<Label Text="ПРЕЗИМЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding Patient.LastName}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Внесете презиме" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Spacing="6">
										<Label Text="ЕМБГ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding Patient.NationalId}" IsReadOnly="{Binding IsReadOnly}" MaxLength="13" Keyboard="Numeric" Placeholder="13 цифри" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
										<Label Text="БРОЈ НА ОСИГУРУВАЊЕ (SSN)" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding Patient.SSN}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Внесете осигурителен број" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
						</Border>

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="20">
								<HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
									<Label Text="🩺" FontSize="18" VerticalOptions="Center" />
									<Label Text="Медицински Картон" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
								</HorizontalStackLayout>

								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
									<VerticalStackLayout Grid.ColumnSpan="2" Spacing="6">
										<Label Text="ПРИМАРНА ДИЈАГНОЗА *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding Patient.Diagnoses}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Пулмолошка, кардиолошка дијагноза или МКБ-10 код" PlaceholderColor="#94A3B8" FontSize="13" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Spacing="6">
										<Label Text="ПОЛ *"    FontSize="11"           FontAttributes="Bold"           TextColor="#475569"           CharacterSpacing="0.5" />

										<Grid>
											<!-- READ ONLY -->
											<Border IsVisible="{Binding IsReadOnly}"                Padding="12,6"                BackgroundColor="#E0F2FE"                StrokeThickness="0"                HorizontalOptions="Start"                StrokeShape="RoundRectangle 8">

												<HorizontalStackLayout Spacing="6">
													<BoxView WidthRequest="8"  HeightRequest="8" CornerRadius="4"  Color="#0369A1"  VerticalOptions="Center" />

													<Label Text="{Binding Patient.Gender}" FontSize="12" FontAttributes="Bold" TextColor="#0369A1" VerticalOptions="Center" />
												</HorizontalStackLayout>
											</Border>
											<!-- EDIT MODE -->
											<Border IsVisible="{Binding IsEditMode}"  HeightRequest="42"
													BackgroundColor="#FFFFFF"
													Stroke="#CBD5E1"
													StrokeThickness="1"
													StrokeShape="RoundRectangle 10">

												<Grid>
													<!-- Fake display -->
													<Grid ColumnDefinitions="*,Auto"
														  Margin="12,0"
														  InputTransparent="True">
														<Label Text="{Binding Patient.Gender, FallbackValue='Изберете пол'}"
															   TextColor="#0F172A"  FontSize="13"
															   VerticalOptions="Center" />
														<Label Grid.Column="1"
															   Text="▼"
															   TextColor="#94A3B8"
															   FontSize="11"
															   VerticalOptions="Center" />
													</Grid>

													<!-- Real picker -->
													<Picker SelectedItem="{Binding Patient.Gender}"
															TextColor="Transparent"
															TitleColor="Transparent"
															BackgroundColor="Transparent"
															HorizontalOptions="Fill"
															VerticalOptions="Fill">

														<Picker.ItemsSource>
															<x:Array Type="{x:Type x:String}">
																<x:String>Male</x:String>
																<x:String>Female</x:String>
															</x:Array>
														</Picker.ItemsSource>
													</Picker>
												</Grid>
											</Border>
										</Grid>
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
										<Label Text="ДАТУМ НА РАЃАЊЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Grid>
												<DatePicker Date="{Binding Patient.BirthDate, Mode=TwoWay}" Format="dd.MM.yyyy" IsVisible="{Binding IsEditMode}" FontSize="13" TextColor="#0F172A" VerticalOptions="Fill" HorizontalOptions="Fill" Margin="10,0" />
												<Label Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" IsVisible="{Binding IsReadOnly}" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
											</Grid>
										</Border>
									</VerticalStackLayout>
								</Grid>

								<VerticalStackLayout Spacing="6" Margin="0,4,0,0">
									<Label Text="ДЕТАЛНИ КЛИНИЧКИ НАПОМЕНИ (АНАМНЕЗА / ИСТОРПИЈА НА БОЛЕСТ)" FontSize="12" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
									<Border HeightRequest="120" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8">
										<Editor Text="{Binding Patient.Allergies}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Внесете симптоми, терапија или лекарски забелешки..." PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Fill" HorizontalOptions="Fill" AutoSize="Disabled" />
									</Border>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout Grid.Column="1" Spacing="24">
						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="14">
								<Label Text="СТАТУС НА ДОСИЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
								<Grid>
									<Border IsVisible="{Binding IsReadOnly}" Padding="12,6" BackgroundColor="#E0F2FE" StrokeThickness="0" HorizontalOptions="Start" StrokeShape="RoundRectangle 8">
										<HorizontalStackLayout Spacing="6">
											<BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#0369A1" VerticalOptions="Center" />
											<Label Text="{Binding Patient.Status}" FontSize="12" FontAttributes="Bold" TextColor="#0369A1" VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Border>

									<Border IsVisible="{Binding IsEditMode}" HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
										<Grid>
											<Grid ColumnDefinitions="*, Auto" Margin="12,0" InputTransparent="True">
												<Label Text="{Binding Patient.Status, FallbackValue='Изберете статус'}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
												<Label Grid.Column="1" Text="▼" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
											</Grid>
											<Picker SelectedItem="{Binding Patient.Status}" TextColor="Transparent" TitleColor="Transparent" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill">
												<Picker.ItemsSource>
													<x:Array Type="{x:Type x:String}">
														<x:String>Active</x:String>
														<x:String>Inactive</x:String>
														<x:String>Critical</x:String>
													</x:Array>
												</Picker.ItemsSource>
											</Picker>
										</Grid>
									</Border>
								</Grid>
							</VerticalStackLayout>
						</Border>
						<!--<Border IsVisible="{Binding IsReadOnly}"
        BackgroundColor="#F0FDF4"
        Padding="16"
        Stroke="#DCFCE7"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 16"
        Margin="0,0,0,0">
							-->
						<!--<VerticalStackLayout Spacing="12">
								-->
						<!--<HorizontalStackLayout Spacing="8">
									<Label Text="⚡" FontSize="16" VerticalOptions="Center" />
									<Label Text="Брзи Терапевтски Акции" FontSize="14" FontAttributes="Bold" TextColor="#166534" VerticalOptions="Center" />
								</HorizontalStackLayout>-->

						<!--<Label Text="Автоматско пресметување на слободен слот кај докторот и генерирање на следниот онколошки циклус за овој пациент."
               FontSize="12"
               TextColor="#1E293B" />

								<Button Text="📅 Алоцирај Следен Циклус"
                Command="{Binding GenerateNextTherapyCycleAndAppointmentCommand}"
                HeightRequest="42"
                BackgroundColor="#16A34A"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="13"
                CornerRadius="10"
                Margin="0,4,0,0" />-->
						<!--
							</VerticalStackLayout>-->
						<!--
						</Border>-->
						<!--<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="14">
								<Label Text="СТАТУС НА ДОСИЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
								<Grid>
									<Border IsVisible="{Binding IsReadOnly}" Padding="12,6" BackgroundColor="#E0F2FE" StrokeThickness="0" HorizontalOptions="Start" StrokeShape="RoundRectangle 8">
										<HorizontalStackLayout Spacing="6">
											<BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#0369A1" VerticalOptions="Center" />
											<Label Text="{Binding Patient.Status}" FontSize="12" FontAttributes="Bold" TextColor="#0369A1" VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Border>

									-->
						<!-- СТАБИЛЕН ДРОПДАУН СИСТЕМ (СТАТУС) -->
						<!--
									<Border IsVisible="{Binding IsEditMode}" HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
										<Grid>
											<Grid ColumnDefinitions="*, Auto" Margin="12,0" InputTransparent="True">
												<Label Text="{Binding Patient.Status, FallbackValue='Изберете статус'}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
												<Label Grid.Column="1" Text="▼" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
											</Grid>

											<Picker SelectedItem="{Binding Patient.Status}" TextColor="Transparent" TitleColor="Transparent" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill">
												<Picker.ItemsSource>
													<x:Array Type="{x:Type x:String}">
														<x:String>Active</x:String>
														<x:String>Inactive</x:String>
														<x:String>Critical</x:String>
