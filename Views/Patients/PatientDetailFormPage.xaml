												<Border Grid.Column="2" Padding="5,0" BackgroundColor="White" HeightRequest="36" Stroke="{StaticResource SparkBorderSubtle}" StrokeThickness="1"><Label FontSize="9.5" LineBreakMode="TailTruncation" Text="{Binding RegimeDisplay}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" /></Border>
												<Border Grid.Column="3" Padding="3,0" BackgroundColor="White" HeightRequest="36" Stroke="{StaticResource SparkBorderSubtle}" StrokeThickness="1"><Entry BackgroundColor="Transparent" FontSize="10" Keyboard="Numeric" Text="{Binding PatientMedicine.Quantity, Mode=TwoWay}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" /></Border>
												<Border Grid.Column="4" BackgroundColor="White" HeightRequest="36" Stroke="{StaticResource SparkBorderSubtle}" StrokeThickness="1"><Button Padding="0" BackgroundColor="Transparent" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}" FontSize="10" IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}" Text="✕" TextColor="#DC2626" WidthRequest="28" /></Border>
											</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
								</VerticalStackLayout>
							</VerticalStackLayout>
