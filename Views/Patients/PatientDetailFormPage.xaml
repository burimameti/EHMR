								ButtonKind="Primary"
								Command="{Binding SaveCommand}"
								ContentPadding="24,0"
								HeightRequestEx="42"
								IsVisible="{Binding IsEditMode}"
								Text="💾 Зачувај" />
							<controls:FFButton
								ButtonKind="Primary"
								Command="{Binding ToggleEditModeCommand}"
								ContentPadding="24,0"
								HeightRequestEx="42"
								IsVisible="{Binding IsReadOnly}"
								Text="✎ Измени податоци" />
						</HorizontalStackLayout>
						<!--  ═══════════════════════════════════════════════════  -->
