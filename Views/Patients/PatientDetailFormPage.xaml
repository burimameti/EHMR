<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Patients.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dto="clr-namespace:EHMR.Services.Dto"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientDetailFormViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<converters:EncounterStatusToTextConverter x:Key="StatusTextConverter" />
			<converters:EncounterStatusToColorConverter x:Key="StatusColorConverter" />
			<converters:EncounterStatusToBgConverter x:Key="StatusBgConverter" />
			<converters:DocumentIsImageConverter x:Key="DocumentIsImageConverter" />

			<!--  ═══ СТИЛОВИ ЗА ОВАА СТРАНА ═══  -->

			<Style x:Key="SectionHeaderStyle" TargetType="controls:CrudSectionHeader">


				<Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
				<Setter Property="TextColor" Value="{StaticResource Gray800}" />
			</Style>

			<Style x:Key="FieldEntryStyle" TargetType="Entry">
				<Setter Property="BackgroundColor" Value="Transparent" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="ReadHintStyle" TargetType="Label">
				<Setter Property="FontSize" Value="11" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="ReadValueBoldStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="SubLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="10" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<!--  ═══ ТАБЕЛИ НА ЛЕКОВИ ═══  -->

			<Style x:Key="TableFrameStyle" TargetType="Border">
				<Setter Property="Padding" Value="0" />
				<Setter Property="BackgroundColor" Value="White" />
				<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="1" />
			</Style>

			<Style x:Key="TableHeaderLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="9" />
				<Setter Property="LineBreakMode" Value="TailTruncation" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

			<Style x:Key="TableCellLabelStyle" TargetType="Label">
				<Setter Property="FontSize" Value="11" />
				<Setter Property="LineBreakMode" Value="TailTruncation" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

			<Style x:Key="TableCellEntryStyle" TargetType="Entry">
				<Setter Property="BackgroundColor" Value="Transparent" />
				<Setter Property="FontSize" Value="11" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

			<Style x:Key="TableIconStyle" TargetType="Label">
				<Setter Property="FontFamily" Value="FASolid" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalOptions" Value="Center" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>
			<Style x:Key="SectionCardStyle" TargetType="Border">
				<Setter Property="Padding" Value="14" />
				<Setter Property="BackgroundColor" Value="#F8FAFC" />
				<Setter Property="Stroke" Value="#DCE3EA" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
				<Setter Property="StrokeThickness" Value="1" />
			</Style>
			<!--  ═══ ШАБЛОНИ ЗА ИСТОРИЈА НА ПАЦИЕНТОТ ═══  -->

			<DataTemplate x:Key="PatientDiagnosisRowTemplate" x:DataType="dto:DiagnosisDto">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontFamily="Consolas"
							FontSize="12"
							Text="{Binding Mkb10Code}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding Mkb10Description}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientEncounterRowTemplate" x:DataType="entities:Encounter">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Border
							Grid.Column="2"
							Padding="6,2"
							BackgroundColor="{Binding Status, Converter={StaticResource StatusBgConverter}}"
							StrokeShape="RoundRectangle 4"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="10"
								Text="{Binding Status, Converter={StaticResource StatusTextConverter}}"
								TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
						</Border>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientAppointmentRowTemplate" x:DataType="entities:Appointment">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleRowTemplate" x:DataType="entities:TherapyCycle">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleHistoryRowTemplate" x:DataType="entities:TherapyCycle">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10"
						RowDefinitions="Auto,Auto"
						RowSpacing="3">
						<Label
							Grid.RowSpan="2"
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding DecisionText, TargetNullValue='Без внесено решение'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="2"
							FontSize="11"
							Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<HorizontalStackLayout
							Grid.Row="1"
							Grid.Column="1"
							Spacing="8">
							<Label
								FontSize="11"
								LineBreakMode="TailTruncation"
								Text="{Binding Notes, TargetNullValue='Без забелешка'}"
								TextColor="{StaticResource SparkTextSecondary}" />
							<Label
								FontSize="11"
								Text="{Binding Documents.Count, StringFormat='Документи: {0}'}"
								TextColor="{StaticResource SparkAccentTealDark}" />
						</HorizontalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientPrescriptionRowTemplate" x:DataType="entities:Prescription">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding Notes}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="260,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*,Auto"
			RowSpacing="0"
			Style="{StaticResource CrudFormPageGridStyle}">

			<!--  Header  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="{Binding HeaderTitle}" Subtitle="Преглед и управување со податоците за пациентот">
					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
							<controls:FFButton
								ButtonKind="Ghost"
								Command="{Binding CancelCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<!--  Body: формата, па историјата под неа  -->
			<Border Grid.Row="1" Style="{StaticResource CrudFormBodyGridStyle}">

				<controls:CustomScrollView x:Name="FormScrollView" ScrollBarColor="{StaticResource SparkAccentTeal}">
					<VerticalStackLayout Spacing="0">

						<!--  ╔═══════════════ ФОРМА ═══════════════╗  -->
						<controls:FFSectionCard Margin="0" Style="{StaticResource CrudFormCardStyle}">
							<VerticalStackLayout Spacing="10" Style="{StaticResource CrudFormContentStackStyle}">

								<!--  ═══ 1. ЛИЧНИ ПОДАТОЦИ ═══  -->
								<Border
									Padding="14"
									Stroke="#DCE3EA"
									StrokeShape="RoundRectangle 6"
									StrokeThickness="1"
									Style="{StaticResource SectionCardStyle}">
									<VerticalStackLayout Spacing="10">

										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
											<controls:CrudSectionHeader
												Title="ЛИЧНИ ПОДАТОЦИ"
												LineColor="{StaticResource Gray600}"
												Style="{StaticResource SectionHeaderStyle}"
												VerticalOptions="Center" />
											<controls:FFStatusChip
												Grid.Column="1"
												BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
												HorizontalOptions="End"
												Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
												TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}"
												VerticalOptions="Center" />
										</Grid>

										<Grid ColumnDefinitions="1.3*,1.3*,125,90,1*,1*" ColumnSpacing="10">

											<!--  Име  -->
											<VerticalStackLayout Grid.Column="0" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Име *" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Placeholder="Пр. Марко"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.FirstName}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Име:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.FirstName}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Презиме  -->
											<VerticalStackLayout Grid.Column="1" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Презиме *" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Placeholder="Пр. Петровски"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.LastName}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Презиме:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.LastName}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Датум на раѓање  -->
											<VerticalStackLayout Grid.Column="2" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Датум на раѓање" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Grid ColumnDefinitions="*,Auto">
														<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
														<Label Grid.Column="1" Style="{StaticResource FieldBoxCalendarIconStyle}" />
														<DatePicker
															Grid.ColumnSpan="2"
															BackgroundColor="Transparent"
															Date="{Binding Patient.BirthDate}"
															Format="dd.MM.yyyy"
															Opacity="0" />
													</Grid>
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Роден:" />
													<Border Style="{StaticResource InfoPillBorderStyle}">
														<HorizontalStackLayout Spacing="6">
															<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf073;" />
															<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
														</HorizontalStackLayout>
													</Border>
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Пол  -->
											<VerticalStackLayout Grid.Column="3" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Пол *" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Grid ColumnDefinitions="*,Auto">
														<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedGenderDisplay}" />
														<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
														<Picker
															Grid.ColumnSpan="2"
															BackgroundColor="Transparent"
															ItemsSource="{Binding GenderOptions}"
															Opacity="0"
															SelectedItem="{Binding SelectedGenderDisplay}" />
													</Grid>
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Пол:" />
													<Border Style="{StaticResource InfoPillBorderStyle}">
														<HorizontalStackLayout Spacing="6">
															<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />
															<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding SelectedGenderDisplay}" />
														</HorizontalStackLayout>
													</Border>
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  ЕЗБО  -->
											<VerticalStackLayout Grid.Column="4" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="ЕЗБО" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Placeholder="Здравствен број"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.SzboNumber}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="ЕЗБО:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.SzboNumber}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  ЕМБГ  -->
											<VerticalStackLayout
												Grid.Column="5"
												IsVisible="{Binding CanViewNationalId}"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="ЕМБГ" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														IsPassword="True"
														Placeholder="Матичен број"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.NationalId}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="ЕМБГ:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding MaskedNationalId}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

										</Grid>
									</VerticalStackLayout>
								</Border>

								<!--  ═══ 2. КОНТАКТ ИНФОРМАЦИИ ═══  -->
								<Border
									Padding="14"
									Stroke="#DCE3EA"
									StrokeShape="RoundRectangle 12"
									StrokeThickness="1"
									Style="{StaticResource SectionCardStyle}">
									<VerticalStackLayout Spacing="10">

										<controls:CrudSectionHeader
											Title="КОНТАКТ ИНФОРМАЦИИ"
											LineColor="{StaticResource Gray600}"
											Style="{StaticResource SectionHeaderStyle}"
											VerticalOptions="Center" />

										<Grid
											ColumnDefinitions="*,*,*"
											ColumnSpacing="12"
											RowDefinitions="Auto,Auto"
											RowSpacing="12">

											<!--  Телефон  -->
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="0"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Телефон" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Keyboard="Telephone"
														Placeholder="+389 7X XXX XXX"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.Phone}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Телефон:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.Phone, TargetNullValue='—'}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Е-пошта  -->
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="1"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Е-пошта" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Keyboard="Email"
														Placeholder="email@example.com"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.Email}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Е-пошта:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.Email, TargetNullValue='—'}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Град  -->
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="2"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Град" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Picker
														BackgroundColor="Transparent"
														FontSize="13"
														ItemsSource="{Binding CityOptions}"
														SelectedItem="{Binding SelectedCityDisplay}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Град:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding SelectedCityDisplay, TargetNullValue='—'}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Адреса  -->
											<VerticalStackLayout
												Grid.Row="1"
												Grid.Column="0"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Адреса" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Placeholder="Улица и број"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.Address}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Адреса:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.Address, TargetNullValue='—'}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Итен контакт  -->
											<VerticalStackLayout
												Grid.Row="1"
												Grid.Column="1"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Итен контакт" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Placeholder="Име и презиме"
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.EmergencyContactName}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Итен контакт:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.EmergencyContactName, TargetNullValue='—'}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

											<!--  Тел. на итен контакт  -->
											<VerticalStackLayout
												Grid.Row="1"
												Grid.Column="2"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Тел. на итен контакт" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														Keyboard="Telephone"
														Placeholder="+389..."
														Style="{StaticResource FieldEntryStyle}"
														Text="{Binding Patient.EmergencyContactPhone}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label Style="{StaticResource ReadHintStyle}" Text="Тел. на итен контакт:" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Patient.EmergencyContactPhone, TargetNullValue='—'}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

										</Grid>
									</VerticalStackLayout>
								</Border>

								<!--  ═══ 3. БИОЛОШКА ТЕРАПИЈА ═══  -->
								<Border
									Padding="14"
									Stroke="#DCE3EA"
									StrokeShape="RoundRectangle 12"
									StrokeThickness="1"
									Style="{StaticResource SectionCardStyle}">
									<VerticalStackLayout Spacing="14">
										<controls:CrudSectionHeader
											Title="БИОЛОШКА ТЕРАПИЈА"
											LineColor="{StaticResource Gray600}"
											Style="{StaticResource SectionHeaderStyle}"
											VerticalOptions="Center" />

										<!--  Doctor + Scores  -->
										<Grid ColumnDefinitions="*,*" ColumnSpacing="14">
											<VerticalStackLayout
												Grid.Column="0"
												Spacing="2"
												VerticalOptions="Start">

												<!--  Edit  -->
												<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="2">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="Матичен Реуматолог"
														TextColor="{StaticResource SparkTextSecondary}" />
													<controls:FFSearchBox Placeholder="Пребарај реуматолог..." Text="{Binding DoctorSearchText, Mode=TwoWay}" />

													<Border
														Padding="4"
														BackgroundColor="White"
														IsVisible="{Binding ShowDoctorDropdown}"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 8"
														StrokeThickness="0.5">
														<CollectionView
															HeightRequest="160"
															ItemsSource="{Binding DoctorSearchResults}"
															SelectionMode="None">
															<CollectionView.ItemTemplate>
																<DataTemplate x:DataType="dto:DoctorDto">
																	<Border
																		Margin="0,2"
																		Padding="8,6"
																		BackgroundColor="#F8FAFC"
																		Stroke="{StaticResource SparkBorderSubtle}"
																		StrokeShape="RoundRectangle 7"
																		StrokeThickness="1">
																		<Border.GestureRecognizers>
																			<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectDoctorCommand}" CommandParameter="{Binding .}" />
																		</Border.GestureRecognizers>
																		<VerticalStackLayout Spacing="1">
																			<Label
																				FontAttributes="Bold"
																				FontSize="11.5"
																				Text="{Binding DisplayName}"
																				TextColor="{StaticResource SparkTextPrimary}" />
																			<Label
																				FontSize="10"
																				Text="{Binding Specialty}"
																				TextColor="{StaticResource SparkTextSecondary}" />
																		</VerticalStackLayout>
																	</Border>
																</DataTemplate>
															</CollectionView.ItemTemplate>
														</CollectionView>
													</Border>

													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														IsVisible="{Binding SelectedDoctorDisplay, Converter={StaticResource StringNotEmptyConverter}}"
														Stroke="{StaticResource SparkAccentTealBg}"
														Style="{StaticResource InfoPillBorderStyle}">
														<VerticalStackLayout Padding="10,7" Spacing="1">
															<Label
																FontSize="9"
																Text="ИЗБРАН РЕУМАТОЛОГ"
																TextColor="{StaticResource SparkTextSecondary}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																LineBreakMode="TailTruncation"
																Text="{Binding SelectedDoctorDisplay}"
																TextColor="{StaticResource SparkAccentTealDark}" />
														</VerticalStackLayout>
													</Border>
												</VerticalStackLayout>

												<!--  Read-only  -->
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="Матичен Реуматолог"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding SelectedDoctorDisplay}" />
												</VerticalStackLayout>
											</VerticalStackLayout>

										</Grid>

										<!--  Outer grid: row 0 = MKB, row 1 = лекови  -->
										<Grid
											ColumnDefinitions="*,*"
											ColumnSpacing="14"
											HorizontalOptions="Fill"
											RowDefinitions="Auto,Auto"
											RowSpacing="16">

											<!--  ─── MKB ───  -->
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="0"
												Spacing="10">
												<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="5">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="МКБ СЕКЦИЈА · ЛАТИНИЦА A–Z"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Border
														Padding="6,5"
														BackgroundColor="#F4F7FA"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 9"
														StrokeThickness="1">
														<ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
															<FlexLayout
																BindableLayout.ItemsSource="{Binding MkbAlphabetSections}"
																Direction="Row"
																JustifyContent="Start"
																Wrap="NoWrap">
																<BindableLayout.ItemTemplate>
																	<DataTemplate x:DataType="viewModels:MkbAlphabetSection">
																		<Border
																			Margin="1"
																			Padding="2"
																			HeightRequest="30"
																			StrokeShape="RoundRectangle 6"
																			StrokeThickness="1"
																			WidthRequest="28">
																			<Border.Triggers>
																				<DataTrigger
																					Binding="{Binding IsSelected}"
																					TargetType="Border"
																					Value="True">
																					<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																					<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																				</DataTrigger>
																				<DataTrigger
																					Binding="{Binding IsSelected}"
																					TargetType="Border"
																					Value="False">
																					<Setter Property="BackgroundColor" Value="White" />
																					<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
																				</DataTrigger>
																			</Border.Triggers>
																			<Border.GestureRecognizers>
																				<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectMkbSectionCommand}" CommandParameter="{Binding .}" />
																			</Border.GestureRecognizers>
																			<Label
																				FontAttributes="Bold"
																				FontSize="10.5"
																				HorizontalOptions="Center"
																				Text="{Binding Letter}"
																				VerticalOptions="Center">
																				<Label.Triggers>
																					<DataTrigger
																						Binding="{Binding IsSelected}"
																						TargetType="Label"
																						Value="True">
																						<Setter Property="TextColor" Value="White" />
																					</DataTrigger>
																					<DataTrigger
																						Binding="{Binding IsSelected}"
																						TargetType="Label"
																						Value="False">
																						<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																					</DataTrigger>
																				</Label.Triggers>
																			</Label>
																		</Border>
																	</DataTemplate>
																</BindableLayout.ItemTemplate>
															</FlexLayout>
														</ScrollView>
													</Border>
												</VerticalStackLayout>

												<Grid
													ColumnDefinitions="*,*"
													ColumnSpacing="10"
													RowDefinitions="Auto,Auto,Auto"
													RowSpacing="6">

													<VerticalStackLayout
														Grid.Column="0"
														IsVisible="{Binding IsEditMode}"
														Spacing="2">
														<controls:FFSearchBox
															HorizontalOptions="Fill"
															Label="Пребарување по код"
															MinimumWidthRequest="0"
															Placeholder="M06.9"
															Text="{Binding MkbCodeSearchText, Mode=TwoWay}" />
													</VerticalStackLayout>

													<VerticalStackLayout
														Grid.Column="1"
														IsVisible="{Binding IsEditMode}"
														Spacing="2">
														<controls:FFSearchBox
															HorizontalOptions="Fill"
															Label="Пребарување по опис"
															MinimumWidthRequest="0"
															Placeholder="Опис на дијагноза"
															Text="{Binding MkbDescriptionSearchText, Mode=TwoWay}" />
													</VerticalStackLayout>

													<Border
														Grid.Row="1"
														Grid.ColumnSpan="2"
														Padding="4"
														BackgroundColor="{StaticResource White}"
														IsVisible="{Binding ShowMkbDropdown}"
														Stroke="{StaticResource SparkBorder}"
														StrokeShape="RoundRectangle 8"
														StrokeThickness="1"
														ZIndex="20">
														<CollectionView
															HeightRequest="180"
															ItemsSource="{Binding MkbResults}"
															SelectionMode="None"
															VerticalScrollBarVisibility="Always">
															<CollectionView.ItemTemplate>
																<DataTemplate x:DataType="dto:Mkb10CodeDto">
																	<Border
																		Padding="8,6"
																		BackgroundColor="{StaticResource White}"
																		Stroke="{StaticResource SparkBorderSubtle}"
																		StrokeThickness="0">
																		<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
																			<Label
																				FontAttributes="Bold"
																				FontSize="11"
																				Text="{Binding Code}"
																				TextColor="{StaticResource SparkAccentTealDark}"
																				VerticalOptions="Center" />
																			<Label
																				Grid.Column="1"
																				FontSize="11"
																				LineBreakMode="WordWrap"
																				Text="{Binding Description}"
																				TextColor="{StaticResource SparkTextPrimary}"
																				VerticalOptions="Center" />
																		</Grid>
																		<Border.GestureRecognizers>
																			<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
																		</Border.GestureRecognizers>
																	</Border>
																</DataTemplate>
															</CollectionView.ItemTemplate>
														</CollectionView>
													</Border>

													<VerticalStackLayout
														Grid.Row="2"
														Grid.ColumnSpan="2"
														BindableLayout.ItemsSource="{Binding Diagnoses}"
														Spacing="4">
														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="dto:DiagnosisDto">
																<Border
																	Padding="10,7"
																	BackgroundColor="{StaticResource SparkTabActiveBg}"
																	Stroke="{StaticResource SparkBorderSubtle}"
																	StrokeShape="RoundRectangle 8"
																	StrokeThickness="1">
																	<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
																		<Label
																			FontAttributes="Bold"
																			FontSize="11.5"
																			Text="{Binding Mkb10Code, TargetNullValue='—'}"
																			TextColor="{StaticResource SparkAccentTealDark}"
																			VerticalOptions="Center" />
																		<Label
																			Grid.Column="1"
																			FontSize="11.5"
																			LineBreakMode="WordWrap"
																			Text="{Binding Mkb10Description, TargetNullValue='—'}"
																			TextColor="{StaticResource SparkTextPrimary}"
																			VerticalOptions="Center" />
																		<Label
																			Grid.Column="2"
																			FontFamily="FASolid"
																			FontSize="10"
																			IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																			Text="&#xf1f8;"
																			TextColor="#DC2626"
																			VerticalOptions="Center">
																			<Label.GestureRecognizers>
																				<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}" CommandParameter="{Binding .}" />
																			</Label.GestureRecognizers>
																		</Label>
																	</Grid>
																</Border>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</VerticalStackLayout>
												</Grid>
											</VerticalStackLayout>

											<!--  ─── СКОРОВИ (десно од МКБ) ───  -->
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="1"
												Spacing="8"
												VerticalOptions="Start">
												<controls:CrudSectionHeader
													Title=""
													LineColor="{StaticResource White}"
													Style="{StaticResource SectionHeaderStyle}" />
												<controls:ScoreEditor BindingContext="{Binding ScoreEditor}" />
											</VerticalStackLayout>

											<!--<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="1"
												Spacing="8"
												VerticalOptions="Start">
												<controls:CrudSectionHeader
													Title=""
													LineColor="{StaticResource White}"
													Style="{StaticResource SectionHeaderStyle}" />
												<controls:ScoreEditor BindingContext="{Binding ScoreEditor}" />
											</VerticalStackLayout>-->

											<!--  ─── АКТИВНИ | НЕАКТИВНИ ЛЕКОВИ (една линија) ───  -->
											<Grid
												Grid.Row="1"
												Grid.Column="0"
												Grid.ColumnSpan="2"
												ColumnDefinitions="*,*"
												ColumnSpacing="14"
												RowDefinitions="Auto,Auto,Auto"
												RowSpacing="8">

												<!--  Row 0: наслови  -->
												<Grid
													Grid.Row="0"
													Grid.Column="0"
													ColumnDefinitions="*,Auto"
													HeightRequest="34">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="АКТИВНИ ЛЕКОВИ"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
													<controls:FFButton
														Grid.Column="1"
														ButtonKind="Primary"
														Command="{Binding AddApplicationRegimeCommand}"
														HeightRequestEx="34"
														IsVisible="{Binding IsEditMode}"
														Text="+ Нов режим"
														WidthRequestEx="116" />
												</Grid>
												<Grid
													Grid.Row="0"
													Grid.Column="1"
													HeightRequest="34">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="НЕАКТИВНИ ЛЕКОВИ"
														TextColor="{StaticResource SparkTextSecondary}"
														VerticalOptions="Center" />
												</Grid>

												<!--  Row 1: пребарување лек (само активни)  -->
												<VerticalStackLayout
													Grid.Row="1"
													Grid.Column="0"
													IsVisible="{Binding IsEditMode}"
													Spacing="4">
													<controls:FFSearchBox Placeholder="Додај лек во активна терапија..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />
													<Border
														Padding="4"
														BackgroundColor="White"
														IsVisible="{Binding ShowMedicineDropdown}"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 8"
														StrokeThickness="1">
														<CollectionView
															HeightRequest="140"
															ItemsSource="{Binding MedicineResults}"
															SelectionMode="None">
															<CollectionView.ItemTemplate>
																<DataTemplate x:DataType="dto:MedicineDto">
																	<Border
																		Padding="9,6"
																		BackgroundColor="Transparent"
																		StrokeThickness="0">
																		<Border.GestureRecognizers>
																			<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
																		</Border.GestureRecognizers>
																		<VerticalStackLayout Spacing="1">
																			<Label
																				FontAttributes="Bold"
																				FontSize="11.5"
																				Text="{Binding Name}"
																				TextColor="{StaticResource SparkAccentTealDark}" />
																			<Label
																				FontSize="10"
																				Text="{Binding GenericName}"
																				TextColor="{StaticResource SparkTextSecondary}" />
																		</VerticalStackLayout>
																	</Border>
																</DataTemplate>
															</CollectionView.ItemTemplate>
														</CollectionView>
													</Border>
												</VerticalStackLayout>

												<!--  Row 2 лево: АКТИВНИ  -->
												<Border
													Grid.Row="2"
													Grid.Column="0"
													Style="{StaticResource TableFrameStyle}"
													VerticalOptions="Start">
													<VerticalStackLayout Spacing="0">

														<Grid
															Padding="10,8"
															BackgroundColor="{StaticResource SparkSurfaceAlt}"
															ColumnDefinitions="1.3*,1.1*,0.9*,0.6*,64,64"
															ColumnSpacing="8">
															<Label
																Grid.Column="0"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="ЛЕК" />
															<Label
																Grid.Column="1"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="РЕЖИМ" />
															<Label
																Grid.Column="2"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="ДОЗА" />
															<Label
																Grid.Column="3"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="КОЛ." />
															<Label
																Grid.Column="4"
																HorizontalTextAlignment="Center"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="РЕШЕНИЕ" />
															<Label
																Grid.Column="5"
																HorizontalTextAlignment="Center"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="АКЦИИ" />
														</Grid>

														<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachedMedicines}" Spacing="0">
															<BindableLayout.EmptyView>
																<Label
																	Padding="12"
																	FontSize="11"
																	HorizontalOptions="Center"
																	Text="Нема активни лекови."
																	TextColor="{StaticResource SparkTextMuted}" />
															</BindableLayout.EmptyView>
															<BindableLayout.ItemTemplate>
																<DataTemplate x:DataType="viewModels:AttachedMedicineRow">
																	<Grid RowDefinitions="Auto,1">
																		<Grid
																			Padding="10,6"
																			ColumnDefinitions="1.3*,1.1*,0.9*,0.6*,64,64"
																			ColumnSpacing="8">
																			<Label
																				Grid.Column="0"
																				Style="{StaticResource TableCellLabelStyle}"
																				Text="{Binding MedicineNameBilingual}" />
																			<controls:FFPicker
																				Grid.Column="1"
																				ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}"
																				Placeholder="Избери"
																				SelectedItem="{Binding PatientMedicine.ApplicationRegime, Mode=TwoWay}"
																				VerticalOptions="Center" />
																			<Label
																				Grid.Column="2"
																				Style="{StaticResource TableCellLabelStyle}"
																				Text="{Binding DefaultDosage}" />
																			<Entry
																				Grid.Column="3"
																				IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																				Keyboard="Numeric"
																				Style="{StaticResource TableCellEntryStyle}"
																				Text="{Binding PatientMedicine.Quantity, Mode=TwoWay}" />

																			<!--  Решение  -->
																			<HorizontalStackLayout
																				Grid.Column="4"
																				HorizontalOptions="Center"
																				Spacing="12"
																				VerticalOptions="Center">
																				<Label
																					IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																					Style="{StaticResource TableIconStyle}"
																					Text="&#xf093;"
																					TextColor="#DC2626">
																					<Label.Triggers>
																						<DataTrigger
																							Binding="{Binding HasResolution}"
																							TargetType="Label"
																							Value="True">
																							<Setter Property="TextColor" Value="{StaticResource SparkAccentTealDark}" />
																						</DataTrigger>
																					</Label.Triggers>
																					<Label.GestureRecognizers>
																						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.UploadMedicineResolutionCommand}" CommandParameter="{Binding .}" />
																					</Label.GestureRecognizers>
																				</Label>
																				<Label
																					IsVisible="{Binding HasResolution}"
																					Style="{StaticResource TableIconStyle}"
																					Text="&#xf06e;"
																					TextColor="{StaticResource SparkAccentTealDark}">
																					<Label.GestureRecognizers>
																						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding PatientMedicine.ResolutionDocument}" />
																					</Label.GestureRecognizers>
																				</Label>
																			</HorizontalStackLayout>

																			<!--  Акции  -->
																			<HorizontalStackLayout
																				Grid.Column="5"
																				HorizontalOptions="Center"
																				IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																				Spacing="12"
																				VerticalOptions="Center">
																				<Label
																					Style="{StaticResource TableIconStyle}"
																					Text="&#xf04c;"
																					TextColor="{StaticResource SparkTextSecondary}">
																					<Label.GestureRecognizers>
																						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.MoveMedicineToInactiveCommand}" CommandParameter="{Binding .}" />
																					</Label.GestureRecognizers>
																				</Label>
																				<Label
																					IsEnabled="{Binding CanDelete}"
																					Style="{StaticResource TableIconStyle}"
																					Text="&#xf1f8;"
																					TextColor="#DC2626">
																					<Label.Triggers>
																						<DataTrigger
																							Binding="{Binding CanDelete}"
																							TargetType="Label"
																							Value="False">
																							<Setter Property="Opacity" Value="0.3" />
																						</DataTrigger>
																					</Label.Triggers>
																					<Label.GestureRecognizers>
																						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}" />
																					</Label.GestureRecognizers>
																				</Label>
																			</HorizontalStackLayout>
																		</Grid>
																		<BoxView
																			Grid.Row="1"
																			HeightRequest="1"
																			Color="{StaticResource SparkBorderSubtle}" />
																	</Grid>
																</DataTemplate>
															</BindableLayout.ItemTemplate>
														</VerticalStackLayout>
													</VerticalStackLayout>
												</Border>

												<!--  Row 2 десно: НЕАКТИВНИ  -->
												<Border
													Grid.Row="2"
													Grid.Column="1"
													Style="{StaticResource TableFrameStyle}"
													VerticalOptions="Start">
													<VerticalStackLayout Spacing="0">

														<Grid
															Padding="10,8"
															BackgroundColor="{StaticResource SparkSurfaceAlt}"
															ColumnDefinitions="1.3*,1.1*,0.9*,0.6*,64,64"
															ColumnSpacing="8">
															<Label
																Grid.Column="0"
																Margin="10,0,0,0"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="ЛЕК" />
															<Label
																Grid.Column="1"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="РЕЖИМ" />
															<Label
																Grid.Column="2"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="ДОЗА" />
															<Label
																Grid.Column="3"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="КОЛ." />
															<Label
																Grid.Column="4"
																HorizontalTextAlignment="Center"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="РЕШЕНИЕ" />
															<Label
																Grid.Column="5"
																HorizontalTextAlignment="Center"
																Style="{StaticResource TableHeaderLabelStyle}"
																Text="АКЦИИ" />
														</Grid>

														<VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviousMedicines}" Spacing="0">
															<BindableLayout.EmptyView>
																<Label
																	Padding="12"
																	FontSize="11"
																	HorizontalOptions="Center"
																	Text="Нема неактивни лекови."
																	TextColor="{StaticResource SparkTextMuted}" />
															</BindableLayout.EmptyView>
															<BindableLayout.ItemTemplate>
																<DataTemplate x:DataType="viewModels:PreviousMedicineRow">
																	<Grid RowDefinitions="Auto,1">
																		<Grid
																			Padding="10,6"
																			ColumnDefinitions="1.3*,1.1*,0.9*,0.6*,64,64"
																			ColumnSpacing="8">
																			<Label
																				Grid.Column="0"
																				Style="{StaticResource TableCellLabelStyle}"
																				Text="{Binding MedicineNameBilingual}" />
																			<controls:FFPicker
																				Grid.Column="1"
																				ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}"
																				Placeholder="Избери"
																				SelectedItem="{Binding PatientMedicine.ApplicationRegime, Mode=TwoWay}"
																				VerticalOptions="Center" />
																			<Label
																				Grid.Column="2"
																				Style="{StaticResource TableCellLabelStyle}"
																				Text="{Binding DefaultDosage}" />
																			<Entry
																				Grid.Column="3"
																				IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																				Keyboard="Numeric"
																				Style="{StaticResource TableCellEntryStyle}"
																				Text="{Binding PatientMedicine.Quantity, Mode=TwoWay}" />

																			<HorizontalStackLayout
																				Grid.Column="4"
																				HorizontalOptions="Center"
																				Spacing="12"
																				VerticalOptions="Center">
																				<Label
																					IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																					Style="{StaticResource TableIconStyle}"
																					Text="&#xf093;"
																					TextColor="#DC2626">
																					<Label.Triggers>
																						<DataTrigger
																							Binding="{Binding HasResolution}"
																							TargetType="Label"
																							Value="True">
																							<Setter Property="TextColor" Value="{StaticResource SparkAccentTealDark}" />
																						</DataTrigger>
																					</Label.Triggers>
																					<Label.GestureRecognizers>
																						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.UploadMedicineResolutionCommand}" CommandParameter="{Binding .}" />
																					</Label.GestureRecognizers>
																				</Label>
																				<Label
																					IsVisible="{Binding HasResolution}"
																					Style="{StaticResource TableIconStyle}"
																					Text="&#xf06e;"
																					TextColor="{StaticResource SparkAccentTealDark}">
																					<Label.GestureRecognizers>
																						<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding PatientMedicine.ResolutionDocument}" />
																					</Label.GestureRecognizers>
																				</Label>
																			</HorizontalStackLayout>

																			<Label
																				Grid.Column="5"
																				IsEnabled="{Binding CanDelete}"
																				IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																				Style="{StaticResource TableIconStyle}"
																				Text="&#xf1f8;"
																				TextColor="#DC2626">
																				<Label.Triggers>
																					<DataTrigger
																						Binding="{Binding CanDelete}"
																						TargetType="Label"
																						Value="False">
																						<Setter Property="Opacity" Value="0.3" />
																					</DataTrigger>
																				</Label.Triggers>
																				<Label.GestureRecognizers>
																					<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemovePreviousMedicineCommand}" CommandParameter="{Binding .}" />
																				</Label.GestureRecognizers>
																			</Label>
																		</Grid>
																		<BoxView
																			Grid.Row="1"
																			HeightRequest="1"
																			Color="{StaticResource SparkBorderSubtle}" />
																	</Grid>
																</DataTemplate>
															</BindableLayout.ItemTemplate>
														</VerticalStackLayout>
													</VerticalStackLayout>
												</Border>
											</Grid>

										</Grid>
									</VerticalStackLayout>
								</Border>

								<!--  ═══ 4. ДОСИЕ | СТАТУС НА ПАЦИЕНТ | ЗАБЕЛЕШКА ═══  -->
								<Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">

									<!--  ДОСИЕ  -->
									<VerticalStackLayout Grid.Column="0" Spacing="10">
										<controls:CrudSectionHeader
											Title="ПРИКАЧИ ДРУГА ДОКУМЕНТАЦИЈА ЗА ПАЦИЕНТОТ"
											LineColor="{StaticResource White}"
											Style="{StaticResource SectionHeaderStyle}" />
										<Border
											Padding="14"
											BackgroundColor="White"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<VerticalStackLayout Spacing="12">
												<Grid
													ColumnDefinitions="Аuto,Auto"
													ColumnSpacing="10"
													IsVisible="{Binding IsEditMode}">

													<controls:FFButton
														ButtonKind="Secondary"
														Command="{Binding UploadDocumentCommand}"
														ContentPadding="10,0"
														HeightRequestEx="36"
														IsEnabled="{Binding IsUploadingDocument, Converter={StaticResource InvertedBoolConverter}}"
														Text="📎 Прикачи документ" />
													<Label
														Grid.Column="1"
														FontSize="12"
														Text="{Binding Documents.Count, StringFormat='Вкупно документи: {0}'}"
														TextColor="{StaticResource SparkTextSecondary}"
														VerticalOptions="Center" />
													<ActivityIndicator
														Grid.Column="1"
														IsRunning="{Binding IsUploadingDocument}"
														IsVisible="{Binding IsUploadingDocument}"
														Color="{StaticResource SparkAccentTeal}" />
												</Grid>
												<CollectionView ItemsSource="{Binding Documents}" SelectionMode="None">

													<CollectionView.ItemTemplate>
														<DataTemplate x:DataType="dto:PatientDocumentDto">
															<Border
																Margin="0,0,0,8"
																Padding="10,8"
																BackgroundColor="{StaticResource SparkTabActiveBg}"
																Stroke="{StaticResource SparkBorderSubtle}"
																StrokeShape="RoundRectangle 10"
																StrokeThickness="1">
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
																</Border.GestureRecognizers>
																<Grid ColumnDefinitions="42,*,Auto,Auto" ColumnSpacing="12">
																	<Border
																		BackgroundColor="{StaticResource SparkAccentTealBg}"
																		HeightRequest="40"
																		StrokeShape="RoundRectangle 8"
																		StrokeThickness="0"
																		WidthRequest="36">
																		<Grid>
																			<Image
																				Aspect="AspectFill"
																				IsVisible="{Binding ., Converter={StaticResource DocumentIsImageConverter}}"
																				Source="{Binding StoredPath}" />
																			<Label
																				FontFamily="FASolid"
																				FontSize="14"
																				HorizontalOptions="Center"
																				IsVisible="{Binding ., Converter={StaticResource DocumentIsImageConverter}, ConverterParameter=Invert}"
																				Text="&#xf15b;"
																				TextColor="{StaticResource SparkAccentTealDark}"
																				VerticalOptions="Center" />
																		</Grid>
																	</Border>
																	<VerticalStackLayout
																		Grid.Column="1"
																		Spacing="2"
																		VerticalOptions="Center">
																		<Label
																			FontAttributes="Bold"
																			FontSize="13"
																			LineBreakMode="TailTruncation"
																			Text="{Binding Title}"
																			TextColor="{StaticResource SparkTextPrimary}" />
																		<Label
																			FontSize="11"
																			LineBreakMode="TailTruncation"
																			Text="{Binding FileName}"
																			TextColor="{StaticResource SparkTextSecondary}" />
																		<Label
																			FontSize="10"
																			Text="{Binding UploadedAt, StringFormat='Прикачен: {0:dd.MM.yyyy HH:mm}'}"
																			TextColor="{StaticResource SparkTextSecondary}" />
																	</VerticalStackLayout>
																	<controls:FFButton
																		Grid.Column="2"
																		ButtonKind="Secondary"
																		Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DownloadDocumentCommand}"
																		CommandParameter="{Binding .}"
																		HeightRequestEx="32"
																		Text="Преземи"
																		WidthRequestEx="82" />
																	<Label
																		Grid.Column="3"
																		FontFamily="FASolid"
																		FontSize="14"
																		IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																		Text="&#xf1f8;"
																		TextColor="#DC2626"
																		VerticalOptions="Center">
																		<Label.GestureRecognizers>
																			<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDocumentCommand}" CommandParameter="{Binding .}" />
																		</Label.GestureRecognizers>
																	</Label>
																</Grid>
															</Border>
														</DataTemplate>
													</CollectionView.ItemTemplate>
												</CollectionView>
											</VerticalStackLayout>
										</Border>
									</VerticalStackLayout>

									<!--  СТАТУС НА ПАЦИЕНТ  -->
									<VerticalStackLayout Grid.Column="1" Spacing="10">
										<controls:CrudSectionHeader
											Title="СТАТУС НА ПАЦИЕНТ"
											LineColor="{StaticResource White}"
											Style="{StaticResource SectionHeaderStyle}" />

										<HorizontalStackLayout HorizontalOptions="Start" Spacing="28">
											<VerticalStackLayout IsVisible="{Binding CanShowActiveStatusOption}" Spacing="2">
												<Label
													FontAttributes="Bold"
													FontSize="11"
													Text="Активен"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<HorizontalStackLayout Spacing="4">
													<HorizontalStackLayout.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding SetActiveCommand}" />
													</HorizontalStackLayout.GestureRecognizers>
													<CheckBox
														IsChecked="{Binding IsPatientActive, Mode=OneWay}"
														IsEnabled="False"
														Color="{StaticResource SparkAccentTeal}" />
												</HorizontalStackLayout>
												<Label
													FontSize="10"
													IsVisible="{Binding CanReactivatePatient}"
													Text="Администратор"
													TextColor="{StaticResource SparkTextSecondary}" />
											</VerticalStackLayout>
											<VerticalStackLayout Spacing="2">
												<Label
													FontAttributes="Bold"
													FontSize="11"
													Text="Неактивен"
													TextColor="#DC2626" />
												<HorizontalStackLayout Spacing="4">
													<HorizontalStackLayout.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding SetInactiveCommand}" />
													</HorizontalStackLayout.GestureRecognizers>
													<CheckBox
														IsChecked="{Binding IsPatientInactive, Mode=OneWay}"
														IsEnabled="False"
														Color="#DC2626" />
												</HorizontalStackLayout>
											</VerticalStackLayout>
										</HorizontalStackLayout>

										<BoxView HeightRequest="1" Color="{StaticResource SparkBorderSubtle}" />

										<VerticalStackLayout IsVisible="{Binding IsPatientInactive}" Spacing="8">
											<controls:CrudSectionHeader
												Title="НЕАКТИВЕН ПАЦИЕНТ"
												LineColor="#FCA5A5"
												TextColor="#B91C1C" />
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Причина за неактивност *" />
											<Border IsEnabled="{Binding IsEditMode}" Style="{StaticResource TextAreaFieldBoxStyle}">
												<Editor
													AutoSize="TextChanges"
													FontSize="13"
													Placeholder="Внесете причина..."
													Text="{Binding InactiveReason, Mode=TwoWay}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
											<controls:FFButton
												ButtonKind="Secondary"
												Command="{Binding UploadDocumentCommand}"
												HeightRequestEx="36"
												IsVisible="{Binding IsEditMode}"
												Text="📎 Прикачи решение за неактивност" />
										</VerticalStackLayout>
									</VerticalStackLayout>

									<!--  ЗАБЕЛЕШКА  -->
									<VerticalStackLayout Grid.Column="2" Spacing="10">
										<controls:CrudSectionHeader
											Title="ЗАБЕЛЕШКА"
											LineColor="{StaticResource White}"
											Style="{StaticResource SectionHeaderStyle}" />
										<Border IsEnabled="{Binding IsEditMode}" Style="{StaticResource TextAreaFieldBoxStyle}">
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Забелешка за пациентот..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.Allergies}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</VerticalStackLayout>

								</Grid>

							</VerticalStackLayout>
						</controls:FFSectionCard>

						<!--  ╔═══════════ ИСТОРИЈА НА ПАЦИЕНТОТ ═══════════╗  -->
						<controls:FFSectionCard Margin="0" Style="{StaticResource CrudFormCardStyle}">
							<VerticalStackLayout Style="{StaticResource CrudFormSidebarStackStyle}">

								<controls:CrudSectionHeader
									Title="ИСТОРИЈА НА ПАЦИЕНТОТ"
									LineColor="{StaticResource White}"
									Style="{StaticResource SectionHeaderStyle}" />

								<FlexLayout
									AlignItems="Start"
									Direction="Row"
									Wrap="Wrap">
									<controls:SparkExpandableCard
										Title="Прегледи"
										Margin="0,0,10,10"
										EmptyViewText="Нема евидентирани прегледи."
										FlexLayout.Basis="280"
										FlexLayout.Grow="1"
										ItemTemplate="{StaticResource PatientEncounterRowTemplate}"
										ItemsSource="{Binding EncounterHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Encounter" />
									<controls:SparkExpandableCard
										Title="Термини"
										Margin="0,0,10,10"
										EmptyViewText="Нема закажани термини."
										FlexLayout.Basis="280"
										FlexLayout.Grow="1"
										ItemTemplate="{StaticResource PatientAppointmentRowTemplate}"
										ItemsSource="{Binding AppointmentHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Appointment" />
									<controls:SparkExpandableCard
										Title="Дијагнози"
										Margin="0,0,0,10"
										EmptyViewText="Нема евидентирани дијагнози."
										FlexLayout.Basis="280"
										FlexLayout.Grow="1"
										ItemTemplate="{StaticResource PatientDiagnosisRowTemplate}"
										ItemsSource="{Binding DiagnosisHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Diagnosis" />
								</FlexLayout>

							</VerticalStackLayout>
						</controls:FFSectionCard>

					</VerticalStackLayout>
				</controls:CustomScrollView>
			</Border>

			<!--  Footer  -->
			<Border
				Grid.Row="2"
				Margin="16,10,16,16"
				Padding="16,10"
				BackgroundColor="White"
				Stroke="{StaticResource SparkBorderSubtle}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
					<Label
						FontAttributes="Bold"
						FontSize="10"
						IsVisible="{Binding HasMissingMedicineResolutions}"
						Text="За секој активен или неактивен лек мора да биде внесено решение пред зачувување."
						TextColor="#DC2626"
						VerticalOptions="Center" />
					<controls:FFButton
						Grid.Column="1"
						ButtonKind="Secondary"
						Command="{Binding CancelCommand}"
						HeightRequestEx="42"
						IsVisible="{Binding IsEditMode}"
						Text="Откажи"
						WidthRequestEx="130" />
					<controls:FFButton
						Grid.Column="2"
						BackgroundColorEx="{StaticResource SparkStatusSuccessText}"
						ButtonKind="Primary"
						Command="{Binding SaveCommand}"
						HeightRequestEx="42"
						IsEnabled="{Binding CanSavePatientForm}"
						IsVisible="{Binding IsEditMode}"
						Text="Зачувај"
						TextColorEx="White"
						WidthRequestEx="130" />
					<controls:FFButton
						Grid.Column="2"
						BackgroundColorEx="{StaticResource SidebarActiveBg}"
						ButtonKind="Primary"
						Command="{Binding ToggleEditModeCommand}"
						HeightRequestEx="42"
						IsEnabled="{Binding CanEditPatient}"
						IsVisible="{Binding IsReadOnly}"
						Text="Уреди"
						TextColorEx="{StaticResource SidebarActiveText}"
						WidthRequestEx="130" />
				</Grid>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
