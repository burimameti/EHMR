								</Grid>
								<CollectionView HeightRequest="150" IsVisible="{Binding ShowMkbDropdown}" ItemsSource="{Binding MkbResults}" SelectionMode="None">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="dto:Mkb10CodeDto">
											<Border Margin="0,2" Padding="8" BackgroundColor="{StaticResource SparkTabActiveBg}" StrokeShape="RoundRectangle 8" StrokeThickness="0">
												<Border.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
												</Border.GestureRecognizers>
												<VerticalStackLayout Spacing="1">
													<Label FontAttributes="Bold" FontSize="12" Text="{Binding Code}" TextColor="{StaticResource SparkAccentTealDark}" />
													<Label FontSize="11" Text="{Binding Description}" TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
											</Border>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>
							<FlexLayout BindableLayout.ItemsSource="{Binding Diagnoses}" Direction="Row" JustifyContent="Start" Wrap="Wrap">
