<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:DataType="viewModels:PatientDetailFormViewModel">

	<!--  Главен контејнер со темна позадина  -->
	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="20">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->

			<Border
				Padding="28"
				BackgroundColor="{StaticResource SparkBackground}"
				Stroke="{StaticResource SparkBorder}"
				StrokeShape="RoundRectangle 0">

				<Grid ColumnDefinitions="Auto,*,440">


					<VerticalStackLayout
						Grid.Column="1"
						Spacing="6"
						VerticalOptions="Center">

						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding HeaderTitle}"
							TextColor="{StaticResource SparkTextPrimary}" />

						<Label
							FontSize="14"
							Text="{Binding HeaderSubtitle}"
							TextColor="{StaticResource SparkTextSecondary}" />

						<HorizontalStackLayout Margin="0,12,0,0" Spacing="10">

							<controls:FFStatusChip
								BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
								Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
								TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}" />

							<Border
								Padding="10,4"
								BackgroundColor="#EDF7F9"
								StrokeShape="RoundRectangle 0"
								StrokeThickness="0">

								<HorizontalStackLayout Spacing="6">

									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf0f8;"
										TextColor="{StaticResource SparkAccentTeal}" />

									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="{Binding Patient.NationalId}"
										TextColor="{StaticResource SparkTextPrimary}" />

								</HorizontalStackLayout>

							</Border>

						</HorizontalStackLayout>

					</VerticalStackLayout>


					<!--  =================================================  -->
					<!--  ACTIONS  -->
					<!--  =================================================  -->

					<HorizontalStackLayout Grid.Column="2" Margin="0,0,0,0">

						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							HeightRequestEx="36"
							IsVisible="{Binding IsEditMode}"
							Text="💾 Зашувај Промени"
							WidthRequest="200" />

						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							HeightRequestEx="36"
							IsVisible="{Binding IsEditMode}"
							Text="Октажи"
							TextColorEx="White"
							WidthRequest="200" />

						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding ToggleEditModeCommand}"
							HeightRequestEx="36"
							IsVisible="{Binding IsReadOnly}"
							Text="✎ Промени"
							TextColorEx="White"
							WidthRequest="200" />

					</HorizontalStackLayout>

				</Grid>

			</Border>

			<!--  =========================================================  -->
			<!--  NAVIGATION — underline tab style  -->
			<!--  =========================================================  -->

			<!--  =========================================================  -->
			<!--  NAVIGATION — underline tab style  -->
			<!--  =========================================================  -->

			<Border
				Grid.Row="1"
				Padding="0"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeThickness="0">

				<VerticalStackLayout Spacing="0">

					<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="0">

						<!--  PERSONAL  -->
						<Grid
							Grid.Column="0"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab1Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="1" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf007;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Лични податоци"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

						<!--  MEDICAL  -->
						<Grid
							Grid.Column="1"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab2Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="2" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf0f1;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Медицински податоци"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

						<!--  CONTACT  -->
						<Grid
							Grid.Column="2"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab3Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="3" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf095;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Контакт информации"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

						<!--  SYSTEM  -->
						<Grid
							Grid.Column="3"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab4Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="4" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf05a;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Системски референци"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

					</Grid>

					<!--  Bottom divider under whole tab bar  -->
					<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

				</VerticalStackLayout>

			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =====================================================  -->
			<Border
				Grid.Row="2"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 1"
				StrokeThickness="0">
				<ScrollView>
					<VerticalStackLayout Padding="32" Spacing="24">

						<!--  ============================================  -->
						<!--  TAB 1 — ЛИЧНИ ПОДАТОЦИ  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab1Active}" Spacing="20">

							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ОСНОВНИ ИНФОРМАЦИИ"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />
							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="22">
								<Grid
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Име *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. Марко"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.FirstName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Презиме *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. Петровски"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.LastName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<!--  ЕМБГ  -->
								<Grid
									Grid.Column="2"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="ЕМБГ *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Numeric"
											MaxLength="13"
											Placeholder="Внесете 13 цифри"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.NationalId}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />
							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="30">
								<Grid
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Бр. на осигурување"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="МК-000000"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.SSN}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Датум на раѓање"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Grid>
											<DatePicker
												BackgroundColor="Transparent"
												Date="{Binding Patient.BirthDate}"
												Format="dd.MM.yyyy"
												HorizontalOptions="Start"
												IsVisible="{Binding IsEditMode}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center"
												WidthRequest="150" />
											<Label
												FontSize="13"
												IsVisible="{Binding IsReadOnly}"
												Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Grid>
									</Border>
								</Grid>
								<Grid
									Grid.Column="3"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Пол *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="14,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding SelectedGenderDisplay}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												IsEnabled="{Binding IsEditMode}"
												ItemsSource="{Binding GenderOptions}"
												Opacity="0"
												SelectedItem="{Binding SelectedGenderDisplay}" />
										</Grid>
									</Border>
								</Grid>
							</Grid>

							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="КОНТАКТ ИНФОРМАЦИИ"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />
							<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
								<Grid
									Grid.Column="0"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Телефон *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Phone}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Е-пошта *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Email"
											Placeholder="example@domain.com"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Email}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />
							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="55">

								<!--  ГРАД  -->
								<Grid
									Grid.Column="0"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Град"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="14,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding Patient.City}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												IsEnabled="{Binding IsEditMode}"
												ItemsSource="{Binding CityOptions}"
												Opacity="0"
												SelectedItem="{Binding Patient.City}" />
										</Grid>
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Адреса"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Улица и број"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Address}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<!--  ПОШТЕНСКИ БРОЈ  -->
								<Grid
									Grid.Column="2"
									ColumnDefinitions="75,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Поштенски број"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. 1000, 4AAB300"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.PostalCode}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />

							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="СТАТУС ДОСИЕ И МАТИЧЕН ЛЕКАР"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />
							<Grid ColumnDefinitions="*,*">
								<Grid
									ColumnDefinitions="200,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Статус на досие"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="6,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Picker
											BackgroundColor="Transparent"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											ItemsSource="{Binding StatusOptions}"
											SelectedItem="{Binding SelectedStatusDisplay}"
											TextColor="{StaticResource SparkTextPrimary}"
											TitleColor="{StaticResource SparkTextSecondary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="200,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										Margin="120,0,0,0"
										FontAttributes="Bold"
										FontSize="13"
										Text="Матичен лекар"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="6,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											Text="Матичен лекар"
											TextColor="{StaticResource SparkTextSecondary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>

						</VerticalStackLayout>

						<!--  ============================================  -->
						<!--  TAB 2 — МЕДИЦИНСКИ ПОДАТОЦИ  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab2Active}" Spacing="24">
							<VerticalStackLayout Spacing="12">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="ОСИГУРУВАЊЕ ИЛИ ПОЛИСА"
									TextColor="{StaticResource SparkTextPrimary}" />
								<BoxView
									Margin="0,10"
									HeightRequest="1"
									Color="{StaticResource SparkBorder}" />
								<Grid ColumnDefinitions="*,*">
									<VerticalStackLayout
										Grid.Column="0"
										MinimumWidthRequest="300"
										Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Број на осигуреник / или полиса"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Border
											Padding="12,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="1">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												IsReadOnly="{Binding IsReadOnly}"
												Placeholder="МК-0001-2024"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.SSN}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Column="1"
										HorizontalOptions="Start"
										Spacing="8">
										<Label
											CharacterSpacing="1"
											FontAttributes="Bold"
											FontSize="13"
											Text="КРВНА ГРУПА"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Border
											Padding="14,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="1">
											<Grid ColumnDefinitions="*,Auto" MinimumWidthRequest="300">
												<Label
													FontSize="13"
													Text="{Binding Patient.BloodType, FallbackValue='Изберете крвна група...'}"
													TextColor="{StaticResource SparkTextPrimary}"
													VerticalOptions="Center" />
												<Label
													Grid.Column="1"
													FontSize="11"
													Text="▼"
													TextColor="{StaticResource SparkTextSecondary}"
													VerticalOptions="Center" />
												<Picker
													Grid.ColumnSpan="2"
													BackgroundColor="Transparent"
													IsEnabled="{Binding IsEditMode}"
													ItemsSource="{Binding BloodTypeOptions}"
													Opacity="0"
													SelectedItem="{Binding Patient.BloodType}" />
											</Grid>
										</Border>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />

							<!--  ДИЈАГНОЗИ  -->
							<VerticalStackLayout Spacing="12">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="АКТИВНИ И ИСТОРИЈА НА ДИЈАГНОЗИ"
									TextColor="{StaticResource SparkTextPrimary}" />
								<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />
								<CollectionView
									EmptyView="Нема евидентирани клинички дијагнози."
									ItemsSource="{Binding Patient.Diagnoses}"
									SelectionMode="None">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="models:Diagnosis">
											<Border
												Margin="0,0,0,12"
												Padding="16"
												BackgroundColor="{StaticResource SparkBackgroundAlt}"
												Stroke="{StaticResource SparkBorder}"
												StrokeShape="RoundRectangle 12"
												StrokeThickness="1">
												<Grid
													ColumnDefinitions="*,Auto"
													ColumnSpacing="12"
													RowDefinitions="Auto,Auto">

													<VerticalStackLayout Spacing="6">
														<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
															<Border
																Padding="8,4"
																BackgroundColor="{StaticResource SparkSidebarBg}"
																StrokeShape="RoundRectangle 4"
																StrokeThickness="0">
																<Label
																	FontAttributes="Bold"
																	FontFamily="Consolas"
																	FontSize="12"
																	Text="{Binding Mkb10Code.Code, FallbackValue='—'}"
																	TextColor="{StaticResource SparkAccentTeal}" />
															</Border>
															<Label
																FontAttributes="Bold"
																FontSize="14"
																Text="{Binding ClinicalDescription}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</HorizontalStackLayout>
														<Label
															FontSize="11"
															Text="{Binding DiagnosedAt, StringFormat='Евидентирано на: {0:dd.MM.yyyy}'}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>

													<controls:FFStatusChip
														Grid.Column="1"
														BackgroundColor="{Binding Status, Converter={StaticResource DiagnosisStatusToColorConverter}}"
														Text="{Binding Status, Converter={StaticResource DiagnosisStatusToLabelConverter}}"
														TextColor="{Binding Status, Converter={StaticResource DiagnosisStatusToTextColorConverter}}"
														VerticalOptions="Center" />

													<Border
														Grid.Row="1"
														Margin="0,12,0,0"
														Padding="8,3"
														BackgroundColor="{StaticResource SparkAccentTeal}"
														HorizontalOptions="Start"
														IsVisible="{Binding IsPrimary}"
														StrokeShape="RoundRectangle 4"
														StrokeThickness="0">
														<Label
															FontAttributes="Bold"
															FontSize="11"
															Text="Примарна Дијагноза"
															TextColor="{StaticResource SparkButtonPrimaryText}" />
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

							<!--  АЛЕРГИИ  -->
							<VerticalStackLayout Spacing="8">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="ПОЗНАТИ АЛЕРГИИ И РЕАКЦИИ"
									TextColor="{StaticResource SparkTextPrimary}" />
								<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />
								<Border
									Padding="12,10"
									BackgroundColor="{StaticResource SparkBackground}"
									HeightRequest="120"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 12"
									StrokeThickness="1">
									<Editor
										AutoSize="Disabled"
										BackgroundColor="Transparent"
										FontSize="13"
										IsReadOnly="{Binding IsReadOnly}"
										Placeholder="Внесете алергии (Пр. Пеницилин, Храна, Прашина...)"
										PlaceholderColor="{StaticResource SparkTextSecondary}"
										Text="{Binding Patient.Allergies}"
										TextColor="{StaticResource SparkTextPrimary}" />
								</Border>
							</VerticalStackLayout>
						</VerticalStackLayout>

						<!--  ============================================  -->
						<!--  TAB 3 — КОНТАКТ ИНФОРМАЦИИ (ИТНО)  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab3Active}" Spacing="20">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="КОНТАКТ ЛИЦЕ ЗА ИТНИ СЛУЧАИ"
								TextColor="{StaticResource SparkAccentTeal}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
								<!--  ИМЕ И ПРЕЗИМЕ НА КОНТАКТ  -->
								<VerticalStackLayout Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="Име и презиме"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. Ана Петровска"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.EmergencyContactName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>

								<!--  ТЕЛЕФОН НА КОНТАКТ  -->
								<VerticalStackLayout Grid.Column="1" Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="Телефонски број"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.EmergencyContactPhone}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
							</Grid>

							<!--  РОДНИНСКА ВРСКА  -->
							<VerticalStackLayout Spacing="8">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Роднинска врска / Релација"
									TextColor="{StaticResource SparkTextSecondary}" />
								<Border
									Padding="14,0"
									BackgroundColor="{StaticResource SparkBackground}"
									HeightRequest="46"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 6"
									StrokeThickness="1">
									<Grid ColumnDefinitions="*,Auto">
										<Label
											FontSize="13"
											Text="{Binding SelectedRelationDisplay, FallbackValue='Изберете релација...'}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
										<Label
											Grid.Column="1"
											FontSize="11"
											Text="▼"
											TextColor="{StaticResource SparkTextSecondary}"
											VerticalOptions="Center" />
										<Picker
											Grid.ColumnSpan="2"
											BackgroundColor="Transparent"
											IsEnabled="{Binding IsEditMode}"
											ItemsSource="{Binding RelationOptions}"
											Opacity="0"
											SelectedItem="{Binding SelectedRelationDisplay}" />
									</Grid>
								</Border>
							</VerticalStackLayout>
						</VerticalStackLayout>

						<!--  ============================================  -->
						<!--  TAB 4 — СИСТЕМСКИ ЗАПИС  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab4Active}" Spacing="24">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="МЕТАДАТА И ИНФОРМАЦИИ ЗА ЗАПИСОТ"
								TextColor="{StaticResource SparkAccentTeal}" />

							<Border
								Padding="20"
								BackgroundColor="{StaticResource SparkBackgroundAlt}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid
									ColumnDefinitions="*,Auto"
									RowDefinitions="Auto,Auto,Auto,Auto"
									RowSpacing="16">

									<!--  ID  -->
									<Label
										FontSize="13"
										Text="Системско ID во база"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontFamily="Consolas"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.Id}"
										TextColor="{StaticResource SparkTextPrimary}" />

									<!--  ДАТУМ РЕГИСТРАЦИЈА  -->
									<Label
										Grid.Row="1"
										FontSize="13"
										Text="Датум на првична регистрација"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Row="1"
										Grid.Column="1"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.RegistrationDate, StringFormat='{0:dd.MM.yyyy}'}"
										TextColor="{StaticResource SparkTextPrimary}" />

									<!--  КРЕИРАНО НА  -->
									<Label
										Grid.Row="2"
										FontSize="13"
										Text="Инстанцирано на сервер"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Row="2"
										Grid.Column="1"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.CreatedAt, StringFormat='{0:dd.MM.yyyy}'}"
										TextColor="{StaticResource SparkTextPrimary}" />

									<!--  ПОСЛЕДНА ПОСЕТА  -->
									<Label
										Grid.Row="3"
										FontSize="13"
										Text="Последна активност / Преглед"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Row="3"
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.LastVisitDate, StringFormat='{0:dd.MM.yyyy}', FallbackValue='Нема евидентирано посети'}"
										TextColor="{StaticResource SparkAccentTeal}" />
								</Grid>
							</Border>

							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
