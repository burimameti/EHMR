<VerticalStackLayout Spacing="2"><Label FontAttributes="Bold" FontSize="11" Text="Неактивен" TextColor="#DC2626" /><HorizontalStackLayout Spacing="4"><HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding SetInactiveCommand}" /></HorizontalStackLayout.GestureRecognizers><CheckBox IsChecked="{Binding IsPatientInactive, Mode=OneWay}" IsEnabled="False" Color="#DC2626" /></HorizontalStackLayout></VerticalStackLayout>
</HorizontalStackLayout>
<Border BackgroundColor="{StaticResource SparkAccentTeal}" HeightRequest="2" HorizontalOptions="Fill" Margin="0,2,0,4" StrokeThickness="0" />
