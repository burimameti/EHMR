															<Label
																FontAttributes="Bold"
																FontSize="12"
																LineBreakMode="TailTruncation"
																Text="{Binding SelectedDoctorDisplay}"
																TextColor="{StaticResource SparkAccentTealDark}" />

														</VerticalStackLayout>
													</Grid>
												</Border>

											</VerticalStackLayout>

											<!--  READ MODE  -->
											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">

												<Label
													FontSize="10"
													Text="Реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />

												<Label
													FontAttributes="Bold"
													FontSize="13"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctorDisplay}"
													TextColor="{StaticResource SparkTextPrimary}" />

											</VerticalStackLayout>

										</VerticalStackLayout>

										<!--  КОЛОНА 2: КРВНА ГРУПА  -->
										<VerticalStackLayout Grid.Column="1" Spacing="8">
