											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Крвна група:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding SelectedBloodTypeDisplay, FallbackValue='—'}" />
									</Grid>
								</Grid>

								<!--  Алергии  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Алергии" />
