							</VerticalStackLayout>
						</Border>-->

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="6">
								<HorizontalStackLayout Spacing="8">
									<Label Text="🚑" FontSize="16" />
									<Label Text="Итен Контакт" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
								</HorizontalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="ЛИЦЕ ЗА КОНТАКТ" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<Entry Text="{Binding Patient.EmergencyContactName}" IsReadOnly="{Binding IsReadOnly}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" Margin="12,0" />
									</Border>
								</VerticalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="ТЕЛЕФОН" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<Entry Text="{Binding Patient.EmergencyContactPhone}" IsReadOnly="{Binding IsReadOnly}" Keyboard="Telephone" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" Margin="12,0" />
									</Border>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Border>

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="6">
								<HorizontalStackLayout Spacing="8">
									<Label Text="🩸" FontSize="16" />
									<Label Text="Медицински Информации" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" />
								</HorizontalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="КРВНА ГРУПА" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<!-- СТАБИЛЕН ДРОПДАУН СИСТЕМ (КРВНА ГРУПА) -->
										<Grid>
											<Grid ColumnDefinitions="*, Auto" Margin="12,0" InputTransparent="True">
												<Label Text="{Binding Patient.BloodType, FallbackValue='Изберете група'}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
												<Label Grid.Column="1" Text="▼" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
											</Grid>

											<Picker SelectedItem="{Binding Patient.BloodType}" IsVisible="{Binding IsEditMode}" TextColor="Transparent" TitleColor="Transparent" BackgroundColor="Transparent" HorizontalOptions="Fill" VerticalOptions="Fill">
												<Picker.ItemsSource>
													<x:Array Type="{x:Type x:String}">
														<x:String>A+</x:String>
														<x:String>A-</x:String>
														<x:String>B+</x:String>
														<x:String>B-</x:String>
														<x:String>AB+</x:String>
														<x:String>AB-</x:String>
														<x:String>O+</x:String>
														<x:String>O-</x:String>
													</x:Array>
												</Picker.ItemsSource>
											</Picker>
										</Grid>
									</Border>
								</VerticalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="АЛЕРГИИ" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="80" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="4">
										<Editor Text="{Binding Patient.Allergies}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Пеницилин, латекс, храна..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalOptions="Fill" HorizontalOptions="Fill" />
									</Border>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Border>

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="6">
								<HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
									<Label Text="📞" FontSize="16" VerticalOptions="Center" />
									<Label Text="Контакт Информации" FontSize="15" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
								</HorizontalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="Е-ПОШТА" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<Entry Text="{Binding Patient.Email}" IsReadOnly="{Binding IsReadOnly}" Keyboard="Email" Placeholder="наслов@домен.com" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
									</Border>
								</VerticalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="ТЕЛЕФОН" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<Entry Text="{Binding Patient.Phone}" IsReadOnly="{Binding IsReadOnly}" Keyboard="Telephone" Placeholder="+389 7X XXX XXX" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
									</Border>
								</VerticalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="АДРЕСА" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<Entry Text="{Binding Patient.Address}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Улица и број" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" Margin="12,0" />
									</Border>
								</VerticalStackLayout>

								<VerticalStackLayout Spacing="6">
									<Label Text="ГРАД" FontSize="10" FontAttributes="Bold" TextColor="#64748B" />
									<Border HeightRequest="40" BackgroundColor="{Binding InputBgColor}" Stroke="{Binding InputBorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
										<Entry Text="{Binding Patient.City}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Струмица" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" Margin="12,0" />
									</Border>
								</VerticalStackLayout>
							</VerticalStackLayout>
						</Border>

						<Border IsVisible="{Binding IsReadOnly}" BackgroundColor="#F8FAFC" Padding="20" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14">
							<VerticalStackLayout Spacing="10">
								<HorizontalStackLayout Spacing="6">
									<Label Text="⚙" TextColor="#64748B" FontSize="12" />
									<Label Text="Информации за записот" FontSize="11" FontAttributes="Bold" TextColor="#64748B" CharacterSpacing="0.5" />
								</HorizontalStackLayout>
								<BoxView HeightRequest="1" Color="#E2E8F0" />
								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto, Auto" RowSpacing="6">
									<Label Text="Датум на креирање:" FontSize="11" TextColor="#94A3B8" />
									<Label Grid.Column="1" Text="{Binding Patient.CreatedAt, StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" HorizontalOptions="End" TextColor="#64748B" />
									<Label Grid.Row="1" Text="ID во база:" FontSize="11" TextColor="#94A3B8" />
									<Label Grid.Row="1" Grid.Column="1" Text="{Binding Patient.Id}" FontSize="11" HorizontalOptions="End" TextColor="#64748B" />
									<Label Grid.Row="2" Text="Регистрација:" FontSize="11" TextColor="#94A3B8" />
									<Label Grid.Row="2" Grid.Column="1" Text="{Binding Patient.RegistrationDate,StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" HorizontalOptions="End" TextColor="#64748B" />
								</Grid>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>
				</Grid>
			</ScrollView>
		</Grid>
	</Grid>
</ContentPage>