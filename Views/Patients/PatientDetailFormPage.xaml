<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Patients.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dto="clr-namespace:EHMR.Services.Dto"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientDetailFormViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<x:Array x:Key="DosesFrequencyValues" Type="{x:Type models:DosesFrequency}">
				<models:DosesFrequency>Daily</models:DosesFrequency>
				<models:DosesFrequency>TwiceDaily</models:DosesFrequency>
				<models:DosesFrequency>ThreeTimesDaily</models:DosesFrequency>
				<models:DosesFrequency>EveryOtherDay</models:DosesFrequency>
				<models:DosesFrequency>EveryThreeDays</models:DosesFrequency>
				<models:DosesFrequency>Weekly</models:DosesFrequency>
				<models:DosesFrequency>Monthly</models:DosesFrequency>
				<models:DosesFrequency>Other</models:DosesFrequency>
			</x:Array>

			<converters:EncounterStatusToTextConverter x:Key="StatusTextConverter" />
			<converters:EncounterStatusToColorConverter x:Key="StatusColorConverter" />
			<converters:EncounterStatusToBgConverter x:Key="StatusBgConverter" />
			<converters:DocumentIsImageConverter x:Key="DocumentIsImageConverter" />

			<!--  ═══ ШАБЛОНИ ЗА ИСТОРИЈА НА ПАЦИЕНТОТ ═══  -->

			<DataTemplate x:Key="PatientDiagnosisRowTemplate" x:DataType="models:Diagnosis">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontFamily="Consolas"
							FontSize="12"
							Text="{Binding Mkb10Code.Code}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding Mkb10Code.Description}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientEncounterRowTemplate" x:DataType="models:Encounter">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Border
							Grid.Column="2"
							Padding="6,2"
							BackgroundColor="{Binding Status, Converter={StaticResource StatusBgConverter}}"
							StrokeShape="RoundRectangle 4"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="10"
								Text="{Binding Status, Converter={StaticResource StatusTextConverter}}"
								TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
						</Border>
					</Grid>
				</Border>
			</DataTemplate>



			<DataTemplate x:Key="PatientAppointmentRowTemplate" x:DataType="models:Appointment">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleRowTemplate" x:DataType="models:TherapyCycle">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleHistoryRowTemplate" x:DataType="models:TherapyCycle">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10"
						RowDefinitions="Auto,Auto"
						RowSpacing="3">
						<Label
							Grid.RowSpan="2"
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding DecisionText, TargetNullValue='Без внесено решение'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="2"
							FontSize="11"
							Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<HorizontalStackLayout
							Grid.Row="1"
							Grid.Column="1"
							Spacing="8">
							<Label
								FontSize="11"
								LineBreakMode="TailTruncation"
								Text="{Binding Notes, TargetNullValue='Без забелешка'}"
								TextColor="{StaticResource SparkTextSecondary}" />
							<Label
								FontSize="11"
								Text="{Binding Documents.Count, StringFormat='Документи: {0}'}"
								TextColor="{StaticResource SparkAccentTealDark}" />
						</HorizontalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientPrescriptionRowTemplate" x:DataType="models:Prescription">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding Notes}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientMedicineHistoryRowTemplate" x:DataType="models:PatientMedicine">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="10,8"
						ColumnDefinitions="*,Auto"
						RowDefinitions="Auto,Auto"
						RowSpacing="6">
						<HorizontalStackLayout Grid.Row="0" Spacing="8">
							<Label
								FontAttributes="Bold"
								FontSize="13"
								Text="{Binding Medicine.Name, FallbackValue='—'}"
								TextColor="{StaticResource SparkAccentTealDark}"
								VerticalOptions="Center" />
							<Border
								Padding="6,2"
								BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToActiveBadgeColorConverter}}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0"
								VerticalOptions="Center">
								<Label
									FontAttributes="Bold"
									FontSize="9"
									Text="{Binding IsActive, Converter={StaticResource BoolToActiveLabelConverter}}"
									TextColor="{StaticResource SparkBackground}" />
							</Border>
						</HorizontalStackLayout>
						<Label
							Grid.Row="0"
							Grid.Column="1"
							FontSize="11"
							Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<HorizontalStackLayout
							Grid.Row="1"
							Grid.ColumnSpan="2"
							Spacing="6">
							<Label
								FontSize="12"
								Text="{Binding Dosage, StringFormat='Количина: {0}'}"
								TextColor="{StaticResource SparkTextPrimary}" />
							<Label
								FontSize="12"
								Text="•"
								TextColor="{StaticResource SparkTextSecondary}" />
							<Label
								FontSize="12"
								Text="{Binding DosesFrequency}"
								TextColor="{StaticResource SparkTextSecondary}" />
						</HorizontalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="260,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*,Auto"
			RowSpacing="0">

			<Border
				Grid.Row="0"
				Margin="0,0,0,0"
				Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="{Binding HeaderTitle}" Subtitle="Преглед и управување со податоците за пациентот}">
					<controls:FFPageHeader.HeaderContent>
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding GenerateClinicalReportCommand}"
							ContentPadding="16,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsNewPatient, Converter={StaticResource InverseBoolConverter}}"
							Text="Печати / PDF" />
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<!--  Една колона: формата, па историјата под неа  -->
			<Grid
				Grid.Row="1"
				Margin="0"
				Padding="0"
				Style="{StaticResource CrudFormBodyGridStyle}">
				<controls:CustomScrollView
					x:Name="FormScrollView"
					Margin="0"
					Padding="0"
					ScrollBarColor="{StaticResource SparkAccentTeal}">
					<VerticalStackLayout Spacing="0">

						<!--  ╔═══════════════════ ФОРМА ═══════════════════╗  -->
						<controls:FFSectionCard Margin="0" Style="{StaticResource CrudFormCardStyle}">
							<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">

								<Grid
									Padding="0"
									RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
									RowSpacing="6">
									<!--  РЕД 1 — ЛИЧНИ ПОДАТОЦИ (статус скроз десно на иста линија)  -->
									<VerticalStackLayout Grid.Row="0" Spacing="10">

										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
											<controls:CrudSectionHeader
												Title="ЛИЧНИ ПОДАТОЦИ"
												Padding="8,5"
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />

											<HorizontalStackLayout
												Grid.Column="1"
												HorizontalOptions="End"
												Spacing="14"
												VerticalOptions="Center">
												<controls:FFStatusChip
													BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
													Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
													TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}" />
											</HorizontalStackLayout>
										</Grid>



										<Grid ColumnDefinitions="1.3*,1.3*,125,90,1*" ColumnSpacing="10">
											<VerticalStackLayout Grid.Column="0" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Име *" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Placeholder="Пр. Марко"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.FirstName}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label
														FontSize="11"
														Text="Име:"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding Patient.FirstName}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="1" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Презиме *" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Placeholder="Пр. Петровски"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.LastName}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label
														FontSize="11"
														Text="Презиме:"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding Patient.LastName}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="2" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Датум на раѓање" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Grid ColumnDefinitions="*,Auto">
														<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
														<Label Grid.Column="1" Style="{StaticResource FieldBoxCalendarIconStyle}" />
														<DatePicker
															Grid.ColumnSpan="2"
															BackgroundColor="Transparent"
															Date="{Binding Patient.BirthDate}"
															Format="dd.MM.yyyy"
															Opacity="0" />
													</Grid>
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label
														FontSize="11"
														Text="Роден:"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Border Style="{StaticResource InfoPillBorderStyle}">
														<HorizontalStackLayout Spacing="6">
															<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf073;" />
															<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
														</HorizontalStackLayout>
													</Border>
												</VerticalStackLayout>
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="3" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Пол *" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Grid ColumnDefinitions="*,Auto">
														<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedGenderDisplay}" />
														<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
														<Picker
															Grid.ColumnSpan="2"
															BackgroundColor="Transparent"
															ItemsSource="{Binding GenderOptions}"
															Opacity="0"
															SelectedItem="{Binding SelectedGenderDisplay}" />
													</Grid>
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label
														FontSize="11"
														Text="Пол:"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Border Style="{StaticResource InfoPillBorderStyle}">
														<HorizontalStackLayout Spacing="6">
															<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />
															<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding SelectedGenderDisplay}" />
														</HorizontalStackLayout>
													</Border>
												</VerticalStackLayout>
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="4" Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="ЕЗБО" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Placeholder="Здравствен број"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.SzboNumber}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
													<Label
														FontSize="11"
														Text="ЕЗБО:"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding Patient.SzboNumber}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
											</VerticalStackLayout>
										</Grid>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Spacing="10">
										<controls:CrudSectionHeader
											Title="КОНТАКТ ИНФОРМАЦИИ"
											Padding="8,5"
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											LineColor="{StaticResource SparkAccentTeal}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Grid
											ColumnDefinitions="1.1*,1.1*,1.1*"
											ColumnSpacing="12"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="0"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Телефон" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Keyboard="Telephone"
														Placeholder="+389 7X XXX XXX"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.Phone}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
													<VerticalStackLayout Spacing="4">
														<Label Style="{StaticResource ReadRowLabelStyle}" Text="Телефон:" />
														<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Phone}" />
													</VerticalStackLayout>
												</Border>
											</VerticalStackLayout>
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="1"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Е-пошта" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Keyboard="Email"
														Placeholder="email@example.com"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.Email}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
													<VerticalStackLayout Spacing="4">
														<Label Style="{StaticResource ReadRowLabelStyle}" Text="Е-пошта:" />
														<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Email}" />
													</VerticalStackLayout>
												</Border>
											</VerticalStackLayout>
											<VerticalStackLayout
												Grid.Row="0"
												Grid.Column="2"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Град" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Picker
														BackgroundColor="Transparent"
														ItemsSource="{Binding CityOptions}"
														SelectedItem="{Binding SelectedCityDisplay}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
													<VerticalStackLayout Spacing="4">
														<Label Style="{StaticResource ReadRowLabelStyle}" Text="Град:" />
														<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding SelectedCityDisplay}" />
													</VerticalStackLayout>
												</Border>
											</VerticalStackLayout>
											<VerticalStackLayout
												Grid.Row="1"
												Grid.Column="0"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Адреса" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Placeholder="Улица и број"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.Address}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
													<VerticalStackLayout Spacing="4">
														<Label Style="{StaticResource ReadRowLabelStyle}" Text="Адреса:" />
														<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Address}" />
													</VerticalStackLayout>
												</Border>
											</VerticalStackLayout>
											<VerticalStackLayout
												Grid.Row="1"
												Grid.Column="1"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Итен контакт" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Placeholder="Име и презиме"
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.EmergencyContactName}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
													<VerticalStackLayout Spacing="4">
														<Label Style="{StaticResource ReadRowLabelStyle}" Text="Итен контакт:" />
														<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.EmergencyContactName}" />
													</VerticalStackLayout>
												</Border>
											</VerticalStackLayout>
											<VerticalStackLayout
												Grid.Row="1"
												Grid.Column="2"
												Spacing="4">
												<Label
													IsVisible="{Binding IsEditMode}"
													Style="{StaticResource EditFieldLabelStyle}"
													Text="Тел. на итен контакт" />
												<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
													<Entry
														BackgroundColor="Transparent"
														FontSize="13"
														Keyboard="Telephone"
														Placeholder="+389..."
														PlaceholderColor="{StaticResource SparkTextSecondary}"
														Text="{Binding Patient.EmergencyContactPhone}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
												<Border IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
													<VerticalStackLayout Spacing="4">
														<Label Style="{StaticResource ReadRowLabelStyle}" Text="Тел. (итен):" />
														<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.EmergencyContactPhone}" />
													</VerticalStackLayout>
												</Border>
											</VerticalStackLayout>
