													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
											<CollectionView ItemsSource="{Binding Diagnoses}" SelectionMode="None">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="dto:DiagnosisDto">
														<Grid Padding="6,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
															<Label FontAttributes="Bold" Text="{Binding Mkb10Code}" TextColor="{StaticResource SparkAccentTealDark}" />
															<Label Grid.Column="1" Text="{Binding Mkb10Description}" LineBreakMode="TailTruncation" />
															<Label Grid.Column="2" FontFamily="FASolid" Text="&#xf1f8;" TextColor="#DC2626"><Label.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}" CommandParameter="{Binding .}" /></Label.GestureRecognizers></Label>
														</Grid>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</VerticalStackLayout>
									</Border>

									<controls:CrudSectionHeader Title="ЛЕКОВИ" />
									<Border Padding="10" Style="{StaticResource EditFieldBoxStyle}">
										<VerticalStackLayout Spacing="8">
											<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
												<Entry Grid.Column="0" Placeholder="Пребарај лек..." Text="{Binding MedicineSearchText, Mode=TwoWay}" FontSize="13" />
												<HorizontalStackLayout Grid.Column="1" Spacing="6">
													<Entry WidthRequest="180" Placeholder="Нов режим на апликација" Text="{Binding NewApplicationRegimeText, Mode=TwoWay}" FontSize="12" />
													<controls:FFButton Text="Нов режим" Command="{Binding AddApplicationRegimeCommand}" ButtonKind="Secondary" HeightRequestEx="40" ContentPadding="14,0" />
															<controls:FFButton Text="Режими" Command="{Binding OpenApplicationRegimesCommand}" ButtonKind="Secondary" HeightRequestEx="40" ContentPadding="14,0" />
												</HorizontalStackLayout>
											</Grid>

											<CollectionView HeightRequest="150" IsVisible="{Binding ShowMedicineDropdown}" ItemsSource="{Binding MedicineResults}" SelectionMode="None">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="dto:MedicineDto">
														<Border Padding="8" Margin="0,2" BackgroundColor="{StaticResource SparkTabActiveBg}" StrokeThickness="0">
															<Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
															<Grid ColumnDefinitions="180,180,110,110,90,90,180,180" ColumnSpacing="8">
																<Label Text="{Binding Name}" FontAttributes="Bold" />
																<Label Grid.Column="1" Text="{Binding GenericName}" />
																<Label Grid.Column="2" Text="{Binding Code}" />
																<Label Grid.Column="3" Text="{Binding DosageForm}" />
																<Label Grid.Column="4" Text="{Binding Strength}" />
																<Label Grid.Column="5" Text="{Binding Unit}" />
																<Label Grid.Column="6" Text="{Binding Manufacturer}" />
															</Grid>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>

											<ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
												<VerticalStackLayout WidthRequest="1442" Spacing="0">
													<Grid ColumnDefinitions="180,180,110,110,90,90,180,180,180,100,42" ColumnSpacing="1" BackgroundColor="#475569">
														<Label Padding="8,7" Text="НАЗИВ" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="1" Padding="8,7" Text="ГЕНЕРИЧКО ИМЕ" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="2" Padding="8,7" Text="ШИФРА" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="3" Padding="8,7" Text="ФОРМА" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="4" Padding="8,7" Text="ЈАЧИНА" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="5" Padding="8,7" Text="ЕДИНИЦА" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="6" Padding="8,7" Text="ПРОИЗВОДИТЕЛ" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="7" Padding="8,7" Text="СТАНДАРДНА ДОЗА" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="8" Padding="8,7" Text="РЕЖИМ НА АПЛИКАЦИЈА" FontAttributes="Bold" FontSize="10" TextColor="White" />
														<Label Grid.Column="9" Padding="8,7" Text="КОЛИЧИНА" />
																		<Label Grid.Column="10" Padding="8,7" Text="" />
													</Grid>
													<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachedMedicines}" Spacing="0">
														<BindableLayout.ItemTemplate>
															<DataTemplate x:DataType="viewModels:AttachedMedicineRow">
																<Grid ColumnDefinitions="180,180,110,110,90,90,180,180,180,100,42" ColumnSpacing="1">
																	<Label Padding="8,8" Text="{Binding MedicineName}" LineBreakMode="TailTruncation" />
																	<Label Grid.Column="1" Padding="8,8" Text="{Binding GenericName}" LineBreakMode="TailTruncation" />
																	<Label Grid.Column="2" Padding="8,8" Text="{Binding Code}" />
																	<Label Grid.Column="3" Padding="8,8" Text="{Binding DosageForm}" />
																	<Label Grid.Column="4" Padding="8,8" Text="{Binding StrengthDisplay}" />
																	<Label Grid.Column="5" Padding="8,8" Text="{Binding PatientMedicine.Unit}" />
																	<Label Grid.Column="6" Padding="8,8" Text="{Binding Manufacturer}" LineBreakMode="TailTruncation" />
																	<Label Grid.Column="7" Padding="8,8" Text="{Binding DefaultDosage}" LineBreakMode="TailTruncation" />
																																					<Picker Grid.Column="8" Margin="3,2" ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}" SelectedItem="{Binding PatientMedicine.ApplicationRegime, Mode=TwoWay}" FontSize="11" />
																	<Entry Grid.Column="8" Margin="3,2" Keyboard="Numeric" Text="{Binding PatientMedicine.Quantity, Mode=TwoWay}" FontSize="12" />
																	<Button Grid.Column="9" Padding="0" BackgroundColor="Transparent" Text="✕" TextColor="#DC2626" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}" />
																</Grid>
															</DataTemplate>
														</BindableLayout.ItemTemplate>
													</VerticalStackLayout>
												</VerticalStackLayout>
											</ScrollView>
										</VerticalStackLayout>
									</Border>

									<controls:CrudSectionHeader Title="СКОР" />
									<Border Padding="10" Style="{StaticResource EditFieldBoxStyle}">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Label Text="Моментален скор" FontAttributes="Bold" VerticalOptions="Center" />
											<Label Grid.Column="1" Text="{Binding CurrentPatientScore}" TextColor="{StaticResource SparkAccentTealDark}" FontAttributes="Bold" VerticalOptions="Center" />
										</Grid>
									</Border>

<!-- СТАТУС НА ПАЦИЕНТ -->
									<controls:CrudSectionHeader Title="СТАТУС НА ПАЦИЕНТ" />
									<Border Padding="12" BackgroundColor="{StaticResource SparkBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
										<VerticalStackLayout Spacing="8">
											<HorizontalStackLayout Spacing="18">
												<HorizontalStackLayout Spacing="6">
													<CheckBox IsChecked="{Binding IsPatientActive, Mode=TwoWay}" IsEnabled="{Binding IsEditMode}" VerticalOptions="Center" />
													<Label Text="Активен" VerticalOptions="Center" FontAttributes="Bold" />
												</HorizontalStackLayout>
												<HorizontalStackLayout Spacing="6">
													<HorizontalStackLayout.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding SetInactiveCommand}" />
													</HorizontalStackLayout.GestureRecognizers>
													<CheckBox IsChecked="{Binding IsPatientInactive, Mode=OneWay}" IsEnabled="False" VerticalOptions="Center" />
													<Label Text="Неактивен" VerticalOptions="Center" FontAttributes="Bold" />
												</HorizontalStackLayout>
											</HorizontalStackLayout>
											<VerticalStackLayout IsVisible="{Binding IsPatientInactive}" Spacing="4">
												<Label Text="Причина за неактивност *" Style="{StaticResource EditFieldLabelStyle}" />
												<Border IsEnabled="{Binding IsEditMode}" Style="{StaticResource TextAreaFieldBoxStyle}">
													<Editor AutoSize="TextChanges" FontSize="13" Placeholder="Внесете причина..." Text="{Binding InactiveReason, Mode=TwoWay}" TextColor="{StaticResource SparkTextPrimary}" />
												</Border>
											</VerticalStackLayout>
										</VerticalStackLayout>
									</Border>

								<!--  COLUMN 2 — КОНТАКТ ИНФОРМАЦИИ  -->
								<!--  ================================================  -->
								<VerticalStackLayout
									Grid.Row="1"
									Grid.Column="1"
									Spacing="16">
									<controls:CrudSectionHeader Title="КОНТАКТ ИНФОРМАЦИИ" />

									<Grid Padding="{StaticResource FormRowPadding}" ColumnDefinitions="*,*" ColumnSpacing="16">
										<VerticalStackLayout Grid.Column="0" IsVisible="{Binding IsEditMode}" Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Телефон" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry BackgroundColor="Transparent" FontSize="13" Keyboard="Telephone" Placeholder="+389 7X XXX XXX" Text="{Binding Patient.Phone}" TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border Grid.Column="0" IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Телефон:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Phone}" />
											</VerticalStackLayout>
										</Border>
										<VerticalStackLayout Grid.Column="1" IsVisible="{Binding IsEditMode}" Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Е-пошта" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry BackgroundColor="Transparent" FontSize="13" Keyboard="Email" Placeholder="email@example.com" Text="{Binding Patient.Email}" TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border Grid.Column="1" IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Е-пошта:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Email}" />
											</VerticalStackLayout>
										</Border>
									</Grid>

									<Grid Padding="{StaticResource FormRowPadding}" ColumnDefinitions="*,*" ColumnSpacing="16">
										<VerticalStackLayout Grid.Column="0" IsVisible="{Binding IsEditMode}" Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Град" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Picker BackgroundColor="Transparent" ItemsSource="{Binding CityOptions}" SelectedItem="{Binding SelectedCityDisplay}" TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border Grid.Column="0" IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Град:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding SelectedCityDisplay}" />
											</VerticalStackLayout>
										</Border>
										<VerticalStackLayout Grid.Column="1" IsVisible="{Binding IsEditMode}" Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Адреса" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry BackgroundColor="Transparent" FontSize="13" Placeholder="Улица и број" Text="{Binding Patient.Address}" TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border Grid.Column="1" IsVisible="{Binding IsReadOnly}" Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Адреса:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Address}" />
											</VerticalStackLayout>
										</Border>
									</Grid>
								</VerticalStackLayout>
							</Grid>
							<BoxView
								BackgroundColor="{StaticResource PageBackground}"
								HeightRequest="1"
								HorizontalOptions="Fill" />
							<HorizontalStackLayout
								Grid.Column="2"
								HorizontalOptions="End"
								Spacing="6"
								VerticalOptions="Center">
								<controls:FFButton
									ButtonKind="Secondary"
									Command="{Binding CancelCommand}"
									ContentPadding="24,0"
									HeightRequestEx="42"
									IsVisible="{Binding IsEditMode}"
									Text="Откажи" />
								<controls:FFButton
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									ButtonKind="Primary"
									Command="{Binding SaveCommand}"
									ContentPadding="24,0"
									HeightRequestEx="42"
									IsVisible="{Binding IsEditMode}"
									Text="Зачувај"
									TextColorEx="{StaticResource SidebarActiveText}" />
								<controls:FFButton
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									ButtonKind="Primary"
									Command="{Binding ToggleEditModeAsyncCommand}"
									ContentPadding="24,0"
									HeightRequestEx="42"
									IsVisible="{Binding IsReadOnly}"
									Text="Уреди"
									TextColorEx="{StaticResource SidebarActiveText}" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</controls:CustomScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ИСТОРИЈА + ДОКУМЕНТИ (со preview)  -->
				<!--  ═══════════════════════════════════════════════════════  -->
