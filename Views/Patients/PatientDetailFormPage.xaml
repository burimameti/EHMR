									Grid.Column="2"
									EmptyViewText="Нема закажани термини."
									ItemTemplate="{StaticResource PatientAppointmentRowTemplate}"
									ItemsSource="{Binding AppointmentHistory}"
									Subtitle="Закажани"
									Variant="Appointment" />
								<controls:SparkExpandableCard
									Title="Терапевтски циклуси"
									Grid.Row="1"
									Grid.Column="0"
									EmptyViewText="Нема терапевтски циклуси."
									ItemTemplate="{StaticResource PatientTherapyCycleRowTemplate}"
									ItemsSource="{Binding TherapyCycleHistory}"
									Variant="TherapyCycle" />
								<controls:SparkExpandableCard
									Title="Историја на рецепти"
									Grid.Row="1"
