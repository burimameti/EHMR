<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Patients.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientDetailFormViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<x:Array x:Key="DosesFrequencyValues" Type="{x:Type models:DosesFrequency}">
				<models:DosesFrequency>Daily</models:DosesFrequency>
				<models:DosesFrequency>TwiceDaily</models:DosesFrequency>
				<models:DosesFrequency>ThreeTimesDaily</models:DosesFrequency>
				<models:DosesFrequency>EveryOtherDay</models:DosesFrequency>
				<models:DosesFrequency>EveryThreeDays</models:DosesFrequency>
				<models:DosesFrequency>Weekly</models:DosesFrequency>
				<models:DosesFrequency>Monthly</models:DosesFrequency>
				<models:DosesFrequency>Other</models:DosesFrequency>
			</x:Array>

			<!--  SECTION HEADER PILL — исто како EncounterCreatePage  -->
			<Style x:Key="SectionPillBorderStyle" TargetType="Border">
				<Setter Property="Padding" Value="14,10" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkTabActiveBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>
			<Style x:Key="SectionPillLabelStyle" TargetType="Label">
				<Setter Property="CharacterSpacing" Value="0.5" />
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="TextColor" Value="{StaticResource SparkAccentTealDark}" />
			</Style>

			<Style x:Key="ReadRowLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>
			<Style x:Key="ReadRowValueStyle" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="VerticalOptions" Value="Center" />
				<Setter Property="LineBreakMode" Value="TailTruncation" />
			</Style>
			<Style x:Key="EditFieldLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<!--  EDIT FIELD BOX — заоблен 8px, teal-tint border + мека сенка (како во EncounterCreatePage)  -->
			<Style x:Key="EditFieldBoxStyle" TargetType="Border">
				<Setter Property="Padding" Value="12,0" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
				<Setter Property="HeightRequest" Value="46" />
				<Setter Property="Stroke" Value="{StaticResource SparkAccentTealBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="Shadow">
					<Setter.Value>
						<Shadow
							Brush="Black"
							Opacity="0.06"
							Radius="6"
							Offset="0,2" />
					</Setter.Value>
				</Setter>
			</Style>

			<!--  TEXT AREA BOX — иста рамка како EditFieldBoxStyle, само повисока и со вертикален padding (Алергии итн.)  -->
			<Style
				x:Key="TextAreaFieldBoxStyle"
				BasedOn="{StaticResource EditFieldBoxStyle}"
				TargetType="Border">
				<Setter Property="Padding" Value="12,10" />
				<Setter Property="HeightRequest" Value="90" />
			</Style>

			<!--  COMPACT FIELD BOX — помала верзија за инлајн доза/фреквенција редови  -->
			<Style
				x:Key="CompactFieldBoxStyle"
				BasedOn="{StaticResource EditFieldBoxStyle}"
				TargetType="Border">
				<Setter Property="Padding" Value="8,0" />
				<Setter Property="HeightRequest" Value="36" />
				<Setter Property="StrokeShape" Value="RoundRectangle 6" />
			</Style>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			RowDefinitions="Auto,*"
			RowSpacing="6">

			<!--  =========================================================  -->
			<!--  PAGE HEADER — иста структура/фонтови како EncounterCreatePage  -->
			<!--  =========================================================  -->
			<Border
				Padding="20,16"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<!--
						Avatar circle — иницијали од Patient, во истиот teal-pill
						стил како иконата во EncounterCreatePage header.
					-->
					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontAttributes="Bold"
							FontSize="16"
							HorizontalOptions="Center"
							Text="{Binding Patient, Converter={StaticResource PatientInitialsConverter}}"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="{Binding HeaderTitle}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<controls:FFStatusChip
							BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
							HorizontalOptions="Start"
							Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
							TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsEditMode}"
							Text="💾 Зачувај промени" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding ToggleEditModeCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsReadOnly}"
							Text="✎ Промени" />
					</HorizontalStackLayout>

				</Grid>
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE — 3 колони, pill section headers  -->
			<!--  =====================================================  -->
			<Border
				Grid.Row="1"
				Padding="10"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<ScrollView>
					<Grid
						Padding="28"
						ColumnDefinitions="*,1,*,1,*"
						ColumnSpacing="24">

						<!--  divider 0|1  -->
						<BoxView
							Grid.Column="1"
							VerticalOptions="Fill"
							WidthRequest="1"
							Color="{StaticResource SparkBorder}" />
						<!--  divider 1|2  -->
						<BoxView
							Grid.Column="3"
							VerticalOptions="Fill"
							WidthRequest="1"
							Color="{StaticResource SparkBorder}" />

						<!--  ================================================  -->
						<!--  COLUMN 0 — ЛИЧНИ ПОДАТОЦИ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="0" Spacing="14">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="ЛИЧНИ ПОДАТОЦИ" />
							</Border>

							<!--  Име  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Име *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Марко"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.FirstName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Име:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.FirstName}" />
								</Grid>
							</Grid>

							<!--  Презиме  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Презиме *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Петровски"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.LastName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Презиме:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.LastName}" />
								</Grid>
							</Grid>

							<!--  ЕМБГ  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="ЕМБГ *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Keyboard="Numeric"
											MaxLength="13"
											Placeholder="Внесете 13 цифри"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.NationalId}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="ЕМБГ:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.NationalId}" />
								</Grid>
							</Grid>

							<!--  Датум на раѓање  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Датум на раѓање" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<DatePicker
											BackgroundColor="Transparent"
											Date="{Binding Patient.BirthDate}"
											FontSize="13"
											Format="dd.MM.yyyy"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Роден:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
								</Grid>
							</Grid>

							<!--  Пол  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Пол *" />
									<Border Padding="14,0" Style="{StaticResource EditFieldBoxStyle}">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding SelectedGenderDisplay}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{Binding GenderOptions}"
												Opacity="0"
												SelectedItem="{Binding SelectedGenderDisplay}" />
										</Grid>
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Пол:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding SelectedGenderDisplay}" />
								</Grid>
							</Grid>

						</VerticalStackLayout>

						<!--  ================================================  -->
						<!--  COLUMN 1 — МЕДИЦИНСКИ ПОДАТОЦИ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="2" Spacing="14">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="МЕДИЦИНСКИ ПОДАТОЦИ" />
							</Border>

							<!--  Матичен лекар (Ревматолог) — реален search + dropdown  -->
							<VerticalStackLayout Spacing="8">
								<Label Style="{StaticResource EditFieldLabelStyle}" Text="Матичен лекар (Ревматолог) *" />

								<Grid IsVisible="{Binding IsEditMode}">
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пребарај лекар по име или специјалност..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding DoctorSearchText}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Border
									Padding="4"
									BackgroundColor="{StaticResource SparkBackground}"
									IsVisible="{Binding ShowDoctorDropdown}"
									MaximumHeightRequest="200"
									Stroke="{StaticResource SparkAccentTealBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<CollectionView ItemsSource="{Binding DoctorSearchResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="models:Doctor">
												<Grid Padding="8,6">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectDoctorCommand}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>
													<VerticalStackLayout Spacing="2">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding User.FirstName, StringFormat='Д-р {0} '}" />
														<Label
															FontSize="11"
															Text="{Binding Specialty}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Grid>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Border>

								<!--  FIX: read-only summary row is now correctly hidden while editing  -->
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Лекар:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding SelectedDoctorDisplay, FallbackValue='Не е избран лекар'}" />
								</Grid>
							</VerticalStackLayout>

							<!--  Крвна група  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Крвна група" />
									<Border Padding="14,0" Style="{StaticResource EditFieldBoxStyle}">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding Patient.BloodType, FallbackValue='Изберете...'}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{Binding BloodTypeOptions}"
												Opacity="0"
												SelectedItem="{Binding Patient.BloodType}" />
										</Grid>
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Крв. група:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.BloodType, FallbackValue='—'}" />
								</Grid>
							</Grid>

							<!--  Алергии  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Алергии" />
									<Border Style="{StaticResource TextAreaFieldBoxStyle}">
										<Editor
											AutoSize="Disabled"
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пеницилин, Храна, Прашина..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Allergies}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Алергии:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.Allergies, FallbackValue='Нема евидентирани.'}" />
								</Grid>
							</Grid>

							<!--  ДИЈАГНОЗИ — MKB-10, search + dropdown  -->
							<VerticalStackLayout Spacing="8">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ДИЈАГНОЗИ (МКБ-10)"
									TextColor="{StaticResource SparkTextSecondary}" />

								<Grid IsVisible="{Binding IsEditMode}">
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пребарај по код или опис..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding MkbSearchText}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Border
									Padding="4"
									BackgroundColor="{StaticResource SparkBackground}"
									IsVisible="{Binding ShowMkbDropdown}"
									MaximumHeightRequest="200"
									Stroke="{StaticResource SparkAccentTealBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<CollectionView ItemsSource="{Binding MkbResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="models:Mkb10Code">
												<Grid Padding="8,6">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>
													<HorizontalStackLayout Spacing="8">
														<Label
															FontAttributes="Bold"
															FontFamily="Consolas"
															FontSize="12"
															Text="{Binding Code}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label FontSize="12" Text="{Binding Description}" />
													</HorizontalStackLayout>
												</Grid>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Border>

								<FlexLayout
									BindableLayout.ItemsSource="{Binding Diagnoses}"
									Direction="Row"
									JustifyContent="Start"
									Wrap="Wrap">
									<BindableLayout.EmptyView>
										<Label
											FontSize="13"
											Text="Нема евидентирани дијагнози."
											TextColor="{StaticResource SparkTextSecondary}" />
									</BindableLayout.EmptyView>
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="models:Diagnosis">
											<Border
												Margin="0,0,8,8"
												Padding="10,6"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												Stroke="{StaticResource SparkAccentTeal}"
												StrokeShape="RoundRectangle 12">
												<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontFamily="Consolas"
														FontSize="12"
														Text="{Binding Mkb10Code.Code, FallbackValue='—'}"
														TextColor="{StaticResource SparkAccentTealDark}" />
													<Label
														FontSize="12"
														Text="{Binding Mkb10Code.Description}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Button
														Padding="0"
														BackgroundColor="Transparent"
														Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
														CommandParameter="{Binding .}"
														CornerRadius="9"
														FontSize="10"
														HeightRequest="18"
														IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
														Text="✕"
														TextColor="{StaticResource SparkAccentTealDark}"
														WidthRequest="18" />
												</HorizontalStackLayout>
											</Border>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</FlexLayout>
							</VerticalStackLayout>

							<!--  ЛЕКОВИ — search + dropdown + editable dosage/frequency  -->
							<VerticalStackLayout Spacing="8">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ЛЕКОВИ"
									TextColor="{StaticResource SparkTextSecondary}" />

								<Grid IsVisible="{Binding IsEditMode}">
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пребарај лек по име, генерик или код..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding MedicineSearchText}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Border
									Padding="4"
									BackgroundColor="{StaticResource SparkBackground}"
									IsVisible="{Binding ShowMedicineDropdown}"
									MaximumHeightRequest="200"
									Stroke="{StaticResource SparkAccentTealBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<CollectionView ItemsSource="{Binding MedicineResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="models:Medicine">
												<Grid Padding="8,6">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>
													<Label FontSize="13" Text="{Binding Name}" />
												</Grid>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Border>

								<CollectionView
									EmptyView="Нема евидентирани лекови."
									ItemsSource="{Binding AttachedMedicines}"
									SelectionMode="None">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="viewModels:AttachedMedicineRow">
											<Border
												Margin="0,0,0,8"
												Padding="12,10"
												BackgroundColor="{StaticResource SparkBackground}"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Grid
													ColumnDefinitions="*,Auto"
													ColumnSpacing="6"
													RowDefinitions="Auto,Auto"
													RowSpacing="6">

													<Label
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding PatientMedicine.Medicine.Name, FallbackValue='—'}"
														TextColor="{StaticResource SparkTextPrimary}" />

													<Label
														Grid.Column="1"
														FontFamily="FASolid"
														FontSize="13"
														IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
														Text="&#xf00d;"
														TextColor="{StaticResource SparkTextSecondary}">
														<Label.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}" />
														</Label.GestureRecognizers>
													</Label>

													<!--  EDIT: dosage entry + frequency picker  -->
													<Grid
														Grid.Row="1"
														Grid.ColumnSpan="2"
														ColumnDefinitions="*,*"
														ColumnSpacing="8"
														IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}">
														<Border Style="{StaticResource CompactFieldBoxStyle}">
															<Entry
																BackgroundColor="Transparent"
																FontSize="12"
																Placeholder="Доза (напр. 1 таблета)"
																Text="{Binding PatientMedicine.Dosage}"
																VerticalOptions="Center" />
														</Border>
														<Border Grid.Column="1" Style="{StaticResource CompactFieldBoxStyle}">
															<Picker
																BackgroundColor="Transparent"
																FontSize="12"
																ItemsSource="{StaticResource DosesFrequencyValues}"
																SelectedItem="{Binding PatientMedicine.DosesFrequency}" />
														</Border>
													</Grid>

													<!--  READ: dosage + frequency as plain text  -->
													<Label
														Grid.Row="1"
														Grid.ColumnSpan="2"
														FontSize="12"
														IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsReadOnly}"
														TextColor="{StaticResource SparkTextSecondary}">
														<Label.FormattedText>
															<FormattedString>
																<Span Text="{Binding PatientMedicine.Dosage}" />
																<Span Text=" · " />
																<Span Text="{Binding PatientMedicine.DosesFrequency}" />
															</FormattedString>
														</Label.FormattedText>
													</Label>

												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

							<!--  ДОКУМЕНТИ  -->
							<VerticalStackLayout Spacing="8">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ДОКУМЕНТИ"
									TextColor="{StaticResource SparkTextSecondary}" />

								<HorizontalStackLayout IsVisible="{Binding IsEditMode}" Spacing="10">
									<controls:FFButton
										ButtonKind="Secondary"
										Command="{Binding UploadDocumentCommand}"
										ContentPadding="16,0"
										HeightRequestEx="36"
										IsEnabled="{Binding IsUploadingDocument, Converter={StaticResource InvertedBoolConverter}}"
										Text="📎 Прикачи документ" />
									<ActivityIndicator
										IsRunning="{Binding IsUploadingDocument}"
										IsVisible="{Binding IsUploadingDocument}"
										Color="{StaticResource SparkAccentTeal}" />
								</HorizontalStackLayout>

								<CollectionView
									EmptyView="Нема прикачени документи."
									ItemsSource="{Binding Documents}"
									SelectionMode="None">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="models:PatientDocument">
											<Grid
												Padding="8,6"
												ColumnDefinitions="Auto,*,Auto"
												ColumnSpacing="8">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													Text="&#xf15b;"
													TextColor="{StaticResource SparkAccentTeal}"
													VerticalOptions="Center" />
												<Label
													Grid.Column="1"
													FontSize="12"
													LineBreakMode="TailTruncation"
													Text="{Binding FileName}"
													TextColor="{StaticResource SparkTextPrimary}"
													VerticalOptions="Center" />
												<Label
													Grid.Column="2"
													FontFamily="FASolid"
													FontSize="13"
													IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
													Text="&#xf1f8;"
													TextColor="{StaticResource SparkTextSecondary}"
													VerticalOptions="Center">
													<Label.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDocumentCommand}" CommandParameter="{Binding .}" />
													</Label.GestureRecognizers>
												</Label>
											</Grid>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

						</VerticalStackLayout>

						<!--  ================================================  -->
						<!--  COLUMN 2 — КОНТАКТ ИНФОРМАЦИИ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="4" Spacing="14">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="КОНТАКТ ИНФОРМАЦИИ" />
							</Border>

							<!--  Телефон  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Телефон *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Phone}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Телефон:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.Phone}" />
								</Grid>
							</Grid>

							<!--  Е-пошта  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Е-пошта *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Keyboard="Email"
											Placeholder="example@domain.com"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Email}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Е-пошта:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.Email}" />
								</Grid>
							</Grid>

							<!--  Град  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Град" />
									<Border Padding="14,0" Style="{StaticResource EditFieldBoxStyle}">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding Patient.City}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{Binding CityOptions}"
												Opacity="0"
												SelectedItem="{Binding Patient.City}" />
										</Grid>
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Град:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.City}" />
								</Grid>
							</Grid>

							<!--  Адреса  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Адреса" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Улица и број"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.Address}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Адреса:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.Address}" />
								</Grid>
							</Grid>

							<!--  Поштенски број  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Поштенски број" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. 1000"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.PostalCode}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Пошт. бр.:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.PostalCode}" />
								</Grid>
							</Grid>

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="ИТЕН КОНТАКТ" />
							</Border>

							<!--  Име и презиме на контакт  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Име и презиме" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Ана Петровска"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.EmergencyContactName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Име:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.EmergencyContactName}" />
								</Grid>
							</Grid>

							<!--  Телефон на контакт  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Телефонски број" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.EmergencyContactPhone}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Телефон:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.EmergencyContactPhone}" />
								</Grid>
							</Grid>

							<!--  Роднинска врска  -->
							<Grid Padding="10">
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Роднинска врска / Релација" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Сопруг/а, Родител..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Patient.EmergencyRelationship}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="90,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Релација:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Patient.EmergencyRelationship}" />
								</Grid>
							</Grid>

						</VerticalStackLayout>

					</Grid>
				</ScrollView>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
