												<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf471;" />
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding SelectedBloodTypeDisplay}" />
											</HorizontalStackLayout>
