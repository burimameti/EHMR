<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Patients.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dto="clr-namespace:EHMR.Services.Dto"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientDetailFormViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<x:Array x:Key="DosesFrequencyValues" Type="{x:Type models:DosesFrequency}">
				<models:DosesFrequency>Daily</models:DosesFrequency>
				<models:DosesFrequency>TwiceDaily</models:DosesFrequency>
				<models:DosesFrequency>ThreeTimesDaily</models:DosesFrequency>
				<models:DosesFrequency>EveryOtherDay</models:DosesFrequency>
				<models:DosesFrequency>EveryThreeDays</models:DosesFrequency>
				<models:DosesFrequency>Weekly</models:DosesFrequency>
				<models:DosesFrequency>Monthly</models:DosesFrequency>
				<models:DosesFrequency>Other</models:DosesFrequency>
			</x:Array>

			<converters:EncounterStatusToTextConverter x:Key="StatusTextConverter" />
			<converters:EncounterStatusToColorConverter x:Key="StatusColorConverter" />
			<converters:EncounterStatusToBgConverter x:Key="StatusBgConverter" />
			<converters:DocumentIsImageConverter x:Key="DocumentIsImageConverter" />

			<!--  ═══ ШАБЛОНИ ЗА ИСТОРИЈА НА ПАЦИЕНТОТ ═══  -->

			<DataTemplate x:Key="PatientDiagnosisRowTemplate" x:DataType="models:Diagnosis">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontFamily="Consolas"
							FontSize="12"
							Text="{Binding Mkb10Code.Code}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding Mkb10Code.Description}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientEncounterRowTemplate" x:DataType="models:Encounter">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Border
							Grid.Column="2"
							Padding="6,2"
							BackgroundColor="{Binding Status, Converter={StaticResource StatusBgConverter}}"
							StrokeShape="RoundRectangle 4"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="10"
								Text="{Binding Status, Converter={StaticResource StatusTextConverter}}"
								TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
						</Border>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientScoreRowTemplate" x:DataType="models:PatientScore">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding RecordedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ScoreText}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientAppointmentRowTemplate" x:DataType="models:Appointment">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleRowTemplate" x:DataType="models:TherapyCycle">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleHistoryRowTemplate" x:DataType="models:TherapyCycle">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="8,6"
						ColumnDefinitions="Auto,*,Auto"
						ColumnSpacing="10"
						RowDefinitions="Auto,Auto"
						RowSpacing="3">
						<Label
							Grid.RowSpan="2"
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding DecisionText, TargetNullValue='Без внесено решение'}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="2"
							FontSize="11"
							Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<HorizontalStackLayout
							Grid.Row="1"
							Grid.Column="1"
							Spacing="8">
							<Label
								FontSize="11"
								LineBreakMode="TailTruncation"
								Text="{Binding Notes, TargetNullValue='Без забелешка'}"
								TextColor="{StaticResource SparkTextSecondary}" />
							<Label
								FontSize="11"
								Text="{Binding Documents.Count, StringFormat='Документи: {0}'}"
								TextColor="{StaticResource SparkAccentTealDark}" />
						</HorizontalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientPrescriptionRowTemplate" x:DataType="models:Prescription">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid Padding="8,6" ColumnDefinitions="Auto,*">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding Status}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Label
							Grid.Column="1"
							Margin="10,0,0,0"
							FontSize="12"
							LineBreakMode="TailTruncation"
							Text="{Binding Notes}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</DataTemplate>

			<DataTemplate x:Key="PatientMedicineHistoryRowTemplate" x:DataType="models:PatientMedicine">
				<Border Style="{StaticResource CrudFormHistoryRowStyle}">
					<Grid
						Padding="10,8"
						ColumnDefinitions="*,Auto"
						RowDefinitions="Auto,Auto"
						RowSpacing="6">
						<HorizontalStackLayout Grid.Row="0" Spacing="8">
							<Label
								FontAttributes="Bold"
								FontSize="13"
								Text="{Binding Medicine.Name, FallbackValue='—'}"
								TextColor="{StaticResource SparkAccentTealDark}"
								VerticalOptions="Center" />
							<Border
								Padding="6,2"
								BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToActiveBadgeColorConverter}}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0"
								VerticalOptions="Center">
								<Label
									FontAttributes="Bold"
									FontSize="9"
									Text="{Binding IsActive, Converter={StaticResource BoolToActiveLabelConverter}}"
									TextColor="{StaticResource SparkBackground}" />
							</Border>
						</HorizontalStackLayout>
						<Label
							Grid.Row="0"
							Grid.Column="1"
							FontSize="11"
							Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<HorizontalStackLayout
							Grid.Row="1"
							Grid.ColumnSpan="2"
							Spacing="6">
							<Label
								FontSize="12"
								Text="{Binding Dosage, StringFormat='Количина: {0}'}"
								TextColor="{StaticResource SparkTextPrimary}" />
							<Label
								FontSize="12"
								Text="•"
								TextColor="{StaticResource SparkTextSecondary}" />
							<Label
								FontSize="12"
								Text="{Binding DosesFrequency}"
								TextColor="{StaticResource SparkTextSecondary}" />
						</HorizontalStackLayout>
					</Grid>
				</Border>
			</DataTemplate>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			Style="{StaticResource CrudFormPageGridStyle}">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->
			<Border
				Grid.Row="0"
				Margin="16,16,16,0"
				Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="{Binding HeaderTitle}" Subtitle="Преглед и управување со податоците за пациентот">
					<controls:FFPageHeader.HeaderContent />
				</controls:FFPageHeader>
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =====================================================  -->
			<Grid
				Grid.Row="1"
				Margin="16,0,16,0"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="6"
				Style="{StaticResource CrudFormBodyGridStyle}">
				<controls:FFSectionCard
					Grid.Column="0"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<controls:CustomScrollView
						x:Name="FormScrollView"
						Margin="0"
						Padding="0"
						ScrollBarColor="{StaticResource SparkAccentTeal}">
						<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">

							<!--  ═══════════════════════════════════════  -->
							<!--  ФОРМА — 3 КОЛОНИ  -->
							<!--  ═══════════════════════════════════════  -->
							<Grid
								Padding="0"
								ColumnDefinitions="24,*"
								ColumnSpacing="8"
								RowDefinitions="Auto,Auto,Auto"
								RowSpacing="18">
								<!--  COLUMN 0 — ЛИЧНИ ПОДАТОЦИ  -->
								<!--  ================================================  -->
								<VerticalStackLayout
									Grid.Row="0"
									Grid.Column="1"
									Spacing="16">

									<controls:CrudSectionHeader Title="ЛИЧНИ ИНФОРМАЦИИ" />

									<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
										<controls:FFStatusChip
											BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
											Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
											TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}" />
										<HorizontalStackLayout IsVisible="{Binding IsEditMode}" Spacing="6">
											<HorizontalStackLayout.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding SetInactiveCommand}" />
											</HorizontalStackLayout.GestureRecognizers>
											<CheckBox
												IsChecked="{Binding IsPatientInactive, Mode=OneWay}"
												IsEnabled="False"
												VerticalOptions="Center" />
											<Label
												FontAttributes="Bold"
												Text="Неактивен"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</HorizontalStackLayout>

									<VerticalStackLayout IsVisible="{Binding IsPatientInactive}" Spacing="8">
										<Label Style="{StaticResource EditFieldLabelStyle}" Text="Причина за неактивност *" />
										<Border IsEnabled="{Binding IsEditMode}" Style="{StaticResource TextAreaFieldBoxStyle}">
											<Editor
												AutoSize="TextChanges"
												FontSize="13"
												Placeholder="Внесете причина..."
												Text="{Binding InactiveReason, Mode=TwoWay}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
										<controls:FFButton
											ButtonKind="Secondary"
											Command="{Binding UploadDocumentCommand}"
											HeightRequestEx="36"
											IsVisible="{Binding IsEditMode}"
											Text="📎 Прикачи решение за неактивност" />
									</VerticalStackLayout>

									<!--  ── РЕД 1: Име | Презиме ────────────────────────  -->
									<Grid
										Padding="{StaticResource FormRowPadding}"
										ColumnDefinitions="*,*"
										ColumnSpacing="10">

										<VerticalStackLayout Grid.Column="0" Spacing="4">
											<Label
												IsVisible="{Binding IsEditMode}"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Име *" />
											<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Пр. Марко"
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding Patient.FirstName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>

											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label
													FontSize="11"
													Text="Име:"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="13"
													Text="{Binding Patient.FirstName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</VerticalStackLayout>

										<VerticalStackLayout Grid.Column="1" Spacing="4">
											<Label
												IsVisible="{Binding IsEditMode}"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Презиме *" />
											<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Пр. Петровски"
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding Patient.LastName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>

											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label
													FontSize="11"
													Text="Презиме:"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="13"
													Text="{Binding Patient.LastName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</VerticalStackLayout>

									</Grid>

									<!--  ── РЕД 3: Датум на раѓање | Пол ────────────────  -->
									<Grid
										Padding="{StaticResource FormRowPadding}"
										ColumnDefinitions="*,*"
										ColumnSpacing="10">

										<VerticalStackLayout Grid.Column="0" Spacing="4">
											<Label
												IsVisible="{Binding IsEditMode}"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Датум на раѓање" />
											<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
												<Grid ColumnDefinitions="*,Auto">
													<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
													<Label Grid.Column="1" Style="{StaticResource FieldBoxCalendarIconStyle}" />
													<DatePicker
														Grid.ColumnSpan="2"
														BackgroundColor="Transparent"
														Date="{Binding Patient.BirthDate}"
														Format="dd.MM.yyyy"
														Opacity="0" />
												</Grid>
											</Border>

											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label
													FontSize="11"
													Text="Роден:"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Border Style="{StaticResource InfoPillBorderStyle}">
													<HorizontalStackLayout Spacing="6">
														<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf073;" />
														<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
													</HorizontalStackLayout>
												</Border>
											</VerticalStackLayout>
										</VerticalStackLayout>

										<VerticalStackLayout Grid.Column="1" Spacing="4">
											<Label
												IsVisible="{Binding IsEditMode}"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Пол *" />
											<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
												<Grid ColumnDefinitions="*,Auto">
													<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedGenderDisplay}" />
													<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
													<Picker
														Grid.ColumnSpan="2"
														BackgroundColor="Transparent"
														ItemsSource="{Binding GenderOptions}"
														Opacity="0"
														SelectedItem="{Binding SelectedGenderDisplay}" />
												</Grid>
											</Border>

											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label
													FontSize="11"
													Text="Пол:"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Border Style="{StaticResource InfoPillBorderStyle}">
													<HorizontalStackLayout Spacing="6">
														<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />
														<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding SelectedGenderDisplay}" />
													</HorizontalStackLayout>
												</Border>
											</VerticalStackLayout>
										</VerticalStackLayout>

									</Grid>

									<!--  ДОКУМЕНТИ / РЕШЕНИЕ  -->
									<Grid
										Padding="{StaticResource FormRowPadding}"
										ColumnDefinitions="*,*"
										ColumnSpacing="10">
										<VerticalStackLayout Grid.Column="0" Spacing="4">
											<Label
												IsVisible="{Binding IsEditMode}"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="ЗБО *" />
											<Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Здравствен број"
													Text="{Binding Patient.SzboNumber}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label
													FontSize="11"
													Text="ЗБО:"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="13"
													Text="{Binding Patient.SzboNumber}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</VerticalStackLayout>
									</Grid>

									<controls:CrudSectionHeader Title="ДОКУМЕНТИ НА ПАЦИЕНТ" />

									<Border
										Padding="14"
										BackgroundColor="{StaticResource SparkBackground}"
										Stroke="{StaticResource SparkAccentTealBg}"
										StrokeShape="RoundRectangle 12"
										StrokeThickness="1">
										<VerticalStackLayout Spacing="12">
											<HorizontalStackLayout IsVisible="{Binding IsEditMode}" Spacing="10">
												<controls:FFButton
													ButtonKind="Secondary"
													Command="{Binding UploadDocumentCommand}"
													ContentPadding="16,0"
													HeightRequestEx="36"
													IsEnabled="{Binding IsUploadingDocument, Converter={StaticResource InvertedBoolConverter}}"
													Text="📎 Прикачи документ" />
												<ActivityIndicator
													IsRunning="{Binding IsUploadingDocument}"
													IsVisible="{Binding IsUploadingDocument}"
													Color="{StaticResource SparkAccentTeal}" />
											</HorizontalStackLayout>

											<CollectionView ItemsSource="{Binding Documents}" SelectionMode="None">
												<CollectionView.EmptyView>
													<Label
														Padding="0,6"
														FontSize="12"
														Text="Нема прикачени документи."
														TextColor="{StaticResource SparkTextSecondary}" />
												</CollectionView.EmptyView>
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="dto:PatientDocumentDto">
														<Border
															Margin="0,0,0,8"
															Padding="10,8"
															BackgroundColor="{StaticResource SparkBackground}"
															Stroke="{StaticResource SparkAccentTealBg}"
															StrokeShape="RoundRectangle 8"
															StrokeThickness="1">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<Grid ColumnDefinitions="36,*,Auto,Auto" ColumnSpacing="10">
																<Border
																	BackgroundColor="{StaticResource SparkAccentTealBg}"
																	HeightRequest="36"
																	StrokeShape="RoundRectangle 8"
																	StrokeThickness="0"
																	WidthRequest="36">
																	<Grid>
																		<Image
																			Aspect="AspectFill"
																			IsVisible="{Binding ., Converter={StaticResource DocumentIsImageConverter}}"
																			Source="{Binding StoredPath}" />
																		<Label
																			FontFamily="FASolid"
																			FontSize="14"
																			HorizontalOptions="Center"
																			IsVisible="{Binding ., Converter={StaticResource DocumentIsImageConverter}, ConverterParameter=Invert}"
																			Text="&#xf15b;"
																			TextColor="{StaticResource SparkAccentTealDark}"
																			VerticalOptions="Center" />
																	</Grid>
																</Border>

																<Label
																	Grid.Column="1"
																	FontSize="13"
																	LineBreakMode="TailTruncation"
																	Text="{Binding FileName}"
																	TextColor="{StaticResource SparkTextPrimary}"
																	VerticalOptions="Center" />

																<Label
																	Grid.Column="2"
																	FontFamily="FASolid"
																	FontSize="14"
																	Text="&#xf019;"
																	TextColor="{StaticResource SparkAccentTealDark}"
																	VerticalOptions="Center">
																	<Label.GestureRecognizers>
																		<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DownloadDocumentCommand}" CommandParameter="{Binding .}" />
																	</Label.GestureRecognizers>
																</Label>

																<Label
																	Grid.Column="3"
																	FontFamily="FASolid"
																	FontSize="14"
																	IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																	Text="&#xf1f8;"
																	TextColor="#DC2626"
																	VerticalOptions="Center">
																	<Label.GestureRecognizers>
																		<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDocumentCommand}" CommandParameter="{Binding .}" />
																	</Label.GestureRecognizers>
																</Label>
															</Grid>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</VerticalStackLayout>
									</Border>

								</VerticalStackLayout>

								<!--  ================================================  -->
								<!--  COLUMN 1 — МЕДИЦИНСКИ ПОДАТОЦИ  -->
								<VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="12">

									<controls:CrudSectionHeader Title="МЕДИЦИНСКИ ПОДАТОЦИ" />

									<!--  РЕД 1: РЕУМАТОЛОГ | МОМЕНТАЛЕН СКОР  -->
									<Grid Padding="{StaticResource FormRowPadding}" ColumnDefinitions="*,*" ColumnSpacing="12">

										<!--  РЕУМАТОЛОГ  -->
										<VerticalStackLayout Grid.Column="0" Spacing="5">
											<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="5">
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
													<Label Grid.Column="0" Style="{StaticResource EditFieldLabelStyle}" Text="Реуматолог *" VerticalOptions="Center" />
													<HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="5" VerticalOptions="Center">
														<CheckBox HeightRequest="22" IsChecked="{Binding UseCyrillicDoctorSearch, Mode=TwoWay}" VerticalOptions="Center" WidthRequest="22" />
														<Label FontAttributes="Bold" FontSize="11" Text="Кирилица" TextColor="{StaticResource SparkAccentTealDark}" VerticalOptions="Center" />
													</HorizontalStackLayout>
												</Grid>

												<Border HeightRequest="44" Style="{StaticResource EditFieldBoxStyle}">
													<Grid ColumnDefinitions="Auto,*">
														<Label Grid.Column="0" Margin="10,0,5,0" FontFamily="FASolid" FontSize="12" Text="&#xf002;" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
														<Entry Grid.Column="1" BackgroundColor="Transparent" FontSize="13" Placeholder="Пребарај реуматолог..." PlaceholderColor="{StaticResource SparkTextSecondary}" Text="{Binding DoctorSearchText, Mode=TwoWay}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
													</Grid>
												</Border>

												<Border IsVisible="{Binding ShowDoctorDropdown}" Style="{StaticResource SearchDropdownBorderStyle}" ZIndex="100">
													<CollectionView HeightRequest="164" ItemsSource="{Binding DoctorSearchResults}" SelectionMode="None">
														<CollectionView.ItemTemplate>
															<DataTemplate x:DataType="dto:DoctorDto">
																<Grid Padding="10,8">
																	<Grid.GestureRecognizers>
																		<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectDoctorCommand}" CommandParameter="{Binding .}" />
																	</Grid.GestureRecognizers>
																	<VerticalStackLayout Spacing="2">
																		<Label FontAttributes="Bold" FontSize="12.5" Text="{Binding DisplayName}" TextColor="{StaticResource SparkTextPrimary}" />
																		<Label FontSize="10" Text="{Binding Specialty}" TextColor="{StaticResource SparkTextSecondary}" />
																	</VerticalStackLayout>
																</Grid>
															</DataTemplate>
														</CollectionView.ItemTemplate>
													</CollectionView>
												</Border>

												<Border BackgroundColor="{StaticResource SparkTabActiveBg}" IsVisible="{Binding SelectedDoctorDisplay, Converter={StaticResource StringNotEmptyConverter}}" Stroke="{StaticResource SparkAccentTealBg}" Style="{StaticResource InfoPillBorderStyle}">
													<Grid Padding="10,7" ColumnDefinitions="Auto,*" ColumnSpacing="8">
														<Label Grid.Column="0" Style="{StaticResource InfoPillIconStyle}" Text="&#xf0f0;" VerticalOptions="Center" />
														<Label Grid.Column="1" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" Text="{Binding SelectedDoctorDisplay}" TextColor="{StaticResource SparkAccentTealDark}" />
													</Grid>
												</Border>
										</VerticalStackLayout>

											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label FontSize="10" Text="Реуматолог" TextColor="{StaticResource SparkTextSecondary}" />
												<Label FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" Text="{Binding SelectedDoctorDisplay}" TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</VerticalStackLayout>

										<!--  МОМЕНТАЛЕН СКОР  -->
										<VerticalStackLayout Grid.Column="1" Spacing="5">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Моментален скор" />
											<Border HeightRequest="44" IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
												<Entry BackgroundColor="Transparent" FontSize="13" Placeholder="Внесете скор" Text="{Binding CurrentPatientScore, Mode=TwoWay}" />
											</Border>
											<Label FontAttributes="Bold" FontSize="13" IsVisible="{Binding IsReadOnly}" Text="{Binding CurrentPatientScore, FallbackValue='—'}" TextColor="{StaticResource SparkAccentTealDark}" />
										</VerticalStackLayout>

									</Grid>

									<!--  РЕД 2: МКБ-10 | ЛЕК  -->
									<Grid Padding="{StaticResource FormRowPadding}" ColumnDefinitions="*,*" ColumnSpacing="12">

										<!--  МКБ-10  -->
										<VerticalStackLayout Grid.Column="0" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="МКБ-10" />
											<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="6">
												<Border HeightRequest="44" Style="{StaticResource EditFieldBoxStyle}">
													<Entry BackgroundColor="Transparent" FontSize="13" Placeholder="Пребарај код или дијагноза..." Text="{Binding MkbSearchText, Mode=TwoWay}" />
												</Border>
												<Border IsVisible="{Binding ShowMkbDropdown}" Style="{StaticResource SearchDropdownBorderStyle}" ZIndex="100">
													<CollectionView HeightRequest="140" ItemsSource="{Binding MkbResults}" SelectionMode="None">
														<CollectionView.ItemTemplate>
															<DataTemplate x:DataType="dto:Mkb10CodeDto">
																<Grid Padding="9,7">
																	<Grid.GestureRecognizers>
																		<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
																	</Grid.GestureRecognizers>
																	<VerticalStackLayout Spacing="1">
																		<Label FontAttributes="Bold" FontSize="12" Text="{Binding Code}" TextColor="{StaticResource SparkTextPrimary}" />
																		<Label FontSize="10" Text="{Binding Description}" TextColor="{StaticResource SparkTextSecondary}" />
																	</VerticalStackLayout>
																</Grid>
															</DataTemplate>
													</CollectionView.ItemTemplate>
												</CollectionView>
											</Border>
										</VerticalStackLayout>

											<CollectionView ItemsSource="{Binding Diagnoses}" SelectionMode="None">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="dto:DiagnosisDto">
														<Grid Padding="6,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
															<Label FontAttributes="Bold" Text="{Binding Mkb10Code}" TextColor="{StaticResource SparkAccentTealDark}" />
															<Label Grid.Column="1" LineBreakMode="TailTruncation" Text="{Binding Mkb10Description}" />
															<Label Grid.Column="2" FontFamily="FASolid" Text="&#xf1f8;" TextColor="#DC2626">
																<Label.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}" CommandParameter="{Binding .}" />
																</Label.GestureRecognizers>
															</Label>
														</Grid>
													</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

										<!--  ЛЕК  -->
										<VerticalStackLayout Grid.Column="1" Spacing="6">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Лек" />
											<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="6">
												<Border HeightRequest="44" Style="{StaticResource EditFieldBoxStyle}">
													<Entry BackgroundColor="Transparent" FontSize="13" Placeholder="Пребарај лек..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />
												</Border>
												<CollectionView HeightRequest="140" IsVisible="{Binding ShowMedicineDropdown}" ItemsSource="{Binding MedicineResults}" SelectionMode="None">
													<CollectionView.ItemTemplate>
														<DataTemplate x:DataType="dto:MedicineDto">
															<Border Margin="0,1" Padding="9,7" BackgroundColor="{StaticResource SparkTabActiveBg}" StrokeThickness="0">
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
																</Border.GestureRecognizers>
																<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
																	<VerticalStackLayout Spacing="1">
																		<Label FontAttributes="Bold" FontSize="12" Text="{Binding Name}" TextColor="{StaticResource SparkTextPrimary}" />
																		<Label FontSize="10" Text="{Binding GenericName}" TextColor="{StaticResource SparkTextSecondary}" />
																	</VerticalStackLayout>
																	<Label Grid.Column="1" FontSize="10" Text="{Binding Strength, StringFormat='Јачина: {0}'}" TextColor="{StaticResource SparkAccentTealDark}" VerticalOptions="Center" />
																</Grid>
															</Border>
														</DataTemplate>
													</CollectionView.ItemTemplate>
												</CollectionView>

												<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachedMedicines}" Spacing="8">
													<BindableLayout.ItemTemplate>
													<DataTemplate x:DataType="viewModels:AttachedMedicineRow">
														<Grid ColumnDefinitions="1.3*,1*,1.25*,0.8*,Auto" ColumnSpacing="8">
															<VerticalStackLayout Spacing="3">
																<Label FontSize="10" Text="Лек" TextColor="{StaticResource SparkTextSecondary}" />
																<Border HeightRequest="40" Style="{StaticResource EditFieldBoxStyle}">
																	<Label Padding="10,0" FontAttributes="Bold" FontSize="12" Text="{Binding MedicineName}" TextColor="{StaticResource SparkTextPrimary}" VerticalTextAlignment="Center" />
																</Border>
															</VerticalStackLayout>
															<VerticalStackLayout Grid.Column="1" Spacing="3">
																<Label FontSize="10" Text="Доза" TextColor="{StaticResource SparkTextSecondary}" />
																<Border HeightRequest="40" Style="{StaticResource EditFieldBoxStyle}">
																	<Entry BackgroundColor="Transparent" FontSize="12" Text="{Binding PatientMedicine.Dosage, Mode=TwoWay}" />
																</Border>
															</VerticalStackLayout>
															<VerticalStackLayout Grid.Column="2" Spacing="3">
																<Label FontSize="10" Text="Начин на апликација" TextColor="{StaticResource SparkTextSecondary}" />
																<Border HeightRequest="40" Style="{StaticResource EditFieldBoxStyle}">
																	<Grid ColumnDefinitions="*,Auto">
																		<Label Padding="10,0" Style="{StaticResource FieldBoxValueStyle}" Text="{Binding PatientMedicine.ApplicationRegime, FallbackValue='Изберете...'}" />
																		<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
																		<Picker Grid.ColumnSpan="2" BackgroundColor="Transparent" ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}" Opacity="0" SelectedItem="{Binding PatientMedicine.ApplicationRegime, Mode=TwoWay}" />
																	</Grid>
																</Border>
															</VerticalStackLayout>
															<VerticalStackLayout Grid.Column="3" Spacing="3">
																<Label FontSize="10" Text="Количина" TextColor="{StaticResource SparkTextSecondary}" />
																<Border HeightRequest="40" Style="{StaticResource EditFieldBoxStyle}">
																	<Entry BackgroundColor="Transparent" FontSize="12" Keyboard="Numeric" Text="{Binding PatientMedicine.Quantity, Mode=TwoWay}" />
																</Border>
															</VerticalStackLayout>
															<Button Grid.Column="4" Padding="0" BackgroundColor="Transparent" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}" FontSize="12" Text="✕" TextColor="#DC2626" VerticalOptions="End" WidthRequest="30" />
														</Grid>
													</DataTemplate>
												</BindableLayout.ItemTemplate>
											</VerticalStackLayout>
										</VerticalStackLayout>
									</Grid>

								</VerticalStackLayout>
								<!--  COLUMN 2 — КОНТАКТ ИНФОРМАЦИИ  -->
								<!--  ================================================  -->
								<VerticalStackLayout
									Grid.Row="1"
									Grid.Column="1"
									Spacing="16">
									<controls:CrudSectionHeader Title="КОНТАКТ И ИТЕН КОНТАКТ" />

									<Grid
										Padding="{StaticResource FormRowPadding}"
										ColumnDefinitions="*,*"
										ColumnSpacing="16">
										<VerticalStackLayout
											Grid.Column="0"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Телефон" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Keyboard="Telephone"
													Placeholder="+389 7X XXX XXX"
													Text="{Binding Patient.Phone}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border
											Grid.Column="0"
											IsVisible="{Binding IsReadOnly}"
											Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Телефон:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Phone}" />
											</VerticalStackLayout>
										</Border>
										<VerticalStackLayout
											Grid.Column="1"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Е-пошта" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Keyboard="Email"
													Placeholder="email@example.com"
													Text="{Binding Patient.Email}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border
											Grid.Column="1"
											IsVisible="{Binding IsReadOnly}"
											Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Е-пошта:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Email}" />
											</VerticalStackLayout>
										</Border>
									</Grid>

									<Grid
										Padding="{StaticResource FormRowPadding}"
										ColumnDefinitions="*,*"
										ColumnSpacing="16">
										<VerticalStackLayout
											Grid.Column="0"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Град" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Picker
													BackgroundColor="Transparent"
													ItemsSource="{Binding CityOptions}"
													SelectedItem="{Binding SelectedCityDisplay}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border
											Grid.Column="0"
											IsVisible="{Binding IsReadOnly}"
											Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Град:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding SelectedCityDisplay}" />
											</VerticalStackLayout>
										</Border>
										<VerticalStackLayout
											Grid.Column="1"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Адреса" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Улица и број"
													Text="{Binding Patient.Address}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<Border
											Grid.Column="1"
											IsVisible="{Binding IsReadOnly}"
											Style="{StaticResource CrudFormValueSurfaceStyle}">
											<VerticalStackLayout Spacing="4">
												<Label Style="{StaticResource ReadRowLabelStyle}" Text="Адреса:" />
												<Label Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.Address}" />
											</VerticalStackLayout>
										</Border>
									</Grid>


									<Grid
										Padding="{StaticResource FormRowPadding}"
										ColumnDefinitions="*,*,*"
										ColumnSpacing="10">
										<VerticalStackLayout
											Grid.Column="0"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Итен контакт" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Име и презиме"
													Text="{Binding Patient.EmergencyContactName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.Column="1"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Телефон" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Keyboard="Telephone"
													Placeholder="+389..."
													Text="{Binding Patient.EmergencyContactPhone}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.Column="2"
											IsVisible="{Binding IsEditMode}"
											Spacing="4">
											<Label Style="{StaticResource EditFieldLabelStyle}" Text="Однос" />
											<Border Style="{StaticResource EditFieldBoxStyle}">
												<Picker
													BackgroundColor="Transparent"
													ItemsSource="{Binding RelationOptions}"
													SelectedItem="{Binding SelectedRelationDisplay}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.ColumnSpan="3"
											IsVisible="{Binding IsReadOnly}"
											Spacing="2">
											<Label
												FontSize="10"
												Text="Итен контакт"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="{Binding Patient.EmergencyContactName}"
												TextColor="{StaticResource SparkTextPrimary}" />
											<Label
												FontSize="12"
												Text="{Binding Patient.EmergencyContactPhone}"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontSize="12"
												Text="{Binding Patient.EmergencyRelationship}"
												TextColor="{StaticResource SparkTextSecondary}" />
										</VerticalStackLayout>
									</Grid>
								</VerticalStackLayout>
							</Grid>
							<BoxView
								BackgroundColor="{StaticResource PageBackground}"
								HeightRequest="1"
								HorizontalOptions="Fill" />
							<HorizontalStackLayout
								Grid.Column="2"
								HorizontalOptions="End"
								Spacing="6"
								VerticalOptions="Center">
								<controls:FFButton
									ButtonKind="Secondary"
									Command="{Binding CancelCommand}"
									ContentPadding="24,0"
									HeightRequestEx="42"
									IsVisible="{Binding IsEditMode}"
									Text="Откажи" />
								<controls:FFButton
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									ButtonKind="Primary"
									Command="{Binding SaveCommand}"
									ContentPadding="24,0"
									HeightRequestEx="42"
									IsVisible="{Binding IsEditMode}"
									Text="Зачувај"
									TextColorEx="{StaticResource SidebarActiveText}" />
								<controls:FFButton
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									ButtonKind="Primary"
									Command="{Binding ToggleEditModeAsyncCommand}"
									ContentPadding="24,0"
									HeightRequestEx="42"
									IsVisible="{Binding IsReadOnly}"
									Text="Уреди"
									TextColorEx="{StaticResource SidebarActiveText}" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</controls:CustomScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ИСТОРИЈА + ДОКУМЕНТИ (со preview)  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="1"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<controls:CustomScrollView
						Margin="0"
						Padding="0"
						ScrollBarColor="{StaticResource SparkAccentTeal}">
						<VerticalStackLayout Style="{StaticResource CrudFormSidebarStackStyle}">
							<!--  ═══════════════════════════════════════════════════  -->
							<!--  ИСТОРИЈА НА ПАЦИЕНТОТ — секогаш видлива, marker+row  -->
							<!--  ═══════════════════════════════════════════════════  -->
							<VerticalStackLayout Padding="0" Spacing="16">

								<controls:CrudSectionHeader Title="ИСТОРИЈА НА ПАЦИЕНТОТ" Margin="-3,0,0,0" />

								<VerticalStackLayout Spacing="10">

									<controls:SparkExpandableCard
										Title="Прегледи"
										EmptyViewText="Нема евидентирани прегледи."
										ItemTemplate="{StaticResource PatientEncounterRowTemplate}"
										ItemsSource="{Binding EncounterHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Encounter" />

									<controls:SparkExpandableCard
										Title="Оценки"
										EmptyViewText="Нема евидентирани оценки."
										ItemTemplate="{StaticResource PatientScoreRowTemplate}"
										ItemsSource="{Binding ScoreHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Encounter" />

									<controls:SparkExpandableCard
										Title="Термини"
										EmptyViewText="Нема закажани термини."
										ItemTemplate="{StaticResource PatientAppointmentRowTemplate}"
										ItemsSource="{Binding AppointmentHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Appointment" />

									<controls:SparkExpandableCard
										Title="Активни терапии"
										EmptyViewText="Нема активни терапии."
										ItemTemplate="{StaticResource PatientTherapyCycleHistoryRowTemplate}"
										ItemsSource="{Binding ActiveTherapies}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Encounter" />

									<controls:SparkExpandableCard
										Title="Претходни терапии"
										EmptyViewText="Нема претходни терапии."
										ItemTemplate="{StaticResource PatientTherapyCycleHistoryRowTemplate}"
										ItemsSource="{Binding PreviousTherapies}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Encounter" />

									<controls:SparkExpandableCard
										Title="Дијагнози"
										EmptyViewText="Нема евидентирани дијагнози."
										ItemTemplate="{StaticResource PatientDiagnosisRowTemplate}"
										ItemsSource="{Binding DiagnosisHistory}"
										Style="{StaticResource CrudFormHistoryCardStyle}"
										Variant="Diagnosis" />

								</VerticalStackLayout>

								<!--  ═══════════════════════════════════════════════  -->
								<!--  ДОКУМЕНТИ НА ПАЦИЕНТ  -->
								<!--  ═══════════════════════════════════════════════  -->
								<controls:CrudSectionHeader Title="ДОКУМЕНТИ НА ПАЦИЕНТ" />

								<!--  Голем преглед на избраниот документ  -->
								<Border
									Padding="10"
									BackgroundColor="{StaticResource SparkContentBackground}"
									IsVisible="{Binding HasDocumentPreview}"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 12"
									StrokeThickness="1">
									<VerticalStackLayout Spacing="8">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontAttributes="Bold"
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedDocumentPreview.FileName}"
												TextColor="{StaticResource SparkTextPrimary}" />
											<Label
												Grid.Column="1"
												FontFamily="FASolid"
												FontSize="13"
												Text="&#xf00d;"
												TextColor="{StaticResource SparkTextSecondary}">
												<Label.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding ClosePreviewCommand}" />
												</Label.GestureRecognizers>
											</Label>
										</Grid>

										<!--  Слика — inline преглед  -->
										<Border
											HeightRequest="180"
											IsVisible="{Binding SelectedDocumentPreview, Converter={StaticResource DocumentIsImageConverter}}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Image Aspect="AspectFill" Source="{Binding SelectedDocumentPreview.StoredPath}" />
										</Border>

										<!--  Не-слика — плејсхолдер (отвора се преку системска апликација)  -->
										<Border
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											HeightRequest="120"
											IsVisible="{Binding SelectedDocumentPreview, Converter={StaticResource DocumentIsImageConverter}, ConverterParameter=Invert}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<VerticalStackLayout
												HorizontalOptions="Center"
												Spacing="4"
												VerticalOptions="Center">
												<Label
													FontFamily="FASolid"
													FontSize="30"
													HorizontalOptions="Center"
													Text="&#xf15b;"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<Label
													FontSize="10"
													HorizontalOptions="Center"
													Text="Нема достапен преглед за овој тип на документ"
													TextColor="{StaticResource SparkTextSecondary}" />
											</VerticalStackLayout>
										</Border>

										<controls:FFButton
											BackgroundColorEx="{StaticResource SidebarActiveBg}"
											ButtonKind="Primary"
											Command="{Binding DownloadDocumentCommand}"
											CommandParameter="{Binding SelectedDocumentPreview}"
											HeightRequestEx="36"
											IsEnabled="{Binding IsDownloadingDocument, Converter={StaticResource InvertedBoolConverter}}"
											Text="⬇ Преземи"
											TextColorEx="{StaticResource SidebarActiveText}" />
									</VerticalStackLayout>
								</Border>
								<!--  Мрежа со сите документи  -->
								<FlexLayout
									Padding="12"
									BackgroundColor="{StaticResource SparkContentBackground}"
									BindableLayout.ItemsSource="{Binding Documents}"
									Direction="Row"
									JustifyContent="Start"
									Wrap="Wrap">
									<BindableLayout.EmptyView>
										<Label
											FontSize="13"
											Text="Нема прикачени документи."
											TextColor="{StaticResource SparkTextSecondary}" />
									</BindableLayout.EmptyView>
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="dto:PatientDocumentDto">
											<Border
												Margin="0,0,8,8"
												Padding="0"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												HeightRequest="120"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeShape="RoundRectangle 12"
												StrokeThickness="1"
												WidthRequest="120">
												<Border.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
												</Border.GestureRecognizers>
												<Grid RowDefinitions="*,Auto" RowSpacing="0">
													<Grid Grid.Row="0">
														<Image
															Aspect="AspectFill"
															IsVisible="{Binding ., Converter={StaticResource DocumentIsImageConverter}}"
															Source="{Binding StoredPath}" />
														<Border
															BackgroundColor="{StaticResource SparkAccentTealBg}"
															IsVisible="{Binding ., Converter={StaticResource DocumentIsImageConverter}, ConverterParameter=Invert}"
															StrokeThickness="0">
															<Label
																FontFamily="FASolid"
																FontSize="26"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Margin="4"
															Padding="4,3"
															BackgroundColor="#99000000"
															HorizontalOptions="End"
															StrokeShape="RoundRectangle 6"
															StrokeThickness="0"
															VerticalOptions="Start">
															<Label
																FontFamily="FASolid"
																FontSize="9"
																Text="&#xf00e;"
																TextColor="White" />
														</Border>
													</Grid>
													<Border
														Grid.Row="1"
														Padding="6,4"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeThickness="0">
														<VerticalStackLayout Spacing="1">
															<Label
																FontAttributes="Bold"
																FontSize="9"
																LineBreakMode="TailTruncation"
																Text="{Binding FileName}"
																TextColor="{StaticResource SparkTextPrimary}" />
															<Label
																FontSize="8"
																Text="{Binding UploadedAt, StringFormat='{0:dd.MM.yyyy}'}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</Grid>
											</Border>

										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</FlexLayout>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</controls:CustomScrollView>
				</controls:FFSectionCard>

			</Grid>
		</Grid>
	</Grid>
</ContentPage>