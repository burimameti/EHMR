													FontSize="10"
													Text="Алергии"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="13"
													LineBreakMode="WordWrap"
													Text="{Binding Patient.Allergies, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</VerticalStackLayout>

									</Grid>

								</VerticalStackLayout>


																<controls:CrudSectionHeader Title="ДИЈАГНОЗИ / МКБ-10" />
