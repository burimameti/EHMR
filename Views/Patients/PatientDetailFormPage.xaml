<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Patients.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:dto="clr-namespace:EHMR.Services.Dto"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientDetailFormViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<x:Array x:Key="DosesFrequencyValues" Type="{x:Type models:DosesFrequency}">
				<models:DosesFrequency>Daily</models:DosesFrequency>
				<models:DosesFrequency>TwiceDaily</models:DosesFrequency>
				<models:DosesFrequency>ThreeTimesDaily</models:DosesFrequency>
				<models:DosesFrequency>EveryOtherDay</models:DosesFrequency>
				<models:DosesFrequency>EveryThreeDays</models:DosesFrequency>
				<models:DosesFrequency>Weekly</models:DosesFrequency>
				<models:DosesFrequency>Monthly</models:DosesFrequency>
				<models:DosesFrequency>Other</models:DosesFrequency>
			</x:Array>

			<converters:EncounterStatusToTextConverter x:Key="StatusTextConverter" />
			<converters:EncounterStatusToColorConverter x:Key="StatusColorConverter" />
			<converters:EncounterStatusToBgConverter x:Key="StatusBgConverter" />

			<!--  ═══ ШАБЛОНИ ЗА ИСТОРИЈА НА ПАЦИЕНТОТ ═══  -->

			<DataTemplate x:Key="PatientDiagnosisRowTemplate" x:DataType="models:Diagnosis">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontFamily="Consolas"
						FontSize="12"
						Text="{Binding Mkb10Code.Code}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Mkb10Code.Description}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientEncounterRowTemplate" x:DataType="models:Encounter">
				<Grid
					Padding="8,6"
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="10">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
					<Border
						Grid.Column="2"
						Padding="6,2"
						BackgroundColor="{Binding Status, Converter={StaticResource StatusBgConverter}}"
						StrokeShape="RoundRectangle 4"
						StrokeThickness="0"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="10"
							Text="{Binding Status, Converter={StaticResource StatusTextConverter}}"
							TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
					</Border>
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientAppointmentRowTemplate" x:DataType="models:Appointment">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding ClinicalNotes, TargetNullValue='Без забелешка'}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientTherapyCycleRowTemplate" x:DataType="models:TherapyCycle">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientPrescriptionRowTemplate" x:DataType="models:Prescription">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<DataTemplate x:Key="PatientMedicineHistoryRowTemplate" x:DataType="models:PatientMedicine">
				<Grid
					Padding="10,8"
					ColumnDefinitions="*,Auto"
					RowDefinitions="Auto,Auto"
					RowSpacing="6">
					<HorizontalStackLayout Grid.Row="0" Spacing="8">
						<Label
							FontAttributes="Bold"
							FontSize="13"
							Text="{Binding Medicine.Name, FallbackValue='—'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Border
							Padding="6,2"
							BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToActiveBadgeColorConverter}}"
							StrokeShape="RoundRectangle 8"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="9"
								Text="{Binding IsActive, Converter={StaticResource BoolToActiveLabelConverter}}"
								TextColor="{StaticResource SparkBackground}" />
						</Border>
					</HorizontalStackLayout>
					<Label
						Grid.Row="0"
						Grid.Column="1"
						FontSize="11"
						Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
						TextColor="{StaticResource SparkTextSecondary}"
						VerticalOptions="Center" />
					<HorizontalStackLayout
						Grid.Row="1"
						Grid.ColumnSpan="2"
						Spacing="6">
						<Label
							FontSize="12"
							Text="{Binding Dosage, StringFormat='Количина: {0}'}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontSize="12"
							Text="•"
							TextColor="{StaticResource SparkTextSecondary}" />
						<Label
							FontSize="12"
							Text="{Binding DosesFrequency}"
							TextColor="{StaticResource SparkTextSecondary}" />
					</HorizontalStackLayout>
				</Grid>
			</DataTemplate>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="290,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
            Grid.Column="1"
            Margin="12,0,12,12"
            RowDefinitions="Auto,*"
            RowSpacing="0">

			<!--  =========================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =========================================================  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<!--  Avatar circle  -->
					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf007;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<!--  Title + status chip  -->
					<VerticalStackLayout
						Grid.Column="1"
						Spacing="6"
						VerticalOptions="Center">
						<Label Style="{StaticResource PageTitleStyle}" Text="{Binding HeaderTitle}" />
						<controls:FFStatusChip
							BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
							HorizontalOptions="Start"
							IsVisible="{Binding IsEditMode}"
							Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
							TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}"
							VerticalOptions="Start" />
					</VerticalStackLayout>

					<!--  Action buttons  -->


				</Grid>
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =====================================================  -->
			<Border Grid.Row="1" Style="{StaticResource PageHeaderCardStyle}">
				<controls:CustomScrollView
					x:Name="FormScrollView"
					Margin="0"
					Padding="0"
					ScrollBarColor="{StaticResource SparkAccentTeal}">
					<VerticalStackLayout Padding="6" Spacing="6">

						<!--  ═══════════════════════════════════════  -->
						<!--  ФОРМА — 3 КОЛОНИ  -->
						<!--  ═══════════════════════════════════════  -->
						<Grid
							Padding="12,0"
							ColumnDefinitions="*,1,*,1,*"
							ColumnSpacing="22">

							<BoxView Grid.Column="1" Style="{StaticResource ColumnDividerStyle}" />
							<BoxView Grid.Column="3" Style="{StaticResource ColumnDividerStyle}" />

							<!--  ================================================  -->
							<!--  COLUMN 0 — ЛИЧНИ ПОДАТОЦИ  -->
							<!--  ================================================  -->
							<VerticalStackLayout Grid.Column="0" Spacing="16">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ЛИЧНИ ПОДАТОЦИ" />
								</Border>

								<!--  Име  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Име *" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Марко"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.FirstName}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Име:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.FirstName}" />
									</Grid>
								</Grid>

								<!--  Презиме  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Презиме *" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Петровски"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.LastName}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Презиме:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.LastName}" />
									</Grid>
								</Grid>

								<!--  ЕМБГ  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="ЕМБГ *" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Keyboard="Numeric"
												MaxLength="13"
												Placeholder="Внесете 13 цифри"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.NationalId}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="ЕМБГ:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.NationalId}" />
									</Grid>
								</Grid>
                                <!--  СЗБО број  -->
                                <Grid Padding="{StaticResource FormRowPadding}">
                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="{StaticResource FormRowSpacing}" IsVisible="{Binding IsEditMode}">
                                        <Label Grid.Column="0" Style="{StaticResource EditFieldLabelStyle}" Text="СЗБО број *" />
                                        <Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
                                            <Entry BackgroundColor="Transparent" FontSize="13" MaxLength="64" Placeholder="Внесете СЗБО број" PlaceholderColor="{StaticResource SparkTextSecondary}" Text="{Binding Patient.SzboNumber}" TextColor="{StaticResource SparkTextPrimary}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="{StaticResource FormRowSpacing}" IsVisible="{Binding IsReadOnly}">
                                        <Label Grid.Column="0" Style="{StaticResource ReadRowLabelStyle}" Text="СЗБО број:" />
                                        <Label Grid.Column="1" Style="{StaticResource ReadRowValueStyle}" Text="{Binding Patient.SzboNumber, TargetNullValue='—'}" />
                                    </Grid>
                                </Grid>

                                <!--  Датум на раѓање  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Датум на раѓање" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Grid ColumnDefinitions="*,Auto">
												<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
												<Label Grid.Column="1" Style="{StaticResource FieldBoxCalendarIconStyle}" />
												<DatePicker
													Grid.ColumnSpan="2"
													BackgroundColor="Transparent"
													Date="{Binding Patient.BirthDate}"
													Format="dd.MM.yyyy"
													Opacity="0" />
											</Grid>
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Роден:" />
										<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
											<HorizontalStackLayout Spacing="6">
												<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf073;" />
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" />
											</HorizontalStackLayout>
										</Border>
									</Grid>
								</Grid>

								<!--  Пол  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Пол *" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Grid ColumnDefinitions="*,Auto">
												<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedGenderDisplay}" />
												<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
												<Picker
													Grid.ColumnSpan="2"
													BackgroundColor="Transparent"
													ItemsSource="{Binding GenderOptions}"
													Opacity="0"
													SelectedItem="{Binding SelectedGenderDisplay}" />
											</Grid>
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Пол:" />
										<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">
											<HorizontalStackLayout Spacing="6">
												<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />
												<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding SelectedGenderDisplay}" />
											</HorizontalStackLayout>
										</Border>
									</Grid>
								</Grid>

								<!--  ДОКУМЕНТИ / РЕШЕНИЕ  -->
								<Border
									Margin="0,10,0,0"
									Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ДОКУМЕНТИ / РЕШЕНИЕ" />
								</Border>

								<Border
									Padding="14"
									BackgroundColor="{StaticResource SparkBackground}"
									Stroke="{StaticResource SparkAccentTealBg}"
									StrokeShape="RoundRectangle 12"
									StrokeThickness="1">
									<VerticalStackLayout Spacing="12">
										<HorizontalStackLayout IsVisible="{Binding IsEditMode}" Spacing="10">
											<controls:FFButton
												ButtonKind="Secondary"
												Command="{Binding UploadDocumentCommand}"
												ContentPadding="16,0"
												HeightRequestEx="36"
												IsEnabled="{Binding IsUploadingDocument, Converter={StaticResource InvertedBoolConverter}}"
												Text="📎 Прикачи документ" />
											<ActivityIndicator
												IsRunning="{Binding IsUploadingDocument}"
												IsVisible="{Binding IsUploadingDocument}"
												Color="{StaticResource SparkAccentTeal}" />
										</HorizontalStackLayout>

										<CollectionView ItemsSource="{Binding Documents}" SelectionMode="None">
											<CollectionView.EmptyView>
												<Label
													Margin="0,4"
													FontSize="13"
													Text="Нема прикачени документи."
													TextColor="{StaticResource SparkTextSecondary}" />
											</CollectionView.EmptyView>
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="dto:PatientDocumentDto">
													<Border
														Margin="0,0,0,6"
														Padding="12,10"
														BackgroundColor="{StaticResource SparkBackground}"
														Stroke="{StaticResource SparkAccentTealBg}"
														StrokeShape="RoundRectangle 8"
														StrokeThickness="1">
														<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
															<Label
																FontFamily="FASolid"
																FontSize="14"
																Text="&#xf15b;"
																VerticalOptions="Center" />
															<Label
																Grid.Column="1"
																FontSize="13"
																LineBreakMode="TailTruncation"
																Text="{Binding FileName}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
															<Label
																Grid.Column="2"
																FontFamily="FASolid"
																FontSize="14"
																IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
																Text="&#xf1f8;"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center">
																<Label.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDocumentCommand}" CommandParameter="{Binding .}" />
																</Label.GestureRecognizers>
															</Label>
														</Grid>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>
								</Border>

							</VerticalStackLayout>

							<!--  ================================================  -->
							<!--  COLUMN 1 — МЕДИЦИНСКИ ПОДАТОЦИ  -->
							<!--  ================================================  -->
							<VerticalStackLayout Grid.Column="2" Spacing="16">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="МЕДИЦИНСКИ ПОДАТОЦИ" />
								</Border>

								<!--  Матичен реуматолог  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<VerticalStackLayout Spacing="8">
										<Grid
											ColumnDefinitions="130,*"
											ColumnSpacing="{StaticResource FormRowSpacing}"
											IsVisible="{Binding IsEditMode}">
											<Label
												Grid.Column="0"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Реуматолог" />
											<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
												<Entry
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Пребарај реуматолог..."
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding DoctorSearchText}"
													TextColor="{StaticResource SparkTextPrimary}"
													VerticalOptions="Center" />
											</Border>
										</Grid>

										<Border
											Margin="130,0,0,0"
											IsVisible="{Binding ShowDoctorDropdown}"
											Style="{StaticResource SearchDropdownBorderStyle}">
											<CollectionView ItemsSource="{Binding DoctorSearchResults}" SelectionMode="None">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="dto:DoctorDto">
														<Grid Padding="12,10">
															<Grid.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectDoctorCommand}" CommandParameter="{Binding .}" />
															</Grid.GestureRecognizers>
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding DisplayName}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</Grid>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>

										<Border
											Margin="130,0,0,0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											IsVisible="{Binding IsEditMode}"
											Stroke="{StaticResource SparkAccentTealBg}"
											Style="{StaticResource InfoPillBorderStyle}">
											<HorizontalStackLayout Spacing="8">
												<Label
													Style="{StaticResource InfoPillIconStyle}"
													Text="&#xf0f0;" />
												<Label
													Style="{StaticResource InfoPillTextStyle}"
													Text="{Binding SelectedDoctorDisplay}"
													TextColor="{StaticResource SparkAccentTealDark}" />
											</HorizontalStackLayout>
										</Border>

										<Grid
											ColumnDefinitions="130,*"
											ColumnSpacing="{StaticResource FormRowSpacing}"
											IsVisible="{Binding IsReadOnly}">
											<Label
												Grid.Column="0"
												Style="{StaticResource ReadRowLabelStyle}"
												Text="Реуматолог:" />
											<Label
												Grid.Column="1"
												Style="{StaticResource ReadRowValueStyle}"
												Text="{Binding SelectedDoctorDisplay, FallbackValue='Не е избран реуматолог'}" />
										</Grid>
