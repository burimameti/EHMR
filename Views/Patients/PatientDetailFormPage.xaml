												AutoSize="Disabled"
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пеницилин, Храна, Прашина..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.Allergies}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</VerticalStackLayout>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Алергии:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.Allergies, FallbackValue='Нема евидентирани.'}" />
									</Grid>
								</Grid>

								<!--  ДИЈАГНОЗИ (МКБ-10)  -->
								<VerticalStackLayout Padding="10,0" Spacing="8">
