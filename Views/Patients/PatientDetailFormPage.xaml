<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.PatientDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:DataType="viewModels:PatientDetailFormViewModel">

	<!--  Главен контејнер со темна позадина  -->
	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="20">

			<!--  =====================================================  -->
			<!--  HEADER PANEL (Информации за пациент / Акции)  -->
			<!--  =====================================================  -->
			<Border
				Padding="20"
				BackgroundColor="{StaticResource White}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<!--  Наслов кога се креира нов пациент  -->


					<!--  Аватар со иницијали (при преглед на постоечки)  -->
					<!--<Border
						BackgroundColor="{StaticResource LoginPrimary}"
						HeightRequest="48"
						IsVisible="{Binding IsReadOnly}"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						VerticalOptions="Center"
						WidthRequest="48">
						<Label
							FontAttributes="Bold"
							FontSize="14"
							HorizontalOptions="Center"
							Text="{Binding PatientInitials}"
						TextColor="{StaticResource Gray800}"
							VerticalOptions="Center" />
					</Border>-->

					<!--  Детални информации во заглавието  -->
					<VerticalStackLayout
						Grid.Column="1"
						Spacing="4"
						VerticalOptions="Center">

						<!--  Title  -->
						<HorizontalStackLayout HorizontalOptions="Fill" Spacing="12">

							<Label
								FontAttributes="Bold"
								FontSize="20"
								Text="{Binding HeaderTitle}"
								TextColor="{StaticResource Gray600}" />


							<controls:FFStatusChip
								BackgroundColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToColorConverter}}"
								HorizontalOptions="End"
								IsVisible="{Binding IsNewPatient, Converter={StaticResource InverseBoolConverter}}"
								Text="{Binding Patient.Status, Converter={StaticResource PatientStatusToLabelConverter}}"
								TextColor="{Binding Patient.Status, Converter={StaticResource PatientStatusToTextColorConverter}}" />

						</HorizontalStackLayout>


						<!--  Subtitle  -->
						<Label
							FontSize="12"
							HorizontalOptions="Fill"
							Text="{Binding HeaderSubtitle}"
							TextColor="{StaticResource Gray700}" />

					</VerticalStackLayout>

					<!--  Акциски копчиња кои менаџираат состојба  -->
					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding ToggleEditModeCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							IsVisible="{Binding IsReadOnly}"
							Text="✎ Уреди досие" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							IsVisible="{Binding IsEditMode}"
							Text="💾 Зачувај промени" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  =====================================================  -->
			<!--  NAVIGATION TABS (Јазичиња за навигација низ форма)  -->
			<!--  =====================================================  -->
			<Border
				Grid.Row="1"
				Padding="20"
				BackgroundColor="{StaticResource White}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">
				<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
					<controls:FFButton
						Grid.Column="0"
						ButtonKind="{Binding IsTab1Active, Converter={StaticResource BoolToTabKindConverter}}"
						Command="{Binding SelectTabCommand}"
						CommandParameter="1"
						HeightRequestEx="40"
						Text="Лични податоци" />
					<controls:FFButton
						Grid.Column="1"
						ButtonKind="{Binding IsTab2Active, Converter={StaticResource BoolToTabKindConverter}}"
						Command="{Binding SelectTabCommand}"
						CommandParameter="2"
						HeightRequestEx="40"
						Text="Медицински податоци" />
					<controls:FFButton
						Grid.Column="2"
						ButtonKind="{Binding IsTab3Active, Converter={StaticResource BoolToTabKindConverter}}"
						Command="{Binding SelectTabCommand}"
						CommandParameter="3"
						HeightRequestEx="40"
						Text="Контакт информации" />
					<controls:FFButton
						Grid.Column="3"
						ButtonKind="{Binding IsTab4Active, Converter={StaticResource BoolToTabKindConverter}}"
						Command="{Binding SelectTabCommand}"
						CommandParameter="4"
						HeightRequestEx="40"
						Text="Системски запис" />
				</Grid>
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE  -->
			<!--  =====================================================  -->
			<Border
				Grid.Row="2"
				BackgroundColor="{StaticResource White}"
				StrokeShape="RoundRectangle 16"
				StrokeThickness="0">
				<ScrollView>
					<VerticalStackLayout Padding="32" Spacing="24">

						<!--  ============================================  -->
						<!--  TAB 1 — ЛИЧНИ ПОДАТОЦИ  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab1Active}" Spacing="20">

							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ОСНОВНИ ИНФОРМАЦИИ"
								TextColor="{StaticResource Gray800}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray600}" />
							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="22">
								<Grid
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Име *"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Entry
											Background="{StaticResource Gray200}"
											BackgroundColor="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. Марко"
											Text="{Binding Patient.FirstName}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>



								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Презиме *"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Entry
											Background="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. Петровски"
											PlaceholderColor="{StaticResource Gray600}"
											Text="{Binding Patient.LastName}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<!--  ЕМБГ  -->
								<Grid
									Grid.Column="2"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="ЕМБГ *"
										TextColor="{StaticResource Gray800}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Entry
											Background="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Numeric"
											MaxLength="13"
											Placeholder="Внесете 13 цифри"
											PlaceholderColor="{StaticResource Gray600}"
											Text="{Binding Patient.NationalId}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>


							</Grid>


							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray200}" />
							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="30">
								<Grid
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Бр. на осигурување"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Entry
											Background="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="МК-000000"
											PlaceholderColor="{StaticResource Gray600}"
											Text="{Binding Patient.SSN}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Датум на раѓање"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Grid>
											<DatePicker
												BackgroundColor="{StaticResource Gray200}"
												Date="{Binding Patient.BirthDate}"
												Format="dd.MM.yyyy"
												HorizontalOptions="Start"
												IsVisible="{Binding IsEditMode}"
												TextColor="{StaticResource Gray800}"
												VerticalOptions="Center"
												WidthRequest="150" />
											<Label
												FontSize="26"
												IsVisible="{Binding IsReadOnly}"
												Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}"
												TextColor="{StaticResource Gray800}"
												VerticalOptions="Center" />
										</Grid>
									</Border>
								</Grid>
								<Grid
									Grid.Column="3"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Пол *"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="14,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding SelectedGenderDisplay}"
												TextColor="{StaticResource Gray800}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="#64748B"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												Background="{StaticResource LoginAccent}"
												IsEnabled="{Binding IsEditMode}"
												ItemsSource="{Binding GenderOptions}"
												Opacity="0"
												SelectedItem="{Binding SelectedGenderDisplay}" />
										</Grid>
									</Border>
								</Grid>
							</Grid>





							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="КОНТАКТ ИНФОРМАЦИИ"
								TextColor="{StaticResource Gray800}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray400}" />
							<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
								<Grid
									Grid.Column="0"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Телефон *"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Entry
											Background="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="#64748B"
											Text="{Binding Patient.Phone}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Е-пошта *"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Entry
											Background="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Email"
											Placeholder="example@domain.com"
											PlaceholderColor="#64748B"
											Text="{Binding Patient.Email}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray200}" />
							<Grid ColumnDefinitions="*,*,*" ColumnSpacing="55">


								<!--  ГРАД  -->
								<Grid
									Grid.Column="0"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Град"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="14,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding Patient.City}"
												TextColor="{StaticResource Gray800}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="#64748B"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												IsEnabled="{Binding IsEditMode}"
												ItemsSource="{Binding CityOptions}"
												Opacity="0"
												SelectedItem="{Binding Patient.City}" />
										</Grid>
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="70,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Адреса"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Entry
											Background="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Улица и број"
											PlaceholderColor="#64748B"
											Text="{Binding Patient.Address}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<!--  ПОШТЕНСКИ БРОЈ  -->
								<Grid
									Grid.Column="2"
									ColumnDefinitions="75,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Поштенски број"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="42"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<Entry
											BackgroundColor="{StaticResource Gray200}"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. 1000 , 4AAB300"
											PlaceholderColor="#64748B"
											Text="{Binding Patient.PostalCode}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>
							<!--  АДРЕСА  -->


							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray200}" />

							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="СТАТУС ДОСИЕ И МАТИЧЕН ЛЕКАР"
								TextColor="{StaticResource Gray800}" />
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray600}" />
							<Grid ColumnDefinitions="*,*">
								<Grid
									ColumnDefinitions="200,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Статус на досие"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="6,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Picker
											BackgroundColor="{StaticResource Gray200}"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											ItemsSource="{Binding StatusOptions}"
											SelectedItem="{Binding SelectedStatusDisplay}"
											TextColor="{StaticResource Gray800}"
											TitleColor="#64748B"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<Grid
									Grid.Column="1"
									ColumnDefinitions="200,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										Margin="120,0,0,0"
										FontAttributes="Bold"
										FontSize="13"
										Text="Матичен лекар"
										TextColor="{StaticResource Gray600}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="6,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Entry
											BackgroundColor="{StaticResource Gray200}"
											FontSize="13"
											IsEnabled="{Binding IsEditMode}"
											Text="Матичен лекар"
											TextColor="{StaticResource Gray600}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>


						</VerticalStackLayout>

						<!--  ============================================  -->
						<!--  TAB 2 — МЕДИЦИНСКИ ПОДАТОЦИ  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab2Active}" Spacing="24">
							<VerticalStackLayout Spacing="12">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="ОСИГУРУВАЊЕ ИЛИ ПОЛИСА"
									TextColor="{StaticResource Gray800}" />
								<BoxView
									Margin="0,10"
									HeightRequest="1"
									Color="{StaticResource Gray800}" />
								<Grid ColumnDefinitions="*,*">
									<VerticalStackLayout
										Grid.Column="0"
										MinimumWidthRequest="300"
										Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Број на осигуреник / или полиса"
											TextColor="{StaticResource Gray800}" />
										<Border
											Padding="12,0"
											BackgroundColor="{StaticResource Gray200}"
											HeightRequest="46"
											StrokeShape="RoundRectangle 10">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												IsReadOnly="{Binding IsReadOnly}"
												Placeholder="МК-0001-2024"
												PlaceholderColor="#64748B"
												Text="{Binding Patient.SSN}"
												TextColor="{StaticResource Gray800}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Column="1"
										HorizontalOptions="Start"
										Spacing="8">
										<Label
											CharacterSpacing="1"
											FontAttributes="Bold"
											FontSize="13"
											Text="КРВНА ГРУПА"
											TextColor="{StaticResource Gray800}" />
										<Border
											Padding="14,0"
											BackgroundColor="{StaticResource Gray200}"
											HeightRequest="46"
											StrokeShape="RoundRectangle 10">
											<Grid ColumnDefinitions="*,Auto" MinimumWidthRequest="300">
												<Label
													FontSize="13"
													Text="{Binding Patient.BloodType, FallbackValue='Изберете крвна група...'}"
													TextColor="{StaticResource Gray800}"
													VerticalOptions="Center" />
												<Label
													Grid.Column="1"
													FontSize="11"
													Text="▼"
													TextColor="#64748B"
													VerticalOptions="Center" />
												<Picker
													Grid.ColumnSpan="2"
													IsEnabled="{Binding IsEditMode}"
													ItemsSource="{Binding BloodTypeOptions}"
													Opacity="0"
													SelectedItem="{Binding Patient.BloodType}" />
											</Grid>
										</Border>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource Gray200}" />
							<!--  КРВНА ГРУПА  -->




							<!--  ДИЈАГНОЗИ  -->
							<VerticalStackLayout Spacing="12">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="АКТИВНИ И ИСТОРИЈА НА ДИЈАГНОЗИ"
									TextColor="{StaticResource Gray800}" />
								<BoxView HeightRequest="1" Color="{StaticResource Gray600}" />
								<CollectionView
									EmptyView="Нема евидентирани клинички дијагнози."
									ItemsSource="{Binding Patient.Diagnoses}"
									SelectionMode="None">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="models:Diagnosis">
											<Border
												Margin="0,0,0,12"
												Padding="16"
												BackgroundColor="{StaticResource Gray200}"
												StrokeShape="RoundRectangle 12"
												StrokeThickness="1">
												<Grid
													ColumnDefinitions="*,Auto"
													ColumnSpacing="12"
													RowDefinitions="Auto,Auto">

													<VerticalStackLayout Spacing="6">
														<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
															<Border
																Padding="8,4"
																BackgroundColor="#0F172A"
																StrokeShape="RoundRectangle 6"
																StrokeThickness="0">
																<Label
																	FontAttributes="Bold"
																	FontFamily="Consolas"
																	FontSize="12"
																	Text="{Binding Mkb10Code.Code, FallbackValue='—'}"
																	TextColor="{StaticResource LoginAccent}" />
															</Border>
															<Label
																FontAttributes="Bold"
																FontSize="14"
																Text="{Binding ClinicalDescription}"
																TextColor="{StaticResource Gray800}"
																VerticalOptions="Center" />
														</HorizontalStackLayout>
														<Label
															FontSize="11"
															Text="{Binding DiagnosedAt, StringFormat='Евидентирано на: {0:dd.MM.yyyy}'}"
															TextColor="#64748B" />
													</VerticalStackLayout>

													<controls:FFStatusChip
														Grid.Column="1"
														BackgroundColor="{Binding Status, Converter={StaticResource DiagnosisStatusToColorConverter}}"
														Text="{Binding Status, Converter={StaticResource DiagnosisStatusToLabelConverter}}"
														TextColor="{Binding Status, Converter={StaticResource DiagnosisStatusToTextColorConverter}}"
														VerticalOptions="Center" />

													<Border
														Grid.Row="1"
														Margin="0,12,0,0"
														Padding="8,3"
														BackgroundColor="#0284C7"
														HorizontalOptions="Start"
														IsVisible="{Binding IsPrimary}"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0">
														<Label
															FontAttributes="Bold"
															FontSize="11"
															Text="Примарна Дијагноза"
															TextColor="{StaticResource Gray800}" />
													</Border>
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>

							<BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

							<!--  АЛЕРГИИ  -->
							<VerticalStackLayout Spacing="8">
								<Label
									CharacterSpacing="1"
									FontAttributes="Bold"
									FontSize="13"
									Text="ПОЗНАТИ АЛЕРГИИ И РЕАКЦИИ"
									TextColor="{StaticResource Gray800}" />
								<BoxView HeightRequest="1" Color="{StaticResource Gray600}" />
								<Border
									Padding="12,10"
									BackgroundColor="{StaticResource Gray200}"
									HeightRequest="120"
									StrokeShape="RoundRectangle 12">
									<Editor
										AutoSize="Disabled"
										BackgroundColor="Transparent"
										FontSize="13"
										IsReadOnly="{Binding IsReadOnly}"
										Placeholder="Внесете алергии (Пр. Пеницилин, Храна, Прашина...)"
										PlaceholderColor="#64748B"
										Text="{Binding Patient.Allergies}"
										TextColor="{StaticResource Gray800}" />
								</Border>
							</VerticalStackLayout>
						</VerticalStackLayout>

						<!--  ============================================  -->
						<!--  TAB 3 — КОНТАКТ ИНФОРМАЦИИ (ИТНО)  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab3Active}" Spacing="20">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="КОНТАКТ ЛИЦЕ ЗА ИТНИ СЛУЧАИ"
								TextColor="{StaticResource LoginAccent}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
								<!--  ИМЕ И ПРЕЗИМЕ НА КОНТАКТ  -->
								<VerticalStackLayout Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="Име и презиме"
										TextColor="{StaticResource Gray600}" />
									<Border
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Пр. Ана Петровска"
											PlaceholderColor="#64748B"
											Text="{Binding Patient.EmergencyContactName}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>

								<!--  ТЕЛЕФОН НА КОНТАКТ  -->
								<VerticalStackLayout Grid.Column="1" Spacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="Телефонски број"
										TextColor="{StaticResource Gray600}" />
									<Border
										Padding="12,0"
										BackgroundColor="{StaticResource Gray200}"
										HeightRequest="46"
										StrokeShape="RoundRectangle 10">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											IsReadOnly="{Binding IsReadOnly}"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="#64748B"
											Text="{Binding Patient.EmergencyContactPhone}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
							</Grid>

							<!--  РОДНИНСКА ВРСКА  -->
							<VerticalStackLayout Spacing="8">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Роднинска врска / Релација"
									TextColor="{StaticResource Gray600}" />
								<Border
									Padding="14,0"
									BackgroundColor="{StaticResource Gray200}"
									HeightRequest="46"
									StrokeShape="RoundRectangle 10">
									<Grid ColumnDefinitions="*,Auto">
										<Label
											FontSize="13"
											Text="{Binding SelectedRelationDisplay, FallbackValue='Изберете релација...'}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
										<Label
											Grid.Column="1"
											FontSize="11"
											Text="▼"
											TextColor="#64748B"
											VerticalOptions="Center" />
										<Picker
											Grid.ColumnSpan="2"
											IsEnabled="{Binding IsEditMode}"
											ItemsSource="{Binding RelationOptions}"
											Opacity="0"
											SelectedItem="{Binding SelectedRelationDisplay}" />
									</Grid>
								</Border>
							</VerticalStackLayout>
						</VerticalStackLayout>

						<!--  ============================================  -->
						<!--  TAB 4 — СИСТЕМСКИ ЗАПИС  -->
						<!--  ============================================  -->
						<VerticalStackLayout IsVisible="{Binding IsTab4Active}" Spacing="24">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="МЕТАДАТА И ИНФОРМАЦИИ ЗА ЗАПИСОТ"
								TextColor="{StaticResource LoginAccent}" />

							<Border
								Padding="20"
								BackgroundColor="{StaticResource Gray200}"
								StrokeShape="RoundRectangle 12">
								<Grid
									ColumnDefinitions="*,Auto"
									RowDefinitions="Auto,Auto,Auto,Auto"
									RowSpacing="16">

									<!--  ID  -->
									<Label
										FontSize="13"
										Text="Системско ID во база"
										TextColor="{StaticResource Gray600}" />
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontFamily="Consolas"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.Id}"
										TextColor="{StaticResource Gray800}" />

									<!--  ДАТУМ РЕГИСТРАЦИЈА  -->
									<Label
										Grid.Row="1"
										FontSize="13"
										Text="Датум на првична регистрација"
										TextColor="{StaticResource Gray600}" />
									<Label
										Grid.Row="1"
										Grid.Column="1"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.RegistrationDate, StringFormat='{0:dd.MM.yyyy}'}"
										TextColor="{StaticResource Gray800}" />

									<!--  КРЕИРАНО НА  -->
									<Label
										Grid.Row="2"
										FontSize="13"
										Text="Инстанцирано на сервер"
										TextColor="{StaticResource Gray600}" />
									<Label
										Grid.Row="2"
										Grid.Column="1"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.CreatedAt, StringFormat='{0:dd.MM.yyyy}'}"
										TextColor="{StaticResource Gray800}" />

									<!--  ПОСЛЕДНА ПОСЕТА  -->
									<Label
										Grid.Row="3"
										FontSize="13"
										Text="Последна активност / Преглед"
										TextColor="{StaticResource Gray600}" />
									<Label
										Grid.Row="3"
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="13"
										HorizontalOptions="End"
										Text="{Binding Patient.LastVisitDate, StringFormat='{0:dd.MM.yyyy}', FallbackValue='Нема евидентирано посети'}"
										TextColor="{StaticResource LoginAccent}" />
								</Grid>
							</Border>

							<BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

							<!--  ДОПОЛНИТЕЛНИ ДЕТАЛИ  -->

						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>
	</Grid>
</ContentPage>