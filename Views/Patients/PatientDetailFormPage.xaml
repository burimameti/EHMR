										FlexLayout.AlignItems="Start"
										JustifyContent="Start"
										Wrap="Wrap">
										<BindableLayout.EmptyView>
											<Label
												Padding="0,4"
												FontSize="13"
												Text="Нема евидентирани дијагнози."
												TextColor="{StaticResource SparkTextSecondary}" />
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="dto:DiagnosisDto">
												<Border Margin="0,0,6,6" Style="{StaticResource TokenChipBorderStyle}">
													<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontFamily="Consolas"
															FontSize="12"
															Text="{Binding Mkb10Code, FallbackValue='—'}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															FontSize="12"
															Text="{Binding Mkb10Description}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Button
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
															CommandParameter="{Binding .}"
															IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
															Style="{StaticResource TokenChipRemoveButtonStyle}"
															Text="✕"
															TextColor="{StaticResource SparkAccentTealDark}" />
													</HorizontalStackLayout>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</FlexLayout>
								</VerticalStackLayout>

								<!--  ЛЕКОВИ  -->
								<VerticalStackLayout Padding="10,0" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Тековни лекови" />
									<Grid IsVisible="{Binding IsEditMode}">
										<Border Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пребарај лек..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding MedicineSearchText}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>

									<Border IsVisible="{Binding ShowMedicineDropdown}" Style="{StaticResource SearchDropdownBorderStyle}">
										<CollectionView ItemsSource="{Binding MedicineResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="dto:MedicineDto">
													<Grid Padding="10,8">
														<Grid.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
														</Grid.GestureRecognizers>
														<Label
															FontSize="12"
															Text="{Binding GenericName}"
															TextColor="{StaticResource SparkTextPrimary}" />
													</Grid>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>

									<VerticalStackLayout BindableLayout.ItemsSource="{Binding AttachedMedicines}" Spacing="8">
										<BindableLayout.EmptyView>
											<Label
												Padding="0,4"
												FontSize="13"
												Text="Нема евидентирани лекови."
												TextColor="{StaticResource SparkTextSecondary}" />
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="viewModels:AttachedMedicineRow">
												<Border
													Padding="12,10"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													Stroke="{StaticResource SparkAccentTeal}"
													StrokeShape="RoundRectangle 10"
													StrokeThickness="1">
													<Grid
														ColumnDefinitions="*,Auto"
														RowDefinitions="Auto,Auto"
														RowSpacing="6"
														VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding MedicineName}"
															TextColor="{StaticResource SparkAccentTealDark}"
															VerticalOptions="Center" />
														<Button
															Grid.Column="1"
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
															CommandParameter="{Binding .}"
															FontSize="14"
															IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
															Style="{StaticResource TokenChipRemoveButtonStyle}"
															Text="✕"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Border
															Grid.Row="1"
															Grid.ColumnSpan="2"
															Padding="10,0"
															BackgroundColor="{StaticResource SparkBackground}"
															HeightRequest="38"
															IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}"
															Stroke="{StaticResource SparkAccentTealBg}"
															StrokeShape="RoundRectangle 6"
															StrokeThickness="1">
															<Entry
																FontSize="12"
																Placeholder="Пр. 1 таблета наутро"
																PlaceholderColor="{StaticResource SparkTextSecondary}"
																Text="{Binding Dosage}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Label
															Grid.Row="1"
															Grid.ColumnSpan="2"
															FontSize="13"
															IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsReadOnly}"
															Text="{Binding Dosage, StringFormat='Дозирање: {0}'}"
															TextColor="{StaticResource SparkTextPrimary}" />
													</Grid>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>

							</VerticalStackLayout>

							<!--  ================================================  -->
							<!--  COLUMN 2 — КОНТАКТ ИНФОРМАЦИИ  -->
							<!--  ================================================  -->
							<VerticalStackLayout Grid.Column="4" Spacing="16">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="КОНТАКТ ИНФОРМАЦИИ" />
								</Border>

								<!--  Телефон  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Телефон *" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Keyboard="Telephone"
												Placeholder="+389 7X XXX XXX"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.Phone}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Телефон:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.Phone}" />
									</Grid>
								</Grid>

								<!--  Е-пошта  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Е-пошта *" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Keyboard="Email"
												Placeholder="petko@gmail.com"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.Email}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Е-пошта:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.Email}" />
									</Grid>
								</Grid>

								<!--  Град  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
										<Grid ColumnDefinitions="130,*" ColumnSpacing="{StaticResource FormRowSpacing}">
											<Label
												Grid.Column="0"
												Style="{StaticResource EditFieldLabelStyle}"
												Text="Град" />
											<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
												<Grid ColumnDefinitions="*,Auto">
													<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedCityDisplay, FallbackValue='Изберете град...'}" />
													<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
													<Picker
														Grid.ColumnSpan="2"
														BackgroundColor="Transparent"
														ItemsSource="{Binding CityOptions}"
														Opacity="0"
														SelectedItem="{Binding SelectedCityDisplay}" />
												</Grid>
											</Border>
										</Grid>

										<Border
											Margin="130,0,0,0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											IsVisible="{Binding SelectedCityDisplay, Converter={StaticResource StringNotEmptyConverter}}"
											Stroke="{StaticResource SparkAccentTealBg}"
											Style="{StaticResource InfoPillBorderStyle}">
											<HorizontalStackLayout Spacing="8">
												<Label
													Style="{StaticResource InfoPillIconStyle}"
													Text="&#xf3c5;" />
												<Label
													Style="{StaticResource InfoPillTextStyle}"
													Text="{Binding SelectedCityDisplay}"
													TextColor="{StaticResource SparkAccentTealDark}" />
											</HorizontalStackLayout>
										</Border>
									</VerticalStackLayout>

									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Град:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding SelectedCityDisplay, FallbackValue='—'}" />
									</Grid>
								</Grid>

								<!--  Адреса  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Адреса" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Улица и број"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.Address}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Адреса:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.Address}" />
									</Grid>
								</Grid>

								<!--  ИТЕН КОНТАКТ  -->
								<Border
									Margin="0,10,0,0"
									Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ИТЕН КОНТАКТ" />
								</Border>

								<!--  Ime i prezime na iten kontakt  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Име и презиме" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Ана Петровска"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.EmergencyContactName}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Контакт лице:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.EmergencyContactName}" />
									</Grid>
								</Grid>

								<!--  Тел / Моб.  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Тел / Моб." />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пример +38970000000"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.EmergencyContactPhone}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Тел / Моб.:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.EmergencyContactPhone}" />
									</Grid>
								</Grid>

								<!--  Роднинска врска  -->
								<Grid Padding="{StaticResource FormRowPadding}">
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsEditMode}">
										<Label
											Grid.Column="0"
											Style="{StaticResource EditFieldLabelStyle}"
											Text="Роднинска врска" />
										<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пример татко, сестра"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Patient.EmergencyRelationship}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<Grid
										ColumnDefinitions="130,*"
										ColumnSpacing="{StaticResource FormRowSpacing}"
										IsVisible="{Binding IsReadOnly}">
										<Label
											Grid.Column="0"
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Роднинска врска:" />
										<Label
											Grid.Column="1"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Patient.EmergencyRelationship}" />
									</Grid>
								</Grid>

							</VerticalStackLayout>
						</Grid>
						<BoxView
							BackgroundColor="{StaticResource SparkBorder}"
							HeightRequest="1"
							HorizontalOptions="Fill" />
						<HorizontalStackLayout
							Grid.Column="2"
							HorizontalOptions="End"
