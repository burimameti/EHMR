											<HorizontalStackLayout Spacing="6">
												<Label FontAttributes="Bold" FontSize="11.5" Text="{Binding Mkb10Code}" TextColor="{StaticResource SparkAccentTealDark}" />
												<Label FontSize="10.5" LineBreakMode="TailTruncation" MaximumWidthRequest="220" Text="{Binding Mkb10Description}" TextColor="{StaticResource SparkTextPrimary}" />
												<Label FontFamily="FASolid" FontSize="10" IsVisible="{Binding Source={x:Reference PageRoot}, Path=BindingContext.IsEditMode}" Text="&#xf1f8;" TextColor="#DC2626">
													<Label.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}" CommandParameter="{Binding .}" />
