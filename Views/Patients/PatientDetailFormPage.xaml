																		<Label.GestureRecognizers>
																			<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveDocumentCommand}" CommandParameter="{Binding .}" />
																		</Label.GestureRecognizers>
																	</Label>
																</Grid>
															</Border>
														</DataTemplate>
													</CollectionView.ItemTemplate>
												</CollectionView>
											</VerticalStackLayout>
										</Border>
									</VerticalStackLayout>
								</Grid>

								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Margin="0,6,0,0" Spacing="6">
<controls:CrudSectionHeader Title="СТАТУС НА ПАЦИЕНТ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" />
