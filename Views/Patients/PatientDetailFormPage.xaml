											<VerticalStackLayout
												Padding="12"
												IsVisible="{Binding IsEditMode}"
												Spacing="4">
												<Label Style="{StaticResource EditFieldLabelStyle}" Text="Крвна група" />
												<Border HeightRequest="44" Style="{StaticResource EditFieldBoxStyle}">
													<Grid ColumnDefinitions="*,Auto">
														<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedBloodTypeDisplay, FallbackValue='Изберете...'}" />
														<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />
														<Picker
															Grid.ColumnSpan="2"
															BackgroundColor="Transparent"
															ItemsSource="{Binding BloodTypeOptions}"
															Opacity="0"
															SelectedItem="{Binding SelectedBloodTypeDisplay}" />
													</Grid>
												</Border>
											</VerticalStackLayout>

											<!--  READ MODE  -->
											<VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
												<Label
													FontSize="10"
													Text="Крвна група"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="13"
													Text="{Binding SelectedBloodTypeDisplay, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</VerticalStackLayout>

										<!--  КОЛОНА 3: АЛЕРГИИ  -->
										<VerticalStackLayout
