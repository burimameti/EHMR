<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.PatientListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:domain="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Patients"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientListViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="8">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Пациенти"
						Grid.Column="0"
						Subtitle="Преглед, пребарување и управување со пациенти">
						<controls:FFPageHeader.HeaderContent>
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GoBackCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
						</controls:FFPageHeader.HeaderContent>
					</controls:FFPageHeader>


				</Grid>
			</Border>

			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource PageBackground}"
				StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">
						<controls:FFSectionCard>
							<Grid ColumnSpacing="5" RowSpacing="0">
								<VerticalStackLayout Spacing="20">
									<controls:SparkExplorerHeaderView
										Buttons="{Binding Buttons}"
										Pickers="{Binding Pickers}"
										SearchCommand="{Binding SearchCommand}"
										SearchPlaceholder="Пребарување на пациенти..."
										SearchText="{Binding SearchText}"
										SelectedSuggestion="{Binding SelectedSuggestion, Mode=TwoWay}"
										ShowSuggestions="{Binding ShowSuggestions}"
										Suggestions="{Binding Suggestions}"
										Tabs="{Binding Tabs}"
										UseCyrillicInput="{Binding UseCyrillicSearch, Mode=TwoWay}">
										<controls:SparkExplorerHeaderView.SuggestionTemplate>
										<DataTemplate x:DataType="domain:Patient">
											<VerticalStackLayout Spacing="0" BackgroundColor="White">
												<Grid Padding="10,8" ColumnDefinitions="*,Auto" ColumnSpacing="12">
													<VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
														<Label Text="{Binding FullName}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource SparkTextPrimary}" />
														<Label Text="{Binding PatientNumber, StringFormat='Пациент бр. {0}'}" FontSize="11" TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
													<Label Grid.Column="1" Text="{Binding SzboNumber}" FontSize="11" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" HorizontalTextAlignment="End" />
												</Grid>
												<BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />
											</VerticalStackLayout>
										</DataTemplate>
									</controls:SparkExplorerHeaderView.SuggestionTemplate>
									</controls:SparkExplorerHeaderView>

								</VerticalStackLayout>
							</Grid>
						</controls:FFSectionCard>

						<controls:FFSectionCard>
							<controls:SparkDataGridView
								x:Name="PatientGrid"
								AutoSelectFirstRow="False"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PageInfoText="{Binding PageInfoText}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								ShowPagination="True"
								ShowRowNumbers="True"
								TotalPages="{Binding TotalPages}" />
						</controls:FFSectionCard>
					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>