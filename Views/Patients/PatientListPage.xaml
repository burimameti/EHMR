<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.PatientListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Patients"
	x:Name="PageRoot"
	x:DataType="viewModels:PatientListViewModel"
	BackgroundColor="{StaticResource PageBackground}">
	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Пациенти"
						Grid.Column="0"
						Subtitle="Преглед, пребарување и управување со пациенти">
						<controls:FFPageHeader.HeaderContent>
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GoBackCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
						</controls:FFPageHeader.HeaderContent>
					</controls:FFPageHeader>

					<!--<Button
						Grid.Column="1"
						Margin="0,9,22,25"
						BackgroundColor="{StaticResource SparkButtonSecondaryBg}"
						Command="{Binding AddCommand}"
						IsEnabled="{Binding CanCreate}"
						Style="{StaticResource PrimaryButtonStyle}"
						Text="Нов пациент"
						TextColor="{StaticResource White}" />-->
				</Grid>
			</Border>

			<!--  MAIN CONTENT / GRID  -->
			<Border
				Grid.Row="1"
				Margin="1,0,1,0"
				Padding="0,3"
				StrokeThickness="-1">
				<Grid
					RowDefinitions="Auto,*"
					RowSpacing="8"
					VerticalOptions="Fill">
					<controls:FFSectionCard Grid.Row="0">
						<controls:SparkExplorerHeaderView
							Buttons="{Binding Buttons}"
							Pickers="{Binding Pickers}"
							SearchCommand="{Binding SearchCommand}"
							SearchPlaceholder="Пребарување на пациенти..."
							SearchText="{Binding SearchText}"
							Tabs="{Binding Tabs}"
							UseCyrillicInput="{Binding UseCyrillicSearch, Mode=TwoWay}" />
					</controls:FFSectionCard>
					<controls:FFSectionCard Grid.Row="1">
						<controls:SparkDataGridView
							x:Name="PatientGrid"
							AutoSelectFirstRow="False"
							Columns="{Binding GridColumns}"
							CurrentPage="{Binding CurrentPage}"
							EditRowCommand="{Binding EditCommand}"
							NextPageCommand="{Binding NextPageCommand}"
							PageChangedCommand="{Binding PageChangedCommand}"
							PageInfoText="{Binding PageInfoText}"
							PreviousPageCommand="{Binding PreviousPageCommand}"
							RowTappedCommand="{Binding SelectCommand}"
							Rows="{Binding GridRows}"
							ShowPagination="True"
							ShowRowNumbers="True"
							TotalPages="{Binding TotalPages}" />
					</controls:FFSectionCard>
				</Grid>
			</Border>

						<controls:FFSectionCard>
							<Grid ColumnSpacing="5" RowSpacing="0">
								<VerticalStackLayout Spacing="20">

									<!--  SEARCH & FILTERS  -->
									<controls:SparkExplorerHeaderView
										Buttons="{Binding Buttons}"
										Pickers="{Binding Pickers}"
										SearchCommand="{Binding SearchCommand}"
										SearchPlaceholder="Пребарување на пациенти..."
										SearchText="{Binding SearchText}"
										Tabs="{Binding Tabs}"
										UseCyrillicInput="{Binding UseCyrillicSearch, Mode=TwoWay}" />
								</VerticalStackLayout>
							</Grid>
						</controls:FFSectionCard>
						<!--  DATA GRID  -->
						<controls:FFSectionCard>
							<Grid RowDefinitions="Auto,*" RowSpacing="6">
								<ActivityIndicator
									HeightRequest="18"
									HorizontalOptions="End"
									IsRunning="{Binding IsBusy}"
									IsVisible="{Binding IsBusy}"
									WidthRequest="18"
									Color="{StaticResource SparkAccentTeal}" />
								<controls:SparkDataGridView
									x:Name="PatientGrid"
									Grid.Row="1"
									AutoSelectFirstRow="False"
									Columns="{Binding GridColumns}"
									CurrentPage="{Binding CurrentPage}"
									EditRowCommand="{Binding EditCommand}"
									NextPageCommand="{Binding NextPageCommand}"
									PageChangedCommand="{Binding PageChangedCommand}"
									PageInfoText="{Binding PageInfoText}"
									PreviousPageCommand="{Binding PreviousPageCommand}"
									RowTappedCommand="{Binding SelectCommand}"
									Rows="{Binding GridRows}"
									ShowPagination="True"
									ShowRowNumbers="True"
									TotalPages="{Binding TotalPages}" />
							</Grid>
						</controls:FFSectionCard>




		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.ColumnSpan="2"
			BackgroundColor="#80000000"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>