<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.Admin.AdminPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EHMR.Resources.Controls"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels.Admin"
    x:Name="Page"
    x:DataType="viewModels:AdminDashboardViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="260,*">
        <Border Grid.Column="0" BackgroundColor="{StaticResource SparkSidebarBg}" StrokeThickness="0">
            <ContentView x:Name="MenuHost" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <controls:FFPageHeader
                        Title="Администрација"
                        Subtitle="Управување со корисници, реуматолози, МКБ-10 и резервни копии." >
				<controls:FFPageHeader.HeaderContent>
<controls:FFButton
						ButtonKind="Secondary"
						Clicked="OnBackClicked"
						HeightRequestEx="40"
						Text="Назад"
						WidthRequestEx="130" />
			</controls:FFPageHeader.HeaderContent>
		</controls:FFPageHeader>
                    <controls:FFButton
                        Grid.Column="1"
                        ButtonKind="Secondary"
                        Command="{Binding RefreshCommand}"
                        ContentPadding="18,0"
                        HeightRequestEx="45"
                        Text="Освежи" />
                </Grid>
            </Border>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}" Spacing="12">

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <controls:FFMetricTile
                            Grid.Column="0"
                            Title="{Binding Cards[0].Title}"
                            Command="{Binding Cards[0].Command}"
                            DisplayMode="Metric"
                            Icon="{Binding Cards[0].Icon}"
                            Subtitle="{Binding Cards[0].Subtitle}"
                            Value="{Binding Cards[0].Value}"
                            Variant="{Binding Cards[0].Variant}" />
                        <controls:FFMetricTile
                            Grid.Column="1"
                            Title="{Binding Cards[1].Title}"
                            Command="{Binding Cards[1].Command}"
                            DisplayMode="Metric"
                            Icon="{Binding Cards[1].Icon}"
                            Subtitle="{Binding Cards[1].Subtitle}"
                            Value="{Binding Cards[1].Value}"
                            Variant="{Binding Cards[1].Variant}" />
                        <controls:FFMetricTile
                            Grid.Column="2"
                            Title="{Binding Cards[2].Title}"
                            Command="{Binding Cards[2].Command}"
                            DisplayMode="Metric"
                            Icon="{Binding Cards[2].Icon}"
                            Subtitle="{Binding Cards[2].Subtitle}"
                            Value="{Binding Cards[2].Value}"
                            Variant="{Binding Cards[2].Variant}" />
                        <controls:FFMetricTile
                            Grid.Column="3"
                            Title="{Binding Cards[3].Title}"
                            Command="{Binding Cards[3].Command}"
                            DisplayMode="Metric"
                            Icon="{Binding Cards[3].Icon}"
                            Subtitle="{Binding Cards[3].Subtitle}"
                            Value="{Binding Cards[3].Value}"
                            Variant="{Binding Cards[3].Variant}" />
                    </Grid>

                    <Border Style="{StaticResource PageCardStyleDashboard}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="Последни бекапи"
                                        TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label
                                        FontSize="11"
                                        Text="Последните извршени резервни копии на системот."
                                        TextColor="{StaticResource SparkTextMuted}" />
                                </VerticalStackLayout>
                                <controls:FFButton
                                    Grid.Column="1"
                                    ButtonKind="Secondary"
                                    Command="{Binding GoToBackupsCommand}"
                                    ContentPadding="16,0"
                                    HeightRequestEx="38"
                                    Text="Прикажи ги сите" />
                            </Grid>

                            <controls:SparkDataGridView
                                Grid.Row="1"
                                Columns="{Binding BackupGridColumns}"
                                RowTappedCommand="{Binding OpenBackupCommand}"
                                Rows="{Binding BackupGridRows}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid Grid.Column="1" BackgroundColor="{StaticResource SparkOverlay}" IsVisible="{Binding IsBusy}">
            <VerticalStackLayout HorizontalOptions="Center" Spacing="12" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
                <Label FontSize="13" Text="Вчитување..." TextColor="{StaticResource SparkTextPrimary}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>