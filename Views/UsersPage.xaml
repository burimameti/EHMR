<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    xmlns:dto="clr-namespace:EHMR.Services"
    x:Class="EHMR.Views.UsersPage"
    x:DataType="viewModels:UsersViewModel"
    x:Name="Root"
    Style="{StaticResource PageBackgroundStyle}">
	<Grid ColumnDefinitions="240,*">

		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="72,*">

			<Border Grid.Row="0" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1">
				<Grid Padding="24,0" ColumnDefinitions="*,Auto">
					<VerticalStackLayout Spacing="{StaticResource SpaceXs}" VerticalOptions="Center">
						<Label Text="Корисници" Style="{StaticResource PageHeaderTitle}" />
						<Label Text="Управување со кориснички сметки, безбедносни роли и системски пристап" Style="{StaticResource PageHeaderSubtitle}" />
					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
						<Border Padding="12,8" BackgroundColor="{StaticResource SurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<HorizontalStackLayout Spacing="8">
								<Label Text="&#xf508;" FontFamily="FASolid" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
								<Label Text="Администратор" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Border>
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<Grid Grid.Row="1" Padding="{StaticResource SpaceLg}" RowDefinitions="Auto,16,*">

				<Border Grid.Row="0" Style="{StaticResource ElevatedCard}" Padding="16">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

						<VerticalStackLayout Spacing="5">
							<Label Text="ПРЕБАРУВАЊЕ" Style="{StaticResource InputLabel}" Margin="2,0,0,0" />
							<Border HeightRequest="48" BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderDefault}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
								<Grid ColumnDefinitions="Auto,*">
									<Label Text="&#xf002;" FontFamily="FASolid" FontSize="14" Margin="14,0,8,0" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
									<Entry Grid.Column="1" Placeholder="Пребарај по корисничко име, име или презиме..." PlaceholderColor="{StaticResource TextSecondary}" Text="{Binding SearchText, Mode=TwoWay}" FontSize="13" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" VerticalOptions="Center" Margin="0,0,8,0" />
								</Grid>
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="1" VerticalOptions="End">
							<Button Text="&#xf067;   Нов Корисник" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" Padding="20,0" Command="{Binding CreateAsyncCommand}" />
						</VerticalStackLayout>
					</Grid>
				</Border>

				<Border Grid.Row="2" Style="{StaticResource ElevatedCard}" Padding="0">
					<Grid RowDefinitions="48,*">

						<Border Grid.Row="0" StrokeThickness="0" Style="{StaticResource GridHeaderStyle}">
							<Grid Padding="16,0" ColumnDefinitions="50, 3*, 3*, 2.5*, 2*, 140" ColumnSpacing="12" VerticalOptions="Center">
								<CheckBox Scale="0.8" HorizontalOptions="Center" VerticalOptions="Center" Color="{StaticResource Surface}" />
								<Label Grid.Column="1" Text="КОРИСНИЧКО ИМЕ" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
								<Label Grid.Column="2" Text="ИМЕ И ПРЕЗИМЕ" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
								<Label Grid.Column="3" Text="РОЛА" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
								<Label Grid.Column="4" Text="СТАТУС" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
								<Label Grid.Column="5" Text="АКЦИИ" Style="{StaticResource GridHeaderTextStyle}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
							</Grid>
						</Border>

						<CollectionView Grid.Row="1" ItemsSource="{Binding Users}" SelectionMode="None">
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="dto:UserAdminDto">
									<Grid RowDefinitions="Auto, 1">
										<Grid Padding="16,12" BackgroundColor="{StaticResource Surface}" ColumnDefinitions="50, 3*, 3*, 2.5*, 2*, 140" ColumnSpacing="12" VerticalOptions="Center">

											<CheckBox Scale="0.75" Color="{StaticResource EhmrPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />

											<HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
												<Border WidthRequest="34" HeightRequest="34" BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 17">
													<Label Text="&#xf109;" FontFamily="FASolid" FontSize="12" TextColor="{StaticResource EhmrPrimary}" HorizontalOptions="Center" VerticalOptions="Center" />
												</Border>
												<Label Text="{Binding Username}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />
											</HorizontalStackLayout>

											<HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
												<Label Text="{Binding FirstName}" FontSize="13" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
												<Label Text="{Binding LastName}" FontSize="13" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" />
											</HorizontalStackLayout>

											<Label Grid.Column="3" Text="{Binding Role}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" LineBreakMode="TailTruncation" />

											<Border Grid.Column="4" Padding="10,5" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center" StrokeShape="RoundRectangle 6">
												<Border.Triggers>
													<DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="True">
														<Setter Property="BackgroundColor" Value="#DCFCE7" />
													</DataTrigger>
													<DataTrigger TargetType="Border" Binding="{Binding IsActive}" Value="False">
														<Setter Property="BackgroundColor" Value="#FEE2E2" />
													</DataTrigger>
												</Border.Triggers>
												<HorizontalStackLayout Spacing="6">
													<BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" VerticalOptions="Center">
														<BoxView.Triggers>
															<DataTrigger TargetType="BoxView" Binding="{Binding IsActive}" Value="True">
																<Setter Property="Color" Value="#15803D" />
															</DataTrigger>
															<DataTrigger TargetType="BoxView" Binding="{Binding IsActive}" Value="False">
																<Setter Property="Color" Value="#B91C1C" />
															</DataTrigger>
														</BoxView.Triggers>
													</BoxView>
													<Label FontSize="11" FontAttributes="Bold" VerticalOptions="Center">
														<Label.Triggers>
															<DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="True">
																<Setter Property="Text" Value="АКТИВЕН" />
																<Setter Property="TextColor" Value="#15803D" />
															</DataTrigger>
															<DataTrigger TargetType="Label" Binding="{Binding IsActive}" Value="False">
																<Setter Property="Text" Value="НЕАКТИВЕН" />
																<Setter Property="TextColor" Value="#B91C1C" />
															</DataTrigger>
														</Label.Triggers>
													</Label>
												</HorizontalStackLayout>
											</Border>

											<HorizontalStackLayout Grid.Column="5" Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
												<Button Text="&#xf304;" FontFamily="FASolid" WidthRequest="36" HeightRequest="36" Style="{StaticResource SecondaryButtonStyle}" FontSize="12" Padding="0" TextColor="{StaticResource EhmrPrimary}"
                                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectUserCommand}"
                                                        CommandParameter="{Binding .}" />

												<Button Text="&#xf00d;" FontFamily="FASolid" WidthRequest="36" HeightRequest="36" BackgroundColor="#FEF2F2" BorderColor="#FEE2E2" BorderWidth="1" CornerRadius="8" FontSize="12" Padding="0" TextColor="#DC2626"
                                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.ResetCommand}"
                                                        CommandParameter="{Binding .}" />
											</HorizontalStackLayout>
										</Grid>
										<BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource BorderDefaultStrong}" />
									</Grid>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</Grid>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>