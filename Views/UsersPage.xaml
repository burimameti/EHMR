<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.UsersPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:UsersViewModel"
	BackgroundColor="{StaticResource PageBackground}">
<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*"
			RowSpacing="16">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Корисници"
						Grid.Column="0"
						Subtitle="Управување со кориснички сметки, безбедносни роли и системски пристап" />

					<controls:FFButton
						Grid.Column="1"
						BackgroundColorEx="{StaticResource SidebarActiveBg}"
						ButtonKind="Primary"
						Command="{Binding NewCommand}"
						ContentPadding="20,0"
						HeightRequestEx="45"
						IsVisible="{Binding CanCreate}"
						Text="Нов"
						TextColorEx="White" />
				</Grid>
			</Border>

			<!--  MAIN CONTENT / GRID  -->
			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource PageBackground}"
				StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">
						<controls:FFSectionCard>
							<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пребарај по корисничко име, име или презиме..."
								SearchText="{Binding SearchText}"
								Tabs="{Binding Tabs}" />
						</controls:FFSectionCard>
						<controls:FFSectionCard>
							<controls:SparkDataGridView
								x:Name="UsersGrid"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								ShowPagination="True"
								ShowRowNumbers="True"
								TotalPages="{Binding TotalPages}" />
						</controls:FFSectionCard>
					</VerticalStackLayout>
				</ScrollView>
			</Border>

		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>