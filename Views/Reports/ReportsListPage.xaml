<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
	x:Class="EHMR.Views.Reports.ReportsListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Reports"
	x:DataType="viewModels:ReportListViewModel">


	<Grid ColumnDefinitions="260,*">


		<!--  ================= LEFT MENU =================  -->

		<Border Grid.Column="0" StrokeThickness="0">

			<ContentView x:Name="MenuHost" />

		</Border>



		<!--  ================= MAIN =================  -->

		<Grid
			Grid.Column="1"
			Padding="0"
			BackgroundColor="{StaticResource PageBackground}"
			RowDefinitions="Auto,Auto,Auto,*"
			RowSpacing="0">



			<!--  HEADER  -->

			<Border Style="{StaticResource PageCardStyleDashboard}">

				<Grid ColumnDefinitions="*,Auto">


					<controls:FFPageHeader
    Title="Извештаи"
    Subtitle="Анализа, следење и системски извештаи" >
				<controls:FFPageHeader.HeaderContent>
<controls:FFButton
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						HeightRequestEx="40"
						Text="Назад"
						WidthRequestEx="130" />
			</controls:FFPageHeader.HeaderContent>
		</controls:FFPageHeader>

<controls:FFButton
    Grid.Column="1"
    ButtonKind="Primary"
    Command="{Binding NewReportCommand}"
    HeightRequestEx="42"
    IsEnabled="{Binding CanCreate}"
    Text="Нов извештај"
    WidthRequestEx="150" />


					<!--<Button
						Grid.Column="1"
						Command="{Binding GenerateReportCommand}"
						HeightRequest="42"
						Style="{StaticResource TabButtonActiveStyle}"
						Text="Генерирај Pdf"
						WidthRequest="140" />-->


				</Grid>

			</Border>



			<!--  METRICS  -->

			<Grid
				Grid.Row="1"
				Margin="16,0"
				ColumnDefinitions="*,*,*"
				ColumnSpacing="16">


				<Border
					Padding="20"
					BackgroundColor="White"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">

					<VerticalStackLayout>

						<Label
							FontSize="13"
							Text="{Binding Metric1Title}"
							TextColor="{StaticResource SparkTextSecondary}" />


						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding Metric1Value}"
							TextColor="{StaticResource SparkTextPrimary}" />

					</VerticalStackLayout>

				</Border>



				<Border
					Grid.Column="1"
					Padding="20"
					BackgroundColor="White"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">

					<VerticalStackLayout>

						<Label
							FontSize="13"
							Text="{Binding Metric2Title}"
							TextColor="{StaticResource SparkTextSecondary}" />


						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding Metric2Value}"
							TextColor="{StaticResource SparkDanger}" />

					</VerticalStackLayout>

				</Border>



				<Border
					Grid.Column="2"
					Padding="20"
					BackgroundColor="White"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">

					<VerticalStackLayout>

						<Label
							FontSize="13"
							Text="{Binding Metric3Title}"
							TextColor="{StaticResource SparkTextSecondary}" />


						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding Metric3ValueText}"
							TextColor="{StaticResource SparkAccentTeal}" />

					</VerticalStackLayout>

				</Border>


			</Grid>





			<!--  GRID  -->

			<controls:FFSectionCard Grid.Row="3">

				<!--  Patient history action appears only after a patient is selected.  -->
				<Grid
					Margin="0,0,0,10"
					ColumnDefinitions="*,Auto"
					IsVisible="{Binding IsPatientHistoryMode}">

					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding SelectedPatientLabel, StringFormat='ИСТОРИЈА НА ПАЦИЕНТ: {0}'}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />

					<controls:FFButton
						Grid.Column="1"
						ButtonKind="Primary"
						Command="{Binding GeneratePatientHistoryReportCommand}"
						IsEnabled="{Binding CanExport}"
						HeightRequestEx="42"
						Text="Генерирај извештај – Историја на Скор" />
				</Grid>


				<controls:SparkDataGridView
					Columns="{Binding GridColumns}"
					CurrentPage="{Binding CurrentPage}"
					NextPageCommand="{Binding NextPageCommand}"
					PageChangedCommand="{Binding PageChangedCommand}"
					PreviousPageCommand="{Binding PreviousPageCommand}"
					Rows="{Binding GridRows}"
					TotalPages="{Binding TotalPages}" />


			</controls:FFSectionCard>




		</Grid>



	</Grid>


</ContentPage>