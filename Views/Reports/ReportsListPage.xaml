<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
	x:Class="EHMR.Views.Reports.ReportsListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Reports"
	x:DataType="viewModels:ReportListViewModel">


	<Grid ColumnDefinitions="260,*">


		<!--  ================= LEFT MENU =================  -->

		<Border Grid.Column="0" StrokeThickness="0">

			<ContentView x:Name="MenuHost" />

		</Border>



		<!--  ================= MAIN =================  -->

		<Grid
			Grid.Column="1"
			Padding="0"
			BackgroundColor="{StaticResource PageBackground}"
			RowDefinitions="Auto,Auto,Auto,*"
			RowSpacing="0">



			<!--  HEADER  -->

			<Border Style="{StaticResource PageCardStyleDashboard}">

				<Grid ColumnDefinitions="*,Auto">


					<controls:FFPageHeader Title="Извештаи" Subtitle="Анализа, следење и системски извештаи" />


					<!--<Button
						Grid.Column="1"
						Command="{Binding GenerateReportCommand}"
						HeightRequest="42"
						Style="{StaticResource TabButtonActiveStyle}"
						Text="Генерирај Pdf"
						WidthRequest="140" />-->


				</Grid>

			</Border>



			<!--  METRICS  -->

			<Grid
				Grid.Row="1"
				Margin="16,0"
				ColumnDefinitions="*,*,*"
				ColumnSpacing="16">


				<Border
					Padding="20"
					BackgroundColor="White"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">

					<VerticalStackLayout>

						<Label
							FontSize="13"
							Text="{Binding Metric1Title}"
							TextColor="{StaticResource SparkTextSecondary}" />


						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding Metric1Value}"
							TextColor="{StaticResource SparkTextPrimary}" />

					</VerticalStackLayout>

				</Border>



				<Border
					Grid.Column="1"
					Padding="20"
					BackgroundColor="White"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">

					<VerticalStackLayout>

						<Label
							FontSize="13"
							Text="{Binding Metric2Title}"
							TextColor="{StaticResource SparkTextSecondary}" />


						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding Metric2Value}"
							TextColor="{StaticResource SparkDanger}" />

					</VerticalStackLayout>

				</Border>



				<Border
					Grid.Column="2"
					Padding="20"
					BackgroundColor="White"
					Stroke="{StaticResource BorderColor}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="1">

					<VerticalStackLayout>

						<Label
							FontSize="13"
							Text="{Binding Metric3Title}"
							TextColor="{StaticResource SparkTextSecondary}" />


						<Label
							FontAttributes="Bold"
							FontSize="28"
							Text="{Binding Metric3ValueText}"
							TextColor="{StaticResource SparkAccentTeal}" />

					</VerticalStackLayout>

				</Border>


			</Grid>





			<!--  FILTERS  -->

			<controls:FFSectionCard Grid.Row="2">

				<VerticalStackLayout Spacing="10">

					<!-- Patient history selector: same suggestion UX as Dashboard -->
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<controls:SparkExplorerHeaderView
							SearchPlaceholder="Пребарај пациент за историја..."
							SearchText="{Binding PatientSearchText}"
							SelectedSuggestion="{Binding SelectedPatientSuggestion, Mode=TwoWay}"
							ShowSuggestions="{Binding ShowPatientSuggestions}"
							Suggestions="{Binding PatientSuggestions}"
							TabsVisible="False">

							<controls:SparkExplorerHeaderView.SuggestionTemplate>
								<DataTemplate x:DataType="{x:Null}">
									<Border
										Margin="2"
										Padding="12,8"
										BackgroundColor="{StaticResource Gray100}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 2"
										StrokeThickness="1.2">
										<Grid ColumnDefinitions="2*,1.2*,1.2*" ColumnSpacing="14">
											<VerticalStackLayout Spacing="1">
												<Label
													FontSize="10"
													Text="Име и презиме"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<Label
													FontAttributes="Bold"
													FontSize="12"
													Text="{Binding DisplayText}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="1" Spacing="1">
												<Label
													FontSize="10"
													Text="Идентификатор"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<Label
													FontAttributes="Bold"
													FontSize="12"
													Text="{Binding Id}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
											<Label
												Grid.Column="2"
												FontSize="11"
												Text="Избери за историја"
												TextColor="{StaticResource SparkAccentTealDark}"
												VerticalOptions="Center" />
										</Grid>
									</Border>
								</DataTemplate>
							</controls:SparkExplorerHeaderView.SuggestionTemplate>
						</controls:SparkExplorerHeaderView>

						<controls:FFButton
							Grid.Column="1"
							ButtonKind="Secondary"
							Command="{Binding ClearPatientHistoryCommand}"
							HeightRequestEx="42"
							Text="Исчисти пациент" />
					</Grid>

					<Border
						BackgroundColor="{StaticResource SparkContentBackground}"
						IsVisible="{Binding IsPatientHistoryMode}"
						Padding="10,7"
						Stroke="{StaticResource SparkBorder}"
						StrokeThickness="1">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="{Binding SelectedPatientLabel, StringFormat='ИСТОРИЈА НА ПАЦИЕНТ: {0}'}"
							TextColor="{StaticResource SparkAccentTealDark}" />
					</Border>

					<controls:SparkExplorerHeaderView
						Buttons="{Binding Buttons}"
						Pickers="{Binding Pickers}"
						SearchCommand="{Binding SearchCommand}"
						SearchPlaceholder="Пребарување во извештај..."
						SearchText="{Binding SearchText}"
						Tabs="{Binding Tabs}" />

				</VerticalStackLayout>

			</controls:FFSectionCard>






			<!--  GRID  -->

			<controls:FFSectionCard Grid.Row="3">

				<!-- Patient history action appears only after a patient is selected. -->
				<Grid
					Margin="0,0,0,10"
					ColumnDefinitions="*,Auto"
					IsVisible="{Binding IsPatientHistoryMode}">

					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding SelectedPatientLabel, StringFormat='ИСТОРИЈА НА ПАЦИЕНТ: {0}'}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />

					<controls:FFButton
						Grid.Column="1"
						ButtonKind="Primary"
						Command="{Binding GeneratePatientHistoryReportCommand}"
						HeightRequestEx="42"
						Text="Генерирај извештај – Историја на пациент" />
				</Grid>


				<controls:SparkDataGridView
					Columns="{Binding GridColumns}"
					CurrentPage="{Binding CurrentPage}"
					NextPageCommand="{Binding NextPageCommand}"
					PageChangedCommand="{Binding PageChangedCommand}"
					PreviousPageCommand="{Binding PreviousPageCommand}"
					Rows="{Binding GridRows}"
					TotalPages="{Binding TotalPages}" />


			</controls:FFSectionCard>




		</Grid>



	</Grid>


</ContentPage>