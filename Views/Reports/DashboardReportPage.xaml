<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Reports.DashboardReportPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:EHMR.Domain.Entities.Reports"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:ReportViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<!--  Same shared card styles used on the Dashboard, so both pages read as one system  -->
			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 0" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<!--  Same 260,* split as the Dashboard menu/content column  -->
	<Grid ColumnDefinitions="260,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="0"
			Style="{StaticResource ListPageRootGridStyle}">

			<!--  HEADER — same PageCardStyleDashboard + FFPageHeader + FFButton as Dashboard  -->
			<Border
				Grid.Row="0"
				Margin="0"
				Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<sc:FFPageHeader
						Title="Извештаи за пациенти"
						Grid.Column="0"
						Subtitle="Преглед, филтрирање и генерирање извештаи за пациенти" />

					<sc:FFButton
						Grid.Column="1"
						Margin="0,0,33,0"
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						ContentPadding="16,16"
						HeightRequestEx="45"
						Text="Назад"
						WidthRequestEx="140" />
				</Grid>
			</Border>

			<!--  MAIN REPORT AREA: keep the grid in a bounded row. SparkDataGridView
			      owns its vertical ScrollView, so it must not be placed inside
			      another ScrollView.  -->
			<Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="12">
				<sc:FFSectionCard Grid.Row="0" Margin="0" ContentPadding="0">
					<sc:SparkExplorerHeaderView
						Buttons="{Binding Buttons}"
						Pickers="{Binding Pickers}"
						SearchPlaceholder="Пребарување на пациенти..."
						SearchText="{Binding ScorePatientSearchText, Mode=TwoWay}"
						SelectedSuggestion="{Binding SelectedScorePatientSuggestion, Mode=TwoWay}"
						ShowSuggestions="{Binding ShowScorePatientSuggestions}"
						Suggestions="{Binding ScorePatientSuggestions}"
						Tabs="{Binding Tabs}"
						TabsVisible="True">
						<sc:SparkExplorerHeaderView.SuggestionTemplate>
							<DataTemplate x:DataType="{x:Null}">
								<Border
									Margin="2"
									Padding="12,8"
									BackgroundColor="{StaticResource Gray100}"
									Stroke="{StaticResource SparkBorderSubtle}"
									StrokeShape="RoundRectangle 2"
									StrokeThickness="1.2">
									<Grid ColumnDefinitions="1.7*,1.1*,1.1*" ColumnSpacing="14">
										<VerticalStackLayout Spacing="1">
											<Label FontSize="10" Text="Име и презиме" TextColor="{StaticResource SparkAccentTealDark}" />
											<Label FontAttributes="Bold" FontSize="12" Text="{Binding FullName}" TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="1" Spacing="1">
											<Label FontSize="10" Text="ЕМБГ" TextColor="{StaticResource SparkAccentTealDark}" />
											<Label FontAttributes="Bold" FontSize="12" Text="{Binding NationalId}" TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
										<VerticalStackLayout Grid.Column="2" Spacing="1">
											<Label FontSize="10" Text="СЗБО број" TextColor="{StaticResource SparkAccentTealDark}" />
											<Label FontAttributes="Bold" FontSize="12" Text="{Binding SzboNumber}" TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</sc:SparkExplorerHeaderView.SuggestionTemplate>
					</sc:SparkExplorerHeaderView>

					<Grid
						Margin="12,0,12,12"
						ColumnDefinitions="Auto,150,Auto,150,*"
						ColumnSpacing="8"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="11"
							Text="ОД"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<sc:FFDatePicker
							Grid.Column="1"
							HasLabel="False"
							SelectedDate="{Binding StartDate, Mode=TwoWay}" />
						<Label
							Grid.Column="2"
							FontAttributes="Bold"
							FontSize="11"
							Text="ДО"
							TextColor="{StaticResource SparkTextSecondary}"
							VerticalOptions="Center" />
						<sc:FFDatePicker
							Grid.Column="3"
							HasLabel="False"
							SelectedDate="{Binding EndDate, Mode=TwoWay}" />
					</Grid>
				</sc:FFSectionCard>

				<sc:FFSectionCard Grid.Row="1" Margin="0" ContentPadding="0" VerticalOptions="Fill">
					<Grid RowDefinitions="Auto,*" VerticalOptions="Fill">
						<ActivityIndicator
							Grid.Row="0"
							Margin="2"
							HeightRequest="50"
							HorizontalOptions="Center"
							IsRunning="{Binding IsBusy}"
							IsVisible="{Binding IsBusy}"
							VerticalOptions="Center"
							Color="{StaticResource SparkAccentTeal}" />
						<sc:SparkDataGridView
							Grid.Row="1"
							Margin="2"
							Columns="{Binding GridColumns}"
							CurrentPage="{Binding CurrentPage}"
							NextPageCommand="{Binding NextPageCommand}"
							PageChangedCommand="{Binding PageChangedCommand}"
							PreviousPageCommand="{Binding PreviousPageCommand}"
							Rows="{Binding GridRows}"
							TotalPages="{Binding TotalPages}"
							VerticalOptions="Fill" />
					</Grid>
				</sc:FFSectionCard>
			</Grid>

			<!--  LOADING OVERLAY — identical to Dashboard's overlay  -->
			<Grid
				Grid.Row="1"
				BackgroundColor="{StaticResource SparkOverlay}"
				IsVisible="{Binding IsBusy}">
				<VerticalStackLayout
					HorizontalOptions="Center"
					Spacing="12"
					VerticalOptions="Center">
					<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
					<Label
						FontSize="13"
						Text="Вчитување..."
						TextColor="{StaticResource SparkTextPrimary}" />
				</VerticalStackLayout>
			</Grid>

		</Grid>
	</Grid>
</ContentPage>
