<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Reports.DashboardReportPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:EHMR.Domain.Entities.Reports"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:ReportViewModel"
	BackgroundColor="{StaticResource White}"
	Shell.PresentationMode="NotAnimated">

	<ContentPage.Resources>
		<ResourceDictionary>

			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 0" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

			<!--  Small bold label used in the filter row  -->
			<Style x:Key="FilterLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="VerticalOptions" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="260,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="0"
			Style="{StaticResource ListPageRootGridStyle}">

			<!--  HEADER  -->
			<Border
				Grid.Row="0"
				Margin="0"
				Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<sc:FFPageHeader
						Title="Извештаи за пациенти"
						Grid.Column="0"
						Subtitle="Преглед, филтрирање и генерирање извештаи за пациенти" />

					<sc:FFButton
						Grid.Column="1"
						Margin="0,0,33,0"
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						ContentPadding="16,16"
						HeightRequestEx="45"
						Text="Назад"
						WidthRequestEx="140" />
				</Grid>
			</Border>

			<!--  MAIN SCROLL AREA  -->
			<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">

					<Grid x:Name="DetailsGrid" IsVisible="True">
						<VerticalStackLayout Spacing="0">

							<!--  ============ FILTER + EXPLORER HEADER (one block) ============  -->
							<VerticalStackLayout Spacing="12">

								<!--  Row 1: report type (left) + actions (right)  -->
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
									<VerticalStackLayout
										Grid.Column="0"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Тип на извештај"
											TextColor="{StaticResource SparkTextMuted}" />
										<Label
											FontAttributes="Bold"
											FontSize="18"
											Text="{Binding ActiveReportTitle}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>

									<HorizontalStackLayout
										Grid.Column="1"
										Spacing="10"
										VerticalOptions="Center">
										<sc:FFButton
											ButtonKind="Secondary"
											Command="{Binding ApplyPeriodAndRegenerateCommand}"
											ContentPadding="14,0"
											HeightRequestEx="42"
											Text="Освежи" />
										<sc:FFButton
											ButtonKind="Primary"
											Command="{Binding ExecuteReportGenerationCommand}"
											ContentPadding="14,0"
											HeightRequestEx="42"
											Text="Генерирај" />
									</HorizontalStackLayout>
								</Grid>

								<!--  Row 2: period + medicine search  -->
								<Grid
									ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
									ColumnSpacing="10"
									VerticalOptions="Center">

									<Label
										Grid.Column="0"
										Style="{StaticResource FilterLabel}"
										Text="Од:" />
									<sc:FFDatePicker
										Grid.Column="1"
										SelectedDate="{Binding FromDate, Mode=TwoWay}"
										WidthRequest="125" />

									<Label
										Grid.Column="2"
										Style="{StaticResource FilterLabel}"
										Text="До:" />
									<sc:FFDatePicker
										Grid.Column="3"
										SelectedDate="{Binding ToDate, Mode=TwoWay}"
										WidthRequest="125" />

									<HorizontalStackLayout
										Grid.Column="4"
										Margin="12,0,0,0"
										Spacing="6"
										VerticalOptions="Center">
										<CheckBox IsChecked="{Binding IsMedicineSearchEnabled, Mode=TwoWay}" Color="{StaticResource SparkAccentTeal}" />
										<Label Style="{StaticResource FilterLabel}" Text="Пребарување по лек" />
									</HorizontalStackLayout>

									<HorizontalStackLayout
										Grid.Column="5"
										IsVisible="{Binding IsMedicineSearchEnabled}"
										Spacing="8"
										VerticalOptions="Center">
										<Label Style="{StaticResource FilterLabel}" Text="По лек:" />
										<sc:FFPicker
											ItemsSource="{Binding MedicinePicker.Items}"
											Label=""
											SelectedItem="{Binding MedicinePicker.SelectedItem, Mode=TwoWay}"
											WidthRequest="320" />
									</HorizontalStackLayout>
								</Grid>

								<!--  Row 3: pickers + patient search  -->
								<sc:SparkExplorerHeaderView
									Pickers="{Binding Pickers}"
									SearchPlaceholder="Пребарување на пациенти..."
									SearchText="{Binding ScorePatientSearchText, Mode=TwoWay}"
									SelectedSuggestion="{Binding SelectedScorePatientSuggestion, Mode=TwoWay}"
									ShowSuggestions="{Binding ShowScorePatientSuggestions}"
									Suggestions="{Binding ScorePatientSuggestions}" />
							</VerticalStackLayout>

							<!--  Data grid  -->
							<sc:FFSectionCard Margin="0,12,0,0" ContentPadding="0">
								<Grid RowDefinitions="Auto,*">
									<ActivityIndicator
										Grid.Row="0"
										Margin="2"
										HeightRequest="50"
										HorizontalOptions="Center"
										IsRunning="{Binding IsBusy}"
										IsVisible="{Binding IsBusy}"
										VerticalOptions="Center"
										Color="{StaticResource SparkAccentTeal}" />
									<sc:SparkDataGridView
										Grid.Row="1"
										Margin="2"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										Rows="{Binding GridRows}"
										TotalPages="{Binding TotalPages}" />
								</Grid>
							</sc:FFSectionCard>

						</VerticalStackLayout>
					</Grid>

				</VerticalStackLayout>
			</ScrollView>

		</Grid>
	</Grid>
</ContentPage>
