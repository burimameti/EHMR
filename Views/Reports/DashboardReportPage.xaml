<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Reports.DashboardReportPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:EHMR.Domain.Entities.Reports"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:ReportViewModel"
	Shell.PresentationMode="NotAnimated"
	BackgroundColor="{StaticResource White}">

	<ContentPage.Resources>
		<ResourceDictionary>


			<!--  Same shared card styles used on the Dashboard, so both pages read as one system  -->
			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 0" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<!--  Same 290,* split as the Dashboard menu/content column  -->
	<Grid ColumnDefinitions="260,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="0"
			Style="{StaticResource ListPageRootGridStyle}">

			<!--  =========================================================  -->
			<!--  HEADER — same PageHeaderCardStyle + FFPageHeader + FFButton as Dashboard  -->
			<!--  =========================================================  -->
			<Border
				Grid.Row="0"
				Margin="0"
				Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<sc:FFPageHeader
						Title="Извештаи за пациенти"
						Grid.Column="0"
						Subtitle="Преглед, филтрирање и генерирање извештаи за пациенти" />

					<sc:FFButton
						Grid.Column="1"
						Margin="0,0,33,0"
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						ContentPadding="16,16"
						HeightRequestEx="45"
						Text="Назад"
						WidthRequestEx="140" />
				</Grid>
			</Border>

			<!--  =========================================================  -->
			<!--  MAIN SCROLL AREA  -->
			<!--  =========================================================  -->
			<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">

					<!--  =========================================================  -->
					<!--  DETAIL VIEW — table + analytics sidebar  -->
					<!--  =========================================================  -->
					<Grid
						x:Name="DetailsGrid"
						Margin="0,0,0,0"
						ColumnSpacing="0"
						IsVisible="True">

						<!--  LEFT COLUMN  -->
						<VerticalStackLayout Spacing="0">

							<!-- Report filters: type above pickers; dates + medicine + actions on one row. -->
							<VerticalStackLayout Spacing="10">
								<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
									<VerticalStackLayout Spacing="1">
										<Label FontAttributes="Bold" FontSize="13" Text="Тип на извештај" TextColor="{StaticResource SparkTextMuted}" />
										<Label FontAttributes="Bold" FontSize="18" Text="{Binding ActiveReportTitle}" TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>
								</Grid>

								<sc:SparkExplorerHeaderView
									Pickers="{Binding Pickers}"
									SearchPlaceholder="Пребарување на пациенти..."
									SearchText="{Binding ScorePatientSearchText, Mode=TwoWay}"
									SelectedSuggestion="{Binding SelectedScorePatientSuggestion, Mode=TwoWay}"
									ShowSuggestions="{Binding ShowScorePatientSuggestions}"
									Suggestions="{Binding ScorePatientSuggestions}" />

								<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
									<Label FontAttributes="Bold" Text="Од:" VerticalOptions="Center" />
									<sc:FFDatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" WidthRequest="125" />
									<Label FontAttributes="Bold" Text="До:" VerticalOptions="Center" />
									<sc:FFDatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" WidthRequest="125" />
									<HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center">
										<CheckBox Color="{StaticResource SparkAccentTeal}" IsChecked="{Binding IsMedicineSearchEnabled, Mode=TwoWay}" />
										<Label FontAttributes="Bold" Text="Пребарување по лек" VerticalOptions="Center" />
									</HorizontalStackLayout>
									<sc:FFButton ButtonKind="Secondary" Command="{Binding ApplyPeriodAndRegenerateCommand}" ContentPadding="14,0" HeightRequestEx="42" Text="Освежи" />
									<sc:FFButton ButtonKind="Primary" Command="{Binding ExecuteReportGenerationCommand}" ContentPadding="14,0" HeightRequestEx="42" Text="Генерирај" />
								</Grid>

								<HorizontalStackLayout IsVisible="{Binding IsMedicineSearchEnabled}" Spacing="8" VerticalOptions="Center">
									<Label FontAttributes="Bold" Text="По лек" VerticalOptions="Center" />
									<sc:FFPicker ItemsSource="{Binding MedicinePicker.Items}" Label="" SelectedItem="{Binding MedicinePicker.SelectedItem, Mode=TwoWay}" WidthRequest="320" />
								</HorizontalStackLayout>
							</VerticalStackLayout>

							<!--  Data grid  -->
							<sc:FFSectionCard Margin="0" ContentPadding="0">
								<Grid RowDefinitions="Auto,*">
									<ActivityIndicator
										Grid.Row="0"
										Margin="2,2,2,2"
										HeightRequest="50"
										HorizontalOptions="Center"
										IsRunning="{Binding IsBusy}"
										IsVisible="{Binding IsBusy}"
										VerticalOptions="Center"
										Color="{StaticResource SparkAccentTeal}" />
									<sc:SparkDataGridView
										Grid.Row="1"
										Margin="2,2,2,2"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										Rows="{Binding GridRows}"
										TotalPages="{Binding TotalPages}" />
								</Grid>
							</sc:FFSectionCard>

						</VerticalStackLayout>

						<!--  Analytics and PDF export removed.  -->

					</Grid>

				</VerticalStackLayout>
			</ScrollView>

		</Grid>
	</Grid>
</ContentPage>
