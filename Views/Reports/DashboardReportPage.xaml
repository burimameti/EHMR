<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Reports.DashboardReportPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:models="clr-namespace:EHMR.Domain.Entities.Reports"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:ReportViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<converters:ReportCategoryConverter x:Key="ReportCategoryConverter" />

			<!--  Same shared card styles used on the Dashboard, so both pages read as one system  -->
			<Style x:Key="DashboardCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>

			<Style x:Key="DashboardCardCountBadge" TargetType="Border">
				<Setter Property="Padding" Value="10,4" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 0" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>

			<Style x:Key="DashboardCardCountLabel" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<Style x:Key="DashboardEmptyStateLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="HorizontalTextAlignment" Value="Center" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextMuted}" />
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<!--  Same 290,* split as the Dashboard menu/content column  -->
	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="0"
			Style="{StaticResource ListPageRootGridStyle}">

			<!--  =========================================================  -->
			<!--  HEADER — same PageHeaderCardStyle + FFPageHeader + FFButton as Dashboard  -->
			<!--  =========================================================  -->
			<Border
				Grid.Row="0"
				Margin="0"
				Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<sc:FFPageHeader
						Title="Извештаи"
						Grid.Column="0"
						Subtitle="Преглед, пребарување и преземање на генерирани извештаи" />
					<HorizontalStackLayout
						Grid.Column="1"
						Margin="0,8,8,8"
						Spacing="10"
						VerticalOptions="Center">
						<sc:FFButton
							ButtonKind="Secondary"
							Command="{Binding BackToHubCommand}"
							ContentPadding="0,0"
							Text="Назад" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  =========================================================  -->
			<!--  MAIN SCROLL AREA  -->
			<!--  =========================================================  -->
			<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">

					<!--  =========================================================  -->
					<!--  HUB VIEW — report definition cards  -->
					<!--  =========================================================  -->
					<sc:FFSectionCard>
						<Border.Triggers>
							<DataTrigger
								Binding="{Binding IsShowingDetails}"
								TargetType="Border"
								Value="True">
								<Setter Property="IsVisible" Value="False" />
							</DataTrigger>
						</Border.Triggers>

						<CollectionView ItemsSource="{Binding AvailableReports}">
							<CollectionView.EmptyView>
								<VerticalStackLayout
									Padding="20"
									HorizontalOptions="Center"
									Spacing="16"
									VerticalOptions="Center">
									<Label Style="{StaticResource DashboardEmptyStateLabel}" Text="Нема достапни извештаи" />
								</VerticalStackLayout>
							</CollectionView.EmptyView>

							<CollectionView.ItemsLayout>
								<GridItemsLayout
									HorizontalItemSpacing="0"
									Orientation="Vertical"
									Span="2"
									VerticalItemSpacing="0" />
							</CollectionView.ItemsLayout>
							<CollectionView.ItemTemplate>
								<DataTemplate x:DataType="models:ReportDefinition">
									<Border
										Padding="20"
										BackgroundColor="{StaticResource SparkPageBackground}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeThickness="1">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="14" />
										</Border.StrokeShape>
										<!--  Same shadow recipe as Dashboard's appointment/encounter cards  -->
										<Border.Shadow>
											<Shadow
												Brush="{StaticResource SparkTextPrimary}"
												Opacity="0.08"
												Radius="10"
												Offset="0,3" />
										</Border.Shadow>
										<Border.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ReportViewModel}}, Path=SelectReportCommand}" CommandParameter="{Binding .}" />
										</Border.GestureRecognizers>

										<Grid RowDefinitions="Auto,Auto,1,Auto" RowSpacing="0">

											<!--  Icon + title  -->
											<Grid Grid.Row="0" ColumnDefinitions="Auto,*">
												<Border
													Grid.Column="0"
													Margin="0,0,14,0"
													Padding="10"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													HeightRequest="48"
													StrokeThickness="0"
													VerticalOptions="Center"
													WidthRequest="48">
													<Border.StrokeShape>
														<RoundRectangle CornerRadius="12" />
													</Border.StrokeShape>
													<Label
														FontSize="22"
														HorizontalOptions="Center"
														Text="{Binding Icon}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="3"
													VerticalOptions="Center">
													<Label
														FontSize="15"
														LineBreakMode="WordWrap"
														Style="{StaticResource DashboardCardTitle}"
														Text="{Binding Title}" />
													<Label
														CharacterSpacing="0.5"
														FontAttributes="Bold"
														FontSize="10"
														Text="КЛИКНИ ЗА ОТВОРАЊЕ"
														TextColor="{StaticResource SparkAccentTeal}" />
												</VerticalStackLayout>
											</Grid>

											<!--  Description  -->
											<Label
												Grid.Row="1"
												FontSize="13"
												LineBreakMode="TailTruncation"
												MaxLines="2"
												Text="{Binding Description}"
												TextColor="{StaticResource SparkTextSecondary}" />

											<!--  Divider  -->
											<BoxView Grid.Row="2" BackgroundColor="{StaticResource SparkBorder}" />

											<!--  Footer — count badge matches Dashboard's card count badge  -->
											<Grid Grid.Row="3" ColumnDefinitions="*,Auto">
												<Border
													Grid.Column="0"
													Padding="10,4"
													HorizontalOptions="Start"
													Style="{StaticResource DashboardCardCountBadge}">
													<Label Style="{StaticResource DashboardCardCountLabel}" Text="{Binding Category, Converter={StaticResource ReportCategoryConverter}, StringFormat='Категорија: {0}'}" />
												</Border>
												<Label
													Grid.Column="1"
													FontAttributes="Bold"
													FontSize="12"
													Text="Отвори ➔"
													TextColor="{StaticResource SparkAccentTeal}"
													VerticalOptions="Center" />
											</Grid>
										</Grid>
									</Border>
								</DataTemplate>
							</CollectionView.ItemTemplate>
						</CollectionView>
					</sc:FFSectionCard>

					<!--  =========================================================  -->
					<!--  DETAIL VIEW — table + analytics sidebar  -->
					<!--  =========================================================  -->
					<Grid
						x:Name="DetailsGrid"
						Margin="0,0,0,0"
						ColumnDefinitions="*,200"
						ColumnSpacing="0"
						IsVisible="False">
						<Grid.Triggers>
							<DataTrigger
								Binding="{Binding IsShowingDetails}"
								TargetType="Grid"
								Value="True">
								<Setter Property="IsVisible" Value="True" />
							</DataTrigger>
						</Grid.Triggers>

						<!--  LEFT COLUMN  -->
						<VerticalStackLayout Grid.Column="0" Spacing="0">

							<sc:FFSectionCard Margin="0">
								<VerticalStackLayout Spacing="10">

									<VerticalStackLayout Spacing="2">
										<Label
											FontSize="15"
											Style="{StaticResource DashboardCardTitle}"
											Text="{Binding ActiveReportTitle, StringFormat='Извештај зa  : {0}'}" />
										<Label
											FontSize="12"
											Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
											TextColor="{StaticResource SparkTextMuted}" />
									</VerticalStackLayout>

									<FlexLayout Style="{StaticResource ResponsiveWrapRow}">

										<HorizontalStackLayout Spacing="8" StyleClass="FilterItem">
											<Label
												Style="{StaticResource SparkTabTitleLabelStyle}"
												Text="Период"
												VerticalOptions="Center" />
											<sc:FFPicker
												ItemsSource="{Binding PeriodTypeOptions}"
												Label=""
												MinimumWidthRequest="130"
												SelectedItem="{Binding SelectedPeriodTypeLabel, Mode=TwoWay}" />
										</HorizontalStackLayout>

										<HorizontalStackLayout Spacing="8" StyleClass="FilterItem">
											<Label
												Style="{StaticResource SparkTabTitleLabelStyle}"
												Text="ОД"
												VerticalOptions="Center" />
											<sc:FFDatePicker HasLabel="False" SelectedDate="{Binding StartDate, Mode=TwoWay}" />
										</HorizontalStackLayout>

										<HorizontalStackLayout Spacing="8" StyleClass="FilterItem">
											<Label
												Style="{StaticResource SparkTabTitleLabelStyle}"
												Text="ДО"
												VerticalOptions="Center" />
											<sc:FFDatePicker HasLabel="False" SelectedDate="{Binding EndDate, Mode=TwoWay}" />
										</HorizontalStackLayout>

										<sc:FFButton
											ButtonKind="Secondary"
											Command="{Binding ApplyPeriodAndRegenerateCommand}"
											ContentPadding="16,0"
											HeightRequestEx="38"
											IsVisible="{Binding CanCreate}"
											StyleClass="FilterItem"
											Text="Примени период" />

										<sc:FFButton
											BackgroundColorEx="{StaticResource SidebarActiveBg}"
											ButtonKind="Primary"
											Command="{Binding ExecuteReportGenerationCommand}"
											ContentPadding="16,0"
											HeightRequestEx="38"
											IsVisible="{Binding CanCreate}"
											StyleClass="FilterItem"
											Text="🔄 Генерирај"
											TextColorEx="White" />
									</FlexLayout>
								</VerticalStackLayout>
							</sc:FFSectionCard>

							<!--  Explorer header: tabs + search + pickers  -->
							<sc:FFSectionCard Margin="0">
								<sc:SparkExplorerHeaderView
									Buttons="{Binding Buttons}"
									Pickers="{Binding Pickers}"
									SearchPlaceholder="Филтрирај редови..."
									SearchText="{Binding SearchText, Mode=TwoWay}"
									Tabs="{Binding Tabs}" />
							</sc:FFSectionCard>

							<!--  Data grid  -->
							<sc:FFSectionCard Margin="0" ContentPadding="0">
								<Grid RowDefinitions="Auto,*">
									<ActivityIndicator
										Grid.Row="0"
										HeightRequest="50"
										HorizontalOptions="Center"
										IsRunning="{Binding IsBusy}"
										IsVisible="{Binding IsBusy}"
										VerticalOptions="Center"
										WidthRequest="50"
										Color="{StaticResource SparkAccentTeal}" />
									<sc:SparkDataGridView
										Grid.Row="1"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										Rows="{Binding GridRows}"
										TotalPages="{Binding TotalPages}" />
								</Grid>
							</sc:FFSectionCard>

							<!--  Report controls bar  -->


						</VerticalStackLayout>

						<!--  RIGHT SIDEBAR — analytics + export  -->
						<ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Spacing="0">

								<!--  Analytics card  -->
								<sc:FFSectionCard Margin="0">
									<VerticalStackLayout Spacing="6">

										<sc:CrudSectionHeader Title="АНАЛИТИКА" />

										<!--  Metric 1  -->
										<Border
											Padding="16"
											BackgroundColor="{StaticResource SparkPageBackground}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeThickness="1">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="12" />
											</Border.StrokeShape>
											<Grid ColumnDefinitions="4,*">
												<BoxView
													Grid.Column="0"
													BackgroundColor="{StaticResource SparkAccentTeal}"
													HorizontalOptions="Start"
													WidthRequest="4" />
												<VerticalStackLayout
													Grid.Column="1"
													Padding="12,0,0,0"
													Spacing="4">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="{Binding Metric1Title}"
														TextColor="{StaticResource SparkTextMuted}" />
													<Label
														FontAttributes="Bold"
														FontSize="26"
														Text="{Binding Metric1Value}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
											</Grid>
										</Border>

										<!--  Metric 2  -->
										<Border
											Padding="16"
											BackgroundColor="{StaticResource SparkPageBackground}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeThickness="1">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="12" />
											</Border.StrokeShape>
											<Grid ColumnDefinitions="4,*">
												<BoxView
													Grid.Column="0"
													BackgroundColor="{StaticResource SparkAccentTeal}"
													HorizontalOptions="Start"
													WidthRequest="4" />
												<VerticalStackLayout
													Grid.Column="1"
													Padding="12,0,0,0"
													Spacing="4">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="{Binding Metric2Title}"
														TextColor="{StaticResource SparkTextMuted}" />
													<Label
														FontAttributes="Bold"
														FontSize="26"
														Text="{Binding Metric2Value}"
														TextColor="{StaticResource SparkAccentTeal}" />
												</VerticalStackLayout>
											</Grid>
										</Border>

										<!--  Metric 3  -->
										<!--<Border
											Padding="16"
											BackgroundColor="{StaticResource SparkPageBackground}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeThickness="1">
											<Border.StrokeShape>
												<RoundRectangle CornerRadius="12" />
											</Border.StrokeShape>
											<Grid ColumnDefinitions="4,*">
												<BoxView
													Grid.Column="0"
													BackgroundColor="{StaticResource SparkAccentTeal}"
													HorizontalOptions="Start"
													WidthRequest="4" />
												<VerticalStackLayout
													Grid.Column="1"
													Padding="12,0,0,0"
													Spacing="4">
													<Label
														FontAttributes="Bold"
														FontSize="11"
														Text="{Binding Metric3Title}"
														TextColor="{StaticResource SparkTextMuted}" />
													<Label
														FontAttributes="Bold"
														FontSize="26"
														Text="{Binding Metric3Value}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
											</Grid>
										</Border>-->

									</VerticalStackLayout>
								</sc:FFSectionCard>

								<!--  Export card  -->
								<sc:FFSectionCard Margin="0">
									<VerticalStackLayout Spacing="10">

										<sc:CrudSectionHeader Title="ГЕНЕРИРАЈ" />

										<Button
											Padding="0,0"
											BackgroundColor="{StaticResource SidebarActiveBg}"
											Command="{Binding ExportToPdfCommand}"
											HeightRequest="38"
											Text="📊 ГЕНЕРИРАЈ PDF"
											TextColor="White" />
										<Button
											Padding="0,0"
											BackgroundColor="{StaticResource SidebarActiveBg}"
											Command="{Binding ExportToExcelCommand}"
											HeightRequest="38"
											Text="📊 ГЕНЕРИРАЈ Excel"
											TextColor="White" />
										<!--<sc:FFButton />-->

									</VerticalStackLayout>
								</sc:FFSectionCard>

							</VerticalStackLayout>
						</ScrollView>

					</Grid>

				</VerticalStackLayout>
			</ScrollView>

			<!--  LOADING OVERLAY — identical to Dashboard's overlay  -->
			<Grid
				Grid.Row="1"
				BackgroundColor="{StaticResource SparkOverlay}"
				IsVisible="{Binding IsBusy}">
				<VerticalStackLayout
					HorizontalOptions="Center"
					Spacing="12"
					VerticalOptions="Center">
					<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
					<Label
						FontSize="13"
						Text="Вчитување..."
						TextColor="{StaticResource SparkTextPrimary}" />
				</VerticalStackLayout>
			</Grid>

		</Grid>
	</Grid>
</ContentPage>
