<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Reports.ReportHistoryPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.ViewModels.Reports"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Reports"
	x:Name="PageRoot"
	x:DataType="viewModels:ReportHistoryViewModel">


	<Grid ColumnDefinitions="260,*">

		<!--  =========================================================  -->
		<!--  LEFT MENU  -->
		<!--  =========================================================  -->

		<Border Grid.Column="0" StrokeThickness="0">

			<ContentView x:Name="MenuHost" />

		</Border>

		<!--  =========================================================  -->
		<!--  MAIN CONTENT  -->
		<!--  =========================================================  -->

		<Grid
			Grid.Column="1"
			Padding="0"
			BackgroundColor="{StaticResource PageBackground}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="0">

			<!--  =====================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =====================================================  -->

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">

				<Grid ColumnDefinitions="*,Auto">

					<controls:FFPageHeader Title="Историја на извештаи" Subtitle="Преглед, пребарување и превземање на генерирани извештаи" />

					<HorizontalStackLayout
						Grid.Column="1"
						Margin="0,0,33,0"
						Spacing="10">

						<!--<Button
							Background="{StaticResource ExpandCardBackground}"
							Command="{Binding RefreshCommand}"
							HeightRequest="45"
							Style="{StaticResource TabButtonActiveStyle}"
							Text="Искисти"
							WidthRequest="130" />-->

						<Button
							BackgroundColor="{StaticResource SparkedDarkCard}"
							Command="{Binding NavigateToReportCommand}"
							HeightRequest="45"
							IsVisible="{Binding CanCreate}"
							Style="{StaticResource TabButtonActiveStyle}"
							Text="Нов извештај"
							TextColor="White"
							WidthRequest="160" />

					</HorizontalStackLayout>

				</Grid>

			</Border>

			<!--  =====================================================  -->
			<!--  SEARCH / FILTER / GRID  -->
			<!--  =====================================================  -->

			<Border
				Grid.Row="1"
				Padding="0"
				StrokeThickness="0">

				<Grid ColumnSpacing="0" RowSpacing="0">

					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">
						<!--  =====================================================  -->
						<!--  SEARCH / FILTER BAR  -->
						<!--  =====================================================  -->

						<controls:FFSectionCard>

							<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пребарување ..."
								SearchText="{Binding ReportSearchText}"
								Tabs="{Binding Tabs}" />

						</controls:FFSectionCard>

						<!--  =====================================================  -->
						<!--  REPORT GRID  -->
						<!--  =====================================================  -->

						<controls:FFSectionCard>

							<controls:SparkDataGridView
								x:Name="ReportHistoryGrid"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding OpenCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								TotalPages="{Binding TotalPages}" />


						</controls:FFSectionCard>

						<!--  Empty state  -->
						<Border
							Margin="0,16,0,0"
							Padding="24"
							BackgroundColor="White"
							IsVisible="{Binding IsEmpty}"
							Stroke="{StaticResource BorderColor}"
							StrokeShape="RoundRectangle 12"
							StrokeThickness="1">

							<VerticalStackLayout HorizontalOptions="Center" Spacing="12">

								<Label
									FontSize="42"
									HorizontalOptions="Center"
									Text="📄" />

								<Label
									HorizontalOptions="Center"
									Style="{StaticResource FormLabelStyle}"
									Text="Нема генерирани извештаи." />

								<Label
									HorizontalOptions="Center"
									HorizontalTextAlignment="Center"
									Style="{StaticResource FormLabelStyle}"
									Text="Генерирај извештај за да се појави во историјата." />

								<!--<Button
									Command="{Binding NavigateToGenerateReportCommand}"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="Нов извештај"
									WidthRequest="170" />-->

							</VerticalStackLayout>

						</Border>

					</VerticalStackLayout>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</ContentPage>
