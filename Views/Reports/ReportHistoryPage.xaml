<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Reports.ReportHistoryPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.ViewModels.Reports"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Reports"
	x:Name="PageRoot"
	x:DataType="viewModels:ReportHistoryViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<Style x:Key="ReportHistoryCardStyle" TargetType="Border">
				<Setter Property="BackgroundColor" Value="{StaticResource White}" />
				<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
				<Setter Property="Padding" Value="0" />
			</Style>
			<Style x:Key="ReportHistorySectionTitleStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="11" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>
			<Style x:Key="ReportHistorySectionAccentStyle" TargetType="BoxView">
				<Setter Property="WidthRequest" Value="4" />
				<Setter Property="HeightRequest" Value="16" />
				<Setter Property="CornerRadius" Value="2" />
				<Setter Property="Color" Value="{StaticResource SparkAccentTeal}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="260,*">

		<!--  =========================================================  -->
		<!--  LEFT MENU  -->
		<!--  =========================================================  -->

		<Border Grid.Column="0" StrokeThickness="0">

			<ContentView x:Name="MenuHost" />

		</Border>

		<!--  =========================================================  -->
		<!--  MAIN CONTENT  -->
		<!--  =========================================================  -->

		<Grid
			Grid.Column="1"
			Padding="0"
			BackgroundColor="{StaticResource PageBackground}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="0">

			<!--  =====================================================  -->
			<!--  PAGE HEADER  -->
			<!--  =====================================================  -->

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">

				<Grid ColumnDefinitions="*,Auto">

					<controls:FFPageHeader Title="Историја на извештаи" Subtitle="Преглед, пребарување и превземање на генерирани извештаи">
						<controls:FFPageHeader.HeaderContent>
							<HorizontalStackLayout Margin="1,0,1,0" Spacing="20">
								<controls:FFButton
									ButtonKind="Secondary"
									Command="{Binding GoBackCommand}"
									HeightRequestEx="40"
									Text="Назад"
									WidthRequestEx="130" />


								<controls:FFButton
									ButtonKind="Primary"
									Command="{Binding NavigateToReportCommand}"
									HeightRequestEx="40"
									IsVisible="{Binding CanCreate}"
									Text="Нов извештај"
									WidthRequestEx="130" />
							</HorizontalStackLayout>
						</controls:FFPageHeader.HeaderContent>
					</controls:FFPageHeader>

					<HorizontalStackLayout
						Grid.Column="1"
						Margin="0,0,33,0"
						Spacing="10">

						<!--<Button
							Background="{StaticResource ExpandCardBackground}"
							Command="{Binding RefreshCommand}"
							HeightRequest="45"
							Style="{StaticResource TabButtonActiveStyle}"
							Text="Искисти"
							WidthRequest="130" />-->


					</HorizontalStackLayout>

				</Grid>

			</Border>

			<!--  =====================================================  -->
			<!--  SEARCH / FILTER / GRID  -->
			<!--  =====================================================  -->

			<Border
				Grid.Row="1"
				Padding="0"
				StrokeThickness="0">

				<Grid ColumnSpacing="0" RowSpacing="0">

					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">
						<!--  =====================================================  -->
						<!--  SEARCH / FILTER BAR  -->
						<!--  =====================================================  -->

						<Border
							BackgroundColor="#F9FAFB"
							Style="{StaticResource ReportHistoryCardStyle}">
							<VerticalStackLayout Padding="8,4,8,4" Spacing="3">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<BoxView Style="{StaticResource ReportHistorySectionAccentStyle}" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReportHistorySectionTitleStyle}"
										Text="ПРЕБАРУВАЊЕ И ФИЛТРИ" />
								</Grid>
								<controls:SparkExplorerHeaderView
									Margin="0"
									Buttons="{Binding Buttons}"
									Pickers="{Binding Pickers}"
									SearchCommand="{Binding SearchCommand}"
									SearchPlaceholder="Пребарување ..."
									SearchText="{Binding ReportSearchText, Mode=TwoWay}"
									SearchVisible="True"
									SearchWidthRatio="0.36"
									ShowCyrillicToggle="False"
									Tabs="{Binding Tabs}" />
							</VerticalStackLayout>
						</Border>

						<!--  =====================================================  -->
						<!--  REPORT GRID  -->
						<!--  =====================================================  -->

						<Border Style="{StaticResource ReportHistoryCardStyle}">
							<VerticalStackLayout Spacing="0">
								<Grid Margin="14,12,14,8" ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<BoxView Style="{StaticResource ReportHistorySectionAccentStyle}" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReportHistorySectionTitleStyle}"
										Text="РЕЗУЛТАТИ" />
								</Grid>
								<controls:FFSectionCard Margin="0" ContentPadding="0">
									<controls:SparkDataGridView
										x:Name="ReportHistoryGrid"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										EditRowCommand="{Binding OpenCommand}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										RowTappedCommand="{Binding SelectCommand}"
										Rows="{Binding GridRows}"
										TotalPages="{Binding TotalPages}" />
								</controls:FFSectionCard>
							</VerticalStackLayout>
						</Border>

						<!--  Empty state  -->
						<Border
							Margin="0,16,0,0"
							Padding="24"
							BackgroundColor="White"
							IsVisible="{Binding IsEmpty}"
							Stroke="{StaticResource BorderColor}"
							StrokeShape="RoundRectangle 12"
							StrokeThickness="1">

							<VerticalStackLayout HorizontalOptions="Center" Spacing="12">

								<Label
									FontSize="42"
									HorizontalOptions="Center"
									Text="📄" />

								<Label
									HorizontalOptions="Center"
									Style="{StaticResource FormLabelStyle}"
									Text="Нема генерирани извештаи." />

								<Label
									HorizontalOptions="Center"
									HorizontalTextAlignment="Center"
									Style="{StaticResource FormLabelStyle}"
									Text="Генерирај извештај за да се појави во историјата." />

								<!--<Button
									Command="{Binding NavigateToGenerateReportCommand}"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="Нов извештај"
									WidthRequest="170" />-->

							</VerticalStackLayout>

						</Border>

					</VerticalStackLayout>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</ContentPage>
