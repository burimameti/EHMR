<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.ApplicationRegimeListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:ApplicationRegimeListViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="285,*">
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="16">
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader
					Title="Начини на апликација"
					Subtitle="Регистар на начини на апликација за лекови">
					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GoBackCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
							<Entry
								Placeholder="Внесете нов начин..."
								Text="{Binding NewRegime, Mode=TwoWay}"
								WidthRequest="240" />
							<controls:FFButton
								ButtonKind="Primary"
								Command="{Binding AddCommand}"
								IsEnabled="{Binding CanManage}"
								HeightRequestEx="40"
								Text="Нов начин"
								WidthRequestEx="130" />
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<Border
				Grid.Row="1"
				Padding="0"
				BackgroundColor="White"
				Stroke="{StaticResource SparkBorder}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<Grid RowDefinitions="42,*">
					<Grid BackgroundColor="#475569" ColumnDefinitions="90,*,120">
						<Label
							Padding="10,0"
							FontAttributes="Bold"
							FontSize="10"
							Text="ID"
							TextColor="White"
							VerticalTextAlignment="Center" />
						<Label
							Grid.Column="1"
							Padding="10,0"
							FontAttributes="Bold"
							FontSize="10"
							Text="НАЧИН НА АПЛИКАЦИЈА"
							TextColor="White"
							VerticalTextAlignment="Center" />
						<Label
							Grid.Column="2"
							Padding="10,0"
							FontAttributes="Bold"
							FontSize="10"
							Text="ОПЦИИ"
							TextColor="White"
							VerticalTextAlignment="Center" />
					</Grid>
					<CollectionView
						Grid.Row="1"
						ItemsSource="{Binding Regimes}"
						SelectionMode="None">
						<CollectionView.ItemTemplate>
							<DataTemplate>
								<Grid Padding="10,8" ColumnDefinitions="90,*,120">
									<Label
										FontSize="11"
										Text="{Binding Id}"
										TextColor="{StaticResource SparkTextMuted}" />
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding Regime}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<HorizontalStackLayout Grid.Column="2" Spacing="6">
										<controls:FFButton
											ContentPadding="10,0"
											BackgroundColorEx="{StaticResource SparkButtonSecondaryBg}"
											Command="{Binding Source={x:Reference Name=PageRoot}, Path=BindingContext.EditCommand}"
											CommandParameter="{Binding .}"
											CornerRadius="6"
											FontSizeEx="11"
											IsEnabled="{Binding Source={x:Reference Name=PageRoot}, Path=BindingContext.CanManage}"
											Text="Промени"
											TextColorEx="White" />
										<controls:FFButton
											ContentPadding="10,0"
											BackgroundColorEx="#DC2626"
											Command="{Binding Source={x:Reference Name=PageRoot}, Path=BindingContext.DeleteCommand}"
											CommandParameter="{Binding .}"
											CornerRadius="6"
											FontSizeEx="11"
											IsEnabled="{Binding Source={x:Reference Name=PageRoot}, Path=BindingContext.CanManage}"
											Text="Избриши"
											TextColorEx="White" />
									</HorizontalStackLayout>
								</Grid>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Grid>
			</Border>

			<Grid
				Grid.Column="1"
				BackgroundColor="{StaticResource SparkOverlay}"
				IsVisible="{Binding IsBusy}">
				<ActivityIndicator
					HorizontalOptions="Center"
					IsRunning="{Binding IsBusy}"
					VerticalOptions="Center" />
			</Grid>
		</Grid>
	</Grid>
</ContentPage>