<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="PageRoot"
    x:Class="EHMR.Views.ApplicationRegimeListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    x:DataType="viewModels:ApplicationRegimeListViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="285,*">
        <Border Grid.Column="0" StrokeThickness="0">
            <ContentView x:Name="MenuHost" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="16">
            <Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <VerticalStackLayout>
                        <Label Text="Режими на апликација" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource SparkTextPrimary}" />
                        <Label Text="Регистар на режими за примена на лекови" FontSize="12" TextColor="{StaticResource SparkTextSecondary}" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Entry WidthRequest="240" Placeholder="Внесете нов режим..." Text="{Binding NewRegime, Mode=TwoWay}" />
                        <Button Text="Нов режим" Command="{Binding AddCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="0" BackgroundColor="White" Stroke="{StaticResource SparkBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <Grid RowDefinitions="42,*">
                    <Grid ColumnDefinitions="90,*,120" BackgroundColor="#475569">
                        <Label Padding="10,0" Text="РЕЖИМ ID" FontAttributes="Bold" FontSize="10" TextColor="White" VerticalTextAlignment="Center" />
                        <Label Grid.Column="1" Padding="10,0" Text="РЕЖИМ" FontAttributes="Bold" FontSize="10" TextColor="White" VerticalTextAlignment="Center" />
                        <Label Grid.Column="2" Padding="10,0" Text="ОПЦИИ" FontAttributes="Bold" FontSize="10" TextColor="White" VerticalTextAlignment="Center" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Regimes}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="90,*,120" Padding="10,8">
                                    <Label Text="{Binding Id}" FontSize="11" TextColor="{StaticResource SparkTextMuted}" />
                                    <Label Grid.Column="1" Text="{Binding Regime}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource SparkTextPrimary}" />
                                    <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                        <Button Padding="10,0" BackgroundColor="{StaticResource SparkButtonSecondaryBg}" Command="{Binding Source={x:Reference Name=PageRoot}, Path=BindingContext.EditCommand}" CommandParameter="{Binding .}" CornerRadius="6" FontSize="11" Text="Промени" TextColor="White" />
                                        <Button Padding="10,0" BackgroundColor="#DC2626" Command="{Binding Source={x:Reference Name=PageRoot}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" CornerRadius="6" FontSize="11" Text="Избриши" TextColor="White" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" BackgroundColor="{StaticResource SparkOverlay}" IsVisible="{Binding IsBusy}">
                <ActivityIndicator IsRunning="{Binding IsBusy}" VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>