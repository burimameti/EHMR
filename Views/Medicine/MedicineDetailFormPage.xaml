<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.MedicineDetailFormPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:models="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:DataType="viewModels:MedicineDetailFormViewModel">

	<Grid ColumnDefinitions="260,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Padding="0"
			
			BackgroundColor="{StaticResource PageBackground}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="16">

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Grid.Row="0" Title="{Binding HeaderTitle}" Subtitle="{Binding HeaderSubtitle}">
	<controls:FFPageHeader.HeaderContent>
					<controls:FFButton
                            ButtonKind="Secondary"
                            Command="{Binding CancelCommand}"
                            HeightRequestEx="40"
                            Text="Назад"
                            WidthRequestEx="130" />
		<HorizontalStackLayout Spacing="10">
			<controls:FFButton BackgroundColorEx="{StaticResource SidebarActiveBg}" Command="{Binding SaveCommand}" HeightRequestEx="40" IsEnabled="{Binding CanEditForm}" IsVisible="{Binding IsEditMode}" Text="Зачувај" TextColorEx="White" />
			<controls:FFButton ButtonKind="Secondary" Command="{Binding CancelCommand}" HeightRequestEx="40" IsVisible="{Binding IsEditMode}" Text="Откажи" />
			<controls:FFButton BackgroundColorEx="{StaticResource SidebarActiveBg}" Command="{Binding ToggleEditCommand}" HeightRequestEx="40" IsEnabled="{Binding CanUpdate}" IsVisible="{Binding IsReadOnly}" Text="Уреди" TextColorEx="White" />
		</HorizontalStackLayout>
	</controls:FFPageHeader.HeaderContent>
</controls:FFPageHeader>
			</Border>

			<Border
				Grid.Row="1"
				Padding="0"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeThickness="0">

				<VerticalStackLayout Spacing="0">

					<Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">

						<Grid
							Grid.Column="0"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab1Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="1" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf484;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Основни податоци"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

						<Grid
							Grid.Column="1"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab2Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="2" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf0f1;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Фармацевтски референци"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

						<Grid
							Grid.Column="2"
							Padding="16,14,16,12"
							BackgroundColor="{Binding IsTab3Active, Converter={StaticResource BoolToActiveBackgroundConverter}}">

							<Grid.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="3" />
							</Grid.GestureRecognizers>

							<HorizontalStackLayout
								HorizontalOptions="Center"
								Spacing="8"
								VerticalOptions="Center">
								<Label
									FontFamily="FASolid"
									FontSize="14"
									Text="&#xf05a;"
									TextColor="White"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="13"
									Text="Системски референци"
									TextColor="White" />
							</HorizontalStackLayout>

						</Grid>

					</Grid>

					<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

				</VerticalStackLayout>

			</Border>

			<controls:FFSectionCard
				Grid.Row="2" Margin="0" ContentPadding="18">

				<ScrollView>
					<VerticalStackLayout Padding="32" Spacing="24">

						<VerticalStackLayout IsVisible="{Binding IsTab1Active}" Spacing="20">

							<controls:CrudSectionHeader Title="ИНФОРМАЦИИ ЗА ЛЕКОТ" />

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="22">

								<Grid
									ColumnDefinitions="140,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Име на лек *"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<controls:FFInput Grid.Column="1" IsReadOnly="{Binding IsReadOnly}" IsEnabled="{Binding CanEditForm}" Placeholder="Пр. Paracetamol" Text="{Binding Medicine.Name}" />
								</Grid>

								<Grid
									Grid.Column="1"
									ColumnDefinitions="140,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Генеричко име"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<controls:FFInput Grid.Column="1" IsReadOnly="{Binding IsReadOnly}" Placeholder="Пр. Acetaminophen" Text="{Binding Medicine.GenericName}" />
								</Grid>

							</Grid>

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="22">

								<Grid
									ColumnDefinitions="140,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Фармацевтска форма"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<controls:FFInput Grid.Column="1" IsReadOnly="{Binding IsReadOnly}" Placeholder="Таблети, Сируп..." Text="{Binding Medicine.DosageForm}" />
								</Grid>

								<Grid
									Grid.Column="1"
									ColumnDefinitions="140,*"
									ColumnSpacing="16"
									VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Стандардна доза"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<controls:FFInput Grid.Column="1" IsReadOnly="{Binding IsReadOnly}" Placeholder="Пр. 500 mg" Text="{Binding Medicine.DefaultDosage}" />
								</Grid>

							</Grid>

						</VerticalStackLayout>

						<VerticalStackLayout IsVisible="{Binding IsTab2Active}" Spacing="20">

							<controls:CrudSectionHeader Title="ДОПОЛНИТЕЛНИ ИНФОРМАЦИИ ЗА АПЛИКАЦИЈА" />

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkBorder}" />

							<Border
								Padding="18"
								BackgroundColor="{StaticResource SparkAccentTealBg}"
								StrokeShape="RoundRectangle 6"
								StrokeThickness="0">

								<HorizontalStackLayout Spacing="12">
									<Label
										FontFamily="FASolid"
										FontSize="18"
										Text="&#xf05a;"
										TextColor="{StaticResource SparkTextPrimary}" />
									<VerticalStackLayout Spacing="3">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Информација"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="13"
											Text="Основните информации за лекот се користат при креирање терапии, рецепти и медицински евиденции."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
								</HorizontalStackLayout>

							</Border>

						</VerticalStackLayout>

						<VerticalStackLayout IsVisible="{Binding IsTab3Active}" Spacing="20">

							<controls:CrudSectionHeader Title="СИСТЕМСКИ ИНФОРМАЦИИ" />

							<BoxView
								Margin="0,10"
								HeightRequest="1"
								Color="{StaticResource SparkAccentTealDark}" />

							<Grid
								ColumnDefinitions="160,*"
								ColumnSpacing="12"
								RowDefinitions="Auto,Auto"
								RowSpacing="16">

								<Label
									Grid.Row="0"
									Grid.Column="0"
									FontAttributes="Bold"
									FontSize="13"
									Text="Идентификатор (ID)"
									TextColor="{StaticResource SparkTextSecondary}" />

								<Label
									Grid.Row="0"
									Grid.Column="1"
									FontSize="13"
									Text="{Binding Medicine.Id}"
									TextColor="{StaticResource SparkTextPrimary}" />

								<Label
									Grid.Row="1"
									Grid.Column="0"
									FontAttributes="Bold"
									FontSize="13"
									Text="Тековен режим"
									TextColor="{StaticResource SparkTextSecondary}" />

								<Label
									Grid.Row="1"
									Grid.Column="1"
									FontSize="13"
									Text="{Binding PageTitle}"
									TextColor="{StaticResource SparkTextPrimary}" />

							</Grid>

						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>

			</controls:FFSectionCard>

		</Grid>
	</Grid>
</ContentPage>