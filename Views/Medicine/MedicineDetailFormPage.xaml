<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.MedicineDetailFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EHMR.Resources.Controls"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    BackgroundColor="{StaticResource PageBackground}"
    x:DataType="viewModels:MedicineDetailFormViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="FieldEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
                <Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
            </Style>

            <Style x:Key="ReadHintStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
            </Style>

            <Style x:Key="ReadValueBoldStyle" TargetType="Label">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="260,*">

        <!-- LEFT MENU -->
        <Border Grid.Column="0" StrokeThickness="0">
            <ContentView x:Name="MenuHost" />
        </Border>

        <!-- MAIN CONTENT -->
        <Grid
            Grid.Column="1"
            Margin="0"
            RowDefinitions="Auto,*,Auto"
            RowSpacing="0">

            <!-- HEADER — same visual language as New Patient -->
            <Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
                <controls:FFPageHeader
                    Title="{Binding HeaderTitle}"
                    Subtitle="{Binding HeaderSubtitle}">
                    <controls:FFPageHeader.HeaderContent>
                        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">

                            <controls:FFButton
                                ButtonKind="Secondary"
                                Command="{Binding CancelCommand}"
                                HeightRequestEx="40"
                                Text="Назад"
                                WidthRequestEx="130" />

                            <controls:FFButton
                                BackgroundColorEx="{StaticResource SidebarActiveBg}"
                                Command="{Binding SaveCommand}"
                                HeightRequestEx="40"
                                IsEnabled="{Binding CanEditForm}"
                                IsVisible="{Binding IsEditMode}"
                                Text="Зачувај"
                                TextColorEx="White" />

                            <controls:FFButton
                                ButtonKind="Secondary"
                                Command="{Binding CancelCommand}"
                                HeightRequestEx="40"
                                IsVisible="{Binding IsEditMode}"
                                Text="Откажи" />

                            <controls:FFButton
                                BackgroundColorEx="{StaticResource SidebarActiveBg}"
                                Command="{Binding ToggleEditCommand}"
                                HeightRequestEx="40"
                                IsEnabled="{Binding CanUpdate}"
                                IsVisible="{Binding IsReadOnly}"
                                Text="Уреди"
                                TextColorEx="White" />

                        </HorizontalStackLayout>
                    </controls:FFPageHeader.HeaderContent>
                </controls:FFPageHeader>
            </Border>

            <!-- FORM -->
            <Grid
                Grid.Row="1"
                Margin="0"
                Padding="0"
                Style="{StaticResource CrudFormBodyGridStyle}">

                <controls:CustomScrollView
                    Margin="0"
                    Padding="0"
                    ScrollBarColor="{StaticResource SparkAccentTeal}">

                    <VerticalStackLayout Spacing="0">

                        <controls:FFSectionCard
                            Margin="0"
                            Style="{StaticResource CrudFormCardStyle}">

                            <VerticalStackLayout
                                Spacing="16"
                                Style="{StaticResource CrudFormContentStackStyle}">

                                <!-- BASIC DATA -->
                                <VerticalStackLayout Spacing="10">

                                    <controls:CrudSectionHeader
                                        Title="ОСНОВНИ ПОДАТОЦИ"
                                        LineColor="{StaticResource SparkAccentTeal}"
                                        Style="{StaticResource SectionHeaderStyle}" />

                                    <Grid
                                        ColumnDefinitions="1.3*,1.3*,1*,1*"
                                        ColumnSpacing="12">

                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Име на лек *" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="Пр. Paracetamol" Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.Name}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Име:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.Name}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Генеричко име" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="Пр. Acetaminophen" Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.GenericName}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Генеричко име:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.GenericName}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Шифра" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="ATC / интерна шифра" Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.Code}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Шифра:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.Code}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="3" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Производител" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="Производител" Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.Manufacturer}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Производител:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.Manufacturer}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                    </Grid>
                                </VerticalStackLayout>

                                <!-- APPLICATION INFORMATION -->
                                <VerticalStackLayout Spacing="10">

                                    <controls:CrudSectionHeader
                                        Title="ДОПОЛНИТЕЛНИ ИНФОРМАЦИИ"
                                        LineColor="{StaticResource SparkAccentTeal}"
                                        Style="{StaticResource SectionHeaderStyle}" />

                                    <Grid
                                        ColumnDefinitions="1.3*,1.3*,1*,1*"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto">

                                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Фармацевтска форма *" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="Таблети, Сируп, Инјекција..." Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.DosageForm}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Фармацевтска форма:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.DosageForm}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Јачина" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Keyboard="Numeric" Placeholder="Пр. 500" Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.Strength}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Јачина:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.Strength}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Единица" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="mg, ml, mcg, IU..." Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.Unit}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Единица:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.Unit}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="3" Spacing="4">
                                            <Label IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldLabelStyle}" Text="Стандардна доза" />
                                            <Border IsVisible="{Binding IsEditMode}" Style="{StaticResource EditFieldBoxStyle}">
                                                <Entry Placeholder="Пр. 500 mg еднаш дневно" Style="{StaticResource FieldEntryStyle}" Text="{Binding Medicine.DefaultDosage}" />
                                            </Border>
                                            <VerticalStackLayout IsVisible="{Binding IsReadOnly}" Spacing="2">
                                                <Label Style="{StaticResource ReadHintStyle}" Text="Стандардна доза:" />
                                                <Label Style="{StaticResource ReadValueBoldStyle}" Text="{Binding Medicine.DefaultDosage}" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>

                                    </Grid>

                                    <Border
                                        Padding="14"
                                        BackgroundColor="{StaticResource SparkAccentTealBg}"
                                        StrokeShape="RoundRectangle 6"
                                        StrokeThickness="0">
                                        <HorizontalStackLayout Spacing="10">
                                            <Label
                                                FontFamily="FASolid"
                                                FontSize="17"
                                                Text="&#xf05a;"
                                                TextColor="{StaticResource SparkAccentTealDark}"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="12"
                                                Text="Стандардната доза е само почетна референца. Реалната доза за пациент се дефинира во терапијата."
                                                TextColor="{StaticResource SparkTextSecondary}"
                                                VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>

                                </VerticalStackLayout>

                                <!-- SYSTEM INFORMATION -->
                                <VerticalStackLayout Spacing="10">

                                    <controls:CrudSectionHeader
                                        Title="СИСТЕМСКИ ИНФОРМАЦИИ"
                                        LineColor="{StaticResource SparkAccentTeal}"
                                        Style="{StaticResource SectionHeaderStyle}" />

                                    <Grid
                                        ColumnDefinitions="160,*"
                                        ColumnSpacing="12"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="10">

                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Style="{StaticResource ReadHintStyle}"
                                            Text="Идентификатор (ID)" />
                                        <Label
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource ReadValueBoldStyle}"
                                            Text="{Binding Medicine.Id}" />

                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Style="{StaticResource ReadHintStyle}"
                                            Text="Статус" />
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="{Binding Medicine.IsActive, StringFormat='Активен: {0}'}"
                                            TextColor="{StaticResource SparkAccentTealDark}" />

                                    </Grid>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </controls:FFSectionCard>

                    </VerticalStackLayout>
                </controls:CustomScrollView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
