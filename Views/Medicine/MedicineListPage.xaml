<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.MedicineListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:MedicineListViewModel"
	BackgroundColor="{StaticResource PageBackground}">
	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Регистар на лекови"
						Grid.Column="0"
						Subtitle="Регистар на лекови во клиниката со нивните стандардни дози">
						<controls:FFPageHeader.HeaderContent>
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GoBackCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
						</controls:FFPageHeader.HeaderContent>
					</controls:FFPageHeader>
				</Grid>
			</Border>

			<!--  MAIN CONTENT  -->
			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource PageBackground}"
				StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Spacing="12" Style="{StaticResource ListPageContentStackStyle}">

						<!--  TIMELINE TABS  -->
						<controls:FFSectionCard>
							<Grid Padding="0,8" ColumnDefinitions="*,*,*">

								<!--  Step 1: Лекови  -->
								<Grid
									Grid.Column="0"
									RowDefinitions="Auto,Auto"
									RowSpacing="6">
									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowMedicinesTabCommand}" />
									</Grid.GestureRecognizers>
									<Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
										<BoxView
											Grid.Column="0"
											HeightRequest="2"
											IsVisible="False"
											VerticalOptions="Center"
											Color="{StaticResource SparkBorder}" />
										<Border
											Grid.Column="1"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="32"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 16"
											StrokeThickness="2"
											WidthRequest="32">
											<Label
												FontAttributes="Bold"
												FontSize="14"
												HorizontalOptions="Center"
												Text="1"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Border.Triggers>
												<DataTrigger
													Binding="{Binding IsMedicinesTabActive}"
													TargetType="Border"
													Value="True">
													<Setter Property="BackgroundColor" Value="{StaticResource SidebarActiveBg}" />
													<Setter Property="Stroke" Value="{StaticResource SidebarActiveBg}" />
												</DataTrigger>
											</Border.Triggers>
										</Border>
										<BoxView
											Grid.Column="2"
											HeightRequest="2"
											VerticalOptions="Center"
											Color="{StaticResource SparkBorder}" />
									</Grid>
									<Label
										Grid.Row="1"
										FontSize="13"
										HorizontalOptions="Center"
										Text="Лекови"
										TextColor="{StaticResource SparkTextSecondary}">
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsMedicinesTabActive}"
												TargetType="Label"
												Value="True">
												<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
												<Setter Property="FontAttributes" Value="Bold" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Grid>

								<!--  Step 2: Режими на апликација  -->
								<Grid
									Grid.Column="1"
									RowDefinitions="Auto,Auto"
									RowSpacing="6">
									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowRegimesTabCommand}" />
									</Grid.GestureRecognizers>
									<Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
										<BoxView
											Grid.Column="0"
											HeightRequest="2"
											VerticalOptions="Center"
											Color="{StaticResource SparkBorder}" />
										<Border
											Grid.Column="1"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="32"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 16"
											StrokeThickness="2"
											WidthRequest="32">
											<Label
												FontAttributes="Bold"
												FontSize="14"
												HorizontalOptions="Center"
												Text="2"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Border.Triggers>
												<DataTrigger
													Binding="{Binding IsRegimesTabActive}"
													TargetType="Border"
													Value="True">
													<Setter Property="BackgroundColor" Value="{StaticResource SidebarActiveBg}" />
													<Setter Property="Stroke" Value="{StaticResource SidebarActiveBg}" />
												</DataTrigger>
											</Border.Triggers>
										</Border>
										<BoxView
											Grid.Column="2"
											HeightRequest="2"
											VerticalOptions="Center"
											Color="{StaticResource SparkBorder}" />
									</Grid>
									<Label
										Grid.Row="1"
										FontSize="13"
										HorizontalOptions="Center"
										Text="Режими на апликација"
										TextColor="{StaticResource SparkTextSecondary}">
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsRegimesTabActive}"
												TargetType="Label"
												Value="True">
												<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
												<Setter Property="FontAttributes" Value="Bold" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Grid>

								<!--  Step 3: Скорови  -->
								<Grid
									Grid.Column="2"
									RowDefinitions="Auto,Auto"
									RowSpacing="6">
									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding ShowScoresTabCommand}" />
									</Grid.GestureRecognizers>
									<Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
										<BoxView
											Grid.Column="0"
											HeightRequest="2"
											VerticalOptions="Center"
											Color="{StaticResource SparkBorder}" />
										<Border
											Grid.Column="1"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="32"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 16"
											StrokeThickness="2"
											WidthRequest="32">
											<Label
												FontAttributes="Bold"
												FontSize="14"
												HorizontalOptions="Center"
												Text="3"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Border.Triggers>
												<DataTrigger
													Binding="{Binding IsScoresTabActive}"
													TargetType="Border"
													Value="True">
													<Setter Property="BackgroundColor" Value="{StaticResource SidebarActiveBg}" />
													<Setter Property="Stroke" Value="{StaticResource SidebarActiveBg}" />
												</DataTrigger>
											</Border.Triggers>
										</Border>
										<BoxView
											Grid.Column="2"
											HeightRequest="2"
											IsVisible="False"
											VerticalOptions="Center"
											Color="{StaticResource SparkBorder}" />
									</Grid>
									<Label
										Grid.Row="1"
										FontSize="13"
										HorizontalOptions="Center"
										Text="Скорови"
										TextColor="{StaticResource SparkTextSecondary}">
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsScoresTabActive}"
												TargetType="Label"
												Value="True">
												<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
												<Setter Property="FontAttributes" Value="Bold" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Grid>

							</Grid>
						</controls:FFSectionCard>

						<!--  SECTION 1: Medicines  -->
						<controls:FFSectionCard IsVisible="{Binding IsMedicinesTabActive}">
							<VerticalStackLayout Spacing="14">
								<Grid Padding="4,0,4,10" ColumnDefinitions="*,Auto">
									<VerticalStackLayout Spacing="3">
										<Label
											FontAttributes="Bold"
											FontSize="16"
											Text="Лекови"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="12"
											Text="Регистар на лекови и нивните стандардни дози."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="1"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding NewMedicineCommand}"
										ContentPadding="18,0"
										HeightRequestEx="40"
										Text="Нов лек"
										TextColorEx="White" />
								</Grid>
								<controls:SparkExplorerHeaderView
									Buttons="{Binding Buttons}"
									Pickers="{Binding Pickers}"
									SearchCommand="{Binding SearchCommand}"
									SearchPlaceholder="Пребарување по назив, генеричко име или форма..."
									SearchText="{Binding SearchText}"
									Tabs="{Binding Tabs}" />
								<controls:SparkDataGridView
									x:Name="MedicineGrid"
									Columns="{Binding GridColumns}"
									CurrentPage="{Binding CurrentPage}"
									EditRowCommand="{Binding EditCommand}"
									NextPageCommand="{Binding NextPageCommand}"
									PageChangedCommand="{Binding PageChangedCommand}"
									PreviousPageCommand="{Binding PreviousPageCommand}"
									RowTappedCommand="{Binding SelectCommand}"
									Rows="{Binding GridRows}"
									ShowPagination="True"
									ShowRowNumbers="True"
									TotalPages="{Binding TotalPages}" />
							</VerticalStackLayout>
						</controls:FFSectionCard>

						<!--  SECTION 2: Application regimes  -->
						<controls:FFSectionCard IsVisible="{Binding IsRegimesTabActive}">
							<VerticalStackLayout Spacing="14">
								<Grid Padding="4,0,4,10" ColumnDefinitions="*,Auto">
									<VerticalStackLayout Spacing="3">
										<Label
											FontAttributes="Bold"
											FontSize="16"
											Text="Режим на апликација"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="12"
											Text="Регистар на режими на апликација што се користат кај терапијата."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="1"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding AddApplicationRegimeCommand}"
										ContentPadding="18,0"
										HeightRequestEx="40"
										Text="Додади начин"
										TextColorEx="White" />
								</Grid>
								<Border
									Padding="8,0"
									BackgroundColor="{StaticResource SparkBackground}"
									HeightRequest="40"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 7"
									StrokeThickness="1">
									<Entry
										BackgroundColor="Transparent"
										Placeholder="Пребарување по режим на апликација..."
										PlaceholderColor="{StaticResource SparkTextSecondary}"
										Text="{Binding RegimeSearchText}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</Border>
								<controls:SparkDataGridView
									Columns="{Binding ApplicationRegimeColumns}"
									Rows="{Binding ApplicationRegimeRows}"
									ShowPagination="False"
									ShowRowNumbers="True" />
							</VerticalStackLayout>
						</controls:FFSectionCard>

						<!--  SECTION 3: Clinical scores  -->
						<controls:FFSectionCard IsVisible="{Binding IsScoresTabActive}">
							<VerticalStackLayout Spacing="14">
								<Grid Padding="4,0,4,10" ColumnDefinitions="*,Auto">
									<VerticalStackLayout Spacing="3">
										<Label
											FontAttributes="Bold"
											FontSize="16"
											Text="Клинички скорови"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="12"
											Text="Регистар на клинички скорови достапни во картонот на пациентот."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="1"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding AddClinicalScoreCommand}"
										ContentPadding="18,0"
										HeightRequestEx="40"
										Text="Нов скор"
										TextColorEx="White" />
								</Grid>
								<Border
									Padding="8,0"
									BackgroundColor="{StaticResource SparkBackground}"
									HeightRequest="40"
									Stroke="{StaticResource SparkBorder}"
									StrokeShape="RoundRectangle 7"
									StrokeThickness="1">
									<Entry
										BackgroundColor="Transparent"
										Placeholder="Пребарување по назив или опис на скор..."
										PlaceholderColor="{StaticResource SparkTextSecondary}"
										Text="{Binding ScoreSearchText}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</Border>
								<controls:SparkDataGridView
									Columns="{Binding ScoreColumns}"
									Rows="{Binding ScoreRows}"
									ShowPagination="False"
									ShowRowNumbers="True" />
							</VerticalStackLayout>
						</controls:FFSectionCard>

					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>