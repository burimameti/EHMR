<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.MedicineListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:MedicineListViewModel"
	BackgroundColor="{StaticResource PageBackground}">
<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Регистар на лекови"
						Grid.Column="0"
						Subtitle="Регистар на лекови во клиниката со нивните стандардни дози" >
				<controls:FFPageHeader.HeaderContent>
<controls:FFButton
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						HeightRequestEx="40"
						Text="Назад"
						WidthRequestEx="130" />
			</controls:FFPageHeader.HeaderContent>
		</controls:FFPageHeader>
				</Grid>
			</Border>

			<!--  MAIN CONTENT / GRID  -->
			<Border Grid.Row="1" BackgroundColor="{StaticResource PageBackground}" StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}" Spacing="12">
                        <!-- Three catalog tabs -->
                        <controls:FFSectionCard>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <controls:FFButton
                                    ButtonKind="{Binding IsMedicinesTabActive, Converter={StaticResource BooleanToButtonKindConverter}}"
                                    Command="{Binding ShowMedicinesTabCommand}"
                                    HeightRequestEx="40"
                                    Text="Лекови" />
                                <controls:FFButton
                                    Grid.Column="1"
                                    ButtonKind="Secondary"
                                    Command="{Binding ShowRegimesTabCommand}"
                                    HeightRequestEx="40"
                                    Text="Режими на апликација" />
                                <controls:FFButton
                                    Grid.Column="2"
                                    ButtonKind="Secondary"
                                    Command="{Binding ShowScoresTabCommand}"
                                    HeightRequestEx="40"
                                    Text="Скорови" />
                            </Grid>
                        </controls:FFSectionCard>

                        <!-- Medicines grid -->
                        <controls:FFSectionCard IsVisible="{Binding IsMedicinesTabActive}">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" Padding="4,0,4,10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontAttributes="Bold" FontSize="16" Text="Лекови" TextColor="{StaticResource SparkTextPrimary}" />
                                        <Label FontSize="12" Text="Регистар на лекови и нивните стандардни дози." TextColor="{StaticResource SparkTextSecondary}" />
                                    </VerticalStackLayout>
                                    <controls:FFButton Grid.Column="1" ButtonKind="Primary" BackgroundColorEx="{StaticResource SidebarActiveBg}" TextColorEx="White" Command="{Binding NewMedicineCommand}" ContentPadding="18,0" HeightRequestEx="40" Text="Нов лек" />
                                </Grid>
                                <controls:SparkExplorerHeaderView
                                    Buttons="{Binding Buttons}"
                                    Pickers="{Binding Pickers}"
                                    SearchCommand="{Binding SearchCommand}"
                                    SearchPlaceholder="Пребарување по назив, генеричко име или форма..."
                                    SearchText="{Binding SearchText}"
                                    Tabs="{Binding Tabs}" />
                                <controls:SparkDataGridView
                                    x:Name="MedicineGrid"
                                    Columns="{Binding GridColumns}"
                                    CurrentPage="{Binding CurrentPage}"
                                    EditRowCommand="{Binding EditCommand}"
                                    NextPageCommand="{Binding NextPageCommand}"
                                    PageChangedCommand="{Binding PageChangedCommand}"
                                    PreviousPageCommand="{Binding PreviousPageCommand}"
                                    RowTappedCommand="{Binding SelectCommand}"
                                    Rows="{Binding GridRows}"
                                    ShowPagination="True"
                                    ShowRowNumbers="True"
                                    TotalPages="{Binding TotalPages}" />
                            </VerticalStackLayout>
                        </controls:FFSectionCard>

                        <!-- Application regimes grid -->
                        <controls:FFSectionCard IsVisible="{Binding IsRegimesTabActive}">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" Padding="4,0,4,10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontAttributes="Bold" FontSize="16" Text="Режим на апликација" TextColor="{StaticResource SparkTextPrimary}" />
                                        <Label FontSize="12" Text="Регистар на режими на апликација што се користат кај терапијата." TextColor="{StaticResource SparkTextSecondary}" />
                                    </VerticalStackLayout>
                                    <controls:FFButton Grid.Column="1" ButtonKind="Primary" BackgroundColorEx="{StaticResource SidebarActiveBg}" TextColorEx="White" Command="{Binding AddApplicationRegimeCommand}" Text="Додади начин" HeightRequestEx="40" ContentPadding="18,0" />
                                </Grid>
                                <Border Padding="8,0" BackgroundColor="{StaticResource SparkBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 7" StrokeThickness="1" HeightRequest="40">
                                    <Entry Placeholder="Пребарување по режим на апликација..." Text="{Binding RegimeSearchText}" TextColor="{StaticResource SparkTextPrimary}" PlaceholderColor="{StaticResource SparkTextSecondary}" BackgroundColor="Transparent" VerticalOptions="Center" />
                                </Border>
                                <controls:SparkDataGridView Columns="{Binding ApplicationRegimeColumns}" Rows="{Binding ApplicationRegimeRows}" ShowPagination="False" ShowRowNumbers="True" />
                            </VerticalStackLayout>
                        </controls:FFSectionCard>

                        <!-- Clinical score definitions grid -->
                        <controls:FFSectionCard IsVisible="{Binding IsScoresTabActive}">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*,Auto" Padding="4,0,4,10">
                                    <VerticalStackLayout Spacing="3">
                                        <Label FontAttributes="Bold" FontSize="16" Text="Клинички скорови" TextColor="{StaticResource SparkTextPrimary}" />
                                        <Label FontSize="12" Text="Регистар на клинички скорови достапни во картонот на пациентот." TextColor="{StaticResource SparkTextSecondary}" />
                                    </VerticalStackLayout>
                                    <controls:FFButton Grid.Column="1" ButtonKind="Primary" BackgroundColorEx="{StaticResource SidebarActiveBg}" TextColorEx="White" Command="{Binding AddClinicalScoreCommand}" Text="Нов скор" HeightRequestEx="40" ContentPadding="18,0" />
                                </Grid>
                                <Border Padding="8,0" BackgroundColor="{StaticResource SparkBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 7" StrokeThickness="1" HeightRequest="40">
                                    <Entry Placeholder="Пребарување по назив или опис на скор..." Text="{Binding ScoreSearchText}" TextColor="{StaticResource SparkTextPrimary}" PlaceholderColor="{StaticResource SparkTextSecondary}" BackgroundColor="Transparent" VerticalOptions="Center" />
                                </Border>
                                <controls:SparkDataGridView Columns="{Binding ScoreColumns}" Rows="{Binding ScoreRows}" ShowPagination="False" ShowRowNumbers="True" />
                            </VerticalStackLayout>
                        </controls:FFSectionCard>
                    </VerticalStackLayout>				</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>