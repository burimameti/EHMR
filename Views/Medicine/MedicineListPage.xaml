<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.MedicineListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="viewModels:MedicineListViewModel"
	BackgroundColor="{StaticResource PageBackground}">
<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Регистар на лекови"
						Grid.Column="0"
						Subtitle="Регистар на лекови во клиниката со нивните стандардни дози" >
				<controls:FFPageHeader.HeaderContent>
<controls:FFButton
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						HeightRequestEx="40"
						Text="Назад"
						WidthRequestEx="130" />
			</controls:FFPageHeader.HeaderContent>
		</controls:FFPageHeader>
				</Grid>
			</Border>

			<!--  MAIN CONTENT / TIMELINE TABS  -->
			<Border Grid.Row="1" BackgroundColor="{StaticResource PageBackground}" StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}" Spacing="14">
						<!-- Catalog timeline tabs -->
						<controls:FFSectionCard>
							<HorizontalStackLayout Padding="4,0" Spacing="8">
								<controls:FFButton Text="Лекови" Command="{Binding SelectCatalogTabCommand}" CommandParameter="1" ButtonKind="Secondary" HeightRequestEx="40" ContentPadding="20,0">
									<controls:FFButton.Triggers>
										<DataTrigger TargetType="controls:FFButton" Binding="{Binding IsMedicineTabActive}" Value="True"><Setter Property="ButtonKind" Value="Primary" /></DataTrigger>
									</controls:FFButton.Triggers>
								</controls:FFButton>
								<controls:FFButton Text="Начини на апликација" Command="{Binding SelectCatalogTabCommand}" CommandParameter="2" ButtonKind="Secondary" HeightRequestEx="40" ContentPadding="20,0">
									<controls:FFButton.Triggers>
										<DataTrigger TargetType="controls:FFButton" Binding="{Binding IsApplicationRegimeTabActive}" Value="True"><Setter Property="ButtonKind" Value="Primary" /></DataTrigger>
									</controls:FFButton.Triggers>
								</controls:FFButton>
								<controls:FFButton Text="Скорови" Command="{Binding SelectCatalogTabCommand}" CommandParameter="3" ButtonKind="Secondary" HeightRequestEx="40" ContentPadding="20,0">
									<controls:FFButton.Triggers>
										<DataTrigger TargetType="controls:FFButton" Binding="{Binding IsScoreTabActive}" Value="True"><Setter Property="ButtonKind" Value="Primary" /></DataTrigger>
									</controls:FFButton.Triggers>
								</controls:FFButton>
							</HorizontalStackLayout>
						</controls:FFSectionCard>

						<!-- Medicines tab -->
						<controls:FFSectionCard IsVisible="{Binding IsMedicineTabActive}">
							<Grid ColumnDefinitions="*,Auto" Padding="4,0,4,10">
								<VerticalStackLayout Spacing="3">
									<Label FontAttributes="Bold" FontSize="16" Text="Лекови" TextColor="{StaticResource SparkTextPrimary}" />
									<Label FontSize="12" Text="Регистар на лекови и нивните стандардни дози." TextColor="{StaticResource SparkTextSecondary}" />
								</VerticalStackLayout>
								<controls:FFButton Grid.Column="1" ButtonKind="Primary" BackgroundColorEx="{StaticResource SidebarActiveBg}" TextColorEx="White" Command="{Binding NewMedicineCommand}" ContentPadding="18,0" HeightRequestEx="40" Text="+ Нов лек" />
							</Grid>
							<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пребарување по назив, генеричко име или форма..."
								SearchText="{Binding SearchText}"
								Tabs="{Binding Tabs}" />
							<controls:SparkDataGridView
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								ShowPagination="True"
								ShowRowNumbers="True"
								TotalPages="{Binding TotalPages}" />
						</controls:FFSectionCard>

						<!-- Application methods tab -->
						<controls:FFSectionCard IsVisible="{Binding IsApplicationRegimeTabActive}">
							<Grid ColumnDefinitions="*,Auto" Padding="4,0,4,10">
								<VerticalStackLayout Spacing="3">
									<Label FontAttributes="Bold" FontSize="16" Text="Начини на апликација" TextColor="{StaticResource SparkTextPrimary}" />
									<Label FontSize="12" Text="Регистар на начини на апликација што се користат кај терапијата." TextColor="{StaticResource SparkTextSecondary}" />
								</VerticalStackLayout>
								<controls:FFButton Grid.Column="1" ButtonKind="Primary" BackgroundColorEx="{StaticResource SidebarActiveBg}" TextColorEx="White" Command="{Binding AddApplicationRegimeCommand}" Text="+ Нов начин на апликација" HeightRequestEx="40" ContentPadding="18,0" />
							</Grid>
							<controls:SparkDataGridView Columns="{Binding ApplicationRegimeColumns}" Rows="{Binding ApplicationRegimeRows}" ShowPagination="False" ShowRowNumbers="True" />
						</controls:FFSectionCard>

						<!-- Clinical scores tab -->
						<controls:FFSectionCard IsVisible="{Binding IsScoreTabActive}">
							<Grid ColumnDefinitions="*,Auto" Padding="4,0,4,10">
								<VerticalStackLayout Spacing="3">
									<Label FontAttributes="Bold" FontSize="16" Text="Скорови" TextColor="{StaticResource SparkTextPrimary}" />
									<Label FontSize="12" Text="Регистар на клинички скорови достапни во прегледите." TextColor="{StaticResource SparkTextSecondary}" />
								</VerticalStackLayout>
								<controls:FFButton Grid.Column="1" ButtonKind="Primary" BackgroundColorEx="{StaticResource SidebarActiveBg}" TextColorEx="White" Command="{Binding AddScoreDefinitionCommand}" IsEnabled="{Binding CanCreate}" Text="+ Додади скор" HeightRequestEx="40" ContentPadding="18,0" />
							</Grid>
							<controls:SparkDataGridView Columns="{Binding ScoreColumns}" Rows="{Binding ScoreRows}" ShowPagination="False" ShowRowNumbers="True" />
						</controls:FFSectionCard>
					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>