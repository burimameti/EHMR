<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.UserEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="Root"
	x:DataType="viewModels:UserEditViewModel"
	BackgroundColor="#F8FAFC">

	<Grid ColumnDefinitions="240,*">

		<Border
			Grid.Column="0"
			BackgroundColor="#0F172A"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="80,*">

			<Border
				Grid.Row="0"
				BackgroundColor="White"
				Stroke="#E2E8F0"
				StrokeThickness="1">
				<Grid Padding="32,0" ColumnDefinitions="*,Auto">

					<VerticalStackLayout Spacing="2" VerticalOptions="Center">
						<HorizontalStackLayout Spacing="8">
							<Button
								Padding="0"
								BackgroundColor="Transparent"
								Command="{Binding CancelCommand}"
								FontAttributes="Bold"
								FontSize="16"
								Text="←"
								TextColor="#64748B"
								VerticalOptions="Center" />
							<Label
								Margin="4,0,0,0"
								FontAttributes="Bold"
								FontSize="22"
								Text="{Binding PageTitle}"
								TextColor="#0F172A"
								VerticalOptions="Center" />
						</HorizontalStackLayout>
						<Label
							Margin="28,0,0,0"
							FontSize="13"
							Text="Менаџирање, уредување улоги и безбедносни дозволи за системски корисник"
							TextColor="#64748B" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="1"
						Spacing="12"
						VerticalOptions="Center">
						<Button
							Padding="16,0"
							BackgroundColor="#EFF6FF"
							Command="{Binding ToggleEditModeCommand}"
							CornerRadius="10"
							FontAttributes="Bold"
							FontSize="12"
							HeightRequest="40"
							IsVisible="{Binding CanShowEditButton}"
							Text="✎ Уреди Корисник"
							TextColor="#2563EB" />

						<Button
							Padding="16,0"
							BackgroundColor="#FEF2F2"
							Command="{Binding DeleteCommand}"
							CornerRadius="10"
							FontAttributes="Bold"
							FontSize="12"
							HeightRequest="40"
							IsVisible="{Binding CanShowDeleteButton}"
							Text="🗑 Избриши"
							TextColor="#DC2626" />

						<Button
							Padding="16,0"
							BackgroundColor="#F1F5F9"
							Command="{Binding CancelCommand}"
							CornerRadius="10"
							FontAttributes="Bold"
							FontSize="12"
							HeightRequest="40"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи"
							TextColor="#475569" />

						<Button
							Padding="20,0"
							BackgroundColor="#2563EB"
							Command="{Binding SaveCommand}"
							CornerRadius="10"
							FontAttributes="Bold"
							FontSize="12"
							HeightRequest="40"
							IsVisible="{Binding IsEditMode}"
							Text="💾 Зачувај Запис"
							TextColor="White" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<ScrollView Grid.Row="1" Padding="32">
				<Grid ColumnDefinitions="2*,*" ColumnSpacing="24">

					<VerticalStackLayout Grid.Column="0" Spacing="24">

						<Border
							Padding="16"
							BackgroundColor="White"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 16"
							StrokeThickness="1">
							<VerticalStackLayout Spacing="20">
								<HorizontalStackLayout Margin="0,0,0,4" Spacing="8">
									<Label
										FontSize="18"
										Text="👤"
										VerticalOptions="Center" />
									<Label
										FontAttributes="Bold"
										FontSize="16"
										Text="Профил на Корисник"
										TextColor="#0F172A"
										VerticalOptions="Center" />
								</HorizontalStackLayout>

								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="20"
									RowDefinitions="Auto,Auto"
									RowSpacing="16">
									<VerticalStackLayout Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="КОРИСНИЧКО ИМЕ *"
											TextColor="#475569" />
										<Border
											BackgroundColor="#FFFFFF"
											HeightRequest="42"
											Stroke="#CBD5E1"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Entry
												Margin="12,0"
												FontSize="13"
												IsReadOnly="{Binding IsReadOnly}"
												IsSpellCheckEnabled="False"
												IsTextPredictionEnabled="False"
												Placeholder="Username"
												PlaceholderColor="#94A3B8"
												Text="{Binding User.Username, Mode=TwoWay}"
												TextColor="#0F172A"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="АКТИВЕН СТАТУС"
											TextColor="#475569" />
										<HorizontalStackLayout
											HeightRequest="42"
											Spacing="10"
											VerticalOptions="Center">
											<Switch
												IsEnabled="{Binding IsEditMode}"
												IsToggled="{Binding User.IsActive, Mode=TwoWay}"
												VerticalOptions="Center" />
											<Label
												FontSize="13"
												Text="Активен Профил"
												TextColor="#475569"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="ИМЕ *"
											TextColor="#475569" />
										<Border
											BackgroundColor="#FFFFFF"
											HeightRequest="42"
											Stroke="#CBD5E1"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Entry
												Margin="12,0"
												FontSize="13"
												IsReadOnly="{Binding IsReadOnly}"
												Placeholder="Внесете име"
												PlaceholderColor="#94A3B8"
												Text="{Binding User.FirstName, Mode=TwoWay}"
												TextColor="#0F172A"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="1"
										Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="ПРЕЗИМЕ *"
											TextColor="#475569" />
										<Border
											BackgroundColor="#FFFFFF"
											HeightRequest="42"
											Stroke="#CBD5E1"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Entry
												Margin="12,0"
												FontSize="13"
												IsReadOnly="{Binding IsReadOnly}"
												Placeholder="Внесете презиме"
												PlaceholderColor="#94A3B8"
												Text="{Binding User.LastName, Mode=TwoWay}"
												TextColor="#0F172A"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
						</Border>

						<Border
							Padding="16"
							BackgroundColor="White"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 16"
							StrokeThickness="1">
							<VerticalStackLayout Spacing="6">
								<Grid ColumnDefinitions="*,Auto">
									<HorizontalStackLayout Spacing="8">
										<Label
											FontSize="18"
											Text="🔐"
											VerticalOptions="Center" />
										<Label
											FontAttributes="Bold"
											FontSize="16"
											Text="Експлицитни Системски Дозволи"
											TextColor="#0F172A"
											VerticalOptions="Center" />
									</HorizontalStackLayout>

									<Button
										Grid.Column="1"
										Padding="10,0"
										BackgroundColor="#F0FDF4"
										Command="{Binding ApplyDefaultPermissionsForRoleCommand}"
										FontSize="11"
										HeightRequest="32"
										IsVisible="{Binding IsEditMode}"
										Text="⚡ Дефолтни за улога"
										TextColor="#16A34A" />
								</Grid>

								<CollectionView Margin="0,8,0,0" ItemsSource="{Binding SystemPermissions}">
									<CollectionView.ItemsLayout>
										<LinearItemsLayout ItemSpacing="6" Orientation="Vertical" />
									</CollectionView.ItemsLayout>
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="viewModels:PermissionCheckWrapper">
											<Border
												Padding="12"
												BackgroundColor="#F8FAFC"
												Stroke="#F1F5F9"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding BindingContext.IsEditMode, Source={x:Reference Root}}">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding BindingContext.TogglePermissionCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>

													<CheckBox
														Grid.Column="0"
														InputTransparent="True"
														IsChecked="{Binding IsSelected}"
														VerticalOptions="Center"
														Color="#2563EB" />

													<Label
														Grid.Column="1"
														Margin="12,0,0,0"
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding DisplayName}"
														TextColor="#0F172A"
														VerticalOptions="Center" />
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout Grid.Column="1" Spacing="24">

						<Border
							Padding="16"
							BackgroundColor="White"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 16"
							StrokeThickness="1">
							<VerticalStackLayout Spacing="14">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Text="СИСТЕМСКА УЛОГА (ROLE) *"
									TextColor="#475569" />
								<Grid>
									<Border
										Padding="12,6"
										BackgroundColor="#EFF6FF"
										HorizontalOptions="Start"
										IsVisible="{Binding IsReadOnly}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="0">
										<HorizontalStackLayout Spacing="6">
											<BoxView
												CornerRadius="4"
												HeightRequest="8"
												VerticalOptions="Center"
												WidthRequest="8"
												Color="#2563EB" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding User.Role}"
												TextColor="#2563EB"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Border>

									<Border
										BackgroundColor="#FFFFFF"
										HeightRequest="42"
										IsVisible="{Binding IsEditMode}"
										Stroke="#CBD5E1"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<Grid>
											<Grid
												Margin="12,0"
												ColumnDefinitions="*, Auto"
												InputTransparent="True">
												<Label
													FontSize="13"
													Text="{Binding Source={x:Reference RolePicker}, Path=SelectedItem, FallbackValue='Изберете улога'}"
													TextColor="#0F172A"
													VerticalOptions="Center" />
												<Label
													Grid.Column="1"
													FontSize="11"
													Text="▼"
													TextColor="#94A3B8"
													VerticalOptions="Center" />
											</Grid>

											<Picker
												x:Name="RolePicker"
												HorizontalOptions="Fill"
												ItemsSource="{Binding Roles}"
												SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
												VerticalOptions="Fill" />
										</Grid>
									</Border>
								</Grid>
							</VerticalStackLayout>
						</Border>

						<Border
							Padding="16"
							BackgroundColor="White"
							Stroke="#E2E8F0"
							StrokeShape="RoundRectangle 16"
							StrokeThickness="1">
							<VerticalStackLayout Spacing="14">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Text="ПОЗИЦИЈА / ОДДЕЛ (POSITION) *"
									TextColor="#475569" />
								<Grid>
									<Border
										Padding="12,6"
										BackgroundColor="#F1F5F9"
										HorizontalOptions="Start"
										IsVisible="{Binding IsReadOnly}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="0">
										<HorizontalStackLayout Spacing="6">
											<BoxView
												CornerRadius="4"
												HeightRequest="8"
												VerticalOptions="Center"
												WidthRequest="8"
												Color="#475569" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding User.Position}"
												TextColor="#475569"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Border>

									<Border
										BackgroundColor="#FFFFFF"
										HeightRequest="42"
										IsVisible="{Binding IsEditMode}"
										Stroke="#CBD5E1"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<Grid>
											<Grid
												Margin="12,0"
												ColumnDefinitions="*, Auto"
												InputTransparent="True">
												<Label
													FontSize="13"
													Text="{Binding Source={x:Reference PositionPicker}, Path=SelectedItem, FallbackValue='Изберете позиција'}"
													TextColor="#0F172A"
													VerticalOptions="Center" />
												<Label
													Grid.Column="1"
													FontSize="11"
													Text="▼"
													TextColor="#94A3B8"
													VerticalOptions="Center" />
											</Grid>

											<Picker
												x:Name="PositionPicker"
												HorizontalOptions="Fill"
												ItemsSource="{Binding Positions}"
												SelectedItem="{Binding User.Position, Mode=TwoWay}"
												TextColor="#0F172A"
												VerticalOptions="Fill" />
										</Grid>
									</Border>
								</Grid>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>
				</Grid>
			</ScrollView>
		</Grid>
	</Grid>
</ContentPage>