<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.UserEditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    x:DataType="viewModels:UserEditViewModel"
    x:Name="Root"
    BackgroundColor="#F8FAFC">

	<Grid ColumnDefinitions="240,*">

		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="80,*">

			<Border Grid.Row="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1">
				<Grid Padding="32,0" ColumnDefinitions="*,Auto">

					<VerticalStackLayout Spacing="2" VerticalOptions="Center">
						<HorizontalStackLayout Spacing="8">
							<Button Text="←" FontSize="16" FontAttributes="Bold" TextColor="#64748B" BackgroundColor="Transparent" Padding="0" Command="{Binding CancelCommand}" VerticalOptions="Center" />
							<Label Text="{Binding PageTitle}" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" Margin="4,0,0,0" />
						</HorizontalStackLayout>
						<Label Text="Менаџирање, уредување улоги и безбедносни дозволи за системски корисник" FontSize="13" TextColor="#64748B" Margin="28,0,0,0" />
					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
						<Button Text="✎ Уреди Корисник"
                                IsVisible="{Binding IsReadOnly}"
                                Command="{Binding ToggleEditModeCommand}"
                                HeightRequest="40" Padding="16,0" CornerRadius="10" FontSize="12" FontAttributes="Bold" BackgroundColor="#EFF6FF" TextColor="#2563EB" />

						<Button Text="Откажи"
                                IsVisible="{Binding IsEditMode}"
                                Command="{Binding CancelCommand}"
                                HeightRequest="40" Padding="16,0" CornerRadius="10" FontSize="12" FontAttributes="Bold" BackgroundColor="#F1F5F9" TextColor="#475569" />

						<Button Text="💾 Зачувај Запис"
                                IsVisible="{Binding IsEditMode}"
                                Command="{Binding SaveCommand}"
                                HeightRequest="40" Padding="20,0" CornerRadius="10" FontSize="12" FontAttributes="Bold" BackgroundColor="#2563EB" TextColor="White" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<ScrollView Grid.Row="1" Padding="32">
				<Grid ColumnDefinitions="2*,*" ColumnSpacing="24">

					<VerticalStackLayout Grid.Column="0" Spacing="24">

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="20">
								<HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
									<Label Text="👤" FontSize="18" VerticalOptions="Center" />
									<Label Text="Профил на Корисник" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
								</HorizontalStackLayout>

								<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="16">
									<VerticalStackLayout Spacing="6">
										<Label Text="КОРИСНИЧКО ИМЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding User.Username, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" Placeholder="Username" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="6">
										<Label Text="АКТИВЕН СТАТУС" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<HorizontalStackLayout Spacing="10" HeightRequest="42" VerticalOptions="Center">
											<Switch IsToggled="{Binding User.IsActive, Mode=TwoWay}" IsEnabled="{Binding IsEditMode}" VerticalOptions="Center" />
											<Label Text="Активен Профил" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
										</HorizontalStackLayout>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Spacing="6">
										<Label Text="ИМЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding User.FirstName, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Внесете име" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="6">
										<Label Text="ПРЕЗИМЕ *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
										<Border HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
											<Entry Text="{Binding User.LastName, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" Placeholder="Внесете презиме" PlaceholderColor="#94A3B8" FontSize="13" TextColor="#0F172A" VerticalOptions="Center" Margin="12,0" />
										</Border>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
						</Border>

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="6">
								<Grid ColumnDefinitions="*,Auto">
									<HorizontalStackLayout Spacing="8">
										<Label Text="🔐" FontSize="18" VerticalOptions="Center" />
										<Label Text="Експлицитни Системски Дозволи" FontSize="16" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
									</HorizontalStackLayout>

									<Button Grid.Column="1"
                                            Text="⚡ Дефолтни за улога"
                                            FontSize="11"
                                            Padding="10,0"
                                            HeightRequest="32"
                                            BackgroundColor="#F0FDF4"
                                            TextColor="#16A34A"
                                            IsVisible="{Binding IsEditMode}"
                                            Command="{Binding ApplyDefaultPermissionsForRoleCommand}" />
								</Grid>

								<CollectionView ItemsSource="{Binding SystemPermissions}" Margin="0,8,0,0">
									<CollectionView.ItemsLayout>
										<LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
									</CollectionView.ItemsLayout>
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="viewModels:PermissionCheckWrapper">
											<Border Padding="12" Stroke="#F1F5F9" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="#F8FAFC">
												<Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding BindingContext.IsEditMode, Source={x:Reference Root}}">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding BindingContext.TogglePermissionCommand, Source={x:Reference Root}}"
                                                                              CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>

													<CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsSelected}"
                                                              InputTransparent="True"
                                                              Color="#2563EB"
                                                              VerticalOptions="Center" />

													<Label Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           VerticalOptions="Center"
                                                           TextColor="#0F172A"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           Margin="12,0,0,0" />
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>

					<VerticalStackLayout Grid.Column="1" Spacing="24">

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="14">
								<Label Text="СИСТЕМСКА УЛОГА (ROLE) *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
								<Grid>
									<Border IsVisible="{Binding IsReadOnly}" Padding="12,6" BackgroundColor="#EFF6FF" StrokeThickness="0" HorizontalOptions="Start" StrokeShape="RoundRectangle 8">
										<HorizontalStackLayout Spacing="6">
											<BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#2563EB" VerticalOptions="Center" />
											<Label Text="{Binding User.Role}" FontSize="12" FontAttributes="Bold" TextColor="#2563EB" VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Border>

									<Border IsVisible="{Binding IsEditMode}" HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
										<Grid>
											<Grid ColumnDefinitions="*, Auto" Margin="12,0" InputTransparent="True">
												<Label Text="{Binding Source={x:Reference RolePicker}, Path=SelectedItem, FallbackValue='Изберете улога'}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
												<Label Grid.Column="1" Text="▼" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
											</Grid>

											<Picker x:Name="RolePicker"
                                                    ItemsSource="{Binding Roles}"
                                                    SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill" />
										</Grid>
									</Border>
								</Grid>
							</VerticalStackLayout>
						</Border>

						<Border BackgroundColor="White" Padding="16" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 16">
							<VerticalStackLayout Spacing="14">
								<Label Text="ПОЗИЦИЈА / ОДДЕЛ (POSITION) *" FontSize="11" FontAttributes="Bold" TextColor="#475569" CharacterSpacing="0.5" />
								<Grid>
									<Border IsVisible="{Binding IsReadOnly}" Padding="12,6" BackgroundColor="#F1F5F9" StrokeThickness="0" HorizontalOptions="Start" StrokeShape="RoundRectangle 8">
										<HorizontalStackLayout Spacing="6">
											<BoxView WidthRequest="8" HeightRequest="8" CornerRadius="4" Color="#475569" VerticalOptions="Center" />
											<Label Text="{Binding User.Position}" FontSize="12" FontAttributes="Bold" TextColor="#475569" VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Border>

									<Border IsVisible="{Binding IsEditMode}" HeightRequest="42" BackgroundColor="#FFFFFF" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 10">
										<Grid>
											<Grid ColumnDefinitions="*, Auto" Margin="12,0" InputTransparent="True">
												<Label Text="{Binding Source={x:Reference PositionPicker}, Path=SelectedItem, FallbackValue='Изберете позиција'}" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
												<Label Grid.Column="1" Text="▼" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
											</Grid>

											<Picker x:Name="PositionPicker"
                                                    ItemsSource="{Binding Positions}"
                                                    SelectedItem="{Binding User.Position, Mode=TwoWay}"
                                                    TextColor="#0F172A"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill" />
										</Grid>
									</Border>
								</Grid>
							</VerticalStackLayout>
						</Border>
					</VerticalStackLayout>
				</Grid>
			</ScrollView>
		</Grid>
	</Grid>
</ContentPage>