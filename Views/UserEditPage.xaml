<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.UserEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:Name="Root"
	x:DataType="viewModels:UserEditViewModel"
	BackgroundColor="#F8FAFC">

	<Grid ColumnDefinitions="285,*">

		<Border
			Grid.Column="0"
			BackgroundColor="#0F172A"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*"
			RowSpacing="16">

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="{Binding PageTitle}" Subtitle="Управување со кориснички улоги и системски дозволи">
					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="10">
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding ToggleEditModeCommand}"
								IsVisible="{Binding CanShowEditButton}"
								Text="Уреди" />
							<controls:FFButton
								ButtonKind="Danger"
								Command="{Binding DeleteCommand}"
								IsVisible="{Binding CanShowDeleteButton}"
								Text="Избриши" />
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding CancelCommand}"
								IsVisible="{Binding IsEditMode}"
								Text="Откажи" />
							<controls:FFButton
								BackgroundColorEx="{StaticResource SidebarActiveBg}"
								ButtonKind="Primary"
								Command="{Binding SaveCommand}"
								IsVisible="{Binding IsEditMode}"
								Text="Зачувај"
								TextColorEx="White" />
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<ScrollView Grid.Row="1" Padding="0">
				<Grid ColumnDefinitions="2*,*" ColumnSpacing="16">

					<VerticalStackLayout Grid.Column="0" Spacing="16">

						<controls:FFSectionCard Margin="0" ContentPadding="18">
							<VerticalStackLayout Spacing="20">
								<HorizontalStackLayout Margin="0,0,0,4" Spacing="8">
									<Label
										FontSize="18"
										Text="👤"
										VerticalOptions="Center" />
									<controls:CrudSectionHeader Title="Профил на Корисник" />
								</HorizontalStackLayout>

								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="20"
									RowDefinitions="Auto,Auto"
									RowSpacing="16">
									<VerticalStackLayout Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="КОРИСНИЧКО ИМЕ *"
											TextColor="#475569" />
										<controls:FFInput
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Username"
											Text="{Binding User.Username, Mode=TwoWay}" />
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="АКТИВЕН СТАТУС"
											TextColor="#475569" />
										<HorizontalStackLayout
											HeightRequest="42"
											Spacing="10"
											VerticalOptions="Center">
											<Switch
												IsEnabled="{Binding IsEditMode}"
												IsToggled="{Binding User.IsActive, Mode=TwoWay}"
												VerticalOptions="Center" />
											<Label
												FontSize="13"
												Text="Активен Профил"
												TextColor="#475569"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="ИМЕ *"
											TextColor="#475569" />
										<controls:FFInput
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Внесете име"
											Text="{Binding User.FirstName, Mode=TwoWay}" />
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="1"
										Spacing="6">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="11"
											Text="ПРЕЗИМЕ *"
											TextColor="#475569" />
										<controls:FFInput
											IsReadOnly="{Binding IsReadOnly}"
											Placeholder="Внесете презиме"
											Text="{Binding User.LastName, Mode=TwoWay}" />
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
						</controls:FFSectionCard>

						<controls:FFSectionCard Margin="0" ContentPadding="18">
							<VerticalStackLayout Spacing="6">
								<Grid ColumnDefinitions="*,Auto">
									<HorizontalStackLayout Spacing="8">
										<Label
											FontSize="18"
											Text="🔐"
											VerticalOptions="Center" />
										<controls:CrudSectionHeader Title="Експлицитни Системски Дозволи" />
									</HorizontalStackLayout>

									<Button
										Grid.Column="1"
										Padding="10,0"
										BackgroundColor="#F0FDF4"
										Command="{Binding ApplyDefaultPermissionsForRoleCommand}"
										FontSize="11"
										HeightRequest="32"
										IsVisible="{Binding IsEditMode}"
										Text="⚡ Дефолтни за улога"
										TextColor="#16A34A" />
								</Grid>

								<CollectionView Margin="0,8,0,0" ItemsSource="{Binding SystemPermissions}">
									<CollectionView.ItemsLayout>
										<LinearItemsLayout ItemSpacing="6" Orientation="Vertical" />
									</CollectionView.ItemsLayout>
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="viewModels:PermissionCheckWrapper">
											<Border
												Padding="12"
												BackgroundColor="#F8FAFC"
												Stroke="#F1F5F9"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Grid ColumnDefinitions="Auto,*" IsEnabled="{Binding BindingContext.IsEditMode, Source={x:Reference Root}}">
													<Grid.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding BindingContext.TogglePermissionCommand, Source={x:Reference Root}}" CommandParameter="{Binding .}" />
													</Grid.GestureRecognizers>

													<CheckBox
														Grid.Column="0"
														InputTransparent="True"
														IsChecked="{Binding IsSelected}"
														VerticalOptions="Center"
														Color="#2563EB" />

													<Label
														Grid.Column="1"
														Margin="12,0,0,0"
														FontAttributes="Bold"
														FontSize="13"
														Text="{Binding DisplayName}"
														TextColor="#0F172A"
														VerticalOptions="Center" />
												</Grid>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>
						</controls:FFSectionCard>
					</VerticalStackLayout>

					<VerticalStackLayout Grid.Column="1" Spacing="16">

						<controls:FFSectionCard Margin="0" ContentPadding="18">
							<VerticalStackLayout Spacing="10">
								<HorizontalStackLayout Spacing="8">
									<Label
										FontSize="15"
										Text="🎭"
										VerticalOptions="Center" />
									<controls:CrudSectionHeader Title="СИСТЕМСКА УЛОГА (ROLE) *" />
								</HorizontalStackLayout>

								<Border
									Padding="14,12"
									BackgroundColor="#EFF6FF"
									IsVisible="{Binding IsReadOnly}"
									Stroke="#BFDBFE"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<HorizontalStackLayout Spacing="10">
										<Border
											Padding="7,5"
											BackgroundColor="#2563EB"
											StrokeShape="RoundRectangle 4"
											StrokeThickness="0"
											VerticalOptions="Center">
											<Label
												FontFamily="FASolid"
												FontSize="10"
												Text="&#xf505;"
												TextColor="White" />
										</Border>
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding User.Role}"
											TextColor="#1E40AF"
											VerticalOptions="Center" />
									</HorizontalStackLayout>
								</Border>

								<controls:FFPicker
									IsVisible="{Binding IsEditMode}"
									ItemsSource="{Binding Roles}"
									Label=""
									Placeholder="Изберете улога"
									SelectedItem="{Binding SelectedRole, Mode=TwoWay}" />
							</VerticalStackLayout>
						</controls:FFSectionCard>

						<controls:FFSectionCard Margin="0" ContentPadding="18">
							<VerticalStackLayout Spacing="10">
								<HorizontalStackLayout Spacing="8">
									<Label
										FontSize="15"
										Text="🏢"
										VerticalOptions="Center" />
									<controls:CrudSectionHeader Title="ПОЗИЦИЈА / ОДДЕЛ (POSITION) *" />
								</HorizontalStackLayout>

								<Border
									Padding="14,12"
									BackgroundColor="#F1F5F9"
									IsVisible="{Binding IsReadOnly}"
									Stroke="#CBD5E1"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<HorizontalStackLayout Spacing="10">
										<Border
											Padding="7,5"
											BackgroundColor="#475569"
											StrokeShape="RoundRectangle 4"
											StrokeThickness="0"
											VerticalOptions="Center">
											<Label
												FontFamily="FASolid"
												FontSize="10"
												Text="&#xf0b1;"
												TextColor="White" />
										</Border>
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding User.Position}"
											TextColor="#334155"
											VerticalOptions="Center" />
									</HorizontalStackLayout>
								</Border>

								<controls:FFPicker
									IsVisible="{Binding IsEditMode}"
									ItemsSource="{Binding Positions}"
									Label=""
									Placeholder="Изберете позиција"
									SelectedItem="{Binding SelectedPosition, Mode=TwoWay}" />
							</VerticalStackLayout>
						</controls:FFSectionCard>

					</VerticalStackLayout>
				</Grid>
			</ScrollView>
		</Grid>
	</Grid>
</ContentPage>