<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Doctors.DoctorsListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="vm:DoctorsListViewModel"
	BackgroundColor="{StaticResource PageBackground}">
	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Реуматолози"
						Grid.Column="0"
						Subtitle="Преглед, пребарување и управување со медицински персонал" >
				<controls:FFPageHeader.HeaderContent>
<controls:FFButton
						ButtonKind="Secondary"
						Command="{Binding GoBackCommand}"
						HeightRequestEx="40"
						Text="Назад"
						WidthRequestEx="130" />
			</controls:FFPageHeader.HeaderContent>
		</controls:FFPageHeader>

					<controls:FFButton
						Grid.Column="1"
						BackgroundColorEx="{StaticResource SidebarActiveBg}"
						ButtonKind="Primary"
						Command="{Binding NewCommand}"
						ContentPadding="20,0"
						HeightRequestEx="45"
						IsEnabled="{Binding CanCreate}"
						Text="Нов реуматолог"
						TextColorEx="White" />
				</Grid>
			</Border>

			<!--  MAIN CONTENT / GRID  -->
			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource PageBackground}"
				StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">
						<Border BackgroundColor="#F9FAFB" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Padding="8,4">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,3">
									<BoxView WidthRequest="4" HeightRequest="16" CornerRadius="2" Color="{StaticResource SparkAccentTeal}" VerticalOptions="Center" />
									<Label Grid.Column="1" FontAttributes="Bold" FontSize="11" Text="ПРЕБАРУВАЊЕ И ФИЛТРИ" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
								</Grid>
<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пребарување на реуматолози..."
								SearchText="{Binding DoctorSearchText}"
								Tabs="{Binding Tabs}" />
							</Border>
						<controls:FFSectionCard>
							<controls:SparkDataGridView
								x:Name="DoctorGrid"
								AutoSelectFirstRow="False"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								ShowPagination="True"
								ShowRowNumbers="True"
								TotalPages="{Binding TotalPages}" />
						</controls:FFSectionCard>
					</VerticalStackLayout>
				</ScrollView>
			</Border>

		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>