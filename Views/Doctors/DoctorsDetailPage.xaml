<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
	x:Class="EHMR.Views.Doctors.DoctorsDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="vm:DoctorsDetailViewModel"
	BackgroundColor="{StaticResource PageBackground}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="SectionHeaderStyle" TargetType="controls:CrudSectionHeader">
                <Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
                <Setter Property="TextColor" Value="{StaticResource Gray800}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

	<Grid ColumnDefinitions="260,*">

		<!--  =====================================================  -->
		<!--  LEFT MENU  -->
		<!--  =====================================================  -->

		<Border
			Grid.Column="0"
			BackgroundColor="#F3F6FA"
			StrokeThickness="0">

			<ContentView x:Name="MenuHost" />

		</Border>

		<!--  =====================================================  -->
		<!--  RIGHT CONTENT  -->
		<!--  =====================================================  -->

		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*,Auto"
			RowSpacing="0">

			<!--  =================================================  -->
			<!--  HEADER  -->
			<!--  =================================================  -->

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">

				<controls:FFPageHeader Title="{Binding PageTitle}" Subtitle="Податоци и пристап за избраниот реуматолог">

					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="10" VerticalOptions="Center">

					<controls:FFButton
                            ButtonKind="Secondary"
                            Command="{Binding CancelCommand}"
                            HeightRequestEx="40"
                            Text="Назад"
                            WidthRequestEx="130" />

						<Border
							Padding="10,5"
							IsVisible="{Binding IsReadOnly}"
							StrokeShape="RoundRectangle 12"
							StrokeThickness="0">

							<Border.Triggers>

								<DataTrigger
									Binding="{Binding IsActive}"
									TargetType="Border"
									Value="True">
									<Setter Property="BackgroundColor" Value="#DCFCE7" />
								</DataTrigger>

								<DataTrigger
									Binding="{Binding IsActive}"
									TargetType="Border"
									Value="False">
									<Setter Property="BackgroundColor" Value="#FEE2E2" />
								</DataTrigger>

							</Border.Triggers>

							<Label FontAttributes="Bold" FontSize="11">

								<Label.Triggers>

									<DataTrigger
										Binding="{Binding IsActive}"
										TargetType="Label"
										Value="True">
										<Setter Property="Text" Value="Активен" />
										<Setter Property="TextColor" Value="#15803D" />
									</DataTrigger>

									<DataTrigger
										Binding="{Binding IsActive}"
										TargetType="Label"
										Value="False">
										<Setter Property="Text" Value="Неактивен" />
										<Setter Property="TextColor" Value="#B91C1C" />
									</DataTrigger>

								</Label.Triggers>

							</Label>

						</Border>

					
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>

				</controls:FFPageHeader>

			</Border>

			<!--  =================================================  -->
			<!--  FORM  -->
			<!--  =================================================  -->

			<Border
                Grid.Row="1"
                Margin="0"
                Padding="24,20"
                BackgroundColor="White"
                Stroke="{StaticResource SparkBorderSubtle}"
                StrokeThickness="1">

				<Border.StrokeShape>
					<RoundRectangle CornerRadius="12" />
				</Border.StrokeShape>

				<ScrollView>

					<VerticalStackLayout MaximumWidthRequest="900" Spacing="16">

						<!--  =====================================  -->
						<!--  BASIC INFORMATION  -->
						<!--  =====================================  -->

						<controls:CrudSectionHeader Title="ОСНОВНИ ИНФОРМАЦИИ" LineColor="{StaticResource BrandAccent}" Style="{StaticResource SectionHeaderStyle}" />

						<!--  NAME  -->

						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Име *"
								VerticalOptions="Center" />

							<controls:FFInput
								Grid.Column="1"
								IsVisible="{Binding IsEditMode}"
								Placeholder="Внесете име"
								Text="{Binding Doctors.User.FirstName, Mode=TwoWay}" />

							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">

								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.User.FirstName, FallbackValue='—'}" />

							</Border>

						</Grid>

						<!--  SURNAME  -->

						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Презиме *"
								VerticalOptions="Center" />

							<controls:FFInput
								Grid.Column="1"
								IsVisible="{Binding IsEditMode}"
								Placeholder="Внесете презиме"
								Text="{Binding Doctors.User.LastName, Mode=TwoWay}" />

							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">

								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.User.LastName, FallbackValue='—'}" />

							</Border>

						</Grid>

						<!--  =====================================  -->
						<!--  GENDER  -->
						<!--  =====================================  -->

						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Пол *"
								VerticalOptions="Center" />

							<!--  EDIT  -->

							<HorizontalStackLayout
								Grid.Column="1"
								IsVisible="{Binding IsEditMode}"
								Spacing="28"
								VerticalOptions="Center">

								<HorizontalStackLayout Spacing="8">

									<RadioButton
										GroupName="DoctorGender"
										IsChecked="{Binding IsMale, Mode=TwoWay}"
										VerticalOptions="Center"
										Value="Male" />

									<Label
										FontSize="14"
										Text="Машки"
										TextColor="#111827"
										VerticalOptions="Center" />

								</HorizontalStackLayout>

								<HorizontalStackLayout Spacing="8">

									<RadioButton
										GroupName="DoctorGender"
										IsChecked="{Binding IsFemale, Mode=TwoWay}"
										VerticalOptions="Center"
										Value="Female" />

									<Label
										FontSize="14"
										Text="Женски"
										TextColor="#111827"
										VerticalOptions="Center" />

								</HorizontalStackLayout>

							</HorizontalStackLayout>

							<!--  READ  -->

							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">

								<HorizontalStackLayout Spacing="8">

									<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />

									<Label Style="{StaticResource InfoPillTextStyle}">

										<Label.Triggers>

											<DataTrigger
												Binding="{Binding IsMale}"
												TargetType="Label"
												Value="True">
												<Setter Property="Text" Value="Машки" />
											</DataTrigger>

											<DataTrigger
												Binding="{Binding IsFemale}"
												TargetType="Label"
												Value="True">
												<Setter Property="Text" Value="Женски" />
											</DataTrigger>

										</Label.Triggers>

									</Label>

								</HorizontalStackLayout>

							</Border>

						</Grid>

						<!--  =====================================  -->
						<!--  CONTACT  -->
						<!--  =====================================  -->

						<controls:CrudSectionHeader Title="КОНТАКТ ИНФОРМАЦИИ" LineColor="{StaticResource BrandAccent}" Style="{StaticResource SectionHeaderStyle}" />

						<!--  PHONE  -->

						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Телефон *"
								VerticalOptions="Center" />

							<controls:FFInput
								Grid.Column="1"
								IsVisible="{Binding IsEditMode}"
								Keyboard="Telephone"
								Placeholder="Внесете телефон"
								Text="{Binding Doctors.ContactPhone, Mode=TwoWay}" />

							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">

								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.ContactPhone, FallbackValue='—'}" />

							</Border>

						</Grid>

						<!--  EMAIL  -->

						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Е-пошта *"
								VerticalOptions="Center" />

							<controls:FFInput
								Grid.Column="1"
								IsVisible="{Binding IsEditMode}"
								Keyboard="Email"
								Placeholder="doctor@hospital.mk"
								Text="{Binding Doctors.Email, Mode=TwoWay}" />

							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">

								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.Email, FallbackValue='—'}" />

							</Border>

						</Grid>

						<!--  =====================================  -->
						<!--  STATUS  -->
						<!--  =====================================  -->

						<Grid
							ColumnDefinitions="160,*"
							ColumnSpacing="{StaticResource FormRowSpacing}"
							IsVisible="{Binding IsEditMode}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Статус"
								VerticalOptions="Center" />

							<HorizontalStackLayout
								Grid.Column="1"
								Spacing="14"
								VerticalOptions="Center">

								<Switch
									IsToggled="{Binding IsActive, Mode=TwoWay}"
									OnColor="#10B981"
									ThumbColor="White" />

								<Label FontSize="14" VerticalOptions="Center">

									<Label.Triggers>

										<DataTrigger
											Binding="{Binding IsActive}"
											TargetType="Label"
											Value="True">

											<Setter Property="Text" Value="Активен" />

											<Setter Property="TextColor" Value="#16A34A" />

											<Setter Property="FontAttributes" Value="Bold" />

										</DataTrigger>

										<DataTrigger
											Binding="{Binding IsActive}"
											TargetType="Label"
											Value="False">

											<Setter Property="Text" Value="Неактивен" />

											<Setter Property="TextColor" Value="#64748B" />

											<Setter Property="FontAttributes" Value="None" />

										</DataTrigger>

									</Label.Triggers>

								</Label>

							</HorizontalStackLayout>

						</Grid>

					</VerticalStackLayout>

				</ScrollView>

			</Border>

			<!--  =================================================  -->
			<!--  FOOTER  -->
			<!--  =================================================  -->

			<Border
				Grid.Row="2"
				Padding="20"
				BackgroundColor="#F3F6FA"
				Stroke="#DCE5EE"
				StrokeThickness="1">

				<Border.StrokeShape>
					<RoundRectangle CornerRadius="0" />
				</Border.StrokeShape>

				<Grid ColumnDefinitions="*,Auto">

					<!--  DELETE  -->

					<Button
						Grid.Column="0"
						Padding="24,0"
						BackgroundColor="#FEE2E2"
						BorderColor="#FCA5A5"
						BorderWidth="1"
						Command="{Binding DeleteCommand}"
						CornerRadius="6"
						FontAttributes="Bold"
						FontSize="14"
						HeightRequest="46"
						HorizontalOptions="Start"
						IsEnabled="{Binding CanDelete}"
						Text="Избриши"
						TextColor="#DC2626" />

					<!--  RIGHT BUTTONS  -->

					<HorizontalStackLayout
						Grid.Column="1"
						HorizontalOptions="End"
						Spacing="14">

						<Button
							BackgroundColor="#F1F5F9"
							BorderColor="#CBD5E1"
							BorderWidth="1"
							Command="{Binding CancelCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							Text="Откажи"
							TextColor="#475569"
							WidthRequest="120" />

						<Button
							BackgroundColor="#ECFDF5"
							BorderColor="#10B981"
							BorderWidth="1"
							Command="{Binding ToggleEditModeCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsEnabled="{Binding CanUpdate}"
							Text="Уреди"
							TextColor="#059669"
							WidthRequest="130" />

						<Button
							BackgroundColor="#10B981"
							Command="{Binding SaveCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsEnabled="{Binding CanSave}"
							Text="Зачувај"
							TextColor="White"
							WidthRequest="150" />

					</HorizontalStackLayout>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</ContentPage>