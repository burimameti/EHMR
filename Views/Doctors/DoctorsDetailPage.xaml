<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Doctors.DoctorsDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="vm:DoctorsDetailViewModel"
	BackgroundColor="#F4F7FB">

	<!--  =========================================================  -->
	<!--  RESOURCES  -->
	<!--  =========================================================  -->

	<ContentPage.Resources>

		<ResourceDictionary>

			<!--  PICKERS  -->

			<x:Array x:Key="GenderValues" Type="{x:Type x:String}">
				<x:String>Машки</x:String>
				<x:String>Женски</x:String>
				<x:String>Друго</x:String>
			</x:Array>

			<x:Array x:Key="StatusValues" Type="{x:Type x:String}">
				<x:String>Активен</x:String>
				<x:String>Неактивен</x:String>
				<x:String>Суспендиран</x:String>
			</x:Array>


			<!--  COLORS  -->

			<Color x:Key="BorderColor">#D7DEE8</Color>
			<Color x:Key="FocusColor">#10B981</Color>
			<Color x:Key="ReadOnlyColor">#F8FAFC</Color>
			<Color x:Key="InputTextColor">#111827</Color>
			<Color x:Key="PlaceholderColor">#94A3B8</Color>
			<Color x:Key="SectionColor">#059669</Color>


			<!--  LABEL  -->

			<Style x:Key="FieldLabelStyle" TargetType="Label">

				<Setter Property="FontSize" Value="13" />

				<Setter Property="FontAttributes" Value="Bold" />

				<Setter Property="TextColor" Value="#334155" />

				<Setter Property="VerticalOptions" Value="Center" />

			</Style>


			<!--  SECTION TITLE  -->

			<Style x:Key="SectionTitleStyle" TargetType="Label">

				<Setter Property="FontSize" Value="16" />

				<Setter Property="FontAttributes" Value="Bold" />

				<Setter Property="TextColor" Value="#059669" />

			</Style>

		</ResourceDictionary>

	</ContentPage.Resources>



	<!--  =========================================================  -->
	<!--  LAYOUT  -->
	<!--  =========================================================  -->

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->

		<Border
			Grid.Column="0"
			BackgroundColor="#FFFFFF"
			StrokeThickness="0">

			<ContentView x:Name="MenuHost" />

		</Border>


		<!--  =====================================================  -->
		<!--  RIGHT SIDE  -->
		<!--  =====================================================  -->

		<Grid
			Grid.Column="1"
			Padding="28"
			RowDefinitions="Auto,*,Auto"
			RowSpacing="20">

			<!--  =================================================  -->
			<!--  HEADER  -->
			<!--  =================================================  -->

			<Border
				Padding="22"
				BackgroundColor="White"
				Stroke="#E5E7EB"
				StrokeThickness="1">

				<Border.StrokeShape>

					<RoundRectangle CornerRadius="8" />

				</Border.StrokeShape>

				<Grid ColumnDefinitions="70,*" ColumnSpacing="18">

					<!--  ICON  -->

					<Border
						BackgroundColor="#ECFDF5"
						HeightRequest="60"
						StrokeThickness="0"
						WidthRequest="60">

						<Border.StrokeShape>

							<RoundRectangle CornerRadius="30" />

						</Border.StrokeShape>

						<Label
							FontFamily="FASolid"
							FontSize="22"
							HorizontalOptions="Center"
							Text="&#xf0f0;"
							TextColor="#10B981"
							VerticalOptions="Center" />

					</Border>


					<!--  TITLE  -->

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="6"
						VerticalOptions="Center">

						<Label
							FontAttributes="Bold"
							FontSize="24"
							Text="{Binding PageTitle}"
							TextColor="#111827" />

						<Border
							Padding="12,5"
							HorizontalOptions="Start"
							StrokeThickness="0">

							<Border.StrokeShape>

								<RoundRectangle CornerRadius="12" />

							</Border.StrokeShape>

							<Border.Triggers>

								<DataTrigger
									Binding="{Binding Doctors.Status}"
									TargetType="Border"
									Value="Active">

									<Setter Property="BackgroundColor" Value="#DCFCE7" />

								</DataTrigger>

								<DataTrigger
									Binding="{Binding Doctors.Status}"
									TargetType="Border"
									Value="Inactive">

									<Setter Property="BackgroundColor" Value="#F1F5F9" />

								</DataTrigger>

								<DataTrigger
									Binding="{Binding Doctors.Status}"
									TargetType="Border"
									Value="Suspended">

									<Setter Property="BackgroundColor" Value="#FEE2E2" />

								</DataTrigger>

							</Border.Triggers>

							<Label
								FontAttributes="Bold"
								FontSize="12"
								Text="{Binding SelectedStatusDisplay}">

								<Label.Triggers>

									<DataTrigger
										Binding="{Binding Doctors.Status}"
										TargetType="Label"
										Value="Active">

										<Setter Property="TextColor" Value="#16A34A" />

									</DataTrigger>

									<DataTrigger
										Binding="{Binding Doctors.Status}"
										TargetType="Label"
										Value="Inactive">

										<Setter Property="TextColor" Value="#64748B" />

									</DataTrigger>

									<DataTrigger
										Binding="{Binding Doctors.Status}"
										TargetType="Label"
										Value="Suspended">

										<Setter Property="TextColor" Value="#DC2626" />

									</DataTrigger>

								</Label.Triggers>

							</Label>

						</Border>

					</VerticalStackLayout>

				</Grid>

			</Border>


			<!--  =================================================  -->
			<!--  FORM  -->
			<!--  =================================================  -->

			<Border
				Grid.Row="1"
				Padding="36"
				BackgroundColor="White"
				Stroke="#E5E7EB"
				StrokeThickness="1">

				<Border.StrokeShape>

					<RoundRectangle CornerRadius="8" />

				</Border.StrokeShape>

				<ScrollView>

					<Grid
						ColumnDefinitions="*,*"
						ColumnSpacing="80"
						RowSpacing="34">

						<!--  ========================================  -->
						<!--  LEFT COLUMN STARTS HERE  -->
						<!--  ========================================  -->

						<VerticalStackLayout Grid.Column="0" Spacing="26">

							<Border
								Padding="0,0,0,12"
								Stroke="#E5E7EB"
								StrokeThickness="0">

								<Border.StrokeShape>
									<RoundRectangle CornerRadius="0" />
								</Border.StrokeShape>

								<Label Style="{StaticResource SectionTitleStyle}" Text="👤 Основни информации" />

							</Border>

							<!--  =======================================  -->
							<!--  ИМЕ  -->
							<!--  =======================================  -->

							<Grid ColumnDefinitions="170,*">

								<Label
									Grid.Column="0"
									Style="{StaticResource FieldLabelStyle}"
									Text="Име *" />

								<Border
									Grid.Column="1"
									Padding="12,0"
									BackgroundColor="White"
									HeightRequest="48"
									Stroke="#D7DEE8"
									StrokeThickness="1">

									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>

									<Entry
										BackgroundColor="Transparent"
										FontSize="14"
										IsEnabled="{Binding IsEditMode}"
										Placeholder="Внесете име"
										PlaceholderColor="#94A3B8"
										Text="{Binding Doctors.User.FirstName}"
										TextColor="#111827" />

								</Border>

							</Grid>


							<!--  =======================================  -->
							<!--  ПРЕЗИМЕ  -->
							<!--  =======================================  -->

							<Grid ColumnDefinitions="170,*">

								<Label
									Grid.Column="0"
									Style="{StaticResource FieldLabelStyle}"
									Text="Презиме *" />

								<Border
									Grid.Column="1"
									Padding="12,0"
									BackgroundColor="White"
									HeightRequest="48"
									Stroke="#D7DEE8"
									StrokeThickness="1">

									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>

									<Entry
										BackgroundColor="Transparent"
										FontSize="14"
										IsEnabled="{Binding IsEditMode}"
										Placeholder="Внесете презиме"
										PlaceholderColor="#94A3B8"
										Text="{Binding Doctors.User.LastName}"
										TextColor="#111827" />

								</Border>

							</Grid>


							<!--  =======================================  -->
							<!--  ПОЛ  -->
							<!--  =======================================  -->
							<Grid Padding="{StaticResource FormRowPadding}">

								<!--  EDIT  -->

								<Grid
									ColumnDefinitions="160,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsEditMode}">

									<Label
										Grid.Column="0"
										Style="{StaticResource EditFieldLabelStyle}"
										Text="Пол *" />

									<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">

										<Grid ColumnDefinitions="*,Auto">

											<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedGenderDisplay}" />

											<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />

											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{StaticResource GenderValues}"
												Opacity="0"
												SelectedItem="{Binding SelectedGenderDisplay}" />

										</Grid>

									</Border>

								</Grid>

								<!--  READ  -->

								<Grid
									ColumnDefinitions="160,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsReadOnly}">

									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Пол:" />

									<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">

										<HorizontalStackLayout Spacing="8">

											<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />

											<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding SelectedGenderDisplay}" />

										</HorizontalStackLayout>

									</Border>

								</Grid>

							</Grid>

							<!--  =======================================  -->
							<!--  КОНТАКТ ИНФОРМАЦИИ  -->
							<!--  =======================================  -->

							<Border
								Margin="0,12,0,0"
								Padding="0,0,0,12"
								StrokeThickness="0">

								<Label Style="{StaticResource SectionTitleStyle}" Text="📞 Контакт информации" />

							</Border>


							<!--  =======================================  -->
							<!--  ТЕЛЕФОН  -->
							<!--  =======================================  -->

							<Grid ColumnDefinitions="170,*">

								<Label
									Grid.Column="0"
									Style="{StaticResource FieldLabelStyle}"
									Text="Телефон *" />

								<Border
									Grid.Column="1"
									Padding="12,0"
									BackgroundColor="White"
									HeightRequest="48"
									Stroke="#D7DEE8"
									StrokeThickness="1">

									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>

									<Entry
										BackgroundColor="Transparent"
										FontSize="14"
										IsEnabled="{Binding IsEditMode}"
										Keyboard="Telephone"
										Placeholder="Внесете телефон"
										PlaceholderColor="#94A3B8"
										Text="{Binding Doctors.ContactPhone}"
										TextColor="#111827" />

								</Border>

							</Grid>

							<!--  =======================================  -->
							<!--  PART 3 STARTS  -->
							<!--  RIGHT COLUMN  -->
							<!--  =======================================  -->

						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="1" Spacing="26">

							<Border Padding="0,0,0,12" StrokeThickness="0">

								<Label Style="{StaticResource SectionTitleStyle}" Text="🩺 Професионални информации" />

							</Border>
							<!--  =======================================  -->
							<!--  СПЕЦИЈАЛНОСТ  -->
							<!--  =======================================  -->

							<Grid ColumnDefinitions="170,*">

								<Label
									Grid.Column="0"
									Style="{StaticResource FieldLabelStyle}"
									Text="Специјалност *" />

								<Border
									Grid.Column="1"
									Padding="12,0"
									BackgroundColor="White"
									HeightRequest="48"
									Stroke="#D7DEE8"
									StrokeThickness="1">

									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>

									<Entry
										BackgroundColor="Transparent"
										FontSize="14"
										IsEnabled="{Binding IsEditMode}"
										Placeholder="Внесете специјалност"
										PlaceholderColor="#94A3B8"
										Text="{Binding Doctors.Specialty}"
										TextColor="#111827" />

								</Border>

							</Grid>


							<!--  =======================================  -->
							<!--  ЛИЦЕНЦА  -->
							<!--  =======================================  -->

							<Grid ColumnDefinitions="170,*">

								<Label
									Grid.Column="0"
									Style="{StaticResource FieldLabelStyle}"
									Text="Лиценца *" />

								<Border
									Grid.Column="1"
									Padding="12,0"
									BackgroundColor="White"
									HeightRequest="48"
									Stroke="#D7DEE8"
									StrokeThickness="1">

									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>

									<Entry
										BackgroundColor="Transparent"
										FontSize="14"
										IsEnabled="{Binding IsEditMode}"
										Placeholder="Внесете број на лиценца"
										PlaceholderColor="#94A3B8"
										Text="{Binding Doctors.LicenseNumber}"
										TextColor="#111827" />

								</Border>

							</Grid>


							<!--  =======================================  -->
							<!--  СТАТУС  -->
							<!--  =======================================  -->

							<Grid Padding="{StaticResource FormRowPadding}">

								<!--  EDIT  -->

								<Grid
									ColumnDefinitions="160,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsEditMode}">

									<Label
										Grid.Column="0"
										Style="{StaticResource EditFieldLabelStyle}"
										Text="Статус *" />

									<Border Grid.Column="1" Style="{StaticResource EditFieldBoxStyle}">

										<Grid ColumnDefinitions="*,Auto">

											<Label Style="{StaticResource FieldBoxValueStyle}" Text="{Binding SelectedStatusDisplay}" />

											<Label Grid.Column="1" Style="{StaticResource FieldBoxChevronStyle}" />

											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{StaticResource StatusValues}"
												Opacity="0"
												SelectedItem="{Binding SelectedStatusDisplay}" />

										</Grid>

									</Border>

								</Grid>

								<!--  READ  -->

								<Grid
									ColumnDefinitions="160,*"
									ColumnSpacing="{StaticResource FormRowSpacing}"
									IsVisible="{Binding IsReadOnly}">

									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Статус:" />

									<Border Grid.Column="1" Style="{StaticResource InfoPillBorderStyle}">

										<HorizontalStackLayout Spacing="8">

											<controls:FFStatusChip
												BackgroundColor="{Binding Doctors.Status, Converter={StaticResource DoctorStatusToColorConverter}}"
												Text="{Binding SelectedStatusDisplay}"
												TextColor="{Binding Doctors.Status, Converter={StaticResource DoctorStatusToTextColorConverter}}" />

										</HorizontalStackLayout>

									</Border>

								</Grid>

							</Grid>


							<!--  =======================================  -->
							<!--  КОНТАКТ  -->
							<!--  =======================================  -->

							<Border
								Margin="0,12,0,0"
								Padding="0,0,0,12"
								StrokeThickness="0">

								<Label Style="{StaticResource SectionTitleStyle}" Text="✉ Контакт" />

							</Border>


							<!--  =======================================  -->
							<!--  EMAIL  -->
							<!--  =======================================  -->

							<Grid ColumnDefinitions="170,*">

								<Label
									Grid.Column="0"
									Style="{StaticResource FieldLabelStyle}"
									Text="Е-пошта *" />

								<Border
									Grid.Column="1"
									Padding="12,0"
									BackgroundColor="White"
									HeightRequest="48"
									Stroke="#D7DEE8"
									StrokeThickness="1">

									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>

									<Entry
										BackgroundColor="Transparent"
										FontSize="14"
										IsEnabled="{Binding IsEditMode}"
										Keyboard="Email"
										Placeholder="doctor@hospital.mk"
										PlaceholderColor="#94A3B8"
										Text="{Binding Doctors.Email}"
										TextColor="#111827" />

								</Border>

							</Grid>

						</VerticalStackLayout>

					</Grid>

				</ScrollView>

			</Border>

			<!--  =======================================  -->
			<!--  PART 4  -->
			<!--  Footer + Action Buttons  -->
			<!--  =======================================  -->
			<!--  =================================================  -->
			<!--  FOOTER  -->
			<!--  =================================================  -->

			<Border
				Grid.Row="2"
				Padding="20"
				BackgroundColor="#FFFFFF"
				Stroke="#E5E7EB"
				StrokeThickness="1">

				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8" />
				</Border.StrokeShape>

				<Grid ColumnDefinitions="*,Auto">

					<!--  DELETE  -->

					<Button
						Grid.Column="0"
						Padding="24,0"
						BackgroundColor="#FEE2E2"
						BorderColor="#FCA5A5"
						BorderWidth="1"
						Command="{Binding DeleteCommand}"
						CornerRadius="6"
						FontAttributes="Bold"
						FontSize="14"
						HeightRequest="46"
						HorizontalOptions="Start"
						IsVisible="{Binding CanShowDelete}"
						Text="🗑 Избриши лекар"
						TextColor="#DC2626" />


					<!--  RIGHT BUTTONS  -->

					<HorizontalStackLayout
						Grid.Column="1"
						HorizontalOptions="End"
						Spacing="14">

						<!--  CANCEL  -->

						<Button
							BackgroundColor="#64748B"
							Command="{Binding CancelCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи"
							TextColor="White"
							WidthRequest="120" />

						<!--  EDIT  -->

						<Button
							BackgroundColor="#ECFDF5"
							BorderColor="#10B981"
							BorderWidth="1"
							Command="{Binding ToggleEditModeCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsVisible="{Binding CanShowEditToggle}"
							Text="✎ Промени"
							TextColor="#059669"
							WidthRequest="130" />

						<!--  SAVE  -->

						<Button
							BackgroundColor="#10B981"
							Command="{Binding SaveCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsVisible="{Binding CanShowSave}"
							Text="💾 Зачувај"
							TextColor="White"
							WidthRequest="150" />

					</HorizontalStackLayout>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</ContentPage>