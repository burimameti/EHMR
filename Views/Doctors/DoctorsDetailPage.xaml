<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Doctors.DoctorsDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="vm:DoctorsDetailViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<!--  =========================================================  -->
	<!--  RESOURCES  -->
	<!--  =========================================================  -->

	<ContentPage.Resources>
		<ResourceDictionary />
	</ContentPage.Resources>

	<!--  =========================================================  -->
	<!--  ROOT LAYOUT: LEFT MENU + RIGHT CONTENT  -->
	<!--  =========================================================  -->

	<Grid ColumnDefinitions="285,*">

		<!--  LEFT MENU  -->
		<Border
			Grid.Column="0"
			BackgroundColor="#F3F6FA"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT SIDE  -->
		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*,Auto"
			RowSpacing="16">

			<!--  =====================================================  -->
			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="{Binding PageTitle}" Subtitle="Податоци и пристап за избраниот реуматолог">
				<controls:FFPageHeader.HeaderContent>
					<controls:FFStatusChip IsVisible="{Binding IsReadOnly}" Text="{Binding Doctors.Status}" />
				</controls:FFPageHeader.HeaderContent>
			</controls:FFPageHeader>
			</Border>

			<!--  FORM  -->
			<!--  =====================================================  -->

			<Border
				Grid.Row="1"
				Padding="40,36"
				BackgroundColor="#F3F6FA"
				Stroke="#DCE5EE"
				StrokeThickness="1">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="0" />
				</Border.StrokeShape>

				<ScrollView>
					<VerticalStackLayout MaximumWidthRequest="600" Spacing="28">

						<!--  ============================  -->
						<!--  СЕКЦИЈА: Основни информации  -->
						<!--  ============================  -->

						<controls:CrudSectionHeader Title="👤 Основни информации" />

						<!--  ИМЕ  -->
						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">
							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Име *"
								VerticalOptions="Center" />
							<controls:FFInput Grid.Column="1" IsVisible="{Binding IsEditMode}" Placeholder="Внесете име" Text="{Binding Doctors.User.FirstName}" />
							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">
								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.User.FirstName}" />
							</Border>
						</Grid>

						<!--  ПРЕЗИМЕ  -->
						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">
							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Презиме *"
								VerticalOptions="Center" />
							<controls:FFInput Grid.Column="1" IsVisible="{Binding IsEditMode}" Placeholder="Внесете презиме" Text="{Binding Doctors.User.LastName}" />
							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">
								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.User.LastName}" />
							</Border>
						</Grid>

						<!--  ПОЛ  -->
						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">
							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Пол *"
								VerticalOptions="Center" />

							<!--  EDIT — Radio buttons  -->
							<HorizontalStackLayout
								Grid.Column="1"
								IsVisible="{Binding IsEditMode}"
								Spacing="28"
								VerticalOptions="Center">

								<HorizontalStackLayout Spacing="8">
									<RadioButton
										IsChecked="{Binding IsMale}"
										VerticalOptions="Center"
										Value="Male" />
									<Label
										FontSize="14"
										Text="Машки"
										TextColor="#111827"
										VerticalOptions="Center" />
								</HorizontalStackLayout>

								<HorizontalStackLayout Spacing="8">
									<RadioButton
										IsChecked="{Binding IsFemale}"
										VerticalOptions="Center"
										Value="Female" />
									<Label
										FontSize="14"
										Text="Женски"
										TextColor="#111827"
										VerticalOptions="Center" />
								</HorizontalStackLayout>

							</HorizontalStackLayout>

							<!--  READ  -->
							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">
								<HorizontalStackLayout Spacing="8">
									<Label Style="{StaticResource InfoPillIconStyle}" Text="&#xf183;" />
									<Label Style="{StaticResource InfoPillTextStyle}">
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsMale}"
												TargetType="Label"
												Value="True">
												<Setter Property="Text" Value="Машки" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsFemale}"
												TargetType="Label"
												Value="True">
												<Setter Property="Text" Value="Женски" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</HorizontalStackLayout>
							</Border>
						</Grid>

						<!--  ============================  -->
						<!--  СЕКЦИЈА: Контакт  -->
						<!--  ============================  -->

						<controls:CrudSectionHeader Title="📞 Контакт информации" />

						<!--  ТЕЛЕФОН  -->
						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">
							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Телефон *"
								VerticalOptions="Center" />
							<controls:FFInput Grid.Column="1" IsVisible="{Binding IsEditMode}" Keyboard="Telephone" Placeholder="Внесете телефон" Text="{Binding Doctors.ContactPhone}" />
							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">
								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.ContactPhone}" />
							</Border>
						</Grid>

						<!--  EMAIL  -->
						<Grid ColumnDefinitions="160,*" ColumnSpacing="{StaticResource FormRowSpacing}">
							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Е-пошта *"
								VerticalOptions="Center" />
							<controls:FFInput Grid.Column="1" IsVisible="{Binding IsEditMode}" Keyboard="Email" Placeholder="doctor@hospital.mk" Text="{Binding Doctors.Email}" />
							<Border
								Grid.Column="1"
								IsVisible="{Binding IsReadOnly}"
								Style="{StaticResource InfoPillBorderStyle}">
								<Label Style="{StaticResource InfoPillTextStyle}" Text="{Binding Doctors.Email}" />
							</Border>
						</Grid>

						<!--  ============================  -->
						<!--  СТАТУС TOGGLE (само Edit)  -->
						<!--  ============================  -->

						<Grid
							ColumnDefinitions="160,*"
							ColumnSpacing="{StaticResource FormRowSpacing}"
							IsVisible="{Binding IsEditMode}">

							<Label
								Grid.Column="0"
								Style="{StaticResource EditFieldLabelStyle}"
								Text="Статус"
								VerticalOptions="Center" />

							<HorizontalStackLayout
								Grid.Column="1"
								Spacing="14"
								VerticalOptions="Center">

								<Switch
									IsToggled="{Binding IsActive}"
									OnColor="#10B981"
									ThumbColor="White" />

								<Label FontSize="14" VerticalOptions="Center">
									<Label.Triggers>
										<DataTrigger
											Binding="{Binding IsActive}"
											TargetType="Label"
											Value="True">
											<Setter Property="Text" Value="Активен" />
											<Setter Property="TextColor" Value="#16A34A" />
											<Setter Property="FontAttributes" Value="Bold" />
										</DataTrigger>
										<DataTrigger
											Binding="{Binding IsActive}"
											TargetType="Label"
											Value="False">
											<Setter Property="Text" Value="Неактивен" />
											<Setter Property="TextColor" Value="#64748B" />
											<Setter Property="FontAttributes" Value="None" />
										</DataTrigger>
									</Label.Triggers>
								</Label>

							</HorizontalStackLayout>

						</Grid>

					</VerticalStackLayout>
				</ScrollView>

			</Border>

			<!--  =====================================================  -->
			<!--  FOOTER — Зачувај / Откажи / Промени / Избриши  -->
			<!--  =====================================================  -->

			<Border
				Grid.Row="2"
				Padding="20"
				BackgroundColor="#F3F6FA"
				Stroke="#DCE5EE"
				StrokeThickness="1">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="0" />
				</Border.StrokeShape>

				<Grid ColumnDefinitions="*,Auto">

					<!--  DELETE (само Read + постоечки)  -->
					<Button
						Grid.Column="0"
						Padding="24,0"
						BackgroundColor="#FEE2E2"
						BorderColor="#FCA5A5"
						BorderWidth="1"
						Command="{Binding DeleteCommand}"
						CornerRadius="6"
						FontAttributes="Bold"
						FontSize="14"
						HeightRequest="46"
						HorizontalOptions="Start"
						IsVisible="{Binding CanShowDelete}"
						Text="Избриши"
						TextColor="#DC2626" />

					<!--  RIGHT BUTTONS  -->
					<HorizontalStackLayout
						Grid.Column="1"
						HorizontalOptions="End"
						Spacing="14">

						<!--  ОТКАЖИ — секогаш оди назад  -->
						<Button
							BackgroundColor="#F1F5F9"
							BorderColor="#CBD5E1"
							BorderWidth="1"
							Command="{Binding CancelCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							Text="Откажи"
							TextColor="#475569"
							WidthRequest="120" />

						<!--  ПРОМЕНИ (само Read)  -->
						<Button
							BackgroundColor="#ECFDF5"
							BorderColor="#10B981"
							BorderWidth="1"
							Command="{Binding ToggleEditModeCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsVisible="{Binding CanShowEditToggle}"
							Text="Уреди"
							TextColor="#059669"
							WidthRequest="130" />

						<!--  ЗАЧУВАЈ (само Edit)  -->
						<Button
							BackgroundColor="#10B981"
							Command="{Binding SaveCommand}"
							CornerRadius="6"
							FontAttributes="Bold"
							FontSize="14"
							HeightRequest="46"
							IsVisible="{Binding CanShowSave}"
							Text="Зачувај"
							TextColor="White"
							WidthRequest="150" />

					</HorizontalStackLayout>

				</Grid>

			</Border>

		</Grid>

	</Grid>

</ContentPage>
