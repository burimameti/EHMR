<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Doctors.DoctorsDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="PageRoot"
	x:DataType="vm:DoctorsDetailViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>

			<x:Array x:Key="GenderValues" Type="{x:Type entities:Gender}">
				<entities:Gender>Male</entities:Gender>
				<entities:Gender>Female</entities:Gender>
				<entities:Gender>Other</entities:Gender>
			</x:Array>

			<x:Array x:Key="StatusValues" Type="{x:Type entities:Status}">
				<entities:Status>Active</entities:Status>
				<entities:Status>Inactive</entities:Status>
				<entities:Status>Suspended</entities:Status>
			</x:Array>

			<!--  SECTION HEADER PILL — исто како EncounterCreatePage  -->
			<Style x:Key="SectionPillBorderStyle" TargetType="Border">
				<Setter Property="Padding" Value="14,10" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkTabActiveBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="0" />
			</Style>
			<Style x:Key="SectionPillLabelStyle" TargetType="Label">
				<Setter Property="CharacterSpacing" Value="0.5" />
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="TextColor" Value="{StaticResource SparkAccentTealDark}" />
			</Style>

			<!--  Read / edit row styles — исти фонтови како EncounterCreatePage field labels  -->
			<Style x:Key="ReadRowLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="12" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>
			<Style x:Key="ReadRowValueStyle" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="VerticalOptions" Value="Center" />
				<Setter Property="LineBreakMode" Value="TailTruncation" />
			</Style>
			<Style x:Key="EditFieldLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
			</Style>

			<!--  EDIT FIELD BOX — заоблен 8px, teal-tint border + мека сенка (како во EncounterCreatePage)  -->
			<Style x:Key="EditFieldBoxStyle" TargetType="Border">
				<Setter Property="Padding" Value="12,0" />
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
				<Setter Property="HeightRequest" Value="46" />
				<Setter Property="Stroke" Value="{StaticResource SparkAccentTealBg}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="1" />
				<Setter Property="Shadow">
					<Setter.Value>
						<Shadow
							Brush="Black"
							Opacity="0.06"
							Radius="6"
							Offset="0,2" />
					</Setter.Value>
				</Setter>
			</Style>

		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ─── LEFT MENU SIDEBAR ───  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ─── MAIN CONTENT AREA ───  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			RowDefinitions="Auto,*"
			RowSpacing="6">

			<!--  =========================================================  -->
			<!--  PAGE HEADER — иста структура/фонтови како EncounterCreatePage  -->
			<!--  =========================================================  -->
			<Border
				Padding="20,16"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<!--
						Icon circle — Doctor нема initials converter како кај Patient,
						па останува икона аватар, но во истиот teal-pill стил
						како во EncounterCreatePage header.
					-->
					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf0f0;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="{Binding PageTitle}"
							TextColor="{StaticResource SparkTextPrimary}" />

						<!--
							Status chip — нема DoctorStatusToColorConverter, па боите
							остануваат преку DataTrigger-и (функционалноста е иста,
							само поставена под насловот како subtitle-слот).
						-->
						<Border
							Padding="10,3"
							HorizontalOptions="Start"
							StrokeThickness="0">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="10" />
							</Border.StrokeShape>
							<Border.Triggers>
								<DataTrigger
									Binding="{Binding Doctors.Status}"
									TargetType="Border"
									Value="Active">
									<Setter Property="BackgroundColor" Value="#DCFCE7" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Doctors.Status}"
									TargetType="Border"
									Value="Inactive">
									<Setter Property="BackgroundColor" Value="#F3F4F6" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Doctors.Status}"
									TargetType="Border"
									Value="Suspended">
									<Setter Property="BackgroundColor" Value="#FEE2E2" />
								</DataTrigger>
							</Border.Triggers>
							<Label
								FontAttributes="Bold"
								FontSize="11"
								Text="{Binding Doctors.Status}">
								<Label.Triggers>
									<DataTrigger
										Binding="{Binding Doctors.Status}"
										TargetType="Label"
										Value="Active">
										<Setter Property="TextColor" Value="#16A34A" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding Doctors.Status}"
										TargetType="Label"
										Value="Inactive">
										<Setter Property="TextColor" Value="#6B7280" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding Doctors.Status}"
										TargetType="Label"
										Value="Suspended">
										<Setter Property="TextColor" Value="#DC2626" />
									</DataTrigger>
								</Label.Triggers>
							</Label>
						</Border>
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding CanShowSave}"
							Text="💾 Зачувај" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding IsEditMode}"
							Text="Откажи"
							TextColorEx="White" />
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding DeleteCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding CanShowDelete}"
							Text="🗑 Избриши"
							TextColorEx="White" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding ToggleEditModeCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							IsVisible="{Binding CanShowEditToggle}"
							Text="✎ Промени"
							TextColorEx="White" />
					</HorizontalStackLayout>

				</Grid>
			</Border>

			<!--  =====================================================  -->
			<!--  FORM CONTENT WORKSPACE — 3 колони, pill section headers  -->
			<!--  =====================================================  -->
			<Border
				Grid.Row="1"
				Padding="0"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<ScrollView>
					<Grid
						Padding="28"
						ColumnDefinitions="*,1,*,1,*"
						ColumnSpacing="24">

						<BoxView
							Grid.Column="1"
							VerticalOptions="Fill"
							WidthRequest="1"
							Color="{StaticResource SparkBorder}" />
						<BoxView
							Grid.Column="3"
							VerticalOptions="Fill"
							WidthRequest="1"
							Color="{StaticResource SparkBorder}" />

						<!--  ================================================  -->
						<!--  COLUMN 0 — ЛИЧНИ ПОДАТОЦИ  -->
						<!--  Doctor нема сопствени FirstName/LastName — тие  -->
						<!--  живеат на поврзаниот User. За нов лекар LoadAsync  -->
						<!--  веќе доделува Doctors.User = new User(), па  -->
						<!--  bindings подолу работат и за нов и за постоечки.  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="0" Spacing="14">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="ЛИЧНИ ПОДАТОЦИ" />
							</Border>

							<!--  Име  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Име *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Марко"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Doctors.User.FirstName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Име:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.User.FirstName}" />
								</Grid>
							</Grid>

							<!--  Презиме  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Презиме *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Петровски"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Doctors.User.LastName}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Презиме:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.User.LastName}" />
								</Grid>
							</Grid>

							<!--  Пол  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Пол" />
									<Border Padding="14,0" Style="{StaticResource EditFieldBoxStyle}">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding Doctors.Gender}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{StaticResource GenderValues}"
												Opacity="0"
												SelectedItem="{Binding Doctors.Gender}" />
										</Grid>
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Пол:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.Gender}" />
								</Grid>
							</Grid>

						</VerticalStackLayout>

						<!--  ================================================  -->
						<!--  COLUMN 1 — ПРОФЕСИОНАЛНИ ПОДАТОЦИ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="2" Spacing="14">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="ПРОФЕСИОНАЛНИ ПОДАТОЦИ" />
							</Border>

							<!--  Специјалност  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Специјалност *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Ревматологија"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Doctors.Specialty}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Специјалност:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.Specialty}" />
								</Grid>
							</Grid>

							<!--  Лиценца  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Лиценца *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. ЛБ-12345"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Doctors.LicenseNumber}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Лиценца:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.LicenseNumber}" />
								</Grid>
							</Grid>

							<!--  Статус  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Статус" />
									<Border Padding="14,0" Style="{StaticResource EditFieldBoxStyle}">
										<Grid ColumnDefinitions="*,Auto">
											<Label
												FontSize="13"
												Text="{Binding Doctors.Status}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontSize="11"
												Text="▼"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
											<Picker
												Grid.ColumnSpan="2"
												BackgroundColor="Transparent"
												ItemsSource="{StaticResource StatusValues}"
												Opacity="0"
												SelectedItem="{Binding Doctors.Status}" />
										</Grid>
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Статус:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.Status}" />
								</Grid>
							</Grid>

						</VerticalStackLayout>

						<!--  ================================================  -->
						<!--  COLUMN 2 — КОНТАКТ ИНФОРМАЦИИ  -->
						<!--  ================================================  -->
						<VerticalStackLayout Grid.Column="4" Spacing="14">

							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="КОНТАКТ ИНФОРМАЦИИ" />
							</Border>

							<!--  Телефон  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Телефон *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Keyboard="Telephone"
											Placeholder="+389 7X XXX XXX"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Doctors.ContactPhone}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Телефон:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.ContactPhone}" />
								</Grid>
							</Grid>

							<!--  Е-пошта  -->
							<Grid>
								<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="8">
									<Label Style="{StaticResource EditFieldLabelStyle}" Text="Е-пошта *" />
									<Border Style="{StaticResource EditFieldBoxStyle}">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Keyboard="Email"
											Placeholder="example@domain.com"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Doctors.Email}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</VerticalStackLayout>
								<Grid ColumnDefinitions="120,*" IsVisible="{Binding IsReadOnly}">
									<Label
										Grid.Column="0"
										Style="{StaticResource ReadRowLabelStyle}"
										Text="Е-пошта:" />
									<Label
										Grid.Column="1"
										Style="{StaticResource ReadRowValueStyle}"
										Text="{Binding Doctors.Email}" />
								</Grid>
							</Grid>

						</VerticalStackLayout>

					</Grid>
				</ScrollView>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
