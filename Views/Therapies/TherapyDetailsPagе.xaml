<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels.Therapies"
    xmlns:entities="clr-namespace:EHMR.Domain.Entities"
    x:Class="EHMR.Views.Therapies.TherapyDetailsPage"
    x:DataType="viewModels:TherapyDetailsViewModel"
    BackgroundColor="#F8FAFC">

	<Grid ColumnDefinitions="240,*">

		<!-- LEFT MENU -->
		<Border
            Grid.Column="0"
            BackgroundColor="#0F172A"
            StrokeThickness="0">

			<ContentView x:Name="MenuHost" />
		</Border>

		<!-- MAIN CONTENT -->
		<Grid
            Grid.Column="1"
            Padding="20"
            ColumnDefinitions="380,*"
            ColumnSpacing="20">

			<!-- LEFT SIDE -->
			<Border
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12"
                Padding="20">

				<VerticalStackLayout Spacing="20">

					<Label
                        Text="{Binding PageTitle}"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

					<BoxView HeightRequest="1"
                             Color="#E2E8F0" />

					<!-- Patient -->
					<VerticalStackLayout Spacing="5">

						<Label
                            Text="Пациент"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

						<Label
                            Text="{Binding Patient.FullName}"
                            FontSize="16"
                            TextColor="#0F172A" />
					</VerticalStackLayout>

					<!-- Cycle Number -->
					<VerticalStackLayout Spacing="5">

						<Label
                            Text="Број на циклус"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

						<Entry
                            Text="{Binding CycleNumber}"
                            Keyboard="Numeric" />
					</VerticalStackLayout>

					<!-- Selected cycle -->
					<VerticalStackLayout Spacing="5">

						<Label
                            Text="Избран циклус"
                            FontAttributes="Bold"
                            TextColor="#64748B" />

						<Label
                            Text="{Binding SelectedCycle.Status}"
                            FontAttributes="Bold"
                            TextColor="#2563EB" />
					</VerticalStackLayout>

					<Button
                        Text="➕ Креирај циклус"
                        Command="{Binding CreateCycleCommand}"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        HeightRequest="45"
                        CornerRadius="10" />

					<Button
                        Text="💾 Зачувај"
                        Command="{Binding SaveCycleCommand}"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        HeightRequest="45"
                        CornerRadius="10" />

					<Button
                        Text="🗑 Избриши"
                        Command="{Binding DeleteCycleCommand}"
                        BackgroundColor="#DC2626"
                        TextColor="White"
                        HeightRequest="45"
                        CornerRadius="10" />
				</VerticalStackLayout>
			</Border>

			<!-- RIGHT SIDE -->
			<Border
                Grid.Column="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12"
                Padding="20">

				<Grid RowDefinitions="Auto,*">

					<Label
                        Text="Терапевтски циклуси"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

					<CollectionView
                        Grid.Row="1"
                        ItemsSource="{Binding Cycles}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCycle}">

						<CollectionView.ItemTemplate>

							<DataTemplate x:DataType="entities:TherapyCycle">

								<Border
                                    Margin="0,5"
                                    Padding="15"
                                    BackgroundColor="#F8FAFC"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 10">

									<Grid ColumnDefinitions="60,*,Auto">

										<!-- Number -->
										<Border
                                            BackgroundColor="#2563EB"
                                            WidthRequest="40"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 20">

											<Label
                                                Text="{Binding CycleNumber}"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center" />
										</Border>

										<!-- Patient -->
										<VerticalStackLayout
                                            Grid.Column="1"
                                            Margin="15,0"
                                            Spacing="3">

											<Label
                                                Text="{Binding Patient.FullName}"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                TextColor="#0F172A" />

											<Label
                                                Text="{Binding Status}"
                                                TextColor="#64748B" />
										</VerticalStackLayout>

										<!-- Appointments count -->
										<Border
                                            Grid.Column="2"
                                            BackgroundColor="#DBEAFE"
                                            Padding="10,5"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8">

											<Label
                                                Text="{Binding Appointments.Count, StringFormat='Термини: {0}'}"
                                                TextColor="#1D4ED8"
                                                FontAttributes="Bold" />
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>