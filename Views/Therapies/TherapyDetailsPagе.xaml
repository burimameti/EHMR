<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
	x:Class="EHMR.Views.Therapies.TherapyDetailsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Therapies"
	x:DataType="viewModels:TherapyDetailsViewModel"
	BackgroundColor="#F8FAFC">

	<Grid ColumnDefinitions="240,*">

		<!--  LEFT MENU  -->
		<Border
			Grid.Column="0"
			BackgroundColor="#0F172A"
			StrokeThickness="0">

			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  MAIN CONTENT  -->
		<Grid
			Grid.Column="1"
			Padding="20"
			ColumnDefinitions="380,*"
			ColumnSpacing="20">

			<!--  LEFT SIDE  -->
			<Border
				Padding="20"
				Grid.Row="1"
				BackgroundColor="#F3F6FA"
				Stroke="#DCE5EE"
				StrokeShape="RoundRectangle 12">

				<VerticalStackLayout Spacing="20">

					<Label
						FontAttributes="Bold"
						FontSize="22"
						Text="{Binding PageTitle}"
						TextColor="#0F172A" />

					<BoxView HeightRequest="1" Color="#E2E8F0" />

					<!--  Patient  -->
					<VerticalStackLayout Spacing="5">

						<Label
							FontAttributes="Bold"
							Text="Пациент"
							TextColor="#64748B" />

						<Label
							FontSize="16"
							Text="{Binding Patient.FullName}"
							TextColor="#0F172A" />
					</VerticalStackLayout>

					<!--  Cycle Number  -->
					<VerticalStackLayout Spacing="5">

						<Label
							FontAttributes="Bold"
							Text="Број на циклус"
							TextColor="#64748B" />

						<controls:FFInput Keyboard="Numeric" Text="{Binding TherapyCycleNumber, Mode=TwoWay}" />
					</VerticalStackLayout>

					<!--  Selected cycle  -->
					<VerticalStackLayout Spacing="5">

						<Label
							FontAttributes="Bold"
							Text="Избран циклус"
							TextColor="#64748B" />

						<Label
							FontAttributes="Bold"
							Text="{Binding SelectedCycle.Status}"
							TextColor="#2563EB" />
					</VerticalStackLayout>

					<Button
						BackgroundColor="#10B981"
						Command="{Binding CreateCycleCommand}"
						CornerRadius="10"
						HeightRequest="45"
						IsEnabled="{Binding CanCreate}"
						Text="➕ Креирај циклус"
						TextColor="White" />

					<Button
						BackgroundColor="#2563EB"
						Command="{Binding SaveCycleCommand}"
						CornerRadius="10"
						HeightRequest="45"
						IsEnabled="{Binding CanUpdate}"
						Text="Зачувај"
						TextColor="White" />

					<Button
						BackgroundColor="#DC2626"
						Command="{Binding DeleteCycleCommand}"
						IsEnabled="{Binding CanDelete}"
						CornerRadius="10"
						HeightRequest="45"
						Text="Избриши"
						TextColor="White" />
				</VerticalStackLayout>
			</Border>

			<!--  RIGHT SIDE  -->
			<Border
				Grid.Column="1"
				Padding="20"
				BackgroundColor="#F3F6FA"
				Stroke="#DCE5EE"
				StrokeShape="RoundRectangle 12">

				<Grid RowDefinitions="Auto,*">

					<Label
						FontAttributes="Bold"
						FontSize="18"
						Text="Терапевтски циклуси"
						TextColor="#0F172A" />

					<CollectionView
						Grid.Row="1"
						ItemsSource="{Binding Cycles}"
						SelectedItem="{Binding SelectedCycle}"
						SelectionMode="Single">

						<CollectionView.ItemTemplate>

							<DataTemplate x:DataType="entities:TherapyCycle">

								<Border
									Margin="0,5"
									Padding="15"
									BackgroundColor="#F8FAFC"
									Stroke="#DCE5EE"
									StrokeShape="RoundRectangle 10">

									<Grid ColumnDefinitions="60,*,Auto">

										<!--  Number  -->
										<Border
											BackgroundColor="#2563EB"
											HeightRequest="40"
											StrokeShape="RoundRectangle 20"
											WidthRequest="40">

											<Label
												FontAttributes="Bold"
												HorizontalOptions="Center"
												Text="{Binding CycleNumber}"
												TextColor="White"
												VerticalOptions="Center" />
										</Border>

										<!--  Patient  -->
										<VerticalStackLayout
											Grid.Column="1"
											Margin="15,0"
											Spacing="3">

											<Label
												FontAttributes="Bold"
												FontSize="16"
												Text="{Binding Patient.FullName}"
												TextColor="#0F172A" />

											<Label Text="{Binding Status}" TextColor="#64748B" />
										</VerticalStackLayout>

										<!--  Appointments count  -->
										<Border
											Grid.Column="2"
											Padding="10,5"
											BackgroundColor="#DBEAFE"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="0">

											<Label
												FontAttributes="Bold"
												Text="{Binding Appointments.Count, StringFormat='Термини: {0}'}"
												TextColor="#1D4ED8" />
										</Border>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>