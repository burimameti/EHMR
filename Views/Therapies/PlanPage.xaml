<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:EHMR.ViewModels"
             xmlns:entities="clr-namespace:EHMR.Domain.Entities"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="EHMR.Views.Therapies.PlanPage"
             x:DataType="viewModels:PlansViewModel"
             BackgroundColor="#F8FAFC">

	<ContentPage.Behaviors>
		<toolkit:EventToCommandBehavior
            EventName="Appearing"
            Command="{Binding LoadPlansAsyncCommand}" />
	</ContentPage.Behaviors>

	<Grid ColumnDefinitions="240,*">

		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="80, *" Padding="16" RowSpacing="20">

			<Border Grid.Row="0" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="24,0">
				<Grid ColumnDefinitions="*, Auto">
					<VerticalStackLayout VerticalOptions="Center" Spacing="2">
						<Label Text="🧬 Управување со планови" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
						<Label Text="Преглед, следење, измена на процеси или планови." FontSize="13" TextColor="#64748B" />
					</VerticalStackLayout>

					<Button Grid.Column="1"
                            Text="➕ НОВА"
                            Command="{Binding CreateNewPlanCommand}"
                            HeightRequest="46"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Padding="20,0" />
				</Grid>
			</Border>

			<Border Grid.Row="1" BackgroundColor="White" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12" Padding="16">
				<Grid RowDefinitions="Auto, *">

					<Grid Grid.Row="0" ColumnDefinitions="2*, 1.5*, *, *, 180" Padding="12,8" BackgroundColor="#F1F5F9" Margin="0,0,0,8">
						<Label Grid.Column="0" Text="Протокол / План" FontAttributes="Bold" TextColor="#475569" FontSize="12" />
						<Label Grid.Column="1" Text="Пациент" FontAttributes="Bold" TextColor="#475569" FontSize="12" />
						<Label Grid.Column="2" Text="Почеток" FontAttributes="Bold" TextColor="#475569" FontSize="12" />
						<Label Grid.Column="3" Text="Статус" FontAttributes="Bold" TextColor="#475569" FontSize="12" />
						<Label Grid.Column="4" Text="Акции" FontAttributes="Bold" TextColor="#475569" FontSize="12" HorizontalOptions="Center" />
					</Grid>

					<ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" Color="#2563EB" />

					<VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10"
                                         IsVisible="{Binding AllRegisteredPlans.Count, Converter={StaticResource EmptyCollectionToVisibleConverter}}">
						<Label Text="🔍 Нема пронајдено активни планови во базата." FontSize="16" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center" />
						<Label Text="Кликнете на копчето горе за да креирате нов третман од нула." FontSize="13" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
					</VerticalStackLayout>

					<CollectionView Grid.Row="1" ItemsSource="{Binding AllRegisteredPlans}" IsVisible="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="entities:TreatmentPlan">
								<Border Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12,10" Margin="0,4" BackgroundColor="White">
									<Grid ColumnDefinitions="2*, 1.5*, *, *, 180">

										<HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
											<Label Text="📄" FontSize="16" VerticalOptions="Center" />
											<Label Text="{Binding ProtocolName}" FontAttributes="Bold" FontSize="14" TextColor="#0F172A" VerticalOptions="Center" LineBreakMode="TailTruncation" />
										</HorizontalStackLayout>

										<HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
											<Label Text="{Binding Patient.FirstName}" TextColor="#334155" FontSize="13" LineBreakMode="TailTruncation" />
											<Label Text="{Binding Patient.LastName, FallbackValue='Глобален Протокол'}" TextColor="#334155" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
										</HorizontalStackLayout>

										<Label Grid.Column="2" Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}" TextColor="#475569" FontSize="13" VerticalOptions="Center" />

										<Border Grid.Column="3" BackgroundColor="#E0F2FE" HorizontalOptions="Start" Padding="8,4" StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Center">
											<Label Text="{Binding Status}" TextColor="#0369A1" FontSize="11" FontAttributes="Bold" />
										</Border>

										<HorizontalStackLayout Grid.Column="4" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
											<Button Text="✏️"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditPlanCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#F1F5F9" TextColor="#1E293B" WidthRequest="40" HeightRequest="36" Padding="0" />

											<Button Text="🗑️"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePlanCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2" TextColor="#DC2626" WidthRequest="40" HeightRequest="36" Padding="0" />
										</HorizontalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>