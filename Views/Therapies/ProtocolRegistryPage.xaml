<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Therapies.ProtocolRegistryPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:DataType="viewModels:ProtocolRegistryViewModel"
	BackgroundColor="#F8FAFC">

	<ContentPage.Behaviors>
		<toolkit:EventToCommandBehavior Command="{Binding LoadCommand}" EventName="Appearing" />
	</ContentPage.Behaviors>

	<Grid ColumnDefinitions="240,*">

		<Border
			Grid.Column="0"
			BackgroundColor="#0F172A"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="72,*">

			<Border
				Grid.Row="0"
				BackgroundColor="White"
				Stroke="#E2E8F0"
				StrokeThickness="1">
				<Grid Padding="24,0" ColumnDefinitions="*,Auto">
					<VerticalStackLayout Spacing="2" VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="22"
							Text="Медицински Протоколи"
							TextColor="#0F172A" />
						<Label
							FontSize="13"
							Text="Централен регистар на Протоколи за третмани и терапии"
							TextColor="#64748B" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="1"
						Spacing="12"
						VerticalOptions="Center">
						<Border
							Padding="12,8"
							BackgroundColor="#F1F5F9"
							StrokeShape="RoundRectangle 10"
							StrokeThickness="0">
							<HorizontalStackLayout Spacing="8">
								<Label
									FontSize="12"
									Text="👤"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="{Binding UserName}"
									TextColor="#334155"
									VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Border>
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<Grid
				Grid.Row="1"
				Padding="16"
				RowDefinitions="Auto,16,*">

				<Border
					Grid.Row="0"
					Padding="16"
					BackgroundColor="White"
					Stroke="#E2E8F0"
					StrokeShape="RoundRectangle 16"
					StrokeThickness="1">
					<Grid ColumnDefinitions="*,260,Auto,Auto,Auto" ColumnSpacing="10">

						<VerticalStackLayout Spacing="5">
							<Label
								Margin="2,0,0,0"
								CharacterSpacing="0.5"
								FontAttributes="Bold"
								FontSize="10"
								Text="ПРЕБАРУВАЊЕ"
								TextColor="#475569" />
							<Border
								BackgroundColor="#FFFFFF"
								HeightRequest="40"
								Stroke="#CBD5E1"
								StrokeShape="RoundRectangle 10"
								StrokeThickness="1">
								<Grid ColumnDefinitions="34,*">
									<Label
										Margin="12,0,0,0"
										FontSize="16"
										Text="⌕"
										TextColor="#64748B"
										VerticalOptions="Center" />
									<SearchBar
										Grid.Column="1"
										Margin="-6,-8,8,-8"
										BackgroundColor="Transparent"
										FontSize="12"
										Placeholder="Пребарај протокол по име или опис..."
										PlaceholderColor="#94A3B8"
										Text="{Binding SearchText, Mode=TwoWay}"
										TextColor="#0F172A" />
								</Grid>
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="1" Spacing="5">
							<Label
								Margin="2,0,0,0"
								CharacterSpacing="0.5"
								FontAttributes="Bold"
								FontSize="10"
								Text="МЕДИЦИНСКА КАТЕГОРИЈА"
								TextColor="#475569" />
							<Border
								BackgroundColor="#FFFFFF"
								HeightRequest="40"
								Stroke="#CBD5E1"
								StrokeShape="RoundRectangle 10"
								StrokeThickness="1">
								<Picker
									Title="Сите категории"
									Margin="10,0"
									FontSize="12"
									HorizontalOptions="Fill"
									ItemsSource="{Binding CategoryFilters}"
									SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
									TextColor="#0F172A"
									VerticalOptions="Center" />
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout
							Grid.Column="2"
							Spacing="5"
							VerticalOptions="End">
							<Button
								BackgroundColor="#FFFFFF"
								BorderColor="#CBD5E1"
								BorderWidth="1"
								Command="{Binding RefreshCommand}"
								CornerRadius="10"
								HeightRequest="40"
								Text="↻"
								TextColor="#475569"
								WidthRequest="40" />
						</VerticalStackLayout>

						<VerticalStackLayout
							Grid.Column="3"
							Spacing="5"
							VerticalOptions="End">
							<Button
								Padding="16,0"
								BackgroundColor="#F1F5F9"
								Command="{Binding ClearFiltersCommand}"
								CornerRadius="10"
								FontAttributes="Bold"
								FontSize="12"
								HeightRequest="40"
								Text="Исчисти"
								TextColor="#475569" />
						</VerticalStackLayout>

						<VerticalStackLayout
							Grid.Column="4"
							Spacing="5"
							VerticalOptions="End">
							<Button
								Padding="16,0"
								BackgroundColor="#10B981"
								Command="{Binding AddCommand}"
								CornerRadius="10"
								FontAttributes="Bold"
								FontSize="12"
								HeightRequest="40"
								Text="＋ Нов Протокол"
								TextColor="White" />
						</VerticalStackLayout>
					</Grid>
				</Border>

				<Border
					Grid.Row="2"
					BackgroundColor="White"
					Stroke="#E2E8F0"
					StrokeShape="RoundRectangle 16"
					StrokeThickness="1">
					<controls:FFDataGrid
						x:Name="PatientGrid"
						Grid.Row="1"
						CurrentPage="{Binding CurrentPage}"
						EmptyMessage="Пробај да ги промениш филтрите..."
						EmptyTitle="Нема пронајдени пациенти"
						IsLoading="{Binding IsBusy}"
						ItemsSource="{Binding FilteredPatients}"
						NextPageCommand="{Binding NextPageCommand}"
						PagedItems="{Binding PagedPatients}"
						PrevPageCommand="{Binding PreviousPageCommand}"
						RowCommand="{Binding SelectCommand}"
						TotalPages="{Binding TotalPagesCount}"
						Variant="CoolBlueLight">

						<!--  ═════ HEADER ═════  -->
						<controls:FFDataGrid.HeaderContent>
							<Grid
								Padding="16,0"
								ColumnDefinitions="50, 2.5*, 2*, 3*, 1.5*, 1.5*, 140"
								ColumnSpacing="12"
								HeightRequest="28"
								VerticalOptions="Center">

								<CheckBox
									HorizontalOptions="Center"
									Scale="0.75"
									VerticalOptions="Center"
									Color="{Binding AccentBrush, Source={x:Reference ProtocolGrid}}" />

								<Label
									Grid.Column="1"
									FontAttributes="Bold"
									FontSize="11"
									Text="НАЗИВ НА ПРОТОКОЛ"
									TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

								<Label
									Grid.Column="2"
									FontAttributes="Bold"
									FontSize="11"
									Text="КАТЕГОРИЈА"
									TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

								<Label
									Grid.Column="3"
									FontAttributes="Bold"
									FontSize="11"
									Text="КРАТОК ОПИС"
									TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

								<Label
									Grid.Column="4"
									FontAttributes="Bold"
									FontSize="11"
									Text="КРЕИРАНО ОД"
									TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

								<Label
									Grid.Column="5"
									FontAttributes="Bold"
									FontSize="11"
									Text="ДАТУМ"
									TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

								<Label
									Grid.Column="6"
									FontAttributes="Bold"
									FontSize="11"
									HorizontalTextAlignment="Center"
									Text="АКЦИИ"
									TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />
							</Grid>
						</controls:FFDataGrid.HeaderContent>

						<!--  ═════ ROW TEMPLATE ═════  -->
						<controls:FFDataGrid.RowTemplate>
							<DataTemplate x:DataType="entities:TherapyProtocol">
								<Grid RowDefinitions="64,1">

									<Grid
										Padding="16,0"
										BackgroundColor="{Binding RowBackground, Source={x:Reference ProtocolGrid}}"
										ColumnDefinitions="50, 2.5*, 2*, 3*, 1.5*, 1.5*, 140"
										ColumnSpacing="12"
										HeightRequest="64">

										<CheckBox
											HorizontalOptions="Center"
											Scale="0.75"
											VerticalOptions="Center"
											Color="{Binding AccentBrush, Source={x:Reference ProtocolGrid}}" />

										<!--  name  -->
										<HorizontalStackLayout
											Grid.Column="1"
											Spacing="10"
											VerticalOptions="Center">
											<Border
												Background="{Binding AlternateRowBackground, Source={x:Reference ProtocolGrid}}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontSize="14"
													HorizontalOptions="Center"
													Text="📄"
													TextColor="{Binding AccentBrush, Source={x:Reference ProtocolGrid}}"
													VerticalOptions="Center" />
											</Border>

											<VerticalStackLayout>
												<Label
													FontAttributes="Bold"
													FontSize="13"
													Text="{Binding Name}"
													TextColor="{Binding PrimaryTextColor, Source={x:Reference ProtocolGrid}}" />
												<Label
													FontSize="11"
													Text="Медицински шаблон"
													TextColor="{Binding MutedTextColor, Source={x:Reference ProtocolGrid}}" />
											</VerticalStackLayout>
										</HorizontalStackLayout>

										<!--  category — semantic blue badge, kept fixed  -->
										<Border
											Grid.Column="2"
											Padding="8,4"
											BackgroundColor="#EFF6FF"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="0">
											<HorizontalStackLayout Spacing="5">
												<BoxView
													CornerRadius="3"
													HeightRequest="6"
													WidthRequest="6"
													Color="#1E40AF" />
												<Label
													FontAttributes="Bold"
													FontSize="11"
													Text="{Binding DiseaseCategory}"
													TextColor="#1E40AF" />
											</HorizontalStackLayout>
										</Border>

										<!--  description  -->
										<Label
											Grid.Column="3"
											FontSize="13"
											LineBreakMode="TailTruncation"
											Text="{Binding Description}"
											TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

										<!--  doctor  -->
										<Label
											Grid.Column="4"
											FontSize="13"
											Text="{Binding CreatedByDoctor}"
											TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

										<!--  date  -->
										<Label
											Grid.Column="5"
											FontSize="13"
											Text="{Binding CreatedAt, StringFormat='{0:dd.MM.yyyy}'}"
											TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}" />

										<!--  actions — view/edit neutral, delete stays semantic red  -->
										<HorizontalStackLayout
											Grid.Column="6"
											HorizontalOptions="Center"
											Spacing="6">

											<Button
												BackgroundColor="{Binding AlternateRowBackground, Source={x:Reference ProtocolGrid}}"
												Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}"
												CommandParameter="{Binding .}"
												CornerRadius="8"
												HeightRequest="32"
												Text="👁"
												TextColor="{Binding SecondaryTextColor, Source={x:Reference ProtocolGrid}}"
												WidthRequest="32" />

											<Button
												BackgroundColor="{Binding AlternateRowBackground, Source={x:Reference ProtocolGrid}}"
												Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
												CommandParameter="{Binding .}"
												CornerRadius="8"
												HeightRequest="32"
												Text="✎"
												TextColor="{Binding AccentBrush, Source={x:Reference ProtocolGrid}}"
												WidthRequest="32" />

											<Button
												BackgroundColor="#FEF2F2"
												Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
												CommandParameter="{Binding .}"
												CornerRadius="8"
												HeightRequest="32"
												Text="✕"
												TextColor="#DC2626"
												WidthRequest="32" />
										</HorizontalStackLayout>
									</Grid>

									<BoxView
										Grid.Row="1"
										HeightRequest="1"
										Color="{Binding DividerBrush, Source={x:Reference ProtocolGrid}}" />
								</Grid>
							</DataTemplate>
						</controls:FFDataGrid.RowTemplate>

						<!--  ═════ FOOTER (custom pagination) ═════  -->
						<!--<controls:FFDataGrid.FooterContent>
							<Grid Padding="20,0" ColumnDefinitions="*,Auto"
                  BackgroundColor="{Binding FooterBackground, Source={x:Reference ProtocolGrid}}">

