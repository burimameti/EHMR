<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Therapies.TherapyCyclesPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Extensions"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Therapies"
	x:Name="PageRoot"
	x:DataType="viewModels:TherapyCycleListViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid
			Grid.Column="1"
            Margin="12,0,12,12"
			RowDefinitions="Auto,*"
			RowSpacing="8">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Циклуси на терапии"
						Grid.Column="0"
						Subtitle="Преглед, пребарување и управување со тераписки циклуси" />

					<controls:FFButton
						Grid.Column="1"
						ButtonKind="Primary"
						Command="{Binding NewCommand}"
						ContentPadding="20,0"
						HeightRequestEx="45"
						IsVisible="{Binding CanCreate}"
						Text="Нов Циклус" />
				</Grid>
			</Border>

			<!--  MAIN CONTENT / SPLIT VIEW  -->
			<ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
				<VerticalStackLayout Spacing="8">

					<!--  MAIN DATA & EDIT GRID CARD  -->
					<Border Style="{StaticResource PageHeaderCardStyle}">
						<Grid ColumnSpacing="16" RowSpacing="16">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>

							<!--  SEARCH & FILTERS  -->
							<controls:SparkExplorerHeaderView
								Grid.Row="0"
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchCommand="{Binding SearchCommand}"
								SearchPlaceholder="Пребарај по име или презиме..."
								SearchText="{Binding SearchText}"
								Tabs="{Binding Tabs}" />

							<!--  SPLIT CONTENT: LEFT GRID | RIGHT EDIT PANEL  -->
							<Grid
								Grid.Row="1"
								ColumnDefinitions="*,400"
								ColumnSpacing="16">

								<!--  LEFT — CYCLES GRID  -->
								<Border Grid.Column="0" Padding="0">
									<controls:SparkDataGridView
										x:Name="TherapyGrid"
										Columns="{Binding GridColumns}"
										CurrentPage="{Binding CurrentPage}"
										EditRowCommand="{Binding EditCycleCommand}"
										NextPageCommand="{Binding NextPageCommand}"
										PageChangedCommand="{Binding PageChangedCommand}"
										PreviousPageCommand="{Binding PreviousPageCommand}"
										RowTappedCommand="{Binding SelectCycleCommand}"
										Rows="{Binding GridRows}"
										ShowPagination="True"
										ShowRowNumbers="True"
										TotalPages="{Binding TotalPages}" />
								</Border>

								<!--  RIGHT — EDIT PANEL  -->
								<Grid Grid.Column="1">

									<!--  EDIT FORM  -->
									<Border
										Padding="0"
										BackgroundColor="{StaticResource SparkSurface}"
										IsVisible="{Binding IsCycleSelected}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeThickness="1">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="12" />
										</Border.StrokeShape>

										<Grid RowDefinitions="Auto,*,Auto">

											<!--  Panel Title Bar  -->
											<Border
												Grid.Row="0"
												Padding="16,12"
												BackgroundColor="{StaticResource SparkPageBackground}"
												StrokeThickness="0">
												<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														HeightRequest="32"
														StrokeThickness="0"
														WidthRequest="32">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="8" />
														</Border.StrokeShape>
														<Label
															FontFamily="FASolid"
															FontSize="12"
															HorizontalOptions="Center"
															Text="&#xf044;"
															TextColor="{StaticResource SparkAccentTeal}"
															VerticalOptions="Center" />
													</Border>
													<VerticalStackLayout Spacing="1" VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="Уреди Тераписки Циклус"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="11"
															Text="Ажурирајте ги медицинските параметри"
															TextColor="{StaticResource SparkTextMuted}" />
													</VerticalStackLayout>
												</HorizontalStackLayout>
											</Border>

											<!--  Form Fields  -->
											<ScrollView Grid.Row="1" Padding="16">
												<VerticalStackLayout Spacing="14">

													<!--  Patient Read-Only Display  -->
													<VerticalStackLayout Spacing="4">
														<Label
															FontSize="11"
															Style="{StaticResource DashboardCardCountLabel}"
															Text="ПАЦИЕНТ" />
														<Border
															Padding="12,0"
															BackgroundColor="{StaticResource SparkPageBackground}"
															HeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="8" />
															</Border.StrokeShape>
															<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
																<Label
																	FontFamily="FASolid"
																	FontSize="11"
																	Text="&#xf007;"
																	TextColor="{StaticResource SparkTextMuted}"
																	VerticalOptions="Center" />
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	Text="{Binding SelectedCycle.Patient.FullName}"
																	TextColor="{StaticResource SparkTextPrimary}"
																	VerticalOptions="Center" />
															</HorizontalStackLayout>
														</Border>
													</VerticalStackLayout>

													<!--  Cycle Number  -->
													<VerticalStackLayout Spacing="4">
														<Label
															FontSize="11"
															Style="{StaticResource DashboardCardCountLabel}"
															Text="РЕДЕН БРОЈ НА ЦИКЛУС *" />
														<Border
															Padding="10,0"
															BackgroundColor="{StaticResource SparkSurface}"
															HeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="8" />
															</Border.StrokeShape>
															<Entry
																FontSize="13"
																Keyboard="Numeric"
																Text="{Binding EditCycleNumber, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
													</VerticalStackLayout>

													<!--  Status Picker  -->
													<VerticalStackLayout Spacing="4">
														<Label
															FontSize="11"
															Style="{StaticResource DashboardCardCountLabel}"
															Text="СТАТУС НА ЦИКЛУС *" />
														<Border
															Padding="10,0"
															BackgroundColor="{StaticResource SparkSurface}"
															HeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="8" />
															</Border.StrokeShape>
															<Picker
																FontSize="13"
																ItemsSource="{Binding StatusOptions}"
																SelectedItem="{Binding EditStatus, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
													</VerticalStackLayout>

													<!--  StartDate / EndDate  -->
													<Grid ColumnDefinitions="*,24,*" ColumnSpacing="0">
														<VerticalStackLayout Grid.Column="0" Spacing="4">
															<Label
																FontSize="11"
																Style="{StaticResource DashboardCardCountLabel}"
																Text="ПОЧЕТОК *" />
															<Border
																Padding="8,0"
																BackgroundColor="{StaticResource SparkSurface}"
																HeightRequest="42"
																Stroke="{StaticResource SparkBorderSubtle}"
																StrokeThickness="1">
																<Border.StrokeShape>
																	<RoundRectangle CornerRadius="8" />
																</Border.StrokeShape>
																<DatePicker
																	BackgroundColor="Transparent"
																	Date="{Binding EditStartDate, Mode=TwoWay}"
																	FontSize="12"
																	Format="dd.MM.yyyy"
																	TextColor="{StaticResource SparkTextPrimary}"
																	VerticalOptions="Center" />
															</Border>
														</VerticalStackLayout>

														<Label
															Grid.Column="1"
															Margin="0,0,0,10"
															FontFamily="FASolid"
															FontSize="12"
															HorizontalOptions="Center"
															Text="&#xf178;"
															TextColor="{StaticResource SparkTextMuted}"
															VerticalOptions="End" />

														<VerticalStackLayout Grid.Column="2" Spacing="4">
															<Label
																FontSize="11"
																Style="{StaticResource DashboardCardCountLabel}"
																Text="КРАЈ" />
															<Border
																Padding="8,0"
																BackgroundColor="{StaticResource SparkSurface}"
																HeightRequest="42"
																Stroke="{StaticResource SparkBorderSubtle}"
																StrokeThickness="1">
																<Border.StrokeShape>
																	<RoundRectangle CornerRadius="8" />
																</Border.StrokeShape>
																<DatePicker
																	BackgroundColor="Transparent"
																	Date="{Binding EditEndDate, Mode=TwoWay}"
																	FontSize="12"
																	Format="dd.MM.yyyy"
																	TextColor="{StaticResource SparkTextPrimary}"
																	VerticalOptions="Center" />
															</Border>
														</VerticalStackLayout>
													</Grid>

													<!--  Notes  -->
													<VerticalStackLayout Spacing="4">
														<Label
															FontSize="11"
															Style="{StaticResource DashboardCardCountLabel}"
															Text="КЛИНИЧКА БЕЛЕШКА" />
														<Border
															Padding="8"
															BackgroundColor="{StaticResource SparkSurface}"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Border.StrokeShape>
																<RoundRectangle CornerRadius="8" />
															</Border.StrokeShape>
															<Editor
																BackgroundColor="Transparent"
																FontSize="12"
																HeightRequest="90"
																Placeholder="Внесете клиничка белешка за овој циклус..."
																Text="{Binding EditNotes, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</Border>
													</VerticalStackLayout>

													<!--  Appointments Count Info  -->
													<Border
														Padding="12,10"
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														StrokeThickness="0">
														<Border.StrokeShape>
															<RoundRectangle CornerRadius="8" />
														</Border.StrokeShape>
														<HorizontalStackLayout Spacing="10">
															<Label
																FontFamily="FASolid"
																FontSize="13"
																Text="&#xf274;"
																TextColor="{StaticResource SparkAccentTeal}"
																VerticalOptions="Center" />
															<VerticalStackLayout Spacing="1" VerticalOptions="Center">
																<Label
																	FontAttributes="Bold"
																	FontSize="12"
																	TextColor="{StaticResource SparkAccentTeal}">
																	<Label.FormattedText>
																		<FormattedString>
																			<Span Text="{Binding SelectedCycle.Appointments.Count}" />
																			<Span Text=" закажани прегледи" />
																		</FormattedString>
																	</Label.FormattedText>
																</Label>
																<Label
																	FontSize="10"
																	Text="Поврзани со овој тераписки циклус"
																	TextColor="{StaticResource SparkTextSecondary}" />
															</VerticalStackLayout>
														</HorizontalStackLayout>
													</Border>

												</VerticalStackLayout>
											</ScrollView>

											<!--  Form Action Footer  -->
											<Border
												Grid.Row="2"
												Padding="16,12"
												BackgroundColor="{StaticResource SparkPageBackground}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeThickness="1">
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
													<Label
														FontSize="11"
														Text="* Задолжителни полиња"
														TextColor="{StaticResource SparkTextMuted}"
														VerticalOptions="Center" />

													<controls:FFButton
														Grid.Column="1"
														ButtonKind="Primary"
														Command="{Binding SaveCycleChangesCommand}"
														ContentPadding="16,0"
														HeightRequestEx="38"
														Text="Зачувај" />
												</Grid>
											</Border>
										</Grid>
									</Border>

									<!--  EMPTY STATE  -->
									<Border
										BackgroundColor="{StaticResource SparkSurface}"
										IsVisible="{Binding IsCycleSelected, Converter={StaticResource InvertedBoolConverter}}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeThickness="1">
										<Border.StrokeShape>
											<RoundRectangle CornerRadius="12" />
										</Border.StrokeShape>
										<VerticalStackLayout
											Padding="24"
											HorizontalOptions="Center"
											Spacing="12"
											VerticalOptions="Center">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="60"
												HorizontalOptions="Center"
												StrokeThickness="0"
												WidthRequest="60">
												<Border.StrokeShape>
													<RoundRectangle CornerRadius="30" />
												</Border.StrokeShape>
												<Label
													FontFamily="FASolid"
													FontSize="24"
													HorizontalOptions="Center"
													Text="&#xf11c;"
													TextColor="{StaticResource SparkAccentTeal}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout HorizontalOptions="Center" Spacing="4">
												<Label
													FontAttributes="Bold"
													FontSize="14"
													HorizontalTextAlignment="Center"
													Text="Не е избран циклус"
													TextColor="{StaticResource SparkTextPrimary}" />
												<Label
													FontSize="12"
													HorizontalTextAlignment="Center"
													MaximumWidthRequest="240"
													Text="Изберете ред од табелата за ажурирање на параметрите."
													TextColor="{StaticResource SparkTextMuted}" />
											</VerticalStackLayout>
										</VerticalStackLayout>
									</Border>

								</Grid>
							</Grid>

						</Grid>
					</Border>

				</VerticalStackLayout>
			</ScrollView>

		</Grid>

		<!--  LOADING OVERLAY  -->
		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>

	</Grid>
</ContentPage>