<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.Therapies.TherapyCyclesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:EHMR.Extensions"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels"
    xmlns:entities="clr-namespace:EHMR.Domain.Entities"
    Style="{StaticResource PageBackgroundStyle}">
	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="295,*">
		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid Grid.Column="1" RowDefinitions="72,*">

			<Border Grid.Row="0" Style="{StaticResource PageHeaderContainer}">
				<Grid ColumnDefinitions="*,Auto">
					<VerticalStackLayout Spacing="{StaticResource SpaceXs}" VerticalOptions="Center">
						<Label Text="Тераписки Циклуси" Style="{StaticResource PageHeaderTitle}" />
						<Label Text="Следење, модификација и ескалација на активни онколошки протоколи" Style="{StaticResource PageHeaderSubtitle}" />
					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" VerticalOptions="Center">
						<Border Padding="12,8" BackgroundColor="{StaticResource SurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
							<HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
								<Label Text="&#xf0f1;" FontFamily="FASolid" FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
								<Label Text="{Binding UserName}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Border>
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<Grid Grid.Row="1" Padding="{StaticResource SpaceLg}" RowDefinitions="Auto,16,*">

				<Border Grid.Row="0" Style="{StaticResource ToolbarContainer}">
					<Grid ColumnDefinitions="*,240,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">

						<VerticalStackLayout Spacing="5">
							<Label Text="ПРЕБАРУВАЊЕ ПАЦИЕНТ" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}">
								<Grid ColumnDefinitions="Auto,*">
									<Label Text="&#xf002;" FontFamily="FASolid" FontSize="14" Margin="4,0,8,0" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
									<Entry Grid.Column="1" Style="{StaticResource InputEntry}" Placeholder="Пребарај по име или презиме на пациент..." PlaceholderColor="{StaticResource TextMuted}" Text="{Binding SearchPatientText, Mode=TwoWay}" VerticalOptions="Center" />
								</Grid>
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="1"
                     Spacing="5">

							<Label Text="ФИЛТЕР ПО СТАТУС"
           Style="{StaticResource InputLabel}" />

							<Border Style="{StaticResource InputBorderStyle}">

								<Picker 
            Margin="0"
            BackgroundColor="{StaticResource White}"
            TextColor="Black"
            TitleColor="Gray"
            VerticalOptions="Center"
            HorizontalOptions="Fill"
            ItemsSource="{Binding StatusOptions}"
            SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
            Title="" />

							</Border>

						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="2" VerticalOptions="End">
							<Button Text="Исчисти" Padding="16,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ClearFilterCommand}" />
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="3" VerticalOptions="End">
							<Button Text="＋ Нов План" Padding="16,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding LoadDataCommand}" />
						</VerticalStackLayout>
					</Grid>
				</Border>

				<Grid Grid.Row="2" ColumnDefinitions="*, 400" ColumnSpacing="20">

					<Border Grid.Column="0" Style="{StaticResource ElevatedCard}" Padding="0">
						<Grid RowDefinitions="48,*,60">

							<Border Grid.Row="0" Style="{StaticResource PageHeader}">
								<Grid Padding="16,0" ColumnDefinitions="2.5*, 2.5*, 1*, 2*, 1.5*, 60" ColumnSpacing="12" VerticalOptions="Center">
									<Label Grid.Column="0" Text="ПАЦИЕНТ" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
									<Label Grid.Column="1" Text="ПРОТОКОЛ / РЕЖИМ" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
									<Label Grid.Column="2" Text="ЦИКЛУС" Style="{StaticResource GridHeaderTextStyle}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
									<Label Grid.Column="3" Text="ПЛАНИРАН ПОЧЕТОК" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
									<Label Grid.Column="4" Text="СТАТУС" Style="{StaticResource GridHeaderTextStyle}" VerticalOptions="Center" />
									<Label Grid.Column="5" Text="АКЦИЈА" Style="{StaticResource GridHeaderTextStyle}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
								</Grid>
							</Border>

							<CollectionView Grid.Row="1" ItemsSource="{Binding FilteredCycles}" SelectedItem="{Binding SelectedCycle, Mode=TwoWay}" SelectionMode="Single">
								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="entities:TherapyCycle">
										<Border Style="{StaticResource GridRowStyle}">
											<Grid Padding="6,2" ColumnDefinitions="2.5*, 2.5*, 1*, 2*, 1.5*, 60" ColumnSpacing="12" VerticalOptions="Center">

												<HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
													<Border WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource PrimaryLight}" StrokeThickness="0" StrokeShape="RoundRectangle 16">
														<Label Text="&#xf007;" FontFamily="FASolid" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{StaticResource Primary}" />
													</Border>
													<Label Text="{Binding TherapySchedule.TreatmentPlan.Patient.FullName}" Style="{StaticResource Body}" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" />
												</HorizontalStackLayout>

												<Label Grid.Column="1" Text="{Binding TherapySchedule.TreatmentPlan.ProtocolName}" Style="{StaticResource Body}" VerticalOptions="Center" LineBreakMode="TailTruncation" />

												<Label Grid.Column="2" Text="{Binding CycleNumber, StringFormat='№ {0}'}" Style="{StaticResource Body}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />

												<Label Grid.Column="3" Text="{Binding PlannedStartDate, StringFormat='{0:dd.MM.yyyy}'}" Style="{StaticResource Body}" VerticalOptions="Center" />

												<Border Grid.Column="4" Style="{StaticResource SuccessPillStyle}" Padding="8,4" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center" StrokeShape="RoundRectangle 6">
													<HorizontalStackLayout Spacing="5">
														<BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource Success}" VerticalOptions="Center" />
														<Label Text="{Binding Status}" Style="{StaticResource SuccessChipText}" VerticalOptions="Center" />
													</HorizontalStackLayout>
												</Border>

												<Label Grid.Column="5" Text="Види &#xf105;" FontFamily="FASolid" FontSize="16" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" VerticalOptions="Center" />
											</Grid>
										</Border>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>

							<Border Grid.Row="2" BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource Border}" StrokeThickness="1">
								<Grid Padding="20,0" HeightRequest="60" ColumnDefinitions="*,Auto">
									<Label Text="Прикажани се активни онколошки циклуси" Style="{StaticResource MutedText}" VerticalOptions="Center" />

									<HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
										<Button Text="Претходна" Style="{StaticResource ToolbarButton}" />
										<Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="0.5" StrokeShape="RoundRectangle 8" HeightRequest="36" Padding="12,0">
											<HorizontalStackLayout Spacing="4" VerticalOptions="Center">
												<Label Text="Страна" Style="{StaticResource MutedText}" />
												<Label Text="1" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
												<Label Text="од" Style="{StaticResource MutedText}" />
												<Label Text="1" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
											</HorizontalStackLayout>
										</Border>
										<Button Text="Следна" Style="{StaticResource ActiveTabButtonStyle}" Padding="12,0" HeightRequest="36" />
									</HorizontalStackLayout>
								</Grid>
							</Border>
						</Grid>
					</Border>

					<Grid Grid.Column="1" RowDefinitions="*">

						<Border BackgroundColor="{StaticResource Surface}" Style="{StaticResource ElevatedCard}" Padding="20" IsVisible="{Binding IsCycleSelected}">
							<ScrollView>
								<VerticalStackLayout Spacing="18">
									<HorizontalStackLayout Spacing="8" Margin="0,0,0,4">
										<Label Text="&#xf044;" FontFamily="FASolid" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
										<Label Text="Уреди Тераписки Циклус" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
									</HorizontalStackLayout>

									<VerticalStackLayout Spacing="5">
										<Label Text="ПАЦИЕНТ" Style="{StaticResource InputLabel}" />
										<Border HeightRequest="46" BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="12,0">
											<Label Text="{Binding SelectedCycle.TherapySchedule.TreatmentPlan.Patient.FullName}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Spacing="5">
										<Label Text="РЕДЕН БРОЈ НА ЦИКЛУС *" Style="{StaticResource InputLabel}" />
										<Border Style="{StaticResource InputBorderStyle}">
											<Entry Text="{Binding EditCycleNumber, Mode=TwoWay}" Keyboard="Numeric" Style="{StaticResource InputEntry}" VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Spacing="5">
										<Label Text="СТАТУС НА ЦИКЛУС *" Style="{StaticResource InputLabel}" />
										<Border Style="{StaticResource InputBorderStyle}">
											<Picker Style="{StaticResource InputPicker}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding EditStatus, Mode=TwoWay}" VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Spacing="5">
										<Label Text="ПЛАНИРАН ПОЧЕТОК *" Style="{StaticResource InputLabel}" />
										<Border Style="{StaticResource InputBorderStyle}">
											<DatePicker Date="{Binding EditPlannedStartDate, Mode=TwoWay}" Format="dd.MM.yyyy" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" FontSize="13" VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Spacing="5">
										<Label Text="ПЛАНИРАН КРАЈ *" Style="{StaticResource InputLabel}" />
										<Border Style="{StaticResource InputBorderStyle}">
											<DatePicker Date="{Binding EditPlannedEndDate, Mode=TwoWay}" Format="dd.MM.yyyy" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" FontSize="13" VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Spacing="5">
										<Label Text="КЛИНИЧКА БЕЛЕШКА / ПРИЧИНА" Style="{StaticResource InputLabel}" />
										<Border BackgroundColor="{StaticResource Surface}" Stroke="{StaticResource BorderStrong}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="8">
											<Editor Text="{Binding EditReasonForMissing, Mode=TwoWay}" Placeholder="Внесете забелешка доколку циклусот е пропуштен или одложен..." HeightRequest="80" FontSize="12" TextColor="{StaticResource TextPrimary}" BackgroundColor="Transparent" />
										</Border>
									</VerticalStackLayout>

									<Button Text="💾 Зачувај Измени" Style="{StaticResource PrimaryButtonStyle}" BackgroundColor="#10B981" Command="{Binding SaveCycleChangesCommand}" Margin="0,8,0,0" />
								</VerticalStackLayout>
							</ScrollView>
						</Border>

						<Border BackgroundColor="{StaticResource SurfaceAlt}" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                                IsVisible="{Binding IsCycleSelected, Converter={StaticResource InvertedBoolConverter}}" Padding="16">
							<VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
								<Label Text="&#xf11c;" FontFamily="FASolid" FontSize="32" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
								<Label Text="Не е избран циклус" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
								<Label Text="Селектирајте тераписки ред од левата табела за да ги ажурирате медицинските параметри."
                                       TextColor="{StaticResource TextMuted}" HorizontalTextAlignment="Center" FontSize="12" />
							</VerticalStackLayout>
						</Border>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>