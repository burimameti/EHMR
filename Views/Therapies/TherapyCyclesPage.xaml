<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Therapies.TherapyCyclesPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Extensions"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Therapies"
	x:Name="PageRoot"
	x:DataType="viewModels:TherapyCycleListViewModel">

	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ================= LEFT MENU =================  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ================= MAIN =================  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="16">

			<!--  HEADER  -->
			<Border
				Grid.Row="0"
				Padding="20"
				StrokeShape="RoundRectangle 0"
				Style="{StaticResource SurfaceCard}">
				<Grid ColumnDefinitions="*,Auto">
					<controls:FFPageHeader Title="Циклуси на терапи" Subtitle="Следење, на циклуси" />
					<Button
						Grid.Column="1"
						BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
						Command="{Binding NewCycleCommand}"
						HeightRequest="45"
						IsVisible="{Binding CanCreate}"
						Style="{StaticResource TabButtonActiveStyle}"
						Text="Нов Циклус"
						WidthRequest="160" />
				</Grid>
			</Border>

			<!--  SEARCH / FILTER  -->
			<Border
				Grid.Row="1"
				Margin="0,8,0,8"
				Padding="0">
				<!--
					Mirrors PatientListPage's toolbar exactly.
					Buttons/Pickers/Tabs are the same generic collections
					SparkExplorerHeaderView expects on the Patient page —
					TherapyCyclesViewModel will need matching properties:
					• Pickers   → one entry wrapping StatusOptions / SelectedStatusFilter
					• Buttons   → one entry wrapping ClearFilterCommand ("✕ Исчисти")
					• Tabs      → empty/omit if cycles have no tab grouping
					If those collections don't exist yet on the VM, this
					control will have nothing to render for filters/actions
					until they're added — happy to wire that up next.
				-->
				<controls:SparkExplorerHeaderView
					Buttons="{Binding Buttons}"
					Pickers="{Binding Pickers}"
					SearchCommand="{Binding SearchCommand}"
					SearchPlaceholder="Пребарај по име или презиме..."
					SearchText="{Binding SearchPatientText}"
					Tabs="{Binding Tabs}" />
			</Border>

			<!--  ================================================  -->
			<!--  ROW 2: LEFT grid (Spark) | RIGHT edit panel  -->
			<!--  Same split as the original page — just the left  -->
			<!--  column now uses SparkDataGridView instead of a  -->
			<!--  hand-built CollectionView + header row.  -->
			<!--  ================================================  -->
			<Grid
				Grid.Row="2"
				ColumnDefinitions="*,400"
				ColumnSpacing="20">

				<!--  ══════════════════════════════  -->
				<!--  LEFT — CYCLES GRID (Spark)  -->
				<!--  ══════════════════════════════  -->
				<Border Grid.Column="0">
					<!--
						SparkDataGridView renders generic Columns/Rows (same as
						Patients), not typed CollectionView + DataTemplate. To
						drive this, TherapyCyclesViewModel needs:
						• GridColumns — column defs (Пациент, Циклус, Почеток,
						Крај, Прегледи, Статус) mirroring what the old manual
						header row showed
						• GridRows    — one row per FilteredCycles item, with
						cells pre-formatted (dates, status pill text, counts)
						• A row-tap handler that resolves the tapped row back to
						the underlying TherapyCycle and sets SelectedCycle, so
						the edit panel on the right still populates correctly
					-->
					<controls:SparkDataGridView
						x:Name="TherapyGrid"
						Columns="{Binding GridColumns}"
						CurrentPage="{Binding CurrentPage}"
						EditRowCommand="{Binding EditCycleCommand}"
						NextPageCommand="{Binding NextPageCommand}"
						PageChangedCommand="{Binding PageChangedCommand}"
						PreviousPageCommand="{Binding PreviousPageCommand}"
						RowTappedCommand="{Binding SelectCycleCommand}"
						Rows="{Binding GridRows}"
						TotalPages="{Binding TotalPages}" />
				</Border>

				<!--  ══════════════════════════════  -->
				<!--  RIGHT — EDIT PANEL (unchanged)  -->
				<!--  ══════════════════════════════  -->
				<Grid Grid.Column="1">

					<!--  EDIT FORM  -->
					<Border
						Padding="0"
						BackgroundColor="{StaticResource Surface}"
						IsVisible="{Binding IsCycleSelected}"
						Style="{StaticResource ElevatedCard}">
						<Grid RowDefinitions="56,*,Auto">

							<!--  Panel title bar  -->
							<Border
								Grid.Row="0"
								BackgroundColor="#0F172A"
								StrokeShape="RoundRectangle 0"
								StrokeThickness="0">
								<HorizontalStackLayout
									Padding="20,0"
									Spacing="10"
									VerticalOptions="Center">
									<Border
										BackgroundColor="{StaticResource PrimaryLight}"
										HeightRequest="32"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="0"
										WidthRequest="32">
										<Label
											FontFamily="FASolid"
											FontSize="12"
											HorizontalOptions="Center"
											Text="&#xf044;"
											TextColor="{StaticResource EhmrPrimary}"
											VerticalOptions="Center" />
									</Border>
									<VerticalStackLayout Spacing="1" VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Уреди Тераписки Циклус"
											TextColor="White" />
										<Label
											FontSize="11"
											Text="Ажурирајте ги медицинските параметри"
											TextColor="#94A3B8" />
									</VerticalStackLayout>
								</HorizontalStackLayout>
							</Border>

							<!--  Form fields  -->
							<ScrollView Grid.Row="1" Padding="20">
								<VerticalStackLayout Spacing="16">

									<!--  Patient (read-only display)  -->
									<VerticalStackLayout Spacing="5">
										<Label Style="{StaticResource InputLabel}" Text="ПАЦИЕНТ" />
										<Border
											Padding="12,0"
											BackgroundColor="{StaticResource Surface2}"
											HeightRequest="46"
											Stroke="{StaticResource BorderDefault}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
												<Label
													FontFamily="FASolid"
													FontSize="11"
													Text="&#xf007;"
													TextColor="{StaticResource Muted}"
													VerticalOptions="Center" />
												<Label
													FontAttributes="Bold"
													FontSize="13"
													Text="{Binding SelectedCycle.Patient.FullName}"
													TextColor="{StaticResource Text}"
													VerticalOptions="Center" />
											</HorizontalStackLayout>
										</Border>
									</VerticalStackLayout>

									<!--  Cycle number  -->
									<VerticalStackLayout Spacing="5">
										<Label Style="{StaticResource InputLabel}" Text="РЕДЕН БРОЈ НА ЦИКЛУС *" />
										<Border Style="{StaticResource InputBorderStyle}">
											<Entry
												Keyboard="Numeric"
												Style="{StaticResource InputEntry}"
												Text="{Binding EditCycleNumber, Mode=TwoWay}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<!--  Status  -->
									<VerticalStackLayout Spacing="5">
										<Label Style="{StaticResource InputLabel}" Text="СТАТУС НА ЦИКЛУС *" />
										<Border Style="{StaticResource InputBorderStyle}">
											<Picker
												ItemsSource="{Binding StatusOptions}"
												SelectedItem="{Binding EditStatus, Mode=TwoWay}"
												Style="{StaticResource InputPicker}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<!--  StartDate / EndDate side-by-side  -->
									<Grid ColumnDefinitions="*,32,*" ColumnSpacing="0">
										<VerticalStackLayout Grid.Column="0" Spacing="5">
											<Label Style="{StaticResource InputLabel}" Text="ПОЧЕТОК *" />
											<Border Style="{StaticResource InputBorderStyle}">
												<DatePicker
													BackgroundColor="Transparent"
													Date="{Binding EditStartDate, Mode=TwoWay}"
													FontSize="13"
													Format="dd.MM.yyyy"
													TextColor="{StaticResource TextPrimary}"
													VerticalOptions="Center" />
											</Border>
										</VerticalStackLayout>

										<Label
											Grid.Column="1"
											Margin="0,0,0,12"
											FontFamily="FASolid"
											FontSize="14"
											HorizontalOptions="Center"
											Text="&#xf178;"
											TextColor="{StaticResource Muted}"
											VerticalOptions="End" />

										<VerticalStackLayout Grid.Column="2" Spacing="5">
											<Label Style="{StaticResource InputLabel}" Text="КРАЈ" />
											<Border Style="{StaticResource InputBorderStyle}">
												<DatePicker
													BackgroundColor="Transparent"
													Date="{Binding EditEndDate, Mode=TwoWay}"
													FontSize="13"
													Format="dd.MM.yyyy"
													TextColor="{StaticResource TextPrimary}"
													VerticalOptions="Center" />
											</Border>
										</VerticalStackLayout>
									</Grid>

									<!--  Notes (maps to TherapyCycle.Notes)  -->
									<VerticalStackLayout Spacing="5">
										<Label Style="{StaticResource InputLabel}" Text="КЛИНИЧКА БЕЛЕШКА" />
										<Border
											Padding="8"
											BackgroundColor="{StaticResource Surface}"
											Stroke="{StaticResource BorderDefaultStrong}"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1">
											<Editor
												BackgroundColor="Transparent"
												FontSize="12"
												HeightRequest="100"
												Placeholder="Внесете клиничка белешка за овој циклус..."
												Text="{Binding EditNotes, Mode=TwoWay}"
												TextColor="{StaticResource TextPrimary}" />
										</Border>
									</VerticalStackLayout>

									<!--  Appointments count (read-only info strip)  -->
									<Border
										Padding="14,10"
										BackgroundColor="{StaticResource Info}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<HorizontalStackLayout Spacing="10">
											<Label
												FontFamily="FASolid"
												FontSize="13"
												Text="&#xf274;"
												TextColor="{StaticResource Info}"
												VerticalOptions="Center" />
											<VerticalStackLayout Spacing="1" VerticalOptions="Center">
												<Label
													FontAttributes="Bold"
													FontSize="12"
													TextColor="{StaticResource Info}">
													<Label.FormattedText>
														<FormattedString>
															<Span Text="{Binding SelectedCycle.Appointments.Count}" />
															<Span Text=" закажани прегледи" />
														</FormattedString>
													</Label.FormattedText>
												</Label>
												<Label
													FontSize="10"
													Text="Поврзани со овој тераписки циклус"
													TextColor="{StaticResource Info}" />
											</VerticalStackLayout>
										</HorizontalStackLayout>
									</Border>

								</VerticalStackLayout>
							</ScrollView>

							<!--  Pinned save footer  -->
							<Border
								Grid.Row="2"
								Padding="20,14"
								BackgroundColor="{StaticResource Surface2}"
								Stroke="{StaticResource Divider}"
								StrokeThickness="1">
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
									<Label
										FontSize="11"
										Text="Полињата означени со * се задолжителни"
										TextColor="{StaticResource Muted}"
										VerticalOptions="Center" />
									<Button
										Grid.Column="1"
										Padding="18,0"
										BackgroundColor="#10B981"
										Command="{Binding SaveCycleChangesCommand}"
										CornerRadius="10"
										FontAttributes="Bold"
										FontFamily="FASolid"
										FontSize="13"
										HeightRequest="40"
										Text="&#xf0c7;  Зачувај"
										TextColor="White" />
								</Grid>
							</Border>
						</Grid>
					</Border>

					<!--  EMPTY STATE  -->
					<Border
						BackgroundColor="{StaticResource Surface}"
						IsVisible="{Binding IsCycleSelected, Converter={StaticResource InvertedBoolConverter}}"
						Stroke="{StaticResource BorderDefault}"
						StrokeShape="RoundRectangle 16"
						StrokeThickness="1">
						<VerticalStackLayout
							Padding="32"
							HorizontalOptions="Center"
							Spacing="16"
							VerticalOptions="Center">
							<Border
								BackgroundColor="{StaticResource PrimaryLight}"
								HeightRequest="72"
								HorizontalOptions="Center"
								StrokeShape="RoundRectangle 20"
								StrokeThickness="0"
								WidthRequest="72">
								<Label
									FontFamily="FASolid"
									FontSize="28"
									HorizontalOptions="Center"
									Text="&#xf11c;"
									TextColor="{StaticResource EhmrPrimary}"
									VerticalOptions="Center" />
							</Border>
							<VerticalStackLayout HorizontalOptions="Center" Spacing="6">
								<Label
									FontAttributes="Bold"
									FontSize="15"
									HorizontalTextAlignment="Center"
									Text="Не е избран циклус"
									TextColor="{StaticResource Text}" />
								<Label
									FontSize="12"
									HorizontalTextAlignment="Center"
									MaximumWidthRequest="280"
									Text="Кликнете на ред од табелата за да ги ажурирате параметрите."
									TextColor="{StaticResource Muted}" />
							</VerticalStackLayout>
							<HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
								<Label
									FontFamily="FASolid"
									FontSize="12"
									Text="&#xf060;"
									TextColor="{StaticResource EhmrPrimary}"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Изберете ред од табелата"
									TextColor="{StaticResource EhmrPrimary}" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</Border>

				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
