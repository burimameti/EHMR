<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.Therapies.TherapyCyclesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:EHMR.Extensions"
    xmlns:viewModels="clr-namespace:EHMR.ViewModels.Therapies"
    xmlns:entities="clr-namespace:EHMR.Domain.Entities"
    x:Name="PageRoot"
    Style="{StaticResource PageBackgroundStyle}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />

			<!-- ── TherapyStatus pill palette ── -->
			<!-- Active / InProgress → emerald -->
			<Color x:Key="PillActiveBg">#DCFCE7</Color>
			<Color x:Key="PillActiveFg">#16A34A</Color>
			<Color x:Key="PillActiveDot">#22C55E</Color>
			<!-- Planned / Pending → amber -->
			<Color x:Key="PillPendingBg">#FEF3C7</Color>
			<Color x:Key="PillPendingFg">#B45309</Color>
			<Color x:Key="PillPendingDot">#F59E0B</Color>
			<!-- Missed / Cancelled → rose -->
			<Color x:Key="PillMissedBg">#FEE2E2</Color>
			<Color x:Key="PillMissedFg">#DC2626</Color>
			<Color x:Key="PillMissedDot">#EF4444</Color>
			<!-- Completed → indigo -->
			<Color x:Key="PillDoneBg">#EEF2FF</Color>
			<Color x:Key="PillDoneFg">#6366F1</Color>
			<Color x:Key="PillDoneDot">#6366F1</Color>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="295,*">

		<!-- ═══════════════════════════════════════════ -->
		<!-- СТРАНИЧНО МЕНИ                              -->
		<!-- ═══════════════════════════════════════════ -->
		<Border Grid.Column="0" BackgroundColor="#0F172A" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!-- ═══════════════════════════════════════════ -->
		<!-- ГЛАВЕН ПАНЕЛ                                -->
		<!-- ═══════════════════════════════════════════ -->
		<Grid Grid.Column="1" RowDefinitions="72,*">

			<!-- ── TOP BAR ── -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderContainer}">
				<Grid ColumnDefinitions="*,Auto">
					<VerticalStackLayout Spacing="2" VerticalOptions="Center">
						<Label Text="Тераписки Циклуси" Style="{StaticResource PageHeaderTitle}" />
						<Label Text="Следење, модификација и ескалација на активни терапии"
                               Style="{StaticResource PageHeaderSubtitle}" />
					</VerticalStackLayout>

					<HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
						<!-- Live count badge -->
						<Border BackgroundColor="{StaticResource SuccessBackground}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="12,6"
                                VerticalOptions="Center">
							<HorizontalStackLayout Spacing="6">
								<BoxView WidthRequest="7" HeightRequest="7"
                                         CornerRadius="4"
                                         Color="{StaticResource Success}"
                                         VerticalOptions="Center" />
								<Label FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource Success}"
                                       VerticalOptions="Center">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding FilteredCycles.Count}" />
											<Span Text=" активни циклуси" />
										</FormattedString>
									</Label.FormattedText>
								</Label>
							</HorizontalStackLayout>
						</Border>

						<!-- User pill -->
						<Border Padding="12,8"
                                BackgroundColor="{StaticResource SurfaceAlt}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">
							<HorizontalStackLayout Spacing="8">
								<Label Text="&#xf0f1;" FontFamily="FASolid" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
								<Label Text="{Binding UserName}" FontSize="12" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"
                                       VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Border>
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!-- ── CONTENT AREA ── -->
			<Grid Grid.Row="1" Padding="24" RowDefinitions="Auto,14,*">

				<!-- ────────────────────────────────── -->
				<!-- TOOLBAR                            -->
				<!-- ────────────────────────────────── -->
				<Border Grid.Row="0" Style="{StaticResource ToolbarContainer}">
					<Grid ColumnDefinitions="*,220,Auto,Auto"
                          ColumnSpacing="12" VerticalOptions="Center">

						<VerticalStackLayout Spacing="5">
							<Label Text="ПРЕБАРУВАЊЕ ПАЦИЕНТ" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}">
								<Grid ColumnDefinitions="Auto,*">
									<Label Text="&#xf002;" FontFamily="FASolid" FontSize="14"
                                           Margin="4,0,8,0"
                                           TextColor="{StaticResource TextMuted}"
                                           VerticalOptions="Center" />
									<Entry Grid.Column="1"
                                           Style="{StaticResource InputEntry}"
                                           Placeholder="Пребарај по име или презиме..."
                                           PlaceholderColor="{StaticResource TextMuted}"
                                           Text="{Binding SearchPatientText, Mode=TwoWay}"
                                           VerticalOptions="Center" />
								</Grid>
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="1" Spacing="5">
							<Label Text="ФИЛТЕР ПО СТАТУС" Style="{StaticResource InputLabel}" />
							<Border Style="{StaticResource InputBorderStyle}">
								<Picker Style="{StaticResource InputPicker}"
                                        ItemsSource="{Binding StatusOptions}"
                                        SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                        VerticalOptions="Center" />
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="2" VerticalOptions="End">
							<Button Text="✕ Исчисти" Padding="14,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ClearFilterCommand}" />
						</VerticalStackLayout>

						<VerticalStackLayout Grid.Column="3" VerticalOptions="End">
							<Button Text="+ Нов Циклус"
                                    HeightRequest="40" CornerRadius="10"
                                    BackgroundColor="{StaticResource EhmrPrimary}"
                                    TextColor="White" FontAttributes="Bold"
                                    Padding="16,0"
                                    Command="{Binding NewCycleCommand}" />
						</VerticalStackLayout>
					</Grid>
				</Border>

				<!-- ────────────────────────────────── -->
				<!-- LEFT grid | RIGHT edit panel       -->
				<!-- ────────────────────────────────── -->
				<Grid Grid.Row="2" ColumnDefinitions="*,400" ColumnSpacing="20">

					<!-- ══════════════════════════════ -->
					<!-- LEFT — CYCLES GRID             -->
					<!-- ══════════════════════════════ -->
					<Border Grid.Column="0" Style="{StaticResource ElevatedCard}" Padding="0">
						<Grid RowDefinitions="50,*,64">

							<!-- Dark header bar
                                 Columns: checkbox | ПАЦИЕНТ | ЦИК. | ПОЧЕТОК | КРАЈ | ПРЕГЛЕДИ | СТАТУС | › -->
							<Border Grid.Row="0"
                                    BackgroundColor="#0F172A"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 0">
								<Grid Padding="20,0"
                                      ColumnDefinitions="36,2.6*,0.7*,1.5*,1.5*,0.9*,1.4*,44"
                                      ColumnSpacing="12"
                                      VerticalOptions="Center">
									<CheckBox Grid.Column="0" Color="#6366F1" Scale="0.85"
                                              VerticalOptions="Center" HorizontalOptions="Center" />
									<Label Grid.Column="1" Text="ПАЦИЕНТ"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                           VerticalOptions="Center" />
									<Label Grid.Column="2" Text="ЦИК."
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
									<Label Grid.Column="3" Text="ПОЧЕТОК"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                           VerticalOptions="Center" />
									<Label Grid.Column="4" Text="КРАЈ"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                           VerticalOptions="Center" />
									<Label Grid.Column="5" Text="ПРЕГ."
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                           HorizontalTextAlignment="Center"
                                           VerticalOptions="Center" />
									<Label Grid.Column="6" Text="СТАТУС"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#94A3B8" CharacterSpacing="0.8"
                                           VerticalOptions="Center" />
									<Label Grid.Column="7" Text=""
                                           VerticalOptions="Center" />
								</Grid>
							</Border>

							<!-- Data rows -->
							<CollectionView Grid.Row="1"
                                            ItemsSource="{Binding FilteredCycles}"
                                            SelectedItem="{Binding SelectedCycle, Mode=TwoWay}"
                                            SelectionMode="Single">

								<CollectionView.EmptyView>
									<VerticalStackLayout Spacing="14"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Padding="0,60">
										<Border WidthRequest="64" HeightRequest="64"
                                                BackgroundColor="{StaticResource Surface2}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 20"
                                                HorizontalOptions="Center">
											<Label Text="&#xf0c3;" FontFamily="FASolid"
                                                   FontSize="26"
                                                   TextColor="{StaticResource Muted}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
										</Border>
										<Label Text="Нема активни циклуси"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource Text}"
                                               HorizontalOptions="Center" />
										<Label Text="Сите терапии се завршени или нема совпаѓање со филтерот."
                                               FontSize="13"
                                               TextColor="{StaticResource Muted}"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center" />
									</VerticalStackLayout>
								</CollectionView.EmptyView>

								<CollectionView.ItemTemplate>
									<DataTemplate x:DataType="entities:TherapyCycle">

										<Border BackgroundColor="{StaticResource Surface}"
                                                StrokeThickness="0" Padding="0">

											<VisualStateManager.VisualStateGroups>
												<VisualStateGroup Name="CommonStates">
													<VisualState Name="Normal">
														<VisualState.Setters>
															<Setter Property="BackgroundColor"
                                                                    Value="{StaticResource Surface}" />
														</VisualState.Setters>
													</VisualState>
													<VisualState Name="Selected">
														<VisualState.Setters>
															<Setter Property="BackgroundColor"
                                                                    Value="{StaticResource PrimaryLight}" />
														</VisualState.Setters>
													</VisualState>
													<VisualState Name="PointerOver">
														<VisualState.Setters>
															<Setter Property="BackgroundColor"
                                                                    Value="{StaticResource Surface2}" />
														</VisualState.Setters>
													</VisualState>
												</VisualStateGroup>
											</VisualStateManager.VisualStateGroups>

											<Grid>
												<!-- Bottom divider -->
												<BoxView HeightRequest="1"
                                                         Color="{StaticResource Divider}"
                                                         VerticalOptions="End"
                                                         Margin="20,0" />
												<!-- Selected left accent bar -->
												<BoxView WidthRequest="3"
                                                         BackgroundColor="{StaticResource EhmrPrimary}"
                                                         HorizontalOptions="Start"
                                                         VerticalOptions="Fill" />

												<Grid Padding="20,13"
                                                      ColumnDefinitions="36,2.6*,0.7*,1.5*,1.5*,0.9*,1.4*,44"
                                                      ColumnSpacing="12"
                                                      VerticalOptions="Center">

													<!-- Checkbox -->
													<CheckBox Grid.Column="0"
                                                              Color="{StaticResource EhmrPrimary}"
                                                              Scale="0.85"
                                                              VerticalOptions="Center"
                                                              HorizontalOptions="Center" />

													<!-- ПАЦИЕНТ: initials avatar + name + PatientId hint -->
													<HorizontalStackLayout Grid.Column="1"
                                                                            Spacing="10"
                                                                            VerticalOptions="Center">
														<Border WidthRequest="36" HeightRequest="36"
                                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                                StrokeThickness="0"
                                                                StrokeShape="RoundRectangle 10">
															<!-- Wire to InitialsConverter: Patient.FirstName[0] + Patient.LastName[0] -->
															<Label FontSize="12" FontAttributes="Bold"
                                                                   TextColor="{StaticResource EhmrPrimary}"
                                                                   HorizontalOptions="Center"
                                                                   VerticalOptions="Center"
                                                                   Text="{Binding Patient.FirstName,
                                                                         StringFormat='{}{0:0}'}" />
														</Border>
														<VerticalStackLayout Spacing="1" VerticalOptions="Center">
															<Label Text="{Binding Patient.FullName}"
                                                                   FontSize="13" FontAttributes="Bold"
                                                                   TextColor="{StaticResource Text}"
                                                                   LineBreakMode="TailTruncation" />
															<Label Text="{Binding Patient.NationalId}"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource Muted}" />
														</VerticalStackLayout>
													</HorizontalStackLayout>

													<!-- ЦИКЛУС број badge -->
													<Border Grid.Column="2"
                                                            BackgroundColor="{StaticResource Surface2}"
                                                            StrokeThickness="1"
                                                            Stroke="{StaticResource BorderDefault}"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="4,4"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center">
														<Label Text="{Binding CycleNumber, StringFormat='№{0}'}"
                                                               FontSize="12" FontAttributes="Bold"
                                                               TextColor="{StaticResource Text}"
                                                               HorizontalOptions="Center" />
													</Border>

													<!-- ПОЧЕТОК -->
													<VerticalStackLayout Grid.Column="3"
                                                                          Spacing="1" VerticalOptions="Center">
														<Label Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
                                                               FontSize="13" FontAttributes="Bold"
                                                               TextColor="{StaticResource Text}" />
														<HorizontalStackLayout Spacing="4">
															<Label Text="&#xf133;" FontFamily="FASolid"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource Muted}"
                                                                   VerticalOptions="Center" />
															<Label Text="{Binding StartDate, StringFormat='{0:dddd}'}"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource Muted}" />
														</HorizontalStackLayout>
													</VerticalStackLayout>

													<!-- КРАЈ (nullable) -->
													<VerticalStackLayout Grid.Column="4"
                                                                          Spacing="1" VerticalOptions="Center">
														<Label FontSize="13" FontAttributes="Bold"
                                                               TextColor="{StaticResource Text}">
															<Label.FormattedText>
																<FormattedString>
																	<Span Text="{Binding EndDate,
                                                                                StringFormat='{0:dd.MM.yyyy}',
                                                                                TargetNullValue='—'}" />
																</FormattedString>
															</Label.FormattedText>
														</Label>
														<Label Text="планиран крај"
                                                               FontSize="10"
                                                               TextColor="{StaticResource Muted}" />
													</VerticalStackLayout>

													<!-- ПРЕГЛЕДИ count badge -->
													<Border Grid.Column="5"
                                                            BackgroundColor="{StaticResource InfoBackground}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            Padding="6,4"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center">
														<HorizontalStackLayout Spacing="4">
															<Label Text="&#xf274;" FontFamily="FASolid"
                                                                   FontSize="10"
                                                                   TextColor="{StaticResource Info}"
                                                                   VerticalOptions="Center" />
															<Label Text="{Binding Appointments.Count}"
                                                                   FontSize="12" FontAttributes="Bold"
                                                                   TextColor="{StaticResource Info}" />
														</HorizontalStackLayout>
													</Border>

													<!-- СТАТУС pill
                                                         NOTE: swap Bg/Fg/Dot via TherapyStatusToPillConverter -->
													<Border Grid.Column="6"
                                                            BackgroundColor="{StaticResource PillActiveBg}"
                                                            StrokeThickness="1"
                                                            Stroke="{StaticResource PillActiveFg}"
                                                            StrokeShape="RoundRectangle 20"
                                                            Padding="10,5"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">
														<HorizontalStackLayout Spacing="5">
															<BoxView WidthRequest="6" HeightRequest="6"
                                                                     CornerRadius="3"
                                                                     Color="{StaticResource PillActiveDot}"
                                                                     VerticalOptions="Center" />
															<Label Text="{Binding Status}"
                                                                   FontSize="11" FontAttributes="Bold"
                                                                   TextColor="{StaticResource PillActiveFg}"
                                                                   VerticalOptions="Center" />
														</HorizontalStackLayout>
													</Border>

													<!-- Open chevron -->
													<Border Grid.Column="7"
                                                            BackgroundColor="{StaticResource Surface2}"
                                                            StrokeThickness="0"
                                                            StrokeShape="RoundRectangle 8"
                                                            WidthRequest="32" HeightRequest="32"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center">
														<Label Text="&#xf105;" FontFamily="FASolid"
                                                               FontSize="14"
                                                               TextColor="{StaticResource EhmrPrimary}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center" />
													</Border>

												</Grid>
											</Grid>
										</Border>
									</DataTemplate>
								</CollectionView.ItemTemplate>
							</CollectionView>

							<!-- Pagination footer -->
							<Border Grid.Row="2"
                                    BackgroundColor="{StaticResource Surface2}"
                                    Stroke="{StaticResource Divider}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 0">
								<Grid Padding="20,0" HeightRequest="64"
                                      ColumnDefinitions="Auto,*,Auto"
                                      VerticalOptions="Center">

									<HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
										<Border BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="8,4">
											<Label Text="{Binding FilteredCycles.Count}"
                                                   FontSize="12" FontAttributes="Bold"
                                                   TextColor="{StaticResource EhmrPrimary}" />
										</Border>
										<Label Text="тераписки циклуси"
                                               FontSize="12"
                                               TextColor="{StaticResource Muted}"
                                               VerticalOptions="Center" />
									</HorizontalStackLayout>

									<HorizontalStackLayout Grid.Column="1"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center"
                                                            Spacing="5">
										<Border WidthRequest="28" HeightRequest="28"
                                                BackgroundColor="{StaticResource EhmrPrimary}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 6">
											<Label Text="{Binding CurrentPage, FallbackValue=1}"
                                                   FontSize="12" FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
										</Border>
										<Label Text="од" FontSize="12"
                                               TextColor="{StaticResource Muted}"
                                               VerticalOptions="Center" />
										<Label Text="{Binding TotalPages, FallbackValue=1}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource Text}"
                                               VerticalOptions="Center" />
										<Label Text="страни" FontSize="12"
                                               TextColor="{StaticResource Muted}"
                                               VerticalOptions="Center" />
									</HorizontalStackLayout>

									<HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
										<Border StrokeThickness="1"
                                                Stroke="{StaticResource BorderDefault}"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource Surface}"
                                                Padding="0">
											<Button Text="&#xf104;  Претходна"
                                                    FontFamily="FASolid" FontSize="12"
                                                    HeightRequest="36" Padding="14,0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource BodyColor}"
                                                    Command="{Binding PreviousPageCommand}" />
										</Border>
										<Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                BackgroundColor="{StaticResource EhmrPrimary}"
                                                Padding="0">
											<Button Text="Следна  &#xf105;"
                                                    FontFamily="FASolid" FontSize="12" FontAttributes="Bold"
                                                    HeightRequest="36" Padding="14,0"
                                                    BackgroundColor="Transparent"
                                                    TextColor="White"
                                                    Command="{Binding NextPageCommand}" />
										</Border>
									</HorizontalStackLayout>
								</Grid>
							</Border>
						</Grid>
					</Border>

					<!-- ══════════════════════════════ -->
					<!-- RIGHT — EDIT PANEL             -->
					<!-- ══════════════════════════════ -->
					<Grid Grid.Column="1">

						<!-- EDIT FORM -->
						<Border BackgroundColor="{StaticResource Surface}"
                                Style="{StaticResource ElevatedCard}"
                                Padding="0"
                                IsVisible="{Binding IsCycleSelected}">
							<Grid RowDefinitions="56,*,Auto">

								<!-- Panel title bar -->
								<Border Grid.Row="0"
                                        BackgroundColor="#0F172A"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 0">
									<HorizontalStackLayout Padding="20,0" Spacing="10" VerticalOptions="Center">
										<Border WidthRequest="32" HeightRequest="32"
                                                BackgroundColor="{StaticResource PrimaryLight}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
											<Label Text="&#xf044;" FontFamily="FASolid"
                                                   FontSize="12"
                                                   TextColor="{StaticResource EhmrPrimary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
										</Border>
										<VerticalStackLayout Spacing="1" VerticalOptions="Center">
											<Label Text="Уреди Тераписки Циклус"
                                                   FontSize="13" FontAttributes="Bold"
                                                   TextColor="White" />
											<Label Text="Ажурирајте ги медицинските параметри"
                                                   FontSize="11" TextColor="#94A3B8" />
										</VerticalStackLayout>
									</HorizontalStackLayout>
								</Border>

								<!-- Form fields -->
								<ScrollView Grid.Row="1" Padding="20">
									<VerticalStackLayout Spacing="16">

										<!-- Patient (read-only display) -->
										<VerticalStackLayout Spacing="5">
											<Label Text="ПАЦИЕНТ" Style="{StaticResource InputLabel}" />
											<Border HeightRequest="46"
                                                    BackgroundColor="{StaticResource Surface2}"
                                                    Stroke="{StaticResource BorderDefault}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 10"
                                                    Padding="12,0">
												<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
													<Label Text="&#xf007;" FontFamily="FASolid"
                                                           FontSize="11"
                                                           TextColor="{StaticResource Muted}"
                                                           VerticalOptions="Center" />
													<Label Text="{Binding SelectedCycle.Patient.FullName}"
                                                           FontSize="13" FontAttributes="Bold"
                                                           TextColor="{StaticResource Text}"
                                                           VerticalOptions="Center" />
												</HorizontalStackLayout>
											</Border>
										</VerticalStackLayout>

										<!-- Cycle number -->
										<VerticalStackLayout Spacing="5">
											<Label Text="РЕДЕН БРОЈ НА ЦИКЛУС *"
                                                   Style="{StaticResource InputLabel}" />
											<Border Style="{StaticResource InputBorderStyle}">
												<Entry Text="{Binding EditCycleNumber, Mode=TwoWay}"
                                                       Keyboard="Numeric"
                                                       Style="{StaticResource InputEntry}"
                                                       VerticalOptions="Center" />
											</Border>
										</VerticalStackLayout>

										<!-- Status -->
										<VerticalStackLayout Spacing="5">
											<Label Text="СТАТУС НА ЦИКЛУС *"
                                                   Style="{StaticResource InputLabel}" />
											<Border Style="{StaticResource InputBorderStyle}">
												<Picker Style="{StaticResource InputPicker}"
                                                        ItemsSource="{Binding StatusOptions}"
                                                        SelectedItem="{Binding EditStatus, Mode=TwoWay}"
                                                        VerticalOptions="Center" />
											</Border>
										</VerticalStackLayout>

										<!-- StartDate / EndDate side-by-side -->
										<Grid ColumnDefinitions="*,32,*" ColumnSpacing="0">
											<VerticalStackLayout Grid.Column="0" Spacing="5">
												<Label Text="ПОЧЕТОК *" Style="{StaticResource InputLabel}" />
												<Border Style="{StaticResource InputBorderStyle}">
													<DatePicker Date="{Binding EditStartDate, Mode=TwoWay}"
                                                                Format="dd.MM.yyyy"
                                                                TextColor="{StaticResource TextPrimary}"
                                                                BackgroundColor="Transparent"
                                                                FontSize="13"
                                                                VerticalOptions="Center" />
												</Border>
											</VerticalStackLayout>

											<Label Grid.Column="1"
                                                   Text="&#xf178;" FontFamily="FASolid"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Muted}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="End"
                                                   Margin="0,0,0,12" />

											<VerticalStackLayout Grid.Column="2" Spacing="5">
												<Label Text="КРАЈ" Style="{StaticResource InputLabel}" />
												<Border Style="{StaticResource InputBorderStyle}">
													<DatePicker Date="{Binding EditEndDate, Mode=TwoWay}"
                                                                Format="dd.MM.yyyy"
                                                                TextColor="{StaticResource TextPrimary}"
                                                                BackgroundColor="Transparent"
                                                                FontSize="13"
                                                                VerticalOptions="Center" />
												</Border>
											</VerticalStackLayout>
										</Grid>

										<!-- Notes (maps to TherapyCycle.Notes) -->
										<VerticalStackLayout Spacing="5">
											<Label Text="КЛИНИЧКА БЕЛЕШКА"
                                                   Style="{StaticResource InputLabel}" />
											<Border BackgroundColor="{StaticResource Surface}"
                                                    Stroke="{StaticResource BorderDefaultStrong}"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="8">
												<Editor Text="{Binding EditNotes, Mode=TwoWay}"
                                                        Placeholder="Внесете клиничка белешка за овој циклус..."
                                                        HeightRequest="100"
                                                        FontSize="12"
                                                        TextColor="{StaticResource TextPrimary}"
                                                        BackgroundColor="Transparent" />
											</Border>
										</VerticalStackLayout>

										<!-- Appointments count (read-only info strip) -->
										<Border BackgroundColor="{StaticResource InfoBackground}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="14,10">
											<HorizontalStackLayout Spacing="10">
												<Label Text="&#xf274;" FontFamily="FASolid"
                                                       FontSize="13"
                                                       TextColor="{StaticResource Info}"
                                                       VerticalOptions="Center" />
												<VerticalStackLayout Spacing="1" VerticalOptions="Center">
													<Label FontSize="12" FontAttributes="Bold"
                                                           TextColor="{StaticResource Info}">
														<Label.FormattedText>
															<FormattedString>
																<Span Text="{Binding SelectedCycle.Appointments.Count}" />
																<Span Text=" закажани прегледи" />
															</FormattedString>
														</Label.FormattedText>
													</Label>
													<Label Text="Поврзани со овој тераписки циклус"
                                                           FontSize="10"
                                                           TextColor="{StaticResource Info}" />
												</VerticalStackLayout>
											</HorizontalStackLayout>
										</Border>

									</VerticalStackLayout>
								</ScrollView>

								<!-- Pinned save footer -->
								<Border Grid.Row="2"
                                        BackgroundColor="{StaticResource Surface2}"
                                        Stroke="{StaticResource Divider}"
                                        StrokeThickness="1"
                                        Padding="20,14">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
										<Label Text="Полињата означени со * се задолжителни"
                                               FontSize="11"
                                               TextColor="{StaticResource Muted}"
                                               VerticalOptions="Center" />
										<Button Grid.Column="1"
                                                Text="&#xf0c7;  Зачувај"
                                                FontFamily="FASolid"
                                                FontSize="13" FontAttributes="Bold"
                                                HeightRequest="40" Padding="18,0"
                                                CornerRadius="10"
                                                BackgroundColor="#10B981"
                                                TextColor="White"
                                                Command="{Binding SaveCycleChangesCommand}" />
									</Grid>
								</Border>
							</Grid>
						</Border>

						<!-- EMPTY STATE -->
						<Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource BorderDefault}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 16"
                                IsVisible="{Binding IsCycleSelected,
                                            Converter={StaticResource InvertedBoolConverter}}">
							<VerticalStackLayout HorizontalOptions="Center"
                                                 VerticalOptions="Center"
                                                 Spacing="16" Padding="32">
								<Border WidthRequest="72" HeightRequest="72"
                                        BackgroundColor="{StaticResource PrimaryLight}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 20"
                                        HorizontalOptions="Center">
									<Label Text="&#xf11c;" FontFamily="FASolid"
                                           FontSize="28"
                                           TextColor="{StaticResource EhmrPrimary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
								</Border>
								<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
									<Label Text="Не е избран циклус"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource Text}"
                                           HorizontalTextAlignment="Center" />
									<Label Text="Кликнете на ред од левата табела за да ги ажурирате параметрите."
                                           FontSize="12"
                                           TextColor="{StaticResource Muted}"
                                           HorizontalTextAlignment="Center"
                                           MaximumWidthRequest="280" />
								</VerticalStackLayout>
								<HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
									<Label Text="&#xf060;" FontFamily="FASolid"
                                           FontSize="12"
                                           TextColor="{StaticResource EhmrPrimary}"
                                           VerticalOptions="Center" />
									<Label Text="Изберете ред од табелата"
                                           FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource EhmrPrimary}" />
								</HorizontalStackLayout>
							</VerticalStackLayout>
						</Border>

					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>