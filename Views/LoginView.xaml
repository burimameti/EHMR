<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:EHMR.ViewModels"
    x:Class="EHMR.Views.LoginView"
    x:DataType="vm:LoginViewModel"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#0F172A">
	<!-- Конзистентна темна позадина како основа -->

	<Grid ColumnDefinitions="*, 600">

		<!-- ЛЕВА КОЛОНА: Информативен дел со суптилен градиент и графики -->
		<Grid Grid.Column="0">
			<Grid.Background>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Color="#1E293B" Offset="0" />
					<GradientStop Color="#0F172A" Offset="0.6" />
					<GradientStop Color="#05084E" Offset="1" />
				</LinearGradientBrush>
			</Grid.Background>

			<!-- Модерни апстрактни кругови во позадина -->
			<AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
				<Ellipse Fill="#38BDF8" WidthRequest="200" HeightRequest="200" Opacity="0.15" AbsoluteLayout.LayoutBounds="-50, 100, 200, 200" />
				<Ellipse Fill="#0C87FD" WidthRequest="400" HeightRequest="400" Opacity="0.1" AbsoluteLayout.LayoutBounds="0.1, 0.2, 400, 400" AbsoluteLayout.LayoutFlags="PositionProportional" />
				<Ellipse Fill="#38BDF8" WidthRequest="300" HeightRequest="300" Opacity="0.15" AbsoluteLayout.LayoutBounds="0.9, 0.8, 300, 300" AbsoluteLayout.LayoutFlags="PositionProportional" />
			</AbsoluteLayout>

			<!-- Содржина на левата колона -->
			<VerticalStackLayout Padding="60, 0" VerticalOptions="Center" Spacing="28">
				<Label Text="&#xf2f6;" FontFamily="FASolid" FontSize="64" TextColor="#38BDF8" HorizontalOptions="Start" />

				<VerticalStackLayout Spacing="6">
					<Label Text="EHMR-MK" FontSize="44" FontAttributes="Bold" TextColor="#FFFFFF" CharacterSpacing="0.5" />
					<Label Text="Систем за управување со здравствени податоци" FontSize="16" TextColor="#94A3B8" />
				</VerticalStackLayout>

				<BoxView HeightRequest="1" BackgroundColor="#1E293B" HorizontalOptions="Fill" Margin="0,10" />

				<!-- Листа на карактеристики -->
				<VerticalStackLayout Spacing="16">
					<HorizontalStackLayout Spacing="14">
						<Label Text="&#xf3ed;" FontFamily="FASolid" FontSize="16" TextColor="#38BDF8" WidthRequest="24" VerticalOptions="Center" HorizontalTextAlignment="Center" />
						<Label Text="Енд-ту-енд енкрипција и највисоко ниво на безбедност." TextColor="#94A3B8" FontSize="14" VerticalOptions="Center" />
					</HorizontalStackLayout>

					<HorizontalStackLayout Spacing="14">
						<Label Text="&#xf0f0;" FontFamily="FASolid" FontSize="16" TextColor="#38BDF8" WidthRequest="24" VerticalOptions="Center" HorizontalTextAlignment="Center" />
						<Label Text="Унифициран преглед на картони, терапии и анамнези." TextColor="#94A3B8" FontSize="14" VerticalOptions="Center" />
					</HorizontalStackLayout>

					<HorizontalStackLayout Spacing="14">
						<Label Text="&#xf201;" FontFamily="FASolid" FontSize="16" TextColor="#38BDF8" WidthRequest="24" VerticalOptions="Center" HorizontalTextAlignment="Center" />
						<Label Text="Напредна статистика и автоматизирани извештаи." TextColor="#94A3B8" FontSize="14" VerticalOptions="Center" />
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</VerticalStackLayout>
		</Grid>

		<!-- ДЕСНА КОЛОНА: Форма за најава -->
		<Grid Grid.Column="1"  Padding="40">
			<!-- Суптилна разделна линија помеѓу двете колони -->
			<!--<BoxView HorizontalOptions="Start" WidthRequest="1" BackgroundColor="#1E293B" />-->

			<Border Padding="40"
                    BackgroundColor="#1E293B"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">

				<Border.Shadow>
					<Shadow Brush="#000000" Offset="0,15" Radius="30" Opacity="0.3" />
				</Border.Shadow>

				<ScrollView VerticalOptions="Center">
					<VerticalStackLayout Spacing="24">

						<!-- Наслов на формата -->
						<VerticalStackLayout Spacing="6">
							<Label Text="Системска најава" FontSize="28" FontAttributes="Bold" TextColor="White" />
							<Label Text="Внесете ги вашите медицински креденцијали" FontSize="14" TextColor="#94A3B8" />
						</VerticalStackLayout>

						<!-- Поле за Корисничко име -->
						<VerticalStackLayout Spacing="8">
							<Label Text="Корисничко име или Е-пошта" TextColor="#94A3B8" FontSize="13" FontAttributes="Bold" />

							<Border x:Name="EmailBorder" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#0F172A" Padding="14,0">
								<Border.Triggers>
									<DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference EmailEntry}, Path=IsFocused}" Value="True">
										<Setter Property="Stroke" Value="#38BDF8" />
										<Setter Property="StrokeThickness" Value="1.5" />
										<Setter Property="BackgroundColor" Value="#1E293B" />
									</DataTrigger>
								</Border.Triggers>

								<Grid ColumnDefinitions="Auto, *">
									<Label Text="&#xf0e0;" FontFamily="FASolid" FontSize="14" TextColor="#38BDF8" VerticalOptions="Center" Margin="0,0,12,0" />
									<Entry x:Name="EmailEntry"
                                           Grid.Column="1"
                                           Placeholder="username@ehmr.mk"
                                           Text="{Binding Username, Mode=TwoWay}"
                                           TextColor="White"
                                           PlaceholderColor="#475569"
                                           HeightRequest="50" />
								</Grid>
							</Border>
						</VerticalStackLayout>

						<!-- Поле за Лозинка -->
						<VerticalStackLayout Spacing="8">
							<Label Text="Лозинка" TextColor="#94A3B8" FontSize="13" FontAttributes="Bold" />

							<Border x:Name="PasswordBorder" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 12" BackgroundColor="#0F172A" Padding="14,0">
								<Border.Triggers>
									<DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference PasswordEntry}, Path=IsFocused}" Value="True">
										<Setter Property="Stroke" Value="#38BDF8" />
										<Setter Property="StrokeThickness" Value="1.5" />
										<Setter Property="BackgroundColor" Value="#1E293B" />
									</DataTrigger>
								</Border.Triggers>

								<Grid ColumnDefinitions="Auto, *">
									<Label Text="&#xf023;" FontFamily="FASolid" FontSize="14" TextColor="#38BDF8" VerticalOptions="Center" Margin="0,0,12,0" />
									<Entry x:Name="PasswordEntry"
                                           Grid.Column="1"
                                           Placeholder="••••••••••••"
                                           IsPassword="True"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           TextColor="White"
                                           PlaceholderColor="#475569"
                                           HeightRequest="50" />
								</Grid>
							</Border>
						</VerticalStackLayout>

						<!-- Опции (Запамти ме и Заборавена лозинка) -->
						<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
							<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
								<CheckBox IsChecked="{Binding RememberMe}" Color="#38BDF8" Visual="Default" />
								<Label Text="Запамти ме" VerticalOptions="Center" TextColor="#94A3B8" FontSize="13" />
							</HorizontalStackLayout>

							<Label Grid.Column="1" Text="Заборавена лозинка?" TextColor="#38BDF8" FontSize="13" VerticalOptions="Center">
								<Label.GestureRecognizers>
									<!-- Тука може да се додаде команда за ресетирање подоцна -->
								</Label.GestureRecognizers>
							</Label>
						</Grid>

						<!-- Копче за Најава -->
						<Border Stroke="Transparent" BackgroundColor="#0284C7" StrokeShape="RoundRectangle 12" HeightRequest="50" Margin="0,8,0,0">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding LoginCommand}" />
							</Border.GestureRecognizers>
							<Grid ColumnDefinitions="*, Auto" Padding="20,0">
								<Label Text="Влези во систем"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Grid.ColumnSpan="2" />
								<Label Grid.Column="1" Text="&#xf061;" FontFamily="FASolid" FontSize="14" TextColor="White" VerticalOptions="Center" />
							</Grid>
						</Border>

						<!-- Футер Безбедност -->
						<HorizontalStackLayout HorizontalOptions="Center" Spacing="6" Margin="0,8,0,0">
							<Label Text="&#xf3ed;" FontFamily="FASolid" FontSize="12" TextColor="#22C55E" VerticalOptions="Center" />
							<Label Text="Заштитен и криптиран пристап (SSL)" FontSize="12" TextColor="#64748B" VerticalOptions="Center" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>
	</Grid>
</ContentPage>