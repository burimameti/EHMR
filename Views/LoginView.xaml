<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.LoginView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:DataType="vm:LoginViewModel"
	NavigationPage.HasNavigationBar="False"
	Style="{StaticResource LoginPageStyle}">

	<Grid ColumnDefinitions="*,600">

		<!--  =====================================================  -->
		<!--  LEFT PANEL  -->
		<!--  =====================================================  -->
		<Grid Grid.Column="0">

			<Grid.Background>
				<StaticResource Key="LoginPageGradient" />
			</Grid.Background>

			<!--  Decorative circles (UNCHANGED)  -->
			<AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
				<Ellipse
					AbsoluteLayout.LayoutBounds="-50,100,200,200"
					Fill="{StaticResource LoginAccent}"
					HeightRequest="200"
					Opacity="0.15"
					WidthRequest="200" />

				<Ellipse
					AbsoluteLayout.LayoutBounds="0.1,0.2,400,400"
					AbsoluteLayout.LayoutFlags="PositionProportional"
					Fill="#016893"
					HeightRequest="400"
					Opacity="0.6"
					WidthRequest="400" />

				<Ellipse
					AbsoluteLayout.LayoutBounds="0.9,0.8,300,300"
					AbsoluteLayout.LayoutFlags="PositionProportional"
					Fill="{StaticResource LoginAccent}"
					HeightRequest="300"
					Opacity="0.15"
					WidthRequest="300" />
			</AbsoluteLayout>

			<!--  CONTENT  -->
			<VerticalStackLayout
				Padding="80,0"
				Spacing="40"
				VerticalOptions="Center">

				<!--  LOGO  -->
				<Border
					BackgroundColor="{StaticResource LoginPrimary}"
					HeightRequest="72"
					HorizontalOptions="Start"
					StrokeThickness="0"
					WidthRequest="72">

					<Border.StrokeShape>
						<RoundRectangle CornerRadius="20" />
					</Border.StrokeShape>

					<Label
						FontAttributes="Bold"
						FontSize="28"
						HorizontalOptions="Center"
						Text="Е-МК"
						TextColor="White"
						VerticalOptions="Center" />
				</Border>

				<!--  TITLE  -->
				<VerticalStackLayout Spacing="8">
					<Label
						FontAttributes="Bold"
						FontSize="52"
						Text="EHMR"
						TextColor="White" />

					<Label
						FontSize="18"
						Text="Систем за обработка на податоци за преглед, терапии, диагнози за потребите на Одделот на Клиниката за реуматологија"
						TextColor="{StaticResource LoginMuted}" />
				</VerticalStackLayout>

				<!--  STATS  -->
				<Grid ColumnDefinitions="*,*" ColumnSpacing="16">

					<Border
						Grid.Column="0"
						Padding="20"
						BackgroundColor="{StaticResource LoginCardAlt}"
						Stroke="{StaticResource LoginAccent}"
						StrokeThickness="1.5">

						<Border.Shadow>
							<Shadow
								Brush="#000000"
								Opacity="0.25"
								Radius="12"
								Offset="0,4" />
						</Border.Shadow>

						<Border.StrokeShape>
							<RoundRectangle CornerRadius="16" />
						</Border.StrokeShape>

						<VerticalStackLayout>
							<Label
								FontAttributes="Bold"
								FontSize="28"
								Text="50K+"
								TextColor="White" />

							<Label Text="Пациенти" TextColor="{StaticResource LoginMuted}" />
						</VerticalStackLayout>

					</Border>

					<Border
						Grid.Column="1"
						Padding="20"
						BackgroundColor="{StaticResource LoginCardAlt}"
						Stroke="{StaticResource LoginAccent}"
						StrokeThickness="1.5">

						<Border.Shadow>
							<Shadow
								Brush="#000000"
								Opacity="0.25"
								Radius="12"
								Offset="0,4" />
						</Border.Shadow>

						<Border.StrokeShape>
							<RoundRectangle CornerRadius="16" />
						</Border.StrokeShape>

						<VerticalStackLayout>
							<Label
								FontAttributes="Bold"
								FontSize="28"
								Text="120+"
								TextColor="White" />

							<Label Text="Медицински лица" TextColor="{StaticResource LoginMuted}" />
						</VerticalStackLayout>

					</Border>

				</Grid>

				<!--  FEATURES  -->
				<Border
					Padding="24"
					BackgroundColor="{StaticResource LoginCardAlt}"
					Stroke="{StaticResource LoginAccent}"
					StrokeThickness="1.5">

					<Border.Shadow>
						<Shadow
							Brush="#000000"
							Opacity="0.25"
							Radius="12"
							Offset="0,4" />
					</Border.Shadow>

					<Border.StrokeShape>
						<RoundRectangle CornerRadius="16" />
					</Border.StrokeShape>

					<VerticalStackLayout Spacing="14">

						<HorizontalStackLayout Spacing="12">
							<Label Text="✓" TextColor="{StaticResource LoginPrimary}" />
							<Label Text="HIPAA / GDPR усогласеност" TextColor="#CBD5E1" />
						</HorizontalStackLayout>

						<HorizontalStackLayout Spacing="12">
							<Label Text="✓" TextColor="{StaticResource LoginPrimary}" />
							<Label Text="Централизирани пациентски картони" TextColor="#CBD5E1" />
						</HorizontalStackLayout>

						<HorizontalStackLayout Spacing="12">
							<Label Text="✓" TextColor="{StaticResource LoginPrimary}" />
							<Label Text="Напредна аналитика и извештаи" TextColor="#CBD5E1" />
						</HorizontalStackLayout>

					</VerticalStackLayout>

				</Border>

			</VerticalStackLayout>
		</Grid>

		<!--  =====================================================  -->
		<!--  RIGHT PANEL  -->
		<!--  =====================================================  -->
		<Grid Grid.Column="1" Padding="40">

			<Border
				BackgroundColor="{StaticResource LoginBorder}"
				HorizontalOptions="Fill"
				Style="{StaticResource LoginCard}"
				VerticalOptions="Center">

				<Border.Shadow>
					<Shadow
						Brush="#000000"
						Opacity="0.3"
						Radius="30"
						Offset="0,15" />
				</Border.Shadow>

				<ScrollView>

					<VerticalStackLayout Spacing="24">

						<!--  TITLE  -->
						<VerticalStackLayout Spacing="6">
							<Label
								FontAttributes="Bold"
								FontSize="28"
								Text="Најава"
								TextColor="White" />

							<Label
								FontSize="14"
								Text="За да се најавите ве молиме користете ја е-поштата и лозинката дадена од Администрацијата"
								TextColor="{StaticResource LoginAccent}" />
						</VerticalStackLayout>

						<!--  USERNAME  -->
						<VerticalStackLayout Spacing="8">

							<Label
								FontAttributes="Bold"
								FontSize="13"
								Text="Корисничко име или Е-пошта"
								TextColor="{StaticResource White}" />

							<Border
								Margin="0,8,0,0"
								Style="{StaticResource LoginInputBorder}"
								VerticalOptions="Center">

								<Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">

									<Label
										Margin="0,0,12,0"
										FontFamily="FASolid"
										FontSize="14"
										Text="&#xf0e0;"
										TextColor="{StaticResource LoginAccent}"
										VerticalOptions="Center" />

									<Entry
										Grid.Column="1"
										Placeholder="username@ehmr.mk"
										Style="{StaticResource LoginEntry}"
										Text="{Binding Username}" />

								</Grid>

							</Border>

						</VerticalStackLayout>

						<!--  PASSWORD  -->
						<VerticalStackLayout Spacing="8">

							<Label
								FontAttributes="Bold"
								FontSize="13"
								Text="Лозинка"
								TextColor="{StaticResource White}" />

							<Border Style="{StaticResource LoginInputBorder}">

								<Grid ColumnDefinitions="Auto,*">

									<Label
										Margin="0,0,12,0"
										FontFamily="FASolid"
										FontSize="14"
										Text="&#xf023;"
										TextColor="{StaticResource LoginAccent}"
										VerticalOptions="Center" />

									<Entry
										Grid.Column="1"
										IsPassword="True"
										Placeholder="••••••••••••"
										Style="{StaticResource LoginEntry}"
										Text="{Binding Password}" />

								</Grid>

							</Border>

						</VerticalStackLayout>

						<!--  OPTIONS  -->
						<Grid ColumnDefinitions="*,Auto">

							<HorizontalStackLayout HorizontalOptions="Start" Spacing="6">
								<CheckBox IsChecked="{Binding RememberMe}" Color="{StaticResource LoginAccent}" />
								<Label
									Margin="-80,5,22,0"
									FontSize="13"
									HorizontalOptions="Start"
									Text="Запамти"
									TextColor="{StaticResource White}" />
							</HorizontalStackLayout>

							<Label
								Grid.Column="1"
								FontSize="13"
								Text="Заборавена лозинка?"
								TextColor="{StaticResource LoginAccent}" />

						</Grid>

						<!--  BUTTON  -->
						<Border Style="{StaticResource LoginPrimaryButton}">

							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding LoginCommand}" />
							</Border.GestureRecognizers>

							<Grid Padding="20,0" ColumnDefinitions="*,Auto">

								<Label
									Grid.ColumnSpan="2"
									FontAttributes="Bold"
									FontSize="15"
									HorizontalOptions="Center"
									Text="Влези во систем"
									TextColor="White"
									VerticalOptions="Center" />

							</Grid>

						</Border>

						<!--  FOOTER  -->
						<HorizontalStackLayout HorizontalOptions="Center" Spacing="6">

							<Label
								FontFamily="FASolid"
								FontSize="12"
								Text="&#xf3ed;"
								TextColor="#22C55E" />

							<Label
								FontSize="12"
								Text="Заштитен и криптиран пристап (SSL)"
								TextColor="{StaticResource LoginMuted}" />

						</HorizontalStackLayout>

					</VerticalStackLayout>

				</ScrollView>

			</Border>

		</Grid>

	</Grid>

</ContentPage>