<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.ReportPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:EHMR.Domain.Entities.Reports"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels"
	x:DataType="viewModels:ReportViewModel"
	Style="{StaticResource ThemedPage}">

	<Grid ColumnDefinitions="295,*">

		<!--  СТРАНИЧНО МЕНИ (Лево - усогласена ширина 295)  -->
		<Border
			Grid.Column="0"
			BackgroundColor="#0F172A"
			StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ГЛАВЕН КОНТЕНТ (Десно)  -->
		<Grid Grid.Column="1" RowDefinitions="100,*">

			<!--  ТОП БАР ХЕДЕР  -->
			<Border Grid.Row="0" Style="{StaticResource SparkPickerFrameStyle}">
				<Grid ColumnDefinitions="*,Auto">
					<VerticalStackLayout Spacing="{StaticResource SpaceXs}" VerticalOptions="Center">
						<Label Style="{StaticResource GridHeaderLabel}" Text="Медицински Извештаи и Аналитика" />
						<Label Style="{StaticResource SparkPagerLabelStyle}" Text="Изберете тип на извештај за обработка и детално филтрирање на базата" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="1"
						Padding="100"
						VerticalOptions="Center">
						<Border
							Padding="12,8"
							BackgroundColor="{StaticResource SurfaceAlt}"
							StrokeShape="RoundRectangle 10"
							StrokeThickness="0">
							<HorizontalStackLayout Spacing="{StaticResource SpaceSm}">
								<Label
									FontFamily="FASolid"
									FontSize="12"
									Text="&#xf007;"
									TextColor="{StaticResource TextSecondary}"
									VerticalOptions="Center" />
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="{Binding UserName}"
									TextColor="{StaticResource TextSecondary}"
									VerticalOptions="Center" />
							</HorizontalStackLayout>
						</Border>
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  ГЛАВЕН РАБОТЕН ПРОСТОР  -->
			<Grid Grid.Row="1" Padding="{StaticResource SpaceLg}">

				<!--  ХАБ: Преглед на достапни дефиниции на извештаи  -->
				<Grid
					x:Name="HubGrid"
					IsVisible="True"
					RowDefinitions="Auto,16,*">
					<Grid.Triggers>
						<DataTrigger
							Binding="{Binding IsShowingDetails}"
							TargetType="Grid"
							Value="True">
							<Setter Property="IsVisible" Value="False" />
						</DataTrigger>
					</Grid.Triggers>

					<!--  Пребарувач во Хабот  -->


					<!--  Колекција во вид на картички со Span=2  -->
					<CollectionView Grid.Row="2" ItemsSource="{Binding AvailableReports}">
						<CollectionView.ItemsLayout>
							<GridItemsLayout
								HorizontalItemSpacing="20"
								Orientation="Vertical"
								Span="2"
								VerticalItemSpacing="20" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:ReportDefinition">
								<Border
									Padding="16"
									BackgroundColor="White"
									Stroke="#E2E8F0"
									StrokeShape="RoundRectangle 16"
									StrokeThickness="1">
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:ReportViewModel}}, Path=SelectReportCommand}" CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<Grid RowDefinitions="Auto,Auto,1,Auto" RowSpacing="22">
										<Grid Grid.Row="0" ColumnDefinitions="Auto,*">
											<Label
												Grid.Column="0"
												Margin="0,0,16,0"
												FontSize="32"
												Text="{Binding Icon}"
												VerticalOptions="Center" />
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="2"
												VerticalOptions="Center">
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="WordWrap"
													Text="{Binding Title}"
													TextColor="#0F172A" />
												<Label
													CharacterSpacing="0.5"
													FontAttributes="Bold"
													FontSize="11"
													Text="КЛИКНИ ЗА ОТВОРАЊЕ"
													TextColor="{StaticResource EhmrPrimary}" />
											</VerticalStackLayout>
										</Grid>
										<Label
											Grid.Row="1"
											FontSize="13"
											HeightRequest="45"
											LineBreakMode="TailTruncation"
											MaxLines="2"
											Text="{Binding Description}"
											TextColor="#64748B" />
										<BoxView Grid.Row="2" BackgroundColor="#F1F5F9" />
										<Grid Grid.Row="3" ColumnDefinitions="*,Auto">
											<Label
												Grid.Column="0"
												FontAttributes="Bold"
												FontSize="11"
												Text="{Binding Category, StringFormat='Категорија: {0}'}"
												TextColor="#94A3B8"
												VerticalOptions="Center" />
											<Label
												Grid.Column="1"
												FontAttributes="Bold"
												FontSize="12"
												Text="Отвори извештај ➔"
												TextColor="{StaticResource SparkAccentTeal}"
												VerticalOptions="Center" />
										</Grid>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</Grid>

				<!--  ДЕТАЛИ: Табеларен приказ со странична аналитика  -->
				<Grid
					x:Name="DetailsGrid"
					ColumnDefinitions="*,340"
					ColumnSpacing="24"
					IsVisible="False"
					RowDefinitions="Auto,16,*">
					<Grid.Triggers>
						<DataTrigger
							Binding="{Binding IsShowingDetails}"
							TargetType="Grid"
							Value="True">
							<Setter Property="IsVisible" Value="True" />
						</DataTrigger>
					</Grid.Triggers>

					<!--  ЛЕНТА СО ФИЛТРИ (ГОРЕ)  -->
					<Border
						Grid.Row="0"
						Grid.Column="0"
						Grid.ColumnSpan="2"
						Style="{StaticResource ToolbarContainer}">
						<Grid
							ColumnDefinitions="Auto,*,*,*,Auto"
							ColumnSpacing="12"
							VerticalOptions="Center">



							<VerticalStackLayout Grid.Column="1" Spacing="5">
								<Label Style="{StaticResource InputLabel}" Text="ОД ДАТУМ" />
								<Border Style="{StaticResource InputBorderStyle}">
									<DatePicker
										BackgroundColor="Transparent"
										Date="{Binding StartDate}"
										FontSize="13"
										Format="dd.MM.yyyy"
										TextColor="{StaticResource TextPrimary}"
										VerticalOptions="Center" />
								</Border>
							</VerticalStackLayout>

							<VerticalStackLayout Grid.Column="2" Spacing="5">
								<Label Style="{StaticResource InputLabel}" Text="ДО ДАТУМ" />
								<Border Style="{StaticResource InputBorderStyle}">
									<DatePicker
										BackgroundColor="Transparent"
										Date="{Binding EndDate}"
										FontSize="13"
										Format="dd.MM.yyyy"
										TextColor="{StaticResource TextPrimary}"
										VerticalOptions="Center" />
								</Border>
							</VerticalStackLayout>

							<VerticalStackLayout Grid.Column="3" Spacing="5">
								<Label Style="{StaticResource InputLabel}" Text="КЛУЧ ЗА ФИЛТРИРАЊЕ" />
								<Border Style="{StaticResource InputBorderStyle}">
									<Entry
										Placeholder="Филтрирај редовиеее..."
										PlaceholderColor="{StaticResource TextMuted}"
										Style="{StaticResource InputEntry}"
										Text="{Binding AdvancedFilterText}"
										VerticalOptions="Center" />
								</Border>
							</VerticalStackLayout>
						</Grid>
					</Border>


				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>