<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.LoadingPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	BackgroundColor="#0F172A">

	<Grid>
		<VerticalStackLayout
			HorizontalOptions="Center"
			Spacing="20"
			VerticalOptions="Center">

			<ActivityIndicator
				HeightRequest="48"
				IsRunning="True"
				WidthRequest="48"
				Color="White" />

			<Label
				FontSize="18"
				HorizontalTextAlignment="Center"
				Text="Initializing EHMR..."
				TextColor="White" />

			<Label
				FontSize="12"
				HorizontalTextAlignment="Center"
				Text="Loading services, authentication and navigation"
				TextColor="#94A3B8" />
		</VerticalStackLayout>
	</Grid>
</ContentPage>