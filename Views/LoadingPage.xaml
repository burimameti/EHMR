<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.LoadingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#0F172A">

	<Grid>
		<VerticalStackLayout
            VerticalOptions="Center"
            HorizontalOptions="Center"
            Spacing="20">

			<ActivityIndicator
                IsRunning="True"
                Color="White"
                WidthRequest="48"
                HeightRequest="48" />

			<Label
                Text="Initializing EHMR..."
                TextColor="White"
                FontSize="18"
                HorizontalTextAlignment="Center" />

			<Label
                Text="Loading services, authentication and navigation"
                TextColor="#94A3B8"
                FontSize="12"
                HorizontalTextAlignment="Center" />
		</VerticalStackLayout>
	</Grid>
</ContentPage>