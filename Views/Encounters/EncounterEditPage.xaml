<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterEditViewModel"
	BackgroundColor="{StaticResource SparkBorder}">
	<ContentPage.Resources>
		<DataTemplate x:Key="EditEncounterHistoryTemplate" x:DataType="entities:Encounter">
			<Border Margin="0,0,0,6" Padding="10,8" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Label FontAttributes="Bold" FontSize="12.5" Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}" TextColor="{StaticResource SparkAccentTealDark}" /><VerticalStackLayout Grid.Column="1" Spacing="2"><Label FontAttributes="Bold" FontSize="12.5" LineBreakMode="TailTruncation" Text="{Binding ClinicalNotes, TargetNullValue='Преглед'}" TextColor="{StaticResource SparkTextPrimary}" /><Label FontSize="11.5" LineBreakMode="TailTruncation" Text="{Binding ClinicalNotes, TargetNullValue='Без клиничка белешка'}" TextColor="{StaticResource SparkTextSecondary}" /></VerticalStackLayout><Label Grid.Column="2" FontSize="16" Text="›" TextColor="{StaticResource SparkAccentTealDark}" VerticalOptions="Center" /></Grid>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="EditDiagnosisHistoryTemplate" x:DataType="entities:Diagnosis">
			<Border Margin="0,0,0,6" Padding="10,8" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 10" StrokeThickness="1"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label FontAttributes="Bold" FontSize="12.5" Text="{Binding Mkb10Code.Code}" TextColor="{StaticResource SparkAccentTealDark}" /><Label Grid.Column="1" FontSize="11.5" LineBreakMode="TailTruncation" Text="{Binding Mkb10Code.Description}" TextColor="{StaticResource SparkTextPrimary}" /></Grid></Border>
		</DataTemplate>
		<DataTemplate x:Key="EditMedicineHistoryTemplate" x:DataType="entities:PatientMedicine">
			<Border Margin="0,0,0,6" Padding="10,8" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 10" StrokeThickness="1"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><Label FontAttributes="Bold" FontSize="12.5" Text="{Binding Medicine.Name}" TextColor="{StaticResource SparkTextPrimary}" /><Label Grid.Column="1" FontSize="11.5" Text="{Binding Dosage}" TextColor="{StaticResource SparkAccentTealDark}" /></Grid></Border>
		</DataTemplate>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="12">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf044;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="Уреди"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="Додавање МКБ дијагнози, забелешки и лекови за пациентот"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Откажи" />
						<controls:FFButton
						BackgroundColorEx="{StaticResource SidebarActiveBg}"
						TextColorEx="{StaticResource SidebarActiveText}"
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Зачувај" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  MAIN PANEL  -->
			<Grid
				Grid.Row="1"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="1">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМУЛАРИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="16" Spacing="24">

							<!--  ── СЕКЦИЈА 1: ПАЦИЕНТ И РЕУМАТОЛОГ (заклучено — прегледот веќе постои) ──  -->
                            <Border Padding="14,10" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontSize="10" Text="ПРЕГЛЕД ЗА УРЕДУВАЊЕ" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Label FontAttributes="Bold" FontSize="13" Text="{Binding Encounter.EncounterNumber}" TextColor="{StaticResource SparkTextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontSize="10" Text="ПАЦИЕНТ" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Label FontAttributes="Bold" FontSize="13" Text="{Binding Encounter.Patient.FullName, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label FontSize="10" Text="ДАТУМ И СТАТУС" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Label FontAttributes="Bold" FontSize="12" Text="{Binding Encounter.EncounterDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}" TextColor="{StaticResource SparkTextPrimary}" />
                                        <Label FontSize="11" Text="{Binding EncounterStatusDisplay}" TextColor="{StaticResource SparkAccentTealDark}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

							<Border Padding="14,12" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
								<Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="14" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Column="0" FontSize="11.5" Text="ЕМБГ" TextColor="{StaticResource SparkTextSecondary}" />
                                    <Label Grid.Column="1" FontSize="11.5" Text="СЗБО број" TextColor="{StaticResource SparkTextSecondary}" />
                                    <Label Grid.Column="2" FontSize="11.5" Text="Датум на раѓање" TextColor="{StaticResource SparkTextSecondary}" />
                                    <Label Grid.Column="3" FontSize="11.5" Text="Крвна група" TextColor="{StaticResource SparkTextSecondary}" />
                                    <Label Grid.Column="4" FontSize="11.5" Text="Телефон" TextColor="{StaticResource SparkTextSecondary}" />
                                    <Label Grid.Column="5" FontSize="11.5" Text="Матичен реуматолог" TextColor="{StaticResource SparkTextSecondary}" />
                                    <Label Grid.Row="1" Grid.Column="0" FontAttributes="Bold" FontSize="13" Text="{Binding SelectedPatient.NationalId, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="1" FontAttributes="Bold" FontSize="13" Text="{Binding SelectedPatient.SzboNumber, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="2" FontAttributes="Bold" FontSize="13" Text="{Binding SelectedPatient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="3" FontAttributes="Bold" FontSize="13" Text="{Binding SelectedPatient.BloodType, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="4" FontAttributes="Bold" FontSize="13" Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label Grid.Row="1" Grid.Column="5" FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}" TextColor="{StaticResource SparkAccentTealDark}" />
                                </Grid>
							</Border>

							<!--  ── СЕКЦИЈА 2: ТИП И ПРИОРИТЕТ ────────────────────  -->
							<VerticalStackLayout IsVisible="False" Spacing="14">
								<Border Style="{StaticResource SectionPillBorderStyle}" >
									<Label Style="{StaticResource SectionPillLabelStyle}"
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ТИП И ПРИОРИТЕТ" />
								</Border>

								<Grid RowDefinitions="Auto,Auto" RowSpacing="16">
									<Grid
										Grid.Row="0"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<controls:FFPicker
											Grid.Column="0"
											ItemsSource="{Binding EncounterTypeOptions}"
											Label="Тип на преглед"
											Placeholder="Изберете тип"
											SelectedItem="{Binding EncounterTypeDisplay}" />
										<controls:FFPicker
											Grid.Column="1"
											ItemsSource="{Binding PriorityOptions}"
											Label="Приоритет"
											Placeholder="Изберете приоритет"
											SelectedItem="{Binding PriorityDisplay}" />
									</Grid>

									<Grid
										Grid.Row="1"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<Grid
											Grid.Column="0"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Датум на преглед"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Grid.Row="1"
												Padding="10,0"
												BackgroundColor="{StaticResource SparkBackground}"
												HeightRequest="46"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<DatePicker
													BackgroundColor="Transparent"
													Date="{Binding ScheduledStartDate}"
													FontSize="13"
													TextColor="{StaticResource SparkTextPrimary}"
													VerticalOptions="Center" />
											</Border>
										</Grid>

										<Grid
											Grid.Column="1"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Време"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Grid.Row="1"
												Padding="10,0"
												BackgroundColor="{StaticResource SparkBackground}"
												HeightRequest="46"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<TimePicker
													BackgroundColor="Transparent"
													FontSize="13"
													TextColor="{StaticResource SparkTextPrimary}"
													Time="{Binding ScheduledStartTime}"
													VerticalOptions="Center" />
											</Border>
										</Grid>
									</Grid>
								</Grid>
							</VerticalStackLayout><!--  ── СЕКЦИЈА 4: МКБ-10 ДИЈАГНОСТИКА ───────────────  -->
							<VerticalStackLayout Spacing="14">
								<Border Style="{StaticResource SectionPillBorderStyle}" >
									<Label Style="{StaticResource SectionPillLabelStyle}"
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="МКБ-10 ДИЈАГНОСТИКА" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24" RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <VerticalStackLayout Grid.ColumnSpan="2" Spacing="5">
                                        <Label FontAttributes="Bold" FontSize="11" Text="МКБ СЕКЦИЈА · ЛАТИНИЦА A–Z" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Border Padding="6,5" BackgroundColor="#F4F7FA" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 9" StrokeThickness="1">
                                            <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                                                <FlexLayout BindableLayout.ItemsSource="{Binding MkbAlphabetSections}" Direction="Row" JustifyContent="Start" Wrap="NoWrap">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:MkbAlphabetSection">
                                                            <Border Margin="1" HeightRequest="30" WidthRequest="28" Padding="2" StrokeShape="RoundRectangle 6" StrokeThickness="1">
                                                                <Border.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="True">
                                                                        <Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
                                                                        <Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" TargetType="Border" Value="False">
                                                                        <Setter Property="BackgroundColor" Value="White" />
                                                                        <Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectMkbSectionCommand}" CommandParameter="{Binding .}" />
                                                                </Border.GestureRecognizers>
                                                                <Label FontAttributes="Bold" FontSize="10.5" HorizontalOptions="Center" Text="{Binding Letter}" VerticalOptions="Center">
                                                                    <Label.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="True"><Setter Property="TextColor" Value="White" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}" TargetType="Label" Value="False"><Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" /></DataTrigger>
                                                                    </Label.Triggers>
                                                                </Label>
                                                            </Border>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </FlexLayout>
                                            </ScrollView>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="12">
										

									<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="5">
                                                <Label FontAttributes="Bold" FontSize="11.5" Text="Пребарување по МКБ код (латиница)" TextColor="{StaticResource SparkTextSecondary}" />
                                                <controls:FFSearchBox Placeholder="Пример: M06.9" Text="{Binding MkbCodeSearchText, Mode=TwoWay}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                                <Label FontAttributes="Bold" FontSize="11.5" Text="Пребарување по опис (кирилица)" TextColor="{StaticResource SparkTextSecondary}" />
                                                <controls:FFSearchBox Placeholder="Пример: ревматоиден артритис" Text="{Binding MkbDescriptionSearchText, Mode=TwoWay}" />
                                            </VerticalStackLayout>
                                        </Grid>
										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMkbDropdown}"
											ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="14">
                                        <VerticalStackLayout
                                            BindableLayout.ItemsSource="{Binding Diagnoses}"
                                            Spacing="8">
                                            <BindableLayout.EmptyView>
                                                <Label FontSize="12" Text="Нема доделени дијагнози." TextColor="{StaticResource SparkTextSecondary}" />
                                            </BindableLayout.EmptyView>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="entities:Diagnosis">
                                                    <Border Padding="12,10" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Padding="9,5" BackgroundColor="{StaticResource SparkAccentTealBg}" StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Start">
                                                                <Label FontAttributes="Bold" FontSize="13" Text="{Binding Mkb10Code.Code}" TextColor="{StaticResource SparkAccentTealDark}" />
                                                            </Border>
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                <Label FontSize="10" Text="ОПИС НА ДИЈАГНОЗА" TextColor="{StaticResource SparkTextSecondary}" />
                                                                <Label FontSize="12" LineBreakMode="WordWrap" Text="{Binding Mkb10Code.Description}" TextColor="{StaticResource SparkTextPrimary}" />
                                                            </VerticalStackLayout>
                                                            <Button Grid.Column="2" Padding="0" BackgroundColor="Transparent" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}" CommandParameter="{Binding .}" FontSize="13" HeightRequest="30" Text="✕" TextColor="#DC2626" VerticalOptions="Center" WidthRequest="30" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

										<VerticalStackLayout Spacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Забелешка за дијагнозата"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Padding="12,8"
												BackgroundColor="{StaticResource SparkBackground}"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Editor
													AutoSize="TextChanges"
													BackgroundColor="Transparent"
													FontSize="13"
													MinimumHeightRequest="46"
													Placeholder="Забелешки надвор од МКБ..."
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding EncounterDiagnosisNotes}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  ── 3. ЛЕКОВИ ──────────────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<Border Style="{StaticResource SectionPillBorderStyle}" >
									<Label Style="{StaticResource SectionPillLabelStyle}"
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ЛЕКОВИ" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">

									<!--  Medicine search + dropdown  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:FFSearchBox Placeholder="Пребарување на лекот..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />

										<Border
											Padding="4"
											BackgroundColor="White"
											IsVisible="{Binding ShowMedicineDropdown}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<CollectionView HeightRequest="200" ItemsSource="{Binding MedicineResults}">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="entities:Medicine">
														<Border
															Margin="2,2,2,0"
															Padding="10,8"
															BackgroundColor="Transparent"
															StrokeThickness="0">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<VerticalStackLayout Spacing="2">
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	Text="{Binding Name}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
																<Label
																	FontSize="11"
																	Text="{Binding GenericName}"
																	TextColor="{StaticResource SparkTextSecondary}" />
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>
									</VerticalStackLayout>

									<!--  Medicine table (right column)  -->
									<VerticalStackLayout Grid.Column="1" Spacing="0">

										<Label
											Margin="0,0,0,8"
											FontAttributes="Bold"
											FontSize="11"
											Text="Додадени за овој преглед"
											TextColor="{StaticResource SparkTextSecondary}" />

										<!--  Table header — only when there are rows  -->
										<Grid
											ColumnDefinitions="2*,1*,32"
											ColumnSpacing="0"
											IsVisible="{Binding HasEncounterMedicines}">
											<Border
												Grid.Column="0"
												Padding="10,7"
												BackgroundColor="#2F3944"
												Stroke="#2F3944"
												StrokeShape="Rectangle"
												StrokeThickness="1">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="ИМЕ НА ЛЕКОТ"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="1"
												Padding="10,7"
												BackgroundColor="#2F3944"
												Stroke="#2F3944"
												StrokeShape="Rectangle"
												StrokeThickness="1">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="КОЛИЧИНА"
													TextColor="White" />
											</Border>
											<!--  Delete column header — empty  -->
											<Border
												Grid.Column="2"
												BackgroundColor="#2F3944"
												Stroke="#2F3944"
												StrokeShape="Rectangle"
												StrokeThickness="1" />
										</Grid>

										<!--  Table rows  -->
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
											<BindableLayout.EmptyView>
												<Label
													Padding="0,6"
													FontSize="12"
													Text="Нема додадени лекови за овој преглед."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:PatientMedicine">
													<Grid ColumnDefinitions="2*,1*,32" ColumnSpacing="0">
														<Border
															Grid.Column="0"
															Padding="10,0"
															MinimumHeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeShape="Rectangle"
															StrokeThickness="1">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																LineBreakMode="TailTruncation"
																Text="{Binding Medicine.Name}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="1"
															Padding="10,0"
															MinimumHeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeShape="Rectangle"
															StrokeThickness="1">
															<Entry
																BackgroundColor="Transparent"
																FontAttributes="Bold"
																FontSize="13"
																Keyboard="Numeric"
																Placeholder="—"
																PlaceholderColor="{StaticResource SparkTextSecondary}"
																Text="{Binding Dosage, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="2"
															MinimumHeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeShape="Rectangle"
															StrokeThickness="1">
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
																CommandParameter="{Binding .}"
																FontSize="12"
																HorizontalOptions="Center"
																Text="✕"
																TextColor="#DC2626"
																VerticalOptions="Center" />
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>

									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ТЕРМИН + ЦИКЛУС + ПАЦИЕНТ КОНТЕКСТ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Grid
				    Grid.Column="1"
					ColumnSpacing="1"
					RowDefinitions="*"
					RowSpacing="0">
					<!--  Поврзување со термин и циклус  -->
					<Border IsVisible="False" Style="{StaticResource PageHeaderCardStyle}">
						<VerticalStackLayout>

							<Border Style="{StaticResource SectionPillBorderStyle}" >
								<Label Style="{StaticResource SectionPillLabelStyle}"
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="16"
									Text="ПОВРЗУВАЊЕ СО ТЕРМИН/ЦИКЛУС" />
							</Border>

							<Grid ColumnDefinitions="*,Auto">
								<VerticalStackLayout Grid.Column="0" Spacing="8">
									<controls:FFSearchBox Placeholder="Пребарај термин..." Text="{Binding AppointmentSearchText, Mode=TwoWay}" />
									<CollectionView
										HeightRequest="80"
										IsVisible="{Binding ShowAppointmentDropdown}"
										ItemsSource="{Binding AppointmentSearchResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:Appointment">
												<Border
													Margin="0,2"
													Padding="8"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectAppointmentCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<VerticalStackLayout Spacing="2">
														<Label
															FontAttributes="Bold"
															FontSize="11"
															Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															FontSize="10"
															LineBreakMode="TailTruncation"
															Text="{Binding ClinicalNotes}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>

									<controls:FFSearchBox Placeholder="Пребарај циклус..." Text="{Binding CycleSearchText, Mode=TwoWay}" />
									<CollectionView
										HeightRequest="80"
										IsVisible="{Binding ShowCycleDropdown}"
										ItemsSource="{Binding CycleSearchResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:TherapyCycle">
												<Border StrokeShape="RoundRectangle 6" Style="{StaticResource PageHeaderCardStyle}">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectTherapyCycleCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<Label
														FontSize="11"
														LineBreakMode="TailTruncation"
														Text="{Binding Notes}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>

								<VerticalStackLayout
									Grid.Column="1"
									Padding="10"
									Spacing="20"
									VerticalOptions="End">
									<controls:FFButton
										ButtonKind="Secondary"
										Command="{Binding AddNewAppointmentCommand}"
										ContentPadding="10,0"
										HeightRequestEx="38"
										Text="Нов термин" />
									<controls:FFButton
										ButtonKind="Secondary"
										Command="{Binding AddNewTherapyCycleCommand}"
										ContentPadding="10,0"
										HeightRequestEx="38"
										Text="Нов циклус" />
								</VerticalStackLayout>
							</Grid>

							<!--  Избран термин — резиме  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasAppointment}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<VerticalStackLayout Spacing="2">
									<Label
										FontSize="11"
										Text="Поврзан термин"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding AppointmentDisplay}"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</VerticalStackLayout>
							</Border>

							<!--  Избран циклус — резиме  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasTherapyCycle}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<VerticalStackLayout Spacing="2">
									<Label
										FontSize="11"
										Text="Терапевтски циклус"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding TherapyCycleDisplay}"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>
					</Border>

					<!--  Пациент контекст  -->
					<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
						<ScrollView VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="16" Spacing="16">

								<Border Style="{StaticResource SectionPillBorderStyle}" >
									<Label Style="{StaticResource SectionPillLabelStyle}"
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="16"
										Text="ИСТОРИЈА НА ПАЦИЕНТОТ" />
								</Border>

                                <ActivityIndicator
									Margin="0,12"
									HorizontalOptions="Center"
									IsRunning="{Binding IsPatientLoading}"
									IsVisible="{Binding IsPatientLoading}"
									Color="{StaticResource SparkAccentTeal}" />

								<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="12">
									<controls:SparkExpandableCard
										EmptyViewText="Нема претходни дијагнози."
										ItemTemplate="{StaticResource EditDiagnosisHistoryTemplate}"
										ItemsSource="{Binding PatientDiagnoses}"
										Subtitle="Историја"
										Title="Дијагнози"
										Variant="Diagnosis" />
									<controls:SparkExpandableCard
										EmptyViewText="Нема претходни прегледи."
										IsExpanded="True"
										ItemTemplate="{StaticResource EditEncounterHistoryTemplate}"
										ItemsSource="{Binding FilteredEncounters}"
										Subtitle="Претходни посети"
										Title="Историја на прегледи"
										Variant="Encounter" />
									<controls:SparkExpandableCard
										EmptyViewText="Нема претходно додадени лекови."
										ItemTemplate="{StaticResource EditMedicineHistoryTemplate}"
										ItemsSource="{Binding PatientMedicines}"
										Subtitle="Терапевтска историја"
										Title="Лекови на пациентот"
										Variant="Medicine" />
								</VerticalStackLayout>
								<Border Style="{StaticResource SectionPillBorderStyle}"><Label Style="{StaticResource SectionPillLabelStyle}" Text="ДОКУМЕНТИ" /></Border>
								<FlexLayout BindableLayout.ItemsSource="{Binding PatientDocuments}" Direction="Row" Wrap="Wrap">
									<BindableLayout.EmptyView><Label FontSize="12" Text="Нема прикачени документи." TextColor="{StaticResource SparkTextSecondary}" /></BindableLayout.EmptyView>
									<BindableLayout.ItemTemplate><DataTemplate x:DataType="entities:PatientDocument"><Border Margin="0,0,8,8" Padding="8" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 10" StrokeThickness="1" WidthRequest="120"><VerticalStackLayout Spacing="4"><Image Aspect="AspectFill" HeightRequest="64" Source="{Binding StoredPath}" /><Label FontAttributes="Bold" FontSize="10.5" LineBreakMode="TailTruncation" Text="{Binding Title}" TextColor="{StaticResource SparkTextPrimary}" /></VerticalStackLayout></Border></DataTemplate></BindableLayout.ItemTemplate>
								</FlexLayout>

							</VerticalStackLayout>
						</ScrollView>
					</Border>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
