<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterEditViewModel"
	BackgroundColor="{StaticResource PageBackground}">
	<ContentPage.Resources>
		<DataTemplate x:Key="EditEncounterHistoryTemplate" x:DataType="entities:Encounter">
			<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
				<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
				<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12.5"
							Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
							TextColor="{StaticResource SparkAccentTealDark}" />
						<VerticalStackLayout Grid.Column="1" Spacing="2">
							<Label
								FontAttributes="Bold"
								FontSize="12.5"
								LineBreakMode="TailTruncation"
								Text="{Binding ClinicalNotes, TargetNullValue='Преглед'}"
								TextColor="{StaticResource SparkTextPrimary}" />
							<Label
								FontSize="11.5"
								LineBreakMode="TailTruncation"
								Text="{Binding ClinicalNotes, TargetNullValue='Без клиничка белешка'}"
								TextColor="{StaticResource SparkTextSecondary}" />
						</VerticalStackLayout>
						<Label
							Grid.Column="2"
							FontSize="16"
							Text="›"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
					</Grid>
				</Border>
			</Grid>
		</DataTemplate>
		<DataTemplate x:Key="EditDiagnosisHistoryTemplate" x:DataType="entities:Diagnosis">
			<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
				<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
				<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<Label
							FontAttributes="Bold"
							FontSize="12.5"
							Text="{Binding Mkb10Code.Code}"
							TextColor="{StaticResource SparkAccentTealDark}" />
						<Label
							Grid.Column="1"
							FontSize="11.5"
							LineBreakMode="TailTruncation"
							Text="{Binding Mkb10Code.Description}"
							TextColor="{StaticResource SparkTextPrimary}" />
					</Grid>
				</Border>
			</Grid>
		</DataTemplate>
		<DataTemplate x:Key="EditMedicineHistoryTemplate" x:DataType="entities:PatientMedicine">
			<Border
				Margin="0,0,0,8"
				Padding="12,9"
				BackgroundColor="White"
				Stroke="#CBD5E1"
				StrokeShape="RoundRectangle 9"
				StrokeThickness="1">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
					<Label
						FontAttributes="Bold"
						FontSize="12.5"
						Text="{Binding Medicine.Name}"
						TextColor="{StaticResource SparkTextPrimary}" />
					<Label
						Grid.Column="1"
						FontSize="11.5"
						Text="{Binding Dosage}"
						TextColor="{StaticResource SparkAccentTealDark}" />
				</Grid>
			</Border>
		</DataTemplate>
	</ContentPage.Resources>
	<Grid ColumnDefinitions="285,*">
		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>
		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			Style="{StaticResource CrudFormPageGridStyle}">
			<!--  HEADER  -->
			<Border
				Grid.Row="0"
				Margin="16,16,16,0"
				Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader
					Title="Уреди преглед"
					Grid.Row="0"
					PrimaryButtonCommand="{Binding SaveCommand}"
					PrimaryButtonText="Зачувај"
					SecondaryButtonCommand="{Binding CancelCommand}"
					SecondaryButtonText="Откажи"
					ShowPrimaryButton="True"
					ShowSecondaryButton="True"
					Subtitle="Додавање МКБ дијагнози, забелешки и лекови за пациентот">
					<controls:FFPageHeader.HeaderContent>
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding GenerateClinicalReportCommand}"
							ContentPadding="16,0"
							HeightRequestEx="40"
							Text="Печати / PDF" />
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>
			<!--  MAIN PANEL  -->

			<Grid
				Grid.Row="1"
				Margin="16,0,16,0"
				ColumnSpacing="0"
				Style="{StaticResource CrudFormBodyGridStyle}">
				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМУЛАРИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="0"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">
							<!--  ── СЕКЦИЈА 1: ПАЦИЕНТ И РЕУМАТОЛОГ (заклучено — прегледот веќе постои) ──  -->
							<Border
								Padding="14,10"
								BackgroundColor="#F8FAFC"
								Stroke="#CBD5E1"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="1">
								<Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
									<VerticalStackLayout Spacing="2">
										<Label
											FontSize="10"
											Text="ПРЕГЛЕД ЗА УРЕДУВАЊЕ"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding Encounter.EncounterNumber}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="1" Spacing="2">
										<Label
											FontSize="10"
											Text="ПАЦИЕНТ"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding Encounter.Patient.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="2" Spacing="2">
										<Label
											FontSize="10"
											Text="ДАТУМ И СТАТУС"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding Encounter.EncounterDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11"
											Text="{Binding EncounterStatusDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
								</Grid>
							</Border>
							<Border
								Padding="14,12"
								BackgroundColor="{StaticResource SparkContentBackground}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid
									ColumnDefinitions="*,*,*,*,*,*,*"
									ColumnSpacing="10"
									RowDefinitions="Auto,Auto"
									RowSpacing="4">
									<Label
										Grid.Column="0"
										FontSize="11.5"
										Text="ЕМБГ"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="1"
										FontSize="11.5"
										Text="СЗБО број"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="2"
										FontSize="11.5"
										Text="Датум на раѓање"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="3"
										FontSize="11.5"
										Text="Крвна група"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="4"
										FontSize="11.5"
										Text="Телефон"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="5"
										FontSize="11.5"
										Text="Матичен реуматолог"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Column="6"
										FontSize="11.5"
										Text="Моментален скор"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										Grid.Row="1"
										Grid.Column="0"
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding SelectedPatient.NationalId, TargetNullValue='—'}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										Grid.Row="1"
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding SelectedPatient.SzboNumber, TargetNullValue='—'}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										Grid.Row="1"
										Grid.Column="2"
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding SelectedPatient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										Grid.Row="1"
										Grid.Column="3"
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding SelectedPatient.BloodType, TargetNullValue='—'}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										Grid.Row="1"
										Grid.Column="4"
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<Label
										Grid.Row="1"
										Grid.Column="5"
										FontAttributes="Bold"
										FontSize="13"
										LineBreakMode="TailTruncation"
										Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}"
										TextColor="{StaticResource SparkAccentTealDark}" />
									<Label
										Grid.Row="1"
										Grid.Column="6"
										FontAttributes="Bold"
										FontSize="13"
										LineBreakMode="TailTruncation"
										Text="{Binding CurrentPatientScore, TargetNullValue='—'}"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Grid>
							</Border>
							<!--  ── СЕКЦИЈА 2: ТИП И ПРИОРИТЕТ ────────────────────  -->
							<VerticalStackLayout IsVisible="False" Spacing="14">

								<Grid RowDefinitions="Auto,Auto" RowSpacing="16">
									<!--<Grid
										Grid.Row="0"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<controls:FFPicker
											Grid.Column="0"
											ItemsSource="{Binding EncounterTypeOptions}"
											Label="Тип на преглед"
											Placeholder="Изберете тип"
											SelectedItem="{Binding EncounterTypeDisplay}" />
										<controls:FFPicker
											Grid.Column="1"
											ItemsSource="{Binding PriorityOptions}"
											Label="Приоритет"
											Placeholder="Изберете приоритет"
											SelectedItem="{Binding PriorityDisplay}" />
									</Grid>-->
									<Grid
										Grid.Row="1"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<Grid
											Grid.Column="0"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Датум на преглед"
												TextColor="{StaticResource SparkTextSecondary}" />
											<controls:FFDatePicker Grid.Row="1" SelectedDate="{Binding ScheduledStartDate}" />
										</Grid>
										<Grid
											Grid.Column="1"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Време"
												TextColor="{StaticResource SparkTextSecondary}" />
											<controls:FFTimePicker Grid.Row="1" SelectedTime="{Binding ScheduledStartTime}" />
										</Grid>
									</Grid>
								</Grid>
							</VerticalStackLayout>
							<!--  ── СЕКЦИЈА 4: МКБ-10 ДИЈАГНОСТИКА ───────────────  -->
							<VerticalStackLayout Spacing="14">
								<controls:CrudSectionHeader Title="МКБ-10 ДИЈАГНОСТИКА" />
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									RowDefinitions="Auto,Auto"
									RowSpacing="16">
									<VerticalStackLayout Grid.ColumnSpan="2" Spacing="5">
										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="МКБ СЕКЦИЈА · ЛАТИНИЦА A–Z"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="6,5"
											BackgroundColor="#F4F7FA"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 9"
											StrokeThickness="1">
											<ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
												<FlexLayout
													BindableLayout.ItemsSource="{Binding MkbAlphabetSections}"
													Direction="Row"
													JustifyContent="Start"
													Wrap="NoWrap">
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="vm:MkbAlphabetSection">
															<Border
																Margin="1"
																Padding="2"
																HeightRequest="30"
																StrokeShape="RoundRectangle 6"
																StrokeThickness="1"
																WidthRequest="28">
																<Border.Triggers>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Border"
																		Value="True">
																		<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																		<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																	</DataTrigger>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Border"
																		Value="False">
																		<Setter Property="BackgroundColor" Value="White" />
																		<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
																	</DataTrigger>
																</Border.Triggers>
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectMkbSectionCommand}" CommandParameter="{Binding .}" />
																</Border.GestureRecognizers>
																<Label
																	FontAttributes="Bold"
																	FontSize="10.5"
																	HorizontalOptions="Center"
																	Text="{Binding Letter}"
																	VerticalOptions="Center">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
															</Border>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</FlexLayout>
											</ScrollView>
										</Border>
									</VerticalStackLayout>
									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="0"
										Spacing="12">
										<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
											<VerticalStackLayout Spacing="5">
												<Label
													FontAttributes="Bold"
													FontSize="11.5"
													Text="Пребарување по МКБ код (латиница)"
													TextColor="{StaticResource SparkTextSecondary}" />
												<controls:FFSearchBox Placeholder="Пример: M06.9" Text="{Binding MkbCodeSearchText, Mode=TwoWay}" />
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="1" Spacing="5">
												<Label
													FontAttributes="Bold"
													FontSize="11.5"
													Text="Пребарување по опис (кирилица)"
													TextColor="{StaticResource SparkTextSecondary}" />
												<controls:FFSearchBox Placeholder="Пример: ревматоиден артритис" Text="{Binding MkbDescriptionSearchText, Mode=TwoWay}" />
											</VerticalStackLayout>
										</Grid>
										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMkbDropdown}"
											ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>
									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="1"
										Spacing="14">
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding Diagnoses}" Spacing="8">
											<BindableLayout.EmptyView>
												<Label
													FontSize="12"
													Text="Нема доделени дијагнози."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:Diagnosis">
													<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
														<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
														<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
															<Grid ColumnDefinitions="Auto,*,28" ColumnSpacing="8">
																<Label Style="{StaticResource CrudCollectionCodeStyle}" Text="{Binding Mkb10Code.Code}" />
																<Label
																	Grid.Column="1"
																	LineBreakMode="TailTruncation"
																	Style="{StaticResource CrudCollectionMetaStyle}"
																	Text="{Binding Mkb10Code.Description}" />
																<Button
																	Grid.Column="2"
																	Padding="0"
																	BackgroundColor="Transparent"
																	Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
																	CommandParameter="{Binding .}"
																	FontSize="11"
																	HeightRequest="26"
																	Text="✕"
																	TextColor="#DC2626"
																	WidthRequest="26" />
															</Grid>
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
										<VerticalStackLayout Spacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Забелешка за дијагнозата"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border Style="{StaticResource TextAreaFieldBoxStyle}">
												<Editor
													AutoSize="TextChanges"
													BackgroundColor="Transparent"
													FontSize="13"
													MinimumHeightRequest="46"
													Placeholder="Забелешки надвор од МКБ..."
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding EncounterDiagnosisNotes}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
							<!--  ── ОЦЕНКА ─────────────────────────────────  -->
							<VerticalStackLayout Spacing="8">
								<controls:CrudSectionHeader Title="ОЦЕНКА" />
								<Border Style="{StaticResource TextAreaFieldBoxStyle}">
									<Entry
										BackgroundColor="Transparent"
										FontSize="13"
										Placeholder="Внесете резултат или оценка..."
										Text="{Binding ScoreText, Mode=TwoWay}"
										TextColor="{StaticResource SparkTextPrimary}" />
								</Border>
							</VerticalStackLayout>

							<!--  ── 3. ЛЕКОВИ ──────────────────────────────  -->
							<VerticalStackLayout Spacing="12">
								<controls:CrudSectionHeader Title="ЛЕКОВИ" />
								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">

									<!--  Medicine search + dropdown  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:FFSearchBox Placeholder="Пребарување на лекот..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />
										<Border
											Padding="4"
											BackgroundColor="White"
											IsVisible="{Binding ShowMedicineDropdown}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<CollectionView HeightRequest="200" ItemsSource="{Binding MedicineResults}">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="entities:Medicine">
														<Border
															Margin="2,2,2,0"
															Padding="10,8"
															BackgroundColor="Transparent"
															StrokeThickness="0">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<VerticalStackLayout Spacing="2">
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	Text="{Binding Name}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
																<Label
																	FontSize="11"
																	Text="{Binding GenericName}"
																	TextColor="{StaticResource SparkTextSecondary}" />
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>
									</VerticalStackLayout>

									<!--  Medicine table (right column)  -->
									<VerticalStackLayout Grid.Column="1" Spacing="0">
										<Label
											Margin="0,0,0,8"
											FontAttributes="Bold"
											FontSize="11"
											Text="Додадени за овој преглед"
											TextColor="{StaticResource SparkTextSecondary}" />

										<Grid
											ColumnDefinitions="2*,1*,32"
											ColumnSpacing="1"
											IsVisible="{Binding HasEncounterMedicines}">
											<Border
												Grid.Column="0"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeShape="RoundRectangle 6,0,0,0"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="ИМЕ НА ЛЕКОТ"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="1"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="КОЛИЧИНА"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="2"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="РЕЖИМ НА АПЛИКАЦИЈА"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="3"
												BackgroundColor="#475569"
												StrokeShape="RoundRectangle 0,6,0,0"
												StrokeThickness="0" />
										</Grid>

										<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
											<BindableLayout.EmptyView>
												<Border
													Padding="12,14"
													BackgroundColor="White"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Label
														FontSize="12"
														Text="Нема додадени лекови за овој преглед."
														TextColor="{StaticResource SparkTextSecondary}" />
												</Border>
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:PatientMedicine">
													<Grid ColumnDefinitions="2*,1*,32" ColumnSpacing="1">
														<Border
															Grid.Column="0"
															Padding="10,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Label
																FontSize="12"
																LineBreakMode="TailTruncation"
																Text="{Binding Medicine.Name}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="1"
															Padding="4,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Entry
																BackgroundColor="Transparent"
																FontSize="12"
																Keyboard="Numeric"
																Text="{Binding Dosage, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center"
																VerticalTextAlignment="Center" />
														</Border>
														<Border
															Grid.Column="2"
															Padding="3,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Picker
																Title="Избери режим"
																FontSize="11"
																ItemDisplayBinding="{Binding Regime}"
																ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}"
																SelectedItem="{Binding ApplicationRegime, Mode=TwoWay}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="3"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
																CommandParameter="{Binding .}"
																FontSize="12"
																Text="✕"
																TextColor="#DC2626"
																WidthRequest="32" />
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</ScrollView>
