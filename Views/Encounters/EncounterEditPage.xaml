<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterEditViewModel"
	BackgroundColor="{StaticResource PageBackground}">


	<ContentPage.Resources>
		<ResourceDictionary>
			<Style x:Key="FieldEntryStyle" TargetType="Entry">
				<Setter Property="BackgroundColor" Value="Transparent" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>
			
			
		</ResourceDictionary>
	</ContentPage.Resources>
	<Grid ColumnDefinitions="260,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*,Auto"
			Style="{StaticResource CrudFormPageGridStyle}">

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="Уреди преглед" Subtitle="Изменете ги медицинските детали за тековниот преглед">
					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
							<controls:FFButton
								ButtonKind="Ghost"
								Command="{Binding CancelCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GenerateClinicalReportCommand}"
								ContentPadding="16,0"
								HeightRequestEx="40"
								IsEnabled="{Binding CanPrint}"
								Text="Преглед за печатење / PDF" />
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<Border Grid.Row="1" Style="{StaticResource CrudFormBodyGridStyle}">
				<Grid ColumnDefinitions="2*,0.6*" ColumnSpacing="14">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="0"
					Margin="0"
					IsEnabled="{Binding CanAdminEditEncounter}"
					Style="{StaticResource CrudFormCardStyle}">
					<controls:CustomScrollView ScrollBarColor="{StaticResource SparkAccentTeal}">
						<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">

							<!--  ── 1. ПАЦИЕНТ И РЕУМАТОЛОГ ─────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<controls:CrudSectionHeader
									Title="ПАЦИЕНТ И РЕУМАТОЛОГ"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />

								<!--  Locked context display  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="12"
									IsVisible="{Binding IsPatientLockedFromContext}">
									<Border Style="{StaticResource CrudFormSectionCardStyle}">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Избран пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="14"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<Border
										Grid.Column="1" Style="{StaticResource CrudFormSectionCardStyle}">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Матичен реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="14"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  Основни податоци за пациентот  -->
								<Border
									IsVisible="{Binding HasPatientContext}" Style="{StaticResource CrudFormSectionCardStyle}">
									<Grid
										ColumnDefinitions="1.4*,1*,1*,1.4*"
										ColumnSpacing="14"
										RowDefinitions="Auto,Auto,Auto"
										RowSpacing="6">
										<Label
											Grid.ColumnSpan="4"
											FontAttributes="Bold"
											FontSize="14"
											LineBreakMode="TailTruncation"
											Text="{Binding SelectedPatient.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />

										<VerticalStackLayout
											Grid.Row="1"
											Grid.Column="0"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Датум на раѓање"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<VerticalStackLayout
											Grid.Row="1"
											Grid.Column="1"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Пол"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.Gender}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<VerticalStackLayout
											Grid.Row="1"
											Grid.Column="2"
											Grid.ColumnSpan="2"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Адреса"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedPatient.Address, TargetNullValue='—'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<VerticalStackLayout
											Grid.Row="2"
											Grid.Column="0"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Телефон"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<VerticalStackLayout
											Grid.Row="2"
											Grid.Column="1"
											Spacing="1">
											<Label
												FontSize="10"
												Text="ЕЗБО"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.SzboNumber, TargetNullValue='—'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<VerticalStackLayout
											Grid.Row="2"
											Grid.Column="2"
											Grid.ColumnSpan="2"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Матичен реуматолог"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</VerticalStackLayout>


							<!-- БИОЛОШКА ТЕРАПИЈА: усогласен приказ на МКБ, активни лекови и претходен скор -->
							<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="8">
								<controls:CrudSectionHeader Title="БИОЛОШКА ТЕРАПИЈА" LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />
								<Grid RowDefinitions="Auto" ColumnDefinitions="2*,2*,1*" ColumnSpacing="8" VerticalOptions="Start">
									<Border Grid.Column="0" VerticalOptions="Start" HorizontalOptions="Fill" Style="{StaticResource CrudFormTableFrameStyle}">
										<VerticalStackLayout Spacing="0">
											<Grid Style="{StaticResource CrudFormTableHeaderGridStyle}">
												<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="МКБ-10 ДИЈАГНОЗИ" />
											</Grid>
											<VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentMkb10Assignments}" Spacing="0" VerticalOptions="Start">
												<BindableLayout.EmptyView><Label FontSize="11" Text="Нема доделени МКБ-10 дијагнози." TextColor="{StaticResource SparkTextSecondary}" /></BindableLayout.EmptyView>
												<BindableLayout.ItemTemplate><DataTemplate x:DataType="entities:PatientMkb10Assignment">
													<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
														<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
														<VerticalStackLayout Grid.Column="1" Padding="0,3" Spacing="1">
															<Label FontAttributes="Bold" FontSize="11.5" Text="{Binding Mkb10Code.Code, TargetNullValue='—'}" TextColor="{StaticResource SparkAccentTealDark}" />
															<Label FontSize="10.5" LineBreakMode="WordWrap" Text="{Binding Mkb10Code.Description, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
													</Grid>
												</DataTemplate></BindableLayout.ItemTemplate>
											</VerticalStackLayout>
										</VerticalStackLayout>
									</Border>
									<Border Grid.Column="1" VerticalOptions="Start" HorizontalOptions="Fill" Style="{StaticResource CrudFormTableFrameStyle}">
										<VerticalStackLayout Spacing="0">
											<Grid Style="{StaticResource CrudFormTableHeaderGridStyle}">
												<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="АКТИВНИ ЛЕКОВИ" />
											</Grid>
											<VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentPatientMedicines}" Spacing="0" VerticalOptions="Start">
												<BindableLayout.EmptyView><Label FontSize="11" Text="Нема активна терапија." TextColor="{StaticResource SparkTextSecondary}" /></BindableLayout.EmptyView>
												<BindableLayout.ItemTemplate><DataTemplate x:DataType="entities:PatientMedicine">
													<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
														<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
														<VerticalStackLayout Grid.Column="1" Padding="0,3" Spacing="1">
															<Label FontAttributes="Bold" FontSize="11.5" LineBreakMode="WordWrap" Text="{Binding Medicine.BilingualName, TargetNullValue='Лек'}" TextColor="{StaticResource SparkTextPrimary}" />
															<Label FontSize="10" Text="{Binding Dosage, StringFormat='Доза: {0}', TargetNullValue=''}" TextColor="{StaticResource SparkTextSecondary}" />
															<Label FontSize="10" Text="{Binding ApplicationRegime.Regime, StringFormat='Режим: {0}', TargetNullValue=''}" TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Grid>
												</DataTemplate></BindableLayout.ItemTemplate>
											</VerticalStackLayout>
										</VerticalStackLayout>
									</Border>
									<Border Grid.Column="2" VerticalOptions="Start" Style="{StaticResource CrudFormSectionCardStyle}">
										<VerticalStackLayout Spacing="5">
											<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="ПРЕТХОДЕН СКОР" />
											<Label FontAttributes="Bold" FontSize="12" LineBreakMode="WordWrap" Text="{Binding CurrentPatientScore, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
									</Border>
								</Grid>
							</VerticalStackLayout>

			<!--  ЛЕКОВИ + СКОРОВИ  -->
							<Grid ColumnDefinitions="3*,2*" ColumnSpacing="14">

								<!--  Лева колона: терапија  -->
								<VerticalStackLayout Grid.Column="0" Spacing="10">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<controls:CrudSectionHeader
											Title="ТЕКОВНА ТЕРАПИЈА"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />
										<controls:FFButton
											Grid.Column="1"
											ButtonKind="Secondary"
											Command="{Binding AddApplicationRegimeCommand}"
											HeightRequestEx="34"
											Text="+ Нов режим"
											WidthRequestEx="116" />
									</Grid>

									<controls:FFSearchBox Placeholder="Додај лек во тековната терапија..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />

									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowMedicineDropdown}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView HeightRequest="180" ItemsSource="{Binding MedicineResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Medicine">
													<Border
														Padding="10,7"
														BackgroundColor="Transparent"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="1">
															<Label
																FontAttributes="Bold"
																FontSize="12.5"
																Text="{Binding Name}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="10.5"
																Text="{Binding GenericName}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>

									<!--  Заглавие на табелата: 4 колони (0..3)  -->
									<Grid
										ColumnDefinitions="1.45*,1*,0.85*,170"
										ColumnSpacing="1"
										IsVisible="{Binding HasEncounterMedicines}">
										<Border
											Padding="8,7"
											BackgroundColor="{StaticResource Gray300}"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="ЛЕК"
												TextColor="{StaticResource SparkTextSecondary}" />
										</Border>
										<Border
											Grid.Column="1"
											Padding="8,7"
											BackgroundColor="{StaticResource Gray300}"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="ДОЗА"
												TextColor="{StaticResource SparkTextSecondary}" />
										</Border>
										<Border
											Grid.Column="2"
											Padding="8,7"
											BackgroundColor="{StaticResource Gray300}"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="КОЛИЧИНА"
												TextColor="{StaticResource SparkTextSecondary}" />
										</Border>
										<Border
											Grid.Column="3"
											Padding="0"
											BackgroundColor="{StaticResource Gray300}"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9"
												HorizontalOptions="Center"
												Text="ТЕКОВНА"
												TextColor="{StaticResource SparkTextSecondary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>

									<!--  Редови  -->
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
										<BindableLayout.EmptyView>
											<Label
												FontSize="12"
												Text="Нема избран лек."
												TextColor="{StaticResource SparkTextSecondary}" />
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:PatientMedicine">
										<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
											<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
											<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
												<Grid ColumnDefinitions="2*,1.2*,1*" ColumnSpacing="10">
													<VerticalStackLayout Spacing="1">
														<Label FontAttributes="Bold" FontSize="12" Text="{Binding Medicine.BilingualName, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
														<Label FontSize="10" Text="{Binding ApplicationRegime.Regime, TargetNullValue='—'}" TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
													<VerticalStackLayout Grid.Column="1" Spacing="1">
														<Label FontSize="10" Text="Период" TextColor="{StaticResource SparkTextSecondary}" />
														<Label Style="{StaticResource CrudCollectionMetaStyle}" Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}" />
														<Label Style="{StaticResource CrudCollectionMetaStyle}" Text="{Binding EndDate, StringFormat='{0:dd.MM.yyyy}'}" />
													</VerticalStackLayout>
													<VerticalStackLayout Grid.Column="2" Spacing="1">
														<Label FontSize="10" Text="Статус" TextColor="{StaticResource SparkTextSecondary}" />
														<Label FontAttributes="Bold" FontSize="11" Text="Завршена" TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Grid>
											</Border>
										</Grid>
									</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>

								<!--  Десна колона: скорови и наоди  -->
								<VerticalStackLayout Grid.Column="1" Spacing="10">
									<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="СКОРОВИ"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />

									</Grid>

									<controls:FFSearchBox Placeholder="Пребарај скор..." Text="{Binding ScoreSearchText, Mode=TwoWay}" />
									<Border Padding="4" BackgroundColor="White" IsVisible="{Binding ShowScoreSuggestions}" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
										<CollectionView HeightRequest="150" ItemsSource="{Binding ScoreSuggestions}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="x:String">
													<Border Padding="9,6" StrokeThickness="0" BackgroundColor="Transparent">
														<Border.GestureRecognizers><TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectScoreSuggestionCommand}" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
														<Label Text="{Binding .}" FontSize="12" TextColor="{StaticResource SparkTextPrimary}" />
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>
									<Border Style="{StaticResource CrudFormTableFrameStyle}">
						<VerticalStackLayout Spacing="0">
							<Grid Padding="10,8" BackgroundColor="{StaticResource SparkSurfaceAlt}" ColumnDefinitions="*,44" ColumnSpacing="8">
								<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="СКОР" />
								<Label Grid.Column="1" HorizontalTextAlignment="Center" Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="АКЦИИ" />
							</Grid>
							<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterScores}" Spacing="0">
								<BindableLayout.EmptyView>
									<Label Padding="12" FontSize="11" HorizontalOptions="Center" Text="Нема внесени скорови." TextColor="{StaticResource SparkTextMuted}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Grid RowDefinitions="Auto,1">
											<Grid Padding="10,6" ColumnDefinitions="*,44" ColumnSpacing="8">
												<Label FontSize="11" LineBreakMode="WordWrap" Text="{Binding .}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
												<Label Grid.Column="1" FontFamily="FASolid" FontSize="13" HorizontalOptions="Center" Text="&#xf1f8;" TextColor="#DC2626" VerticalOptions="Center">
													<Label.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveScoreCommand}" CommandParameter="{Binding .}" />
													</Label.GestureRecognizers>
												</Label>
											</Grid>
											<BoxView Grid.Row="1" HeightRequest="1" Color="{StaticResource SparkBorderSubtle}" />
										</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>
						</VerticalStackLayout>
					</Border>

									<Border
										BackgroundColor="White"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterFindings}" Spacing="0">
											<BindableLayout.EmptyView>
												<Label
													Padding="10,8"
													FontSize="11"
													Text="Нема внесени наоди."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="x:String">
													<Grid
														Padding="10,7"
														RowDefinitions="Auto,Auto"
														RowSpacing="6">
														<Label
															FontSize="12"
															LineBreakMode="WordWrap"
															Text="{Binding .}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<controls:FFButton
															Grid.Row="1"
															ButtonKind="Danger"
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveFindingCommand}"
															CommandParameter="{Binding .}"
															HeightRequestEx="30"
															HorizontalOptions="Start"
															Text="Избриши"
															WidthRequestEx="76" />
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</Border>
								</VerticalStackLayout>
							</Grid>

							<!--  ЗАКАЖУВАЊЕ НА СЛЕДЕН ТЕРМИН  -->
							<VerticalStackLayout Spacing="10">
								<controls:CrudSectionHeader
									Title="ЗАКАЖУВАЊЕ НА СЛЕДЕН ТЕРМИН"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />
								<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="11.5"
										Text="Закажи следна контрола"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
									<CheckBox IsChecked="{Binding ScheduleNextFollowUp, Mode=TwoWay}" VerticalOptions="Center" />
								</HorizontalStackLayout>
								<Grid
									ColumnDefinitions="Auto,130,Auto,180"
									ColumnSpacing="8"
									IsVisible="{Binding ScheduleNextFollowUp}">
									<Label
										FontSize="10"
										Text="Датум"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="0"
										BackgroundColor="White"
										HeightRequest="42"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="1">
										<DatePicker
											Date="{Binding NextFollowUpDate, Mode=TwoWay}"
											Format="dd.MM.yyyy"
											HorizontalOptions="Fill"
											MinimumDate="{Binding FollowUpMinimumDate}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
									<Label
										Grid.Column="2"
										FontSize="10"
										Text="Периодично избирање"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<controls:FFPicker
										Grid.Column="3"
										ItemsSource="{Binding FollowUpIntervalOptions}"
										Placeholder="Брзо избирање"
										SelectedItem="{Binding SelectedFollowUpInterval, Mode=TwoWay}" />
								</Grid>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</controls:CustomScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ПРЕГЛЕДИ + ИСТОРИЈА + ДОКУМЕНТИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="1"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<controls:CustomScrollView ScrollBarColor="{StaticResource SparkAccentTeal}">
						<VerticalStackLayout Style="{StaticResource CrudFormSidebarStackStyle}">

							<!--  Section: Последни прегледи  -->
							<controls:CrudSectionHeader
								Title="ПОСЛЕДНИ ПРЕГЛЕДИ"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за историја."
								TextColor="{StaticResource SparkTextSecondary}" />

							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding RecentEncounters}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема евидентирани прегледи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Encounter">
										<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
											<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
											<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
												<Border.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenEncounterCommand}" CommandParameter="{Binding .}" />
												</Border.GestureRecognizers>
												<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
													<VerticalStackLayout Spacing="2">
														<Label FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" Text="{Binding ClinicalNotes, TargetNullValue='Преглед без наведена причина'}" TextColor="{StaticResource SparkTextPrimary}" />
														<Label Style="{StaticResource CrudCollectionMetaStyle}" Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}" />
													</VerticalStackLayout>
													<Label Grid.Column="1" FontAttributes="Bold" FontSize="9.5" Text="{Binding Status}" TextColor="{StaticResource SparkAccentTealDark}" VerticalOptions="Center" />
												</Grid>
											</Border>
										</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<controls:CrudSectionHeader
								Title="ИСТОРИЈА НА ТЕРАПИИ"
								IsVisible="{Binding HasPatientContext}"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />
							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding PreviousMedicines}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема претходни терапии."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientMedicine">
										<Border
											Padding="10,8"
											BackgroundColor="{StaticResource SparkContentBackground}"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Grid ColumnDefinitions="2*,1.2*,1*" ColumnSpacing="12">
												<VerticalStackLayout Spacing="1">
													<Label
														FontAttributes="Bold"
														FontSize="12.5"
														Text="{Binding Medicine.BilingualName, TargetNullValue='—'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="10"
														Text="{Binding ApplicationRegime.Regime, TargetNullValue='—'}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<VerticalStackLayout Grid.Column="1" Spacing="1">
													<Label
														FontSize="10"
														Text="Период"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontSize="11.5"
														Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="11.5"
														Text="{Binding EndDate, StringFormat='{0:dd.MM.yyyy}'}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
												<VerticalStackLayout Grid.Column="2" Spacing="1">
													<Label
														FontSize="10"
														Text="Статус"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="11.5"
														Text="Завршена"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<controls:CrudSectionHeader
								Title="ИСТОРИЈА НА ДИЈАГНОЗИ"
								IsVisible="{Binding HasPatientContext}"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />
							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding PatientMkb10Assignments}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема претходни дијагнози."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientMkb10Assignment">
										<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
											<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
											<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
												<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
													<Label Style="{StaticResource CrudCollectionCodeStyle}" Text="{Binding Mkb10Code.Code}" />
													<Label Grid.Column="1" LineBreakMode="TailTruncation" Style="{StaticResource CrudCollectionMetaStyle}" Text="{Binding Mkb10Code.Description}" />
												</Grid>
											</Border>
										</Grid>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<!--  Section: Документи  -->
							<controls:CrudSectionHeader
								Title="ДОКУМЕНТИ НА ПАЦИЕНТ"
								IsVisible="{Binding HasPatientContext}"  LineColor="{StaticResource Gray600}" Style="{StaticResource CrudFormSectionHeaderStyle}" />

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за документи."
								TextColor="{StaticResource SparkTextSecondary}" />

							<Border
								Padding="10"
								BackgroundColor="{StaticResource SparkContentBackground}"
								IsVisible="{Binding LatestPatientDocument, Converter={StaticResource SparkNotNullConverter}}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12">
									<Border
										HeightRequest="90"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0"
										WidthRequest="110">
										<Image Aspect="AspectFill" Source="{Binding LatestPatientDocument.StoredPath}" />
									</Border>
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="4"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding LatestPatientDocument.Title}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.DocumentType}"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.UploadedAt, StringFormat='{0:dd.MM.yyyy}'}"
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="2"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding PreviewDocumentCommand}"
										CommandParameter="{Binding LatestPatientDocument}"
										ContentPadding="12,0"
										HeightRequestEx="38"
										Text="🔍 Отвори"
										TextColorEx="{StaticResource SidebarActiveText}"
										WidthRequestEx="110" />
								</Grid>
							</Border>

							<FlexLayout
								BindableLayout.ItemsSource="{Binding PatientDocuments}"
								Direction="Row"
								IsVisible="{Binding HasPatientContext}"
								JustifyContent="Start"
								Wrap="Wrap">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема прикачени документи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientDocument">
										<Border
											Margin="0,0,8,8"
											Padding="0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											HeightRequest="110"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1"
											WidthRequest="110">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid RowDefinitions="*,Auto" RowSpacing="0">
												<Grid Grid.Row="0" IsClippedToBounds="True">
													<Image
														Aspect="AspectFill"
														IsVisible="{Binding IsImageDocument}"
														Source="{Binding StoredPath}" />
													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														IsVisible="{Binding IsImageDocument, Converter={StaticResource InverseBoolConverter}}"
														StrokeThickness="0">
														<VerticalStackLayout
															HorizontalOptions="Center"
															Spacing="4"
															VerticalOptions="Center">
															<Label
																FontFamily="FASolid"
																FontSize="24"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTeal}" />
															<Label
																FontSize="8"
																HorizontalOptions="Center"
																Text="{Binding DocumentType}"
																TextColor="{StaticResource SparkAccentTealDark}" />
														</VerticalStackLayout>
													</Border>
													<Border
														Margin="4"
														Padding="4,3"
														BackgroundColor="#99000000"
														HorizontalOptions="End"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0"
														VerticalOptions="Start">
														<Label
															FontFamily="FASolid"
															FontSize="9"
															Text="&#xf00e;"
															TextColor="White" />
													</Border>
												</Grid>
												<Border
													Grid.Row="1"
													Padding="6,4"
													BackgroundColor="White"
													StrokeThickness="0">
													<VerticalStackLayout Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="9"
															LineBreakMode="TailTruncation"
															Text="{Binding Title}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="8"
															Text="{Binding DocumentType}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</FlexLayout>

						</VerticalStackLayout>
					</controls:CustomScrollView>
				</controls:FFSectionCard>

			</Grid>
			</Border>

			<!--  Footer  -->
			<Border
				Grid.Row="2"
				Margin="16,10,16,16"
				Padding="16,10"
				BackgroundColor="White"
				Stroke="{StaticResource SparkBorderSubtle}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
					<controls:FFButton
						Grid.Column="1"
						ButtonKind="Secondary"
						Command="{Binding CancelCommand}"
						HeightRequestEx="42"
						Text="Откажи"
						WidthRequestEx="130" />
					<controls:FFButton
						Grid.Column="2"
						BackgroundColorEx="{StaticResource SidebarActiveBg}"
						ButtonKind="Primary"
						Command="{Binding SaveCommand}"
						HeightRequestEx="42"
						IsEnabled="{Binding CanAdminEditEncounter}"
						Text="Зачувај"
						TextColorEx="White"
						WidthRequestEx="130" />
				</Grid>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
