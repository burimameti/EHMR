<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterEditViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="12">

			<!--  HEADER  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf044;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="Уреди дијагнози"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="Дозволени се промени само на МКБ дијагнози и забелешка"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Зачувај дијагнози" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  MAIN PANEL  -->
			<Grid
				Grid.Row="1"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="1">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМУЛАРИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="16" Spacing="24">

							<!--  ── СЕКЦИЈА 1: ПАЦИЕНТ И РЕУМАТОЛОГ (заклучено — прегледот веќе постои) ──  -->
                            <Border Padding="14,10" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="2">
                                        <Label FontSize="10" Text="ПРЕГЛЕД ЗА УРЕДУВАЊЕ" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Label FontAttributes="Bold" FontSize="13" Text="{Binding Encounter.EncounterNumber}" TextColor="{StaticResource SparkTextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label FontSize="10" Text="ПАЦИЕНТ" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Label FontAttributes="Bold" FontSize="13" Text="{Binding Encounter.Patient.FullName, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                                        <Label FontSize="10" Text="ДАТУМ И СТАТУС" TextColor="{StaticResource SparkTextSecondary}" />
                                        <Label FontAttributes="Bold" FontSize="12" Text="{Binding Encounter.EncounterDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}" TextColor="{StaticResource SparkTextPrimary}" />
                                        <Label FontSize="11" Text="{Binding EncounterStatusDisplay}" TextColor="{StaticResource SparkAccentTealDark}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>


							<!--  ── СЕКЦИЈА 2: ТИП И ПРИОРИТЕТ ────────────────────  -->
							<VerticalStackLayout IsVisible="False" Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ТИП И ПРИОРИТЕТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid RowDefinitions="Auto,Auto" RowSpacing="16">
									<Grid
										Grid.Row="0"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<controls:FFPicker
											Grid.Column="0"
											ItemsSource="{Binding EncounterTypeOptions}"
											Label="Тип на преглед"
											Placeholder="Изберете тип"
											SelectedItem="{Binding EncounterTypeDisplay}" />
										<controls:FFPicker
											Grid.Column="1"
											ItemsSource="{Binding PriorityOptions}"
											Label="Приоритет"
											Placeholder="Изберете приоритет"
											SelectedItem="{Binding PriorityDisplay}" />
									</Grid>

									<Grid
										Grid.Row="1"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<Grid
											Grid.Column="0"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Датум на преглед"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Grid.Row="1"
												Padding="10,0"
												BackgroundColor="{StaticResource SparkBackground}"
												HeightRequest="46"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<DatePicker
													BackgroundColor="Transparent"
													Date="{Binding ScheduledStartDate}"
													FontSize="13"
													TextColor="{StaticResource SparkTextPrimary}"
													VerticalOptions="Center" />
											</Border>
										</Grid>

										<Grid
											Grid.Column="1"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Време"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Grid.Row="1"
												Padding="10,0"
												BackgroundColor="{StaticResource SparkBackground}"
												HeightRequest="46"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<TimePicker
													BackgroundColor="Transparent"
													FontSize="13"
													TextColor="{StaticResource SparkTextPrimary}"
													Time="{Binding ScheduledStartTime}"
													VerticalOptions="Center" />
											</Border>
										</Grid>
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  ── СЕКЦИЈА 3: ДЕТАЛИ ЗА ПРЕГЛЕДОТ ───────────────  -->
							<VerticalStackLayout IsVisible="False" Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
									<Grid
										Grid.Column="0"
										RowDefinitions="Auto,Auto"
										RowSpacing="8"
										VerticalOptions="Start">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Причина за посета *"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Grid.Row="1"
											Padding="12,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkAccentTealBg}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Редовна контрола"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ReasonForVisit}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>

									<Grid
										Grid.Column="1"
										RowDefinitions="Auto,Auto"
										RowSpacing="8"
										VerticalOptions="Start">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Клинички белешки"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Grid.Row="1"
											Padding="12,8"
											BackgroundColor="{StaticResource SparkBackground}"
											Stroke="{StaticResource SparkAccentTealBg}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												MinimumHeightRequest="46"
												Placeholder="Внесете детален извештај..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ClinicalNotes}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  ── СЕКЦИЈА 4: МКБ-10 ДИЈАГНОСТИКА ───────────────  -->
							<VerticalStackLayout Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="МКБ-10 ДИЈАГНОСТИКА"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
									<VerticalStackLayout Grid.Column="0" Spacing="12">
										<controls:FFSearchBox Placeholder="Внесете шифра или назив на МКБ 10..." Text="{Binding MkbSearchText, Mode=TwoWay}" />
										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMkbDropdown}"
											ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="14">
                                        <VerticalStackLayout
                                            BindableLayout.ItemsSource="{Binding Diagnoses}"
                                            Spacing="8">
                                            <BindableLayout.EmptyView>
                                                <Label FontSize="12" Text="Нема доделени дијагнози." TextColor="{StaticResource SparkTextSecondary}" />
                                            </BindableLayout.EmptyView>
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="entities:Diagnosis">
                                                    <Border Padding="12,10" BackgroundColor="#F8FAFC" Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                                            <Border Padding="9,5" BackgroundColor="{StaticResource SparkAccentTealBg}" StrokeShape="RoundRectangle 6" StrokeThickness="0" VerticalOptions="Start">
                                                                <Label FontAttributes="Bold" FontSize="13" Text="{Binding Mkb10Code.Code}" TextColor="{StaticResource SparkAccentTealDark}" />
                                                            </Border>
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                <Label FontSize="10" Text="ОПИС НА ДИЈАГНОЗА" TextColor="{StaticResource SparkTextSecondary}" />
                                                                <Label FontSize="12" LineBreakMode="WordWrap" Text="{Binding Mkb10Code.Description}" TextColor="{StaticResource SparkTextPrimary}" />
                                                            </VerticalStackLayout>
                                                            <Button Grid.Column="2" Padding="0" BackgroundColor="Transparent" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}" CommandParameter="{Binding .}" FontSize="13" HeightRequest="30" Text="✕" TextColor="#DC2626" VerticalOptions="Center" WidthRequest="30" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

										<VerticalStackLayout Spacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Забелешка за дијагнозата"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Padding="12,8"
												BackgroundColor="{StaticResource SparkBackground}"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Editor
													AutoSize="TextChanges"
													BackgroundColor="Transparent"
													FontSize="13"
													MinimumHeightRequest="46"
													Placeholder="Забелешки надвор од МКБ..."
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding EncounterDiagnosisNotes}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  ── СЕКЦИЈА 5: ЛЕКОВИ ─────────────────────────────  -->
							<VerticalStackLayout IsVisible="False" Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ЛЕКОВИ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
									<VerticalStackLayout Grid.Column="0" Spacing="12">
										<controls:FFSearchBox Placeholder="Пребарај лек по име, генерик или код..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />
										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMedicineDropdown}"
											ItemsSource="{Binding MedicineResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Medicine">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Name}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding GenericName}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="10">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Додадени за овој преглед"
											TextColor="{StaticResource SparkTextSecondary}" />
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="8">
											<BindableLayout.EmptyView>
												<Label
													FontSize="12"
													Text="Нема додадени лекови за овој преглед."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:PatientMedicine">
													<Border
														Padding="10,8"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														Stroke="{StaticResource SparkAccentTeal}"
														StrokeShape="RoundRectangle 10">
														<Grid
															ColumnDefinitions="*,Auto"
															ColumnSpacing="10"
															RowDefinitions="Auto,Auto"
															RowSpacing="6">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Medicine.Name}"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center" />
															<Button
																Grid.Column="1"
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
																CommandParameter="{Binding .}"
																CornerRadius="9"
																FontSize="10"
																HeightRequest="18"
																Text="✕"
																TextColor="{StaticResource SparkAccentTealDark}"
																WidthRequest="18" />
															<Border
																Grid.Row="1"
																Grid.ColumnSpan="2"
																Padding="10,0"
																BackgroundColor="{StaticResource SparkBackground}"
																HeightRequest="36"
																Stroke="{StaticResource SparkAccentTealBg}"
																StrokeShape="RoundRectangle 6"
																StrokeThickness="1">
																<Entry
																	FontSize="12"
																	Keyboard="Numeric"
																	Placeholder="Количина"
																	PlaceholderColor="{StaticResource SparkTextSecondary}"
																	Text="{Binding Dosage}"
																	TextColor="{StaticResource SparkTextPrimary}"
																	VerticalOptions="Center" />
															</Border>
														</Grid>
													</Border>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ТЕРМИН + ЦИКЛУС + ПАЦИЕНТ КОНТЕКСТ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Grid
				    IsVisible="False"
					Grid.Column="1"
					ColumnSpacing="1"
					RowDefinitions="Auto,*"
					RowSpacing="10">
					<!--  Поврзување со термин и циклус  -->
					<Border Style="{StaticResource PageHeaderCardStyle}">
						<VerticalStackLayout>

							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="16"
									Text="ПОВРЗУВАЊЕ СО ТЕРМИН/ЦИКЛУС"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Grid ColumnDefinitions="*,Auto">
								<VerticalStackLayout Grid.Column="0" Spacing="8">
									<controls:FFSearchBox Placeholder="Пребарај термин..." Text="{Binding AppointmentSearchText, Mode=TwoWay}" />
									<CollectionView
										HeightRequest="80"
										IsVisible="{Binding ShowAppointmentDropdown}"
										ItemsSource="{Binding AppointmentSearchResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:Appointment">
												<Border
													Margin="0,2"
													Padding="8"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectAppointmentCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<VerticalStackLayout Spacing="2">
														<Label
															FontAttributes="Bold"
															FontSize="11"
															Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															FontSize="10"
															LineBreakMode="TailTruncation"
															Text="{Binding ReasonForVisit}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>

									<controls:FFSearchBox Placeholder="Пребарај циклус..." Text="{Binding CycleSearchText, Mode=TwoWay}" />
									<CollectionView
										HeightRequest="80"
										IsVisible="{Binding ShowCycleDropdown}"
										ItemsSource="{Binding CycleSearchResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:TherapyCycle">
												<Border StrokeShape="RoundRectangle 6" Style="{StaticResource PageHeaderCardStyle}">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectTherapyCycleCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<Label
														FontSize="11"
														LineBreakMode="TailTruncation"
														Text="{Binding Notes}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>

								<VerticalStackLayout
									Grid.Column="1"
									Padding="10"
									Spacing="20"
									VerticalOptions="End">
									<controls:FFButton
										ButtonKind="Secondary"
										Command="{Binding AddNewAppointmentCommand}"
										ContentPadding="10,0"
										HeightRequestEx="38"
										Text="+ Нов термин" />
									<controls:FFButton
										ButtonKind="Secondary"
										Command="{Binding AddNewTherapyCycleCommand}"
										ContentPadding="10,0"
										HeightRequestEx="38"
										Text="+ Нов циклус" />
								</VerticalStackLayout>
							</Grid>

							<!--  Избран термин — резиме  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasAppointment}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<VerticalStackLayout Spacing="2">
									<Label
										FontSize="11"
										Text="Поврзан термин"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding AppointmentDisplay}"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</VerticalStackLayout>
							</Border>

							<!--  Избран циклус — резиме  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasTherapyCycle}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<VerticalStackLayout Spacing="2">
									<Label
										FontSize="11"
										Text="Терапевтски циклус"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="{Binding TherapyCycleDisplay}"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>
					</Border>

					<!--  Пациент контекст  -->
					<Border Grid.Row="1" Style="{StaticResource PageHeaderCardStyle}">
						<ScrollView VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="16" Spacing="16">

								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="16"
										Text="ПОДАТОЦИ ЗА ПАЦИЕНТОТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
									<Border
										BackgroundColor="{StaticResource SparkAccentTealBg}"
										HeightRequest="44"
										StrokeShape="RoundRectangle 22"
										StrokeThickness="0"
										WidthRequest="44">
										<Label
											FontFamily="FASolid"
											FontSize="16"
											HorizontalOptions="Center"
											Text="&#xf007;"
											TextColor="{StaticResource SparkAccentTealDark}"
											VerticalOptions="Center" />
									</Border>
									<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
										<Label
											FontSize="11"
											Text="Избран Пациент"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="15"
											LineBreakMode="WordWrap"
											Text="{Binding SelectedPatient.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>
								</Grid>

								<Grid
									ColumnDefinitions="Auto,*"
									ColumnSpacing="12"
									IsVisible="{Binding SelectedDoctor}">
									<Border
										BackgroundColor="{StaticResource SparkAccentTealBg}"
										HeightRequest="44"
										StrokeShape="RoundRectangle 22"
										StrokeThickness="0"
										WidthRequest="44">
										<Label
											FontFamily="FASolid"
											FontSize="16"
											HorizontalOptions="Center"
											Text="&#xf0f0;"
											TextColor="{StaticResource SparkAccentTealDark}"
											VerticalOptions="Center" />
									</Border>
									<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
										<Label
											FontSize="11"
											Text="Матичен Реуматолог"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="14"
											LineBreakMode="WordWrap"
											Text="{Binding SelectedDoctor.FullName}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
								</Grid>

								<ActivityIndicator
									Margin="0,12"
									HorizontalOptions="Center"
									IsRunning="{Binding IsPatientLoading}"
									IsVisible="{Binding IsPatientLoading}"
									Color="{StaticResource SparkAccentTeal}" />

								<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="12">
									<controls:SparkExpandableCard
										Title="Дијагнози"
										Subtitle="Историја"
										Variant="Diagnosis" />
									<controls:SparkExpandableCard
										Title="Прегледи"
										Subtitle="Посети"
										Variant="Encounter" />
									<controls:SparkExpandableCard
										Title="Термини"
										Subtitle="Закажани"
										Variant="Appointment" />
									<controls:SparkExpandableCard Title="Терапевтски циклуси" Variant="TherapyCycle" />
									<controls:SparkExpandableCard Title="Рецепти" Variant="Prescription" />
									<controls:SparkExpandableCard Title="Терапии со лекови" Variant="Medicine" />
								</VerticalStackLayout>

							</VerticalStackLayout>
						</ScrollView>
					</Border>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
