<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterEditPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="viewModels:EncounterEditViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<Grid ColumnDefinitions="285,*">

		<!--  Лево мени (Странична лента)  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  Десен главен контејнер  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			RowDefinitions="Auto,*"
			RowSpacing="6">

			<!--  ============================================================  -->
			<!--  HEADER PANEL  -->
			<!--  ============================================================  -->
			<Border
				Padding="20,16"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf0f1;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="{Binding PageTitle}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="Ажурирајте ги основните и медицинските детали за прегледот"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="💾 Зачувај преглед" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  ============================================================  -->
			<!--  MAIN PANEL  -->
			<!--  ============================================================  -->
			<Grid
				Grid.Row="1"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="19">

				<!--  ЛЕВА КОЛОНА — Форма за уредување  -->
				<Border
					BackgroundColor="{StaticResource SparkBackground}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="0">

					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="10" Spacing="6">

							<!--  =====================================================  -->
							<!--  ПАЦИЕНТ И ЛЕКАР  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">

								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ПАЦИЕНТ И ЛЕКАР"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
									<controls:FFPicker
										Grid.Column="0"
										ItemsSource="{Binding Patients}"
										Label="Пациент"
										Placeholder="Изберете пациент *"
										SelectedItem="{Binding SelectedPatient}" />

									<controls:FFPicker
										Grid.Column="1"
										ItemsSource="{Binding Doctors}"
										Label="Лекар"
										Placeholder="Изберете матичен реуматолог"
										SelectedItem="{Binding SelectedDoctor}" />
								</Grid>
							</VerticalStackLayout>

							<!--  =====================================================  -->
							<!--  ДЕТАЛИ ЗА ПРЕГЛЕДОТ  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

									<Grid
										Grid.Column="0"
										RowDefinitions="Auto,Auto"
										RowSpacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Причина за посета *"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Grid.Row="1"
											Padding="12,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkAccentTealBg}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Border.Shadow>
												<Shadow
													Brush="Black"
													Opacity="0.06"
													Radius="6"
													Offset="0,2" />
											</Border.Shadow>
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Редовна контрола, Главоболка"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ReasonForVisit}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>

									<Grid
										Grid.Column="1"
										RowDefinitions="Auto,Auto"
										RowSpacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Клинички белешки"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Grid.Row="1"
											Padding="12,8"
											BackgroundColor="{StaticResource SparkBackground}"
											Stroke="{StaticResource SparkAccentTealBg}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Border.Shadow>
												<Shadow
													Brush="Black"
													Opacity="0.06"
													Radius="6"
													Offset="0,2" />
											</Border.Shadow>
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Внесете детален извештај од прегледот..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ClinicalNotes}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  =====================================================  -->
							<!--  МКБ-10 ДИЈАГНОСТИКА  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="МКБ-10 ДИЈАГНОСТИКА"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

									<!--  Лева колона: Пребарување  -->
									<VerticalStackLayout Grid.Column="0" Spacing="12">
										<controls:FFSearchBox Placeholder="Внесете шифра или назив на МКБ 10 (Пр. I10)..." Text="{Binding MkbSearchText, Mode=TwoWay}" />

										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMkbDropdown}"
											ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<!--  Десна колона: Избрани чипови  -->
									<VerticalStackLayout Grid.Column="1" Spacing="8">
										<FlexLayout
											BindableLayout.ItemsSource="{Binding Diagnoses}"
											Direction="Row"
											JustifyContent="Start"
											Wrap="Wrap">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:Diagnosis">
													<Border
														Margin="0,0,8,8"
														Padding="10,6"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														Stroke="{StaticResource SparkAccentTeal}"
														StrokeShape="RoundRectangle 14">
														<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Mkb10Code.Code}"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center" />
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
																CommandParameter="{Binding .}"
																CornerRadius="9"
																FontSize="10"
																HeightRequest="18"
																Text="✕"
																TextColor="{StaticResource SparkAccentTealDark}"
																WidthRequest="18" />
														</HorizontalStackLayout>
													</Border>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</FlexLayout>

										<Label
											FontSize="13"
											IsVisible="{Binding Diagnoses.Count, Converter={StaticResource InvertedBoolConverter}}"
											Text="Нема доделени дијагнози за овој преглед."
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  =====================================================  -->
							<!--  СТАТУС НА ПРЕГЛЕД  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="СТАТУС НА ПРЕГЛЕД"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<controls:FFPicker
									HorizontalOptions="Start"
									ItemsSource="{Binding StatusOptions}"
									Label="Статус"
									Placeholder="Изберете статус"
									SelectedItem="{Binding StatusDisplay}"
									WidthRequest="280" />
							</VerticalStackLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

				<!--  ДЕСНА КОЛОНА — Пациент контекст + историски картички  -->
				<Grid Grid.Column="1" RowDefinitions="Auto,*">

					<Border
						BackgroundColor="{StaticResource SparkBackground}"
						StrokeShape="RoundRectangle 12"
						StrokeThickness="0"
						VerticalOptions="Start">

						<Grid
							Padding="16,14"
							RowDefinitions="Auto,Auto,Auto"
							VerticalOptions="Center">

							<Border
								Grid.Row="0"
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								HorizontalOptions="Start"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="12"
									Text="ПОДАТОЦИ ЗА ПАЦИЕНТОТ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<HorizontalStackLayout
								Grid.Row="1"
								Padding="22"
								Spacing="16">
								<Border
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									HeightRequest="60"
									HorizontalOptions="Start"
									StrokeShape="RoundRectangle 21"
									StrokeThickness="0"
									WidthRequest="60">
									<Label
										FontFamily="FASolid"
										FontSize="15"
										HorizontalOptions="Center"
										Text="&#xf007;"
										TextColor="{StaticResource SparkAccentTealDark}"
										VerticalOptions="Center" />
								</Border>
								<Label
									FontAttributes="Bold"
									FontSize="16"
									LineBreakMode="TailTruncation"
									Text="{Binding SelectedPatient.FullName, TargetNullValue='Изберете пациент'}"
									TextColor="{StaticResource SparkTextPrimary}"
									VerticalOptions="Center" />
							</HorizontalStackLayout>

							<HorizontalStackLayout
								Grid.Row="2"
								Padding="10"
								IsVisible="{Binding SelectedDoctor}"
								Spacing="6"
								VerticalOptions="Center">
								<Grid RowDefinitions="*,*">
									<Label
										FontFamily="FASolid"
										FontSize="18"
										Text="&#xf0f0; Матичен РЕУМАТОЛОГ"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<Label
										Grid.Row="1"
										FontAttributes="Bold"
										FontSize="18"
										LineBreakMode="TailTruncation"
										Text="{Binding SelectedDoctor.FullName}"
										TextColor="{StaticResource SparkAccentTealDark}"
										VerticalOptions="Center" />
								</Grid>
							</HorizontalStackLayout>
						</Grid>
					</Border>

					<Border
						Grid.Row="1"
						Margin="0,1,0,0"
						BackgroundColor="{StaticResource SparkBackground}"
						StrokeShape="RoundRectangle 12"
						StrokeThickness="0"
						VerticalOptions="Fill">
						<ScrollView VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="10" Spacing="16">
								<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="16">

									<controls:SparkExpandableCard
										Title="Дијагнози"
										Subtitle="Историја"
										Variant="Diagnosis" />

									<controls:SparkExpandableCard
										Title="Прегледи"
										Subtitle="Посети"
										Variant="Encounter" />

									<controls:SparkExpandableCard
										Title="Термини"
										Subtitle="Закажани"
										Variant="Appointment" />

									<controls:SparkExpandableCard Title="Терапевтски циклуси" Variant="TherapyCycle" />

									<controls:SparkExpandableCard Title="Рецепти" Variant="Prescription" />

									<controls:SparkExpandableCard Title="Терапии со лекови" Variant="Medicine" />

								</VerticalStackLayout>
							</VerticalStackLayout>
						</ScrollView>
					</Border>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
