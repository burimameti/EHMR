<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterCreateViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="260,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*,Auto"
			Style="{StaticResource CrudFormPageGridStyle}">

			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader Title="Внесување на нов преглед" Subtitle="Внесете ги основните и медицинските детали за тековниот преглед">
					<controls:FFPageHeader.HeaderContent>
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							HeightRequestEx="40"
							Text="Назад"
							WidthRequestEx="130" />
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

			<Grid
				Grid.Row="1"
				ColumnDefinitions="2*,0.6*"
				Style="{StaticResource CrudFormBodyGridStyle}">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard Grid.Column="0" Margin="0">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">

							<!--  ── 1. ПАЦИЕНТ И РЕУМАТОЛОГ ─────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<!--  Section header  -->
								<controls:CrudSectionHeader
									Title="ПАЦИЕНТ И РЕУМАТОЛОГ"
									Padding="8,5"
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									LineColor="{StaticResource SparkAccentTeal}"
									TextColor="{StaticResource SparkTextPrimary}" />

								<!--  Locked context display  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="12"
									IsVisible="{Binding IsPatientLockedFromContext}">
									<Border
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Избран пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<Border
										Grid.Column="1"
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Матичен реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  Patient search (hidden when locked)  -->
								<VerticalStackLayout Spacing="8">
									<VerticalStackLayout.Triggers>
										<DataTrigger
											Binding="{Binding IsPatientLockedFromContext}"
											TargetType="VerticalStackLayout"
											Value="True">
											<Setter Property="IsVisible" Value="False" />
										</DataTrigger>
									</VerticalStackLayout.Triggers>

									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<controls:FFSearchBox Placeholder="Пребарај по име, ЕМБГ или СЗБО..." Text="{Binding PatientSearchText, Mode=TwoWay}" />
										<HorizontalStackLayout
											Grid.Column="1"
											Spacing="4"
											VerticalOptions="Center">
											<CheckBox IsChecked="{Binding UseCyrillicPatientSearch, Mode=TwoWay}" />
											<Label
												FontSize="12"
												Text="Кирилица"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Grid>

									<!--  Autocomplete dropdown  -->
									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowPatientSuggestions}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView
											HeightRequest="164"
											ItemsSource="{Binding PatientSuggestions}"
											SelectedItem="{Binding PatientSuggestionSelection, Mode=TwoWay}"
											SelectionMode="Single">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Patient">
													<Border
														Margin="1"
														Padding="10,7"
														BackgroundColor="#F8FAFC"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 7"
														StrokeThickness="1">
														<Grid ColumnDefinitions="2*,1.2*" ColumnSpacing="12">
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
															<VerticalStackLayout Grid.Column="1" Spacing="1">
																<Label
																	FontSize="9.5"
																	Text="СЗБО број"
																	TextColor="{StaticResource SparkTextSecondary}" />
																<Label
																	FontAttributes="Bold"
																	FontSize="11.5"
																	Text="{Binding SzboNumber}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
															</VerticalStackLayout>
														</Grid>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>
								</VerticalStackLayout>

								<!--  Основни податоци за пациентот  -->
								<Border
									Padding="14"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									IsVisible="{Binding HasPatientContext}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="0">
									<Grid
										ColumnDefinitions="1.4*,1*,1*,1.4*"
										ColumnSpacing="14"
										RowDefinitions="Auto,Auto,Auto"
										RowSpacing="6">
										<Label
											Grid.ColumnSpan="4"
											FontAttributes="Bold"
											FontSize="15"
											LineBreakMode="TailTruncation"
											Text="{Binding SelectedPatient.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<VerticalStackLayout
											Grid.Row="1"
											Grid.Column="0"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Датум на раѓање"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>

										<VerticalStackLayout
											Grid.Row="1"
											Grid.Column="2"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Пол"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.Gender}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.Row="1"
											Grid.Column="3"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Адреса"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedPatient.Address, TargetNullValue='—'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.Row="2"
											Grid.Column="0"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Телефон"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.Row="2"
											Grid.Column="1"
											Spacing="1">
											<Label
												FontSize="10"
												Text="ЕЗБО"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												Text="{Binding SelectedPatient.SzboNumber, TargetNullValue='—'}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</VerticalStackLayout>
										<VerticalStackLayout
											Grid.Row="2"
											Grid.Column="2"
											Grid.ColumnSpan="2"
											Spacing="1">
											<Label
												FontSize="10"
												Text="Матичен реуматолог"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Label
												FontAttributes="Bold"
												FontSize="12"
												LineBreakMode="TailTruncation"
												Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</VerticalStackLayout>

							<!--  БИОЛОШКА ТЕРАПИЈА  -->
							<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="10">
								<controls:CrudSectionHeader
									Title="БИОЛОШКА ТЕРАПИЈА"
									Padding="8,5"
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									LineColor="{StaticResource SparkAccentTeal}"
									TextColor="{StaticResource SparkTextPrimary}" />

								<Grid
									ColumnDefinitions="1.25*,1*"
									ColumnSpacing="20"
									RowDefinitions="Auto,Auto"
									RowSpacing="10">
									<VerticalStackLayout
										Grid.Row="0"
										Grid.Column="0"
										Spacing="2">
										<Label
											FontSize="10"
											Text="МКБ-10 дијагноза"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="11.5"
											LineBreakMode="WordWrap"
											Text="{Binding CurrentDiagnosesSummary, TargetNullValue='Нема внесена дијагноза.'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="0"
										Grid.Column="1"
										Spacing="2">
										<Label
											FontSize="10"
											Text="Претходен скор"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="11.5"
											Text="{Binding CurrentPatientScore, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="0"
										Spacing="2">
										<Label
											FontSize="10"
											Text="Активна терапија"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="11.5"
											LineBreakMode="WordWrap"
											Text="{Binding ActiveMedicinesSummary, TargetNullValue='Нема активна терапија.'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="1"
										Spacing="2">
										<Label
											FontSize="10"
											Text="Забелешка"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="11.5"
											LineBreakMode="WordWrap"
											Text="{Binding EncounterDiagnosisNotes, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>


							<!--  ЛЕКОВИ + СКОРОВИ  -->
							<Grid ColumnDefinitions="4*,1*" ColumnSpacing="14">
								<VerticalStackLayout Grid.Column="0" Spacing="10">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
										<controls:CrudSectionHeader
											Title="ТЕКОВНА ТЕРАПИЈА"
											Grid.Column="0"
											Padding="8,5"
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											LineColor="{StaticResource SparkAccentTeal}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Button
											Grid.Column="1"
											Padding="12,0"
											BackgroundColor="{StaticResource SparkButtonSecondaryBg}"
											Command="{Binding AddApplicationRegimeCommand}"
											CornerRadius="6"
											FontAttributes="Bold"
											FontSize="10.5"
											Text="+ Нов начин"
											TextColor="White"
											VerticalOptions="Center" />
									</Grid>
									<controls:FFSearchBox Placeholder="Додај лек во тековната терапија..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />
									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowMedicineDropdown}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView HeightRequest="180" ItemsSource="{Binding MedicineResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Medicine">
													<Border
														Padding="10,7"
														BackgroundColor="Transparent"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="1">
															<Label
																FontAttributes="Bold"
																FontSize="12.5"
																Text="{Binding Name}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="10.5"
																Text="{Binding GenericName}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>
									<Grid
										ColumnDefinitions="1.45*,1*,1.35*,0.85*,95"
										ColumnSpacing="1"
										IsVisible="{Binding HasEncounterMedicines}">
										<Border
											Padding="8,7"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="ЛЕК"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="1"
											Padding="8,7"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="ДОЗА"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="2"
											Padding="8,7"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="НАЧИН НА АПЛИКАЦИЈА"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="3"
											Padding="8,7"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="9.5"
												Text="КОЛИЧИНА"
												TextColor="White" />
										</Border>
										<Border
											Grid.Column="4"
											Padding="0"
											BackgroundColor="#475569"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="8"
												HorizontalOptions="Center"
												Text="ТЕКОВНА"
												TextColor="White"
												VerticalOptions="Center" />
										</Border>
									</Grid>
									<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
										<BindableLayout.EmptyView>
											<Label
												FontSize="12"
												Text="Нема избран лек."
												TextColor="{StaticResource SparkTextSecondary}" />
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:PatientMedicine">
												<Grid ColumnDefinitions="1.45*,1*,1.35*,0.85*,95" ColumnSpacing="1">
													<Border
														Padding="8,0"
														BackgroundColor="White"
														HeightRequest="42"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Label
															FontSize="11.5"
															LineBreakMode="TailTruncation"
															Text="{Binding Medicine.Name}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />
													</Border>
													<Border
														Grid.Column="1"
														Padding="4,0"
														BackgroundColor="White"
														HeightRequest="42"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Entry
															BackgroundColor="Transparent"
															FontSize="11.5"
															Keyboard="Numeric"
															Text="{Binding Dosage, Mode=TwoWay}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />
													</Border>
													<Border
														Grid.Column="2"
														Padding="0"
														BackgroundColor="White"
														HeightRequest="42"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<controls:FFPicker
															ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}"
															MinimumWidthRequest="110"
															SelectedItem="{Binding ApplicationRegimeDisplay, Mode=TwoWay}" />
													</Border>
													<Border
														Grid.Column="3"
														Padding="4,0"
														BackgroundColor="White"
														HeightRequest="42"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<Entry
															BackgroundColor="Transparent"
															FontSize="11.5"
															Keyboard="Numeric"
															Text="{Binding Quantity, Mode=TwoWay}"
															TextColor="{StaticResource SparkTextPrimary}"
															VerticalOptions="Center" />
													</Border>
													<Border
														Grid.Column="4"
														BackgroundColor="White"
														HeightRequest="42"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeThickness="1">
														<HorizontalStackLayout HorizontalOptions="Center" Spacing="4" VerticalOptions="Center">
										<CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" IsEnabled="{Binding Source={x:Reference PageRoot}, Path=BindingContext.CanUpdate}" />
										<controls:FFButton ButtonKind="Danger" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}" CommandParameter="{Binding .}" HeightRequestEx="32" Text="Избриши" WidthRequestEx="78" />
									</HorizontalStackLayout>
													</Border>
												</Grid>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</VerticalStackLayout>
								</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="1" Spacing="10">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
        <Label FontAttributes="Bold" FontSize="13" Text="СКОРОВИ" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
        <controls:FFButton Grid.Column="1" ButtonKind="Primary" Command="{Binding AddScoreCommand}" HeightRequestEx="34" Text="+ Додади скор" WidthRequestEx="112" />
        <controls:FFButton Grid.Column="2" ButtonKind="Secondary" Command="{Binding AddFindingCommand}" HeightRequestEx="34" Text="+ Додади наод" WidthRequestEx="112" />
    </Grid>
    <Label FontSize="10" Text="Внесените скорови и наоди се прикажуваат подолу." TextColor="{StaticResource SparkTextSecondary}" />
    <Border BackgroundColor="White" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterScores}" Spacing="0">
            <BindableLayout.EmptyView>
                <Label Padding="10,8" FontSize="11" Text="Нема внесени скорови." TextColor="{StaticResource SparkTextSecondary}" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,7" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label FontSize="12" Text="{Binding .}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
                        <controls:FFButton Grid.Column="1" ButtonKind="Danger" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveScoreCommand}" CommandParameter="{Binding .}" HeightRequestEx="30" Text="Избриши" WidthRequestEx="76" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </Border>
    <Border BackgroundColor="White" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterFindings}" Spacing="0">
            <BindableLayout.EmptyView>
                <Label Padding="10,8" FontSize="11" Text="Нема внесени наоди." TextColor="{StaticResource SparkTextSecondary}" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10,7" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label FontSize="12" LineBreakMode="WordWrap" Text="{Binding .}" TextColor="{StaticResource SparkTextPrimary}" />
                        <controls:FFButton Grid.Column="1" ButtonKind="Danger" Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveFindingCommand}" CommandParameter="{Binding .}" HeightRequestEx="30" Text="Избриши" WidthRequestEx="76" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </Border>
</VerticalStackLayout>
</Grid>
<!--  ЗАКАЖУВАЊЕ НА СЛЕДЕН ТЕРМИН  -->
							<VerticalStackLayout Spacing="10">
								<controls:CrudSectionHeader
									Title="ЗАКАЖУВАЊЕ НА СЛЕДЕН ТЕРМИН"
									Padding="8,5"
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									LineColor="{StaticResource SparkAccentTeal}"
									TextColor="{StaticResource SparkTextPrimary}" />
								<HorizontalStackLayout Spacing="6" VerticalOptions="Center">
									<Label
										FontAttributes="Bold"
										FontSize="11.5"
										Text="Закажи следна контрола"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
									<CheckBox IsChecked="{Binding ScheduleNextFollowUp, Mode=TwoWay}" VerticalOptions="Center" />
								</HorizontalStackLayout>
								<Grid
									ColumnDefinitions="Auto,130,Auto,180"
									ColumnSpacing="8"
									IsVisible="{Binding ScheduleNextFollowUp}">
									<Label
										FontSize="10"
										Text="Датум"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Border
										Grid.Column="1"
										Padding="0"
										BackgroundColor="White"
										HeightRequest="42"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="1">
										<DatePicker
											Date="{Binding NextFollowUpDate, Mode=TwoWay}"
											Format="dd.MM.yyyy"
											HorizontalOptions="Fill"
											MinimumDate="{Binding FollowUpMinimumDate}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
									<Label
										Grid.Column="2"
										FontSize="10"
										Text="Периодично избирање"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<controls:FFPicker
										Grid.Column="3"
										ItemsSource="{Binding FollowUpIntervalOptions}"
										Placeholder="Брзо избирање"
										SelectedItem="{Binding SelectedFollowUpInterval, Mode=TwoWay}" />
								</Grid>
							</VerticalStackLayout>



						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ТЕРМИН/ЦИКЛУС + ПРЕГЛЕДИ + ДОКУМЕНТИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="1"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormSidebarStackStyle}">

							<!--  Section: Последни прегледи  -->
							<controls:CrudSectionHeader
								Title="ПОСЛЕДНИ ПРЕГЛЕДИ"
								Padding="8,5"
								BackgroundColor="{StaticResource SparkAccentTealBg}"
								LineColor="{StaticResource SparkAccentTeal}"
								TextColor="{StaticResource SparkTextPrimary}" />

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за историја."
								TextColor="{StaticResource SparkTextSecondary}" />

							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding RecentEncounters}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема евидентирани прегледи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Encounter">
										<Border
											Padding="12,10"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenEncounterCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
												<Border
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													HeightRequest="32"
													StrokeShape="RoundRectangle 16"
													StrokeThickness="0"
													WidthRequest="32">
													<Label
														FontFamily="FASolid"
														FontSize="11"
														HorizontalOptions="Center"
														Text="&#xf0f1;"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="2"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="12"
														LineBreakMode="TailTruncation"
														Text="{Binding ClinicalNotes, TargetNullValue='Преглед без наведена причина'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="10"
														Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<Border
													Grid.Column="2"
													Padding="8,3"
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="9"
														Text="{Binding Status}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<controls:CrudSectionHeader
								Title="ИСТОРИЈА НА ТЕРАПИИ"
								Padding="8,5"
								BackgroundColor="{StaticResource SparkAccentTealBg}"
								IsVisible="{Binding HasPatientContext}"
								LineColor="{StaticResource SparkAccentTeal}"
								TextColor="{StaticResource SparkTextPrimary}" />
							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding PreviousMedicines}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема претходни терапии."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientMedicine">
										<Border
											Padding="10,8"
											BackgroundColor="{StaticResource SparkContentBackground}"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Grid ColumnDefinitions="2*,1.2*,1*" ColumnSpacing="12">
												<VerticalStackLayout Spacing="1">
													<Label
														FontAttributes="Bold"
														FontSize="12.5"
														Text="{Binding Medicine.Name, TargetNullValue='—'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="10"
														Text="{Binding ApplicationRegime.Regime, TargetNullValue='—'}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<VerticalStackLayout Grid.Column="1" Spacing="1">
													<Label
														FontSize="10"
														Text="Период"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontSize="11.5"
														Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="11.5"
														Text="{Binding EndDate, StringFormat='{0:dd.MM.yyyy}'}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</VerticalStackLayout>
												<VerticalStackLayout Grid.Column="2" Spacing="1">
													<Label
														FontSize="10"
														Text="Статус"
														TextColor="{StaticResource SparkTextSecondary}" />
													<Label
														FontAttributes="Bold"
														FontSize="11.5"
														Text="Завршена"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<controls:CrudSectionHeader
								Title="ИСТОРИЈА НА ДИЈАГНОЗИ"
								Padding="8,5"
								BackgroundColor="{StaticResource SparkAccentTealBg}"
								IsVisible="{Binding HasPatientContext}"
								LineColor="{StaticResource SparkAccentTeal}"
								TextColor="{StaticResource SparkTextPrimary}" />
							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding PatientDiagnoses}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема претходни дијагнози."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Diagnosis">
										<Border
											Padding="10,8"
											BackgroundColor="{StaticResource SparkContentBackground}"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
												<Label
													FontAttributes="Bold"
													FontSize="12.5"
													Text="{Binding Mkb10Code.Code}"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<Label
													Grid.Column="1"
													FontSize="11.5"
													LineBreakMode="TailTruncation"
													Text="{Binding Mkb10Code.Description}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<!--  Section: Документи  -->
							<controls:CrudSectionHeader
								Title="ДОКУМЕНТИ НА ПАЦИЕНТ"
								Padding="8,5"
								BackgroundColor="{StaticResource SparkAccentTealBg}"
								IsVisible="{Binding HasPatientContext}"
								LineColor="{StaticResource SparkAccentTeal}"
								TextColor="{StaticResource SparkTextPrimary}" />

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за документи."
								TextColor="{StaticResource SparkTextSecondary}" />

							<Border
								Padding="10"
								BackgroundColor="{StaticResource SparkContentBackground}"
								IsVisible="{Binding LatestPatientDocument, Converter={StaticResource SparkNotNullConverter}}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12">
									<Border
										HeightRequest="90"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0"
										WidthRequest="110">
										<Image Aspect="AspectFill" Source="{Binding LatestPatientDocument.StoredPath}" />
									</Border>
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="4"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding LatestPatientDocument.Title}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.DocumentType}"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.UploadedAt, StringFormat='{0:dd.MM.yyyy}'}"
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="2"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding PreviewDocumentCommand}"
										CommandParameter="{Binding LatestPatientDocument}"
										ContentPadding="12,0"
										HeightRequestEx="38"
										Text="🔍 Отвори"
										TextColorEx="{StaticResource SidebarActiveText}"
										WidthRequestEx="110" />
								</Grid>
							</Border>
							<FlexLayout
								BindableLayout.ItemsSource="{Binding PatientDocuments}"
								Direction="Row"
								IsVisible="{Binding HasPatientContext}"
								JustifyContent="Start"
								Wrap="Wrap">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема прикачени документи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientDocument">
										<Border
											Margin="0,0,8,8"
											Padding="0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											HeightRequest="110"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1"
											WidthRequest="110">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid RowDefinitions="*,Auto" RowSpacing="0">
												<Grid Grid.Row="0" IsClippedToBounds="True">
													<Image
														Aspect="AspectFill"
														IsVisible="{Binding IsImageDocument}"
														Source="{Binding StoredPath}" />
													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														IsVisible="{Binding IsImageDocument, Converter={StaticResource InverseBoolConverter}}"
														StrokeThickness="0">
														<VerticalStackLayout
															HorizontalOptions="Center"
															Spacing="4"
															VerticalOptions="Center">
															<Label
																FontFamily="FASolid"
																FontSize="24"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTeal}" />
															<Label
																FontSize="8"
																HorizontalOptions="Center"
																Text="{Binding DocumentType}"
																TextColor="{StaticResource SparkAccentTealDark}" />
														</VerticalStackLayout>
													</Border>
													<Border
														Margin="4"
														Padding="4,3"
														BackgroundColor="#99000000"
														HorizontalOptions="End"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0"
														VerticalOptions="Start">
														<Label
															FontFamily="FASolid"
															FontSize="9"
															Text="&#xf00e;"
															TextColor="{StaticResource SparkTextSecondary}" />
													</Border>
												</Grid>
												<Border
													Grid.Row="1"
													Padding="6,4"
													BackgroundColor="White"
													StrokeThickness="0">
													<VerticalStackLayout Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="9"
															LineBreakMode="TailTruncation"
															Text="{Binding Title}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="8"
															Text="{Binding DocumentType}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</FlexLayout>

						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

			</Grid>
			<Border
				Grid.Row="2"
				Margin="16,10,16,16"
				Padding="16,10"
				BackgroundColor="White"
				Stroke="{StaticResource SparkBorderSubtle}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
					<Label
						Grid.Column="0"
						FontSize="10.5"
						Text="Завршете го внесувањето на прегледот"
						TextColor="{StaticResource SparkTextSecondary}"
						VerticalOptions="Center" />
					<controls:FFButton
						Grid.Column="1"
						ButtonKind="Secondary"
						Command="{Binding CancelCommand}"
						HeightRequestEx="42"
						Text="Откажи"
						WidthRequestEx="130" />
					<controls:FFButton
						Grid.Column="2"
						BackgroundColorEx="{StaticResource SidebarActiveBg}"
						ButtonKind="Primary"
						Command="{Binding SaveEncounterCommand}"
						HeightRequestEx="42"
						Text="Зачувај"
						TextColorEx="White"
						WidthRequestEx="130" />
				</Grid>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
