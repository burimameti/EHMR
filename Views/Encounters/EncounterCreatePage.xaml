<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	x:Name="PageRoot"
	BackgroundColor="{StaticResource SparkBackgroundAlt}">

	<Grid ColumnDefinitions="285,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource SparkBackgroundAlt}"
			RowDefinitions="Auto,*"
			RowSpacing="20">

			<!--  HEADER — SparkRadiusLg (12), matches list-page header cards  -->
			<Border
				Padding="20"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 1"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="18"
					VerticalOptions="Center">

					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="52"
						StrokeShape="RoundRectangle 26"
						StrokeThickness="0"
						WidthRequest="52">
						<Label
							FontFamily="FASolid"
							FontSize="20"
							HorizontalOptions="Center"
							Text="&#xf0f1;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="4"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="20"
							Text="Нов Преглед"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="Внесете ги основните и медицинските детали за тековниот преглед"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							Text="💾 Зачувај преглед" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  MAIN PANEL — SparkRadiusXl (16), the page-level card wrapper  -->
			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 1"
				StrokeThickness="0">

				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Padding="32" Spacing="1">

						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ОСНОВНИ ИНФОРМАЦИИ"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
								<controls:FFPicker
									Grid.Column="0"
									ItemsSource="{Binding Patients}"
									Label="Пациент"
									Placeholder="Изберете пациент"
									SelectedItem="{Binding SelectedPatient}" />

								<controls:FFPicker
									Grid.Column="1"
									ItemsSource="{Binding Doctors}"
									Label="Изберете лекар"
									Placeholder="Изберете доктор"
									SelectedItem="{Binding SelectedDoctor}" />
							</Grid>
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ТИП И ПРИОРИТЕТ"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

							<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="24">
								<controls:FFPicker
									Grid.Column="0"
									ItemsSource="{Binding EncounterTypeOptions}"
									Label="Тип на преглед"
									Placeholder="Изберете тип"
									SelectedItem="{Binding EncounterTypeDisplay}" />

								<controls:FFPicker
									Grid.Column="1"
									ItemsSource="{Binding PriorityOptions}"
									Label="Приоритет"
									Placeholder="Изберете приоритет"
									SelectedItem="{Binding PriorityDisplay}" />

								<Grid
									Grid.Column="2"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Датум на преглед"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<DatePicker
											BackgroundColor="Transparent"
											Date="{Binding ScheduledStartDate}"
											FontSize="13"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="3"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Време"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<TimePicker
											BackgroundColor="Transparent"
											FontSize="13"
											TextColor="{StaticResource SparkTextPrimary}"
											Time="{Binding ScheduledStartTime}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

								<Grid
									Grid.Column="0"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Причина за посета *"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="12,0"
										BackgroundColor="{StaticResource SparkBackground}"
										HeightRequest="46"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Entry
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Пр. Редовна контрола, Главоболка"
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Encounter.ReasonForVisit}"
											TextColor="{StaticResource SparkTextPrimary}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="1"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Клинички белешки"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Border
										Grid.Row="1"
										Padding="12,6"
										BackgroundColor="{StaticResource SparkBackground}"
										Stroke="{StaticResource SparkBorder}"
										StrokeShape="RoundRectangle 6"
										StrokeThickness="1">
										<Editor
											AutoSize="TextChanges"
											BackgroundColor="Transparent"
											FontSize="13"
											Placeholder="Внесете детален извештај од прегледот..."
											PlaceholderColor="{StaticResource SparkTextSecondary}"
											Text="{Binding Encounter.ClinicalNotes}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
								</Grid>
							</Grid>
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="МКБ-10 ДИЈАГНОСТИКА"
								TextColor="{StaticResource SparkTextPrimary}" />
							<BoxView HeightRequest="1" Color="{StaticResource SparkBorder}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

								<VerticalStackLayout Grid.Column="0" Spacing="12">

									<controls:FFSearchBox Placeholder="Внесете шифра или назив на МКБ 10 (Пр. I10)..." Text="{Binding MkbSearchText, Mode=TwoWay}" />

									<CollectionView
										HeightRequest="180"
										IsVisible="{Binding ShowMkbDropdown}"
										ItemsSource="{Binding MkbResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:Mkb10Code">
												<Border
													Margin="0,4"
													Padding="12"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													StrokeShape="RoundRectangle 12"
													StrokeThickness="0">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<VerticalStackLayout Spacing="2">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Code}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															FontSize="12"
															Text="{Binding Description}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>

								<VerticalStackLayout Grid.Column="1" Spacing="14">
									<FlexLayout
										BindableLayout.ItemsSource="{Binding Diagnoses}"
										Direction="Row"
										JustifyContent="Start"
										Wrap="Wrap">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:Diagnosis">
												<!--  SparkRadiusPill (20) — intentional pill-shaped chip, kept as-is  -->
												<Border
													Margin="4"
													Padding="10,6"
													BackgroundColor="{StaticResource SparkTabActiveBg}"
													Stroke="{StaticResource SparkAccentTeal}"
													StrokeShape="RoundRectangle 12">
													<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Mkb10Code.Code}"
															TextColor="{StaticResource SparkAccentTealDark}"
															VerticalOptions="Center" />
														<!--  Circular remove button — radius 9 = half of 18×18, not part of card/input scale  -->
														<Button
															Padding="0"
															BackgroundColor="Transparent"
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
															CommandParameter="{Binding .}"
															CornerRadius="9"
															FontSize="10"
															HeightRequest="18"
															Text="✕"
															TextColor="{StaticResource SparkAccentTealDark}"
															WidthRequest="18" />
													</HorizontalStackLayout>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</FlexLayout>

									<VerticalStackLayout Margin="0,6,0,0" Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Дополнителен наод / Слободен текст"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="12,6"
											BackgroundColor="{StaticResource SparkBackground}"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 6"
											StrokeThickness="1">
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Додадете специфични забелешки или дијагнози надвор од МКБ системот..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding EncounterDiagnosisNotes}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</VerticalStackLayout>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>
			</Border>

		</Grid>
	</Grid>
</ContentPage>
