<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	BackgroundColor="{StaticResource SparkBorder}">

	<Grid ColumnDefinitions="285,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>
		<Grid
			Grid.Column="1"
			Padding="24"
			RowDefinitions="Auto,*"
			RowSpacing="6">
			<Border
				Padding="20,16"
				BackgroundColor="{StaticResource SparkBackground}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="16"
					VerticalOptions="Center">

					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf0f1;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>

					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="19"
							Text="Нов Преглед"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="Внесете ги основните и медицинските детали за тековниот преглед"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="💾 Зачувај преглед" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  MAIN PANEL  -->
			<Grid
				Grid.Row="1"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="19">
				<Border
					BackgroundColor="{StaticResource SparkBackground}"
					StrokeShape="RoundRectangle 12"
					StrokeThickness="0">

					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="10" Spacing="6">

							<!--  =====================================================  -->
							<!--  ПАЦИЕНТ / ЛЕКАР — контекстна лента наместо picker кога  -->
							<!--  пациентот е веќе наследен (appointment / patient row)  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">

								<!--  SECTION HEADER — проширена, заоблена pill-лента  -->
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									IsVisible="{Binding IsPatientLockedFromContext}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Grid>
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="12"
											IsVisible="{Binding IsPatientLockedFromContext}"
											Text="ПАЦИЕНТ И ЛЕКАР"
											TextColor="{StaticResource SparkAccentTealDark}" />

									</Grid>
								</Border>

								<!--  ЗАКЛУЧАН КОНТЕКСТ — само приказ, без input изглед  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="20"
									IsVisible="{Binding IsPatientLockedFromContext}">

									<Border
										Grid.Column="0"
										Padding="16,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="38"
												StrokeShape="RoundRectangle 19"
												StrokeThickness="0"
												WidthRequest="38">
												<Label
													FontFamily="FASolid"
													FontSize="14"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="11"
													Text="Пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="17"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatient.FullName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<Border
										Grid.Column="1"
										Padding="16,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="38"
												StrokeShape="RoundRectangle 19"
												StrokeThickness="0"
												WidthRequest="38">
												<Label
													FontFamily="FASolid"
													FontSize="14"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="11"
													Text="Матичен Реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="17"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  СЛОБОДЕН ИЗБОР — вистински pickers кога формата е сосема нова  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									IsVisible="{Binding IsPatientLockedFromContext}">
									<controls:FFPicker
										Grid.Column="0"
										ItemsSource="{Binding Patients}"
										Label="Пациент"
										Placeholder="Изберете пациент *"
										SelectedItem="{Binding SelectedPatient}" />

									<controls:FFPicker
										Grid.Column="1"
										ItemsSource="{Binding Doctors}"
										Label="Изберете реуматолог *"
										Placeholder="Изберете матичен реуматолог"
										SelectedItem="{Binding SelectedDoctor}" />
								</Grid>

								<!--  Термин / циклус — копчињата "+" едно под друго лево,  -->
								<!--  пребарувачите (со нивните dropdown-и) едно под друго десно  -->

							</VerticalStackLayout>

							<!--  =====================================================  -->
							<!--  ТИП И ПРИОРИТЕТ — ред 1: тип/приоритет, ред 2: датум/време  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">

								<!--  SECTION HEADER — иста pill-лента како погоре  -->
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ТИП И ПРИОРИТЕТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid RowDefinitions="Auto,Auto" RowSpacing="20">

									<!--  РЕД 1: Тип на преглед / Приоритет  -->
									<Grid
										Grid.Row="0"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">
										<controls:FFPicker
											Grid.Column="0"
											ItemsSource="{Binding EncounterTypeOptions}"
											Label="Тип на преглед"
											Placeholder="Изберете тип"
											SelectedItem="{Binding EncounterTypeDisplay}" />

										<controls:FFPicker
											Grid.Column="1"
											ItemsSource="{Binding PriorityOptions}"
											Label="Приоритет"
											Placeholder="Изберете приоритет"
											SelectedItem="{Binding PriorityDisplay}" />
									</Grid>

									<!--  РЕД 2: Датум на преглед / Време  -->
									<Grid
										Grid.Row="1"
										ColumnDefinitions="*,*"
										ColumnSpacing="24">

										<Grid
											Grid.Column="0"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Датум на преглед"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Grid.Row="1"
												Padding="10,0"
												BackgroundColor="{StaticResource SparkBackground}"
												HeightRequest="46"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Border.Shadow>
													<Shadow
														Brush="Black"
														Opacity="0.06"
														Radius="6"
														Offset="0,2" />
												</Border.Shadow>
												<DatePicker
													BackgroundColor="Transparent"
													Date="{Binding ScheduledStartDate}"
													FontSize="13"
													TextColor="{StaticResource SparkTextPrimary}"
													VerticalOptions="Center" />
											</Border>
										</Grid>

										<Grid
											Grid.Column="1"
											RowDefinitions="Auto,Auto"
											RowSpacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Време"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Grid.Row="1"
												Padding="10,0"
												BackgroundColor="{StaticResource SparkBackground}"
												HeightRequest="46"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Border.Shadow>
													<Shadow
														Brush="Black"
														Opacity="0.06"
														Radius="6"
														Offset="0,2" />
												</Border.Shadow>
												<TimePicker
													BackgroundColor="Transparent"
													FontSize="13"
													TextColor="{StaticResource SparkTextPrimary}"
													Time="{Binding ScheduledStartTime}"
													VerticalOptions="Center" />
											</Border>
										</Grid>
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  =====================================================  -->
							<!--  ДЕТАЛИ ЗА ПРЕГЛЕДОТ — ред 3: причина за посета / клинички белешки  -->
							<!--  =====================================================  -->
							<VerticalStackLayout Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

									<Grid
										Grid.Column="0"
										RowDefinitions="Auto,Auto"
										RowSpacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Причина за посета *"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Grid.Row="1"
											Padding="12,0"
											BackgroundColor="{StaticResource SparkBackground}"
											HeightRequest="46"
											Stroke="{StaticResource SparkAccentTealBg}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Border.Shadow>
												<Shadow
													Brush="Black"
													Opacity="0.06"
													Radius="6"
													Offset="0,2" />
											</Border.Shadow>
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Редовна контрола, Главоболка"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ReasonForVisit}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</Grid>

									<Grid
										Grid.Column="1"
										RowDefinitions="Auto,Auto"
										RowSpacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Клинички белешки"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Grid.Row="1"
											Padding="12,8"
											BackgroundColor="{StaticResource SparkBackground}"
											Stroke="{StaticResource SparkAccentTealBg}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Border.Shadow>
												<Shadow
													Brush="Black"
													Opacity="0.06"
													Radius="6"
													Offset="0,2" />
											</Border.Shadow>
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Внесете детален извештај од прегледот..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ClinicalNotes}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  =====================================================  -->
							<!--  МКБ-10 — обично се внесува при пациентот; тука се гледа  -->
							<!--  само во edit режим за дополнителна дијагностика/измена  -->
							<!--  (потребно е VM својство IsEditMode — видете ги забелешките горе)  -->
							<!--  =====================================================  -->
							<VerticalStackLayout IsVisible="{Binding IsEditMode}" Spacing="14">
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="МКБ-10 ДИЈАГНОСТИКА"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>


								<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

									<VerticalStackLayout Grid.Column="0" Spacing="12">

										<controls:FFSearchBox Placeholder="Внесете шифра или назив на МКБ 10 (Пр. I10)..." Text="{Binding MkbSearchText, Mode=TwoWay}" />

										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMkbDropdown}"
											ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="14">
										<FlexLayout
											BindableLayout.ItemsSource="{Binding Diagnoses}"
											Direction="Row"
											JustifyContent="Start"
											Wrap="Wrap">
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:Diagnosis">
													<Border
														Margin="4"
														Padding="10,6"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														Stroke="{StaticResource SparkAccentTeal}"
														StrokeShape="RoundRectangle 12">
														<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Mkb10Code.Code}"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center" />
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
																CommandParameter="{Binding .}"
																CornerRadius="9"
																FontSize="10"
																HeightRequest="18"
																Text="✕"
																TextColor="{StaticResource SparkAccentTealDark}"
																WidthRequest="18" />
														</HorizontalStackLayout>
													</Border>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</FlexLayout>

										<VerticalStackLayout Margin="0,6,0,0" Spacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Дополнителен наод / Слободен текст"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Padding="12,8"
												BackgroundColor="{StaticResource SparkBackground}"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Border.Shadow>
													<Shadow
														Brush="Black"
														Opacity="0.06"
														Radius="6"
														Offset="0,2" />
												</Border.Shadow>
												<Editor
													AutoSize="TextChanges"
													BackgroundColor="Transparent"
													FontSize="13"
													Placeholder="Додадете специфични забелешки или дијагнози надвор од МКБ системот..."
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding EncounterDiagnosisNotes}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>
				<Grid Grid.Column="1" RowDefinitions="Auto,*">
					<Border
						Grid.Column="1"
						BackgroundColor="{StaticResource SparkBackground}"
						StrokeShape="RoundRectangle 12"
						StrokeThickness="0"
						VerticalOptions="Start">
						<Grid ColumnDefinitions="320,*" ColumnSpacing="1">

							<VerticalStackLayout
								Grid.Column="1"
								Margin="0,22"
								Padding="10"
								Spacing="22">
								<controls:FFButton
									BackgroundColor="{StaticResource Transparent}"
									BackgroundColorEx="{StaticResource SparkAccentTealBg}"
									ButtonKind="Secondary"
									Command="{Binding AddNewAppointmentCommand}"
									ContentPadding="14,0"
									HeightRequestEx="42"
									Text="+ Нов термин"
									WidthRequestEx="140" />
								<controls:FFButton
									BackgroundColor="{StaticResource Transparent}"
									BackgroundColorEx="{StaticResource SparkAccentTealBg}"
									ButtonKind="Secondary"
									Command="{Binding AddNewTherapyCycleCommand}"
									ContentPadding="14,0"
									HeightRequestEx="42"
									Text="+ Нов циклус"
									WidthRequestEx="140" />
							</VerticalStackLayout>

							<VerticalStackLayout
								Grid.Column="0"
								Padding="10"
								Spacing="6">
								<controls:FFSearchBox
									Placeholder="Пребарај постоечки термин..."
									Text="{Binding AppointmentSearchText, Mode=TwoWay}"
									WidthRequest="300" />
								<CollectionView
									HeightRequest="100"
									IsVisible="{Binding ShowAppointmentDropdown}"
									ItemsSource="{Binding AppointmentSearchResults}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="entities:Appointment">
											<Border
												Margin="0,0"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="2">
												<Border.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectAppointmentCommand}" CommandParameter="{Binding .}" />
												</Border.GestureRecognizers>
												<VerticalStackLayout Spacing="2">
													<Label
														FontAttributes="Bold"
														FontSize="12"
														Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
														TextColor="{StaticResource SparkAccentTealDark}" />
													<Label
														FontSize="11"
														Text="{Binding ReasonForVisit}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>

								<controls:FFSearchBox Placeholder="Пребарај постоечки  циклус" Text="{Binding CycleSearchText, Mode=TwoWay}" />
								<CollectionView
									HeightRequest="140"
									IsVisible="{Binding ShowCycleDropdown}"
									ItemsSource="{Binding CycleSearchResults}">
									<CollectionView.ItemTemplate>
										<DataTemplate x:DataType="entities:TherapyCycle">
											<Border
												Margin="0,3"
												Padding="10"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0">
												<Border.GestureRecognizers>
													<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectTherapyCycleCommand}" CommandParameter="{Binding .}" />
												</Border.GestureRecognizers>
												<Label
													FontSize="12"
													Text="{Binding Notes}"
													TextColor="{StaticResource SparkAccentTealDark}" />
											</Border>
										</DataTemplate>
									</CollectionView.ItemTemplate>
								</CollectionView>
							</VerticalStackLayout>
						</Grid>
					</Border>

					<Border
						Grid.Row="1"
						Grid.Column="1"
						Margin="1"
						StrokeShape="RoundRectangle 12"
						StrokeThickness="0"
						VerticalOptions="Fill">

						<Grid RowDefinitions="Auto,*" VerticalOptions="Fill">
							<Border
								Padding="16,14"
								BackgroundColor="{StaticResource SparkBackground}"
								StrokeThickness="0">
								<Grid
									ColumnDefinitions="Auto,*,*"
									ColumnSpacing="10"
									RowDefinitions="*,*,*"
									VerticalOptions="Center">
									<Border
										Grid.Row="0"
										Padding="14,10"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										IsVisible="{Binding !IsPatientLockedFromContext}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="0">
										<Label
											CharacterSpacing="0.5"
											FontAttributes="Bold"
											FontSize="12"
											HorizontalOptions="Start"
											Text="ПОДАТОЦИ ЗА ПАЦИЕНТОТ"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</Border>

									<HorizontalStackLayout Grid.Row="1" Padding="22">
										<Border
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											HeightRequest="60"
											HorizontalOptions="Start"
											StrokeShape="RoundRectangle 21"
											StrokeThickness="0"
											WidthRequest="60">

											<Label
												FontFamily="FASolid"
												FontSize="15"
												HorizontalOptions="Center"
												Text="&#xf007;"
												TextColor="{StaticResource SparkAccentTealDark}"
												VerticalOptions="Center" />
										</Border>
										<Label
											Padding="22"
											FontAttributes="Bold"
											FontSize="16"
											LineBreakMode="TailTruncation"
											Text="{Binding SelectedPatient.FullName, TargetNullValue='Изберете пациент'}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</HorizontalStackLayout>



									<VerticalStackLayout
										Grid.Row="2"
										Grid.Column="0"
										Spacing="2"
										VerticalOptions="Center">

										<HorizontalStackLayout
											Padding="10"
											IsVisible="{Binding SelectedDoctor}"
											Spacing="6"
											VerticalOptions="Center">
											<Grid RowDefinitions="*,*">
												<Label
													FontFamily="FASolid"
													FontSize="18"
													Text="&#xf0f0; Матичен РЕУМАТОЛОГ"
													TextColor="{StaticResource SparkAccentTeal}"
													VerticalOptions="Center" />
												<Label
													Grid.Row="1"
													FontAttributes="Bold"
													FontSize="18"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName, StringFormat='{0}'}"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Grid>
										</HorizontalStackLayout>
									</VerticalStackLayout>

									<ActivityIndicator
										Grid.Column="2"
										IsRunning="{Binding IsPatientLoading}"
										IsVisible="{Binding IsPatientLoading}"
										Color="{StaticResource SparkAccentTeal}" />
								</Grid>
							</Border>

							<Border
								Grid.Row="1"
								BackgroundColor="{StaticResource SparkBackground}"
								VerticalOptions="Fill">
								<ScrollView VerticalScrollBarVisibility="Never">
									<VerticalStackLayout Padding="10" Spacing="16">
										<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="16">

											<controls:SparkExpandableCard
												Title="Дијагнози"
												Subtitle="Историја"
												Variant="Diagnosis" />

											<controls:SparkExpandableCard
												Title="Прегледи"
												Subtitle="Посети"
												Variant="Encounter" />

											<controls:SparkExpandableCard
												Title="Термини"
												Subtitle="Закажани"
												Variant="Appointment" />

											<controls:SparkExpandableCard Title="Терапевтски циклуси" Variant="TherapyCycle" />

											<controls:SparkExpandableCard Title="Рецепти" Variant="Prescription" />

											<controls:SparkExpandableCard Title="Терапии со лекови" Variant="Medicine" />

										</VerticalStackLayout>
									</VerticalStackLayout>
								</ScrollView>
							</Border>
						</Grid>
					</Border>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</ContentPage>
