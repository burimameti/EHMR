<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	x:Name="PageRoot"
	BackgroundColor="#F6F7FB">

	<Grid ColumnDefinitions="285,*">

		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,*"
			RowSpacing="20">

			<Border
				Padding="20"
				BackgroundColor="{StaticResource White}"
				StrokeShape="RoundRectangle 12"
				StrokeThickness="0">

				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">

					<VerticalStackLayout Spacing="4" VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontFamily="Segoe UI"
							FontSize="20"
							Text="Нов Преглед"
							TextColor="{StaticResource Gray600}" />
						<Label
							FontFamily="Segoe UI"
							FontSize="12"
							Text="Внесете ги основните и медицинските детали за тековниот преглед"
							TextColor="{StaticResource Gray700}" />
					</VerticalStackLayout>

					<HorizontalStackLayout
						Grid.Column="1"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							Text="Откажи" />
						<controls:FFButton
							ButtonKind="Primary"
							Command="{Binding SaveCommand}"
							ContentPadding="20,0"
							HeightRequestEx="42"
							Text="💾 Зачувај преглед" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource White}"
				StrokeShape="RoundRectangle 16"
				StrokeThickness="0">

				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Padding="32" Spacing="28">

						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ОСНОВНИ ИНФОРМАЦИИ"
								TextColor="{StaticResource Gray800}" />
							<BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">
								<controls:FFPicker
									Grid.Column="0"
									ItemsSource="{Binding Patients}"
									Label="Пациент"
									Placeholder="Изберете пациент"
									SelectedItem="{Binding SelectedPatient}" />

								<controls:FFPicker
									Grid.Column="1"
									ItemsSource="{Binding Doctors}"
									Label="Изберете лекар"
									Placeholder="Изберете доктор"
									SelectedItem="{Binding SelectedDoctor}" />
							</Grid>
						</VerticalStackLayout>
						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ТИП И ПРИОРИТЕТ"
								TextColor="{StaticResource Gray800}" />
							<BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

							<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="24">
								<controls:FFPicker
									Grid.Column="0"
									ItemsSource="{Binding EncounterTypeOptions}"
									Label="Тип на преглед"
									Placeholder="Изберете тип"
									SelectedItem="{Binding EncounterTypeDisplay}" />

								<controls:FFPicker
									Grid.Column="1"
									ItemsSource="{Binding PriorityOptions}"
									Label="Приоритет"
									Placeholder="Изберете приоритет"
									SelectedItem="{Binding PriorityDisplay}" />

								<Grid
									Grid.Column="2"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Датум на преглед"
										TextColor="{StaticResource Gray600}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource Gray50}"
										HeightRequest="46"
										Stroke="LightGray"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<DatePicker
											BackgroundColor="Transparent"
											Date="{Binding ScheduledStartDate}"
											FontSize="13"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="3"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Време"
										TextColor="{StaticResource Gray600}" />
									<Border
										Grid.Row="1"
										Padding="10,0"
										BackgroundColor="{StaticResource Gray50}"
										HeightRequest="46"
										Stroke="LightGray"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<TimePicker
											BackgroundColor="Transparent"
											FontSize="13"
											TextColor="{StaticResource Gray800}"
											Time="{Binding ScheduledStartTime}"
											VerticalOptions="Center" />
									</Border>
								</Grid>
							</Grid>
						</VerticalStackLayout>
						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ"
								TextColor="{StaticResource Gray800}" />
							<BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

								<Grid
									Grid.Column="0"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Причина за посета *"
										TextColor="{StaticResource Gray600}" />
									<Border
										Grid.Row="1"
										Padding="12,0"
										BackgroundColor="{StaticResource Gray50}"
										HeightRequest="46"
										Stroke="LightGray"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<Entry
											Background="Transparent"
											FontSize="13"
											Placeholder="Пр. Редовна контрола, Главоболка"
											Text="{Binding Encounter.ReasonForVisit}"
											TextColor="{StaticResource Gray800}"
											VerticalOptions="Center" />
									</Border>
								</Grid>

								<Grid
									Grid.Column="1"
									RowDefinitions="Auto,Auto"
									RowSpacing="8">
									<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Клинички белешки"
										TextColor="{StaticResource Gray600}" />
									<Border
										Grid.Row="1"
										Padding="12,6"
										BackgroundColor="{StaticResource Gray50}"
										Stroke="LightGray"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="1">
										<Editor
											AutoSize="TextChanges"
											Background="Transparent"
											FontSize="13"
											Placeholder="Внесете детален извештај од прегледот..."
											Text="{Binding Encounter.ClinicalNotes}"
											TextColor="{StaticResource Gray800}" />
									</Border>
								</Grid>
							</Grid>
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="16">
							<Label
								CharacterSpacing="1"
								FontAttributes="Bold"
								FontSize="13"
								Text="МКБ-10 ДИЈАГНОСТИКА"
								TextColor="{StaticResource Gray800}" />
							<BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="24">

								<VerticalStackLayout Grid.Column="0" Spacing="12">

									<controls:FFSearchBox Placeholder="Внесете шифра или називна МКБ 10 (Пр. I10)..." Text="{Binding MkbSearchText, Mode=TwoWay}" />

									<CollectionView
										HeightRequest="180"
										IsVisible="{Binding ShowMkbDropdown}"
										ItemsSource="{Binding MkbResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:Mkb10Code">
												<Border
													Margin="0,4"
													Padding="12"
													BackgroundColor="{StaticResource Gray200}"
													StrokeShape="RoundRectangle 10"
													StrokeThickness="0">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<VerticalStackLayout Spacing="2">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Code}"
															TextColor="#2563EB" />
														<Label
															FontSize="12"
															Text="{Binding Description}"
															TextColor="{StaticResource Gray700}" />
													</VerticalStackLayout>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</VerticalStackLayout>

								<VerticalStackLayout Grid.Column="1" Spacing="14">
									<!--<Label
										FontAttributes="Bold"
										FontSize="13"
										Text="Избрани примарни/секундарни дијагнози"
										TextColor="{StaticResource Gray600}" />-->
									<FlexLayout
										BindableLayout.ItemsSource="{Binding Diagnoses}"
										Direction="Row"
										JustifyContent="Start"
										Wrap="Wrap">
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:Diagnosis">
												<Border
													Margin="4"
													Padding="10,6"
													BackgroundColor="#EFF6FF"
													Stroke="#BFDBFE"
													StrokeShape="RoundRectangle 20">
													<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
														<Label
															FontAttributes="Bold"
															FontSize="13"
															Text="{Binding Mkb10Code.Code}"
															TextColor="#1D4ED8"
															VerticalOptions="Center" />
														<Button
															Padding="0"
															BackgroundColor="Transparent"
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
															CommandParameter="{Binding .}"
															CornerRadius="9"
															FontSize="10"
															HeightRequest="18"
															Text="✕"
															TextColor="#1D4ED8"
															WidthRequest="18" />
													</HorizontalStackLayout>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</FlexLayout>

									<VerticalStackLayout Margin="0,6,0,0" Spacing="8">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="Дополнителен наод / Слободен текст"
											TextColor="{StaticResource Gray600}" />
										<Border
											Padding="12,6"
											BackgroundColor="{StaticResource Gray50}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">

											<Editor
												AutoSize="TextChanges"
												Background="Transparent"
												FontSize="13"
												Placeholder="Додадете специфични забелешки или дијагнози надвор од МКД системот..."
												Text="{Binding EncounterDiagnosisNotes}" />
										</Border>
									</VerticalStackLayout>
								</VerticalStackLayout>
							</Grid>
						</VerticalStackLayout>

					</VerticalStackLayout>
				</ScrollView>
			</Border>

		</Grid>
	</Grid>
</ContentPage>