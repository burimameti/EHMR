<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterCreateViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			RowSpacing="0">

			<!--  ── HEADER ─────────────────────────────────────────────────  -->
			<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
				<Grid
					ColumnDefinitions="Auto,*"
					ColumnSpacing="16"
					VerticalOptions="Center">
					<Border
						BackgroundColor="{StaticResource SparkTabActiveBg}"
						HeightRequest="48"
						StrokeShape="RoundRectangle 24"
						StrokeThickness="0"
						WidthRequest="48">
						<Label
							FontFamily="FASolid"
							FontSize="18"
							HorizontalOptions="Center"
							Text="&#xf0f1;"
							TextColor="{StaticResource SparkAccentTeal}"
							VerticalOptions="Center" />
					</Border>
					<VerticalStackLayout
						Grid.Column="1"
						Spacing="2"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="19"
							Text="Внесување на нов преглед"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontSize="12"
							Text="Внесете ги основните и медицинските детали за тековниот преглед"
							TextColor="{StaticResource SparkTextSecondary}" />
					</VerticalStackLayout>
				</Grid>
			</Border>

			<!--  ── TWO-COLUMN BODY ──────────────────────────────────────────  -->
			<Grid
				Grid.Row="1"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="1">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Border Grid.Column="0" Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="16" Spacing="24">

							<!--  ── 1. ПАЦИЕНТ И РЕУМАТОЛОГ ─────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<!--  Section header  -->
								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ПАЦИЕНТ И РЕУМАТОЛОГ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<!--  Locked context display  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="12"
									IsVisible="{Binding IsPatientLockedFromContext}">
									<Border
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Избран пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<Border
										Grid.Column="1"
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Матичен реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  Patient search (hidden when locked)  -->
								<VerticalStackLayout Spacing="8">
									<VerticalStackLayout.Triggers>
										<DataTrigger
											Binding="{Binding IsPatientLockedFromContext}"
											TargetType="VerticalStackLayout"
											Value="True">
											<Setter Property="IsVisible" Value="False" />
										</DataTrigger>
									</VerticalStackLayout.Triggers>

									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<controls:FFSearchBox Placeholder="Пребарај пациент по име, ЕМБГ или број..." Text="{Binding PatientSearchText, Mode=TwoWay}" />
										<HorizontalStackLayout
											Grid.Column="1"
											Spacing="4"
											VerticalOptions="Center">
											<CheckBox IsChecked="{Binding UseCyrillicPatientSearch, Mode=TwoWay}" />
											<Label
												FontSize="12"
												Text="Кирилица"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Grid>

									<!--  Autocomplete dropdown  -->
									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowPatientSuggestions}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView
											HeightRequest="164"
											ItemsSource="{Binding PatientSuggestions}"
											SelectedItem="{Binding PatientSuggestionSelection, Mode=TwoWay}"
											SelectionMode="Single">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Patient">
													<Label
														Margin="1"
														Padding="10,7"
														BackgroundColor="#F8FAFC"
														FontSize="12"
														Text="{Binding FullName}"
														TextColor="{StaticResource SparkTextPrimary}" />
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>
								</VerticalStackLayout>

								<!--  Selected patient info card  -->
								<Border
									Padding="14"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									IsVisible="{Binding HasPatientContext}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="0">
									<Grid
										ColumnDefinitions="*,*,*"
										ColumnSpacing="12"
										RowDefinitions="Auto,Auto,Auto,Auto,Auto"
										RowSpacing="2">

										<Label
											Grid.Row="0"
											Grid.ColumnSpan="3"
											FontAttributes="Bold"
											FontSize="15"
											LineBreakMode="WordWrap"
											Text="{Binding SelectedPatient.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />

										<Label
											Grid.Row="1"
											Grid.Column="0"
											FontSize="10"
											Text="Возраст"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="1"
											Grid.Column="1"
											FontSize="10"
											Text="Пол"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="1"
											Grid.Column="2"
											FontSize="10"
											Text="Статус"
											TextColor="{StaticResource SparkTextSecondary}" />

										<Label
											Grid.Row="2"
											Grid.Column="0"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.Age, StringFormat='{0} год.'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Row="2"
											Grid.Column="1"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.Gender}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Border
											Grid.Row="2"
											Grid.Column="2"
											Padding="8,3"
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											HorizontalOptions="Start"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="10"
												Text="{Binding SelectedPatient.Status}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</Border>

										<Label
											Grid.Row="3"
											Grid.Column="0"
											FontSize="10"
											Text="Бр. пациент"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="3"
											Grid.Column="1"
											FontSize="10"
											Text="Телефон"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="3"
											Grid.Column="2"
											FontSize="10"
											Text="Матичен реуматолог"
											TextColor="{StaticResource SparkTextSecondary}" />

										<Label
											Grid.Row="4"
											Grid.Column="0"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.PatientNumber, StringFormat='#{0}'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Row="4"
											Grid.Column="1"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Row="4"
											Grid.Column="2"
											FontAttributes="Bold"
											FontSize="12"
											LineBreakMode="TailTruncation"
											Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</Grid>
								</Border>

							</VerticalStackLayout>

							<!--  ── 2. МКБ-10 ДИЈАГНОСТИКА ─────────────────  -->
							<VerticalStackLayout Spacing="12">

								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="МКБ-10 ДИЈАГНОСТИКА"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<!--  Search (left) + selected tags (right) — same row  -->
								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">

									<!--  Search box + results dropdown  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:FFSearchBox Placeholder="Внесете шифра или назив на МКБ 10..." Text="{Binding MkbSearchText, Mode=TwoWay}" />

										<Border
											Padding="4"
											BackgroundColor="White"
											IsVisible="{Binding ShowMkbDropdown}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<CollectionView HeightRequest="220" ItemsSource="{Binding MkbResults}">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="entities:Mkb10Code">
														<Border
															Margin="2,2,2,0"
															Padding="10,8"
															BackgroundColor="Transparent"
															StrokeThickness="0">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
																<Border
																	Padding="6,3"
																	BackgroundColor="{StaticResource SparkAccentTealBg}"
																	StrokeShape="RoundRectangle 6"
																	StrokeThickness="0"
																	VerticalOptions="Start">
																	<Label
																		FontAttributes="Bold"
																		FontSize="11"
																		Text="{Binding Code}"
																		TextColor="{StaticResource SparkAccentTealDark}" />
																</Border>
																<Label
																	Grid.Column="1"
																	FontSize="12"
																	LineBreakMode="WordWrap"
																	Text="{Binding Description}"
																	TextColor="{StaticResource SparkTextPrimary}"
																	VerticalOptions="Center" />
															</Grid>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>
									</VerticalStackLayout>

									<!--  Selected diagnoses — same vertical start  -->
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="8"
										VerticalOptions="Start">
										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="Избрани дијагнози"
											TextColor="{StaticResource SparkTextSecondary}" />

										<FlexLayout
											BindableLayout.ItemsSource="{Binding Diagnoses}"
											Direction="Row"
											JustifyContent="Start"
											Wrap="Wrap">
											<BindableLayout.EmptyView>
												<Label
													FontSize="12"
													Text="Нема доделени дијагнози."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:Diagnosis">
													<!--  Tag: Code + Description + remove  -->
													<Border
														Margin="0,0,6,6"
														Padding="8,5"
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														Stroke="{StaticResource SparkAccentTeal}"
														StrokeShape="RoundRectangle 8"
														StrokeThickness="1">
														<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
															<Label
																Grid.Column="0"
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Mkb10Code.Code}"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center" />
															<Label
																Grid.Column="1"
																FontSize="11"
																LineBreakMode="TailTruncation"
																Text="{Binding Mkb10Code.Description}"
																TextColor="{StaticResource SparkTextSecondary}"
																VerticalOptions="Center" />
															<Button
																Grid.Column="2"
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
																CommandParameter="{Binding .}"
																FontSize="10"
																HeightRequest="18"
																Text="✕"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center"
																WidthRequest="18" />
														</Grid>
													</Border>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</FlexLayout>
									</VerticalStackLayout>

								</Grid>
							</VerticalStackLayout>

							<!--  ── 3. ЛЕКОВИ ──────────────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ЛЕКОВИ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">

									<!--  Medicine search + dropdown  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:FFSearchBox Placeholder="Пребарување на лекот..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />

										<Border
											Padding="4"
											BackgroundColor="White"
											IsVisible="{Binding ShowMedicineDropdown}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<CollectionView HeightRequest="200" ItemsSource="{Binding MedicineResults}">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="entities:Medicine">
														<Border
															Margin="2,2,2,0"
															Padding="10,8"
															BackgroundColor="Transparent"
															StrokeThickness="0">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<VerticalStackLayout Spacing="2">
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	Text="{Binding Name}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
																<Label
																	FontSize="11"
																	Text="{Binding GenericName}"
																	TextColor="{StaticResource SparkTextSecondary}" />
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>
									</VerticalStackLayout>

									<!--  Medicine table (right column)  -->
									<VerticalStackLayout Grid.Column="1" Spacing="0">

										<Label
											Margin="0,0,0,8"
											FontAttributes="Bold"
											FontSize="11"
											Text="Додадени за овој преглед"
											TextColor="{StaticResource SparkTextSecondary}" />

										<!--  Table header — only when there are rows  -->
										<Grid
											ColumnDefinitions="2*,1*,32"
											ColumnSpacing="0"
											IsVisible="{Binding HasEncounterMedicines}">
											<Border
												Grid.Column="0"
												Padding="10,7"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeShape="Rectangle"
												StrokeThickness="1">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="ИМЕ НА ЛЕКОТ"
													TextColor="{StaticResource SparkTextSecondary}" />
											</Border>
											<Border
												Grid.Column="1"
												Padding="10,7"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeShape="Rectangle"
												StrokeThickness="1">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="КОЛИЧИНА"
													TextColor="{StaticResource SparkTextSecondary}" />
											</Border>
											<!--  Delete column header — empty  -->
											<Border
												Grid.Column="2"
												BackgroundColor="{StaticResource SparkTabActiveBg}"
												Stroke="{StaticResource SparkBorderSubtle}"
												StrokeShape="Rectangle"
												StrokeThickness="1" />
										</Grid>

										<!--  Table rows  -->
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
											<BindableLayout.EmptyView>
												<Label
													Padding="0,6"
													FontSize="12"
													Text="Нема додадени лекови за овој преглед."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:PatientMedicine">
													<Grid ColumnDefinitions="2*,1*,32" ColumnSpacing="0">
														<Border
															Grid.Column="0"
															Padding="10,0"
															MinimumHeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeShape="Rectangle"
															StrokeThickness="1">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																LineBreakMode="TailTruncation"
																Text="{Binding Medicine.Name}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="1"
															Padding="10,0"
															MinimumHeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeShape="Rectangle"
															StrokeThickness="1">
															<Entry
																BackgroundColor="Transparent"
																FontAttributes="Bold"
																FontSize="13"
																Keyboard="Numeric"
																Placeholder="—"
																PlaceholderColor="{StaticResource SparkTextSecondary}"
																Text="{Binding Dosage, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="2"
															MinimumHeightRequest="42"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeShape="Rectangle"
															StrokeThickness="1">
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
																CommandParameter="{Binding .}"
																FontSize="12"
																HorizontalOptions="Center"
																Text="✕"
																TextColor="#DC2626"
																VerticalOptions="Center" />
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>

									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  ── 4. ДЕТАЛИ ЗА ПРЕГЛЕДОТ ────────────────  -->
							<VerticalStackLayout Spacing="12">

								<Border
									Padding="14,10"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="0">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<!--  Status + schedule row  -->
								<Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
									<Label
										FontSize="11"
										Text="СТАТУС"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="12"
										Text="{Binding StatusDisplay}"
										TextColor="{StaticResource SparkAccentTealDark}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontSize="11"
										Text="АВТОМАТСКИ ТЕРМИН"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="3"
										FontAttributes="Bold"
										FontSize="12"
										Text="{Binding AutomaticScheduleDisplay}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</Grid>

								<!--  Reason + notes  -->
								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">
									<VerticalStackLayout Grid.Column="0" Spacing="6">
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="Причина за посета (опционално)"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="12,0"
											BackgroundColor="White"
											HeightRequest="46"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Entry
												BackgroundColor="Transparent"
												FontSize="13"
												Placeholder="Пр. Редовна контрола"
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding Encounter.ReasonForVisit}"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout Grid.Column="1" Spacing="6">
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="Забелешки"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="12,8"
											BackgroundColor="White"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<Editor
												AutoSize="TextChanges"
												BackgroundColor="Transparent"
												FontSize="13"
												MinimumHeightRequest="46"
												Placeholder="Внесете дополнителни забелешки..."
												PlaceholderColor="{StaticResource SparkTextSecondary}"
												Text="{Binding EncounterDiagnosisNotes, Mode=TwoWay}"
												TextColor="{StaticResource SparkTextPrimary}" />
										</Border>
									</VerticalStackLayout>
								</Grid>

							</VerticalStackLayout>

							<!--  ── АКЦИИ ────────────────────────────────────  -->
							<Grid
								Padding="0,8,0,8"
								ColumnDefinitions="*,*"
								ColumnSpacing="16">
								<controls:FFButton
									Grid.Column="0"
									ButtonKind="Secondary"
									Command="{Binding CancelCommand}"
									HeightRequestEx="46"
									Text="Откажи" />
								<controls:FFButton
									Grid.Column="1"
									ButtonKind="Primary"
									Command="{Binding SaveEncounterCommand}"
									HeightRequestEx="46"
									Text="Зачувај преглед" />
							</Grid>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ТЕРМИН/ЦИКЛУС + ПРЕГЛЕДИ + ДОКУМЕНТИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<Border Grid.Column="1" Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="14" Spacing="14">

							<!--  Section: Поврзување  -->
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Text="ПОВРЗУВАЊЕ СО ТЕРМИН / ЦИКЛУС"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<controls:FFButton
									Grid.Column="0"
									ButtonKind="Secondary"
									Command="{Binding SelectAppointmentCommand}"
									HeightRequestEx="44"
									Text="+ Избери термин" />
								<controls:FFButton
									Grid.Column="1"
									ButtonKind="Secondary"
									Command="{Binding SelectTherapyCycleCommand}"
									HeightRequestEx="44"
									Text="+ Избери циклус" />
							</Grid>

							<!--  Selected appointment  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasAppointment}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf073;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontSize="10"
											Text="Поврзан термин"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding AppointmentDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
									<Button
										Grid.Column="2"
										Padding="0"
										BackgroundColor="Transparent"
										Command="{Binding ClearAppointmentCommand}"
										FontSize="11"
										HeightRequest="20"
										Text="✕"
										TextColor="{StaticResource SparkTextSecondary}"
										WidthRequest="20" />
								</Grid>
							</Border>

							<!--  Selected therapy cycle  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasTherapyCycle}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf0ec;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontSize="10"
											Text="Терапевтски циклус"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding TherapyCycleDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
									<Button
										Grid.Column="2"
										Padding="0"
										BackgroundColor="Transparent"
										Command="{Binding ClearTherapyCycleCommand}"
										FontSize="11"
										HeightRequest="20"
										Text="✕"
										TextColor="{StaticResource SparkTextSecondary}"
										WidthRequest="20" />
								</Grid>
							</Border>

							<!--  Section: Последни прегледи  -->
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Text="ПОСЛЕДНИ ПРЕГЛЕДИ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за историја."
								TextColor="{StaticResource SparkTextSecondary}" />

							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding RecentEncounters}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема евидентирани прегледи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Encounter">
										<Border
											Padding="12,10"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
												<Border
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													HeightRequest="32"
													StrokeShape="RoundRectangle 16"
													StrokeThickness="0"
													WidthRequest="32">
													<Label
														FontFamily="FASolid"
														FontSize="11"
														HorizontalOptions="Center"
														Text="&#xf0f1;"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="2"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="12"
														LineBreakMode="TailTruncation"
														Text="{Binding ReasonForVisit}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="10"
														Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<Border
													Grid.Column="2"
													Padding="8,3"
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="9"
														Text="{Binding Status}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<!--  Section: Документи  -->
							<Border
								Padding="14,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasPatientContext}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Text="ДОКУМЕНТИ НА ПАЦИЕНТ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за документи."
								TextColor="{StaticResource SparkTextSecondary}" />

							<FlexLayout
								BindableLayout.ItemsSource="{Binding PatientDocuments}"
								Direction="Row"
								IsVisible="{Binding HasPatientContext}"
								JustifyContent="Start"
								Wrap="Wrap">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема прикачени документи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientDocument">
										<Border
											Margin="0,0,8,8"
											Padding="0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											HeightRequest="110"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1"
											WidthRequest="110">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid RowDefinitions="*,Auto" RowSpacing="0">
												<Grid Grid.Row="0" IsClippedToBounds="True">
													<Image
														Aspect="AspectFill"
														IsVisible="{Binding IsImageDocument}"
														Source="{Binding StoredPath}" />
													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														IsVisible="{Binding IsImageDocument, Converter={StaticResource InverseBoolConverter}}"
														StrokeThickness="0">
														<VerticalStackLayout
															HorizontalOptions="Center"
															Spacing="4"
															VerticalOptions="Center">
															<Label
																FontFamily="FASolid"
																FontSize="24"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTeal}" />
															<Label
																FontSize="8"
																HorizontalOptions="Center"
																Text="{Binding DocumentType}"
																TextColor="{StaticResource SparkAccentTealDark}" />
														</VerticalStackLayout>
													</Border>
													<Border
														Margin="4"
														Padding="4,3"
														BackgroundColor="#99000000"
														HorizontalOptions="End"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0"
														VerticalOptions="Start">
														<Label
															FontFamily="FASolid"
															FontSize="9"
															Text="&#xf00e;"
															TextColor="White" />
													</Border>
												</Grid>
												<Border
													Grid.Row="1"
													Padding="6,4"
													BackgroundColor="White"
													StrokeThickness="0">
													<VerticalStackLayout Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="9"
															LineBreakMode="TailTruncation"
															Text="{Binding Title}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="8"
															Text="{Binding DocumentType}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</FlexLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

			</Grid>
		</Grid>
	</Grid>
</ContentPage>