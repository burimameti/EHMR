<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterCreateViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			Style="{StaticResource CrudFormPageGridStyle}">

			<Border
				Grid.Row="0"
				Margin="16,16,16,0"
				Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader
					Title="Внесување на нов преглед"
					PrimaryButtonCommand="{Binding SaveEncounterCommand}"
					PrimaryButtonText="Зачувај"
					SecondaryButtonCommand="{Binding CancelCommand}"
					SecondaryButtonText="Откажи"
					ShowPrimaryButton="True"
					ShowSecondaryButton="True"
					Subtitle="Внесете ги основните и медицинските детали за тековниот преглед" />
			</Border>

			<Grid
				Grid.Row="1"
				Margin="16,0,16,0"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="6"
				Style="{StaticResource CrudFormBodyGridStyle}">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="0"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">

							<!--  ── 1. ПАЦИЕНТ И РЕУМАТОЛОГ ─────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<!--  Section header  -->
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ПАЦИЕНТ И РЕУМАТОЛОГ" />
								</Border>

								<!--  Locked context display  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="12"
									IsVisible="{Binding IsPatientLockedFromContext}">
									<Border
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Избран пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<Border
										Grid.Column="1"
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Матичен реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  Patient search (hidden when locked)  -->
								<VerticalStackLayout Spacing="8">
									<VerticalStackLayout.Triggers>
										<DataTrigger
											Binding="{Binding IsPatientLockedFromContext}"
											TargetType="VerticalStackLayout"
											Value="True">
											<Setter Property="IsVisible" Value="False" />
										</DataTrigger>
									</VerticalStackLayout.Triggers>

									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<controls:FFSearchBox Placeholder="Пребарај по име, ЕМБГ или СЗБО..." Text="{Binding PatientSearchText, Mode=TwoWay}" />
										<HorizontalStackLayout
											Grid.Column="1"
											Spacing="4"
											VerticalOptions="Center">
											<CheckBox IsChecked="{Binding UseCyrillicPatientSearch, Mode=TwoWay}" />
											<Label
												FontSize="12"
												Text="Кирилица"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Grid>

									<!--  Autocomplete dropdown  -->
									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowPatientSuggestions}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView
											HeightRequest="164"
											ItemsSource="{Binding PatientSuggestions}"
											SelectedItem="{Binding PatientSuggestionSelection, Mode=TwoWay}"
											SelectionMode="Single">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Patient">
													<Border
														Margin="1"
														Padding="10,7"
														BackgroundColor="#F8FAFC"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 7"
														StrokeThickness="1">
														<Grid ColumnDefinitions="2*,1.2*" ColumnSpacing="12">
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
															<VerticalStackLayout Grid.Column="1" Spacing="1">
																<Label
																	FontSize="9.5"
																	Text="СЗБО број"
																	TextColor="{StaticResource SparkTextSecondary}" />
																<Label
																	FontAttributes="Bold"
																	FontSize="11.5"
																	Text="{Binding SzboNumber}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
															</VerticalStackLayout>
														</Grid>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>
								</VerticalStackLayout>

								<!--  Selected patient info card  -->
								<Border
									Padding="14"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									IsVisible="{Binding HasPatientContext}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="0">
									<Grid
										ColumnDefinitions="*,*,*"
										ColumnSpacing="12"
										RowDefinitions="Auto,Auto,Auto,Auto,Auto"
										RowSpacing="2">

										<Label
											Grid.Row="0"
											Grid.ColumnSpan="3"
											FontAttributes="Bold"
											FontSize="15"
											LineBreakMode="WordWrap"
											Text="{Binding SelectedPatient.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />

										<Label
											Grid.Row="1"
											Grid.Column="0"
											FontSize="10"
											Text="Возраст"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="1"
											Grid.Column="1"
											FontSize="10"
											Text="Пол"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="1"
											Grid.Column="2"
											FontSize="10"
											Text="Статус"
											TextColor="{StaticResource SparkTextSecondary}" />

										<Label
											Grid.Row="2"
											Grid.Column="0"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.Age, StringFormat='{0} год.'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Row="2"
											Grid.Column="1"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.Gender}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Border
											Grid.Row="2"
											Grid.Column="2"
											Padding="8,3"
											BackgroundColor="{StaticResource SparkAccentTealBg}"
											HorizontalOptions="Start"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Label
												FontAttributes="Bold"
												FontSize="10"
												Text="{Binding SelectedPatient.Status}"
												TextColor="{StaticResource SparkAccentTealDark}" />
										</Border>

										<Label
											Grid.Row="3"
											Grid.Column="0"
											FontSize="10"
											Text="СЗБО број"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="3"
											Grid.Column="1"
											FontSize="10"
											Text="Телефон"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											Grid.Row="3"
											Grid.Column="2"
											FontSize="10"
											Text="Матичен реуматолог"
											TextColor="{StaticResource SparkTextSecondary}" />

										<Label
											Grid.Row="4"
											Grid.Column="0"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.SzboNumber, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Row="4"
											Grid.Column="1"
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											Grid.Row="4"
											Grid.Column="2"
											FontAttributes="Bold"
											FontSize="12"
											LineBreakMode="TailTruncation"
											Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</Grid>
								</Border>

							</VerticalStackLayout>

							<!--  ── 2. МКБ-10 ДИЈАГНОСТИКА ─────────────────  -->
							<VerticalStackLayout Spacing="14">
								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="МКБ-10 ДИЈАГНОСТИКА" />
								</Border>

								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									RowDefinitions="Auto,Auto"
									RowSpacing="12">
									<VerticalStackLayout Grid.ColumnSpan="2" Spacing="5">
										<Label
											FontAttributes="Bold"
											FontSize="11"
											Text="МКБ СЕКЦИЈА · ЛАТИНИЦА A–Z"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Border
											Padding="6,5"
											BackgroundColor="#F4F7FA"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 9"
											StrokeThickness="1">
											<ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
												<FlexLayout
													BindableLayout.ItemsSource="{Binding MkbAlphabetSections}"
													Direction="Row"
													JustifyContent="Start"
													Wrap="NoWrap">
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="vm:MkbAlphabetSection">
															<Border
																Margin="1"
																Padding="2"
																HeightRequest="30"
																StrokeShape="RoundRectangle 6"
																StrokeThickness="1"
																WidthRequest="28">
																<Border.Triggers>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Border"
																		Value="True">
																		<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
																		<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
																	</DataTrigger>
																	<DataTrigger
																		Binding="{Binding IsSelected}"
																		TargetType="Border"
																		Value="False">
																		<Setter Property="BackgroundColor" Value="White" />
																		<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
																	</DataTrigger>
																</Border.Triggers>
																<Border.GestureRecognizers>
																	<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectMkbSectionCommand}" CommandParameter="{Binding .}" />
																</Border.GestureRecognizers>
																<Label
																	FontAttributes="Bold"
																	FontSize="10.5"
																	HorizontalOptions="Center"
																	Text="{Binding Letter}"
																	VerticalOptions="Center">
																	<Label.Triggers>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="True">
																			<Setter Property="TextColor" Value="White" />
																		</DataTrigger>
																		<DataTrigger
																			Binding="{Binding IsSelected}"
																			TargetType="Label"
																			Value="False">
																			<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
																		</DataTrigger>
																	</Label.Triggers>
																</Label>
															</Border>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</FlexLayout>
											</ScrollView>
										</Border>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="0"
										Spacing="12">


										<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
											<VerticalStackLayout Spacing="5">
												<Label
													FontAttributes="Bold"
													FontSize="11.5"
													Text="Пребарување по МКБ код (латиница)"
													TextColor="{StaticResource SparkTextSecondary}" />
												<controls:FFSearchBox Placeholder="Пример: M06.9" Text="{Binding MkbCodeSearchText, Mode=TwoWay}" />
											</VerticalStackLayout>
											<VerticalStackLayout Grid.Column="1" Spacing="5">
												<Label
													FontAttributes="Bold"
													FontSize="11.5"
													Text="Пребарување по опис (кирилица)"
													TextColor="{StaticResource SparkTextSecondary}" />
												<controls:FFSearchBox Placeholder="Пример: ревматоиден артритис" Text="{Binding MkbDescriptionSearchText, Mode=TwoWay}" />
											</VerticalStackLayout>
										</Grid>
										<CollectionView
											HeightRequest="180"
											IsVisible="{Binding ShowMkbDropdown}"
											ItemsSource="{Binding MkbResults}">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Mkb10Code">
													<Border
														Margin="0,4"
														Padding="12"
														BackgroundColor="{StaticResource SparkTabActiveBg}"
														StrokeShape="RoundRectangle 10"
														StrokeThickness="0">
														<Border.GestureRecognizers>
															<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMkbCommand}" CommandParameter="{Binding .}" />
														</Border.GestureRecognizers>
														<VerticalStackLayout Spacing="2">
															<Label
																FontAttributes="Bold"
																FontSize="13"
																Text="{Binding Code}"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontSize="12"
																Text="{Binding Description}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</VerticalStackLayout>

									<VerticalStackLayout
										Grid.Row="1"
										Grid.Column="1"
										Spacing="14">
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding Diagnoses}" Spacing="8">
											<BindableLayout.EmptyView>
												<Label
													FontSize="12"
													Text="Нема доделени дијагнози."
													TextColor="{StaticResource SparkTextSecondary}" />
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:Diagnosis">
													<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
														<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
														<Border Grid.Column="1" Style="{StaticResource CrudCollectionItemStyle}">
															<Grid ColumnDefinitions="Auto,*,28" ColumnSpacing="8">
																<Label Style="{StaticResource CrudCollectionCodeStyle}" Text="{Binding Mkb10Code.Code}" />
																<Label
																	Grid.Column="1"
																	LineBreakMode="TailTruncation"
																	Style="{StaticResource CrudCollectionMetaStyle}"
																	Text="{Binding Mkb10Code.Description}" />
																<Button
																	Grid.Column="2"
																	Padding="0"
																	BackgroundColor="Transparent"
																	Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMkbCommand}"
																	CommandParameter="{Binding .}"
																	FontSize="11"
																	HeightRequest="26"
																	Text="✕"
																	TextColor="#DC2626"
																	WidthRequest="26" />
															</Grid>
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>

										<VerticalStackLayout Spacing="8">
											<Label
												FontAttributes="Bold"
												FontSize="13"
												Text="Забелешка за дијагнозата"
												TextColor="{StaticResource SparkTextSecondary}" />
											<Border
												Padding="12,8"
												BackgroundColor="{StaticResource SparkBackground}"
												Stroke="{StaticResource SparkAccentTealBg}"
												StrokeShape="RoundRectangle 8"
												StrokeThickness="1">
												<Editor
													AutoSize="TextChanges"
													BackgroundColor="Transparent"
													FontSize="13"
													MinimumHeightRequest="46"
													Placeholder="Забелешки надвор од МКБ..."
													PlaceholderColor="{StaticResource SparkTextSecondary}"
													Text="{Binding EncounterDiagnosisNotes}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Border>
										</VerticalStackLayout>
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  ── ОЦЕНКА ─────────────────────────────────  -->
							<VerticalStackLayout Spacing="8">
								<controls:CrudSectionHeader Title="ОЦЕНКА" />
								<Border Style="{StaticResource TextAreaFieldBoxStyle}">
									<Entry
										BackgroundColor="Transparent"
										FontSize="13"
										Placeholder="Внесете резултат или оценка..."
										Text="{Binding ScoreText, Mode=TwoWay}"
										TextColor="{StaticResource SparkTextPrimary}" />
								</Border>
							</VerticalStackLayout>

							<!--  ── 3. ЛЕКОВИ ──────────────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ЛЕКОВИ" />
								</Border>

								<Grid ColumnDefinitions="*,*" ColumnSpacing="16">

									<!--  Medicine search + dropdown  -->
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:FFSearchBox Placeholder="Пребарување на лекот..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />

										<Border
											Padding="4"
											BackgroundColor="White"
											IsVisible="{Binding ShowMedicineDropdown}"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 8"
											StrokeThickness="1">
											<CollectionView HeightRequest="200" ItemsSource="{Binding MedicineResults}">
												<CollectionView.ItemTemplate>
													<DataTemplate x:DataType="entities:Medicine">
														<Border
															Margin="2,2,2,0"
															Padding="10,8"
															BackgroundColor="Transparent"
															StrokeThickness="0">
															<Border.GestureRecognizers>
																<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
															</Border.GestureRecognizers>
															<VerticalStackLayout Spacing="2">
																<Label
																	FontAttributes="Bold"
																	FontSize="13"
																	Text="{Binding Name}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
																<Label
																	FontSize="11"
																	Text="{Binding GenericName}"
																	TextColor="{StaticResource SparkTextSecondary}" />
															</VerticalStackLayout>
														</Border>
													</DataTemplate>
												</CollectionView.ItemTemplate>
											</CollectionView>
										</Border>
									</VerticalStackLayout>

									<!--  Medicine table (right column)  -->
									<VerticalStackLayout Grid.Column="1" Spacing="0">

										<Label
											Margin="0,0,0,8"
											FontAttributes="Bold"
											FontSize="11"
											Text="Додадени за овој преглед"
											TextColor="{StaticResource SparkTextSecondary}" />

										<!--  Table header  -->
										<Grid
											ColumnDefinitions="2*,1*,32"
											ColumnSpacing="1"
											IsVisible="{Binding HasEncounterMedicines}">
											<Border
												Grid.Column="0"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeShape="RoundRectangle 6,0,0,0"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="ИМЕ НА ЛЕКОТ"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="1"
												Padding="10,8"
												BackgroundColor="#475569"
												StrokeThickness="0">
												<Label
													FontAttributes="Bold"
													FontSize="10"
													Text="КОЛИЧИНА"
													TextColor="White" />
											</Border>
											<Border
												Grid.Column="2"
												BackgroundColor="#475569"
												StrokeShape="RoundRectangle 0,6,0,0"
												StrokeThickness="0" />
										</Grid>

										<!--  Table rows  -->
										<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
											<BindableLayout.EmptyView>
												<Border
													Padding="12,14"
													BackgroundColor="White"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Label
														FontSize="12"
														Text="Нема додадени лекови за овој преглед."
														TextColor="{StaticResource SparkTextSecondary}" />
												</Border>
											</BindableLayout.EmptyView>
											<BindableLayout.ItemTemplate>
												<DataTemplate x:DataType="entities:PatientMedicine">
													<Grid ColumnDefinitions="2*,1*,32" ColumnSpacing="1">
														<Border
															Grid.Column="0"
															Padding="10,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Label
																FontSize="12"
																LineBreakMode="TailTruncation"
																Text="{Binding Medicine.Name}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center" />
														</Border>
														<Border
															Grid.Column="1"
															Padding="4,0"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Entry
																BackgroundColor="Transparent"
																FontSize="12"
																Keyboard="Numeric"
																Text="{Binding Dosage, Mode=TwoWay}"
																TextColor="{StaticResource SparkTextPrimary}"
																VerticalOptions="Center"
																VerticalTextAlignment="Center" />
														</Border>
														<Border
															Grid.Column="2"
															BackgroundColor="White"
															HeightRequest="44"
															Stroke="{StaticResource SparkBorderSubtle}"
															StrokeThickness="1">
															<Button
																Padding="0"
																BackgroundColor="Transparent"
																Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
																CommandParameter="{Binding .}"
																FontSize="12"
																Text="✕"
																TextColor="#DC2626"
																WidthRequest="32" />
														</Border>
													</Grid>
												</DataTemplate>
											</BindableLayout.ItemTemplate>
										</VerticalStackLayout>

									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>

							<!--  ── 4. ДЕТАЛИ ЗА ПРЕГЛЕДОТ ────────────────  -->
							<VerticalStackLayout Spacing="12">

								<Border Style="{StaticResource SectionPillBorderStyle}">
									<Label
										CharacterSpacing="0.5"
										FontAttributes="Bold"
										FontSize="12"
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ДЕТАЛИ ЗА ПРЕГЛЕДОТ" />
								</Border>

								<!--  Status + schedule row  -->
								<Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
									<Label
										FontSize="11"
										Text="СТАТУС"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="12"
										Text="{Binding StatusDisplay}"
										TextColor="{StaticResource SparkAccentTealDark}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="2"
										FontSize="11"
										Text="АВТОМАТСКИ ТЕРМИН"
										TextColor="{StaticResource SparkTextSecondary}"
										VerticalOptions="Center" />
									<Label
										Grid.Column="3"
										FontAttributes="Bold"
										FontSize="12"
										Text="{Binding AutomaticScheduleDisplay}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</Grid>
							</VerticalStackLayout>

							<!--  ── АКЦИИ ────────────────────────────────────  -->
							<Grid
								Padding="0,8,0,8"
								ColumnDefinitions="*,*"
								ColumnSpacing="16">
								<controls:FFButton
									Grid.Column="0"
									ButtonKind="Secondary"
									Command="{Binding CancelCommand}"
									HeightRequestEx="46"
									Text="Откажи" />
								<controls:FFButton
									Grid.Column="1"
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									ButtonKind="Primary"
									Command="{Binding SaveEncounterCommand}"
									HeightRequestEx="46"
									Text="Зачувај"
									TextColorEx="{StaticResource SidebarActiveText}" />
							</Grid>

						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ТЕРМИН/ЦИКЛУС + ПРЕГЛЕДИ + ДОКУМЕНТИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="1"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormSidebarStackStyle}">

							<!--  Section: Поврзување  -->
							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Style="{StaticResource SectionPillLabelStyle}"
									Text="ПОВРЗУВАЊЕ СО ТЕРМИН / ЦИКЛУС" />
							</Border>

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<controls:FFButton
									Grid.Column="0"
									ButtonKind="Secondary"
									Command="{Binding SelectAppointmentCommand}"
									HeightRequestEx="44"
									Text="+ Избери термин" />
								<controls:FFButton
									Grid.Column="1"
									ButtonKind="Secondary"
									Command="{Binding SelectTherapyCycleCommand}"
									HeightRequestEx="44"
									Text="+ Избери циклус" />
							</Grid>

							<!--  Selected appointment  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasAppointment}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf073;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontSize="10"
											Text="Поврзан термин"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding AppointmentDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
									<Button
										Grid.Column="2"
										Padding="0"
										BackgroundColor="Transparent"
										Command="{Binding ClearAppointmentCommand}"
										FontSize="11"
										HeightRequest="20"
										Text="✕"
										TextColor="{StaticResource SparkTextSecondary}"
										WidthRequest="20" />
								</Grid>
							</Border>

							<!--  Selected therapy cycle  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasTherapyCycle}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf0ec;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontSize="10"
											Text="Терапевтски циклус"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding TherapyCycleDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
									<Button
										Grid.Column="2"
										Padding="0"
										BackgroundColor="Transparent"
										Command="{Binding ClearTherapyCycleCommand}"
										FontSize="11"
										HeightRequest="20"
										Text="✕"
										TextColor="{StaticResource SparkTextSecondary}"
										WidthRequest="20" />
								</Grid>
							</Border>

							<!--  Section: Последни прегледи  -->
							<Border Style="{StaticResource SectionPillBorderStyle}">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Style="{StaticResource SectionPillLabelStyle}"
									Text="ПОСЛЕДНИ ПРЕГЛЕДИ" />
							</Border>

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за историја."
								TextColor="{StaticResource SparkTextSecondary}" />

							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding RecentEncounters}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема евидентирани прегледи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Encounter">
										<Border
											Padding="12,10"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenEncounterCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
												<Border
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													HeightRequest="32"
													StrokeShape="RoundRectangle 16"
													StrokeThickness="0"
													WidthRequest="32">
													<Label
														FontFamily="FASolid"
														FontSize="11"
														HorizontalOptions="Center"
														Text="&#xf0f1;"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="2"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="12"
														LineBreakMode="TailTruncation"
														Text="{Binding ClinicalNotes, TargetNullValue='Преглед без наведена причина'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="10"
														Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<Border
													Grid.Column="2"
													Padding="8,3"
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="9"
														Text="{Binding Status}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<Border IsVisible="{Binding HasPatientContext}" Style="{StaticResource SectionPillBorderStyle}">
								<Label Style="{StaticResource SectionPillLabelStyle}" Text="ИСТОРИЈА НА ДИЈАГНОЗИ" />
							</Border>
							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding PatientDiagnoses}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема претходни дијагнози."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Diagnosis">
										<Border
											Padding="10,8"
											BackgroundColor="{StaticResource SparkContentBackground}"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
												<Label
													FontAttributes="Bold"
													FontSize="12.5"
													Text="{Binding Mkb10Code.Code}"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<Label
													Grid.Column="1"
													FontSize="11.5"
													LineBreakMode="TailTruncation"
													Text="{Binding Mkb10Code.Description}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<!--  Section: Документи  -->
							<Border IsVisible="{Binding HasPatientContext}" Style="{StaticResource SectionPillBorderStyle}">
								<Label
									CharacterSpacing="0.5"
									FontAttributes="Bold"
									FontSize="11"
									Text="ДОКУМЕНТИ НА ПАЦИЕНТ" />
							</Border>

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за документи."
								TextColor="{StaticResource SparkTextSecondary}" />

							<Border
								Padding="10"
								BackgroundColor="{StaticResource SparkContentBackground}"
								IsVisible="{Binding LatestPatientDocument, Converter={StaticResource SparkNotNullConverter}}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12">
									<Border
										HeightRequest="90"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0"
										WidthRequest="110">
										<Image Aspect="AspectFill" Source="{Binding LatestPatientDocument.StoredPath}" />
									</Border>
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="4"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding LatestPatientDocument.Title}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.DocumentType}"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.UploadedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="2"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding PreviewDocumentCommand}"
										CommandParameter="{Binding LatestPatientDocument}"
										ContentPadding="12,0"
										HeightRequestEx="38"
										Text="🔍 Отвори"
										TextColorEx="{StaticResource SidebarActiveText}"
										WidthRequestEx="110" />
								</Grid>
							</Border>
							<FlexLayout
								BindableLayout.ItemsSource="{Binding PatientDocuments}"
								Direction="Row"
								IsVisible="{Binding HasPatientContext}"
								JustifyContent="Start"
								Wrap="Wrap">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема прикачени документи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientDocument">
										<Border
											Margin="0,0,8,8"
											Padding="0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											HeightRequest="110"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1"
											WidthRequest="110">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid RowDefinitions="*,Auto" RowSpacing="0">
												<Grid Grid.Row="0" IsClippedToBounds="True">
													<Image
														Aspect="AspectFill"
														IsVisible="{Binding IsImageDocument}"
														Source="{Binding StoredPath}" />
													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														IsVisible="{Binding IsImageDocument, Converter={StaticResource InverseBoolConverter}}"
														StrokeThickness="0">
														<VerticalStackLayout
															HorizontalOptions="Center"
															Spacing="4"
															VerticalOptions="Center">
															<Label
																FontFamily="FASolid"
																FontSize="24"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTeal}" />
															<Label
																FontSize="8"
																HorizontalOptions="Center"
																Text="{Binding DocumentType}"
																TextColor="{StaticResource SparkAccentTealDark}" />
														</VerticalStackLayout>
													</Border>
													<Border
														Margin="4"
														Padding="4,3"
														BackgroundColor="#99000000"
														HorizontalOptions="End"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0"
														VerticalOptions="Start">
														<Label
															FontFamily="FASolid"
															FontSize="9"
															Text="&#xf00e;"
															TextColor="{StaticResource SparkTextSecondary}" />
													</Border>
												</Grid>
												<Border
													Grid.Row="1"
													Padding="6,4"
													BackgroundColor="White"
													StrokeThickness="0">
													<VerticalStackLayout Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="9"
															LineBreakMode="TailTruncation"
															Text="{Binding Title}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="8"
															Text="{Binding DocumentType}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</FlexLayout>

						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

			</Grid>
		</Grid>
	</Grid>
</ContentPage>
