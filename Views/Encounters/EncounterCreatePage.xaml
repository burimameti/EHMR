<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterCreatePage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:vm="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="vm:EncounterCreateViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<Grid ColumnDefinitions="285,*">

		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			RowDefinitions="Auto,*"
			Style="{StaticResource CrudFormPageGridStyle}">

			<Border
				Grid.Row="0"
				Margin="16,16,16,0"
				Style="{StaticResource PageCardStyleDashboard}">
				<controls:FFPageHeader
					Title="Внесување на нов преглед"
					Subtitle="Внесете ги основните и медицинските детали за тековниот преглед" />
			</Border>

			<Grid
				Grid.Row="1"
				Margin="16,0,16,0"
				ColumnDefinitions="2*,1*"
				ColumnSpacing="6"
				Style="{StaticResource CrudFormBodyGridStyle}">

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ЛЕВА КОЛОНА — ФОРМИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="0"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormContentStackStyle}">

							<!--  ── 1. ПАЦИЕНТ И РЕУМАТОЛОГ ─────────────────────  -->
							<VerticalStackLayout Spacing="12">

								<!--  Section header  -->
								<controls:CrudSectionHeader Title="ПАЦИЕНТ И РЕУМАТОЛОГ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />

								<!--  Locked context display  -->
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="12"
									IsVisible="{Binding IsPatientLockedFromContext}">
									<Border
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 10"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Избран пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>

									<Border
										Grid.Column="1"
										Padding="14,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="36"
												StrokeShape="RoundRectangle 18"
												StrokeThickness="0"
												WidthRequest="36">
												<Label
													FontFamily="FASolid"
													FontSize="13"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="10"
													Text="Матичен реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="15"
													LineBreakMode="TailTruncation"
													Text="{Binding SelectedDoctor.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>

								<!--  Patient search (hidden when locked)  -->
								<VerticalStackLayout Spacing="8">
									<VerticalStackLayout.Triggers>
										<DataTrigger
											Binding="{Binding IsPatientLockedFromContext}"
											TargetType="VerticalStackLayout"
											Value="True">
											<Setter Property="IsVisible" Value="False" />
										</DataTrigger>
									</VerticalStackLayout.Triggers>

									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<controls:FFSearchBox Placeholder="Пребарај по име, ЕМБГ или СЗБО..." Text="{Binding PatientSearchText, Mode=TwoWay}" />
										<HorizontalStackLayout
											Grid.Column="1"
											Spacing="4"
											VerticalOptions="Center">
											<CheckBox IsChecked="{Binding UseCyrillicPatientSearch, Mode=TwoWay}" />
											<Label
												FontSize="12"
												Text="Кирилица"
												TextColor="{StaticResource SparkTextPrimary}"
												VerticalOptions="Center" />
										</HorizontalStackLayout>
									</Grid>

									<!--  Autocomplete dropdown  -->
									<Border
										Padding="4"
										BackgroundColor="White"
										IsVisible="{Binding ShowPatientSuggestions}"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 8"
										StrokeThickness="1">
										<CollectionView
											HeightRequest="164"
											ItemsSource="{Binding PatientSuggestions}"
											SelectedItem="{Binding PatientSuggestionSelection, Mode=TwoWay}"
											SelectionMode="Single">
											<CollectionView.ItemTemplate>
												<DataTemplate x:DataType="entities:Patient">
													<Border
														Margin="1"
														Padding="10,7"
														BackgroundColor="#F8FAFC"
														Stroke="{StaticResource SparkBorderSubtle}"
														StrokeShape="RoundRectangle 7"
														StrokeThickness="1">
														<Grid ColumnDefinitions="2*,1.2*" ColumnSpacing="12">
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
															<VerticalStackLayout Grid.Column="1" Spacing="1">
																<Label
																	FontSize="9.5"
																	Text="СЗБО број"
																	TextColor="{StaticResource SparkTextSecondary}" />
																<Label
																	FontAttributes="Bold"
																	FontSize="11.5"
																	Text="{Binding SzboNumber}"
																	TextColor="{StaticResource SparkAccentTealDark}" />
															</VerticalStackLayout>
														</Grid>
													</Border>
												</DataTemplate>
											</CollectionView.ItemTemplate>
										</CollectionView>
									</Border>
								</VerticalStackLayout>

								<!-- Основни податоци за пациентот -->
								<Border
									Padding="14"
									BackgroundColor="{StaticResource SparkTabActiveBg}"
									IsVisible="{Binding HasPatientContext}"
									StrokeShape="RoundRectangle 10"
									StrokeThickness="0">
									<Grid ColumnDefinitions="1.4*,1*,1*,1.4*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="6">
										<Label Grid.ColumnSpan="4" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" Text="{Binding SelectedPatient.FullName, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" />
										<VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="1"><Label FontSize="10" Text="Датум на раѓање" TextColor="{StaticResource SparkTextSecondary}" /><Label FontAttributes="Bold" FontSize="12" Text="{Binding SelectedPatient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" TextColor="{StaticResource SparkTextPrimary}" /></VerticalStackLayout>
										
										<VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="1"><Label FontSize="10" Text="Пол" TextColor="{StaticResource SparkTextSecondary}" /><Label FontAttributes="Bold" FontSize="12" Text="{Binding SelectedPatient.Gender}" TextColor="{StaticResource SparkTextPrimary}" /></VerticalStackLayout>
										<VerticalStackLayout Grid.Row="1" Grid.Column="3" Spacing="1"><Label FontSize="10" Text="Адреса" TextColor="{StaticResource SparkTextSecondary}" /><Label FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" Text="{Binding SelectedPatient.Address, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" /></VerticalStackLayout>
										<VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="1"><Label FontSize="10" Text="Телефон" TextColor="{StaticResource SparkTextSecondary}" /><Label FontAttributes="Bold" FontSize="12" Text="{Binding SelectedPatient.Phone, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" /></VerticalStackLayout>
										<VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="1"><Label FontSize="10" Text="ЕЗБО" TextColor="{StaticResource SparkTextSecondary}" /><Label FontAttributes="Bold" FontSize="12" Text="{Binding SelectedPatient.SzboNumber, TargetNullValue='—'}" TextColor="{StaticResource SparkTextPrimary}" /></VerticalStackLayout>
										<VerticalStackLayout Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Spacing="1"><Label FontSize="10" Text="Матичен реуматолог" TextColor="{StaticResource SparkTextSecondary}" /><Label FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" Text="{Binding SelectedDoctor.FullName, TargetNullValue='—'}" TextColor="{StaticResource SparkAccentTealDark}" /></VerticalStackLayout>
									</Grid>
								</Border>
							</VerticalStackLayout>

							<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="10">
								<controls:CrudSectionHeader Title="БИОЛОШКА ТЕРАПИЈА" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
								<Grid ColumnDefinitions="*,*" ColumnSpacing="14">
									<VerticalStackLayout Grid.Column="0" Spacing="8">
										<controls:CrudSectionHeader Title="МКБ-10 ДИЈАГНОЗА" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
										<Label FontSize="11" Text="{Binding CurrentDiagnosesSummary, TargetNullValue='Нема внесена дијагноза.'}" TextColor="{StaticResource SparkTextPrimary}" LineBreakMode="WordWrap" />
										<controls:CrudSectionHeader Title="АКТИВНА ТЕРАПИЈА" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
										<Label FontSize="11" Text="{Binding ActiveMedicinesSummary, TargetNullValue='Нема активна терапија.'}" TextColor="{StaticResource SparkTextPrimary}" LineBreakMode="WordWrap" />
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="1" Spacing="8">
										<controls:CrudSectionHeader Title="МОМЕНТАЛЕН СКОР" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
										<Label FontSize="12" FontAttributes="Bold" Text="{Binding CurrentPatientScore, TargetNullValue='—'}" TextColor="{StaticResource SparkAccentTealDark}" />
										<controls:CrudSectionHeader Title="ЗАБЕЛЕШКА" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
										<Label FontSize="11" Text="{Binding EncounterDiagnosisNotes, TargetNullValue=''}" TextColor="{StaticResource SparkTextPrimary}" LineBreakMode="WordWrap" />
									</VerticalStackLayout>
								</Grid>
							</VerticalStackLayout>


							<!--  ── 2. ЛЕКОВИ ──────────────────────────────  -->
							<VerticalStackLayout Spacing="10">
								<controls:CrudSectionHeader Title="ЛЕКОВИ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
								<controls:FFSearchBox Placeholder="Пребарување на лекот..." Text="{Binding MedicineSearchText, Mode=TwoWay}" />
								<Border
									Padding="4"
									BackgroundColor="White"
									IsVisible="{Binding ShowMedicineDropdown}"
									Stroke="{StaticResource SparkBorderSubtle}"
									StrokeShape="RoundRectangle 8"
									StrokeThickness="1">
									<CollectionView HeightRequest="180" ItemsSource="{Binding MedicineResults}">
										<CollectionView.ItemTemplate>
											<DataTemplate x:DataType="entities:Medicine">
												<Border
													Padding="10,7"
													BackgroundColor="Transparent"
													StrokeThickness="0">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.AddMedicineCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<VerticalStackLayout Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="12.5"
															Text="{Binding Name}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															FontSize="10.5"
															Text="{Binding GenericName}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</DataTemplate>
										</CollectionView.ItemTemplate>
									</CollectionView>
								</Border>
								<Grid
									ColumnDefinitions="1.45*,1*,1.35*,0.85*,75"
									ColumnSpacing="1"
									IsVisible="{Binding HasEncounterMedicines}">
									<Border
										Padding="8,7"
										BackgroundColor="#475569"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="9.5"
											Text="ЛЕК"
											TextColor="White" />
									</Border>
									<Border
										Grid.Column="1"
										Padding="8,7"
										BackgroundColor="#475569"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="9.5"
											Text="ДОЗА"
											TextColor="White" />
									</Border>
									<Border
										Grid.Column="2"
										Padding="8,7"
										BackgroundColor="#475569"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="9.5"
											Text="НАЧИН НА АПЛИКАЦИЈА"
											TextColor="White" />
									</Border>
									<Border
										Grid.Column="3"
										Padding="8,7"
										BackgroundColor="#475569"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="9.5"
											Text="КОЛИЧИНА"
											TextColor="White" />
									</Border>
									<Border
										Grid.Column="4"
										Padding="0"
										BackgroundColor="#475569"
										StrokeThickness="0">
										<Label
											FontAttributes="Bold"
											FontSize="8"
											HorizontalOptions="Center"
											Text="АКТИВНА"
											TextColor="White"
											VerticalOptions="Center" />
									</Border>
								</Grid>
								<VerticalStackLayout BindableLayout.ItemsSource="{Binding EncounterMedicines}" Spacing="0">
									<BindableLayout.EmptyView>
										<Label
											FontSize="12"
											Text="Нема избран лек."
											TextColor="{StaticResource SparkTextSecondary}" />
									</BindableLayout.EmptyView>
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="entities:PatientMedicine">
											<Grid ColumnDefinitions="1.45*,1*,1.35*,0.85*,32" ColumnSpacing="1">
												<Border
													Padding="8,0"
													BackgroundColor="White"
													HeightRequest="42"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Label
														FontSize="11.5"
														LineBreakMode="TailTruncation"
														Text="{Binding Medicine.Name}"
														TextColor="{StaticResource SparkTextPrimary}"
														VerticalOptions="Center" />
												</Border>
												<Border
													Grid.Column="1"
													Padding="4,0"
													BackgroundColor="White"
													HeightRequest="42"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Entry
														BackgroundColor="Transparent"
														FontSize="11.5"
														Keyboard="Numeric"
														Text="{Binding Dosage, Mode=TwoWay}"
														TextColor="{StaticResource SparkTextPrimary}"
														VerticalOptions="Center" />
												</Border>
												<Border
													Grid.Column="2"
													Padding="3,0"
													BackgroundColor="White"
													HeightRequest="42"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Picker
														Title="Избери"
														FontSize="10.5"
														ItemDisplayBinding="{Binding Regime}"
														ItemsSource="{Binding Source={x:Reference PageRoot}, Path=BindingContext.ApplicationRegimeOptions}"
														SelectedItem="{Binding ApplicationRegime, Mode=TwoWay}"
														VerticalOptions="Center" />
												</Border>
												<Border
													Grid.Column="3"
													Padding="4,0"
													BackgroundColor="White"
													HeightRequest="42"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<Entry
														BackgroundColor="Transparent"
														FontSize="11.5"
														Keyboard="Numeric"
														Text="{Binding Quantity, Mode=TwoWay}"
														TextColor="{StaticResource SparkTextPrimary}"
														VerticalOptions="Center" />
												</Border>
												<Border
													Grid.Column="4"
													BackgroundColor="White"
													HeightRequest="42"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeThickness="1">
													<HorizontalStackLayout HorizontalOptions="Center" Spacing="2" VerticalOptions="Center">
														<CheckBox IsChecked="{Binding IsActive, Mode=TwoWay}" />
														<Button
															Padding="0"
															BackgroundColor="Transparent"
															Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.RemoveMedicineCommand}"
															CommandParameter="{Binding .}"
															FontSize="12"
															Text="✕"
															TextColor="#DC2626"
															WidthRequest="26" />
													</HorizontalStackLayout>
												</Border>
											</Grid>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</VerticalStackLayout>

							</VerticalStackLayout>


							<!--  ── 4. ДЕТАЛИ ЗА ПРЕГЛЕДОТ ────────────────  -->
							<VerticalStackLayout Spacing="12">

								<controls:CrudSectionHeader Title="ДЕТАЛИ ЗА ПРЕГЛЕДОТ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />

								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
									<Label FontSize="11" Text="АВТОМАТСКИ ТЕРМИН" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
									<Label Grid.Column="1" FontAttributes="Bold" FontSize="12" Text="{Binding AutomaticScheduleDisplay}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
								</Grid>
								<Grid
									Margin="0,6,0,0"
									ColumnDefinitions="Auto,*"
									ColumnSpacing="8">
									<CheckBox IsChecked="{Binding ScheduleNextFollowUp, Mode=TwoWay}" VerticalOptions="Center" />
									<Label
										Grid.Column="1"
										FontAttributes="Bold"
										FontSize="11.5"
										Text="Закажи следен термин"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</Grid>
								<Grid
									Margin="0,4,0,0"
									ColumnDefinitions="1.2*,1*"
									ColumnSpacing="8"
									IsVisible="{Binding ScheduleNextFollowUp}">
									<Border
										Padding="8,2"
										BackgroundColor="White"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="1">
										<DatePicker
											Date="{Binding NextFollowUpDate, Mode=TwoWay}"
											Format="dd.MM.yyyy"
											MinimumDate="{Binding FollowUpMinimumDate}"
											TextColor="{StaticResource SparkTextPrimary}" />
									</Border>
									<Border
										Grid.Column="1"
										Padding="3,0"
										BackgroundColor="White"
										Stroke="{StaticResource SparkBorderSubtle}"
										StrokeShape="RoundRectangle 7"
										StrokeThickness="1">
										<Picker
											Title="Брзо избирање"
											FontSize="11"
											ItemsSource="{Binding FollowUpIntervalOptions}"
											SelectedItem="{Binding SelectedFollowUpInterval, Mode=TwoWay}" />
									</Border>
								</Grid>
							</VerticalStackLayout>


							<HorizontalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,14,0,8">
								<Button BackgroundColor="{StaticResource SidebarActiveBg}" Command="{Binding SaveEncounterCommand}" HeightRequest="42" Style="{StaticResource TabButtonActiveStyle}" Text="Зачувај" TextColor="White" WidthRequest="150" />
								<Button BackgroundColor="#475569" Command="{Binding CancelCommand}" HeightRequest="42" Style="{StaticResource TabButtonStyle}" Text="Откажи" TextColor="White" WidthRequest="150" />
							</HorizontalStackLayout>
						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

				<!--  ═══════════════════════════════════════════════════════  -->
				<!--  ДЕСНА КОЛОНА — ТЕРМИН/ЦИКЛУС + ПРЕГЛЕДИ + ДОКУМЕНТИ  -->
				<!--  ═══════════════════════════════════════════════════════  -->
				<controls:FFSectionCard
					Grid.Column="1"
					Margin="0"
					Style="{StaticResource CrudFormCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Style="{StaticResource CrudFormSidebarStackStyle}">

							<!--  Section: Поврзување  -->
							<controls:CrudSectionHeader Title="ПОВРЗУВАЊЕ СО ТЕРМИН / ЦИКЛУС" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />

							<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
								<controls:FFButton
									Grid.Column="0"
									ButtonKind="Secondary"
									Command="{Binding SelectAppointmentCommand}"
									HeightRequestEx="44"
									Text="+ Избери термин" />
								<controls:FFButton
									Grid.Column="1"
									ButtonKind="Secondary"
									Command="{Binding SelectTherapyCycleCommand}"
									HeightRequestEx="44"
									Text="+ Избери циклус" />
								<controls:FFButton
									Grid.ColumnSpan="2"
									Margin="0,8,0,0"
									ButtonKind="Secondary"
									Command="{Binding AddNewAppointmentCommand}"
									HeightRequestEx="40"
									Text="+ Закажи следна контрола" />
							</Grid>

							<!--  Selected appointment  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasAppointment}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf073;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontSize="10"
											Text="Поврзан термин"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding AppointmentDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
									<Button
										Grid.Column="2"
										Padding="0"
										BackgroundColor="Transparent"
										Command="{Binding ClearAppointmentCommand}"
										FontSize="11"
										HeightRequest="20"
										Text="✕"
										TextColor="{StaticResource SparkTextSecondary}"
										WidthRequest="20" />
								</Grid>
							</Border>

							<!--  Selected therapy cycle  -->
							<Border
								Padding="12,10"
								BackgroundColor="{StaticResource SparkTabActiveBg}"
								IsVisible="{Binding HasTherapyCycle}"
								StrokeShape="RoundRectangle 8"
								StrokeThickness="0">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
									<Label
										FontFamily="FASolid"
										FontSize="12"
										Text="&#xf0ec;"
										TextColor="{StaticResource SparkAccentTeal}"
										VerticalOptions="Center" />
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="1"
										VerticalOptions="Center">
										<Label
											FontSize="10"
											Text="Терапевтски циклус"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontAttributes="Bold"
											FontSize="12"
											Text="{Binding TherapyCycleDisplay}"
											TextColor="{StaticResource SparkAccentTealDark}" />
									</VerticalStackLayout>
									<Button
										Grid.Column="2"
										Padding="0"
										BackgroundColor="Transparent"
										Command="{Binding ClearTherapyCycleCommand}"
										FontSize="11"
										HeightRequest="20"
										Text="✕"
										TextColor="{StaticResource SparkTextSecondary}"
										WidthRequest="20" />
								</Grid>
							</Border>

							<!--  Section: Последни прегледи  -->
							<controls:CrudSectionHeader Title="ПОСЛЕДНИ ПРЕГЛЕДИ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за историја."
								TextColor="{StaticResource SparkTextSecondary}" />

							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding RecentEncounters}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема евидентирани прегледи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Encounter">
										<Border
											Padding="12,10"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="0">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.OpenEncounterCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
												<Border
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													HeightRequest="32"
													StrokeShape="RoundRectangle 16"
													StrokeThickness="0"
													WidthRequest="32">
													<Label
														FontFamily="FASolid"
														FontSize="11"
														HorizontalOptions="Center"
														Text="&#xf0f1;"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
												</Border>
												<VerticalStackLayout
													Grid.Column="1"
													Spacing="2"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="12"
														LineBreakMode="TailTruncation"
														Text="{Binding ClinicalNotes, TargetNullValue='Преглед без наведена причина'}"
														TextColor="{StaticResource SparkTextPrimary}" />
													<Label
														FontSize="10"
														Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
														TextColor="{StaticResource SparkTextSecondary}" />
												</VerticalStackLayout>
												<Border
													Grid.Column="2"
													Padding="8,3"
													BackgroundColor="{StaticResource SparkAccentTealBg}"
													StrokeShape="RoundRectangle 8"
													StrokeThickness="0"
													VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontSize="9"
														Text="{Binding Status}"
														TextColor="{StaticResource SparkAccentTealDark}" />
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<controls:CrudSectionHeader IsVisible="{Binding HasPatientContext}" Title="ИСТОРИЈА НА ДИЈАГНОЗИ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />
							<VerticalStackLayout
								BindableLayout.ItemsSource="{Binding PatientDiagnoses}"
								IsVisible="{Binding HasPatientContext}"
								Spacing="6">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема претходни дијагнози."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:Diagnosis">
										<Border
											Padding="10,8"
											BackgroundColor="{StaticResource SparkContentBackground}"
											Stroke="{StaticResource SparkBorder}"
											StrokeShape="RoundRectangle 10"
											StrokeThickness="1">
											<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
												<Label
													FontAttributes="Bold"
													FontSize="12.5"
													Text="{Binding Mkb10Code.Code}"
													TextColor="{StaticResource SparkAccentTealDark}" />
												<Label
													Grid.Column="1"
													FontSize="11.5"
													LineBreakMode="TailTruncation"
													Text="{Binding Mkb10Code.Description}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</VerticalStackLayout>

							<!--  Section: Документи  -->
							<controls:CrudSectionHeader IsVisible="{Binding HasPatientContext}" Title="ДОКУМЕНТИ НА ПАЦИЕНТ" TextColor="{StaticResource SparkTextPrimary}" LineColor="{StaticResource SparkAccentTeal}" BackgroundColor="{StaticResource SparkAccentTealBg}" Padding="8,5" />

							<Label
								FontSize="12"
								IsVisible="{Binding HasPatientContext, Converter={StaticResource InverseBoolConverter}}"
								Text="Изберете пациент за документи."
								TextColor="{StaticResource SparkTextSecondary}" />

							<Border
								Padding="10"
								BackgroundColor="{StaticResource SparkContentBackground}"
								IsVisible="{Binding LatestPatientDocument, Converter={StaticResource SparkNotNullConverter}}"
								Stroke="{StaticResource SparkBorder}"
								StrokeShape="RoundRectangle 12"
								StrokeThickness="1">
								<Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12">
									<Border
										HeightRequest="90"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0"
										WidthRequest="110">
										<Image Aspect="AspectFill" Source="{Binding LatestPatientDocument.StoredPath}" />
									</Border>
									<VerticalStackLayout
										Grid.Column="1"
										Spacing="4"
										VerticalOptions="Center">
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding LatestPatientDocument.Title}"
											TextColor="{StaticResource SparkTextPrimary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.DocumentType}"
											TextColor="{StaticResource SparkTextSecondary}" />
										<Label
											FontSize="11.5"
											Text="{Binding LatestPatientDocument.UploadedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
											TextColor="{StaticResource SparkTextSecondary}" />
									</VerticalStackLayout>
									<controls:FFButton
										Grid.Column="2"
										BackgroundColorEx="{StaticResource SidebarActiveBg}"
										ButtonKind="Primary"
										Command="{Binding PreviewDocumentCommand}"
										CommandParameter="{Binding LatestPatientDocument}"
										ContentPadding="12,0"
										HeightRequestEx="38"
										Text="🔍 Отвори"
										TextColorEx="{StaticResource SidebarActiveText}"
										WidthRequestEx="110" />
								</Grid>
							</Border>
							<FlexLayout
								BindableLayout.ItemsSource="{Binding PatientDocuments}"
								Direction="Row"
								IsVisible="{Binding HasPatientContext}"
								JustifyContent="Start"
								Wrap="Wrap">
								<BindableLayout.EmptyView>
									<Label
										FontSize="12"
										Text="Нема прикачени документи."
										TextColor="{StaticResource SparkTextSecondary}" />
								</BindableLayout.EmptyView>
								<BindableLayout.ItemTemplate>
									<DataTemplate x:DataType="entities:PatientDocument">
										<Border
											Margin="0,0,8,8"
											Padding="0"
											BackgroundColor="{StaticResource SparkTabActiveBg}"
											HeightRequest="110"
											Stroke="{StaticResource SparkBorderSubtle}"
											StrokeShape="RoundRectangle 12"
											StrokeThickness="1"
											WidthRequest="110">
											<Border.GestureRecognizers>
												<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
											</Border.GestureRecognizers>
											<Grid RowDefinitions="*,Auto" RowSpacing="0">
												<Grid Grid.Row="0" IsClippedToBounds="True">
													<Image
														Aspect="AspectFill"
														IsVisible="{Binding IsImageDocument}"
														Source="{Binding StoredPath}" />
													<Border
														BackgroundColor="{StaticResource SparkAccentTealBg}"
														IsVisible="{Binding IsImageDocument, Converter={StaticResource InverseBoolConverter}}"
														StrokeThickness="0">
														<VerticalStackLayout
															HorizontalOptions="Center"
															Spacing="4"
															VerticalOptions="Center">
															<Label
																FontFamily="FASolid"
																FontSize="24"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTeal}" />
															<Label
																FontSize="8"
																HorizontalOptions="Center"
																Text="{Binding DocumentType}"
																TextColor="{StaticResource SparkAccentTealDark}" />
														</VerticalStackLayout>
													</Border>
													<Border
														Margin="4"
														Padding="4,3"
														BackgroundColor="#99000000"
														HorizontalOptions="End"
														StrokeShape="RoundRectangle 6"
														StrokeThickness="0"
														VerticalOptions="Start">
														<Label
															FontFamily="FASolid"
															FontSize="9"
															Text="&#xf00e;"
															TextColor="{StaticResource SparkTextSecondary}" />
													</Border>
												</Grid>
												<Border
													Grid.Row="1"
													Padding="6,4"
													BackgroundColor="White"
													StrokeThickness="0">
													<VerticalStackLayout Spacing="1">
														<Label
															FontAttributes="Bold"
															FontSize="9"
															LineBreakMode="TailTruncation"
															Text="{Binding Title}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="8"
															Text="{Binding DocumentType}"
															TextColor="{StaticResource SparkTextSecondary}" />
													</VerticalStackLayout>
												</Border>
											</Grid>
										</Border>
									</DataTemplate>
								</BindableLayout.ItemTemplate>
							</FlexLayout>

						</VerticalStackLayout>
					</ScrollView>
				</controls:FFSectionCard>

			</Grid>
		</Grid>
	</Grid>
</ContentPage>
