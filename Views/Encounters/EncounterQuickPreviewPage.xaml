<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.Encounters.EncounterQuickPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EHMR.Resources.Controls"
    BackgroundColor="#EEF2F6">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid
            Grid.Row="0"
            Padding="24,14"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label
                    FontAttributes="Bold"
                    FontSize="11"
                    Text="PREVIEW"
                    TextColor="#64748B" />
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="Преглед на медицински извештај"
                    TextColor="#1E293B" />
            </VerticalStackLayout>
            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="8"
                VerticalOptions="Center">
                <controls:FFButton
                    ButtonKind="Primary"
                    BackgroundColorEx="#2AEBE7"
                    TextColorEx="#0F172A"
                    Clicked="OnPrintClicked"
                    ContentPadding="18,0"
                    HeightRequestEx="40"
                    Text="Печати"
                    WidthRequestEx="130" />
                <controls:FFButton
                    ButtonKind="Secondary"
                    BackgroundColorEx="#F1F5F9"
                    TextColorEx="#334155"
                    Clicked="OnBackClicked"
                    ContentPadding="18,0"
                    HeightRequestEx="40"
                    Text="Назад"
                    WidthRequestEx="130" />
            </HorizontalStackLayout>
        </Grid>

        <WebView
            x:Name="PrintWebView"
            Grid.Row="1"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsVisible="True"
            Opacity="1" />
    </Grid>
</ContentPage>
