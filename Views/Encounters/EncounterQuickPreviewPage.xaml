<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EHMR.Views.Encounters.EncounterQuickPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:entities="clr-namespace:EHMR.Domain.Entities"
    x:DataType="entities:Encounter"
    BackgroundColor="#EEF2F6">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0" Padding="24,14" BackgroundColor="White" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="2">
                <Label Text="PREVIEW" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                <Label Text="Преглед на медицински извештај" FontSize="20" FontAttributes="Bold" TextColor="#1E293B" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Назад" Clicked="OnBackClicked" Padding="18,0" HeightRequest="40"
                    BackgroundColor="#F1F5F9" TextColor="#334155" />
        </Grid>

        <ScrollView Grid.Row="1" Padding="24" VerticalScrollBarVisibility="Always">
            <Border BackgroundColor="White" Stroke="#DCE3EA" StrokeThickness="1" Padding="42" MaximumWidthRequest="1000"
                    HorizontalOptions="Center" Margin="0,0,0,24">
                <VerticalStackLayout Spacing="24">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="МЕДИЦИНСКА УСТАНОВА" FontSize="11" FontAttributes="Bold" TextColor="#64748B" />
                            <Label Text="КЛИНИЧКИ ИЗВЕШТАЈ ЗА ПРЕГЛЕД" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                            <Label Text="БРОЈ НА ПРЕГЛЕД" FontSize="10" TextColor="#64748B" />
                            <Label Text="{Binding EncounterNumber}" FontSize="14" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="12" TextColor="#475569" />
                        </VerticalStackLayout>
                        <BoxView Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="2" BackgroundColor="#64748B" Margin="0,16,0,0" />
                    </Grid>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="ПОДАТОЦИ ЗА ПАЦИЕНТОТ" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Име и презиме" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Patient.FullName, TargetNullValue='—'}" FontSize="14" FontAttributes="Bold" TextColor="#1E293B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="ЕМБГ" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Patient.NationalId, TargetNullValue='—'}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="3">
                                <Label Text="СЗБО број" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Patient.SzboNumber, TargetNullValue='—'}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="3">
                                <Label Text="Датум на раѓање" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="3">
                                <Label Text="Телефон" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Patient.Phone, TargetNullValue='—'}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="3">
                                <Label Text="Адреса" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Patient.Address, TargetNullValue='—'}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="ПОДАТОЦИ ЗА ПРЕГЛЕДОТ" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="Реуматолог" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Doctor.User.FirstName, TargetNullValue=''}" FontSize="14" TextColor="#1E293B" />
                                <Label Text="{Binding Doctor.User.LastName, TargetNullValue='—'}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Статус" FontSize="10" TextColor="#64748B" />
                                <Label Text="{Binding Status}" FontSize="14" TextColor="#1E293B" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Главна поплака" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Label Text="{Binding ChiefComplaint, TargetNullValue='Нема внесена главна поплака.'}" FontSize="13" TextColor="#1E293B" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Анамнеза на сегашната состојба" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Label Text="{Binding HistoryOfPresentIllness, TargetNullValue='Нема внесена анамнеза.'}" FontSize="13" TextColor="#1E293B" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Процена / дијагностички заклучок" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Label Text="{Binding Assessment, TargetNullValue='Нема внесена процена.'}" FontSize="13" TextColor="#1E293B" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="План и препораки" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Label Text="{Binding Plan, TargetNullValue='Нема внесен план.'}" FontSize="13" TextColor="#1E293B" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Клинички забелешки" FontSize="12" FontAttributes="Bold" TextColor="#334155" />
                        <Label Text="{Binding ClinicalNotes, TargetNullValue='Нема внесени клинички забелешки.'}" FontSize="13" TextColor="#1E293B" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" Margin="0,30,0,0" ColumnSpacing="40">
                        <VerticalStackLayout Spacing="28">
                            <BoxView HeightRequest="1" BackgroundColor="#94A3B8" />
                            <Label Text="Потпис на лекар" FontSize="11" TextColor="#64748B" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="28">
                            <BoxView HeightRequest="1" BackgroundColor="#94A3B8" />
                            <Label Text="Печат на установа" FontSize="11" TextColor="#64748B" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>