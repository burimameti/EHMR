<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterQuickPreviewPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	BackgroundColor="#EEF2F6">

	<Grid RowDefinitions="Auto,*" RowSpacing="0">
		<Grid
			Grid.Row="0"
			Padding="24,14"
			BackgroundColor="White"
			ColumnDefinitions="*,Auto">
			<VerticalStackLayout Spacing="2">
				<Label
					FontAttributes="Bold"
					FontSize="11"
					Text="PREVIEW"
					TextColor="#64748B" />
				<Label
					FontAttributes="Bold"
					FontSize="20"
					Text="Преглед на медицински извештај"
					TextColor="#1E293B" />
			</VerticalStackLayout>
			<HorizontalStackLayout
				Grid.Column="1"
				Spacing="8"
				VerticalOptions="Center">
				<Button
					Padding="18,0"
					BackgroundColor="#2AEBE7"
					Clicked="OnPrintClicked"
					FontAttributes="Bold"
					HeightRequest="36"
					Text="Печати"
					TextColor="#0F172A" />
				<Button
					Padding="18,0"
					BackgroundColor="#F1F5F9"
					Clicked="OnBackClicked"
					HeightRequest="36"
					Text="Назад"
					TextColor="#334155" />
			</HorizontalStackLayout>
		</Grid>

		<WebView
			x:Name="PrintWebView"
			Grid.Row="1"
			BackgroundColor="White"
			HorizontalOptions="Fill"
			VerticalOptions="Fill" />
	</Grid>
</ContentPage>
