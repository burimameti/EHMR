<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterQuickPreviewPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	x:DataType="entities:Encounter"
	BackgroundColor="#EEF2F6">

	<Grid RowDefinitions="Auto,*" RowSpacing="0">
		<WebView
			x:Name="PrintWebView"
			Grid.Row="1"
			HeightRequest="1"
			HorizontalOptions="Start"
			InputTransparent="True"
			Opacity="0.01"
			VerticalOptions="Start"
			WidthRequest="1" />

		<Grid
			Grid.Row="0"
			Padding="24,14"
			BackgroundColor="White"
			ColumnDefinitions="*,Auto">
			<VerticalStackLayout Spacing="2">
				<Label
					FontAttributes="Bold"
					FontSize="11"
					Text="PREVIEW"
					TextColor="#64748B" />
				<Label
					FontAttributes="Bold"
					FontSize="20"
					Text="Преглед на медицински извештај"
					TextColor="#1E293B" />
			</VerticalStackLayout>
			<HorizontalStackLayout
				Grid.Column="1"
				Spacing="8"
				VerticalOptions="Center">
				<Button
					Padding="18,0"
					BackgroundColor="#2AEBE7"
					Clicked="OnPrintClicked"
					FontAttributes="Bold"
					HeightRequest="36"
					Text="Печати"
					TextColor="#0F172A" />
				<Button
					Padding="18,0"
					BackgroundColor="#F1F5F9"
					Clicked="OnBackClicked"
					HeightRequest="36"
					Text="Назад"
					TextColor="#334155" />
			</HorizontalStackLayout>
		</Grid>

		<ScrollView
			Grid.Row="1"
			Padding="24"
			VerticalScrollBarVisibility="Always">
			<Border
				Margin="0,0,0,24"
				Padding="42"
				BackgroundColor="White"
				HorizontalOptions="Center"
				MaximumWidthRequest="1000"
				Stroke="#DCE3EA"
				StrokeThickness="1">
				<VerticalStackLayout Spacing="10">
					<!--  Report header  -->
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
						<VerticalStackLayout Spacing="3">
							<Label
								FontAttributes="Bold"
								FontSize="12"
								Text="EHMR"
								TextColor="#64748B" />
							<Label
								FontAttributes="Bold"
								FontSize="20"
								Text="Извештај за преглед"
								TextColor="#111827" />
						</VerticalStackLayout>
						<VerticalStackLayout
							Grid.Column="1"
							HorizontalOptions="End"
							Spacing="4">
							<Label
								FontSize="12"
								Text="{Binding EncounterNumber, StringFormat='Број: {0}'}"
								TextColor="#111827" />
							<Label
								FontSize="12"
								Text="{Binding EncounterDate, StringFormat='Датум: {0:dd.MM.yyyy}'}"
								TextColor="#111827" />
						</VerticalStackLayout>
					</Grid>
					<BoxView BackgroundColor="#111827" HeightRequest="1" />

					<!--  Patient information  -->
					<VerticalStackLayout Spacing="4">
						<Label
							FontAttributes="Bold"
							FontSize="13"
							Text="ОСНОВНИ ПОДАТОЦИ"
							TextColor="#111827" />
						<BoxView BackgroundColor="#111827" HeightRequest="1" />
						<Grid
							ColumnDefinitions="*,*"
							ColumnSpacing="24"
							RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
							<Grid
								Grid.Row="0"
								Grid.Column="0"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Пациент"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.FullName, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="0"
								Grid.Column="1"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="СЗБО"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.SzboNumber, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="1"
								Grid.Column="0"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="ЕМБГ"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.NationalId, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="1"
								Grid.Column="1"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Датум на раѓање"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.BirthDate, StringFormat='{0:dd.MM.yyyy}'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="2"
								Grid.Column="0"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Пол"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.Gender, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="2"
								Grid.Column="1"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Телефон"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.Phone, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="3"
								Grid.Column="0"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Адреса"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.Address, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="3"
								Grid.Column="1"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Град"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.City, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="4"
								Grid.Column="0"
								Grid.ColumnSpan="2"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Реуматолог"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Doctor.FullName, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="5"
								Grid.Column="0"
								Grid.ColumnSpan="2"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Поштенски број"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Patient.PostalCode, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
						</Grid>
					</VerticalStackLayout>

					<!--  Encounter details  -->
					<VerticalStackLayout Spacing="4">
						<Label
							FontAttributes="Bold"
							FontSize="13"
							Text="ПОДАТОЦИ ЗА ПРЕГЛЕДОТ"
							TextColor="#111827" />
						<BoxView BackgroundColor="#111827" HeightRequest="1" />
						<Grid
							ColumnDefinitions="*,*"
							ColumnSpacing="24"
							RowDefinitions="Auto,Auto,Auto">
							<Grid
								Grid.Row="0"
								Grid.Column="0"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Број на преглед"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding EncounterNumber, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="0"
								Grid.Column="1"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Статус"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding Status, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="1"
								Grid.Column="0"
								Grid.ColumnSpan="2"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Причина за посета"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding ReasonForVisit, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
							<Grid
								Grid.Row="2"
								Grid.Column="0"
								Grid.ColumnSpan="2"
								Padding="0,3"
								ColumnDefinitions="120,*">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="Главна тегоба"
									TextColor="#111827" />
								<Label
									Grid.Column="1"
									FontSize="12"
									Text="{Binding ChiefComplaint, TargetNullValue='—'}"
									TextColor="#111827" />
							</Grid>
						</Grid>
					</VerticalStackLayout>

					<VerticalStackLayout Spacing="4">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="АНАМНЕЗА"
							TextColor="#111827" />
						<BoxView BackgroundColor="#E5E7EB" HeightRequest="1" />
						<Label
							FontSize="12"
							Text="{Binding HistoryOfPresentIllness, TargetNullValue='—'}"
							TextColor="#111827" />
					</VerticalStackLayout>
					<VerticalStackLayout Spacing="4">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="ПРОЦЕНКА"
							TextColor="#111827" />
						<BoxView BackgroundColor="#E5E7EB" HeightRequest="1" />
						<Label
							FontSize="12"
							Text="{Binding Assessment, TargetNullValue='—'}"
							TextColor="#111827" />
					</VerticalStackLayout>
					<VerticalStackLayout Spacing="4">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="ПЛАН И ПРЕПОРАКИ"
							TextColor="#111827" />
						<BoxView BackgroundColor="#E5E7EB" HeightRequest="1" />
						<Label
							FontSize="12"
							Text="{Binding Plan, TargetNullValue='—'}"
							TextColor="#111827" />
					</VerticalStackLayout>
					<VerticalStackLayout Spacing="4">
						<Label
							FontAttributes="Bold"
							FontSize="12"
							Text="ЗАБЕЛЕШКА"
							TextColor="#111827" />
						<BoxView BackgroundColor="#E5E7EB" HeightRequest="1" />
						<Label
							FontSize="12"
							Text="{Binding Notes, TargetNullValue='—'}"
							TextColor="#111827" />
					</VerticalStackLayout>

					<!--  Signature lines  -->
					<Grid
						Margin="0,30,0,0"
						ColumnDefinitions="*,*"
						ColumnSpacing="40">
						<VerticalStackLayout Spacing="6">
							<BoxView BackgroundColor="#64748B" HeightRequest="1" />
							<Label
								FontSize="11"
								HorizontalTextAlignment="Center"
								Text="Потпис на лекар"
								TextColor="#475569" />
						</VerticalStackLayout>
						<VerticalStackLayout Grid.Column="1" Spacing="6">
							<BoxView BackgroundColor="#64748B" HeightRequest="1" />
							<Label
								FontSize="11"
								HorizontalTextAlignment="Center"
								Text="Печат на установа"
								TextColor="#475569" />
						</VerticalStackLayout>
					</Grid>
				</VerticalStackLayout>
			</Border>
		</ScrollView>
	</Grid>
</ContentPage>