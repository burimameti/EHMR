										</Grid>
									</Border>-->
								</VerticalStackLayout>
							</Border>

							<Border Margin="0,0,0,10" Style="{StaticResource CrudFormSectionCardStyle}">
								<VerticalStackLayout Spacing="6">
									<controls:CrudSectionHeader
										Title="КОНТАКТ ИНФОРМАЦИИ"
