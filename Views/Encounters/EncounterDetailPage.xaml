											<Label FontSize="10" Text="{Binding ApplicationRegime.Regime, StringFormat='Режим: {0}', TargetNullValue=''}" TextColor="{StaticResource SparkTextSecondary}" />-->
																</VerticalStackLayout>
															</Grid>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</VerticalStackLayout>
											</VerticalStackLayout>
										</Border>
										<Border
											Grid.Column="2"
											Style="{StaticResource CrudFormTableFrameStyle}"
											VerticalOptions="Start">
											<VerticalStackLayout Spacing="0">
												<Grid ColumnDefinitions="*,Auto" Style="{StaticResource CrudFormTableHeaderGridStyle}">
													<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="СКОР / ОПИС" />
													<Label
