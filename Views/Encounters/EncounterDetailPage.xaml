														VerticalOptions="Center" />
												</Grid>
											</VerticalStackLayout>
										</Border>
									</Grid>
								</VerticalStackLayout>


							</Border>
							<Border Style="{StaticResource CrudFormSectionCardStyle}">
								<!--  ЛЕКОВИ: компактна табела во половина ред  -->
								<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
									<VerticalStackLayout Grid.Column="0" Spacing="10">
										<controls:CrudSectionHeader
											Title="Лекови / Терапија за прегледот"
											LineColor="{StaticResource Gray600}"
											Style="{StaticResource CrudFormSectionHeaderStyle}" />
										<Border Style="{StaticResource CrudFormTableFrameStyle}" VerticalOptions="Start">
											<VerticalStackLayout Spacing="0">
												<Grid
													ColumnDefinitions="1.3*,1.1*,0.9*,0.6*"
													ColumnSpacing="0"
													Style="{StaticResource CrudFormTableHeaderGridStyle}">
													<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="ЛЕК" />
													<Label
														Grid.Column="1"
														Style="{StaticResource CrudFormTableHeaderLabelStyle}"
														Text="РЕЖИМ" />
													<Label
														Grid.Column="2"
														Style="{StaticResource CrudFormTableHeaderLabelStyle}"
														Text="ДОЗА" />
													<Label
														Grid.Column="3"
														Style="{StaticResource CrudFormTableHeaderLabelStyle}"
														Text="КОЛ." />
													<BoxView
														Grid.Column="1"
														HorizontalOptions="Start"
														WidthRequest="1"
														Color="{StaticResource SparkBorderSubtle}" />
													<BoxView
														Grid.Column="2"
														HorizontalOptions="Start"
														WidthRequest="1"
														Color="{StaticResource SparkBorderSubtle}" />
													<BoxView
														Grid.Column="3"
														HorizontalOptions="Start"
														WidthRequest="1"
														Color="{StaticResource SparkBorderSubtle}" />
												</Grid>
												<VerticalStackLayout
													BindableLayout.EmptyView="Нема активни лекови."
													BindableLayout.ItemsSource="{Binding CurrentPatientMedicines}"
													Spacing="0">
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="entities:PatientMedicine">
															<Grid RowDefinitions="Auto,1">
																<Grid
																	Padding="10,6"
																	ColumnDefinitions="1.3*,1.1*,0.9*,0.6*"
																	ColumnSpacing="0">
																	<Label Style="{StaticResource CrudFormTableCellLabelStyle}" Text="{Binding Medicine.BilingualName, TargetNullValue='—'}" />
																	<Label
																		Grid.Column="1"
																		Margin="5"
																		Style="{StaticResource CrudFormTableCellLabelStyle}"
																		Text="{Binding ApplicationRegime.Regime, TargetNullValue='—'}" />
																	<Label
																		Grid.Column="2"
																		Margin="5"
																		Style="{StaticResource CrudFormTableCellLabelStyle}"
																		Text="{Binding Dosage, TargetNullValue='—'}" />
																	<Label
																		Grid.Column="3"
																		Margin="5"
																		Style="{StaticResource CrudFormTableCellLabelStyle}"
																		Text="{Binding Quantity, TargetNullValue='—'}" />
																	<BoxView
																		Grid.Column="1"
																		HorizontalOptions="Start"
																		WidthRequest="1"
																		Color="{StaticResource SparkBorderSubtle}" />
																	<BoxView
																		Grid.Column="2"
																		HorizontalOptions="Start"
																		WidthRequest="1"
																		Color="{StaticResource SparkBorderSubtle}" />
																	<BoxView
																		Grid.Column="3"
																		HorizontalOptions="Start"
																		WidthRequest="1"
																		Color="{StaticResource SparkBorderSubtle}" />
																</Grid>
																<BoxView
																	Grid.Row="1"
																	HeightRequest="1"
																	Color="{StaticResource SparkBorderSubtle}" />
															</Grid>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</VerticalStackLayout>
											</VerticalStackLayout>
										</Border>
									</VerticalStackLayout>
									<VerticalStackLayout Grid.Column="1" />
								</Grid>

							</Border>
							<Border Style="{StaticResource CrudFormSectionCardStyle}">
								<!--  ДОКУМЕНТИ  -->
								<VerticalStackLayout Spacing="10">
									<controls:CrudSectionHeader
										Title="ДОКУМЕНТИ"
										LineColor="{StaticResource Gray600}"
										Style="{StaticResource CrudFormSectionHeaderStyle}" />
									<FlexLayout
										BindableLayout.ItemsSource="{Binding PatientDocuments}"
										Direction="Row"
										JustifyContent="Start"
										Wrap="Wrap">
										<BindableLayout.EmptyView>
											<Label
												FontSize="12"
												Text="Нема прикачени документи."
												TextColor="{StaticResource SparkTextSecondary}" />
										</BindableLayout.EmptyView>
										<BindableLayout.ItemTemplate>
											<DataTemplate x:DataType="entities:PatientDocument">
												<Border
													Margin="0,0,8,8"
													Style="{StaticResource CrudFormDocumentCardStyle}"
													WidthRequest="180">
													<Border.GestureRecognizers>
														<TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.PreviewDocumentCommand}" CommandParameter="{Binding .}" />
													</Border.GestureRecognizers>
													<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
														<Border
															BackgroundColor="{StaticResource SparkAccentTealBg}"
															HeightRequest="34"
															StrokeShape="RoundRectangle 8"
															StrokeThickness="0"
															WidthRequest="34">
															<Label
																FontFamily="FASolid"
																FontSize="13"
																HorizontalOptions="Center"
																Text="&#xf15b;"
																TextColor="{StaticResource SparkAccentTealDark}"
																VerticalOptions="Center" />
														</Border>
														<VerticalStackLayout
															Grid.Column="1"
															Spacing="2"
															VerticalOptions="Center">
															<Label
																FontAttributes="Bold"
																FontSize="11"
																LineBreakMode="TailTruncation"
																Text="{Binding Title, TargetNullValue='Документ'}"
																TextColor="{StaticResource SparkTextPrimary}" />
															<Label
																FontSize="9.5"
																Text="{Binding DocumentType, TargetNullValue='Документ'}"
																TextColor="{StaticResource SparkTextSecondary}" />
														</VerticalStackLayout>
													</Grid>
												</Border>
											</DataTemplate>
										</BindableLayout.ItemTemplate>
									</FlexLayout>
								</VerticalStackLayout>
							</Border>
						</VerticalStackLayout>

					</ScrollView>
				</controls:FFSectionCard>
			</Border>

			<!--<Border
				Grid.Row="2"
				Margin="16,10,16,16"
				Padding="16,10"
				BackgroundColor="White"
				Stroke="{StaticResource SparkBorderSubtle}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<Grid ColumnDefinitions="*" ColumnSpacing="10">
					<Label
						FontSize="10.5"
						TextColor="{StaticResource SparkTextSecondary}"
						VerticalOptions="Center" />
				</Grid>
			</Border>-->
		</Grid>
	</Grid>
</ContentPage>
