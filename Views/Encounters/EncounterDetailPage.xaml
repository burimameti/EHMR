<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterDetailPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="viewModels:EncounterDetailViewModel"
	BackgroundColor="{StaticResource SparkBorder}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<!--  Конвертори за статус  -->
			<converters:EncounterStatusToTextConverter x:Key="StatusTextConverter" />
			<converters:EncounterStatusToColorConverter x:Key="StatusColorConverter" />
			<converters:EncounterStatusToBgConverter x:Key="StatusBgConverter" />

			<!--  Шаблон за Прегледи  -->
			<DataTemplate x:Key="EncounterRowTemplate" x:DataType="entities:Encounter">
				<Grid
					Padding="8,6"
					ColumnDefinitions="Auto,*,Auto"
					ColumnSpacing="10">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding EncounterDate, StringFormat='{0:dd.MM.yyyy}'}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding ReasonForVisit}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
					<Border
						Grid.Column="2"
						Padding="6,2"
						BackgroundColor="{Binding Status, Converter={StaticResource StatusBgConverter}}"
						StrokeShape="RoundRectangle 4"
						StrokeThickness="0"
						VerticalOptions="Center">
						<Label
							FontAttributes="Bold"
							FontSize="10"
							Text="{Binding Status, Converter={StaticResource StatusTextConverter}}"
							TextColor="{Binding Status, Converter={StaticResource StatusColorConverter}}" />
					</Border>
				</Grid>
			</DataTemplate>

			<!--  Шаблон за Термини  -->
			<DataTemplate x:Key="AppointmentRowTemplate" x:DataType="entities:Appointment">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding ReasonForVisit}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<!--  Шаблон за Терапевтски Циклуси  -->
			<DataTemplate x:Key="TherapyCycleRowTemplate" x:DataType="entities:TherapyCycle">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<!--  Шаблон за Рецепти  -->
			<DataTemplate x:Key="PrescriptionRowTemplate" x:DataType="entities:Prescription">
				<Grid Padding="8,6" ColumnDefinitions="Auto,*">
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="{Binding Status}"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
					<Label
						Grid.Column="1"
						Margin="10,0,0,0"
						FontSize="12"
						LineBreakMode="TailTruncation"
						Text="{Binding Notes}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Grid>
			</DataTemplate>

			<!--  Шаблон за Лекови на пациент  -->
			<DataTemplate x:Key="PatientMedicineRowTemplate" x:DataType="entities:PatientMedicine">
				<Grid
					Padding="10,8"
					ColumnDefinitions="*,Auto"
					RowDefinitions="Auto,Auto"
					RowSpacing="6">
					<HorizontalStackLayout Grid.Row="0" Spacing="8">
						<Label
							FontAttributes="Bold"
							FontSize="13"
							Text="{Binding Medicine.Name, FallbackValue='—'}"
							TextColor="{StaticResource SparkAccentTealDark}"
							VerticalOptions="Center" />
						<Border
							Padding="6,2"
							BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToActiveBadgeColorConverter}}"
							StrokeShape="RoundRectangle 8"
							StrokeThickness="0"
							VerticalOptions="Center">
							<Label
								FontAttributes="Bold"
								FontSize="9"
								Text="{Binding IsActive, Converter={StaticResource BoolToActiveLabelConverter}}"
								TextColor="{StaticResource SparkBackground}" />
						</Border>
					</HorizontalStackLayout>

					<Label
						Grid.Row="0"
						Grid.Column="1"
						FontSize="11"
						Text="{Binding StartDate, StringFormat='{0:dd.MM.yyyy}'}"
						TextColor="{StaticResource SparkTextSecondary}"
						VerticalOptions="Center" />

					<HorizontalStackLayout
						Grid.Row="1"
						Grid.ColumnSpan="2"
						Spacing="6">
						<Label
							FontSize="12"
							Text="{Binding Dosage, StringFormat='Количина: {0}'}"
							TextColor="{StaticResource SparkTextPrimary}" />
						<Label
							FontSize="12"
							Text="•"
							TextColor="{StaticResource SparkTextSecondary}" />
						<Label
							FontSize="12"
							Text="{Binding DosesFrequency}"
							TextColor="{StaticResource SparkTextSecondary}" />
					</HorizontalStackLayout>
				</Grid>
			</DataTemplate>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid ColumnDefinitions="285,*">
		<!--  ЛЕВО МЕНИ  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  ДЕСЕН ГЛАВЕН КОНТЕЈНЕР  -->
		<Grid
			Grid.Column="1"
			Padding="0"
			RowDefinitions="Auto,*">

			<!--  HEADER PANEL  -->
			<Border Style="{StaticResource PageHeaderCardStyle}">
				<Grid ColumnDefinitions="Auto,*,Auto">
					<!--<Border Style="{StaticResource AvatarCircleStyle}">
						<Label
							FontSize="18"
							Style="{StaticResource AvatarGlyphStyle}"
							Text="&#xf0f1;" />
					</Border>-->
					<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
						<Label Style="{StaticResource PageTitleStyle}" Text="{Binding PageTitle}" />

					</VerticalStackLayout>
					<HorizontalStackLayout
						Grid.Column="2"
						Spacing="10"
						VerticalOptions="Center">
						<controls:FFButton
							ButtonKind="Secondary"
							Command="{Binding CancelCommand}"
							ContentPadding="20,0"
							HeightRequestEx="40"
							Text="Назад" />
					</HorizontalStackLayout>
				</Grid>
			</Border>

			<!--  MAIN PANEL  -->
			<Grid Grid.Row="1" ColumnDefinitions="2*,1*">

				<!--  ЛЕВА КОЛОНА — ДЕТАЛИ ЗА ЕНТИТЕТОТ  -->
				<Border Style="{StaticResource PageHeaderCardStyle}">
					<ScrollView VerticalScrollBarVisibility="Never">
						<VerticalStackLayout Padding="16" Spacing="12">

							<!--  СЕКЦИЈА 1: ИДЕНТИФИКАЦИЈА И СТАТУС  -->
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ОПШТИ ПОДАТОЦИ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									RowDefinitions="Auto,Auto"
									RowSpacing="12">
									<Grid
										Grid.Row="0"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Број на преглед:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											FontAttributes="Bold"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.EncounterNumber}" />
									</Grid>

									<Grid
										Grid.Row="1"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Тип на преглед:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding EncounterTypeDisplay, TargetNullValue='—'}" />
										<!--  Врзано со преведената вредност  -->
									</Grid>
									<Grid
										Grid.Row="1"
										Grid.Column="1"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Приоритет:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding PriorityDisplay, TargetNullValue='—'}" />
									</Grid>
								</Grid>
							</VerticalStackLayout>
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ПАЦИЕНТ И ЛЕКАР"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<Grid ColumnDefinitions="*,*" ColumnSpacing="20">
									<Border
										Padding="16,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="38"
												StrokeShape="RoundRectangle 19"
												StrokeThickness="0"
												WidthRequest="38">
												<Label
													FontFamily="FASolid"
													FontSize="14"
													HorizontalOptions="Center"
													Text="&#xf007;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="11"
													Text="Пациент"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="16"
													LineBreakMode="WordWrap"
													Text="{Binding SelectedPatient.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
									<Border
										Grid.Column="1"
										Padding="16,12"
										BackgroundColor="{StaticResource SparkTabActiveBg}"
										StrokeShape="RoundRectangle 10"
										StrokeThickness="0">
										<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
											<Border
												BackgroundColor="{StaticResource SparkAccentTealBg}"
												HeightRequest="38"
												StrokeShape="RoundRectangle 19"
												StrokeThickness="0"
												WidthRequest="38">
												<Label
													FontFamily="FASolid"
													FontSize="14"
													HorizontalOptions="Center"
													Text="&#xf0f0;"
													TextColor="{StaticResource SparkAccentTealDark}"
													VerticalOptions="Center" />
											</Border>
											<VerticalStackLayout
												Grid.Column="1"
												Spacing="1"
												VerticalOptions="Center">
												<Label
													FontSize="11"
													Text="Матичен Реуматолог"
													TextColor="{StaticResource SparkTextSecondary}" />
												<Label
													FontAttributes="Bold"
													FontSize="16"
													LineBreakMode="WordWrap"
													Text="{Binding SelectedDoctor.FullName, FallbackValue='—'}"
													TextColor="{StaticResource SparkTextPrimary}" />
											</VerticalStackLayout>
										</Grid>
									</Border>
								</Grid>
							</VerticalStackLayout>

							<!--  СЕКЦИЈА 2: ПАЦИЕНТ И ЛЕКАР  -->

							<!--  СЕКЦИЈА 3: КЛИНИЧКИ НАОДИ И БЕЛЕШКИ  -->
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="КЛИНИЧКИ НАОДИ И БЕЛЕШКИ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<VerticalStackLayout Spacing="12">
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Главна поплака:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.ChiefComplaint, TargetNullValue='—'}" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Причина за посета:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.ReasonForVisit, TargetNullValue='—'}" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Историја на сегашна болест:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.HistoryOfPresentIllness, TargetNullValue='—'}" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Клиничка процена:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.Assessment, TargetNullValue='—'}" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="План за лекување:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.Plan, TargetNullValue='—'}" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Општи белешки:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.Notes, TargetNullValue='—'}" />
									</Grid>
									<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Клинички белешки:"
											WidthRequest="170" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.ClinicalNotes, TargetNullValue='—'}" />
									</Grid>
								</VerticalStackLayout>
							</VerticalStackLayout>

							<!--  СЕКЦИЈА 4: МКБ-10 ДИЈАГНОСТИКА  -->
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="МКБ-10 ДИЈАГНОСТИКА"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>

								<!--  Листа на чипови (се прикажува ако има елементи)  -->
								<FlexLayout
									BindableLayout.ItemsSource="{Binding Diagnoses}"
									Direction="Row"
									JustifyContent="Start"
									Wrap="Wrap">
									<BindableLayout.ItemTemplate>
										<DataTemplate x:DataType="entities:Diagnosis">
											<Border
												Margin="0,0,6,6"
												Padding="12,0"
												HeightRequest="36"
												Style="{StaticResource TokenChipBorderStyle}">
												<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
													<Label
														FontAttributes="Bold"
														FontFamily="Consolas"
														FontSize="12"
														Text="{Binding Mkb10Code.Code}"
														TextColor="{StaticResource SparkAccentTealDark}"
														VerticalOptions="Center" />
													<Label
														FontSize="12"
														Text="{Binding Mkb10Code.Description}"
														TextColor="{StaticResource SparkTextPrimary}"
														VerticalOptions="Center" />
												</HorizontalStackLayout>
											</Border>
										</DataTemplate>
									</BindableLayout.ItemTemplate>
								</FlexLayout>

								<!--  Порака кога нема дијагнози - БЕЗ КОНВЕРТОР (Го решава ObjectReference крашот)  -->
								<Label
									FontSize="13"
									IsVisible="False"
									Text="Нема доделени дијагнози за овој преглед."
									TextColor="{StaticResource SparkTextSecondary}">
									<!--  Секогаш скриено по дефолт  -->
									<Label.Triggers>
										<DataTrigger
											Binding="{Binding Diagnoses.Count}"
											TargetType="Label"
											Value="0">
											<Setter Property="IsVisible" Value="True" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
							</VerticalStackLayout>
							<!--  СЕКЦИЈА 5: ВРЕМЕНСКА ЛИНЈА И ВРЕМЕТРАЕЊЕ  -->
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ВРЕМЕНСКА ЛИНЈА НА ПОСЕТА"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									RowDefinitions="Auto,Auto,Auto"
									RowSpacing="12">
									<Grid
										Grid.Row="0"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Закажан почеток:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}', TargetNullValue='—'}" />
									</Grid>
									<Grid
										Grid.Row="0"
										Grid.Column="1"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Закажан крај:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.ScheduledEnd, StringFormat='{0:dd.MM.yyyy HH:mm}', TargetNullValue='—'}" />
									</Grid>
									<Grid
										Grid.Row="1"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Време на пријава:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.CheckInTime, StringFormat='{0:HH:mm}', TargetNullValue='—'}" />
									</Grid>
									<Grid
										Grid.Row="1"
										Grid.Column="1"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Време на почеток:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.StartTime, StringFormat='{0:HH:mm}', TargetNullValue='—'}" />
									</Grid>
									<Grid
										Grid.Row="2"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Време на одјава:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.CheckOutTime, StringFormat='{0:HH:mm}', TargetNullValue='—'}" />
									</Grid>
									<Grid
										Grid.Row="2"
										Grid.Column="1"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Времетраење:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.DurationMinutes, StringFormat='{0} минути', TargetNullValue='—'}" />
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  СЕКЦИЈА 6: АДМИНИСТРАТИВНО И АУДИТ  -->
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="АДМИНИСТРАЦИЈА И СИСТЕМСКИ ПОДАТОЦИ"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<Grid
									ColumnDefinitions="*,*"
									ColumnSpacing="24"
									RowDefinitions="Auto,Auto,Auto"
									RowSpacing="12">
									<Grid
										Grid.Row="0"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Извор на посета:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.VisitSource, TargetNullValue='Директно'}" />
									</Grid>

									<Grid
										Grid.Row="1"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Заклучен запис:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.IsLocked, Converter={StaticResource BoolToActiveLabelConverter}, FallbackValue='Не'}" />
									</Grid>
									<Grid
										Grid.Row="1"
										Grid.Column="1"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Активен во систем:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.IsActive, Converter={StaticResource BoolToActiveLabelConverter}, FallbackValue='Да'}" />
									</Grid>
									<Grid
										Grid.Row="2"
										Grid.Column="0"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Креирано на:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.CreatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}'}" />
									</Grid>
									<Grid
										Grid.Row="2"
										Grid.Column="1"
										ColumnDefinitions="Auto,*"
										ColumnSpacing="12">
										<Label
											Style="{StaticResource ReadRowLabelStyle}"
											Text="Последна измена:"
											WidthRequest="130" />
										<Label
											Grid.Column="1"
											LineBreakMode="WordWrap"
											Style="{StaticResource ReadRowValueStyle}"
											Text="{Binding Encounter.UpdatedAt, StringFormat='{0:dd.MM.yyyy HH:mm}', TargetNullValue='Нема измени'}" />
									</Grid>
								</Grid>
							</VerticalStackLayout>

							<!--  СЕКЦИЈА 7: ТЕКОВЕН СТАТУС НА ПРЕГЛЕДОТ  -->
							<VerticalStackLayout Spacing="16">
								<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
									<Label
										Style="{StaticResource SectionPillLabelStyle}"
										Text="ТЕКОВЕН СТАТУС"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</Border>
								<Border
									Padding="14,0"
									BackgroundColor="{Binding Encounter.Status, Converter={StaticResource StatusBgConverter}}"
									HeightRequest="34"
									HorizontalOptions="Start"
									StrokeShape="RoundRectangle 16"
									StrokeThickness="0">
									<HorizontalStackLayout Spacing="8" VerticalOptions="Center">
										<BoxView
											CornerRadius="4"
											HeightRequest="8"
											VerticalOptions="Center"
											WidthRequest="8"
											Color="{Binding Encounter.Status, Converter={StaticResource StatusColorConverter}}" />
										<Label
											FontAttributes="Bold"
											FontSize="13"
											Text="{Binding Encounter.Status, Converter={StaticResource StatusTextConverter}}"
											TextColor="{Binding Encounter.Status, Converter={StaticResource StatusColorConverter}}"
											VerticalOptions="Center" />
									</HorizontalStackLayout>
								</Border>
							</VerticalStackLayout>

						</VerticalStackLayout>
					</ScrollView>
				</Border>

				<!--  ДЕСНА КОЛОНА — КОНТЕКСТ + ИСТОРИСКИ КАРТИЧКИ  -->
				<Grid Grid.Column="1" RowDefinitions="Auto,*">
					<!--  Контекст Картичка  -->
					<Border Style="{StaticResource PageHeaderCardStyle}">
						<Grid
							Padding="16,14"
							RowDefinitions="Auto,Auto,Auto"
							RowSpacing="12"
							VerticalOptions="Center">
							<Border BackgroundColor="{StaticResource SparkTabActiveBg}" Style="{StaticResource SectionPillBorderStyle}">
								<Label
									Style="{StaticResource SectionPillLabelStyle}"
									Text="ПОДАТОЦИ ЗА ПАЦИЕНТОТ"
									TextColor="{StaticResource SparkAccentTealDark}" />
							</Border>
							<HorizontalStackLayout
								Grid.Row="1"
								Padding="4,2"
								Spacing="10"
								VerticalOptions="Center">
								<Border
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									HeightRequest="38"
									StrokeShape="RoundRectangle 19"
									StrokeThickness="0"
									WidthRequest="38">
									<Label
										FontFamily="FASolid"
										FontSize="14"
										HorizontalOptions="Center"
										Text="&#xf007;"
										TextColor="{StaticResource SparkAccentTealDark}"
										VerticalOptions="Center" />
								</Border>
								<VerticalStackLayout Spacing="1" VerticalOptions="Center">
									<Label
										FontSize="10"
										Text="Пациент"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="14"
										LineBreakMode="TailTruncation"
										Text="{Binding SelectedPatient.FullName, TargetNullValue='Нема пациент'}"
										TextColor="{StaticResource SparkTextPrimary}" />
								</VerticalStackLayout>
							</HorizontalStackLayout>
							<HorizontalStackLayout
								Grid.Row="2"
								Padding="4,2"
								IsVisible="{Binding SelectedDoctor}"
								Spacing="10"
								VerticalOptions="Center">
								<Border
									BackgroundColor="{StaticResource SparkAccentTealBg}"
									HeightRequest="38"
									StrokeShape="RoundRectangle 19"
									StrokeThickness="0"
									WidthRequest="38">
									<Label
										FontFamily="FASolid"
										FontSize="14"
										HorizontalOptions="Center"
										Text="&#xf0f0;"
										TextColor="{StaticResource SparkAccentTealDark}"
										VerticalOptions="Center" />
								</Border>
								<VerticalStackLayout Spacing="1" VerticalOptions="Center">
									<Label
										FontSize="10"
										Text="Матичен реуматолог"
										TextColor="{StaticResource SparkTextSecondary}" />
									<Label
										FontAttributes="Bold"
										FontSize="14"
										LineBreakMode="TailTruncation"
										Text="{Binding SelectedDoctor.FullName}"
										TextColor="{StaticResource SparkAccentTealDark}" />
								</VerticalStackLayout>
							</HorizontalStackLayout>
						</Grid>
					</Border>

					<!--  Експандабилни историски картички  -->
					<Border
						Grid.Row="1"
						Style="{StaticResource PageHeaderCardStyle}"
						VerticalOptions="FillAndExpand">
						<ScrollView VerticalScrollBarVisibility="Never">
							<VerticalStackLayout Padding="14" Spacing="16">
								<VerticalStackLayout IsVisible="{Binding HasPatientContext}" Spacing="16">
									<controls:SparkExpandableCard
										Title="Дијагнози"
										EmptyViewText="Нема евидентирани прегледи."
										ItemTemplate="{StaticResource EncounterRowTemplate}"
										ItemsSource="{Binding PatientDiagnosisHistory}"
										Subtitle="Историја"
										Variant="Diagnosis" />
									<controls:SparkExpandableCard
										Title="Прегледи"
										EmptyViewText="Нема евидентирани прегледи."
										ItemTemplate="{StaticResource EncounterRowTemplate}"
										ItemsSource="{Binding FilteredEncounters}"
										Subtitle="Посети"
										Variant="Encounter" />
									<controls:SparkExpandableCard
										Title="Термини"
										EmptyViewText="Нема закажани термини."
										ItemTemplate="{StaticResource AppointmentRowTemplate}"
										ItemsSource="{Binding FilteredAppointments}"
										Subtitle="Закажани"
										Variant="Appointment" />
									<controls:SparkExpandableCard
										Title="Терапевтски циклуси"
										EmptyViewText="Нема терапевтски циклуси."
										ItemTemplate="{StaticResource TherapyCycleRowTemplate}"
										ItemsSource="{Binding PatientTherapyCyclesHistory}"
										Variant="TherapyCycle" />
									<controls:SparkExpandableCard
										Title="Историја на Рецепти"
										EmptyViewText="Нема рецепти."
										ItemTemplate="{StaticResource PrescriptionRowTemplate}"
										ItemsSource="{Binding FilteredPrescriptions}"
										Variant="Prescription" />
									<controls:SparkExpandableCard
										Title="Терапии со лекови"
										EmptyViewText="Нема терапии со лекови."
										ItemTemplate="{StaticResource PatientMedicineRowTemplate}"
										ItemsSource="{Binding PatientMedicines}"
										Variant="Medicine" />
								</VerticalStackLayout>
							</VerticalStackLayout>
						</ScrollView>
					</Border>
				</Grid>

			</Grid>
		</Grid>
	</Grid>
</ContentPage>
