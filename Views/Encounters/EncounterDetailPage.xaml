					PrimaryButtonCommand="{Binding EditCommand}"
					PrimaryButtonIsEnabled="{Binding CanShowEdit}"
					PrimaryButtonText="Уреди"
					SecondaryButtonCommand="{Binding GenerateClinicalReportCommand}"
					SecondaryButtonIsEnabled="{Binding CanPrint}"
					SecondaryButtonText="Преглед за печатење / PDF"
					SecondaryButtonWidthRequest="230"
					ShowPrimaryButton="{Binding CanShowEdit}"
					ShowSecondaryButton="False"
					Subtitle="{Binding Encounter.EncounterDate, StringFormat='Преглед од {0:dd.MM.yyyy}'}">
					<controls:FFPageHeader.HeaderContent>
						<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding CancelCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
							<Border
								Padding="12,0"
								BackgroundColor="{Binding Encounter.Status, Converter={StaticResource StatusBgConverter}}"
								HeightRequest="34"
								IsVisible="{Binding IsAdmin}"
								StrokeShape="RoundRectangle 17"
								StrokeThickness="0">
								<HorizontalStackLayout Spacing="7" VerticalOptions="Center">
									<BoxView
										CornerRadius="4"
										HeightRequest="8"
										WidthRequest="8"
										Color="{Binding Encounter.Status, Converter={StaticResource StatusColorConverter}}" />
									<Label
										FontAttributes="Bold"
										FontSize="12"
										Text="{Binding Encounter.Status, Converter={StaticResource StatusTextConverter}}"
										TextColor="{Binding Encounter.Status, Converter={StaticResource StatusColorConverter}}" />
								</HorizontalStackLayout>
							</Border>
						</HorizontalStackLayout>
					</controls:FFPageHeader.HeaderContent>
				</controls:FFPageHeader>
			</Border>

