							<!--  БИОЛОШКА ТЕРАПИЈА: МКБ-10 дијагнози, активни лекови и скор  -->
							<Border Style="{StaticResource CrudFormSectionCardStyle}">
								<VerticalStackLayout IsVisible="True" Spacing="8">
									<controls:CrudSectionHeader
										Title="БИОЛОШКА ТЕРАПИЈА"
										LineColor="{StaticResource Gray600}"
										Style="{StaticResource CrudFormSectionHeaderStyle}" />
									<Grid
										ColumnDefinitions="2*,2*,1*"
										ColumnSpacing="8"
										RowDefinitions="Auto"
										VerticalOptions="Start">
										<Border
											Grid.Column="0"
											HorizontalOptions="Fill"
											Style="{StaticResource CrudFormTableFrameStyle}"
											VerticalOptions="Start">
											<VerticalStackLayout Spacing="0">
												<Grid Style="{StaticResource CrudFormTableHeaderGridStyle}">
													<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="МКБ-10 ДИЈАГНОЗИ" />
												</Grid>
												<VerticalStackLayout
													BindableLayout.ItemsSource="{Binding Mkb10Assignments}"
													Spacing="0"
													VerticalOptions="Start">
													<BindableLayout.EmptyView>
														<Label
															FontSize="11"
															Text="Нема доделени дијагнози."
															TextColor="{StaticResource SparkTextSecondary}" />
													</BindableLayout.EmptyView>
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="entities:PatientMkb10Assignment">
															<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
																<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
																<VerticalStackLayout
																	Grid.Column="1"
																	Padding="0,3"
																	Spacing="1">
																	<Label
																		FontAttributes="Bold"
																		FontSize="11.5"
																		Text="{Binding Mkb10Code.Code, TargetNullValue='—'}"
																		TextColor="{StaticResource SparkAccentTealDark}" />
																	<Label
																		FontSize="10.5"
																		LineBreakMode="WordWrap"
																		Text="{Binding Mkb10Code.Description, TargetNullValue='—'}"
																		TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															FontSize="9.5"
															Text="{Binding DiagnosedAt, StringFormat='Евидентирана: {0:dd.MM.yyyy}'}"
															TextColor="{StaticResource SparkTextSecondary}" />
																</VerticalStackLayout>
															</Grid>
														</DataTemplate>
													</BindableLayout.ItemTemplate>
												</VerticalStackLayout>
											</VerticalStackLayout>
										</Border>
										<Border
											Grid.Column="1"
											HorizontalOptions="Fill"
											Style="{StaticResource CrudFormTableFrameStyle}"
											VerticalOptions="Start">
											<VerticalStackLayout Spacing="0">
												<Grid Style="{StaticResource CrudFormTableHeaderGridStyle}">
													<Label Style="{StaticResource CrudFormTableHeaderLabelStyle}" Text="АКТИВНИ / ОДОБРЕНИ ЛЕКОВИ ЗА ПАЦИЕНТ" />
												</Grid>
												<VerticalStackLayout
													BindableLayout.ItemsSource="{Binding CurrentPatientMedicines}"
													Spacing="0"
													VerticalOptions="Start">
													<BindableLayout.EmptyView>
														<Label
															FontSize="11"
															Text="Нема лекови во овој преглед."
															TextColor="{StaticResource SparkTextSecondary}" />
													</BindableLayout.EmptyView>
													<BindableLayout.ItemTemplate>
														<DataTemplate x:DataType="entities:PatientMedicine">
															<Grid ColumnDefinitions="18,*" ColumnSpacing="5">
																<controls:CrudTimelineMarker Grid.Column="0" WidthRequest="18" />
																<VerticalStackLayout
																	Grid.Column="1"
																	Padding="0,3"
																	Spacing="1">
																	<Label
																		FontAttributes="Bold"
																		FontSize="11.5"
																		LineBreakMode="WordWrap"
																		Text="{Binding Medicine.BilingualName, TargetNullValue='Лек'}"
