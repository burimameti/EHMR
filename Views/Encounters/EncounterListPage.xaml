<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="viewModels:EncounterListViewModel">
	<Grid ColumnDefinitions="285,*">
		<!--  ================= LEFT MENU =================  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>
		<!--  ================= MAIN =================  -->
		<Grid
			Grid.Column="1"
			Padding="24"
			BackgroundColor="{StaticResource Gray200}"
			RowDefinitions="Auto,Auto,*"
			RowSpacing="16">
			<!--  HEADER  -->
			<Border
				Grid.Row="0"
				Padding="20"
				StrokeShape="RoundRectangle 0"
				Style="{StaticResource SurfaceCard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader Title="Регистар на прегледи" Subtitle="Преглед, пребарување и управување со прегледи" />
					<Button
						Grid.Column="1"
						BackgroundColor="{StaticResource SparkBadgeNeutralBgSelected}"
						Command="{Binding NewEncounterCommand}"
						HeightRequest="45"
						Style="{StaticResource TabButtonActiveStyle}"
						Text="Нов Преглед"
						WidthRequest="150" />
				</Grid>
			</Border>
			<!--  SEARCH / FILTER  -->
			<Border Grid.Row="1" Padding="0">
				<Grid ColumnSpacing="5" RowSpacing="20">
					<VerticalStackLayout>
						<Border Margin="0,8,0,8" Padding="0">
							<controls:SparkExplorerHeaderView
								Buttons="{Binding Buttons}"
								Pickers="{Binding Pickers}"
								SearchPlaceholder="Пребарување на прегледи..."
								SearchText="{Binding SearchText}"
								Tabs="{Binding Tabs}" />
						</Border>
						<Border>
							<controls:SparkDataGridView
								x:Name="EncounterGrid"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditEncounterCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding OpenEncounterCommand}"
								Rows="{Binding GridRows}"
								TotalPages="{Binding TotalPages}" />
						</Border>
					</VerticalStackLayout>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>