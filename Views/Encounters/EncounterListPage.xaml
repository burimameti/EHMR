<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="EHMR.Views.Encounters.EncounterListPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:converters="clr-namespace:EHMR.Converters"
	xmlns:entities="clr-namespace:EHMR.Domain.Entities"
	xmlns:viewModels="clr-namespace:EHMR.ViewModels.Encounters"
	x:Name="PageRoot"
	x:DataType="viewModels:EncountersListViewModel"
	BackgroundColor="{StaticResource PageBackground}">

	<ContentPage.Resources>
		<ResourceDictionary>
			<converters:EncounterStatusChipBackgroundConverter x:Key="EncounterStatusChipBg" />
			<converters:EncounterStatusChipTextConverter x:Key="EncounterStatusChipFg" />
			<converters:EncounterStatusChipLabelConverter x:Key="EncounterStatusChipLabel" />
		</ResourceDictionary>
	</ContentPage.Resources>
	<Grid ColumnDefinitions="285,*">
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<Grid
			Grid.Column="1"
			Margin="0"
			RowDefinitions="Auto,*"
			RowSpacing="0">
			<Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
				<Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
					<controls:FFPageHeader
						Title="Прегледи"
						Grid.Column="0"
						Subtitle="Преглед, пребарување и управување со медицински прегледи">
						<controls:FFPageHeader.HeaderContent>
							<controls:FFButton
								ButtonKind="Secondary"
								Command="{Binding GoBackCommand}"
								HeightRequestEx="40"
								Text="Назад"
								WidthRequestEx="130" />
						</controls:FFPageHeader.HeaderContent>
					</controls:FFPageHeader>
					<!--<controls:FFButton
						Grid.Column="1"
						BackgroundColorEx="{StaticResource SparkButtonSecondaryBg}"
						ButtonKind="Primary"
						Command="{Binding NewCommand}"
						ContentPadding="16,0"
						HeightRequestEx="45"
						IsVisible="{Binding CanCreate}"
						Text="Нов преглед"
						TextColorEx="{StaticResource White}" />-->
				</Grid>
			</Border>

			<Border
				Grid.Row="1"
				BackgroundColor="{StaticResource PageBackground}"
				StrokeThickness="0">
				<ScrollView VerticalScrollBarVisibility="Never">
					<VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}">
						<controls:FFSectionCard>
							<Grid ColumnSpacing="5" RowSpacing="0">
								<VerticalStackLayout Spacing="20">
									<controls:SparkExplorerHeaderView
										Buttons="{Binding Buttons}"
										Pickers="{Binding Pickers}"
										SearchCommand="{Binding SearchCommand}"
										SearchPlaceholder="Пребарување на прегледи..."
										SearchText="{Binding SearchText}"
										SelectedSuggestion="{Binding SelectedEncounterSuggestion, Mode=TwoWay}"
										ShowSuggestions="{Binding ShowEncounterSuggestions}"
										Suggestions="{Binding EncounterSuggestions}"
										Tabs="{Binding Tabs}"
										UseCyrillicInput="{Binding UseCyrillicSearch, Mode=TwoWay}">
										<controls:SparkExplorerHeaderView.SuggestionTemplate>
											<DataTemplate x:DataType="entities:Encounter">
												<Border
													Margin="2"
													Padding="12,8"
													BackgroundColor="{StaticResource Gray100}"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeShape="RoundRectangle 2"
													StrokeThickness="1.2">
													<Grid ColumnDefinitions="1.7*,1.1*,1.1*,1*" ColumnSpacing="14">
														<VerticalStackLayout Spacing="1">
															<Label
																FontSize="10"
																Text="Име и презиме"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.FullName}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="1" Spacing="1">
															<Label
																FontSize="10"
																Text="ЕМБГ"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.NationalId}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="2" Spacing="1">
															<Label
																FontSize="10"
																Text="СЗБО број"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Label
																FontAttributes="Bold"
																FontSize="12"
																Text="{Binding Patient.SzboNumber}"
																TextColor="{StaticResource SparkTextPrimary}" />
														</VerticalStackLayout>
														<VerticalStackLayout Grid.Column="3" Spacing="1">
															<Label
																FontSize="10"
																Text="Статус преглед"
																TextColor="{StaticResource SparkAccentTealDark}" />
															<Border
																Padding="8,4"
																BackgroundColor="{Binding Status, Converter={StaticResource EncounterStatusChipBg}}"
																StrokeThickness="0"
																VerticalOptions="Start">
																<Border.StrokeShape>
																	<RoundRectangle CornerRadius="8" />
																</Border.StrokeShape>
																<Label
																	FontAttributes="Bold"
																	FontSize="11"
																	HorizontalTextAlignment="Center"
																	Text="{Binding Status, Converter={StaticResource EncounterStatusChipLabel}}"
																	TextColor="{Binding Status, Converter={StaticResource EncounterStatusChipFg}}" />
															</Border>
														</VerticalStackLayout>
													</Grid>
												</Border>
											</DataTemplate>
										</controls:SparkExplorerHeaderView.SuggestionTemplate>
										<!--<controls:SparkExplorerHeaderView.SuggestionTemplate>
											<DataTemplate x:DataType="entities:Encounter">
												<Border
													Margin="2"
													Padding="12,8"
													BackgroundColor="{StaticResource SparkContentBackground}"
													Stroke="{StaticResource SparkBorderSubtle}"
													StrokeShape="RoundRectangle 4"
													StrokeThickness="1">
													<Grid ColumnDefinitions="1.1*,1.8*,1.2*,1.3*,1*" ColumnSpacing="12">
														<Label
															FontAttributes="Bold"
															FontSize="12"
															Text="{Binding EncounterNumber}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															Grid.Column="1"
															FontSize="12"
															Text="{Binding Patient.FullName}"
															TextColor="{StaticResource SparkTextPrimary}" />
														<Label
															Grid.Column="2"
															FontAttributes="Bold"
															FontSize="11"
															Text="{Binding Patient.SzboNumber}"
															TextColor="{StaticResource SparkAccentTealDark}" />
														<Label
															Grid.Column="3"
															FontSize="11"
															Text="{Binding ScheduledStart, StringFormat='{0:dd.MM.yyyy HH:mm}'}"
															TextColor="{StaticResource SparkTextSecondary}" />
														<Label
															Grid.Column="4"
															FontAttributes="Bold"
															FontSize="11"
															Text="{Binding Status}"
															TextColor="{StaticResource SparkAccentTealDark}" />
													</Grid>
												</Border>
											</DataTemplate>
										</controls:SparkExplorerHeaderView.SuggestionTemplate>-->
									</controls:SparkExplorerHeaderView>
								</VerticalStackLayout>
							</Grid>
						</controls:FFSectionCard>

						<controls:FFSectionCard>
							<controls:SparkDataGridView
								x:Name="EncounterGrid"
								AutoSelectFirstRow="False"
								Columns="{Binding GridColumns}"
								CurrentPage="{Binding CurrentPage}"
								EditRowCommand="{Binding EditCommand}"
								QuickPreviewCommand="{Binding PreviewCommand}"
								NextPageCommand="{Binding NextPageCommand}"
								PageChangedCommand="{Binding PageChangedCommand}"
								PageInfoText="{Binding PageInfoText}"
								PreviousPageCommand="{Binding PreviousPageCommand}"
								RowTappedCommand="{Binding SelectCommand}"
								Rows="{Binding GridRows}"
								ShowPagination="True"
								ShowRowNumbers="True"
								TotalPages="{Binding TotalPages}" />
						</controls:FFSectionCard>
					</VerticalStackLayout>
				</ScrollView>
			</Border>
		</Grid>

		<Grid
			Grid.Column="1"
			BackgroundColor="{StaticResource SparkOverlay}"
			IsVisible="{Binding IsBusy}">
			<VerticalStackLayout
				HorizontalOptions="Center"
				Spacing="12"
				VerticalOptions="Center">
				<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
				<Label
					FontSize="13"
					Text="Вчитување..."
					TextColor="{StaticResource SparkTextPrimary}" />
			</VerticalStackLayout>
		</Grid>
	</Grid>
</ContentPage>