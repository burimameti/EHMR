<Grid
	x:Class="EHMR.Components.PageHeader"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Border Padding="16" Style="{StaticResource DashboardCard}">

		<Grid ColumnDefinitions="*,Auto">

			<VerticalStackLayout>

				<Label Style="{StaticResource MedicalSectionTitle}" Text="{Binding Title}" />

				<Label Style="{StaticResource MutedText}" Text="{Binding Subtitle}" />
			</VerticalStackLayout>

			<Border
				Grid.Column="1"
				Padding="12,6"
				BackgroundColor="{StaticResource SurfaceAlt}"
				StrokeShape="RoundRectangle 10"
				StrokeThickness="0">

				<Label FontAttributes="Bold" Text="{Binding UserName}" />
			</Border>
		</Grid>
	</Border>
</Grid>