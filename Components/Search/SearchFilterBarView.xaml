<ContentView
	x:Class="EHMR.Components.Search.SearchFilterBarView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Border Style="{StaticResource DashboardCard}">
		<Grid ColumnDefinitions="*,90,170,170,130,120" ColumnSpacing="8">

			<!--  SEARCH  -->

			<VerticalStackLayout>
				<Label Style="{StaticResource InputLabel}" Text="ПРЕБАРУВАЊЕ" />

				<Border Style="{StaticResource InputBorderStyle}">

					<Grid ColumnDefinitions="Auto,*">
						<Label
							FontFamily="FASolid"
							Text="&#xf002;"
							TextColor="{StaticResource TextMuted}" />

						<Entry
							Grid.Column="1"
							Placeholder="Пребарај пациент или доктор..."
							Text="{Binding SearchText}" />
					</Grid>
				</Border>
			</VerticalStackLayout>

			<!--  DATE FILTER  -->

			<VerticalStackLayout>

				<Label Style="{StaticResource InputLabel}" Text="ФИЛТЕР" />

				<CheckBox IsChecked="{Binding FilterByDate}" />
			</VerticalStackLayout>

			<DatePicker Date="{Binding FilterDate}" IsEnabled="{Binding FilterByDate}" />

			<Picker ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}" />

			<Button
				BackgroundColor="{StaticResource SparkButtonSecondaryBg}"
				Command="{Binding ClearFiltersCommand}"
				CornerRadius="6"
				Text="Исчисти"
				TextColor="White" />

			<Button Command="{Binding AddCommand}" Text="Нов" />
		</Grid>
	</Border>
</ContentView>