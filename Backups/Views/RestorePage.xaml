<ContentPage
    x:Class="EHMR.Backups.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EHMR.Resources.Controls"
    xmlns:viewModels="clr-namespace:EHMR.Backups.ViewModels"
    x:DataType="viewModels:RestoreViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="260,*">
        <Border Grid.Column="0" BackgroundColor="{StaticResource SparkSidebarBg}" StrokeThickness="0">
            <ContentView x:Name="MenuHost" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <controls:FFPageHeader Title="Враќање на база" Subtitle="Враќање на базата на податоци од резервна копија." />
                    <controls:FFButton
                        Grid.Column="1"
                        ButtonKind="Primary"
                        BackgroundColorEx="{StaticResource SparkDanger}"
                        TextColorEx="White"
                        Command="{Binding RestoreCommand}"
                        ContentPadding="18,0"
                        HeightRequestEx="45"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                        Text="Врати база" />
                </Grid>
            </Border>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}" Spacing="12">
                    <Border Style="{StaticResource PageCardStyleDashboard}">
                        <VerticalStackLayout Spacing="16">
                            <Label FontAttributes="Bold" FontSize="16" Text="Поставки" TextColor="{StaticResource SparkTextPrimary}" />
                            <Border Padding="12,2" BackgroundColor="{StaticResource SparkPageBackground}" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                                <Entry
                                    BackgroundColor="Transparent"
                                    FontSize="13"
                                    Placeholder="Патека до бекап фајлот"
                                    Text="{Binding Settings.BackupFile}"
                                    TextColor="{StaticResource SparkTextPrimary}" />
                            </Border>
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding Settings.IsEncrypted}" />
                                <Label FontSize="13" Text="Криптиран бекап" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource PageCardStyleDashboard}">
                        <VerticalStackLayout Spacing="10">
                            <Label FontAttributes="Bold" FontSize="16" Text="Прогрес" TextColor="{StaticResource SparkTextPrimary}" />
                            <ProgressBar HeightRequest="8" Progress="{Binding Progress.Percentage}" ProgressColor="{StaticResource SparkAccentTeal}" />
                            <Label FontSize="12.5" Text="{Binding StatusMessage}" TextColor="{StaticResource SparkTextSecondary}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Padding="14" BackgroundColor="{StaticResource SparkDangerBg}" Stroke="{StaticResource SparkDanger}" StrokeShape="RoundRectangle 8" StrokeThickness="1">
                        <Label FontSize="12.5" Text="Враќањето ќе ги презапише тековните податоци во базата. Оваа операција не може да се врати назад." TextColor="{StaticResource SparkDanger}" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Column="1" BackgroundColor="{StaticResource SparkOverlay}" IsVisible="{Binding IsBusy}">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
                    <Label FontSize="13" Text="Враќање во тек..." TextColor="{StaticResource SparkTextPrimary}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>