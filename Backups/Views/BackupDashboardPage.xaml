<ContentPage
    x:Class="EHMR.Backups.Views.BackupDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EHMR.Resources.Controls"
    xmlns:viewModels="clr-namespace:EHMR.Backups.ViewModels"
    x:DataType="viewModels:BackupDashboardViewModel"
    BackgroundColor="{StaticResource PageBackground}">

    <Grid ColumnDefinitions="260,*">
        <Border Grid.Column="0" BackgroundColor="{StaticResource SparkSidebarBg}" StrokeThickness="0">
            <ContentView x:Name="MenuHost" />
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">
            <Border Grid.Row="0" Style="{StaticResource PageCardStyleDashboard}">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <controls:FFPageHeader
                        Title="Бекап"
                        Subtitle="Преглед на состојбата и историјата на резервните копии." />
                    <controls:FFButton
                        Grid.Column="1"
                        ButtonKind="Primary"
                        BackgroundColorEx="{StaticResource SidebarActiveBg}"
                        TextColorEx="White"
                        Command="{Binding RunBackupCommand}"
                        ContentPadding="18,0"
                        HeightRequestEx="45"
                        Text="Нов бекап" />
                </Grid>
            </Border>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Style="{StaticResource ListPageContentStackStyle}" Spacing="12">

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Border Padding="12,8" BackgroundColor="White" HeightRequest="72" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                                <Border Grid.RowSpan="2" BackgroundColor="{StaticResource SparkAccentTeal}" HeightRequest="30" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="30">
                                    <Label FontFamily="FASolid" FontSize="12" HorizontalOptions="Center" Text="&#xf1da;" TextColor="White" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="9" Text="ПОСЛЕДЕН БЕКАП" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" Text="{Binding LastBackup}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,4" BackgroundColor="{StaticResource SparkAccentTeal}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" Text="Состојба" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Padding="12,8" BackgroundColor="White" HeightRequest="72" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                                <Border Grid.RowSpan="2" BackgroundColor="{StaticResource SparkAccentTeal}" HeightRequest="30" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="30">
                                    <Label FontFamily="FASolid" FontSize="12" HorizontalOptions="Center" Text="&#xf0c7;" TextColor="White" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="9" Text="ГОЛЕМИНА НА БАЗА" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="15" Text="{Binding DatabaseSize}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,4" BackgroundColor="{StaticResource SparkAccentTeal}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" Text="База" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="12,8" BackgroundColor="White" HeightRequest="72" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                                <Border Grid.RowSpan="2" BackgroundColor="{StaticResource SparkAccentTeal}" HeightRequest="30" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="30">
                                    <Label FontFamily="FASolid" FontSize="12" HorizontalOptions="Center" Text="&#xf058;" TextColor="White" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="9" Text="СТАТУС" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="15" Text="{Binding BackupStatus}" TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,4" BackgroundColor="{StaticResource SparkAccentTeal}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" Text="Системски статус" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="3" Padding="12,8" BackgroundColor="White" HeightRequest="72" Stroke="{StaticResource SparkBorderSubtle}" StrokeShape="RoundRectangle 12" StrokeThickness="1.5">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                                <Border Grid.RowSpan="2" BackgroundColor="{StaticResource SparkAccentTeal}" HeightRequest="30" StrokeShape="RoundRectangle 8" StrokeThickness="0" WidthRequest="30">
                                    <Label FontFamily="FASolid" FontSize="12" HorizontalOptions="Center" Text="&#xf0e8;" TextColor="White" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" FontAttributes="Bold" FontSize="9" Text="ДЕСТИНАЦИИ" TextColor="{StaticResource SparkTextSecondary}" VerticalOptions="Center" />
                                <Label Grid.Column="2" FontAttributes="Bold" FontSize="15" Text="{Binding DestinationCount}" TextColor="{StaticResource SparkTextPrimary}" VerticalOptions="Center" />
                                <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Padding="8,4" BackgroundColor="{StaticResource SparkAccentTeal}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                    <Label FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center" Text="Складишта" TextColor="White" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource PageCardStyleDashboard}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label FontAttributes="Bold" FontSize="16" Text="Историја на бекапи" TextColor="{StaticResource SparkTextPrimary}" />
                                    <Label FontSize="11" Text="Последните извршени резервни копии." TextColor="{StaticResource SparkTextMuted}" />
                                </VerticalStackLayout>
                                <controls:FFButton
                                    Grid.Column="1"
                                    ButtonKind="Secondary"
                                    Command="{Binding OpenDestinationsCommand}"
                                    ContentPadding="14,0"
                                    HeightRequestEx="38"
                                    Text="Дестинации" />
                            </Grid>
                            <controls:SparkDataGridView Grid.Row="1" Columns="{Binding GridColumns}" Rows="{Binding GridRows}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Column="1" Grid.RowSpan="2" BackgroundColor="{StaticResource SparkOverlay}" IsVisible="{Binding IsBusy}">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="12" VerticalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource SparkAccentTeal}" />
                    <Label FontSize="13" Text="Вчитување..." TextColor="{StaticResource SparkTextPrimary}" />
                </VerticalStackLayout>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>