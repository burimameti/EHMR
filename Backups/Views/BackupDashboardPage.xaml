<!--  File: EHMR.Backups/Views/BackupDashboardPage.xaml  -->
<!--  (same XAML as before — unchanged, included here for completeness)  -->
<ContentPage
	x:Class="EHMR.Backups.Views.BackupDashboardPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:viewModels="clr-namespace:EHMR.Backups.ViewModels"
	x:DataType="viewModels:BackupDashboardViewModel">

	<ContentPage.Resources>
		<ResourceDictionary>
			<Style x:Key="BackupKpiCard" TargetType="Border">
				<Setter Property="Padding" Value="20" />
				<Setter Property="BackgroundColor" Value="{StaticResource White}" />
				<Setter Property="Stroke" Value="{StaticResource Gray100}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 12" />
			</Style>
			<Style x:Key="BackupKpiLabel" TargetType="Label">
				<Setter Property="FontSize" Value="13" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>
			<Style x:Key="BackupKpiValue" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="22" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>
			<Style x:Key="BackupCardTitle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="20" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
			</Style>
		</ResourceDictionary>
	</ContentPage.Resources>
	<Grid ColumnDefinitions="290,*">

		<!--  LEFT MENU  -->
		<Border Grid.Column="0" StrokeThickness="0">
			<ContentView x:Name="MenuHost" />
		</Border>

		<!--  RIGHT MAIN CONTAINER  -->
		<Grid Grid.Column="1" RowDefinitions="Auto,*">

			<Border BackgroundColor="{StaticResource Gray200}" StrokeThickness="0">
				<Grid RowDefinitions="110,Auto,*" RowSpacing="0">

					<Border Grid.Row="0" Style="{StaticResource PageHeaderCardStyle}">
						<Grid ColumnDefinitions="*,*" VerticalOptions="Center">
							<controls:FFPageHeader Title="Backup Dashboard" Subtitle="Преглед на состојбата на бекап процесите." />
							<HorizontalStackLayout
								Grid.Column="1"
								HorizontalOptions="End"
								Spacing="10"
								VerticalOptions="Center">
								<Button
									BackgroundColor="{StaticResource SparkAccentTeal}"
									Command="{Binding RunBackupCommand}"
									HeightRequest="45"
									Style="{StaticResource TabButtonActiveStyle}"
									Text="Нов бекап"
									TextColor="White"
									WidthRequest="160" />
							</HorizontalStackLayout>
						</Grid>
					</Border>

					<Border Grid.Row="1" Padding="16,20,16,0">
						<Grid
							ColumnDefinitions="*,*,*,*"
							ColumnSpacing="15"
							RowSpacing="15">

							<Border Grid.Column="0" Style="{StaticResource BackupKpiCard}">
								<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
									<Label Style="{StaticResource BackupKpiLabel}" Text="Последен бекап" />
									<Label
										Grid.Row="1"
										Style="{StaticResource BackupKpiValue}"
										Text="{Binding LastBackup}" />
								</Grid>
							</Border>

							<Border Grid.Column="1" Style="{StaticResource BackupKpiCard}">
								<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
									<Label Style="{StaticResource BackupKpiLabel}" Text="Големина на база" />
									<Label
										Grid.Row="1"
										Style="{StaticResource BackupKpiValue}"
										Text="{Binding DatabaseSize}" />
								</Grid>
							</Border>

							<Border Grid.Column="2" Style="{StaticResource BackupKpiCard}">
								<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
									<Label Style="{StaticResource BackupKpiLabel}" Text="Статус" />
									<Label
										Grid.Row="1"
										Style="{StaticResource BackupKpiValue}"
										Text="{Binding BackupStatus}"
										TextColor="{Binding StatusColor}" />
								</Grid>
							</Border>

							<Border Grid.Column="3" Style="{StaticResource BackupKpiCard}">
								<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
									<Label Style="{StaticResource BackupKpiLabel}" Text="Дестинации" />
									<Label
										Grid.Row="1"
										Style="{StaticResource BackupKpiValue}"
										Text="{Binding DestinationCount}" />
								</Grid>
							</Border>

						</Grid>
					</Border>

					<Border Grid.Row="2" Padding="16,20,16,20">
						<Border
							Padding="20"
							BackgroundColor="{StaticResource White}"
							Stroke="{StaticResource Gray100}"
							StrokeShape="RoundRectangle 12">
							<Grid RowDefinitions="Auto,*" RowSpacing="12">

								<Grid ColumnDefinitions="*,Auto">
									<Label Style="{StaticResource BackupCardTitle}" Text="Историја на бекапи" />
								</Grid>

								<!--  Таблата покажува фиксна скорешна листа — овој VM нема страничење.  -->
								<controls:SparkDataGridView
									Grid.Row="1"
									Columns="{Binding GridColumns}"
									Rows="{Binding GridRows}" />

							</Grid>
						</Border>
					</Border>

					<Grid
						Grid.RowSpan="3"
						BackgroundColor="#80191E29"
						IsVisible="{Binding IsBusy}">
						<VerticalStackLayout
							HorizontalOptions="Center"
							Spacing="12"
							VerticalOptions="Center">
							<ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource Primary}" />
							<Label
								FontSize="13"
								Text="Вчитување..."
								TextColor="White" />
						</VerticalStackLayout>
					</Grid>

				</Grid>
			</Border>
		</Grid>
	</Grid>
</ContentPage>