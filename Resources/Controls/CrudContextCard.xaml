<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EHMR.Resources.Controls.CrudContextCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:EHMR.Resources.Controls"
    x:Name="Root"
    x:DataType="controls:CrudContextCard">
    <Border Padding="14,12" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkBorder}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border BackgroundColor="{Binding IconBackgroundColor, Source={x:Reference Root}}" HeightRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" WidthRequest="38">
                <Label FontFamily="FASolid" FontSize="14" HorizontalOptions="Center" Text="{Binding IconGlyph, Source={x:Reference Root}}" TextColor="{Binding IconColor, Source={x:Reference Root}}" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label FontSize="11.5" Text="{Binding Caption, Source={x:Reference Root}}" TextColor="{StaticResource SparkTextSecondary}" />
                <Label FontAttributes="Bold" FontSize="14" LineBreakMode="TailTruncation" Text="{Binding Value, Source={x:Reference Root}}" TextColor="{Binding ValueColor, Source={x:Reference Root}}" />
                <Label FontSize="12.5" IsVisible="{Binding Detail1, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}" Text="{Binding Detail1, Source={x:Reference Root}}" TextColor="{StaticResource SparkTextSecondary}" />
                <Label FontSize="12.5" IsVisible="{Binding Detail2, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}" Text="{Binding Detail2, Source={x:Reference Root}}" TextColor="{StaticResource SparkTextSecondary}" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>