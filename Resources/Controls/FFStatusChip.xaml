<?xml version="1.0" encoding="utf-8" ?>

<ContentView x:Class="EHMR.Resources.Controls.FFStatusChip"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="Root">

	<Border x:Name="ChipRoot"
            Style="{StaticResource FFStatusChipBaseStyle}"
            BackgroundColor="{Binding BackgroundColor, Source={x:Reference Root}}">

		<Label x:Name="ChipLabel"
               Text="{Binding Text, Source={x:Reference Root}}"
               Style="{StaticResource FFStatusChipLabelStyle}"
               TextColor="{Binding TextColor, Source={x:Reference Root}}" />
	</Border>
</ContentView>