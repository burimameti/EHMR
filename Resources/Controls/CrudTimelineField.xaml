<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.CrudTimelineField"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root">
	<controls:CrudTimelineRow ShowLine="{Binding ShowLine, Source={x:Reference Root}}">
		<Grid Padding="{StaticResource FormRowPadding}">
			<Grid
				ColumnDefinitions="130,*"
				ColumnSpacing="{StaticResource FormRowSpacing}"
				IsVisible="{Binding IsEditMode, Source={x:Reference Root}}">
				<Label
					Grid.Column="0"
					Style="{StaticResource EditFieldLabelStyle}"
					Text="{Binding Label, Source={x:Reference Root}}" />
				<ContentView x:Name="EditContentHost" Grid.Column="1" />
			</Grid>
			<Border IsVisible="{Binding IsReadOnly, Source={x:Reference Root}}" Style="{StaticResource DetailValueSurfaceStyle}">
				<Grid ColumnDefinitions="130,*" ColumnSpacing="{StaticResource FormRowSpacing}">
					<Label
						Grid.Column="0"
						Style="{StaticResource ReadRowLabelStyle}"
						Text="{Binding EffectiveReadLabel, Source={x:Reference Root}}" />
					<ContentView
						x:Name="ReadContentHost"
						Grid.Column="1"
						VerticalOptions="Center" />
				</Grid>
			</Border>
		</Grid>
	</controls:CrudTimelineRow>
</ContentView>