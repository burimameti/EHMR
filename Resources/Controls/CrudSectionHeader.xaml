<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.CrudSectionHeader"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root"
	x:DataType="controls:CrudSectionHeader"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls">

	<Grid RowDefinitions="Auto,1" RowSpacing="6">
		<Label
			FontAttributes="Bold"
			FontSize="12"
			CharacterSpacing="0.7"
			Text="{Binding Title, Source={x:Reference Root}}"
			TextColor="{Binding TextColor, Source={x:Reference Root}}"
			VerticalOptions="Center" />
		<BoxView
			Grid.Row="1"
			BackgroundColor="{Binding LineColor, Source={x:Reference Root}}"
			HeightRequest="1"
			HorizontalOptions="Fill" />
	</Grid>
</ContentView>