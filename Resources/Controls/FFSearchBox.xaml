<ContentView
	x:Class="EHMR.Resources.Controls.FFSearchBox"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root"
	HorizontalOptions="Fill"
	VerticalOptions="Center">

	<Grid
		HorizontalOptions="Fill"
		MinimumWidthRequest="220"
		RowDefinitions="Auto,Auto"
		RowSpacing="5"
		VerticalOptions="Center">

		<Label
			Margin="2,0,0,0"
			CharacterSpacing=".4"
			FontAttributes="Bold"
			FontSize="11"
			HorizontalOptions="Start"
			IsVisible="{Binding Label, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
			LineBreakMode="TailTruncation"
			MaxLines="1"
			Text="{Binding Label, Source={x:Reference Root}}"
			TextColor="{StaticResource SparkTextSecondary}" />

		<Border
			x:Name="SearchBorder"
			Grid.Row="1"
			Padding="0"
			BackgroundColor="{StaticResource White}"
			HeightRequest="36"
			HorizontalOptions="Fill"
			Stroke="#CBD5E1"
			StrokeShape="RoundRectangle 8"
			StrokeThickness="1"
			VerticalOptions="Center">

			<Border.GestureRecognizers>
				<PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
			</Border.GestureRecognizers>

			<Grid
				Padding="12,0,10,0"
				ColumnDefinitions="22,*,Auto"
				ColumnSpacing="0"
				HorizontalOptions="Fill"
				VerticalOptions="Center">

				<Label
					Grid.Column="0"
					FontFamily="FASolid"
					FontSize="12"
					Text="&#xf002;"
					TextColor="{StaticResource SparkTextSecondary}"
					VerticalOptions="Center" />

				<Entry
					Grid.Column="1"
					Margin="8,0,0,0"
					BackgroundColor="Transparent"
					Completed="OnEntryCompleted"
					FontSize="13"
					HorizontalOptions="Fill"
					Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
					PlaceholderColor="{StaticResource SparkTextMuted}"
					Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
					TextChanged="OnEntryTextChanged"
					TextColor="{StaticResource SparkTextPrimary}"
					VerticalOptions="Center" />

				<Label
					Grid.Column="2"
					FontAttributes="Bold"
					FontSize="11"
					IsVisible="{Binding Hint, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
					LineBreakMode="TailTruncation"
					Text="{Binding Hint, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextMuted}"
					VerticalOptions="Center" />

			</Grid>
			<Border.Triggers>
				<DataTrigger
					Binding="{Binding IsPointerOver, Source={x:Reference Root}}"
					TargetType="Border"
					Value="True">
					<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
					<Setter Property="StrokeThickness" Value="1.5" />
				</DataTrigger>
			</Border.Triggers>
		</Border>
	</Grid>
</ContentView>