<?xml version="1.0" encoding="utf-8" ?>

<controls:ShadowFieldContainer
	x:Class="EHMR.Resources.Controls.ShadowEntryField"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root">

	<controls:ShadowFieldContainer.FieldContent>
		<Entry
			BackgroundColor="Transparent"
			Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
			PlaceholderColor="{StaticResource SparkTextMuted}"
			Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
			TextColor="{StaticResource SparkTextPrimary}" />
	</controls:ShadowFieldContainer.FieldContent>
</controls:ShadowFieldContainer>