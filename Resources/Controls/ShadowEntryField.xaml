<?xml version="1.0" encoding="utf-8" ?>

<controls:ShadowFieldContainer xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                               xmlns:controls="clr-namespace:EHMR.Resources.Controls"
                               x:Class="EHMR.Resources.Controls.ShadowEntryField"
                               x:Name="Root">

	<controls:ShadowFieldContainer.FieldContent>
		<Entry Text="{Binding Text, Source={x:Reference Root}, Mode=TwoWay}"
               Placeholder="{Binding Placeholder, Source={x:Reference Root}}"
               PlaceholderColor="#9CA3AF"
               BackgroundColor="Transparent"
               TextColor="#111827" />
	</controls:ShadowFieldContainer.FieldContent>
</controls:ShadowFieldContainer>