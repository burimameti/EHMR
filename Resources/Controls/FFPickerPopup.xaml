<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup x:Class="EHMR.Resources.Controls.FFPickerPopup"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" CanBeDismissedByTappingOutsideOfPopup="True">
 <Border Padding="0" BackgroundColor="White" Stroke="#D6DCE5" StrokeShape="RoundRectangle 12" StrokeThickness="1" WidthRequest="360">
  <Grid RowDefinitions="Auto,Auto,*" MaximumHeightRequest="420">
   <Grid Padding="18,14" ColumnDefinitions="*,Auto"><Label FontAttributes="Bold" FontSize="15" Text="{Binding Title}" TextColor="#0F172A"/><Label Grid.Column="1" FontFamily="FASolid" Text="&#xf00d;" TextColor="#64748B"/></Grid>
   <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#E2E8F0"/>
   <CollectionView x:Name="ItemsView" Grid.Row="2" Margin="6" SelectionMode="Single"/>
  </Grid>
 </Border>
</toolkit:Popup>