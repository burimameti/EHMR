<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFButton"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root"
	SizeChanged="OnButtonSizeChanged">
	<Border
		x:Name="Container"
		Padding="{Binding ContentPadding, Source={x:Reference Root}}"
		BackgroundColor="{Binding BackgroundColorEx, Source={x:Reference Root}}"
		HorizontalOptions="{Binding HorizontalOptionsEx, Source={x:Reference Root}}"
		HorizontalOptions="Fill"
		MinimumHeightRequest="{Binding HeightRequestEx, Source={x:Reference Root}}"
		MinimumWidthRequest="{Binding WidthRequestEx, Source={x:Reference Root}}"
		Stroke="{Binding BorderColor, Source={x:Reference Root}}"
		StrokeThickness="{Binding BorderThickness, Source={x:Reference Root}}"
		VerticalOptions="Center">
		<Border.Shadow>
			<Shadow
				Brush="#18000000"
				Radius="4"
				Offset="0,1" />
		</Border.Shadow>
		<Border.StrokeShape>
			<RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference Root}}" />
		</Border.StrokeShape>
		<Border.GestureRecognizers>
			<TapGestureRecognizer Tapped="OnTapped" />
		</Border.GestureRecognizers>
		<Grid
			ColumnDefinitions="Auto,*"
			ColumnSpacing="8"
			HorizontalOptions="Fill">
			<ActivityIndicator
				Grid.Column="0"
				HeightRequest="16"
				IsRunning="{Binding IsLoading, Source={x:Reference Root}}"
				IsVisible="{Binding IsLoading, Source={x:Reference Root}}"
				WidthRequest="16"
				Color="{Binding TextColorEx, Source={x:Reference Root}}" />
			<Label
				Grid.Column="1"
				FontAttributes="{Binding FontAttributesEx, Source={x:Reference Root}}"
				FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
				FontSize="{Binding FontSizeEx, Source={x:Reference Root}}"
				HorizontalTextAlignment="Center"
				LineBreakMode="TailTruncation"
				MaxLines="1"
				HorizontalOptions="Fill"
				Text="{Binding Text, Source={x:Reference Root}}"
				TextColor="{Binding TextColorEx, Source={x:Reference Root}}"
				VerticalOptions="Center" />
		</Grid>
	</Border>
</ContentView>