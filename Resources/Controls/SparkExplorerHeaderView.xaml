<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.SparkExplorerHeaderView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root"
	SizeChanged="OnHeaderSizeChanged"
	ZIndex="100">

	<!--
		РЕДИЗАЈН (само визуелно):
		• Ред 1: Пребарување (fill) | Кирилица | Копчиња
		• Ред 2: Pickers во wrap-grid (4 по ред, 3 на потесни ширини)
		Сите x:Name, bindings и event handlers се непроменети.
	-->

	<VerticalStackLayout
		Margin="0"
		Padding="0"
		BackgroundColor="Transparent"
		Spacing="0">

		<!--  ============ SEARCH + FILTERS + BUTTONS ============  -->
		<Grid BackgroundColor="Transparent" IsVisible="{Binding SearchVisible, Source={x:Reference Root}}">
			<Grid
				x:Name="SecondaryToolbarGrid"
				Padding="0"
				ColumnDefinitions="*,Auto,Auto,Auto"
				ColumnSpacing="14"
				MinimumHeightRequest="0"
				MinimumWidthRequest="0"
				RowDefinitions="Auto,Auto"
				RowSpacing="3">

				<!--  Search – ги зазема сите преостанати колони  -->
				<VerticalStackLayout
					Grid.Row="0"
					Grid.Column="0"
					HorizontalOptions="Fill"
					MinimumWidthRequest="0"
					Spacing="2"
					VerticalOptions="Start">
					<Label
						FontAttributes="Bold"
						FontSize="0"
						Text=""
						TextColor="{StaticResource SparkTextSecondary}" />
					<sc:FFSearchBox
						x:Name="HeaderSearchBox"
						HorizontalOptions="Fill"
						Label=""
						Placeholder="{Binding SearchPlaceholder, Source={x:Reference Root}}"
						SearchCommand="{Binding SearchCommand, Source={x:Reference Root}}"
						Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
						VerticalOptions="Start" />

					<Border
						Padding="4"
						BackgroundColor="White"
						IsVisible="{Binding ShowSuggestions, Source={x:Reference Root}}"
						Stroke="{StaticResource SparkBorderSubtle}"
						StrokeShape="RoundRectangle 10"
						StrokeThickness="1">
						<Grid ColumnDefinitions="*,12" ColumnSpacing="4">
							<CollectionView
								x:Name="SuggestionList"
								Grid.Column="0"
								HeightRequest="164"
								ItemTemplate="{Binding SuggestionTemplate, Source={x:Reference Root}}"
								ItemsSource="{Binding Suggestions, Source={x:Reference Root}}"
								Scrolled="OnSuggestionListScrolled"
								SelectedItem="{Binding SelectedSuggestion, Source={x:Reference Root}, Mode=TwoWay}"
								SelectionMode="Single"
								VerticalScrollBarVisibility="Never" />
							<Border
								x:Name="SuggestionScrollRail"
								Grid.Column="1"
								Margin="2,4"
								BackgroundColor="#E2E8F0"
								StrokeThickness="0">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="4" />
								</Border.StrokeShape>
								<Border
									x:Name="SuggestionScrollThumb"
									BackgroundColor="{StaticResource SidebarActiveBg}"
									HeightRequest="38"
									StrokeThickness="0"
									VerticalOptions="Start">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="4" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<PanGestureRecognizer PanUpdated="OnSuggestionThumbPanUpdated" />
									</Border.GestureRecognizers>
								</Border>
							</Border>
						</Grid>
					</Border>
				</VerticalStackLayout>

				<!--  Кирилица – checkbox + текст, порамнет со полето  -->
				<HorizontalStackLayout
					x:Name="CyrillicToggleLayout"
					Grid.Row="0"
					Grid.Column="2"
					Margin="0,20,0,0"
					Padding="8,0,12,0"
					BackgroundColor="{StaticResource SparkAccentTealBg}"
					HeightRequest="38"
					IsVisible="{Binding ShowCyrillicToggle, Source={x:Reference Root}}"
					Spacing="2"
					VerticalOptions="Start">
					<CheckBox
						IsChecked="{Binding UseCyrillicInput, Source={x:Reference Root}, Mode=TwoWay}"
						IsEnabled="True"
						VerticalOptions="Center"
						Color="{StaticResource SidebarActiveBg}" />
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="Кирилица"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
				</HorizontalStackLayout>

				<!--  Копчиња – на иста линија со пребарувањето  -->
				<VerticalStackLayout
					x:Name="ActionLayout"
					Grid.Row="0"
					Grid.Column="3"
					Margin="0,0,0,0"
					Spacing="4"
					VerticalOptions="Start">
					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}" Spacing="10">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="sc:SparkButtonItem">
								<sc:FFButton
									ButtonKind="Secondary"
									Command="{Binding Command}"
									CommandParameter="{Binding CommandParameter}"
									ContentPadding="18,0"
									CornerRadius="8"
									HeightRequestEx="38"
									IsEnabled="{Binding IsEnabled}"
									Text="{Binding Label}"
									WidthRequestEx="0">
									<sc:FFButton.Triggers>
										<DataTrigger
											Binding="{Binding IsPrimary}"
											TargetType="sc:FFButton"
											Value="True">
											<Setter Property="ButtonKind" Value="Primary" />
										</DataTrigger>
									</sc:FFButton.Triggers>
								</sc:FFButton>
							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</HorizontalStackLayout>
				</VerticalStackLayout>


				<!-- Conditional filters (for example, the medicine picker) stay inline beside search. -->
				<FlexLayout
					x:Name="InlinePickerLayout"
					Grid.Row="0"
					Grid.Column="1"
					AlignItems="Center"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Direction="Row"
					JustifyContent="Start"
					Wrap="NoWrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<HorizontalStackLayout
								Margin="0,0,8,0"
								IsVisible="{Binding IsInlineVisible}"
								Spacing="6"
								VerticalOptions="Center">
								<sc:FFPicker
									IsVisible="{Binding IsPicker}"
									ItemsSource="{Binding Items}"
									Label="{Binding Placeholder}"
									MinimumWidthRequest="150"
									SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
								<sc:FFDatePicker
									IsVisible="{Binding IsDatePicker}"
									Label="{Binding Placeholder}"
									SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
								<HorizontalStackLayout
									IsVisible="{Binding IsCheckBox}"
									Spacing="3"
									VerticalOptions="Center">
									<CheckBox
										IsChecked="{Binding IsChecked, Mode=TwoWay}"
										IsEnabled="{Binding IsEnabled}"
										VerticalOptions="Center"
										Color="{StaticResource Gray500}" />
									<Label
										FontSize="12"
										Text="{Binding Placeholder}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</HorizontalStackLayout>
							</HorizontalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>

				<!--  Pickers (Статус / Град / Реуматолог / Дијагноза / Пол…) – wrap grid како на огласник  -->
				<FlexLayout
					x:Name="PickerLayout"
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					AlignItems="Start"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Direction="Row"
					JustifyContent="Start"
					Wrap="Wrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<Grid
								Margin="0,0,8,8"
								FlexLayout.Basis="20%"
								FlexLayout.Grow="0"
								IsVisible="{Binding IsFilterRowVisible}"
								MinimumWidthRequest="112">
								<sc:FFPicker
									HorizontalOptions="Fill"
									IsVisible="{Binding IsPicker}"
									ItemsSource="{Binding Items}"
									Label="{Binding Placeholder}"
									MinimumWidthRequest="0"
									SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
								<sc:FFDatePicker
									IsVisible="{Binding IsDatePicker}"
									Label="{Binding Placeholder}"
									SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
								<VerticalStackLayout
									IsVisible="{Binding IsCheckBox}"
									Spacing="2"
									VerticalOptions="Start">
									<Label
										FontSize="12"
										Text="{Binding Placeholder}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
									<CheckBox
										HorizontalOptions="Start"
										IsChecked="{Binding IsChecked, Mode=TwoWay}"
										IsEnabled="{Binding IsEnabled}"
										VerticalOptions="Center"
										Color="{StaticResource Gray500}" />
								</VerticalStackLayout>
							</Grid>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>
			</Grid>
			<BoxView
				BackgroundColor="{StaticResource Transparent}"
				HeightRequest="10"
				VerticalOptions="End" />
		</Grid>
	</VerticalStackLayout>

</ContentView>