<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.SparkExplorerHeaderView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root"
	SizeChanged="OnHeaderSizeChanged"
	ZIndex="100">

	<!--
		Ред 1: Пребарување (зафаќа сè што остана) | Inline филтри | Копчиња
		Ред 2: Pickers во wrap-grid
		Сите x:Name, bindings и event handlers се зачувани (освен Кирилица, која е отстранета).
	-->

	<VerticalStackLayout
		Padding="0"
		BackgroundColor="Transparent"
		Spacing="0">

		<Grid BackgroundColor="Transparent" IsVisible="{Binding SearchVisible, Source={x:Reference Root}}">

			<Grid
				x:Name="SecondaryToolbarGrid"
				Padding="4"
				ColumnDefinitions="*,Auto,Auto"
				ColumnSpacing="12"
				MinimumHeightRequest="0"
				MinimumWidthRequest="0"
				RowDefinitions="Auto,Auto"
				RowSpacing="4">

				<!--  ═══ ПРЕБАРУВАЊЕ: star колона, се шири до копчињата ═══  -->
				<VerticalStackLayout
					Grid.Row="0"
					Grid.Column="0"
					HorizontalOptions="Fill"
					MinimumWidthRequest="0"
					Spacing="4"
					VerticalOptions="Start">

					<sc:FFSearchBox
						x:Name="HeaderSearchBox"
						HorizontalOptions="Start"
						Label=""
						MinimumWidthRequest="0"
						Placeholder="{Binding SearchPlaceholder, Source={x:Reference Root}}"
						SearchCommand="{Binding SearchCommand, Source={x:Reference Root}}"
						Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
						VerticalOptions="Start"
						WidthRequest="600" />

					<!--  Предлози  -->
					<Border
						Padding="4"
						BackgroundColor="White"
						HorizontalOptions="Fill"
						IsVisible="{Binding ShowSuggestions, Source={x:Reference Root}}"
						Stroke="{StaticResource SparkBorderSubtle}"
						StrokeShape="RoundRectangle 10"
						StrokeThickness="1">
						<Grid ColumnDefinitions="*,12" ColumnSpacing="4">
							<CollectionView
								x:Name="SuggestionList"
								Grid.Column="0"
								HeightRequest="164"
								ItemTemplate="{Binding SuggestionTemplate, Source={x:Reference Root}}"
								ItemsSource="{Binding Suggestions, Source={x:Reference Root}}"
								Scrolled="OnSuggestionListScrolled"
								SelectedItem="{Binding SelectedSuggestion, Source={x:Reference Root}, Mode=TwoWay}"
								SelectionMode="Single"
								VerticalScrollBarVisibility="Never" />
							<Border
								x:Name="SuggestionScrollRail"
								Grid.Column="1"
								Margin="2,4"
								BackgroundColor="#E2E8F0"
								StrokeThickness="0">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="4" />
								</Border.StrokeShape>
								<Border
									x:Name="SuggestionScrollThumb"
									BackgroundColor="{StaticResource SidebarActiveBg}"
									HeightRequest="38"
									StrokeThickness="0"
									VerticalOptions="Start">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="4" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<PanGestureRecognizer PanUpdated="OnSuggestionThumbPanUpdated" />
									</Border.GestureRecognizers>
								</Border>
							</Border>
						</Grid>
					</Border>
				</VerticalStackLayout>

				<!--  ═══ INLINE ФИЛТРИ (само кога постојат) ═══  -->
				<FlexLayout
					x:Name="InlinePickerLayout"
					Grid.Row="0"
					Grid.Column="1"
					AlignItems="End"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Direction="Row"
					JustifyContent="Start"
					VerticalOptions="End"
					Wrap="NoWrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<VerticalStackLayout
								Margin="0,0,8,0"
								IsVisible="{Binding IsInlineVisible}"
								VerticalOptions="End">
								<sc:FFPicker
									IsVisible="{Binding IsPicker}"
									ItemsSource="{Binding Items}"
									Label="{Binding Placeholder}"
									MinimumWidthRequest="150"
									SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
								<sc:FFDatePicker
									IsVisible="{Binding IsDatePicker}"
									Label="{Binding Placeholder}"
									SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
								<VerticalStackLayout
									IsVisible="{Binding IsCheckBox}"
									Spacing="2"
									VerticalOptions="End">
									<Label
										FontSize="12"
										Text="{Binding Placeholder}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<CheckBox
										Margin="0"
										HorizontalOptions="Start"
										IsChecked="{Binding IsChecked, Mode=TwoWay}"
										IsEnabled="{Binding IsEnabled}"
										Color="{StaticResource Gray500}" />
								</VerticalStackLayout>
							</VerticalStackLayout>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>

				<!--  ═══ КОПЧИЊА: Auto колона, најдесно ═══  -->
				<VerticalStackLayout
					x:Name="ActionLayout"
					Grid.Row="0"
					Grid.Column="2"
					Spacing="4"
					VerticalOptions="End">
					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}" Spacing="10">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="sc:SparkButtonItem">
								<sc:FFButton
									ButtonKind="Secondary"
									Command="{Binding Command}"
									CommandParameter="{Binding CommandParameter}"
									ContentPadding="18,0"
									CornerRadius="8"
									HeightRequestEx="38"
									IsEnabled="{Binding IsEnabled}"
									Text="{Binding Label}"
									WidthRequestEx="0">
									<sc:FFButton.Triggers>
										<DataTrigger
											Binding="{Binding IsPrimary}"
											TargetType="sc:FFButton"
											Value="True">
											<Setter Property="ButtonKind" Value="Primary" />
										</DataTrigger>
									</sc:FFButton.Triggers>
								</sc:FFButton>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
				</VerticalStackLayout>

				<!--  ═══ РЕД 2: Pickers (wrap) ═══  -->
				<FlexLayout
					x:Name="PickerLayout"
					Grid.Row="1"
					Grid.Column="0"
					Grid.ColumnSpan="3"
					AlignItems="Start"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Direction="Row"
					JustifyContent="Start"
					Wrap="Wrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<Grid
								Margin="0,0,8,8"
								FlexLayout.Basis="20%"
								FlexLayout.Grow="0"
								IsVisible="{Binding IsFilterRowVisible}"
								MinimumWidthRequest="112">
								<sc:FFPicker
									HorizontalOptions="Fill"
									IsVisible="{Binding IsPicker}"
									ItemsSource="{Binding Items}"
									Label="{Binding Placeholder}"
									MinimumWidthRequest="0"
									SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
								<sc:FFDatePicker
									IsVisible="{Binding IsDatePicker}"
									Label="{Binding Placeholder}"
									SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
								<VerticalStackLayout
									IsVisible="{Binding IsCheckBox}"
									Spacing="2"
									VerticalOptions="Start">
									<Label
										FontSize="12"
										Text="{Binding Placeholder}"
										TextColor="{StaticResource SparkTextPrimary}" />
									<CheckBox
										HorizontalOptions="Start"
										IsChecked="{Binding IsChecked, Mode=TwoWay}"
										IsEnabled="{Binding IsEnabled}"
										Color="{StaticResource Gray500}" />
								</VerticalStackLayout>
							</Grid>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>
			</Grid>

			<BoxView
				BackgroundColor="{StaticResource Transparent}"
				HeightRequest="10"
				InputTransparent="True"
				VerticalOptions="End" />
		</Grid>
	</VerticalStackLayout>

</ContentView>
