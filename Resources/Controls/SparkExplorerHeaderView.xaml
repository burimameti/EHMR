<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.SparkExplorerHeaderView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root">

	<VerticalStackLayout>

		<!--  ============ ROW 1: TABS + TRAILING ============  -->
		<Grid BackgroundColor="{StaticResource SparkBadgeNeutralBg}">

			<Grid
				x:Name="ExplorerGrid"
				Padding="0"
				ColumnSpacing="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<!--  0: tabs  -->
					<ColumnDefinition Width="1" />
					<!--  1: divider  -->
					<ColumnDefinition Width="*" />
					<!--  2: spacer  -->
					<ColumnDefinition Width="Auto" />
					<!--  3: trailing  -->
				</Grid.ColumnDefinitions>

				<!--  ============ 0: TABS ============  -->
				<ScrollView
					Grid.Column="0"
					HorizontalScrollBarVisibility="Never"
					Orientation="Both">
					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tabs, Source={x:Reference Root}}" Spacing="0">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="sc:SparkTabItem">
								<Grid
									Padding="20,0"
									HeightRequest="56"
									RowDefinitions="*,4"
									WidthRequest="-1">
									<Grid.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
									</Grid.GestureRecognizers>

									<!--  TAB BACKGROUND STATE  -->
									<Grid.Triggers>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Grid"
											Value="True">
											<Setter Property="BackgroundColor" Value="{StaticResource SparkBackgroundAlt}" />
										</DataTrigger>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Grid"
											Value="False">
											<Setter Property="BackgroundColor" Value="{StaticResource SparkButtonSecondaryBg}" />
										</DataTrigger>
									</Grid.Triggers>

									<Label
										Grid.Row="0"
										FontSize="14"
										HorizontalOptions="Center"
										VerticalOptions="Center">
										<Label.FormattedText>
											<FormattedString>
												<Span Text="{Binding Title}" />
												<Span Text=" " />
												<Span Text="{Binding Value, StringFormat='({0})'}" />
											</FormattedString>
										</Label.FormattedText>
										<!--
											FIX: unselected branch previously bound TextColor to
											SparkBackground — the same color as the strip itself —
											so unselected tab labels rendered invisible. Swapped
											to the existing SparkTextSecondary token, no new
											resource added.
										-->
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsSelected}"
												TargetType="Label"
												Value="True">
												<Setter Property="TextColor" Value="{StaticResource SparkAccentTeal}" />
												<Setter Property="FontAttributes" Value="Bold" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsSelected}"
												TargetType="Label"
												Value="False">
												<Setter Property="TextColor" Value="{StaticResource White}" />
												<Setter Property="FontAttributes" Value="None" />
											</DataTrigger>
										</Label.Triggers>
									</Label>

									<BoxView Grid.Row="1" HorizontalOptions="Fill">
										<BoxView.Triggers>
											<DataTrigger
												Binding="{Binding IsSelected}"
												TargetType="BoxView"
												Value="True">
												<Setter Property="Color" Value="{StaticResource SparkAccentTeal}" />
											</DataTrigger>
										</BoxView.Triggers>
									</BoxView>
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
				</ScrollView>

				<!--  ============ 1: DIVIDER ============  -->
				<BoxView
					Grid.Column="1"
					BackgroundColor="{StaticResource SparkBorder}"
					WidthRequest="1" />

				<!--  ============ 2: SPACER ============  -->
				<!--  intentionally empty — pushes trailing action to the right edge  -->

				<!--  ============ 3: TRAILING ACTION ============  -->
				<Border
					Grid.Column="3"
					BackgroundColor="{StaticResource SparkButtonSecondaryBg}"
					HeightRequest="34"
					IsVisible="{Binding TrailingButton, Source={x:Reference Root}, Converter={StaticResource SparkNotNullConverter}}"
					StrokeThickness="0"
					VerticalOptions="Center"
					WidthRequest="34">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="6" />
					</Border.StrokeShape>
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding TrailingButton.Command, Source={x:Reference Root}}" CommandParameter="{Binding TrailingButton.CommandParameter, Source={x:Reference Root}}" />
					</Border.GestureRecognizers>
					<Path
						Aspect="Uniform"
						Data="{Binding TrailingButton.IconGlyph, Source={x:Reference Root}}"
						HeightRequest="14"
						HorizontalOptions="Center"
						Stroke="White"
						StrokeThickness="1.4"
						VerticalOptions="Center"
						WidthRequest="14" />
				</Border>
			</Grid>

			<!--
				Bottom rule: MAUI Border.StrokeThickness is a single double, it
				can't express a per-side "0,0,0,1" the way WPF/Avalonia
				Thickness can. A 1px BoxView pinned to the bottom edge is the
				direct MAUI equivalent, colored with the same SparkBorder
				token already used for the column-1 divider above.
			-->
			<BoxView
				BackgroundColor="{StaticResource SparkBorder}"
				HeightRequest="1"
				VerticalOptions="End" />
		</Grid>

		<!--  ============ ROW 2: SEARCH + BUTTONS + PICKERS ============  -->
		<Grid BackgroundColor="{StaticResource SparkBackground}">

			<Grid
				x:Name="SecondaryToolbarGrid"
				Padding="20,12"
				ColumnSpacing="8"
				MinimumHeightRequest="48">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<!--  0: search  -->
					<ColumnDefinition Width="Auto" />
					<!--  1: pickers  -->
					<ColumnDefinition Width="Auto" />
					<!--  2: buttons  -->
				</Grid.ColumnDefinitions>

				<!--  ============ 0: SEARCH ============  -->
				<Border
					Grid.Column="0"
					Margin="8,42,8,8"
					Padding="16,0"
					BackgroundColor="White"
					HeightRequest="38"
					HorizontalOptions="Fill"
					Stroke="{StaticResource SparkBorder}"
					StrokeThickness="1">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="6" />
					</Border.StrokeShape>
					<Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
						<HorizontalStackLayout
							Grid.Column="0"
							Spacing="4"
							VerticalOptions="Center">
							<Path
								Data="M9,2 A7,7 0 1 0 9,16 A7,7 0 1 0 9,2 Z M14,14 L20,20"
								HeightRequest="24"
								Stroke="{StaticResource SparkTextSecondary}"
								StrokeThickness="1.9"
								WidthRequest="24" />
							<Path
								Data="M0,0 L8,0 L4,6 Z"
								Fill="{StaticResource SparkTextSecondary}"
								HeightRequest="22"
								WidthRequest="22" />
						</HorizontalStackLayout>
						<!--
							FIX: the original fixed MinimumWidthRequest="500" sat
							inside a "*"-width grid column — on a narrower content
							pane that hard floor could force the whole toolbar to
							overflow horizontally. HorizontalOptions="Fill" lets
							the entry size to whatever room row 2 actually has,
							same visual result at normal widths, no overflow risk
							at smaller ones.
						-->
						<Entry
							Grid.Column="2"
							BackgroundColor="Transparent"
							FontSize="14"
							HeightRequest="38"
							HorizontalOptions="Fill"
							Placeholder="{Binding SearchPlaceholder, Source={x:Reference Root}}"
							Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />
						<Border
							Grid.Column="1"
							Padding="0"
							Stroke="{StaticResource SparkBorder}"
							StrokeThickness="1"
							VerticalOptions="Center"
							WidthRequest="18">
							<Border.StrokeShape>
								<RoundRectangle CornerRadius="9" />
							</Border.StrokeShape>
							<Label
								FontSize="11"
								HorizontalTextAlignment="Center"
								Text="?"
								TextColor="{StaticResource SparkTextSecondary}"
								VerticalTextAlignment="Center" />
						</Border>
					</Grid>
				</Border>

				<!--  ============ 1: PICKERS ============  -->
				<!--  ============ 1: PICKERS ============  -->
				<HorizontalStackLayout
					Grid.Column="1"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Spacing="8"
					VerticalOptions="Center">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<VerticalStackLayout MinimumWidthRequest="140" Spacing="20">
								<Label
									Grid.Row="0"
									FontSize="12"
									HorizontalOptions="Center"
									LineBreakMode="NoWrap"
									Text="{Binding Placeholder}"
									TextColor="{StaticResource SparkAccentTeal}" />
								<Border
									Padding="12,1"
									BackgroundColor="White"
									HeightRequest="40"
									Stroke="{StaticResource SparkBorder}"
									StrokeThickness="1">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="8" />
									</Border.StrokeShape>
									<Picker
										Grid.Row="1"
										Margin="1,0,0,0"
										FontSize="13"
										HeightRequest="36"
										HorizontalTextAlignment="Center"
										ItemsSource="{Binding Items}"
										SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
								</Border>
							</VerticalStackLayout>





						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>

				<!--  ============ 2: BUTTONS ============  -->
				<HorizontalStackLayout
					Grid.Column="2"
					Margin="10,36,8,8"
					BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}"
					Spacing="8"
					VerticalOptions="Center">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkButtonItem">
							<Border
								Padding="22,0"
								HeightRequest="36"
								StrokeThickness="0">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="12" />
								</Border.StrokeShape>
								<Border.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
								</Border.GestureRecognizers>
								<!--
									FIX: both IsPrimary branches previously set the SAME
									BackgroundColor (SparkAccentTeal), so the trigger did
									nothing — every button looked identical regardless of
									intent. False now uses the existing SparkButtonSecondaryBg
									token (same one already used for the trailing action
									button above), matching the pattern already established
									elsewhere in this file rather than inventing anything new.
								-->
								<Border.Triggers>
									<DataTrigger
										Binding="{Binding IsPrimary}"
										TargetType="Border"
										Value="True">
										<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding IsPrimary}"
										TargetType="Border"
										Value="False">
										<Setter Property="BackgroundColor" Value="{StaticResource SparkButtonSecondaryBg}" />
									</DataTrigger>
								</Border.Triggers>
								<HorizontalStackLayout
									HorizontalOptions="Center"
									Spacing="6"
									VerticalOptions="Center">
									<Path
										Aspect="Uniform"
										Data="{Binding IconGlyph}"
										HeightRequest="12"
										IsVisible="{Binding IconGlyph, Converter={StaticResource SparkStringNotEmptyConverter}}"
										StrokeThickness="1.4"
										WidthRequest="12">
										<Path.Triggers>
											<DataTrigger
												Binding="{Binding IsPrimary}"
												TargetType="Path"
												Value="True">
												<Setter Property="Stroke" Value="White" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsPrimary}"
												TargetType="Path"
												Value="False">
												<Setter Property="Stroke" Value="{StaticResource SparkTextSecondary}" />
											</DataTrigger>
										</Path.Triggers>
									</Path>
									<Label
										FontAttributes="Bold"
										FontSize="15"
										Text="{Binding Label}"
										VerticalOptions="Center">
										<!--
											Label text now follows the same IsPrimary split as the
											background — was hardcoded White before, which is
											correct on the accent-filled primary button but
											invisible on the light SparkButtonSecondaryBg one.
										-->
										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsPrimary}"
												TargetType="Label"
												Value="True">
												<Setter Property="TextColor" Value="White" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsPrimary}"
												TargetType="Label"
												Value="False">
												<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</HorizontalStackLayout>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>

			</Grid>

			<!--  bottom rule — same BoxView stand-in as row 1, same SparkBorder token  -->
			<BoxView
				BackgroundColor="{StaticResource SparkBorder}"
				HeightRequest="1"
				VerticalOptions="End" />
		</Grid>

		<!--  ============ ROW 3: DATA GRID HEADER COLUMNS ============  -->
		<Grid
			x:Name="DataGridHeaderGrid"
			Padding="16,10"
			BackgroundColor="{StaticResource SparkBackground}"
			ColumnSpacing="8"
			IsVisible="{Binding HeaderColumns, Source={x:Reference Root}, Converter={StaticResource SparkCollectionNotEmptyConverter}}" />

	</VerticalStackLayout>
</ContentView>
