<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.SparkExplorerHeaderView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root"
	HorizontalOptions="Fill"
	ZIndex="100">

	<VerticalStackLayout
		Margin="0"
		BackgroundColor="{StaticResource Transparent}"
		Spacing="8">

		<!--  ============ ROW 1: TABS (wrap instead of overflow) ============  -->
		<Border
			BackgroundColor="Transparent"
			IsVisible="{Binding TabsVisible, Source={x:Reference Root}}"
			StrokeShape="RoundRectangle 0">

			<Grid
				x:Name="ExplorerGrid"
				Padding="0,0,6,1"
				RowDefinitions="Auto,1"
				RowSpacing="6">

				<FlexLayout
					Grid.Row="0"
					AlignContent="Start"
					AlignItems="Center"
					BindableLayout.ItemsSource="{Binding Tabs, Source={x:Reference Root}}"
					Direction="Row"
					JustifyContent="Start"
					Wrap="Wrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkTabItem">
							<Border
								Margin="0,0,10,8"
								Padding="16,10"
								HeightRequest="44"
								StrokeThickness="1">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="6" />
								</Border.StrokeShape>
								<Border.GestureRecognizers>
									<TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
								</Border.GestureRecognizers>

								<!--  TAB STATE: background + border  -->
								<Border.Triggers>
									<DataTrigger
										Binding="{Binding IsSelected}"
										TargetType="Border"
										Value="True">
										<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBgSelected}" />
										<Setter Property="Stroke" Value="{StaticResource SidebarActiveBg}" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding IsSelected}"
										TargetType="Border"
										Value="False">
										<Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
										<Setter Property="Stroke" Value="{StaticResource White}" />
									</DataTrigger>
								</Border.Triggers>

								<Label
									FontSize="14"
									HorizontalOptions="Center"
									LineBreakMode="TailTruncation"
									VerticalOptions="Center">
									<Label.FormattedText>
										<FormattedString>
											<Span Text="{Binding Title}" />
											<Span Text=" " />
											<Span Text="{Binding Value, StringFormat='({0})'}" />
										</FormattedString>
									</Label.FormattedText>

									<Label.Triggers>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Label"
											Value="True">
											<Setter Property="TextColor" Value="{StaticResource White}" />
											<Setter Property="FontAttributes" Value="Bold" />
										</DataTrigger>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Label"
											Value="False">
											<Setter Property="TextColor" Value="{StaticResource White}" />
											<Setter Property="FontAttributes" Value="None" />
										</DataTrigger>
									</Label.Triggers>
								</Label>
							</Border>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>

				<!--  DIVIDER: now a full-width line under the tabs  -->
				<BoxView
					Grid.Row="1"
					BackgroundColor="{StaticResource SidebarActiveBg}"
					HeightRequest="1"
					HorizontalOptions="Fill" />
			</Grid>
		</Border>

		<!--  ============ ROW 2: SEARCH + FILTERS + BUTTONS (wrap) ============  -->
		<Grid BackgroundColor="Transparent" IsVisible="{Binding SearchVisible, Source={x:Reference Root}}">

			<FlexLayout
				x:Name="SecondaryToolbarGrid"
				Padding="10"
				AlignContent="Start"
				AlignItems="Start"
				Direction="Row"
				JustifyContent="Start"
				MinimumHeightRequest="64"
				Wrap="Wrap">

				<!--  SEARCH: wants 280, grows to fill the row, wraps to its own line when narrow  -->
				<VerticalStackLayout
					Margin="0,0,10,8"
					FlexLayout.Basis="280"
					FlexLayout.Grow="1"
					FlexLayout.Shrink="1"
					Spacing="4">
					<sc:FFSearchBox
						Label="Пребарување"
						Placeholder="{Binding SearchPlaceholder, Source={x:Reference Root}}"
						SearchCommand="{Binding SearchCommand, Source={x:Reference Root}}"
						Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}" />

					<Border
						Padding="4"
						BackgroundColor="White"
						IsVisible="{Binding ShowSuggestions, Source={x:Reference Root}}"
						Stroke="{StaticResource SparkBorderSubtle}"
						StrokeShape="RoundRectangle 8"
						StrokeThickness="1">
						<Grid ColumnDefinitions="*,12" ColumnSpacing="4">
							<CollectionView
								x:Name="SuggestionList"
								Grid.Column="0"
								HeightRequest="164"
								ItemTemplate="{Binding SuggestionTemplate, Source={x:Reference Root}}"
								ItemsSource="{Binding Suggestions, Source={x:Reference Root}}"
								Scrolled="OnSuggestionListScrolled"
								SelectedItem="{Binding SelectedSuggestion, Source={x:Reference Root}, Mode=TwoWay}"
								SelectionMode="Single"
								VerticalScrollBarVisibility="Never" />
							<Border
								x:Name="SuggestionScrollRail"
								Grid.Column="1"
								Margin="2,4"
								BackgroundColor="#E2E8F0"
								StrokeThickness="0">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="4" />
								</Border.StrokeShape>
								<Border
									x:Name="SuggestionScrollThumb"
									BackgroundColor="{StaticResource SidebarActiveBg}"
									HeightRequest="38"
									StrokeThickness="0"
									VerticalOptions="Start">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="4" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<PanGestureRecognizer PanUpdated="OnSuggestionThumbPanUpdated" />
									</Border.GestureRecognizers>
								</Border>
							</Border>
						</Grid>
					</Border>
				</VerticalStackLayout>

				<!--  CYRILLIC TOGGLE: no more negative-margin hacks  -->
				<HorizontalStackLayout
					Margin="0,22,10,8"
					IsVisible="{Binding ShowCyrillicToggle, Source={x:Reference Root}}"
					Spacing="4"
					VerticalOptions="Start">
					<CheckBox
						IsChecked="{Binding UseCyrillicInput, Source={x:Reference Root}, Mode=TwoWay}"
						VerticalOptions="Center"
						Color="{StaticResource SidebarActiveBg}" />
					<Label
						FontSize="12"
						Text="Кирилица"
						TextColor="{StaticResource SparkTextSecondary}"
						VerticalOptions="Center" />
				</HorizontalStackLayout>

				<!--  PICKERS: each one wraps on its own instead of running off the right edge  -->
				<FlexLayout
					AlignItems="Start"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Direction="Row"
					Wrap="Wrap">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<sc:FFPicker
								Margin="0,0,8,8"
								ItemsSource="{Binding Items}"
								Label="{Binding Placeholder}"
								MinimumWidthRequest="88"
								SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</FlexLayout>

				<!--  ACTION BUTTONS  -->
				<VerticalStackLayout Margin="0,0,0,8" Spacing="4">
					<Label
						FontSize="11"
						HorizontalOptions="Start"
						Text="Акции"
						TextColor="{StaticResource SparkTextSecondary}" />
					<FlexLayout
						BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}"
						Direction="Row"
						Wrap="Wrap">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="sc:SparkButtonItem">
								<sc:FFButton
									Margin="0,0,8,0"
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									Command="{Binding Command}"
									CommandParameter="{Binding CommandParameter}"
									ContentPadding="16,0"
									CornerRadius="6"
									HeightRequestEx="44"
									Text="{Binding Label}"
									TextColorEx="White"
									WidthRequestEx="88" />
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</FlexLayout>
				</VerticalStackLayout>
			</FlexLayout>

			<BoxView
				BackgroundColor="{StaticResource Transparent}"
				HeightRequest="10"
				VerticalOptions="End" />
		</Grid>
	</VerticalStackLayout>

</ContentView>