<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.SparkExplorerHeaderView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:sc="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root"
	ZIndex="100">

	<VerticalStackLayout
		Margin="0"
		BackgroundColor="White"
		Spacing="8">

		<!--  ============ ROW 1: TABS + TRAILING ============  -->
		<Border
			BackgroundColor="Transparent"
			IsVisible="{Binding TabsVisible, Source={x:Reference Root}}"
			StrokeShape="RoundRectangle 0">

			<Grid
				x:Name="ExplorerGrid"
				Padding="0,0,6,1"
				ColumnSpacing="0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<!--  0: tabs  -->
					<ColumnDefinition Width="1" />
					<!--  1: divider (once, after all tabs)  -->
					<ColumnDefinition Width="*" />
					<!--  2: spacer  -->
					<ColumnDefinition Width="Auto" />
					<!--  3: trailing  -->
				</Grid.ColumnDefinitions>

				<!--  ============ 0: TABS ============  -->
				<ScrollView
					Grid.Column="0"
					HorizontalScrollBarVisibility="Never"
					Orientation="Both">
					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding Tabs, Source={x:Reference Root}}" Spacing="10">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="sc:SparkTabItem">

								<Border
									Padding="16,10"
									HeightRequest="44"
									StrokeThickness="1">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="6" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Command}" CommandParameter="{Binding CommandParameter}" />
									</Border.GestureRecognizers>

									<!--  TAB STATE: background + border  -->
									<Border.Triggers>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Border"
											Value="True">
											<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBgSelected}" />
											<Setter Property="Stroke" Value="{StaticResource SidebarActiveBg}" />
										</DataTrigger>
										<DataTrigger
											Binding="{Binding IsSelected}"
											TargetType="Border"
											Value="False">
											<Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}" />
											<Setter Property="Stroke" Value="{StaticResource White}" />
										</DataTrigger>
									</Border.Triggers>

									<Label
										FontSize="14"
										HorizontalOptions="Center"
										VerticalOptions="Center">
										<Label.FormattedText>
											<FormattedString>
												<Span Text="{Binding Title}" />
												<Span Text=" " />
												<Span Text="{Binding Value, StringFormat='({0})'}" />
											</FormattedString>
										</Label.FormattedText>

										<Label.Triggers>
											<DataTrigger
												Binding="{Binding IsSelected}"
												TargetType="Label"
												Value="True">
												<Setter Property="TextColor" Value="{StaticResource White}" />
												<Setter Property="FontAttributes" Value="Bold" />
											</DataTrigger>
											<DataTrigger
												Binding="{Binding IsSelected}"
												TargetType="Label"
												Value="False">
												<Setter Property="TextColor" Value="{StaticResource White}" />
												<Setter Property="FontAttributes" Value="None" />
											</DataTrigger>
										</Label.Triggers>
									</Label>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
				</ScrollView>

				<!--  ============ 1: DIVIDER (appears once, at the end of the tabs) ============  -->
				<BoxView
					Grid.Column="1"
					Margin="0,0"
					BackgroundColor="{StaticResource SidebarActiveBg}"
					WidthRequest="1" />


			</Grid>


		</Border>

		<!--  ============ ROW 2: SEARCH + FILTERS + BUTTONS ============  -->
		<Grid BackgroundColor="Transparent" IsVisible="{Binding SearchVisible, Source={x:Reference Root}}">
			<Grid
				x:Name="SecondaryToolbarGrid"
				Padding="10"
				ColumnDefinitions="*,Auto,Auto,Auto"
				ColumnSpacing="8"
				MinimumHeightRequest="64">

				<!--  Search uses all remaining horizontal space.  -->
				<VerticalStackLayout Grid.Column="0" Spacing="4">
					<sc:FFSearchBox
						Label="Пребарување"
						Placeholder="{Binding SearchPlaceholder, Source={x:Reference Root}}"
						SearchCommand="{Binding SearchCommand, Source={x:Reference Root}}"
						Text="{Binding SearchText, Source={x:Reference Root}, Mode=TwoWay}" />

					<Border
						Padding="4"
						BackgroundColor="White"
						IsVisible="{Binding ShowSuggestions, Source={x:Reference Root}}"
						Stroke="{StaticResource SparkBorderSubtle}"
						StrokeShape="RoundRectangle 8"
						StrokeThickness="1">
						<Grid ColumnDefinitions="*,12" ColumnSpacing="4">
							<CollectionView
								x:Name="SuggestionList"
								Grid.Column="0"
								HeightRequest="164"
								ItemTemplate="{Binding SuggestionTemplate, Source={x:Reference Root}}"
								ItemsSource="{Binding Suggestions, Source={x:Reference Root}}"
								Scrolled="OnSuggestionListScrolled"
								SelectedItem="{Binding SelectedSuggestion, Source={x:Reference Root}, Mode=TwoWay}"
								SelectionMode="Single"
								VerticalScrollBarVisibility="Never" />
							<Border
								x:Name="SuggestionScrollRail"
								Grid.Column="1"
								Margin="2,4"
								BackgroundColor="#E2E8F0"
								StrokeThickness="0">
								<Border.StrokeShape>
									<RoundRectangle CornerRadius="4" />
								</Border.StrokeShape>
								<Border
									x:Name="SuggestionScrollThumb"
									BackgroundColor="{StaticResource SidebarActiveBg}"
									HeightRequest="38"
									StrokeThickness="0"
									VerticalOptions="Start">
									<Border.StrokeShape>
										<RoundRectangle CornerRadius="4" />
									</Border.StrokeShape>
									<Border.GestureRecognizers>
										<PanGestureRecognizer PanUpdated="OnSuggestionThumbPanUpdated" />
									</Border.GestureRecognizers>
								</Border>
							</Border>
						</Grid>
					</Border>
				</VerticalStackLayout>
				<HorizontalStackLayout
					Grid.Column="1"
					IsVisible="{Binding ShowCyrillicToggle, Source={x:Reference Root}}"
					Spacing="4"
					VerticalOptions="Start"
					WidthRequest="100">
					<Label
						Margin="0,0,-18,0"
						FontSize="12"
						HorizontalOptions="Start"
						Text="Кирилица"
						TextColor="{StaticResource SparkTextSecondary}" />
					<Border
						Margin="-28,22,0,0"
						Padding="0"
						BackgroundColor="{StaticResource Transparent}"
						Stroke="Transparent"
						StrokeThickness="1">
						<CheckBox
							HorizontalOptions="Start"
							IsChecked="{Binding UseCyrillicInput, Source={x:Reference Root}, Mode=TwoWay}"
							IsEnabled="True"
							VerticalOptions="Center"
							Color="{StaticResource SidebarActiveBg}" />
					</Border>
				</HorizontalStackLayout>
				<HorizontalStackLayout
					Grid.Column="2"
					BindableLayout.ItemsSource="{Binding Pickers, Source={x:Reference Root}}"
					Spacing="8"
					VerticalOptions="Start">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="sc:SparkPickerItem">
							<sc:FFPicker
								ItemsSource="{Binding Items}"
								Label="{Binding Placeholder}"
								MinimumWidthRequest="140"
								SelectedItem="{Binding SelectedItem, Mode=TwoWay}" />
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</HorizontalStackLayout>

				<VerticalStackLayout
					Grid.Column="3"
					Spacing="4"
					VerticalOptions="Start">
					<Label
						FontSize="11"
						HorizontalOptions="Center"
						Text="Акции"
						TextColor="{StaticResource SparkTextSecondary}" />
					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding Buttons, Source={x:Reference Root}}" Spacing="8">

						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="sc:SparkButtonItem">
								<sc:FFButton
									BackgroundColorEx="{StaticResource SidebarActiveBg}"
									Command="{Binding Command}"
									CommandParameter="{Binding CommandParameter}"
									ContentPadding="16,0"
									CornerRadius="6"
									HeightRequestEx="44"
									Text="{Binding Label}"
									TextColorEx="White"
									WidthRequestEx="0" />
							</DataTemplate>
						</BindableLayout.ItemTemplate>

					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Grid>
			<BoxView
				BackgroundColor="{StaticResource Transparent}"
				HeightRequest="10"
				VerticalOptions="End" />
		</Grid>
	</VerticalStackLayout>

</ContentView>
