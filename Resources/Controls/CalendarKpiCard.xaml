<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.CalendarKpiCard"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<!--
		KPI картичка над календарот.
		Распоред како во дизајнот: наслов со ⓘ, период под него,
		па голем број со значка за промена во истиот ред.
	-->
	<!--  Потенка од порано: помал внатрешен простор, за да не зема висина од гридот.  -->
	<Border
		Padding="14,10"
		BackgroundColor="{StaticResource SparkBackground}"
		Stroke="{StaticResource SparkBorder}"
		StrokeShape="RoundRectangle 8"
		StrokeThickness="1">
		<Border.GestureRecognizers>
			<TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}" CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
		</Border.GestureRecognizers>

		<VerticalStackLayout Spacing="1">

			<HorizontalStackLayout Spacing="5">
				<Label
					FontSize="11"
					Text="{Binding Title, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextSecondary}" />
				<Label
					FontSize="10"
					Text="ⓘ"
					TextColor="{StaticResource SparkTextMuted}"
					VerticalOptions="Center" />
			</HorizontalStackLayout>

			<Label
				FontSize="9"
				Text="{Binding PeriodText, Source={x:Reference Root}}"
				TextColor="{StaticResource SparkTextSecondary}" />

			<Grid
				Margin="0,4,0,0"
				ColumnDefinitions="Auto,Auto,*"
				ColumnSpacing="8">
				<Label
					FontAttributes="Bold"
					FontSize="21"
					Text="{Binding Value, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextPrimary}"
					VerticalOptions="Center" />

				<Border
					Grid.Column="1"
					Padding="7,3"
					BackgroundColor="{Binding DeltaBackground, Source={x:Reference Root}}"
					IsVisible="{Binding HasDelta, Source={x:Reference Root}}"
					StrokeShape="RoundRectangle 8"
					StrokeThickness="0"
					VerticalOptions="Center">
					<Label
						FontAttributes="Bold"
						FontSize="10"
						Text="{Binding DeltaText, Source={x:Reference Root}}"
						TextColor="{Binding DeltaForeground, Source={x:Reference Root}}" />
				</Border>

				<Label
					Grid.Column="2"
					FontSize="10"
					IsVisible="{Binding HasDelta, Source={x:Reference Root}}"
					Text="{Binding ComparisonText, Source={x:Reference Root}}"
					TextColor="#94A3B8"
					VerticalOptions="Center" />
			</Grid>
		</VerticalStackLayout>
	</Border>
</ContentView>
