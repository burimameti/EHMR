<?xml version="1.0" encoding="utf-8" ?>

<ContentView
	x:Class="EHMR.Resources.Controls.FFShell"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Grid ColumnDefinitions="224,*" RowDefinitions="56,*">

		<Border Grid.RowSpan="2" Style="{StaticResource FFShellSidebarStyle}">
			<VerticalStackLayout Spacing="4">
				<Label Style="{StaticResource FFShellBrandStyle}" Text="{Binding AppTitle, Source={x:Reference Root}}" />

				<CollectionView ItemsSource="{Binding MenuItems, Source={x:Reference Root}}">
					<CollectionView.ItemTemplate>
						<DataTemplate>
							<Button
								Command="{Binding NavigateCommand}"
								CommandParameter="{Binding Route}"
								Style="{StaticResource FFShellMenuButtonStyle}"
								Text="{Binding Title}" />
						</DataTemplate>
					</CollectionView.ItemTemplate>
				</CollectionView>
			</VerticalStackLayout>
		</Border>

		<Border Grid.Column="1" Style="{StaticResource FFShellTopBarStyle}">
			<Grid ColumnDefinitions="*,Auto">
				<SearchBar
					BackgroundColor="Transparent"
					Placeholder="Search..."
					VerticalOptions="Center" />

				<HorizontalStackLayout
					Grid.Column="1"
					Spacing="8"
					VerticalOptions="Center">
					<Label
						Text="{Binding UserName, Source={x:Reference Root}}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
					<Image
						HeightRequest="30"
						Source="user.png"
						WidthRequest="30" />
				</HorizontalStackLayout>
			</Grid>
		</Border>

		<ContentView
			Grid.Row="1"
			Grid.Column="1"
			Content="{Binding ContentView, Source={x:Reference Root}}" />
	</Grid>
</ContentView>