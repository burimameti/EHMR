<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  ============================================================  -->
	<!--  SIDEBAR (Deep Slate / Slate-Blue Theme)  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkSidebarBg">#293441</Color>
	<!--  was #32404D — slightly deeper, reads as "premium dark" not "washed navy"  -->
	<Color x:Key="SparkSidebarBgHover">#333F4D</Color>
	<Color x:Key="SparkSidebarActiveBg">#22B8C6</Color>
	<!--  aligned to the refined accent teal below, was a mismatched #4CC3D9  -->
	<Color x:Key="SparkSidebarText">#96A5B5</Color>
	<Color x:Key="SparkSidebarTextActive">#FFFFFF</Color>
	<Color x:Key="SparkSidebarBorder">#1F2933</Color>

	<!--  ============================================================  -->
	<!--  MAIN SURFACES & CANVAS  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkCanvasBackground">#EEF2F6</Color>
	<!--  Canvas behind the cards  -->
	<Color x:Key="SparkBackground">#FFFFFF</Color>
	<!--  White card surface  -->
	<Color x:Key="SparkBackgroundAlt">#F7F9FC</Color>
	<!--  Alternating rows/nested sections  -->
	<Color x:Key="SparkBorder">#E1E6ED</Color>
	<!--  Hairline borders/dividers  -->

	<!--  ============================================================  -->
	<!--  TYPOGRAPHY  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkTextPrimary">#1E2733</Color>
	<!--  was #2D3748 — darker for crisper headings/labels  -->
	<Color x:Key="SparkTextSecondary">#64748B</Color>
	<!--  Tailwind slate-500, replaces the slightly muddy #718096  -->
	<Color x:Key="SparkTextMuted">#94A3B8</Color>
	<!--  slate-400  -->
	<Color x:Key="SparkLink">#2563EB</Color>
	<!--  cleaner, more standard SaaS link blue than #2F8FE0  -->

	<!--  ============================================================  -->
	<!--  ACCENTS (Vibrant Dashboard Teal)  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkAccentTeal">#0EA5B8</Color>
	<!--  was #21B6C4 — a touch deeper/more saturated, better text contrast on white  -->
	<Color x:Key="SparkAccentTealDark">#0B8494</Color>
	<Color x:Key="SparkAccentTealBg">#E3F6F9</Color>

	<!--  ============================================================  -->
	<!--  BUTTONS & INTERACTIVE ELEMENTS  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkButtonPrimaryBg">#0EA5B8</Color>
	<Color x:Key="SparkButtonPrimaryBgPressed">#0B8494</Color>
	<Color x:Key="SparkButtonPrimaryText">#FFFFFF</Color>

	<Color x:Key="SparkButtonSecondaryBg">#475569</Color>
	<!--  slate-600, was #5B6B79 — cooler, matches sidebar family  -->
	<Color x:Key="SparkButtonSecondaryBgPressed">#334155</Color>
	<Color x:Key="SparkButtonSecondaryBorder">#D6DCE5</Color>
	<Color x:Key="SparkButtonSecondaryText">#FFFFFF</Color>

	<!--  ============================================================  -->
	<!--  TABS CONFIGURATION  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkTabActiveBg">#E3F6F9</Color>
	<Color x:Key="SparkTabActiveBorder">#0EA5B8</Color>
	<Color x:Key="SparkTabActiveText">#0F3B45</Color>
	<Color x:Key="SparkTabInactiveText">#7C8798</Color>
	<Color x:Key="SparkTabHoverBg">#F1F5F8</Color>

	<!--  ============================================================  -->
	<!--  SEMANTIC STATUS & BADGES (muted, enterprise-grade — not candy pastel)  -->
	<!--  ============================================================  -->
	<!--  Success / Low Risk (Green)  -->
	<Color x:Key="SparkStatusSuccessBg">#DCF3E3</Color>
	<Color x:Key="SparkStatusSuccessText">#1B7A3D</Color>
	<Color x:Key="SparkBadgeSuccessBg">#E6F5E9</Color>
	<Color x:Key="SparkBadgeSuccessText">#2E9C55</Color>

	<!--  Warning / Moderate Risk (Amber)  -->
	<Color x:Key="SparkStatusWarningBg">#FBEED2</Color>
	<Color x:Key="SparkStatusWarningText">#96650F</Color>
	<Color x:Key="SparkBadgeWarningBg">#FCF0DC</Color>
	<Color x:Key="SparkBadgeWarningText">#C4901F</Color>

	<!--  Danger / High Risk / Churned (muted rose, less "hot pink" than before)  -->
	<Color x:Key="SparkStatusDangerBg">#FADDE1</Color>
	<Color x:Key="SparkStatusDangerText">#A82940</Color>
	<Color x:Key="SparkBadgeDangerBg">#FBE4E4</Color>
	<Color x:Key="SparkBadgeDangerText">#C24545</Color>

	<!--  Neutral  -->
	<Color x:Key="SparkButtonBg">#E8EBF0</Color>
	<Color x:Key="SparkStatusNeutralBg">#E8EBF0</Color>
	<Color x:Key="SparkStatusNeutralText">#52586B</Color>
	<Color x:Key="SparkBadgeNeutralBg">#EBEFF3</Color>
	<Color x:Key="SparkBadgeNeutralBgSelected">#0EA5B8</Color>
	<Color x:Key="SparkBadgeNeutralText">#556072</Color>
	<Color x:Key="SparkBadgeNeutralTextSelected">#FFFFFF</Color>

	<!--  ============================================================  -->
	<!--  RADIUS SCALE  -->
	<!--  ============================================================  -->
	<x:Double x:Key="SparkRadiusXs">4</x:Double>
	<x:Double x:Key="SparkRadiusSm">6</x:Double>
	<x:Double x:Key="SparkRadiusMd">8</x:Double>
	<x:Double x:Key="SparkRadiusLg">12</x:Double>
	<x:Double x:Key="SparkRadiusXl">16</x:Double>
	<x:Double x:Key="SparkRadiusPill">20</x:Double>

	<!--  ============================================================  -->
	<!--  TYPOGRAPHY METRICS & VECTOR PATH DATA  -->
	<!--  ============================================================  -->
	<x:Double x:Key="SparkFontSizeSmall">12</x:Double>
	<x:Double x:Key="SparkFontSizeNormal">14</x:Double>
	<x:Double x:Key="SparkFontSizeTitle">16</x:Double>

	<x:String x:Key="SparkIconSearchPathData">M9,2 A7,7 0 1,0 9,16 A7,7 0 1,0 9,2 Z M14.2,14.2 L19,19</x:String>
	<x:String x:Key="SparkIconFilterPathData">M2,3 L18,3 L11.5,10.5 L11.5,16 L8.5,17.5 L8.5,10.5 Z</x:String>
	<x:String x:Key="SparkIconChevronDownPathData">M3,6 L10,13 L17,6</x:String>

	<!--  ============================================================  -->
	<!--  STYLES  -->
	<!--  ============================================================  -->
	<Style x:Key="SparkSearchBarStyle" TargetType="SearchBar">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="CancelButtonColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="HeightRequest" Value="32" />
	</Style>

	<Style x:Key="SparkSearchBarFrameStyle" TargetType="Border">
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="6" />
			</Setter.Value>
		</Setter>
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style x:Key="SparkPickerStyle" TargetType="Picker">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="TitleColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="HeightRequest" Value="32" />
	</Style>

	<Style x:Key="SparkPickerFrameStyle" TargetType="Border">
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="6" />
			</Setter.Value>
		</Setter>
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="Padding" Value="8,0" />
		<Setter Property="MinimumWidthRequest" Value="96" />
	</Style>

	<Style x:Key="SparkActionButtonStyle" TargetType="Button">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="BorderColor" Value="{StaticResource SparkButtonSecondaryBorder}" />
		<Setter Property="BorderWidth" Value="1" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsPrimary}"
				TargetType="Button"
				Value="True">
				<Setter Property="BackgroundColor" Value="{StaticResource SparkAccentTeal}" />
				<Setter Property="TextColor" Value="{StaticResource SparkButtonPrimaryText}" />
				<Setter Property="BorderWidth" Value="0" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkIconButtonFrameStyle" TargetType="Border">
		<Setter Property="Stroke" Value="{StaticResource SparkButtonSecondaryBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="WidthRequest" Value="38" />
		<Setter Property="HeightRequest" Value="38" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style x:Key="SparkPagerButtonStyle" TargetType="Button">
		<Setter Property="FontFamily" Value="{x:Null}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="BorderColor" Value="{StaticResource SparkBorder}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="ImageSource" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger TargetType="Button" Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value="0.4" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkPagerLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="SparkTabTitleLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource SparkFontSizeNormal}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource SparkTabInactiveText}" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsSelected}"
				TargetType="Label"
				Value="True">
				<Setter Property="TextColor" Value="{StaticResource SparkTabActiveText}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkTabBadgeFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 8" />
		<Setter Property="Padding" Value="7,2" />
		<Setter Property="Stroke" Value="Transparent" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsSelected}"
				TargetType="Border"
				Value="True">
				<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBgSelected}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkTabBadgeLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource SparkFontSizeSmall}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource SparkBadgeNeutralText}" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsSelected}"
				TargetType="Label"
				Value="True">
				<Setter Property="TextColor" Value="{StaticResource SparkBadgeNeutralTextSelected}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkTabUnderlineStyle" TargetType="BoxView">
		<Setter Property="HeightRequest" Value="2" />
		<Setter Property="Color" Value="Transparent" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsSelected}"
				TargetType="BoxView"
				Value="True">
				<Setter Property="Color" Value="{StaticResource SparkTabActiveBorder}" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkBadgeDangerFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeDangerBg}" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="4" />
			</Setter.Value>
		</Setter>
		<Setter Property="Stroke" Value="Transparent" />
		<Setter Property="Padding" Value="8,3" />
	</Style>

	<Style x:Key="SparkBadgeSuccessFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeSuccessBg}" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="4" />
			</Setter.Value>
		</Setter>
		<Setter Property="Stroke" Value="Transparent" />
		<Setter Property="Padding" Value="8,3" />
	</Style>

	<Style x:Key="SparkBadgeWarningFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeWarningBg}" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="4" />
			</Setter.Value>
		</Setter>
		<Setter Property="Stroke" Value="Transparent" />
		<Setter Property="Padding" Value="8,3" />
	</Style>

	<Style x:Key="SparkBadgeNeutralFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBadgeNeutralBg}" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="4" />
			</Setter.Value>
		</Setter>
		<Setter Property="Stroke" Value="Transparent" />
		<Setter Property="Padding" Value="8,3" />
	</Style>

	<Style x:Key="SparkEntryStyle" TargetType="Entry">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="ClearButtonVisibility" Value="WhileEditing" />
	</Style>

	<Style x:Key="SparkEditorStyle" TargetType="Editor">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="AutoSize" Value="TextChanges" />
	</Style>

	<Style x:Key="SparkDatePickerStyle" TargetType="DatePicker">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="BackgroundColor" Value="Transparent" />
	</Style>

	<Style x:Key="SparkTimePickerStyle" TargetType="TimePicker">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="BackgroundColor" Value="Transparent" />
	</Style>
	<Style x:Key="SparkCardStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackground}" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 0" />
		<Setter Property="Padding" Value="20" />
	</Style>

	<Style x:Key="SectionHeaderStyle" TargetType="Label">
		<Setter Property="FontSize" Value="15" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="Margin" Value="0,0,0,12" />
	</Style>

	<Style x:Key="DisplayBlockStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkBackgroundAlt}" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="Padding" Value="12,10" />
	</Style>

	<Style x:Key="DisplayLabelCaptionStyle" TargetType="Label">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="Margin" Value="0,0,0,2" />
	</Style>

	<Style x:Key="DisplayLabelValueStyle" TargetType="Label">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="FontAttributes" Value="Bold" />
	</Style>
</ResourceDictionary>