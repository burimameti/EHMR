	</Style>

	<Style x:Key="DisplayBlockStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#F8FAFC" />
		<Setter Property="Stroke" Value="#D9E0E5" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="Padding" Value="12,10" />
	</Style>

	<Style x:Key="DisplayLabelCaptionStyle" TargetType="Label">
		<Setter Property="FontSize" Value="11" />
