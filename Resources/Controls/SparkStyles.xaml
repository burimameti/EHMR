<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  ============================================================  -->
	<!--  SIDEBAR (Deep Slate / Slate-Blue Theme)  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkSidebarBg">#202D3D</Color>
	<!--  was #32404D — slightly deeper, reads as "premium dark" not "washed navy"  -->
	<Color x:Key="SparkSidebarBgHover">#2E4257</Color>
	<Color x:Key="SparkSidebarActiveBg">#2AEBE7</Color>
	<!--  aligned to the refined accent teal below, was a mismatched #4CC3D9  -->
	<Color x:Key="SparkSidebarText">#CBD5E1</Color>
	<Color x:Key="SparkSidebarTextActive">#FFFFFF</Color>
	<Color x:Key="SparkSidebarBorder">#1E293B</Color>

	<!--  ============================================================  -->
	<!--  MAIN SURFACES & CANVAS  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkCanvasBackground">#F1F5F9</Color>
	<!--  Canvas behind the cards  -->
	<Color x:Key="SparkBackground">#FFFFFF</Color>
	<!--  White card surface  -->
	<Color x:Key="SparkBackgroundAlt">#F8FAFC</Color>
	<!--  Alternating rows/nested sections  -->
	<Color x:Key="SparkBorder">#D9E0E5</Color>
	<!--  Hairline borders/dividers  -->

	<!--  ============================================================  -->
	<!--  TYPOGRAPHY  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkTextPrimary">#334155</Color>
	<!--  was #2D3748 — darker for crisper headings/labels  -->
	<Color x:Key="SparkTextSecondary">#64748B</Color>
	<!--  Tailwind slate-500, replaces the slightly muddy #718096  -->
	<Color x:Key="SparkTextMuted">#9AA6AD</Color>
	<!--  slate-400  -->
	<Color x:Key="SparkLink">#2AEBE7</Color>
	<!--  cleaner, more standard SaaS link blue than #2F8FE0  -->

	<!--  ============================================================  -->
	<!--  ACCENTS (Vibrant Dashboard Teal)  -->
	<!--  ============================================================  -->
	<!--  SparkAccentTeal tokens live in Colors.xaml so earlier dictionaries can use them.  -->

	<!--  ============================================================  -->
	<!--  BUTTONS & INTERACTIVE ELEMENTS  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkButtonPrimaryBg">#2AEBE7</Color>
	<Color x:Key="SparkButtonPrimaryBgPressed">#0F9693</Color>
	<Color x:Key="SparkButtonPrimaryText">#0F172A</Color>

	<Color x:Key="SparkButtonSecondaryBg">#FFFFFF</Color>
	<!--  slate-600, was #5B6B79 — cooler, matches sidebar family  -->
	<Color x:Key="SparkButtonSecondaryBgPressed">#E2E8F0</Color>
	<Color x:Key="SparkButtonSecondaryBorder">#CBD5E1</Color>
	<Color x:Key="SparkButtonSecondaryText">#334155</Color>

	<!--  ============================================================  -->
	<!--  TABS CONFIGURATION  -->
	<!--  ============================================================  -->
	<Color x:Key="SparkTabActiveBg">#D9FBFA</Color>
	<Color x:Key="SparkTabActiveBorder">#2AEBE7</Color>
	<Color x:Key="SparkTabActiveText">#0F172A</Color>
	<Color x:Key="SparkTabInactiveText">#7C8798</Color>
	<Color x:Key="SparkTabHoverBg">#F1F5F9</Color>

	<!--  ============================================================  -->
	<!--  SEMANTIC STATUS & BADGES (muted, enterprise-grade — not candy pastel)  -->
	<!--  ============================================================  -->
	<!--  Success / Low Risk (Green)  -->
	<Color x:Key="SparkStatusSuccessBg">#DCF3E3</Color>
	<Color x:Key="SparkStatusSuccessText">#1B7A3D</Color>
	<Color x:Key="SparkBadgeSuccessBg">#E6F5E9</Color>
	<Color x:Key="SparkBadgeSuccessText">#2E9C55</Color>

	<!--  Warning / Moderate Risk (Amber)  -->
	<Color x:Key="SparkStatusWarningBg">#FBEED2</Color>
	<Color x:Key="SparkStatusWarningText">#96650F</Color>
	<Color x:Key="SparkBadgeWarningBg">#FCF0DC</Color>
	<Color x:Key="SparkBadgeWarningText">#C4901F</Color>

	<!--  Danger / High Risk / Churned (muted rose, less "hot pink" than before)  -->
	<Color x:Key="SparkStatusDangerBg">#FADDE1</Color>
	<Color x:Key="SparkStatusDangerText">#A82940</Color>
	<Color x:Key="SparkBadgeDangerBg">#FBE4E4</Color>
	<Color x:Key="SparkBadgeDangerText">#C24545</Color>

	<!--  Neutral  -->
	<Color x:Key="SparkButtonBg">#F1F5F9</Color>
	<Color x:Key="SparkStatusNeutralBg">#F1F5F9</Color>
	<Color x:Key="SparkStatusNeutralText">#52586B</Color>
	<Color x:Key="SparkBadgeNeutralBg">#EBEFF3</Color>
	<Color x:Key="SparkBadgeNeutralBgSelected">#2AEBE7</Color>
	<Color x:Key="SparkBadgeNeutralText">#556072</Color>
	<Color x:Key="SparkBadgeNeutralTextSelected">#0F172A</Color>

	<!--
		Danger — овие три се користеа на 5 места (RestorePage, MbkImportExportPage,
		ReportsListPage, двата popup-а) но никаде не беа дефинирани. Нерешен
		StaticResource фрла кога страницата се отвора.
		Вредностите се усогласени со постоечките SparkStatusDanger* / SparkBadgeDanger*.
	-->
	<Color x:Key="SparkDanger">#C0304A</Color>
	<Color x:Key="SparkDangerBg">#FCE3E7</Color>
	<Color x:Key="SparkDangerText">#C0304A</Color>

	<!--
		Површини — исто така се користеа низ повеќе страници без да бидат
		дефинирани (SparkExpandableCardView, TherapyCyclesPage, BackupHistoryPage,
		страницата за дестинации). Врзани се за постоечките еквиваленти.
	-->
	<Color x:Key="SparkSurface">#F8FAFC</Color>
	<Color x:Key="SparkSurfaceAlt">#F8FAFC</Color>
	<Color x:Key="SparkBorderSubtle">#D9E0E5</Color>
	<Color x:Key="SparkOverlay">#80191E29</Color>

	<!--  ============================================================  -->
	<!--
		Ресурси што се користеа низ апликацијата без никаде да бидат
		дефинирани. Нерешен StaticResource фрла XamlParseException штом
		страницата се вчита — FFHeader ја рушеше почетната страна со
		„StaticResource not found for key EhmrIconButton".
	-->
	<!--  ============================================================  -->

	<!--  FFInput, FFDatePickerPage  -->
	<Color x:Key="InputText">#334155</Color>
	<Color x:Key="InputPlaceholder">#9AA6AD</Color>

	<!--  Components\PageHeader.xaml, SearchFilterBarView.xaml  -->
	<Style x:Key="DashboardCard" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Stroke" Value="#D9E0E5" />
		<Setter Property="StrokeShape" Value="RoundRectangle 8" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>

	<Style x:Key="MedicalSectionTitle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="TextColor" Value="#334155" />
	</Style>

	<Style x:Key="MutedText" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="#9AA6AD" />
	</Style>

	<Style x:Key="InputLabel" TargetType="Label">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="Margin" Value="0,0,0,4" />
	</Style>

	<!--  FFHeader — копче со само иконка  -->
	<Style x:Key="EhmrIconButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#5B6973" />
		<Setter Property="BorderColor" Value="#D9E0E5" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<!--  AppointmentDetailPage, PatientDetailFormPage — „x" во чипче  -->
	<Style x:Key="TokenChipRemoveButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="WidthRequest" Value="24" />
		<Setter Property="HeightRequest" Value="24" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="12" />
	</Style>

	<!--  ── ReportPage ──────────────────────────────────────────────  -->

	<x:Double x:Key="SpaceXs">4</x:Double>
	<x:Double x:Key="SpaceSm">8</x:Double>
	<x:Double x:Key="SpaceLg">20</x:Double>

	<Color x:Key="BorderDefaultStrong">#CBD5E1</Color>

	<Style x:Key="GridHeaderLabel" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="22" />
		<Setter Property="TextColor" Value="#334155" />
	</Style>

	<Style x:Key="ToolbarContainer" TargetType="Border">
		<Setter Property="Padding" Value="16,12" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Stroke" Value="#D9E0E5" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>

	<Style x:Key="ElevatedCard" TargetType="Border">
