		<Setter Property="TextColor" Value="#334155" />
		<Setter Property="PlaceholderColor" Value="#9AA6AD" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="40" />
	</Style>

	<Style x:Key="PrimaryButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="#2AEBE7" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="40" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,0" />
	</Style>

	<Style x:Key="ToolbarButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="TextColor" Value="#5B6973" />
		<Setter Property="BorderColor" Value="#D9E0E5" />
