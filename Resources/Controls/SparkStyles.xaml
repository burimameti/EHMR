		<Setter Property="Stroke" Value="#EDF1F5" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>

	<!--  ============================================================  -->
	<!--  RADIUS SCALE  -->
	<!--  ============================================================  -->
	<x:Double x:Key="SparkRadiusXs">4</x:Double>
	<x:Double x:Key="SparkRadiusSm">6</x:Double>
	<x:Double x:Key="SparkRadiusMd">8</x:Double>
	<x:Double x:Key="SparkRadiusLg">12</x:Double>
	<x:Double x:Key="SparkRadiusXl">16</x:Double>
	<x:Double x:Key="SparkRadiusPill">20</x:Double>

	<!--  ============================================================  -->
	<!--  TYPOGRAPHY METRICS & VECTOR PATH DATA  -->
	<!--  ============================================================  -->
	<x:Double x:Key="SparkFontSizeSmall">12</x:Double>
	<x:Double x:Key="SparkFontSizeNormal">14</x:Double>
	<x:Double x:Key="SparkFontSizeTitle">16</x:Double>

	<x:String x:Key="SparkIconSearchPathData">M9,2 A7,7 0 1,0 9,16 A7,7 0 1,0 9,2 Z M14.2,14.2 L19,19</x:String>
	<x:String x:Key="SparkIconFilterPathData">M2,3 L18,3 L11.5,10.5 L11.5,16 L8.5,17.5 L8.5,10.5 Z</x:String>
	<x:String x:Key="SparkIconChevronDownPathData">M3,6 L10,13 L17,6</x:String>

	<!--  ============================================================  -->
	<!--  STYLES  -->
	<!--  ============================================================  -->
	<Style x:Key="SparkSearchBarStyle" TargetType="SearchBar">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="#334155" />
		<Setter Property="PlaceholderColor" Value="#64748B" />
		<Setter Property="CancelButtonColor" Value="#64748B" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="HeightRequest" Value="32" />
	</Style>

	<Style x:Key="SparkSearchBarFrameStyle" TargetType="Border">
		<Setter Property="Stroke" Value="#D9E0E5" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="6" />
			</Setter.Value>
		</Setter>
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style x:Key="SparkPickerStyle" TargetType="Picker">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="#334155" />
		<Setter Property="TitleColor" Value="#64748B" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="HeightRequest" Value="32" />
	</Style>

	<Style x:Key="SparkPickerFrameStyle" TargetType="Border">
		<Setter Property="Stroke" Value="#D9E0E5" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<Rectangle />
			</Setter.Value>
		</Setter>
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Padding" Value="8,0" />
		<Setter Property="MinimumWidthRequest" Value="96" />
	</Style>

	<Style x:Key="SparkActionButtonStyle" TargetType="Button">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#334155" />
		<Setter Property="BorderColor" Value="#CBD5E1" />
		<Setter Property="BorderWidth" Value="1" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsPrimary}"
				TargetType="Button"
				Value="True">
				<Setter Property="BackgroundColor" Value="#FFFFFF" />
				<Setter Property="TextColor" Value="#334155" />
				<Setter Property="BorderWidth" Value="0" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkIconButtonFrameStyle" TargetType="Border">
		<Setter Property="Stroke" Value="#CBD5E1" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="WidthRequest" Value="38" />
		<Setter Property="HeightRequest" Value="38" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<Style x:Key="SparkPagerButtonStyle" TargetType="Button">
		<Setter Property="FontFamily" Value="{x:Null}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="#334155" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="BorderColor" Value="#D9E0E5" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="ImageSource" Value="{x:Null}" />
		<Style.Triggers>
			<Trigger TargetType="Button" Property="IsEnabled" Value="False">
				<Setter Property="Opacity" Value="0.4" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkPagerLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="SparkTabTitleLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="#7C8798" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsSelected}"
				TargetType="Label"
				Value="True">
				<Setter Property="TextColor" Value="#0F172A" />
			</DataTrigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="SparkTabBadgeFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#EBEFF3" />
		<Setter Property="StrokeShape" Value="RoundRectangle 8" />
		<Setter Property="Padding" Value="7,2" />
		<Setter Property="Stroke" Value="Transparent" />
		<Style.Triggers>
			<DataTrigger
				Binding="{Binding IsSelected}"
				TargetType="Border"
				Value="True">
				<Setter Property="BackgroundColor" Value="#2AEBE7" />
			</DataTrigger>
		</Style.Triggers>
	</Style>










	<Style x:Key="SparkBadgeWarningFrameStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#FDF3E3" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="4" />
			</Setter.Value>
		</Setter>
		<Setter Property="Stroke" Value="Transparent" />
		<Setter Property="Padding" Value="8,3" />
	</Style>



	<Style x:Key="SparkEntryStyle" TargetType="Entry">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="32" />
		<Setter Property="TextColor" Value="#334155" />
		<Setter Property="PlaceholderColor" Value="#64748B" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="ClearButtonVisibility" Value="WhileEditing" />
	</Style>

	<Style x:Key="SparkEditorStyle" TargetType="Editor">
