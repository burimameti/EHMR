<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.SparkDataGridView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root"
	SizeChanged="OnGridSizeChanged">
	<Border
		Margin="-15,-14,-15,-22"
		Background="White"
		Stroke="#D8DEE8"
		StrokeShape="RoundRectangle 0"
		StrokeThickness="3">

		<Grid RowDefinitions="*, Auto">
			<ScrollView
				x:Name="HostScroll"
				Grid.Row="0"
				HorizontalOptions="Fill"
				Orientation="Vertical"
				VerticalOptions="Fill">
				<Grid
					x:Name="GridRoot"
					ColumnSpacing="0"
					HorizontalOptions="Fill"
					RowSpacing="0"
					VerticalOptions="Fill" />
			</ScrollView>
			<Grid
				x:Name="PagerContainer"
				Grid.Row="1"
				Padding="16,12"
				Background="{StaticResource SparkPageBackground2}"
				ColumnDefinitions="*,Auto"
				IsClippedToBounds="True"
				IsVisible="True">
				<Label
					x:Name="PagerInfoLabel"
					Grid.Column="0"
					HorizontalOptions="Center"
					Style="{StaticResource SparkPagerLabelStyle}"
					VerticalOptions="Center" />
				<HorizontalStackLayout
					x:Name="PagerRow"
					Grid.Column="1"
					Spacing="6"
					VerticalOptions="Center" />
			</Grid>
		</Grid>
	</Border>
</ContentView>
