<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFSwitch"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
	<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
		<!--  LABEL  -->
		<Label
			FontSize="14"
			Text="{Binding Label, Source={x:Reference This}}"
			TextColor="#374151"
			VerticalOptions="Center" />
		<!--  SWITCH  -->
		<Switch
			IsEnabled="{Binding IsEnabled, Source={x:Reference This}}"
			IsToggled="{Binding IsToggled, Source={x:Reference This}, Mode=TwoWay}"
			VerticalOptions="Center" />
		<!--  STATUS TEXT  -->
		<Label
			FontSize="12"
			Text="{Binding StatusText, Source={x:Reference This}}"
			TextColor="#6B7280"
			VerticalOptions="Center" />
	</HorizontalStackLayout>
</ContentView>