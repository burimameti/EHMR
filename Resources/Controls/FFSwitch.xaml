<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="EHMR.Resources.Controls.FFSwitch" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
		xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
	<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
		<!-- LABEL -->
		<Label Text="{Binding Label, Source={x:Reference This}}" VerticalOptions="Center" FontSize="14"
				TextColor="#374151" />
		<!-- SWITCH -->
		<Switch IsToggled="{Binding IsToggled, Source={x:Reference This}, Mode=TwoWay}"
				IsEnabled="{Binding IsEnabled, Source={x:Reference This}}" VerticalOptions="Center" />
		<!-- STATUS TEXT -->
		<Label Text="{Binding StatusText, Source={x:Reference This}}" VerticalOptions="Center" FontSize="12"
				TextColor="#6B7280" />
	</HorizontalStackLayout>
</ContentView>