<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls">

	<!--  =====================================================  -->
	<!--  FFMetricTile base  -->
	<!--  =====================================================  -->
	<Style x:Key="FFMetricTileBaseStyle" TargetType="controls:FFMetricTile" />

	<!--  =====================================================  -->
	<!--  Dashboard metric tile  -->
	<!--  =====================================================  -->
	<Style
		x:Key="FFMetricTileDashboardStyle"
		BasedOn="{StaticResource FFMetricTileBaseStyle}"
		TargetType="controls:FFMetricTile" />

	<!--  =====================================================  -->
	<!--  Compact metric tile  -->
	<!--  =====================================================  -->
	<Style
		x:Key="FFMetricTileCompactStyle"
		BasedOn="{StaticResource FFMetricTileBaseStyle}"
		TargetType="controls:FFMetricTile" />

	<!--  =====================================================  -->
	<!--  Dashboard metric tile with footer  -->
	<!--  =====================================================  -->
	<Style
		x:Key="FFMetricTileDashboardFooterStyle"
		BasedOn="{StaticResource FFMetricTileDashboardStyle}"
		TargetType="controls:FFMetricTile" />
</ResourceDictionary>