<?xml version="1.0" encoding="utf-8" ?>

<ContentView
	x:Class="EHMR.Resources.Controls.SparkExpandableCard"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Border
		x:Name="CardBorder"
		Margin="0"
		Padding="0"
		BackgroundColor="{StaticResource SparkContentBackground}"
		Stroke="{StaticResource SparkBorder}"
		StrokeShape="RoundRectangle 12"
		StrokeThickness="1">

		<Grid RowSpacing="0">

			<Grid.RowDefinitions>
				<RowDefinition Height="56" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  HEADER  -->

			<Grid
				x:Name="HeaderGrid"
				Grid.Row="0"
				Padding="12,0"
				BackgroundColor="Transparent"
				ColumnSpacing="12">

				<Grid.GestureRecognizers>
					<TapGestureRecognizer Tapped="ExpandTapped" />
				</Grid.GestureRecognizers>

				<Grid.ColumnDefinitions>

					<ColumnDefinition Width="28" />

					<ColumnDefinition Width="*" />

					<ColumnDefinition Width="Auto" />

					<ColumnDefinition Width="26" />

				</Grid.ColumnDefinitions>

				<!--  icon  -->

				<Label
					Grid.Column="0"
					FontSize="16"
					HorizontalOptions="Center"
					HorizontalTextAlignment="Center"
					Text="{Binding Icon, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkAccentTealDark}"
					VerticalOptions="Center"
					VerticalTextAlignment="Center" />

				<!--  title  -->

				<VerticalStackLayout
					Grid.Column="1"
					Spacing="0"
					VerticalOptions="Center">

					<Label
						FontAttributes="Bold"
						FontSize="16"
						LineBreakMode="TailTruncation"
						Text="{Binding Title, Source={x:Reference Root}}"
						TextColor="{StaticResource SparkTextPrimary}" />

					<Label
						FontSize="13"
						IsVisible="{Binding HasSubtitle, Source={x:Reference Root}}"
						LineBreakMode="TailTruncation"
						Text="{Binding Subtitle, Source={x:Reference Root}}"
						TextColor="{StaticResource SparkTextPrimary}" />

				</VerticalStackLayout>

				<!--  count  -->

				<Border
					x:Name="CountBorder"
					Grid.Column="2"
					Padding="6,2"
					BackgroundColor="{StaticResource SparkSurfaceAlt}"
					IsVisible="{Binding ShowCount, Source={x:Reference Root}}"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 6"
					StrokeThickness="0"
					VerticalOptions="Center">

					<Label
						FontAttributes="Bold"
						FontSize="16"
						HorizontalTextAlignment="Center"
						Text="{Binding ItemCount, Source={x:Reference Root}}"
						TextColor="{StaticResource SparkAccentTeal}" />

				</Border>

				<!--  expand  -->

				<Border
					Grid.Column="3"
					BackgroundColor="{StaticResource SparkAccentTealBg}"
					HeightRequest="30"
					StrokeShape="RoundRectangle 15"
					StrokeThickness="0"
					WidthRequest="30">
					<Label
						x:Name="ExpandIcon"
						FontAttributes="Bold"
						FontSize="18"
						HorizontalOptions="Center"
						HorizontalTextAlignment="Center"
						Text="▾"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center"
						VerticalTextAlignment="Center" />
				</Border>

			</Grid>

			<!--  separator  -->

			<BoxView
				Grid.Row="0"
				HeightRequest="1"
				VerticalOptions="End"
				Color="{StaticResource SparkBorder}" />

			<!--  CONTENT  -->

			<Grid
				x:Name="ExpandableArea"
				Grid.Row="1"
				IsVisible="False"
				Opacity="0">

				<Grid.RowDefinitions>

					<RowDefinition Height="Auto" />

					<RowDefinition Height="*" />

					<RowDefinition Height="Auto" />

				</Grid.RowDefinitions>

				<!--  search slot  -->

				<ContentPresenter
					x:Name="SearchHost"
					Margin="12,12,12,0"
					IsVisible="False" />

				<!--  body  -->

				<Grid Grid.Row="1" Margin="12">

					<!--  custom content  -->

					<ContentPresenter x:Name="ContentHost" />

					<!--  autogenerated collection  -->

					<CollectionView
						x:Name="ItemsHost"
						IsVisible="False"
						SelectionMode="Single"
						VerticalScrollBarVisibility="Never" />

					<!--  empty  -->

					<Grid x:Name="EmptyHost" IsVisible="False">

						<Label
							FontSize="12"
							HorizontalOptions="Center"
							Text="{Binding EmptyViewText, Source={x:Reference Root}}"
							TextColor="{StaticResource SparkTextPrimary}"
							VerticalOptions="Center" />

					</Grid>

				</Grid>

				<!--  footer  -->

				<Grid
					x:Name="FooterGrid"
					Grid.Row="2"
					Padding="12,8"
					IsVisible="False">

					<Label
						x:Name="FooterLabel"
						FontSize="11"
						TextColor="{StaticResource SparkTextPrimary}" />

				</Grid>

			</Grid>

		</Grid>

	</Border>

</ContentView>