<DataTemplate
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

    <VerticalStackLayout>

        <Label
            Text="{Binding Label}"
            Style="{StaticResource SparkFieldLabelStyle}" />

        <DatePicker
            Date="{Binding Value}"
            Style="{StaticResource SparkDatePickerStyle}" />

    </VerticalStackLayout>

</DataTemplate>
