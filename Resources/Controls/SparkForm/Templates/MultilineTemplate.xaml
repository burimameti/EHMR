<DataTemplate
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

    <VerticalStackLayout
        Spacing="4">

        <Label
            Text="{Binding Label}"
            Style="{StaticResource SparkFieldLabelStyle}" />

        <Editor
            Text="{Binding Value}"
            Placeholder="{Binding Placeholder}"
            AutoSize="TextChanges"
            MinimumHeightRequest="120"
            Style="{StaticResource SparkEditorStyle}" />

    </VerticalStackLayout>

</DataTemplate>
