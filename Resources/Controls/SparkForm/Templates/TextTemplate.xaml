<DataTemplate
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

    <VerticalStackLayout
        Spacing="4"
        Margin="0,4">

        <Label
            Text="{Binding Label}"
            Style="{StaticResource SparkFieldLabelStyle}" />

        <Entry
            Text="{Binding Value}"
            Placeholder="{Binding Placeholder}"
            IsEnabled="{Binding IsEnabled}"
            IsReadOnly="{Binding IsReadOnly}"
            Style="{StaticResource SparkEntryStyle}" />

    </VerticalStackLayout>

</DataTemplate>
