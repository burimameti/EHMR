<DataTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

	<HorizontalStackLayout Padding="0,6" VerticalOptions="Center">

		<Label
			HorizontalOptions="StartAndExpand"
			Style="{StaticResource SparkFieldLabelStyle}"
			Text="{Binding Label}" />

		<Switch IsEnabled="{Binding IsEnabled}" IsToggled="{Binding Value}" />

	</HorizontalStackLayout>

</DataTemplate>
