<DataTemplate
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

<VerticalStackLayout>

<Label
Text="{Binding Label}"
Style="{StaticResource SparkFieldLabelStyle}"/>

<Entry
IsPassword="True"
Text="{Binding Value}"
Placeholder="{Binding Placeholder}"
Style="{StaticResource SparkEntryStyle}"/>

</VerticalStackLayout>

</DataTemplate>
