<DataTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

	<VerticalStackLayout>

		<Label Style="{StaticResource SparkFieldLabelStyle}" Text="{Binding Label}" />

		<Entry
			IsPassword="True"
			Placeholder="{Binding Placeholder}"
			Style="{StaticResource SparkEntryStyle}"
			Text="{Binding Value}" />

	</VerticalStackLayout>

</DataTemplate>
