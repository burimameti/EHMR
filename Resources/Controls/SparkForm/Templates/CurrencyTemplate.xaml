<DataTemplate
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

    <VerticalStackLayout>

        <Label
            Text="{Binding Label}"
            Style="{StaticResource SparkFieldLabelStyle}" />

        <Grid>

            <Entry
                Text="{Binding Value}"
                Keyboard="Numeric"
                Placeholder="{Binding Placeholder}"
                Style="{StaticResource SparkEntryStyle}" />

            <Label
                HorizontalOptions="End"
                VerticalOptions="Center"
                Margin="0,0,12,0"
                Text="$"
                FontAttributes="Bold"/>

        </Grid>

    </VerticalStackLayout>

</DataTemplate>
