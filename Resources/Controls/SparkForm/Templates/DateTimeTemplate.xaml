<DataTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

	<VerticalStackLayout>

		<Label Style="{StaticResource SparkFieldLabelStyle}" Text="{Binding Label}" />

		<Grid ColumnDefinitions="*,*">

			<DatePicker Grid.Column="0" Date="{Binding Value}" />

			<TimePicker Grid.Column="1" Time="{Binding Value}" />

		</Grid>

	</VerticalStackLayout>

</DataTemplate>
