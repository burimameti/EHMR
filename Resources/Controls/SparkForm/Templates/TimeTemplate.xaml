<DataTemplate
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

    <VerticalStackLayout>

        <Label
            Text="{Binding Label}"
            Style="{StaticResource SparkFieldLabelStyle}" />

        <TimePicker
            Time="{Binding Value}"
            Style="{StaticResource SparkTimePickerStyle}" />

    </VerticalStackLayout>

</DataTemplate>
