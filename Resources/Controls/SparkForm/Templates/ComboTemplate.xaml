<DataTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

	<VerticalStackLayout>

		<Label Style="{StaticResource SparkFieldLabelStyle}" Text="{Binding Label}" />

		<Picker
			ItemDisplayBinding="{Binding Text}"
			ItemsSource="{Binding ItemsSource}"
			SelectedItem="{Binding Value}"
			Style="{StaticResource SparkPickerStyle}" />

	</VerticalStackLayout>

</DataTemplate>
