<DataTemplate
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui">

<VerticalStackLayout>

<Label
Text="{Binding Label}"
Style="{StaticResource SparkFieldLabelStyle}"/>

<Picker
ItemsSource="{Binding ItemsSource}"
ItemDisplayBinding="{Binding Text}"
SelectedItem="{Binding Value}"
Style="{StaticResource SparkPickerStyle}"/>

</VerticalStackLayout>

</DataTemplate>
