<?xml version="1.0" encoding="utf-8" ?>

<ContentView
	x:Class="EHMR.Resources.Controls.SparkForms.Controls.SparkSectionView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Border
		Padding="14"
		BackgroundColor="{StaticResource SparkContentBackground}"
		Stroke="{StaticResource SparkCardBorder}"
		StrokeShape="RoundRectangle 8"
		StrokeThickness="1">

		<VerticalStackLayout Spacing="10">

			<Label
				FontAttributes="Bold"
				FontSize="14"
				Text="{Binding Section.Header, Source={x:Reference Root}}"
				TextColor="{StaticResource SparkTextPrimary}" />

			<Grid
				x:Name="PART_FieldGrid"
				ColumnSpacing="12"
				RowSpacing="12" />

		</VerticalStackLayout>
	</Border>
</ContentView>