<?xml version="1.0" encoding="utf-8" ?>

<ContentView
	x:Class="EHMR.Resources.Controls.SparkForms.Controls.SparkSectionView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">


	<Border Padding="16" StrokeThickness="1">


		<VerticalStackLayout Spacing="15">


			<Label
				FontAttributes="Bold"
				FontSize="20"
				Text="{Binding Section.Header, Source={x:Reference Root}}" />



			<Grid
				x:Name="PART_FieldGrid"
				ColumnSpacing="15"
				RowSpacing="15" />


		</VerticalStackLayout>


	</Border>


</ContentView>