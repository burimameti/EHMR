<?xml version="1.0" encoding="utf-8" ?>

<ContentView
	x:Class="EHMR.Resources.Controls.SparkForms.Controls.SparkSectionView"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">


	<Border Padding="18" BackgroundColor="{StaticResource SparkContentBackground}" Stroke="{StaticResource SparkCardBorder}" StrokeShape="RoundRectangle 14" StrokeThickness="1"><Border.Shadow><Shadow Brush="#000000" Opacity="0.05" Radius="10" Offset="0,3" /></Border.Shadow>


		<VerticalStackLayout Spacing="15">


			<Border Style="{StaticResource SectionPillBorderStyle}">
				<Label Style="{StaticResource SectionPillLabelStyle}" Text="{Binding Section.Header, Source={x:Reference Root}}" />
			</Border>



			<Grid
				x:Name="PART_FieldGrid"
				ColumnSpacing="15"
				RowSpacing="15" />


		</VerticalStackLayout>


	</Border>


</ContentView>