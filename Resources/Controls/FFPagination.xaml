<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EHMR.Resources.Controls.FFPagination"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

	<Grid
    Padding="16,12"
    ColumnDefinitions="*,Auto"
    ColumnSpacing="20">

		<!-- LEFT -->
		<Label
        Grid.Column="0"
        Text="{Binding SummaryText, Source={x:Reference Root}}"
        Style="{StaticResource FFPaginationLabelStyle}" />

		<!-- RIGHT -->
		<HorizontalStackLayout
        Grid.Column="1"
        Spacing="6"
        HorizontalOptions="End">

			<Button
            Text="‹"
            Style="{StaticResource FFPaginationButtonStyle}"
            Command="{Binding PrevCommand, Source={x:Reference Root}}"
            IsEnabled="{Binding CanPrev, Source={x:Reference Root}}" />

			<Border
            Background="#2563EB"
            StrokeThickness="0"
            Padding="12,6">

				<Border.StrokeShape>
					<RoundRectangle CornerRadius="8"/>
				</Border.StrokeShape>

				<Label
                Text="{Binding PageInfo, Source={x:Reference Root}}"
                TextColor="White"
                FontSize="12"
                FontAttributes="Bold"/>
			</Border>

			<Button
            Text="›"
            Style="{StaticResource FFPaginationButtonStyle}"
            Command="{Binding NextCommand, Source={x:Reference Root}}"
            IsEnabled="{Binding CanNext, Source={x:Reference Root}}" />

		</HorizontalStackLayout>

	</Grid>
</ContentView>