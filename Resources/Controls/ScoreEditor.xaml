<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.ScoreEditor"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="Root"
	x:DataType="vm:ScoreEditorViewModel">

	<VerticalStackLayout Spacing="8">

		<!--  Search and inline add: no popup.  -->
		<VerticalStackLayout IsVisible="{Binding IsEditable}" Spacing="4">
			<Label
				FontAttributes="Bold"
				FontSize="10"
				Text="ПРЕБАРУВАЊЕ НА СКОР"
				TextColor="{StaticResource SparkTextSecondary}" />
			<Grid ColumnDefinitions="*,82" ColumnSpacing="6">
				<Border
					Padding="8,0"
					BackgroundColor="{StaticResource SparkBackground}"
					HeightRequest="38"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 7"
					StrokeThickness="1">
					<Entry
						BackgroundColor="Transparent"
						FontSize="12"
						Placeholder="Пребарај скор (пр. DAS28)"
						PlaceholderColor="{StaticResource SparkTextSecondary}"
						Text="{Binding DescriptionText, Mode=TwoWay}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Border>
				<Border
					Grid.Column="1"
					Padding="6,0"
					BackgroundColor="{StaticResource SparkBackground}"
					HeightRequest="38"
					Stroke="{StaticResource SparkBorder}"
					StrokeShape="RoundRectangle 7"
					StrokeThickness="1">
					<Entry
						BackgroundColor="Transparent"
						FontSize="12"
						Keyboard="Numeric"
						Placeholder="Бројка"
						PlaceholderColor="{StaticResource SparkTextSecondary}"
						Text="{Binding NumberText, Mode=TwoWay}"
						TextColor="{StaticResource SparkTextPrimary}"
						VerticalOptions="Center" />
				</Border>
			</Grid>
			<HorizontalStackLayout HorizontalOptions="End" Spacing="6">
				<controls:FFButton
					ButtonKind="Primary"
					Command="{Binding AddCommand}"
					HeightRequestEx="38"
					Text="Додади во листа"
					WidthRequestEx="132" />
				<controls:FFButton
					ButtonKind="Secondary"
					Command="{Binding AddNewScoreDefinitionCommand}"
					HeightRequestEx="38"
					Text="+ Додади нов скор"
					WidthRequestEx="150" />
			</HorizontalStackLayout>
		</VerticalStackLayout>

		<!--  Предлози (најупотребените најгоре)  -->
		<Border
			Padding="4"
			BackgroundColor="{StaticResource SparkBackground}"
			IsVisible="{Binding ShowSuggestions}"
			Stroke="{StaticResource SparkBorderSubtle}"
			StrokeShape="RoundRectangle 8"
			StrokeThickness="1">
			<VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}" Spacing="0">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="vm:ScoreSuggestion">
						<Border
							Padding="9,7"
							BackgroundColor="Transparent"
							StrokeThickness="0">
							<Border.GestureRecognizers>
								<TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectSuggestionCommand}" CommandParameter="{Binding .}" />
							</Border.GestureRecognizers>
							<Grid ColumnDefinitions="*,Auto">
								<Label
									FontAttributes="Bold"
									FontSize="12"
									Text="{Binding Text}"
									TextColor="{StaticResource SparkAccentTealDark}" />
								<Label
									Grid.Column="1"
									FontSize="10"
									Text="{Binding UsageCount, StringFormat='×{0}'}"
									TextColor="{StaticResource SparkTextSecondary}" />
							</Grid>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</Border>

		<!--  Заглавие  -->
		<Grid ColumnDefinitions="*,90,44" ColumnSpacing="1">
			<Border
				Padding="8,6"
				BackgroundColor="{StaticResource SparkSurfaceAlt}"
				StrokeThickness="0">
				<Label
					FontAttributes="Bold"
					FontSize="9"
					Text="ОПИС"
					TextColor="{StaticResource SparkTextPrimary}" />
			</Border>
			<Border
				Grid.Column="1"
				Padding="8,6"
				BackgroundColor="{StaticResource Gray300}"
				StrokeThickness="0">
				<Label
					FontAttributes="Bold"
					FontSize="9"
					Text="БРОЈКА"
					TextColor="{StaticResource SparkTextPrimary}" />
			</Border>
			<Border
				Grid.Column="2"
				BackgroundColor="{StaticResource Gray300}"
				StrokeThickness="0" />
		</Grid>

		<!--  Редови  -->
		<VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="0">
			<BindableLayout.ItemTemplate>
				<DataTemplate x:DataType="vm:ScoreRow">
					<Grid ColumnDefinitions="*,90,44" ColumnSpacing="1">
						<Border
							Padding="8,0"
							BackgroundColor="{StaticResource SparkBackground}"
							HeightRequest="42"
							Stroke="{StaticResource SparkBorderSubtle}"
							StrokeThickness="1">
							<Entry
								BackgroundColor="Transparent"
								FontSize="11.5"
								HeightRequest="36"
								IsEnabled="{Binding Source={x:Reference Root}, Path=BindingContext.IsEditable}"
								Text="{Binding Description, Mode=TwoWay}"
								TextColor="{StaticResource SparkTextPrimary}"
								VerticalOptions="Center" />
						</Border>
						<Border
							Grid.Column="1"
							Padding="4,0"
							BackgroundColor="{StaticResource SparkBackground}"
							HeightRequest="46"
							Stroke="{StaticResource SparkBorderSubtle}"
							StrokeThickness="1">
							<Entry
								BackgroundColor="Transparent"
								FontSize="11.5"
								IsEnabled="{Binding Source={x:Reference Root}, Path=BindingContext.IsEditable}"
								Keyboard="Numeric"
								Text="{Binding Number, Mode=TwoWay}"
								TextColor="{StaticResource SparkTextPrimary}"
								VerticalOptions="Center" />
						</Border>
						<Border
							Grid.Column="2"
							BackgroundColor="{StaticResource SparkBackground}"
							HeightRequest="46"
							Stroke="{StaticResource SparkBorderSubtle}"
							StrokeThickness="1">
							<controls:FFButton
								ButtonKind="Danger"
								Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveCommand}"
								CommandParameter="{Binding .}"
								HeightRequestEx="32"
								HorizontalOptions="Center"
								IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsEditable}"
								Text="X"
								VerticalOptions="Center"
								WidthRequestEx="36" />
						</Border>
					</Grid>
				</DataTemplate>
			</BindableLayout.ItemTemplate>
		</VerticalStackLayout>
	</VerticalStackLayout>
</ContentView>