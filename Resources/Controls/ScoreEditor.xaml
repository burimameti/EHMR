<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.ScoreEditor"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	xmlns:vm="clr-namespace:EHMR.ViewModels"
	x:Name="Root"
	x:DataType="vm:ScoreEditorViewModel">

	<ContentView.Resources>
		<ResourceDictionary>

			<Style x:Key="ScoreFrameStyle" TargetType="Border">
				<Setter Property="Padding" Value="0" />
				<Setter Property="BackgroundColor" Value="White" />
				<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
				<Setter Property="StrokeShape" Value="RoundRectangle 8" />
				<Setter Property="StrokeThickness" Value="1" />
			</Style>

			<Style x:Key="ScoreHeaderLabelStyle" TargetType="Label">
				<Setter Property="FontAttributes" Value="Bold" />
				<Setter Property="FontSize" Value="9" />
				<Setter Property="LineBreakMode" Value="TailTruncation" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

			<Style x:Key="ScoreCellEntryStyle" TargetType="Entry">
				<Setter Property="BackgroundColor" Value="Transparent" />
				<Setter Property="FontSize" Value="11" />
				<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

		</ResourceDictionary>
	</ContentView.Resources>

	<VerticalStackLayout Spacing="8">

		<!--  Наслов (иста висина како „АКТИВНИ ЛЕКОВИ")  -->
		<Grid HeightRequest="34">
			<Label
				FontAttributes="Bold"
				FontSize="11"
				Text="СКОРОВИ"
				TextColor="{StaticResource SparkAccentTealDark}"
				VerticalOptions="Center" />
		</Grid>

		<!--  Пребарување + предлози  -->
		<VerticalStackLayout IsVisible="{Binding IsEditable}" Spacing="4">
			<controls:FFSearchBox Placeholder="Пребарај скор (пр. DAS28)..." Text="{Binding DescriptionText, Mode=TwoWay}" />

			<Border
				Padding="4"
				BackgroundColor="White"
				IsVisible="{Binding ShowSuggestions}"
				Stroke="{StaticResource SparkBorderSubtle}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1">
				<VerticalStackLayout Spacing="0">
					<Label
						Padding="8,7"
						FontSize="11"
						IsVisible="{Binding HasSearchStatus}"
						Text="{Binding SearchStatusText}"
						TextColor="{StaticResource SparkTextSecondary}" />
					<VerticalStackLayout
						BindableLayout.ItemsSource="{Binding Suggestions}"
						IsVisible="{Binding HasSuggestions}"
						Spacing="0">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="vm:ScoreSuggestion">
								<Border
									Padding="9,6"
									BackgroundColor="Transparent"
									StrokeThickness="0">
									<Border.GestureRecognizers>
										<TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectSuggestionCommand}" CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<Grid ColumnDefinitions="*,Auto">
										<Label
											FontAttributes="Bold"
											FontSize="11.5"
											Text="{Binding Text}"
											TextColor="{StaticResource SparkAccentTealDark}" />
										<Label
											Grid.Column="1"
											FontSize="10"
											Text="{Binding UsageCount, StringFormat='×{0}'}"
											TextColor="{StaticResource SparkTextSecondary}" />
									</Grid>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>
		</VerticalStackLayout>

		<!--  Табела (ист дизајн како лековите)  -->
		<Border Style="{StaticResource ScoreFrameStyle}" VerticalOptions="Start">
			<VerticalStackLayout Spacing="0">

				<Grid
					Padding="10,8"
					BackgroundColor="{StaticResource SparkSurfaceAlt}"
					ColumnDefinitions="*,90,44"
					ColumnSpacing="8">
					<Label
						Grid.Column="0"
						Style="{StaticResource ScoreHeaderLabelStyle}"
						Text="СКОР" />
					<Label
						Grid.Column="1"
						Style="{StaticResource ScoreHeaderLabelStyle}"
						Text="БРОЈКА" />
					<Label
						Grid.Column="2"
						HorizontalTextAlignment="Center"
						Style="{StaticResource ScoreHeaderLabelStyle}"
						Text="АКЦИИ" />
				</Grid>

				<VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="0">
					<BindableLayout.EmptyView>
						<Label
							Padding="12"
							FontSize="11"
							HorizontalOptions="Center"
							Text="Нема внесени скорови."
							TextColor="{StaticResource SparkTextMuted}" />
					</BindableLayout.EmptyView>
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="vm:ScoreRow">
							<Grid RowDefinitions="Auto,1">
								<Grid
									Padding="10,6"
									ColumnDefinitions="*,90,44"
									ColumnSpacing="8">
									<Label
										Grid.Column="0"
										FontSize="11"
										LineBreakMode="WordWrap"
										Text="{Binding Description}"
										TextColor="{StaticResource SparkTextPrimary}"
										VerticalOptions="Center" />
									<Entry
										Grid.Column="1"
										IsEnabled="{Binding IsNew}"
										Keyboard="Numeric"
										Placeholder="0.0"
										Style="{StaticResource ScoreCellEntryStyle}"
										Text="{Binding Number, Mode=TwoWay}" />
									<Label
										Grid.Column="2"
										FontFamily="FASolid"
										FontSize="13"
										HorizontalOptions="Center"
										IsVisible="{Binding Source={x:Reference Root}, Path=BindingContext.IsEditable}"
										Text="&#xf1f8;"
										TextColor="#DC2626"
										VerticalOptions="Center">
										<Label.GestureRecognizers>
											<TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveCommand}" CommandParameter="{Binding .}" />
										</Label.GestureRecognizers>
									</Label>
								</Grid>
								<BoxView
									Grid.Row="1"
									HeightRequest="1"
									Color="{StaticResource SparkBorderSubtle}" />
							</Grid>
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>

			</VerticalStackLayout>
		</Border>
	</VerticalStackLayout>
</ContentView>
