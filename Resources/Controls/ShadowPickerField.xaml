<?xml version="1.0" encoding="utf-8" ?>

<controls:ShadowFieldContainer
	x:Class="EHMR.Resources.Controls.ShadowPickerField"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root">

	<controls:ShadowFieldContainer.FieldContent>

		<Picker
			Title="{Binding Placeholder, Source={x:Reference Root}}"
			ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
			SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}" />
	</controls:ShadowFieldContainer.FieldContent>
</controls:ShadowFieldContainer>