<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFMetricTile"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Border
		Margin="4"
		Padding="14,10"
		BackgroundColor="{Binding TileBackground, Source={x:Reference Root}}"
		Stroke="{Binding TileBorder, Source={x:Reference Root}}"
		StrokeThickness="1">
		<Border.StrokeShape>
			<RoundRectangle CornerRadius="12" />
		</Border.StrokeShape>
		<Border.Shadow>
			<Shadow
				Brush="#000000"
				Opacity="0.05"
				Radius="12"
				Offset="0,2" />
		</Border.Shadow>

		<Grid RowDefinitions="Auto,Auto" RowSpacing="8">
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
				<Border
					BackgroundColor="{Binding IconBackground, Source={x:Reference Root}}"
					HeightRequest="32"
					IsVisible="{Binding ShowIcon, Source={x:Reference Root}}"
					StrokeThickness="0"
					VerticalOptions="Center"
					WidthRequest="32">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="12" />
					</Border.StrokeShape>
					<Label
						FontFamily="FASolid"
						FontSize="12"
						HorizontalOptions="Center"
						Text="{Binding Icon, Source={x:Reference Root}}"
						TextColor="#FFFFFF"
						VerticalOptions="Center" />
				</Border>
				<Label
					Grid.Column="1"
					CharacterSpacing="0.9"
					FontAttributes="Bold"
					FontSize="9"
					LineBreakMode="TailTruncation"
					MaxLines="1"
					Text="{Binding Title, Source={x:Reference Root}}"
					TextColor="{Binding TitleColor, Source={x:Reference Root}}"
					VerticalOptions="Center" />
				<Label
					Grid.Column="2"
					FontAttributes="Bold"
					FontSize="22"
					Text="{Binding Value, Source={x:Reference Root}}"
					TextColor="{Binding ValueColor, Source={x:Reference Root}}"
					VerticalOptions="Center" />
			</Grid>

			<Border
				Grid.Row="1"
				Padding="10,5"
				BackgroundColor="{Binding AccentColor, Source={x:Reference Root}}"
				HorizontalOptions="End"
				IsVisible="{Binding Command, Source={x:Reference Root}, Converter={StaticResource SparkNotNullConverter}}"
				StrokeThickness="0">
				<Border.StrokeShape>
					<RoundRectangle CornerRadius="12" />
				</Border.StrokeShape>
				<Border.GestureRecognizers>
					<TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}" CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}" />
				</Border.GestureRecognizers>
				<HorizontalStackLayout Spacing="5">
					<Label
						FontAttributes="Bold"
						FontSize="11"
						Text="Повеќе"
						TextColor="White"
						VerticalOptions="Center" />
					<Label
						FontAttributes="Bold"
						FontSize="12"
						Text="›"
						TextColor="White"
						VerticalOptions="Center" />
				</HorizontalStackLayout>
			</Border>
		</Grid>
	</Border>
</ContentView>