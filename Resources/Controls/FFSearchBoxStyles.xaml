<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style x:Key="SurfaceCard" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource White}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="Padding" Value="12" />
	</Style>

	<Style x:Key="SoftPanel" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource Gray50}" />
		<Setter Property="StrokeThickness" Value="0" />

		<Setter Property="Padding" Value="12" />
	</Style>
	<!--  BORDER  -->
	<Style x:Key="FFSearchBoxBorderStyle" TargetType="Border">
		<Setter Property="Stroke" Value="#E5E7EB" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Background" Value="White" />
		<Setter Property="Padding" Value="10" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="6" />
			</Setter.Value>
		</Setter>
	</Style>

	<!--  ICON  -->
	<Style x:Key="FFSearchIconStyle" TargetType="Label">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="#6B7280" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<!--  ENTRY  -->
	<Style x:Key="FFSearchEntryStyle" TargetType="Entry">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="#111827" />
		<Setter Property="PlaceholderColor" Value="#9CA3AF" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="HeightRequest" Value="40" />
	</Style>
</ResourceDictionary>