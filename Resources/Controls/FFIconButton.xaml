<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="EHMR.Resources.Controls.FFIconButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

	<Grid>

		<!-- MAIN BUTTON -->
		<Button x:Name="RootButton"
                Style="{StaticResource FFIconButtonStyle}"
                Command="{Binding Command, Source={x:Reference Root}}"
                CommandParameter="{Binding CommandParameter, Source={x:Reference Root}}">

			<Button.ImageSource>
				<FontImageSource
                    FontFamily="{Binding FontFamily, Source={x:Reference Root}}"
                    Glyph="{Binding Icon, Source={x:Reference Root}}"
                    Size="{Binding IconSize, Source={x:Reference Root}}"
                    Color="{Binding IconColor, Source={x:Reference Root}}" />
			</Button.ImageSource>
		</Button>

		<!-- PRESSED OVERLAY -->
		<BoxView x:Name="PressedOverlay"
                 BackgroundColor="Black"
                 Opacity="0"
                 InputTransparent="True" />
	</Grid>

	<!-- VISUAL STATES -->
	<VisualStateManager.VisualStateGroups>

		<VisualStateGroup Name="CommonStates">

			<VisualState Name="Normal">
				<VisualState.Setters>
					<Setter TargetName="PressedOverlay" Property="Opacity" Value="0" />
				</VisualState.Setters>
			</VisualState>

			<VisualState Name="Pressed">
				<VisualState.Setters>
					<Setter TargetName="PressedOverlay" Property="Opacity" Value="0.15" />
				</VisualState.Setters>
			</VisualState>

			<VisualState Name="Disabled">
				<VisualState.Setters>
					<Setter TargetName="PressedOverlay" Property="Opacity" Value="0" />
					<Setter TargetName="RootButton" Property="Opacity" Value="0.4" />
				</VisualState.Setters>
			</VisualState>
		</VisualStateGroup>
	</VisualStateManager.VisualStateGroups>
</ContentView>