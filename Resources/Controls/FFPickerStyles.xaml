<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  BORDER  -->
	<Style x:Key="FFPickerBorderStyle" TargetType="Border">
		<Setter Property="Background" Value="White" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="MinimumHeightRequest" Value="48" />
		<Setter Property="Stroke" Value="#D6DCE5" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="10" />
			</Setter.Value>
		</Setter>
	</Style>

	<!--  CONTAINER  -->


	<!--  LABEL  -->
	<Style x:Key="FFPickerLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="FontAttributes" Value="None" />
		<Setter Property="Margin" Value="2,0,0,0" />
	</Style>

	<!--  PICKER  -->
	<Style x:Key="FFPickerControlStyle" TargetType="Picker">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="HeightRequest" Value="46" />
		<Setter Property="CharacterSpacing" Value="0.2" />
	</Style>
</ResourceDictionary>