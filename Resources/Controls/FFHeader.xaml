<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFPageHeader"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls"
	x:Name="Root"
	x:DataType="controls:FFPageHeader">

	<Border
		Padding="0"
		StrokeShape="RoundRectangle 0"
		StrokeThickness="0">
		<Grid
			Padding="0"
			ColumnDefinitions="Auto,*,Auto"
			ColumnSpacing="0">
			<Border
				Grid.Column="0"
				Margin="12,10,10,10"
				BackgroundColor="{StaticResource SparkAccentTealBg}"
				HeightRequest="38"
				Stroke="{StaticResource SparkAccentTeal}"
				StrokeShape="RoundRectangle 8"
				StrokeThickness="1"
				WidthRequest="38">
				<Label
					FontFamily="FASolid"
					FontSize="14"
					HorizontalOptions="Center"
					Text="&#xf15c;"
					TextColor="{StaticResource SparkAccentTealDark}"
					VerticalOptions="Center" />
			</Border>

			<VerticalStackLayout
				Grid.Column="1"
				Spacing="1"
				VerticalOptions="Center">
				<Label
					FontSize="11"
					IsVisible="{Binding Caption, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
					Text="{Binding Caption, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextSecondary}" />
				<Label
					FontAttributes="Bold"
					FontSize="20"
					Text="{Binding Title, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextPrimary}" />
				<Label
					FontSize="12"
					IsVisible="{Binding Subtitle, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
					LineBreakMode="TailTruncation"
					MaxLines="1"
					Text="{Binding Subtitle, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextSecondary}" />
			</VerticalStackLayout>

			<HorizontalStackLayout
				Grid.Column="2"
				Margin="12,10,16,10"
				Spacing="8"
				VerticalOptions="Center">
				<ContentView Content="{Binding HeaderContent, Source={x:Reference Root}}" />
				<Button
					BackgroundColor="{StaticResource SparkButtonPrimaryBg}"
					Command="{Binding PrimaryButtonCommand, Source={x:Reference Root}}"
					HeightRequest="36"
					IsEnabled="{Binding PrimaryButtonIsEnabled, Source={x:Reference Root}}"
					IsVisible="{Binding ShowPrimaryButton, Source={x:Reference Root}}"
					Style="{StaticResource TabButtonActiveStyle}"
					Text="{Binding PrimaryButtonText, Source={x:Reference Root}}"
					TextColor="White"
					WidthRequest="140" />
				<Button
					BackgroundColor="{StaticResource SparkButtonSecondaryBg}"
					BorderColor="{StaticResource SparkBorder}"
					BorderWidth="1"
					Command="{Binding SecondaryButtonCommand, Source={x:Reference Root}}"
					CornerRadius="7"
					HeightRequest="36"
					IsVisible="{Binding ShowSecondaryButton, Source={x:Reference Root}}"
					Style="{StaticResource TabButtonStyle}"
					Text="{Binding SecondaryButtonText, Source={x:Reference Root}}"
					TextColor="{StaticResource SparkTextPrimary}"
					WidthRequest="140" />
				<Button
					Command="{Binding RefreshCommand, Source={x:Reference Root}}"
					HeightRequest="36"
					IsVisible="{Binding ShowRefreshButton, Source={x:Reference Root}}"
					Style="{StaticResource EhmrIconButton}"
					WidthRequest="36" />
			</HorizontalStackLayout>
		</Grid>
	</Border>
</ContentView>