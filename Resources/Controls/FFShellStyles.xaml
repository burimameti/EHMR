<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<Style x:Key="FFShellSidebarStyle" TargetType="Border">
		<Setter Property="Background" Value="#111827" />
		<Setter Property="Padding" Value="10" />
		<Setter Property="StrokeThickness" Value="0" />
	</Style>

	<Style x:Key="FFShellBrandStyle" TargetType="Label">
		<Setter Property="TextColor" Value="White" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="Margin" Value="2,8,2,16" />
	</Style>

	<Style x:Key="FFShellMenuButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="#E2E8F0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="CornerRadius" Value="7" />
		<Setter Property="HeightRequest" Value="36" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="HorizontalOptions" Value="Fill" />
	</Style>

	<Style x:Key="FFShellTopBarStyle" TargetType="Border">
		<Setter Property="Background" Value="White" />
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 0" />
	</Style>
</ResourceDictionary>