<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFScrollBar"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<!--
		Секогаш видлива вертикална лента. Системскиот WinUI scrollbar се крие
		и е претенок, па оваа е нацртана рачно за да се гледа постојано.
	-->
	<Grid x:Name="TrackHost" WidthRequest="{Binding BarWidth, Source={x:Reference Root}}">

		<!--  Патека  -->
		<Border
			BackgroundColor="{Binding TrackColor, Source={x:Reference Root}}"
			StrokeShape="RoundRectangle 6"
			StrokeThickness="0" />

		<!--  Палец  -->
		<Border
			x:Name="Thumb"
			BackgroundColor="{Binding ThumbColor, Source={x:Reference Root}}"
			HeightRequest="40"
			StrokeShape="RoundRectangle 6"
			StrokeThickness="0"
			VerticalOptions="Start">
			<Border.GestureRecognizers>
				<PanGestureRecognizer PanUpdated="OnThumbPan" />
			</Border.GestureRecognizers>
		</Border>
	</Grid>
</ContentView>
