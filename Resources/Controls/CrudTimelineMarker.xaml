<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.CrudTimelineMarker"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	WidthRequest="24">
	<Grid>
		<BoxView
			Margin="0,-10,0,-10"
			BackgroundColor="{StaticResource SidebarActiveBg}"
			HorizontalOptions="Center"
			VerticalOptions="Fill"
			WidthRequest="1" />
		<Border
			BackgroundColor="White"
			HeightRequest="10"
			HorizontalOptions="Center"
			Stroke="{StaticResource SidebarActiveBg}"
			StrokeShape="Ellipse"
			StrokeThickness="2"
			VerticalOptions="Center"
			WidthRequest="10" />
	</Grid>
</ContentView>
