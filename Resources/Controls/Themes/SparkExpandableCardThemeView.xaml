<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


	<!--  =================================================  -->
	<!--  COLORS  -->
	<!--  =================================================  -->


	<!--  Card  -->
	<Color x:Key="SparkCardBackground">
		#FFFFFF
	</Color>


	<Color x:Key="SparkContentBackground">
		#F8FAFC
	</Color>


	<Color x:Key="SparkCardBorder">
		#E2E8F0
	</Color>




	<!--  Accent  -->
	<Color x:Key="SparkAccent">
		#F97316
	</Color>


	<Color x:Key="SparkAccentSoft">
		#FFF7ED
	</Color>



	<!--  Button  -->
	<Color x:Key="SparkButtonBackground">
		#F1F5F9
	</Color>


	<Color x:Key="SparkButtonHover">
		#E2E8F0
	</Color>







	<!--  =================================================  -->
	<!--  HEADER TITLE  -->
	<!--  =================================================  -->


	<Style x:Key="SparkCardTitle" TargetType="Label">


		<Setter Property="FontSize" Value="16" />


		<Setter Property="FontAttributes" Value="Bold" />


		<Setter Property="TextColor" Value="#111827" />


		<Setter Property="LineBreakMode" Value="TailTruncation" />


	</Style>








	<!--  =================================================  -->
	<!--  SUBTITLE  -->
	<!--  =================================================  -->


	<Style x:Key="SparkCardSubtitle" TargetType="Label">


		<Setter Property="FontSize" Value="13" />


		<Setter Property="TextColor" Value="#64748B" />


		<Setter Property="LineBreakMode" Value="TailTruncation" />


	</Style>









	<!--  =================================================  -->
	<!--  EXPAND BUTTON  -->
	<!--  =================================================  -->


	<Style x:Key="SparkExpandButton" TargetType="Border">


		<Setter Property="BackgroundColor" Value="{StaticResource SparkButtonBackground}" />


		<Setter Property="HeightRequest" Value="36" />


		<Setter Property="WidthRequest" Value="36" />


		<Setter Property="StrokeThickness" Value="0" />


	</Style>









	<!--  =================================================  -->
	<!--  CONTENT LABEL  -->
	<!--  =================================================  -->


	<Style x:Key="SparkCardContentText" TargetType="Label">


		<Setter Property="FontSize" Value="14" />


		<Setter Property="TextColor" Value="#334155" />


	</Style>









	<!--  =================================================  -->
	<!--  OPTIONAL SECTION HEADER  -->
	<!--  =================================================  -->


	<Style x:Key="SparkSectionHeader" TargetType="Label">


		<Setter Property="FontSize" Value="14" />


		<Setter Property="FontAttributes" Value="Bold" />


		<Setter Property="TextColor" Value="#475569" />


	</Style>









	<!--  =================================================  -->
	<!--  DARK MODE READY  -->
	<!--  =================================================  -->


	<Color x:Key="SparkDarkCardBackground">
		#111827
	</Color>


	<Color x:Key="SparkDarkContentBackground">
		#1F2937
	</Color>


	<Color x:Key="SparkDarkText">
		#F8FAFC
	</Color>



</ResourceDictionary>