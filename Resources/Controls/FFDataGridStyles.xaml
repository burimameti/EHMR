<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls">



	<Style x:Key="GridHeaderLabelBase" TargetType="Label">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="CharacterSpacing" Value="0.6" />
		<Setter Property="TextTransform" Value="Uppercase" />
		<Setter Property="VerticalTextAlignment" Value="Center" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="LineBreakMode" Value="NoWrap" />
	</Style>

	<Style
		x:Key="GridHeaderLabelStyle"
		BasedOn="{StaticResource GridHeaderLabelBase}"
		TargetType="Label">
		<Setter Property="TextColor" Value="#64748B" />
	</Style>

	<Style
		x:Key="GridHeaderLabelStyleWhite"
		BasedOn="{StaticResource GridHeaderLabelBase}"
		TargetType="Label">
		<Setter Property="TextColor" Value="#FFFFFF" />
	</Style>

	<Style x:Key="FFDataGridProfessional" TargetType="controls:FFDataGrid">
		<Setter Property="SurfaceBackground" Value="#1F2633" />
		<Setter Property="HeaderBackground" Value="#1A202C" />
		<Setter Property="FooterBackground" Value="#1A202C" />
		<Setter Property="BorderBrush" Value="#2A3342" />
		<Setter Property="DividerBrush" Value="#2A3342" />
		<Setter Property="PrimaryTextColor" Value="#F8FAFC" />
		<Setter Property="SecondaryTextColor" Value="#94A3B8" />
		<Setter Property="MutedTextColor" Value="#64748B" />
		<Setter Property="CornerRadius" Value="12" />
	</Style>

	<Style x:Key="FFDataGridExecutive" TargetType="controls:FFDataGrid">
		<Setter Property="SurfaceBackground" Value="#FFFFFF" />
		<Setter Property="HeaderBackground" Value="#FAFAFA" />
		<Setter Property="FooterBackground" Value="#F4F4F5" />
		<Setter Property="BorderBrush" Value="#E4E4E7" />
		<Setter Property="DividerBrush" Value="#E4E4E7" />
		<Setter Property="PrimaryTextColor" Value="#09090B" />
		<Setter Property="SecondaryTextColor" Value="#52525B" />
		<Setter Property="MutedTextColor" Value="#71717A" />
		<Setter Property="CornerRadius" Value="10" />
	</Style>

	<Style x:Key="FFDataGridDark" TargetType="controls:FFDataGrid">
		<Setter Property="SurfaceBackground" Value="#0F0A2A" />
		<Setter Property="HeaderBackground" Value="#050212" />
		<Setter Property="FooterBackground" Value="#050212" />
		<Setter Property="BorderBrush" Value="#1E1548" />
		<Setter Property="DividerBrush" Value="#2E206A" />
		<Setter Property="PrimaryTextColor" Value="#F4F5FA" />
		<Setter Property="SecondaryTextColor" Value="#C7D2FE" />
		<Setter Property="MutedTextColor" Value="#818CF8" />
		<Setter Property="CornerRadius" Value="14" />
	</Style>

	<Style x:Key="FFDataGridPanda" TargetType="controls:FFDataGrid">
		<Setter Property="SurfaceBackground" Value="#FFFFFF" />
		<Setter Property="HeaderBackground" Value="#EEF5FD" />
		<Setter Property="FooterBackground" Value="#0F172A" />
		<Setter Property="BorderBrush" Value="#D9E2EC" />
		<Setter Property="DividerBrush" Value="#E5E7EB" />
		<Setter Property="PrimaryTextColor" Value="#1D2939" />
		<Setter Property="SecondaryTextColor" Value="#475467" />
		<Setter Property="MutedTextColor" Value="#98A2B3" />
		<Setter Property="CornerRadius" Value="6" />
	</Style>

</ResourceDictionary>