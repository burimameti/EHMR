<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="EHMR.Resources.Controls.CrudTimelineRow" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Name="Root">
    <Grid ColumnDefinitions="24,*" ColumnSpacing="8">
        <BoxView Grid.Column="0" Margin="0,-8" BackgroundColor="{StaticResource SidebarActiveBg}" HorizontalOptions="Center" IsVisible="{Binding ShowLine, Source={x:Reference Root}}" VerticalOptions="Fill" WidthRequest="1" ZIndex="0" />
        <Border Grid.Column="0" BackgroundColor="White" HeightRequest="10" HorizontalOptions="Center" Stroke="{StaticResource SidebarActiveBg}" StrokeShape="Ellipse" StrokeThickness="1.5" VerticalOptions="Center" WidthRequest="10" ZIndex="2" />
        <ContentView x:Name="RowContentHost" Grid.Column="1" />
    </Grid>
</ContentView>