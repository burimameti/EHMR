<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFTimePicker"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">
	<Grid RowDefinitions="Auto,*" RowSpacing="6">
		<Label Margin="4,0,0,0" FontAttributes="Bold" FontSize="13" IsVisible="{Binding HasLabel, Source={x:Reference Root}}" Text="{Binding Label, Source={x:Reference Root}}" TextColor="{StaticResource Gray700}" />
		<Border Grid.Row="1" Padding="0" BackgroundColor="White" HeightRequest="48" Stroke="{StaticResource Gray400}" StrokeShape="RoundRectangle 10" StrokeThickness="1">
			<Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBorderTapped" /></Border.GestureRecognizers>
			<Grid Padding="12,0" ColumnDefinitions="*,48">
				<Label x:Name="DisplayLabel" FontSize="14" InputTransparent="True" TextColor="{StaticResource InputText}" VerticalOptions="Center" />
				<TimePicker x:Name="InnerTimePicker" Grid.ColumnSpan="2" BackgroundColor="Transparent" Opacity="0" Time="{Binding SelectedTime, Source={x:Reference Root}, Mode=TwoWay}" PropertyChanged="InnerTimePicker_PropertyChanged" />
				<Label Grid.Column="1" FontFamily="FASolid" FontSize="13" HorizontalOptions="Center" InputTransparent="True" Text="&#xf017;" TextColor="#9CA3AF" VerticalOptions="Center" />
			</Grid>
		</Border>
	</Grid>
</ContentView>