<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFPicker"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">
	<Grid RowDefinitions="Auto,Auto" RowSpacing="4">
		<Label
			Margin="2,0,0,0"
			CharacterSpacing=".5"
			FontAttributes="Bold"
			FontSize="11"
			IsVisible="{Binding Label, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
			Text="{Binding Label, Source={x:Reference Root}}"
			TextColor="{StaticResource SparkTextSecondary}" />
		<Border
			Grid.Row="1"
			Padding="0"
			BackgroundColor="{StaticResource SparkContentBackground}"
			HeightRequest="44"
			Stroke="{StaticResource SparkBorderSubtle}"
			StrokeShape="RoundRectangle 4"
			StrokeThickness="1">
			<Grid ColumnDefinitions="*,36">
				<Picker
					x:Name="InnerPicker"
					Title="{Binding Placeholder, Source={x:Reference Root}}"
					Grid.ColumnSpan="2"
					Margin="8,0,30,0"
					BackgroundColor="Transparent"
					FontSize="12.5"
					ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
					SelectedIndex="{Binding SelectedIndex, Source={x:Reference Root}, Mode=TwoWay}"
					SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
					TextColor="{StaticResource SparkTextPrimary}"
					TitleColor="{StaticResource SparkTextMuted}"
					VerticalOptions="Fill" />
				<Border
					x:Name="ArrowButton"
					Grid.Column="1"
					Margin="0,5,5,5"
					BackgroundColor="{StaticResource SparkAccentTealBg}"
					StrokeShape="RoundRectangle 3"
					StrokeThickness="0">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Tapped="OnArrowTapped" />
					</Border.GestureRecognizers>
					<Label
						FontFamily="FASolid"
						FontSize="10"
						HorizontalOptions="Center"
						InputTransparent="True"
						Text="&#xf078;"
						TextColor="{StaticResource SparkAccentTealDark}"
						VerticalOptions="Center" />
				</Border>
			</Grid>
		</Border>
	</Grid>
</ContentView>