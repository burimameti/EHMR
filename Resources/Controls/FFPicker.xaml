<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFPicker"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Grid RowDefinitions="Auto,Auto" RowSpacing="5">

		<!--  Field label  -->
		<Label
			x:Name="FieldLabel"
			Margin="2,0,0,0"
			CharacterSpacing=".4"
			FontAttributes="Bold"
			FontSize="11"
			IsVisible="{Binding Label, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
			LineBreakMode="TailTruncation"
			MaxLines="1"
			Text="{Binding Label, Source={x:Reference Root}}"
			TextColor="{StaticResource SparkTextSecondary}" />

		<!--  Picker field  -->
		<Border
			x:Name="PickerBorder"
			Grid.Row="1"
			Padding="0"
			BackgroundColor="{StaticResource SparkContentBackground}"
			HeightRequest="44"
			Stroke="{StaticResource SparkBorder}"
			StrokeShape="RoundRectangle 8"
			StrokeThickness="1">

			<Border.GestureRecognizers>
				<PointerGestureRecognizer PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" />
			</Border.GestureRecognizers>

			<Grid ColumnDefinitions="*,34" ColumnSpacing="0">

				<!--  Invisible native picker: only provides the popup and tap target  -->
				<Picker
					x:Name="InnerPicker"
					Title=""
					Grid.ColumnSpan="2"
					BackgroundColor="Transparent"
					HorizontalOptions="Fill"
					Opacity="0.01"
					TextColor="Transparent"
					TitleColor="Transparent"
					VerticalOptions="Fill" />

				<!--  Displayed text: selected value, or placeholder when empty  -->
				<Label
					x:Name="ValueLabel"
					Grid.Column="0"
					Margin="12,0,2,0"
					FontAttributes="Bold"
					FontSize="13"
					InputTransparent="True"
					LineBreakMode="TailTruncation"
					MaxLines="1"
					VerticalOptions="Center" />

				<!--  Dropdown affordance  -->
				<Label
					x:Name="ArrowIcon"
					Grid.Column="1"
					FontFamily="FASolid"
					FontSize="9"
					HorizontalOptions="Center"
					InputTransparent="True"
					Text="&#xf078;"
					TextColor="{StaticResource SparkTextSecondary}"
					VerticalOptions="Center" />

			</Grid>
			<Border.Triggers>
				<DataTrigger Binding="{Binding IsPointerOver, Source={x:Reference Root}}" TargetType="Border" Value="True">
					<Setter Property="Stroke" Value="{StaticResource SparkAccentTeal}" />
					<Setter Property="StrokeThickness" Value="1.5" />
				</DataTrigger>
			</Border.Triggers>
		</Border>

	</Grid>
</ContentView>
