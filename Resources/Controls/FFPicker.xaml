<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="EHMR.Resources.Controls.FFPicker"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Grid RowDefinitions="Auto,Auto" RowSpacing="5">

		<Label
			Margin="2,0,0,0"
			CharacterSpacing=".4"
			FontAttributes="Bold"
			FontSize="11"
			IsVisible="{Binding Label, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
			LineBreakMode="TailTruncation"
			MaxLines="1"
			Text="{Binding Label, Source={x:Reference Root}}"
			TextColor="{StaticResource SparkTextSecondary}" />

		<Border
			Grid.Row="1"
			Padding="0"
			BackgroundColor="{StaticResource SparkContentBackground}"
			HeightRequest="44"
			Stroke="{StaticResource SparkBorder}"
			StrokeShape="RoundRectangle 8"
			StrokeThickness="1">

			<Picker
				x:Name="InnerPicker"
				Title="{Binding Placeholder, Source={x:Reference Root}}"
				Margin="8,0"
				BackgroundColor="Transparent"
				FontAttributes="Bold"
				FontSize="13"
				HorizontalOptions="Fill"
				ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
				ItemDisplayBinding="{Binding ItemDisplayBinding, Source={x:Reference Root}}"
				SelectedIndex="{Binding SelectedIndex, Source={x:Reference Root}, Mode=TwoWay}"
				SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
				TextColor="{StaticResource SparkTextPrimary}"
				TitleColor="{StaticResource SparkTextMuted}"
				VerticalOptions="Center" />

		</Border>
	</Grid>
</ContentView>