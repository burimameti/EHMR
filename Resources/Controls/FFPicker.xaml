<ContentView
	x:Class="EHMR.Resources.Controls.FFPicker"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Name="Root">

	<Grid RowDefinitions="18,40" RowSpacing="4">

		<Label
			Margin="2,0,0,0"
			CharacterSpacing=".5"
			FontAttributes="Bold"
			FontSize="11"
			Text="{Binding Label, Source={x:Reference Root}}"
			TextColor="{StaticResource Gray600}" />

		<Border
			Grid.Row="1"
			BackgroundColor="White"
			HeightRequest="40"
			Stroke="{StaticResource Gray300}"
			StrokeShape="RoundRectangle 0"
			StrokeThickness="1">

			<Grid Padding="8,0">

				<Picker
					x:Name="InnerPicker"
					BackgroundColor="Transparent"
					FontSize="12"
					ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
					SelectedIndex="{Binding SelectedIndex, Source={x:Reference Root}, Mode=TwoWay}"
					SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
					TextColor="{StaticResource Gray800}"
					TitleColor="{StaticResource Gray500}"
					VerticalOptions="Center" />

			</Grid>

		</Border>

	</Grid>

</ContentView>