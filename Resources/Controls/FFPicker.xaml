<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EHMR.Resources.Controls.FFPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid RowDefinitions="Auto,Auto" RowSpacing="5">

        <!-- Field label -->
        <Label
            x:Name="FieldLabel"
            Margin="2,0,0,0"
            CharacterSpacing=".4"
            FontAttributes="Bold"
            FontSize="11"
            IsVisible="{Binding Label, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
            LineBreakMode="TailTruncation"
            MaxLines="1"
            Text="{Binding Label, Source={x:Reference Root}}"
            TextColor="{StaticResource SparkTextSecondary}" />

        <!-- Professional compact picker field -->
        <Border
            x:Name="PickerBorder"
            Grid.Row="1"
            Padding="0"
            BackgroundColor="{StaticResource SparkContentBackground}"
            HeightRequest="42"
            Stroke="{StaticResource SparkAccentTealDark}"
            StrokeShape="RoundRectangle 7"
            StrokeThickness="1">

            <Grid ColumnDefinitions="*,34" ColumnSpacing="0">

                <Picker
                    x:Name="InnerPicker"
                    Grid.Column="0"
                    Margin="10,0,2,0"
                    BackgroundColor="Transparent"
                    FontAttributes="Bold"
                    FontSize="13"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
                    Title="{Binding Placeholder, Source={x:Reference Root}}"
                    TextColor="{StaticResource SparkTextPrimary}"
                    TitleColor="{StaticResource SparkTextMuted}"
                    VerticalOptions="Fill" />

                <!-- Dedicated dropdown affordance -->
                <Border
                    x:Name="ArrowButton"
                    Grid.Column="1"
                    Margin="2,5,5,5"
                    BackgroundColor="{StaticResource SparkAccentTealBg}"
                    HorizontalOptions="Fill"
                    StrokeShape="RoundRectangle 5"
                    StrokeThickness="0"
                    VerticalOptions="Fill">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnArrowTapped" />
                    </Border.GestureRecognizers>

                    <Label
                        x:Name="ArrowIcon"
                        FontFamily="FASolid"
                        FontSize="9"
                        HorizontalOptions="Center"
                        InputTransparent="True"
                        Text="&#xf078;"
                        TextColor="{StaticResource SparkAccentTealDark}"
                        VerticalOptions="Center" />
                </Border>

            </Grid>
        </Border>

    </Grid>
</ContentView>