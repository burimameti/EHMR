<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="EHMR.Resources.Controls.FFPicker2"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="Root">

    <Grid RowDefinitions="Auto,Auto" RowSpacing="5">
        <Label
            x:Name="FieldLabel"
            Margin="2,0,0,0"
            FontAttributes="Bold"
            FontSize="11"
            IsVisible="{Binding Label, Source={x:Reference Root}, Converter={StaticResource StringNotNullOrEmptyConverter}}"
            LineBreakMode="TailTruncation"
            MaxLines="1"
            Text="{Binding Label, Source={x:Reference Root}}"
            TextColor="{StaticResource SparkTextSecondary}" />

        <Border
            Grid.Row="1"
            BackgroundColor="{StaticResource SparkContentBackground}"
            HeightRequest="42"
            Stroke="{StaticResource SparkAccentTealDark}"
            StrokeShape="RoundRectangle 7"
            StrokeThickness="1">

            <Picker
                x:Name="InnerPicker"
                Margin="10,0,8,0"
                BackgroundColor="Transparent"
                FontAttributes="Bold"
                FontSize="13"
                HorizontalOptions="Fill"
                ItemsSource="{Binding ItemsSource, Source={x:Reference Root}}"
                SelectedItem="{Binding SelectedItem, Source={x:Reference Root}, Mode=TwoWay}"
                Title="{Binding Placeholder, Source={x:Reference Root}}"
                TitleColor="{StaticResource SparkTextMuted}"
                TextColor="{StaticResource SparkTextPrimary}"
                VerticalOptions="Fill" />
        </Border>
    </Grid>
</ContentView>