<!--  DashboardStyle.xaml  -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  Backgrounds  -->

	<Color x:Key="DashboardBackground">#F6F8FC</Color>
	<Color x:Key="DashboardCardColor">#FFFFFF</Color>

	<!--  Primary Typography  -->

	<Color x:Key="DashboardTitleColor">#0F172A</Color>

	<!--  Body  -->

	<Color x:Key="DashboardBodyColor">#475569</Color>

	<!--  Muted  -->

	<Color x:Key="DashboardMutedColor">#94A3B8</Color>

	<!--  Section Label  -->

	<Color x:Key="DashboardAccentColor">#5B5FEF</Color>

	<!--  Border  -->

	<Color x:Key="DashboardBorderColor">#E7ECF5</Color>

	<!--  Hover  -->

	<Color x:Key="DashboardSurface">#FAFBFE</Color>
	<Style x:Key="DashboardSectionCaption" TargetType="Label">

		<Setter Property="FontSize" Value="11" />

		<Setter Property="CharacterSpacing" Value="1.2" />

		<Setter Property="FontAttributes" Value="Bold" />

		<Setter Property="TextColor" Value="{StaticResource DashboardAccentColor}" />

		<Setter Property="TextTransform" Value="Uppercase" />

	</Style>



	<Style x:Key="DashboardHeading" TargetType="Label">

		<Setter Property="FontSize" Value="30" />

		<Setter Property="FontAttributes" Value="Bold" />

		<Setter Property="TextColor" Value="{StaticResource DashboardTitleColor}" />

	</Style>



	<Style x:Key="DashboardSubHeading" TargetType="Label">

		<Setter Property="FontSize" Value="18" />

		<Setter Property="FontAttributes" Value="Bold" />

		<Setter Property="TextColor" Value="{StaticResource DashboardTitleColor}" />

	</Style>



	<Style x:Key="DashboardBody" TargetType="Label">

		<Setter Property="FontSize" Value="14" />

		<Setter Property="TextColor" Value="{StaticResource DashboardBodyColor}" />

	</Style>



	<Style x:Key="DashboardMuted" TargetType="Label">

		<Setter Property="FontSize" Value="13" />

		<Setter Property="TextColor" Value="{StaticResource DashboardMutedColor}" />

	</Style>
</ResourceDictionary>