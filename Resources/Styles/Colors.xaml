<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->
	<x:Double x:Key="SpaceXs">4</x:Double>
	<x:Double x:Key="SpaceSm">8</x:Double>
	<x:Double x:Key="SpaceMd">16</x:Double>
	<x:Double x:Key="SpaceLg">24</x:Double>
	<x:Double x:Key="SpaceXl">32</x:Double>

	<x:Double x:Key="RadiusSm">8</x:Double>
	<x:Double x:Key="RadiusMd">12</x:Double>
	<x:Double x:Key="RadiusLg">16</x:Double>
	<x:Double x:Key="RadiusXl">20</x:Double>
	<Color x:Key="Primary">#2563EB</Color>
	<Color x:Key="PrimaryHover">#1D4ED8</Color>
	<Color x:Key="PrimaryLight">#DBEAFE</Color>

	<!-- SURFACES -->
	<Color x:Key="Background">#F8FAFC</Color>
	<Color x:Key="Surface">#FFFFFF</Color>
	<Color x:Key="SurfaceAlt">#F1F5F9</Color>

	<!-- BORDERS -->
	<Color x:Key="Border">#E2E8F0</Color>
	<Color x:Key="BorderStrong">#CBD5E1</Color>

	<!-- TEXT -->
	<Color x:Key="TextPrimary">#0F172A</Color>
	<Color x:Key="TextSecondary">#475569</Color>
	<Color x:Key="TextMuted">#94A3B8</Color>

	<!-- STATUS -->
	<Color x:Key="Success">#16A34A</Color>
	<Color x:Key="SuccessBg">#DCFCE7</Color>

	<Color x:Key="Warning">#D97706</Color>
	<Color x:Key="WarningBg">#FEF3C7</Color>

	<Color x:Key="Danger">#DC2626</Color>
	<Color x:Key="DangerBg">#FEE2E2</Color>

	<Color x:Key="Info">#0284C7</Color>
	<Color x:Key="InfoBg">#E0F2FE</Color>

	<Color x:Key="PrimaryDark">#ac99ea</Color>
	<Color x:Key="PrimaryDarkText">#242424</Color>
	<Color x:Key="Secondary">#DFD8F7</Color>
	<Color x:Key="SecondaryDarkText">#9880e5</Color>
	<Color x:Key="Tertiary">#2B0B98</Color>

	<Color x:Key="White">White</Color>
	<Color x:Key="Black">Black</Color>
	<Color x:Key="Magenta">#D600AA</Color>
	<Color x:Key="MidnightBlue">#190649</Color>
	<Color x:Key="OffBlack">#1f1f1f</Color>

	<Color x:Key="Gray100">#E1E1E1</Color>
	<Color x:Key="Gray200">#C8C8C8</Color>
	<Color x:Key="Gray300">#ACACAC</Color>
	<Color x:Key="Gray400">#919191</Color>
	<Color x:Key="Gray500">#6E6E6E</Color>
	<Color x:Key="Gray600">#404040</Color>
	<Color x:Key="Gray900">#212121</Color>
	<Color x:Key="Gray950">#141414</Color>

	<SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
	<SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
	<SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
	<SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
	<SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

	<SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
	<SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
	<SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
	<SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
	<SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
	<SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
	<SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
	<SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
	<Style x:Key="PageHeader"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="{StaticResource Surface}" />

		<Setter Property="Stroke"
            Value="{StaticResource Border}" />

		<Setter Property="StrokeThickness"
            Value="1" />
	</Style>

	<Style x:Key="SearchContainer"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="{StaticResource SurfaceAlt}" />

		<Setter Property="Stroke"
            Value="{StaticResource Border}" />

		<Setter Property="HeightRequest"
            Value="44" />

		<Setter Property="Padding"
            Value="14,0" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="12" />
		</Setter
>
	</Style>
	<Style x:Key="PageBackgroundStyle"
   TargetType="Grid">
		<Setter Property="BackgroundColor"
        Value="{StaticResource Background}" />
	</Style>

	<Style x:Key="CardBorderStyle"
   TargetType="Border">

		<Setter Property="BackgroundColor"
        Value="{StaticResource Surface}" />

		<Setter Property="Stroke"
        Value="{StaticResource Border}" />

		<Setter Property="StrokeThickness"
        Value="1" />

		<Setter Property="Padding"
        Value="20" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="16" />
		</Setter>
	</Style>
	<Style x:Key="PageTitleStyle"
   TargetType="Label">

		<Setter Property="FontSize"
        Value="28" />

		<Setter Property="FontAttributes"
        Value="Bold" />

		<Setter Property="TextColor"
        Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="SectionTitleStyle"
   TargetType="Label">

		<Setter Property="FontSize"
        Value="18" />

		<Setter Property="FontAttributes"
        Value="Bold" />

		<Setter Property="TextColor"
        Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="CaptionStyle"
   TargetType="Label">

		<Setter Property="FontSize"
        Value="12" />

		<Setter Property="TextColor"
        Value="{StaticResource TextSecondary}" />

		<Setter Property="CharacterSpacing"
        Value="0.5" />
	</Style>
	<Style x:Key="PrimaryButtonStyle"
       TargetType="Button">

		<Setter Property="BackgroundColor"
            Value="{StaticResource Primary}" />

		<Setter Property="TextColor"
            Value="White" />

		<Setter Property="CornerRadius"
            Value="10" />

		<Setter Property="HeightRequest"
            Value="42" />

		<Setter Property="FontAttributes"
            Value="Bold" />
	</Style>

	<Style x:Key="SecondaryButtonStyle"
       TargetType="Button">

		<Setter Property="BackgroundColor"
            Value="{StaticResource Surface}" />

		<Setter Property="TextColor"
            Value="{StaticResource TextPrimary}" />

		<Setter Property="BorderColor"
            Value="{StaticResource BorderStrong}" />

		<Setter Property="BorderWidth"
            Value="1" />

		<Setter Property="CornerRadius"
            Value="10" />
	</Style>
	<Style x:Key="DangerButtonStyle"
       TargetType="Button">

		<Setter Property="BackgroundColor"
            Value="{StaticResource Danger}" />

		<Setter Property="TextColor"
            Value="White" />
	</Style>

	<Style x:Key="InputBorderStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="White" />

		<Setter Property="Stroke"
            Value="{StaticResource BorderStrong}" />

		<Setter Property="Padding"
            Value="10,0" />

		<Setter Property="HeightRequest"
            Value="42" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="10" />
		</Setter>
	</Style>

	<Style x:Key="GridHeaderStyle"
       TargetType="Border">
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
					<GradientStop Color="#F2F2F2" Offset="0" />
					<GradientStop Color="#AAAAAA" Offset="0.5" />
					<GradientStop Color="#FFFFFF" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
		<Setter Property="StrokeThickness"             Value="1" />
		<Setter Property="StrokeShape"        Value="RoundRectangle 16" />
		<Setter Property="Stroke"            Value="{StaticResource MidnightBlue}" />
		<Setter Property="Margin"  Value="8,8,0,8" />
		<Setter Property="Padding"             Value="6" />
	</Style>

	<Style x:Key="GridHeaderTextStyle"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="12" />

		<Setter Property="FontAttributes"
            Value="Bold" />

		<Setter Property="TextColor"
            Value="#334155" />

		<Setter Property="TextTransform"
            Value="Uppercase" />
	</Style>

	<Style x:Key="SelectedRowStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="#EFF6FF" />

		<Setter Property="Stroke"
            Value="#93C5FD" />
	</Style>

	<Style x:Key="TabButtonStyle"
       TargetType="Button">

		<Setter Property="BackgroundColor"
            Value="Transparent" />

		<Setter Property="TextColor"
            Value="{StaticResource TextSecondary}" />

		<Setter Property="CornerRadius"
            Value="10" />
	</Style>

	<Style x:Key="ActiveTabButtonStyle"
       TargetType="Button">

		<Setter Property="BackgroundColor"
            Value="{StaticResource PrimaryLight}" />

		<Setter Property="TextColor"
            Value="{StaticResource Primary}" />

		<Setter Property="FontAttributes"
            Value="Bold" />
	</Style>

	<Style x:Key="SuccessPillStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="{StaticResource SuccessBg}" />
	</Style>
	<Style x:Key="WarningPillStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="{StaticResource WarningBg}" />
	</Style>
	<Style x:Key="DangerPillStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="{StaticResource DangerBg}" />
	</Style>
	<Style x:Key="MetricCardStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="White" />

		<Setter Property="Padding"
            Value="20" />

		<Setter Property="Stroke"
            Value="{StaticResource Border}" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="16" />
		</Setter>
	</Style>

	<Style x:Key="SurfaceCard"
       TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
		<Setter Property="Stroke" Value="{StaticResource Border}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="20" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="16" />
		</Setter>
	</Style>

	<Style x:Key="SurfaceCardCompact"
       BasedOn="{StaticResource SurfaceCard}"
       TargetType="Border">
		<Setter Property="Padding" Value="12" />
	</Style>

	<Style x:Key="PageHeaderContainer"
       TargetType="Border">

		<Setter Property="BackgroundColor" Value="White" />
		<Setter Property="Stroke" Value="{StaticResource Border}" />

		<Setter Property="Padding" Value="24,16" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="14" />
		</Setter>
	</Style>

	<Style x:Key="PageHeaderTitle"
       TargetType="Label">

		<Setter Property="FontSize" Value="26" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="PageHeaderSubtitle"
       TargetType="Label">

		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
	</Style>
	<Style x:Key="ToolbarContainer"
       TargetType="Border">

		<Setter Property="BackgroundColor" Value="#F8FAFC" />
		<Setter Property="Stroke" Value="{StaticResource Border}" />
		<Setter Property="Padding" Value="16" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="12" />
		</Setter>
	</Style>
	<Style x:Key="H1"
       TargetType="Label">
		<Setter Property="FontSize" Value="32" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="H2"
       TargetType="Label">
		<Setter Property="FontSize" Value="24" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="H3"
       TargetType="Label">
		<Setter Property="FontSize" Value="20" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="Body"
       TargetType="Label">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="MutedText"
       TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource TextMuted}" />
	</Style>
	<Style x:Key="SectionCard"
       BasedOn="{StaticResource SurfaceCard}"
       TargetType="Border">
		<Setter Property="Margin" Value="0,0,0,16" />
	</Style>

	<Style x:Key="ElevatedCard"
       BasedOn="{StaticResource SurfaceCard}"
       TargetType="Border">
		<Setter Property="Shadow">
			<Shadow Radius="12"
                Opacity="0.08"
                Offset="0,4" />
		</Setter>
	</Style>

	<Style x:Key="InputLabel"
       TargetType="Label">

		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="#475569" />
		<Setter Property="CharacterSpacing" Value="0.5" />
	</Style>

	<Style x:Key="InputEntry"
       TargetType="Entry">

		<Setter Property="TextColor"
            Value="{StaticResource TextPrimary}" />

		<Setter Property="FontSize"
            Value="14" />

		<Setter Property="BackgroundColor"
            Value="Transparent" />
	</Style>

	<Style x:Key="InputPicker"
       TargetType="Picker">

		<Setter Property="TextColor"
            Value="{StaticResource TextPrimary}" />

		<Setter Property="BackgroundColor"
            Value="Transparent" />
	</Style>

	<Style x:Key="GridRowStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="White" />

		<Setter Property="Stroke"
            Value="#F1F5F9" />

		<Setter Property="Padding"
            Value="10" />
	</Style>

	<Style x:Key="GridAlternateRowStyle"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="#FAFBFC" />

		<Setter Property="Stroke"
            Value="#F1F5F9" />
	</Style>
	<Style x:Key="MetricTitle"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="13" />

		<Setter Property="TextColor"
            Value="{StaticResource TextSecondary}" />
	</Style>

	<Style x:Key="MetricValue"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="32" />

		<Setter Property="FontAttributes"
            Value="Bold" />

		<Setter Property="TextColor"
            Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="MetricChange"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="12" />

		<Setter Property="FontAttributes"
            Value="Bold" />
	</Style>

	<Style x:Key="StatusChipText"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="11" />

		<Setter Property="FontAttributes"
            Value="Bold" />
	</Style>

	<Style x:Key="SuccessChipText"
       BasedOn="{StaticResource StatusChipText}"
       TargetType="Label">
		<Setter Property="TextColor"
            Value="{StaticResource Success}" />
	</Style>

	<Style x:Key="WarningChipText"
       BasedOn="{StaticResource StatusChipText}"
       TargetType="Label">
		<Setter Property="TextColor"
            Value="{StaticResource Warning}" />
	</Style>

	<Style x:Key="DangerChipText"
       BasedOn="{StaticResource StatusChipText}"
       TargetType="Label">
		<Setter Property="TextColor"
            Value="{StaticResource Danger}" />
	</Style>
	<Style x:Key="ToolbarButton"
       BasedOn="{StaticResource SecondaryButtonStyle}"
       TargetType="Button">

		<Setter Property="HeightRequest"
            Value="36" />

		<Setter Property="Padding"
            Value="12,0" />
	</Style>
	<Style x:Key="IconButton"
       TargetType="ImageButton">

		<Setter Property="BackgroundColor"
            Value="Transparent" />

		<Setter Property="HeightRequest"
            Value="36" />

		<Setter Property="WidthRequest"
            Value="36" />
	</Style>
	<Style x:Key="ModalCard"
       TargetType="Border">

		<Setter Property="BackgroundColor"
            Value="White" />

		<Setter Property="Padding"
            Value="24" />

		<Setter Property="MaximumWidthRequest"
            Value="900" />

		<Setter Property="Stroke"
            Value="{StaticResource Border}" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="20" />
		</Setter>
	</Style>
	<Style x:Key="EmptyStateTitle"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="18" />

		<Setter Property="FontAttributes"
            Value="Bold" />

		<Setter Property="HorizontalTextAlignment"
            Value="Center" />
	</Style>

	<Style x:Key="EmptyStateText"
       TargetType="Label">

		<Setter Property="FontSize"
            Value="13" />

		<Setter Property="TextColor"
            Value="{StaticResource TextSecondary}" />

		<Setter Property="HorizontalTextAlignment"
            Value="Center" />
	</Style>

	<Style x:Key="StatCard"
       BasedOn="{StaticResource SurfaceCard}"
       TargetType="Border">

		<Setter Property="Padding"
            Value="24" />

		<Setter Property="MinimumHeightRequest"
            Value="120" />

		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="20" />
		</Setter>

		<Setter Property="Shadow">
			<Shadow Radius="12"
                Offset="0,4"
                Opacity="0.08" />
		</Setter>
	</Style>
</ResourceDictionary>