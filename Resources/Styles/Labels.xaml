<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  =========================================================  -->
	<!--  PAGE  -->
	<!--  =========================================================  -->




	<!--  =========================================================  -->
	<!--  SECTION  -->
	<!--  =========================================================  -->


	<Style x:Key="SectionSubtitleLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyDefault}" />
		<Setter Property="FontSize" Value="{StaticResource SectionSubtitleSize}" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
	</Style>

	<!--  =========================================================  -->
	<!--  CARD  -->
	<!--  =========================================================  -->

	<Style x:Key="CardTitleLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyMedium}" />
		<Setter Property="FontSize" Value="{StaticResource CardTitleSize}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="CardSubtitleLabel" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource CardSubtitleSize}" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
	</Style>

	<!--  =========================================================  -->
	<!--  FORM  -->
	<!--  =========================================================  -->

	<Style x:Key="FormLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyMedium}" />
		<Setter Property="FontSize" Value="{StaticResource FormLabelSize}" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
		<Setter Property="Margin" Value="0,0,0,4" />
	</Style>

	<Style x:Key="FormHintLabel" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource FormHelperSize}" />
		<Setter Property="TextColor" Value="{StaticResource TextMuted}" />
	</Style>

	<Style x:Key="ValidationErrorLabel" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource ValidationSize}" />
		<Setter Property="TextColor" Value="{StaticResource Danger}" />
	</Style>

	<Style x:Key="ValidationSuccessLabel" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource ValidationSize}" />
		<Setter Property="TextColor" Value="{StaticResource Success}" />
	</Style>

	<!--  =========================================================  -->
	<!--  GRID  -->
	<!--  =========================================================  -->



	<Style x:Key="GridPrimaryLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyMedium}" />
		<Setter Property="FontSize" Value="{StaticResource GridCellSize}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
	</Style>

	<Style x:Key="GridSecondaryLabel" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource GridSecondarySize}" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
	</Style>

	<Style x:Key="GridMutedLabel" TargetType="Label">
		<Setter Property="FontSize" Value="{StaticResource GridSecondarySize}" />
		<Setter Property="TextColor" Value="{StaticResource TextMuted}" />
	</Style>




	<!--  =========================================================  -->
	<!--  KPI  -->
	<!--  =========================================================  -->






	<!--  =========================================================  -->
	<!--  STATUS  -->
	<!--  =========================================================  -->

	<Style x:Key="StatusLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyMedium}" />
		<Setter Property="FontSize" Value="{StaticResource StatusSize}" />
	</Style>

	<Style x:Key="BadgeLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyBold}" />
		<Setter Property="FontSize" Value="{StaticResource BadgeSize}" />
		<Setter Property="HorizontalTextAlignment" Value="Center" />
		<Setter Property="VerticalTextAlignment" Value="Center" />
	</Style>

	<!--  =========================================================  -->
	<!--  TIMELINE  -->
	<!--  =========================================================  -->




	<!--  =========================================================  -->
	<!--  DIALOG  -->
	<!--  =========================================================  -->




	<!--  =========================================================  -->
	<!--  EMPTY  -->
	<!--  =========================================================  -->




	<!--  =========================================================  -->
	<!--  UTILITY  -->
	<!--  =========================================================  -->



	<Style x:Key="LinkLabel" TargetType="Label">
		<Setter Property="FontFamily" Value="{StaticResource FontFamilyMedium}" />
		<Setter Property="TextColor" Value="{StaticResource EhmrPrimary}" />
	</Style>

</ResourceDictionary>