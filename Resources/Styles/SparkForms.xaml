<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!--  ============================================================  -->
	<!--  LAYOUT CONSTANTS — change once, every form updates  -->
	<!--  ============================================================  -->
	<x:Double x:Key="FormLabelColumnWidth">130</x:Double>
	<x:Double x:Key="FormRowSpacing">14</x:Double>
	<Thickness x:Key="FormRowPadding">10</Thickness>
	<Thickness x:Key="PageContentMargin">12,0,12,12</Thickness>
	<x:Double x:Key="PageSectionSpacing">8</x:Double>
	<x:Double x:Key="ControlCornerRadius">6</x:Double>
	<Thickness x:Key="CrudPageHorizontalMargin">18,0</Thickness>
	<Thickness x:Key="CrudCardPadding">18</Thickness>
	<Thickness x:Key="CrudSectionMargin">18,0,18,14</Thickness>

	<!--  ============================================================  -->
	<!--  COMMON SHADOWS (Дефиниција за меки сенки кои даваат длабочина)  -->
	<!--  ============================================================  -->
	<Shadow
		x:Key="SoftCardShadow"
		Brush="#000000"
		Opacity="0.06"
		Radius="10"
		Offset="0,4" />

	<Shadow
		x:Key="InputShadow"
		Brush="#000000"
		Opacity="0.055"
		Radius="8"
		Offset="0,3" />

	<!--  ============================================================  -->
	<!--  PAGE CHROME — Префинет изглед со заоблени агли и меки сенки  -->
	<!--  ============================================================  -->
	<Style x:Key="PageHeaderCardStyle" TargetType="Border">
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,0,0,0" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>

	<Style x:Key="FormWorkspaceCardStyle" TargetType="Border">
		<Setter Property="Padding" Value="18" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Stroke" Value="{StaticResource BorderColor}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<!--  Единствена геометрија за CRUD листи: search/filter и grid се одделни карти.  -->
	<!--  Unified read-only value surfaces used by detail pages.  -->
	<Style x:Key="DetailValueSurfaceStyle" TargetType="Border">
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="MinimumHeightRequest" Value="40" />
		<Setter Property="BackgroundColor" Value="#F1F5F9" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 4" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<Style
		x:Key="DetailValueSurfaceLargeStyle"
		BasedOn="{StaticResource DetailValueSurfaceStyle}"
		TargetType="Border">
		<Setter Property="Padding" Value="14,12" />
		<Setter Property="MinimumHeightRequest" Value="72" />
	</Style>
	<Style x:Key="MetricStyle" TargetType="Border">
		<Setter Property="Padding" Value="0,0" />

		<Setter Property="BackgroundColor" Value="{StaticResource SparkContentBackground}" />
		<Setter Property="Stroke" Value="#FFFFFF" />
		<Setter Property="StrokeShape" Value="RoundRectangle 0" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<!--  Единствена геометрија за сите list/registry страници.  -->
	<Style x:Key="ListPageRootGridStyle" TargetType="Grid">
		<Setter Property="Margin" Value="0" />
		<Setter Property="RowSpacing" Value="0" />
	</Style>
	<Style x:Key="ListPageContentStackStyle" TargetType="VerticalStackLayout">
		<Setter Property="Padding" Value="0,0,0,0" />
		<Setter Property="Spacing" Value="0" />
	</Style>
	<Style x:Key="PageHeaderCardStyle1" TargetType="Border">
		<Setter Property="Padding" Value="16,18" />

		<Setter Property="BackgroundColor" Value="{StaticResource SparkContentBackground}" />
		<Setter Property="Stroke" Value="#DCE5EE" />
		<Setter Property="StrokeShape" Value="RoundRectangle 14" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<Style x:Key="AvatarCircleStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="White" />
		<Setter Property="HeightRequest" Value="54" />
		<Setter Property="WidthRequest" Value="54" />
		<Setter Property="Stroke" Value="{StaticResource BorderColor}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 27" />
		<!--  Совршен круг  -->
		<Setter Property="StrokeThickness" Value="1" />
	</Style>

	<Style x:Key="AvatarGlyphStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="18" />
		<Setter Property="HorizontalOptions" Value="Center" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
	</Style>

	<Style x:Key="PageTitleStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontSize" Value="22" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
	</Style>

	<Style x:Key="WorkspaceCardStyle" TargetType="Border">
		<Setter Property="Padding" Value="12" />
		<Setter Property="BackgroundColor" Value="#F3F6FA" />
		<Setter Property="Stroke" Value="#E2E8F0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 16" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{StaticResource SoftCardShadow}" />
	</Style>

	<!--  Vertical structure marker shared by multi-column forms.  -->
	<Style x:Key="ColumnDividerStyle" TargetType="BoxView">
		<Setter Property="WidthRequest" Value="2" />
		<Setter Property="VerticalOptions" Value="Fill" />
		<Setter Property="Color" Value="#9ADBD3" />
		<Setter Property="Opacity" Value="0.72" />
	</Style>

	<!--  Neutral horizontal separator for cards and form groups.  -->
	<Style x:Key="HorizontalFormDividerStyle" TargetType="BoxView">
		<Setter Property="HeightRequest" Value="1" />
		<Setter Property="HorizontalOptions" Value="Fill" />
		<Setter Property="Color" Value="#DDE6EC" />
	</Style>

	<!--  Clean section title, full-width filled rectangle bar.  -->
	<Style x:Key="SectionPillBorderStyle" TargetType="Border">
		<Setter Property="Padding" Value="12,9" />
		<Setter Property="BackgroundColor" Value="#4A5863" />


		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="Rectangle" />
		<Setter Property="Shadow" Value="{x:Null}" />
		<Setter Property="HorizontalOptions" Value="Fill" />
	</Style>

	<Style x:Key="SectionPillLabelStyle" TargetType="Label">
		<Setter Property="CharacterSpacing" Value="0.2" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="HorizontalOptions" Value="Start" />
	</Style>

	<!--  ============================================================  -->
	<!--  READ-MODE ROW  -->
	<!--  ============================================================  -->
	<Style x:Key="ReadRowLabelStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="ReadRowValueStyle" TargetType="Label">
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="Padding" Value="0" />
	</Style>

	<!--  ============================================================  -->
	<!--  EDIT-MODE INPUTS — Модернизирани со сенка, рамка и заобленост  -->
	<!--  ============================================================  -->
	<Style x:Key="EditFieldLabelStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{StaticResource SubtitleColor}" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="Margin" Value="0,0,0,5" />
	</Style>

	<Style x:Key="EditFieldBoxStyle" TargetType="Border">
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="HeightRequest" Value="46" />
		<Setter Property="Stroke" Value="{StaticResource BorderColor}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 4" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>

	<Style
		x:Key="TextAreaFieldBoxStyle"
		BasedOn="{StaticResource EditFieldBoxStyle}"
		TargetType="Border">
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="HeightRequest" Value="90" />
	</Style>

	<Style
		x:Key="CompactFieldBoxStyle"
		BasedOn="{StaticResource EditFieldBoxStyle}"
		TargetType="Border">
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<Style x:Key="FieldBoxValueStyle" TargetType="Label">
		<Setter Property="Margin" Value="0" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="FieldBoxChevronStyle" TargetType="Label">
		<Setter Property="Margin" Value="0,0,4,0" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Text" Value="▼" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<Style x:Key="FieldBoxCalendarIconStyle" TargetType="Label">
		<Setter Property="Margin" Value="0,0,4,0" />
		<Setter Property="FontFamily" Value="FASolid" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Text" Value="&#xf073;" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<!--  ============================================================  -->
	<!--  INFO PILL — За преглед на веќе внесени селектирани вредности  -->
	<!--  ============================================================  -->
	<Style x:Key="InfoPillBorderStyle" TargetType="Border">
		<Setter Property="Padding" Value="12,6" />
		<Setter Property="BackgroundColor" Value="White" />
		<Setter Property="HorizontalOptions" Value="Start" />
		<Setter Property="Stroke" Value="{StaticResource BorderColor}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 20" />
		<!--  Претворено во Pill  -->
		<Setter Property="StrokeThickness" Value="1" />
	</Style>
	<Style x:Key="InfoPillIconStyle" TargetType="Label">
		<Setter Property="FontFamily" Value="FASolid" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
	</Style>
	<Style x:Key="InfoPillTextStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
	</Style>

	<!--  ============================================================  -->
	<!--  SEARCH DROPDOWNS & TOKENS  -->
	<!--  ============================================================  -->
	<Style x:Key="SearchDropdownBorderStyle" TargetType="Border">
		<Setter Property="Padding" Value="6" />
		<Setter Property="BackgroundColor" Value="#F3F6FA" />
		<Setter Property="MaximumHeightRequest" Value="200" />
		<Setter Property="Stroke" Value="#E2E8F0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 14" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{StaticResource SoftCardShadow}" />
	</Style>

	<Style x:Key="TokenChipBorderStyle" TargetType="Border">
		<Setter Property="Padding" Value="12,6" />
		<Setter Property="BackgroundColor" Value="#4A5863" />
		<Setter Property="Stroke" Value="{StaticResource BorderColor}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 20" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>

	<!--
		Овие два ги бараат Spark шаблоните за полиња (Combo, Currency, Date, Lookup…)
		но никаде не беа дефинирани — нерешен StaticResource фрла при исцртување
		на формата.
	-->
	<Style x:Key="SparkFieldLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="Margin" Value="0,0,0,4" />
	</Style>

	<Style x:Key="SparkLookupButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource SparkButtonPrimaryBg}" />
		<Setter Property="TextColor" Value="#FFFFFF" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="HeightRequest" Value="38" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="12,0" />
	</Style>

</ResourceDictionary>
