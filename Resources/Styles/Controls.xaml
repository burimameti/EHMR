<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
	<Style x:Key="OutlineButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
		<Setter Property="TextColor" Value="{StaticResource EpicPrimary}" />
		<Setter Property="BorderColor" Value="{StaticResource EpicPrimary}" />
		<Setter Property="BorderWidth" Value="1.5" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>
	<Style
		x:Key="AccentCardStyle"
		BasedOn="{StaticResource AppCardStyle}"
		TargetType="Border">
		<Setter Property="Stroke" Value="{StaticResource SurfaceBorder}" />
	</Style>
	<Style x:Key="PrimaryButtonStyle" TargetType="Button">

		<Setter Property="TextColor" Value="White" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="HeightRequest" Value="36" />
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup x:Name="CommonStates">
					<VisualState x:Name="Normal">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{StaticResource ChartBlue}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="PointerOver">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{StaticResource EpicPrimaryDark}" />
						</VisualState.Setters>
					</VisualState>
					<VisualState x:Name="Pressed">
						<VisualState.Setters>
							<Setter Property="BackgroundColor" Value="{StaticResource EpicPrimaryDark}" />
							<Setter Property="Scale" Value="0.97" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>

	<!--  в”Ђв”Ђ GHOST BUTTON в”Ђв”Ђ  -->
	<Style x:Key="GhostButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
		<Setter Property="BorderColor" Value="{StaticResource SurfaceBorder}" />
		<Setter Property="BorderWidth" Value="1" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<!--  в”Ђв”Ђ DANGER BUTTON в”Ђв”Ђ  -->
	<Style x:Key="DangerButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Danger}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<!--  в”Ђв”Ђ ENTRY в”Ђв”Ђ  -->
	<Style TargetType="Entry">
		<Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource TextPlaceholder}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<!--  в”Ђв”Ђ EDITOR в”Ђв”Ђ  -->
	<Style TargetType="Editor">
		<Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource TextPlaceholder}" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<!--  в”Ђв”Ђ PICKER в”Ђв”Ђ  -->
	<Style TargetType="Picker">
		<Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="TitleColor" Value="{StaticResource TextPlaceholder}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<!--  в”Ђв”Ђ DATE PICKER в”Ђв”Ђ  -->
	<Style TargetType="DatePicker">
		<Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<!--  в”Ђв”Ђ LABEL INPUT FORM в”Ђв”Ђ  -->
	<Style x:Key="FormLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="TextTransform" Value="Uppercase" />
		<Setter Property="CharacterSpacing" Value="0.5" />
	</Style>

	<!--  в”Ђв”Ђ INPUT BORDER FRAME в”Ђв”Ђ  -->
	<Style x:Key="InputBorderStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="{StaticResource InputBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<!--  в”Ђв”Ђ CARD в”Ђв”Ђ  -->
	<Style x:Key="CardStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="{StaticResource SurfaceBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 10" />
		<Setter Property="Padding" Value="20" />
	</Style>

	<!--  в”Ђв”Ђ STAT CARD в”Ђв”Ђ  -->
	<Style x:Key="StatCardStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource CardBg}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="{StaticResource SurfaceBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 10" />
		<Setter Property="Padding" Value="16,14" />
		<Setter Property="MinimumWidthRequest" Value="160" />
	</Style>

	<!--  в”Ђв”Ђ STATUS PILL в”Ђв”Ђ  -->
	<Style x:Key="StatusPillStyle" TargetType="Border">
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="Padding" Value="10,3" />
		<Setter Property="HorizontalOptions" Value="Start" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<!--  в”Ђв”Ђ SEPARATOR в”Ђв”Ђ  -->
	<Style x:Key="SeparatorStyle" TargetType="BoxView">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceBorder}" />
		<Setter Property="HeightRequest" Value="2" />
		<Setter Property="HorizontalOptions" Value="Fill" />
	</Style>

	<!--  в”Ђв”Ђ SEARCH BAR в”Ђв”Ђ  -->
	<Style TargetType="SearchBar">
		<Setter Property="BackgroundColor" Value="{StaticResource InputBg}" />
		<Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource TextPlaceholder}" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<!--  в”Ђв”Ђ COLLECTIONVIEW в”Ђв”Ђ  -->
	<Style TargetType="CollectionView">
		<Setter Property="BackgroundColor" Value="Transparent" />
	</Style>

	<!--  в”Ђв”Ђ SCROLLVIEW в”Ђв”Ђ  -->
	<Style TargetType="ScrollView">
		<Setter Property="BackgroundColor" Value="Transparent" />
	</Style>

	<!--  в”Ђв”Ђ CHECKBOX в”Ђв”Ђ  -->
	<Style TargetType="CheckBox">
		<Setter Property="Color" Value="{StaticResource EpicPrimary}" />
	</Style>

	<!--  в”Ђв”Ђ SWITCH в”Ђв”Ђ  -->
	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="{StaticResource EpicPrimary}" />
		<Setter Property="ThumbColor" Value="White" />
	</Style>

	<!--  в”Ђв”Ђ PROGRESS BAR в”Ђв”Ђ  -->
	<Style TargetType="ProgressBar">
		<Setter Property="ProgressColor" Value="{StaticResource EpicPrimary}" />
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}" />
	</Style>

	<!--  в”Ђв”Ђ ICON BUTTON (small action) в”Ђв”Ђ  -->
	<Style x:Key="IconButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{StaticResource TextMuted}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Padding" Value="6" />
		<Setter Property="WidthRequest" Value="30" />
		<Setter Property="HeightRequest" Value="30" />
		<Setter Property="CornerRadius" Value="4" />
	</Style>

	<!--  в”Ђв”Ђ TAB BUTTON в”Ђв”Ђ  -->
	<Style x:Key="TabButtonStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{StaticResource TextMuted}" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="BorderWidth" Value="0" />
	</Style>

	<Style x:Key="TabButtonActiveStyle" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource EpicPrimary}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="BorderWidth" Value="0" />
	</Style>
</ResourceDictionary>