<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
	<!--  =========================================================  -->
	<!--  BUTTON BASE  -->
	<!--  =========================================================  -->

	<Style x:Key="BaseButtonStyle" TargetType="Button">

		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="40" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="BorderWidth" Value="0" />

	</Style>

	<Style x:Key="IconButtonStyle" TargetType="Button">

		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="Padding" Value="6" />
		<Setter Property="WidthRequest" Value="30" />
		<Setter Property="HeightRequest" Value="30" />
		<Setter Property="CornerRadius" Value="4" />

	</Style>

	<Style
		x:Key="TabButtonStyle"
		BasedOn="{StaticResource BaseButtonStyle}"
		TargetType="Button">

		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="Padding" Value="16,8" />

	</Style>

	<Style
		x:Key="TabButtonActiveStyle"
		BasedOn="{StaticResource BaseButtonStyle}"
		TargetType="Button">

		<Setter Property="BackgroundColor" Value="#2AEBE7" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="Padding" Value="16,8" />


	</Style>
	<!--  =========================================================  -->
	<!--  INPUT CONTROLS  -->
	<!--  =========================================================  -->
	<Style x:Key="PageHeaderTitleStyle" TargetType="Label">
		<Setter Property="FontSize" Value="28" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="#0F172A" />
	</Style>

	<Style x:Key="PageHeaderSubtitleStyle" TargetType="Label">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
		<Setter Property="MaxLines" Value="2" />
	</Style>

	<Style
		x:Key="PageHeaderActionButtonStyle"
		BasedOn="{StaticResource TabButtonStyle}"
		TargetType="Button">
		<Setter Property="WidthRequest" Value="150" />
		<Setter Property="HeightRequest" Value="45" />
	</Style>

	<Style
		x:Key="PageHeaderPrimaryButtonStyle"
		BasedOn="{StaticResource TabButtonActiveStyle}"
		TargetType="Button">
		<Setter Property="WidthRequest" Value="150" />
		<Setter Property="HeightRequest" Value="45" />
	</Style>
	<Style x:Key="BaseInputStyle" TargetType="VisualElement">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
	</Style>

	<Style TargetType="Entry">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="PlaceholderColor" Value="#94A3B8" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<Style TargetType="Editor">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="PlaceholderColor" Value="#94A3B8" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<Style TargetType="Picker">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="TitleColor" Value="#94A3B8" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<Style TargetType="DatePicker">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HeightRequest" Value="36" />
	</Style>

	<Style TargetType="SearchBar">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="TextColor" Value="#0F172A" />
		<Setter Property="PlaceholderColor" Value="#94A3B8" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<!--  =========================================================  -->
	<!--  LABELS  -->
	<!--  =========================================================  -->

	<Style x:Key="FormLabelStyle" TargetType="Label">

		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="#64748B" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="CharacterSpacing" Value="0.5" />
		<Setter Property="TextTransform" Value="Uppercase" />

	</Style>

	<!--  =========================================================  -->
	<!--  BORDER BASE  -->
	<!--  =========================================================  -->

	<Style x:Key="BaseBorderStyle" TargetType="Border">

		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Stroke" Value="#D9E0E5" />

	</Style>

	<Style
		x:Key="InputBorderStyle"
		BasedOn="{StaticResource BaseBorderStyle}"
		TargetType="Border">

		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Stroke" Value="#CBD5E1" />
		<Setter Property="StrokeShape" Value="Rectangle" />
		<Setter Property="Padding" Value="10,0" />
		<Setter Property="HeightRequest" Value="36" />

	</Style>

	<Style
		x:Key="CardStyle"
		BasedOn="{StaticResource BaseBorderStyle}"
		TargetType="Border">

		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="StrokeShape" Value="Rectangle" />
		<Setter Property="Padding" Value="20" />

	</Style>

	<Style
		x:Key="StatCardStyle"
		BasedOn="{StaticResource BaseBorderStyle}"
		TargetType="Border">

		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="StrokeShape" Value="RoundRectangle 10" />
		<Setter Property="Padding" Value="16,14" />
		<Setter Property="MinimumWidthRequest" Value="160" />

	</Style>

	<Style x:Key="StatusPillStyle" TargetType="Border">

		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="Rectangle" />
		<Setter Property="Padding" Value="10,3" />
		<Setter Property="HorizontalOptions" Value="Start" />
		<Setter Property="VerticalOptions" Value="Center" />

	</Style>

	<!--  =========================================================  -->
	<!--  COMMON  -->
	<!--  =========================================================  -->

	<Style x:Key="SeparatorStyle" TargetType="BoxView">

		<Setter Property="BackgroundColor" Value="#D9E0E5" />
		<Setter Property="HeightRequest" Value="2" />
		<Setter Property="HorizontalOptions" Value="Fill" />

	</Style>

	<Style TargetType="CollectionView">
		<Setter Property="BackgroundColor" Value="Transparent" />
	</Style>

	<Style TargetType="ScrollView">
		<Setter Property="BackgroundColor" Value="Transparent" />
	</Style>

	<Style TargetType="CheckBox">
		<Setter Property="Color" Value="#2AEBE7" />
	</Style>

	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="#2AEBE7" />
		<Setter Property="ThumbColor" Value="#0F172A" />
	</Style>

	<Style TargetType="ProgressBar">
		<Setter Property="ProgressColor" Value="#2AEBE7" />
		<Setter Property="BackgroundColor" Value="#F8FAFC" />
	</Style>


</ResourceDictionary>