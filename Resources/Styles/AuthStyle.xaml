	<!--  Neutral  -->
	<Color x:Key="SparkStatusNeutralBg">#EAECF1</Color>
	<Color x:Key="SparkStatusNeutralText">#5A6178</Color>



	<!--  =====================================================  -->
	<!--  Badges  -->
	<!--  =====================================================  -->

	<Color x:Key="SparkBadgeSuccessBg">#E7F6E9</Color>
	<Color x:Key="SparkBadgeSuccessText">#3CB35B</Color>

	<Color x:Key="SparkBadgeWarningBg">#FDF3E3</Color>
	<Color x:Key="SparkBadgeWarningText">#E0A83C</Color>

	<Color x:Key="SparkBadgeDangerBg">#FDE8E8</Color>
	<Color x:Key="SparkBadgeDangerText">#E0554F</Color>

	<Color x:Key="SparkBadgeNeutralBg">#EDF1F5</Color>
	<Color x:Key="SparkBadgeNeutralSelected">#21B6C4</Color>



	<!--  =====================================================  -->
	<!--  Expandable Card  -->
	<!--  =====================================================  -->

	<Color x:Key="ExpandCardBackground">#FFFFFF</Color>
	<Color x:Key="ExpandCardBody">#FAFBFC</Color>
	<Color x:Key="ExpandCardBorder">#D8E1EA</Color>

	<Color x:Key="ExpandCardHeader">#556372</Color>
	<Color x:Key="ExpandCardHeaderHover">#647383</Color>

	<Color x:Key="ExpandCardTitle">#FFFFFF</Color>
	<Color x:Key="ExpandCardText">#475569</Color>

	<Color x:Key="ExpandCardChevron">#FFFFFF</Color>

	<Color x:Key="ExpandCardBadge">#21B6C4</Color>
	<Color x:Key="ExpandCardBadgeText">#FFFFFF</Color>



	<!--  =====================================================  -->
	<!--  Card Variants  -->
	<!--  =====================================================  -->


	<!--  Patient  -->
	<Color x:Key="SparkPatientHeader">#EFF6FF</Color>
	<Color x:Key="SparkPatientIcon">#DBEAFE</Color>
	<Color x:Key="SparkPatientBorder">#BFDBFE</Color>


	<!--  Diagnosis  -->
	<Color x:Key="SparkDiagnosisHeader">#EEF2FF</Color>
	<Color x:Key="SparkDiagnosisIcon">#C7D2FE</Color>
	<Color x:Key="SparkDiagnosisBorder">#A5B4FC</Color>


	<!--  Encounter  -->
	<Color x:Key="SparkEncounterHeader">#ECFEFF</Color>
	<Color x:Key="SparkEncounterIcon">#A5F3FC</Color>
	<Color x:Key="SparkEncounterBorder">#67E8F9</Color>


	<!--  Appointment  -->
	<Color x:Key="SparkAppointmentHeader">#FAF5FF</Color>
	<Color x:Key="SparkAppointmentIcon">#E9D5FF</Color>
	<Color x:Key="SparkAppointmentBorder">#D8B4FE</Color>


	<!--  Therapy  -->
	<Color x:Key="SparkTherapyHeader">#F0FDF4</Color>
	<Color x:Key="SparkTherapyIcon">#BBF7D0</Color>
	<Color x:Key="SparkTherapyBorder">#86EFAC</Color>


	<!--  Prescription  -->
	<Color x:Key="SparkPrescriptionHeader">#FFF1F2</Color>
	<Color x:Key="SparkPrescriptionIcon">#FECDD3</Color>
	<Color x:Key="SparkPrescriptionBorder">#FDA4AF</Color>


	<!--  Medicine  -->
	<Color x:Key="SparkMedicineHeader">#FFFBEB</Color>
	<Color x:Key="SparkMedicineIcon">#FDE68A</Color>
	<Color x:Key="SparkMedicineBorder">#FCD34D</Color>



	<!--  =====================================================  -->
	<!--  Login Theme  -->
	<!--  =====================================================  -->

	<Color x:Key="LoginDark">#0F172A</Color>
	<Color x:Key="LoginDark2">#1E293B</Color>
	<Color x:Key="LoginDark3">#05084E</Color>

	<Color x:Key="LoginText">#FFFFFF</Color>
	<Color x:Key="LoginMuted">#9CA3AF</Color>

	<Color x:Key="LoginPrimary">#06B6D4</Color>
	<Color x:Key="LoginAccent">#0891B2</Color>

	<Color x:Key="LoginBorder">#374151</Color>
	<Color x:Key="LoginCardAlt">#111827</Color>


	<LinearGradientBrush x:Key="LoginPageGradient" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="{StaticResource SparkedDarkBg}" />
		<GradientStop Offset="1" Color="{StaticResource SparkedDarkCard}" />
	</LinearGradientBrush>

	<Style x:Key="LoginPageStyle" TargetType="ContentPage">
		<Setter Property="BackgroundColor" Value="{StaticResource LoginDark}" />
	</Style>

	<!--  Right login card (white surface)  -->
	<Style x:Key="LoginCard" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource White}" />
		<Setter Property="Stroke" Value="#E2E8F0" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="40" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="24" />
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Input field wrapper  -->
	<Style x:Key="LoginInputBorder" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#F8FAFC" />
		<Setter Property="Stroke" Value="#CBD5E1" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="12" />
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Entry text  -->
	<Style x:Key="LoginEntry" TargetType="Entry">
		<Setter Property="TextColor" Value="#1E293B" />
		<Setter Property="PlaceholderColor" Value="#94A3B8" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="HeightRequest" Value="50" />
	</Style>

	<!--  Primary button  -->
	<Style x:Key="LoginPrimaryButton" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource LoginPrimary}" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="12" />
			</Setter.Value>
		</Setter>
		<Setter Property="HeightRequest" Value="50" />
	</Style>

</ResourceDictionary>