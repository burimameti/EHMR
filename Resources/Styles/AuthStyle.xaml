	<!--  =====================================================  -->
	<!--  Login Theme  -->
	<!--  =====================================================  -->

	<Color x:Key="LoginDark">#0F172A</Color>
	<Color x:Key="LoginDark2">#1E293B</Color>
	<Color x:Key="LoginDark3">#0F172A</Color>

	<Color x:Key="LoginText">#FFFFFF</Color>
	<Color x:Key="LoginMuted">#9CA3AF</Color>

	<Color x:Key="LoginPrimary">#2AEBE7</Color>
	<Color x:Key="LoginAccent">#2AEBE7</Color>

	<Color x:Key="LoginBorder">#374151</Color>
	<Color x:Key="LoginCardAlt">#111827</Color>


	<LinearGradientBrush x:Key="LoginPageGradient" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="#1F2937" />
		<GradientStop Offset="1" Color="#1A2436" />
	</LinearGradientBrush>

	<Style x:Key="LoginPageStyle" TargetType="ContentPage">
		<Setter Property="BackgroundColor" Value="#0F172A" />
	</Style>

	<!--  Right login card (white surface)  -->
	<Style x:Key="LoginCard" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#FFFFFF" />
		<Setter Property="Stroke" Value="#E2E8F0" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="40" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="24" />
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Input field wrapper  -->
	<Style x:Key="LoginInputBorder" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#F8FAFC" />
		<Setter Property="Stroke" Value="#CBD5E1" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Padding" Value="14,0" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="12" />
			</Setter.Value>
		</Setter>
	</Style>

	<!--  Entry text  -->
	<Style x:Key="LoginEntry" TargetType="Entry">
		<Setter Property="TextColor" Value="#1E293B" />
		<Setter Property="PlaceholderColor" Value="#94A3B8" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="HeightRequest" Value="50" />
	</Style>

	<!--  Primary button  -->
	<Style x:Key="LoginPrimaryButton" TargetType="Border">
		<Setter Property="BackgroundColor" Value="#2AEBE7" />
		<Setter Property="StrokeShape">
			<Setter.Value>
				<RoundRectangle CornerRadius="12" />
			</Setter.Value>
		</Setter>
		<Setter Property="HeightRequest" Value="50" />
	</Style>

</ResourceDictionary>