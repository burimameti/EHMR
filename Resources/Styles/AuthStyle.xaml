	<!--  =====================================================  -->
	<Color x:Key="Surface">#4A5863</Color>
	<Color x:Key="SurfaceAlt">#1A2436</Color>
	<Color x:Key="SparkedDarkCard">#1A2436</Color>
	<Color x:Key="BorderDefault">#334155</Color>
	<Color x:Key="Teal400">#2DD4BF</Color>
	<Color x:Key="Teal600">#0D9488</Color>
	<Color x:Key="Teal50">#F0FDFA</Color>
	<Color x:Key="Teal100">#CCFBF1</Color>

	<Color x:Key="SidebarBg">#3B4754</Color>
	<Color x:Key="SidebarActiveBg">#4DD9C7</Color>
	<Color x:Key="SidebarActiveText">#0F2E2A</Color>
	<Color x:Key="SidebarText">#CBD5E1</Color>
	<Color x:Key="SidebarTextMuted">#8B98A5</Color>
	<Color x:Key="SidebarLine">#5B6672</Color>
	<Color x:Key="SidebarBorder">#1E293B</Color>

	<Color x:Key="TextPrimary">#FFFFFF</Color>
	<Color x:Key="TextSecondary">#94A3B8</Color>
	<Color x:Key="TextMuted">#64748B</Color>

	<Color x:Key="EhmrPrimary">#0284C7</Color>
	<Color x:Key="PrimarySoft">#1E293B</Color>

	<Color x:Key="AppBg">#F1F5F9</Color>

	<Style x:Key="ThemedPage" TargetType="ContentPage">
		<Setter Property="BackgroundColor" Value="{StaticResource AppBg}" />
	</Style>

	<!--  =====================================================  -->
	<!--  =====================================================  -->
	<!--  🌈 SPARK CORE THEME  -->
	<!--  =====================================================  -->

	<Color x:Key="SparkPageBackground">#F4F7FB</Color>

	<Color x:Key="SparkedDarkBg">#1F2937</Color>
