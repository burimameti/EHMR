	<Color x:Key="SparkContentBackground">#FFFFFF</Color>
	<Color x:Key="SparkCardBorder">#DDE6F0</Color>


	<!--  Text  -->
	<Color x:Key="SparkTextPrimary">#172B4D</Color>
	<Color x:Key="SparkTextSecondary">#637381</Color>


	<!--  Accent  -->
	<Color x:Key="SparkAccentTeal">#009688</Color>
	<Color x:Key="SparkAccentTealDark">#00695C</Color>


	<!--  =====================================================  -->
	<!--  Tabs  -->
	<!--  =====================================================  -->

	<Color x:Key="SparkTabActiveBg">#E7F7FA</Color>
	<Color x:Key="SparkTabActiveBorder">#21B6C4</Color>
	<Color x:Key="SparkTabActiveText">#16374A</Color>
	<Color x:Key="SparkTabInactiveText">#7C8798</Color>
	<Color x:Key="SparkTabHoverBg">#F1F5F8</Color>



	<!--  =====================================================  -->
	<!--  Section Headers  -->
	<!--  =====================================================  -->

	<Color x:Key="SparkSectionHeaderBg">#E8F5F4</Color>
	<Color x:Key="SparkSectionHeaderText">#00695C</Color>



	<!--  =====================================================  -->
	<!--  Status  -->
	<!--  =====================================================  -->


