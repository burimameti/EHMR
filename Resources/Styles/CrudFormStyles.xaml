<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:EHMR.Resources.Controls">

	<!--  Shared input/button tokens: keep visual tuning in this dictionary.  -->
	<Color x:Key="FFControlLabelText">#94A3B8</Color>
	<Color x:Key="FFControlInputBackground">#FFFFFF</Color>
	<Color x:Key="FFControlInputBorder">#CBD5E1</Color>
	<Color x:Key="FFControlInputText">#0F172A</Color>
	<Color x:Key="FFControlPlaceholderText">#CBD5E1</Color>
	<Color x:Key="FFControlInputFocusBackground">#FAFCFF</Color>
	<Color x:Key="FFControlInputErrorBackground">#FFF8F8</Color>
	<Color x:Key="FFControlInputDisabledBackground">#F8FAFC</Color>
	<x:Double x:Key="FFControlInputHeight">36</x:Double>
	<x:Double x:Key="FFControlLabelFontSize">11</x:Double>
	<x:Double x:Key="FFControlInputFontSize">13</x:Double>
	<x:Double x:Key="FFControlInputCornerRadius">8</x:Double>
	<Thickness x:Key="FFControlInputPadding">12,0</Thickness>
	<x:Double x:Key="FFControlButtonHeight">40</x:Double>
	<Thickness x:Key="FFControlButtonPadding">16,0</Thickness>

	<Thickness x:Key="CrudFormPageMargin">16,0</Thickness>
	<Thickness x:Key="CrudFormCardPadding">18</Thickness>
	<x:Double x:Key="CrudFormSectionSpacing">18</x:Double>
	<x:Double x:Key="CrudFormColumnSpacing">8</x:Double>

	<!--  One default geometry for all FF buttons; explicit per-use sizing remains supported.  -->
	<Style TargetType="controls:FFButton">
		<Setter Property="HeightRequestEx" Value="{StaticResource FFControlButtonHeight}" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="ContentPadding" Value="{StaticResource FFControlButtonPadding}" />
		<Setter Property="FontSizeEx" Value="13" />
		<Setter Property="FontFamily" Value="Segoe UI" />
		<Setter Property="FontAttributesEx" Value="Bold" />
	</Style>

	<!--  Shared Entry style used by patient and encounter create/edit forms.  -->
	<Style x:Key="CrudFormFieldEntryStyle" TargetType="Entry">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="PlaceholderColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
	</Style>

	<Style x:Key="CrudFormPageGridStyle" TargetType="Grid">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="RowSpacing" Value="3" />
	</Style>

	<Style x:Key="CrudFormBodyGridStyle" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>

	<Style x:Key="CrudFormCardStyle" TargetType="controls:FFSectionCard">
		<Setter Property="Margin" Value="0" />
		<Setter Property="ContentPadding" Value="{StaticResource CrudFormCardPadding}" />
	</Style>

	<Style x:Key="CrudFormContentStackStyle" TargetType="VerticalStackLayout">
		<Setter Property="Padding" Value="0" />
		<Setter Property="Spacing" Value="1" />
	</Style>

	<Style x:Key="CrudFormSidebarStackStyle" TargetType="VerticalStackLayout">
		<Setter Property="Padding" Value="0" />
		<Setter Property="Spacing" Value="0" />
	</Style>

	<Style x:Key="CrudFormSectionStackStyle" TargetType="VerticalStackLayout">
		<Setter Property="Spacing" Value="3" />
	</Style>

	<Style x:Key="CrudFormSummarySurfaceStyle" TargetType="Border">
		<Setter Property="Padding" Value="14,12" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkContentBackground}" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>

	<Style x:Key="CrudFormValueSurfaceStyle" TargetType="Border">
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="MinimumHeightRequest" Value="40" />
		<Setter Property="BackgroundColor" Value="AliceBlue" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 4" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<Style x:Key="CrudFormValueSurfaceLargeStyle" TargetType="Border">
		<Setter Property="Padding" Value="14,12" />
		<Setter Property="MinimumHeightRequest" Value="72" />
		<Setter Property="BackgroundColor" Value="#F1F5F9" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorder}" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="StrokeShape" Value="RoundRectangle 4" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>

	<Style x:Key="CrudFormHistoryCardStyle" TargetType="controls:SparkExpandableCard">
		<Setter Property="CardBackgroundColor" Value="#4A5863" />
		<Setter Property="HeaderTextColor" Value="White" />
		<Setter Property="Subtitle" Value="" />
	</Style>

	<Style x:Key="CrudFormHistoryRowStyle" TargetType="Border">
		<Setter Property="Margin" Value="0,0,0,5" />
		<Setter Property="Padding" Value="2,0" />
		<Setter Property="BackgroundColor" Value="White" />
		<Setter Property="Stroke" Value="#D7E0E8" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<Style x:Key="CrudCollectionItemStyle" TargetType="Border">
		<Setter Property="Margin" Value="0,0,0,5" />
		<Setter Property="Padding" Value="9,6" />
		<Setter Property="BackgroundColor" Value="White" />
		<Setter Property="Stroke" Value="#D7E0E8" />
		<Setter Property="StrokeShape" Value="RoundRectangle 6" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<Style x:Key="CrudCollectionTitleStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="11.5" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudCollectionCodeStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="VerticalOptions" Value="Center" />
		<Setter Property="TextColor" Value="{StaticResource SparkAccentTealDark}" />
	</Style>
	<Style x:Key="CrudCollectionMetaStyle" TargetType="Label">
		<Setter Property="FontSize" Value="10.5" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextSecondary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudCollectionChevronStyle" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Text" Value="&#x276F;" />
		<Setter Property="TextColor" Value="{StaticResource SparkAccentTealDark}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudFormActionBarStyle" TargetType="HorizontalStackLayout">
		<Setter Property="HorizontalOptions" Value="End" />
		<Setter Property="Spacing" Value="8" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>

	<!--  Master card surface: copied from the patient form's established card design.  -->
	<Style x:Key="CrudFormSectionCardStyle" TargetType="Border">
		<Setter Property="Padding" Value="14" />
		<Setter Property="BackgroundColor" Value="#F8FAFC" />
		<Setter Property="Stroke" Value="#DCE3EA" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>

	<!--  Master editable-grid styles: the medication grid on PatientDetailFormPage is the reference.  -->
	<Style x:Key="CrudFormTableFrameStyle" TargetType="Border">
		<Setter Property="Padding" Value="0" />
		<Setter Property="BackgroundColor" Value="White" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 0" />
		<Setter Property="StrokeThickness" Value="1" />
	</Style>
	<Style x:Key="CrudFormTableHeaderGridStyle" TargetType="Grid">
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="BackgroundColor" Value="{StaticResource Gray300}" />
	</Style>
	<Style x:Key="CrudFormTableHeaderCellStyle" TargetType="Border">
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="BackgroundColor" Value="{StaticResource Gray300}" />
		<Setter Property="StrokeThickness" Value="0" />
	</Style>
	<Style x:Key="CrudFormTableHeaderLabelStyle" TargetType="Label">
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="9" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
		<Setter Property="TextColor" Value="{StaticResource Black}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudFormTableCellLabelStyle" TargetType="Label">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="LineBreakMode" Value="TailTruncation" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudFormTableCellEntryStyle" TargetType="Entry">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="TextColor" Value="{StaticResource SparkTextPrimary}" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudFormTableIconStyle" TargetType="Label">
		<Setter Property="FontFamily" Value="FASolid" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="HorizontalOptions" Value="Center" />
		<Setter Property="VerticalOptions" Value="Center" />
	</Style>
	<Style x:Key="CrudFormDocumentCardStyle" TargetType="Border">
		<Setter Property="Padding" Value="10,8" />
		<Setter Property="BackgroundColor" Value="{StaticResource SparkTabActiveBg}" />
		<Setter Property="Stroke" Value="{StaticResource SparkBorderSubtle}" />
		<Setter Property="StrokeShape" Value="RoundRectangle 10" />
		<Setter Property="StrokeThickness" Value="1" />
		<Setter Property="Shadow" Value="{x:Null}" />
	</Style>
	<Style x:Key="CrudFormSectionHeaderStyle" TargetType="controls:CrudSectionHeader">
		<Setter Property="BackgroundColor" Value="{StaticResource Transparent}" />
		<Setter Property="TextColor" Value="{StaticResource Gray800}" />
	</Style>

</ResourceDictionary>