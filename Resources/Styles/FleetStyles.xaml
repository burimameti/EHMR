<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- ========= COLORS (MINIMAL) ========= -->
	<Color x:Key="Color.Primary">#F97316</Color>
	<Color x:Key="Color.Primary.Dark">#C2410C</Color>

	<Color x:Key="Color.Background">#F8FAFC</Color>
	<Color x:Key="Color.Surface">#FFFFFF</Color>

	<Color x:Key="Color.Text">#0F172A</Color>
	<Color x:Key="Color.Text.Muted">#64748B</Color>

	<Color x:Key="Color.Border">#E2E8F0</Color>

	<!-- Ripple -->
	<Color x:Key="Color.Ripple">#1A000000</Color>

	<!-- ========= SPACING / RADIUS ========= -->
	<Thickness x:Key="Space.SM">8</Thickness>
	<Thickness x:Key="Space.MD">12</Thickness>

	<x:Double x:Key="Radius.SM">10</x:Double>
	<x:Double x:Key="Radius.MD">14</x:Double>

	<!-- ========= SHADOW ========= -->
	<Shadow x:Key="Shadow.SM"
            Brush="#000000"
            Offset="0,4"
            Radius="12"
            Opacity="0.08" />

	<!-- ========= GLOBAL ========= -->
	<Style TargetType="ContentPage" ApplyToDerivedTypes="True">
		<Setter Property="NavigationPage.HasNavigationBar" Value="False" />
		<Setter Property="BackgroundColor" Value="{StaticResource Color.Background}" />
	</Style>

	<!-- ========= TEXT ========= -->
	<Style x:Key="Style.Text.Title" TargetType="Label">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextColor" Value="{StaticResource Color.Text}" />
	</Style>

	<Style x:Key="Style.Text.Body" TargetType="Label">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="TextColor" Value="{StaticResource Color.Text.Muted}" />
	</Style>

	<!-- ========= INPUT ========= -->
	<Style x:Key="Style.Input" TargetType="Entry">
		<Setter Property="HeightRequest" Value="46" />
		<Setter Property="BackgroundColor" Value="{StaticResource Color.Surface}" />
		<Setter Property="TextColor" Value="{StaticResource Color.Text}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource Color.Text.Muted}" />
	</Style>

	<!-- ========= CARD ========= -->
	<Style x:Key="Style.Card" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource Color.Surface}" />
		<Setter Property="Stroke" Value="{StaticResource Color.Border}" />
		<Setter Property="Padding" Value="{StaticResource Space.MD}" />
		<Setter Property="StrokeShape">
			<RoundRectangle CornerRadius="{StaticResource Radius.MD}" />
		</Setter>
		<Setter Property="Shadow" Value="{StaticResource Shadow.SM}" />
	</Style>

	<!-- ========= BUTTON: PRIMARY ========= -->
	<Style x:Key="Style.Button.Primary" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Color.Primary}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
		<Setter Property="HeightRequest" Value="48" />
		<Setter Property="FontAttributes" Value="Bold" />

		<!-- Press effect -->
		<Setter Property="VisualStateManager.VisualStateGroups">
			<VisualStateGroupList>
				<VisualStateGroup Name="CommonStates">
					<VisualState Name="Pressed">
						<VisualState.Setters>
							<Setter Property="BackgroundColor"
                                    Value="{StaticResource Color.Primary.Dark}" />
						</VisualState.Setters>
					</VisualState>
				</VisualStateGroup>
			</VisualStateGroupList>
		</Setter>
	</Style>

	<!-- ========= BUTTON: SECONDARY ========= -->
	<Style x:Key="Style.Button.Secondary" TargetType="Button">
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="TextColor" Value="{StaticResource Color.Primary}" />
		<Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
	</Style>

	<!-- ========= BUTTON: ICON / FAB ========= -->
	<Style x:Key="Style.Button.Fab" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Color.Primary}" />
		<Setter Property="TextColor" Value="White" />
		<Setter Property="WidthRequest" Value="44" />
		<Setter Property="HeightRequest" Value="44" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="Shadow" Value="{StaticResource Shadow.SM}" />
	</Style>

	<!-- ========= SEARCH ========= -->

	<!-- ========= ACTIVITY ========= -->
	<Style TargetType="ActivityIndicator">
		<Setter Property="Color" Value="{StaticResource Color.Primary}" />
	</Style>
</ResourceDictionary>